open CanonicalBlocks

/-- An occupied removable column in a connected skew diagram has
no occupied column strictly to its left. The argument locates the
last row whose left endpoint is at least the alleged removable
column, then uses the overlap with the next row. -/
theorem connected_removable_column_is_leftmost (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j : ℕ) (hj : j ∈ occupiedColumnsRaw B)
    (hrem : RemovableHeadColumn B lo j)
    (k : ℕ) (hk : k ∈ occupiedColumnsRaw B) :
    j ≤ k := by
  classical
  by_contra hnot
  have hkj : k < j := by omega
  obtain ⟨p, hpB, hpc⟩ := Finset.mem_image.mp hj
  obtain ⟨q, hqB, hqc⟩ := Finset.mem_image.mp hk
  have hpj : (p.1, j) ∈ B := by
    have hpEq : p = (p.1, j) := Prod.ext rfl hpc
    rw [hpEq] at hpB
    exact hpB
  have hqk : (q.1, k) ∈ B := by
    have hqEq : q = (q.1, k) := Prod.ext rfl hqc
    rw [hqEq] at hqB
    exact hqB
  have hleftp : lo p.1 = j := hrem p.1 hpj
  have hleftq : lo q.1 ≤ k := ((hmem q.1 k).mp hqk).2.1
  have hpn : p.1 < n := ((hmem p.1 j).mp hpj).1
  have hqn : q.1 < n := ((hmem q.1 k).mp hqk).1
  have hpq : p.1 < q.1 := by
    by_contra hn
    have hqp : q.1 ≤ p.1 := by omega
    have hle := finiteInterval_antitone lo n hlo
      q.1 p.1 hqp hpn
    omega
  let R : Finset ℕ :=
    (occupiedRows B).filter (fun r => j ≤ lo r)
  have hpR : p.1 ∈ R := by
    simp only [R, Finset.mem_filter]
    exact ⟨Finset.mem_image.mpr ⟨p, hpB, rfl⟩,
      le_of_eq hleftp.symm⟩
  have hRNon : R.Nonempty := ⟨p.1, hpR⟩
  let s : ℕ := R.max' hRNon
  have hsR : s ∈ R := Finset.max'_mem R hRNon
  have hsOcc : s ∈ occupiedRows B := (Finset.mem_filter.mp hsR).1
  have hsLo : j ≤ lo s := (Finset.mem_filter.mp hsR).2
  have hps : p.1 ≤ s :=
    Finset.le_max' R p.1 hpR
  obtain ⟨c, hcB, hcrow⟩ := Finset.mem_image.mp hsOcc
  have hsn : s < n := by
    have hdata := (hmem c.1 c.2).mp hcB
    omega
  have hloS : lo s ≤ j := by
    have hle := finiteInterval_antitone lo n hlo
      p.1 s hps hsn
    omega
  have hSeq : lo s = j := by omega
  have hsq : s < q.1 := by
    by_contra hn
    have hqs : q.1 ≤ s := by omega
    have hle := finiteInterval_antitone lo n hlo
      q.1 s hqs hsn
    omega
  have hqOcc : q.1 ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨q, hqB, rfl⟩
  obtain ⟨t, hst, hnext⟩ :=
    hconn.2 s hsOcc ⟨q.1, hqOcc, hsq⟩
  have hnextOcc : s + 1 ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨(s + 1, t), hnext, rfl⟩
  have hnextLo : lo (s + 1) < j := by
    by_contra hn
    have hIn : s + 1 ∈ R := by
      simp only [R, Finset.mem_filter]
      exact ⟨hnextOcc, by omega⟩
    have hMax := Finset.le_max' R (s + 1) hIn
    omega
  have hsData := (hmem s t).mp hst
  have hnextData := (hmem (s + 1) t).mp hnext
  have hcell : (s + 1, j) ∈ B := by
    apply (hmem (s + 1) j).mpr
    exact ⟨hnextData.1, by omega, by omega⟩
  have hrembad : lo (s + 1) = j := hrem (s + 1) hcell
  omega

/-- Hence a connected skew diagram has at most one removable head
column (the minimum occupied column, when the diagram is nonempty). -/
theorem connected_removable_column_unique (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j k : ℕ)
    (hj : j ∈ occupiedColumnsRaw B)
    (hk : k ∈ occupiedColumnsRaw B)
    (hremj : RemovableHeadColumn B lo j)
    (hremk : RemovableHeadColumn B lo k) :
    j = k := by
  have hjk := connected_removable_column_is_leftmost B hconn
    n lo hi hmem hlo j hj hremj k hk
  have hkj := connected_removable_column_is_leftmost B hconn
    n lo hi hmem hlo k hk hremk j hj
  omega

end TableauTransfer
end OrderIdealSpecializations

