/-- The precise global width factorization. Each column that is not
removable contributes a fixed `y`; a removable head column contributes
`1` when selected in full, and `y` otherwise. Distinct groups are
independent even if the skew diagram is disconnected. -/
theorem skew_headTuples_width_product (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) (y : ℚ)
    [DecidablePred (RemovableHeadColumn B lo)] :
    y ^ columnCount (B \ headTuplesCells B lo P) =
      y ^ (nonremovableColumns B lo).card *
        ∏ g : HeadColumn B lo,
          if RemovableHeadColumn B lo g.1 then
            (if (P g).1 = leftBoundaryRowGroup B lo g.1
             then 1 else y)
          else 1 := by
  classical
  let S : Diagram := headTuplesCells B lo P
  let C : Finset ℕ := occupiedColumnsRaw B
  let R : Finset ℕ := occupiedColumnsRaw (B \ S)
  let f : ℕ → ℚ := fun j => if j ∈ R then y else 1
  have hSub : R ⊆ C := occupiedColumnsRaw_sdiff_subset B S
  have hWidth : y ^ columnCount (B \ S) = ∏ j ∈ C, f j := by
    have hPower := indicator_product_is_power C
      (fun j => j ∈ R) y
    have hFilter : C.filter (fun j => j ∈ R) = R := by
      ext j
      simp only [Finset.mem_filter]
      constructor
      · exact And.right
      · intro hj
        exact ⟨hSub hj, hj⟩
    change y ^ R.card = ∏ j ∈ C, f j
    rw [hPower, hFilter]
  have hNon :
      (∏ j ∈ nonremovableColumns B lo, f j) =
        y ^ (nonremovableColumns B lo).card := by
    have heq : (∏ j ∈ nonremovableColumns B lo, f j) =
        ∏ _j ∈ nonremovableColumns B lo, y := by
      apply Finset.prod_congr rfl
      intro j hj
      have hAlive := nonremovable_column_survives B
        n lo hi hmem hlo P j hj
      change (if j ∈ occupiedColumnsRaw
        (B \ headTuplesCells B lo P) then y else 1) = y
      exact ite_eq_left hAlive
    rw [heq]
    simp
  let v : ℕ → ℚ := fun j =>
    if hj : j ∈ headColumnIndices B lo then
      if (P (⟨j, hj⟩ : HeadColumn B lo)).1 =
           leftBoundaryRowGroup B lo j then 1 else y
    else 1
  have hRem :
      (∏ j ∈ C.filter (RemovableHeadColumn B lo), f j) =
      ∏ g : HeadColumn B lo,
        if RemovableHeadColumn B lo g.1 then
          (if (P g).1 = leftBoundaryRowGroup B lo g.1
            then 1 else y) else 1 := by
    have hRemIndex := removable_columns_filter_eq B
      n lo hi hmem
    rw [hRemIndex]
    calc
      (∏ j ∈ (headColumnIndices B lo).filter
          (RemovableHeadColumn B lo), f j) =
        ∏ j ∈ (headColumnIndices B lo).filter
          (RemovableHeadColumn B lo), v j := by
          apply Finset.prod_congr rfl
          intro j hj
          obtain ⟨hjHead, hjRem⟩ := Finset.mem_filter.mp hj
          have hjOcc := headColumn_occupied B n lo hi hmem
            (⟨j, hjHead⟩ : HeadColumn B lo)
          have hVan := headTuple_column_vanishes_iff_full B
            n lo hi hmem hlo P j hjOcc
          by_cases hFull :
              (P (⟨j, hjHead⟩ : HeadColumn B lo)).1 =
                leftBoundaryRowGroup B lo j
          · have hGone : j ∉ R := by
              exact hVan.mpr ⟨hjRem, hFull⟩
            simp [f, v, hjHead, hFull, hGone, R]
          · have hAlive : j ∈ R := by
              by_contra hGone
              obtain ⟨hRem', hFull'⟩ := hVan.mp hGone
              exact hFull (by simpa only [] using hFull')
            simp [f, v, hjHead, hFull, hAlive, R]
      _ = ∏ j ∈ headColumnIndices B lo,
            if RemovableHeadColumn B lo j then v j else 1 :=
          product_filter_as_indicator (headColumnIndices B lo)
            (RemovableHeadColumn B lo) v
      _ = ∏ g : HeadColumn B lo,
            if RemovableHeadColumn B lo g.1 then
              (if (P g).1 = leftBoundaryRowGroup B lo g.1
               then 1 else y) else 1 := by
          rw [← Finset.prod_attach]
          apply Finset.prod_congr rfl
          intro g _
          by_cases hrem : RemovableHeadColumn B lo g.1
          · simp [v, g.2, hrem]
          · simp [v, hrem]
  have hSplit := product_filter_partition C
    (RemovableHeadColumn B lo) f
  have hNonIndex : C.filter
      (fun j => ¬ RemovableHeadColumn B lo j) =
      nonremovableColumns B lo := by
    ext j
    simp only [C, nonremovableColumns, Finset.mem_filter]
  calc
    y ^ columnCount (B \ headTuplesCells B lo P) =
        ∏ j ∈ C, f j := hWidth
    _ = (∏ j ∈ C.filter (RemovableHeadColumn B lo), f j) *
        (∏ j ∈ nonremovableColumns B lo, f j) := by
          rw [hSplit, hNonIndex]
    _ = y ^ (nonremovableColumns B lo).card *
        (∏ g : HeadColumn B lo,
          if RemovableHeadColumn B lo g.1 then
            (if (P g).1 = leftBoundaryRowGroup B lo g.1
             then 1 else y) else 1) := by
          rw [hRem, hNon]
          ring

/-- The unrestricted two-variable inverse-strip enumerator. This is
the precise disconnected analogue of the preceding lemmas's connected formula.
Every removable column contributes a factor `(y-x)`; all other head
groups contribute the unchanged telescope `(1-x)^r`. -/
theorem skew_headTuples_bivariate_product (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (x y : ℚ) [DecidablePred (RemovableHeadColumn B lo)] :
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        y ^ columnCount (B \ headTuplesCells B lo P)) =
      y ^ (nonremovableColumns B lo).card *
        ∏ g : HeadColumn B lo,
          if RemovableHeadColumn B lo g.1 then
            (y - x) * (1 - x) ^
              ((leftBoundaryRowGroup B lo g.1).card - 1)
          else (1 - x) ^ (leftBoundaryRowGroup B lo g.1).card := by
  classical
  let w : ∀ g : HeadColumn B lo,
      FiniteRowPrefix (leftBoundaryRowGroup B lo g.1) → ℚ :=
    fun g p => oneColumnInverseCoefficient x p.1.card
  let z : ∀ g : HeadColumn B lo,
      FiniteRowPrefix (leftBoundaryRowGroup B lo g.1) → ℚ :=
    fun g p => if RemovableHeadColumn B lo g.1 then
      (if p.1 = leftBoundaryRowGroup B lo g.1 then 1 else y)
      else 1
  let v : ∀ g : HeadColumn B lo,
      FiniteRowPrefix (leftBoundaryRowGroup B lo g.1) → ℚ :=
    fun g p => w g p * z g p
  have hOne (g : HeadColumn B lo) :
      (∑ p : FiniteRowPrefix (leftBoundaryRowGroup B lo g.1),
        v g p) =
        if RemovableHeadColumn B lo g.1 then
          (y - x) * (1 - x) ^
            ((leftBoundaryRowGroup B lo g.1).card - 1)
        else (1 - x) ^ (leftBoundaryRowGroup B lo g.1).card := by
    by_cases hrem : RemovableHeadColumn B lo g.1
    · simpa only [v, w, z, ite_eq_left hrem] using
        finiteRowPrefix_removable_sum x y
          (leftBoundaryRowGroup B lo g.1)
          (headColumn_rowGroup_nonempty B lo g)
    · simpa only [v, w, z, ite_eq_right hrem, mul_one] using
        finiteRowPrefix_weight_sum_subtype x
          (leftBoundaryRowGroup B lo g.1)
  calc
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        y ^ columnCount (B \ headTuplesCells B lo P)) =
      ∑ P : HeadPrefixTuples B lo,
        y ^ (nonremovableColumns B lo).card *
          (∏ g : HeadColumn B lo, v g (P g)) := by
          apply Finset.sum_congr rfl
          intro P _
          rw [headTuples_q_is_product_skew B n lo hi hmem
            hlo hhi P x,
            skew_headTuples_width_product B n lo hi hmem hlo P y]
          simp only [v, w, z]
          rw [Finset.prod_mul_distrib]
          ring
    _ = y ^ (nonremovableColumns B lo).card *
          (∑ P : HeadPrefixTuples B lo,
            ∏ g : HeadColumn B lo, v g (P g)) := by
          rw [Finset.mul_sum]
    _ = y ^ (nonremovableColumns B lo).card *
          (∏ g : HeadColumn B lo,
            ∑ p : FiniteRowPrefix (leftBoundaryRowGroup B lo g.1),
              v g p) := by
          rw [finitePi_weight_sum_product v]
    _ = _ := by
          simp_rw [hOne]

end TableauTransfer
