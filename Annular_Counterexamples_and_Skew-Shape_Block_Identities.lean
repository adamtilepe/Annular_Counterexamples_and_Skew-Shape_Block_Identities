/-- Complete matrix cancellation on proper *connected* intervals.
This makes the connected portion of manuscript Lemma 5.3 an actual
statement about entries of Q_x T_x, rather than only head-prefix sums. -/
theorem connected_Q_mul_T_entry (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊂ J.1)
    (hconn : ConnectedSkewRows (intervalCells D I J)) :
    (Q D x * T D x) I J = 0 := by
  classical
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  have hskD : SkewRowIntervals D :=
    ⟨n, lo, hi, hmem, hlo, hhi⟩
  obtain ⟨nB, loB, hiB, hmemB, hloB, hhiB⟩ :=
    movingShape_skew D hskD I J
  let B : Diagram := intervalCells D I J
  have hBNonempty : B.Nonempty := by
    have hproper := (Finset.ssubset_iff_subset_ne).mp hIJ
    have hne : ¬ J.1 ⊆ I.1 := by
      intro h
      exact hproper.2 (Finset.Subset.antisymm hproper.1 h)
    have hwidth : columnCount B ≠ 0 := by
      intro hw
      exact hne ((interval_width_zero_iff D I J).mp hw)
    by_contra he
    have hempty : B = ∅ := Finset.not_nonempty_iff_eq_empty.mp he
    exact hwidth (by simp [hempty, columnCount])
  obtain ⟨j₀, hj₀, hrem₀⟩ :=
    nonempty_skew_has_removable_column B
      (movingShape_skew D hskD I J) hBNonempty
  rw [Q_mul_T_as_legal_initial_strips]
  have hReindex := legalStrips_sum_as_headTuples D hskD I J
    hIJ.subset n lo hi hmem hlo hhi
    nB loB hiB hmemB hloB
    (fun S R => verticalStripCoefficient x S * x ^ columnCount R)
  rw [hReindex]
  exact connected_headTuples_cancellation B hconn
    nB loB hiB hmemB hloB j₀ hj₀
      (hrem₀ nB loB hiB hmemB) x

/-- Complete derivative convolution on proper connected intervals. -/
theorem connected_Q_mul_Tprime_entry (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊂ J.1)
    (hconn : ConnectedSkewRows (intervalCells D I J)) :
    (Q D x * Tprime D x) I J = A D (1 - x) I J := by
  classical
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  have hskD : SkewRowIntervals D :=
    ⟨n, lo, hi, hmem, hlo, hhi⟩
  obtain ⟨nB, loB, hiB, hmemB, hloB, hhiB⟩ :=
    movingShape_skew D hskD I J
  let B : Diagram := intervalCells D I J
  have hBNonempty : B.Nonempty := by
    have hproper := (Finset.ssubset_iff_subset_ne).mp hIJ
    have hne : ¬ J.1 ⊆ I.1 := by
      intro h
      exact hproper.2 (Finset.Subset.antisymm hproper.1 h)
    have hwidth : columnCount B ≠ 0 := by
      intro hw
      exact hne ((interval_width_zero_iff D I J).mp hw)
    by_contra he
    have hempty : B = ∅ := Finset.not_nonempty_iff_eq_empty.mp he
    exact hwidth (by simp [hempty, columnCount])
  obtain ⟨j₀, hj₀, hrem₀⟩ :=
    nonempty_skew_has_removable_column B
      (movingShape_skew D hskD I J) hBNonempty
  rw [Q_mul_Tprime_as_legal_initial_strips]
  have hReindex := legalStrips_sum_as_headTuples D hskD I J
    hIJ.subset n lo hi hmem hlo hhi
    nB loB hiB hmemB hloB
    (fun S R => verticalStripCoefficient x S *
      ((columnCount R : ℚ) * x ^ (columnCount R - 1)))
  rw [hReindex]
  rw [A_of_connected D (1 - x) I J hIJ hconn]
  change
    (∑ P : HeadPrefixTuples B loB,
      verticalStripCoefficient x (headTuplesCells B loB P) *
        ((columnCount (B \ headTuplesCells B loB P) : ℚ) *
          x ^ (columnCount (B \ headTuplesCells B loB P) - 1))) =
      (1 - x) ^ (rowCount B - 1) *
        (1 - (1 - x)) ^ (columnCount B - 1)
  rw [connected_headTuples_derivative B hconn
    nB loB hiB hmemB hloB j₀ hj₀
      (hrem₀ nB loB hiB hmemB) x]
  ring

end TableauTransfer
