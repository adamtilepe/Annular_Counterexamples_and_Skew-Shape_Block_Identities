open CanonicalBlocks

/-- Two ideals above the same initial ideal are equal if they add the
same cells. This is independent of skewness or connectedness. -/
theorem ideals_eq_of_same_interval (D : Diagram)
    (I K L : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hIL : I.1 ⊆ L.1)
    (he : intervalCells D I K = intervalCells D I L) :
    K = L := by
  apply Subtype.ext
  ext c
  by_cases hcI : c ∈ I.1
  · exact ⟨fun _ => hIL hcI, fun _ => hIK hcI⟩
  · have hK := moving_cell_mem_iff D I K c
    have hL := moving_cell_mem_iff D I L c
    have hcell : c.1 ∈ MovingShape D I K ↔
        c.1 ∈ MovingShape D I L := by
      change c.1 ∈ intervalCells D I K ↔
        c.1 ∈ intervalCells D I L
      rw [he]
    simpa [hcI] using (hK.symm.trans (hcell.trans hL))

/-- The type of all intermediate ideals whose first increment is a
vertical strip. It is finite because the ambient ideal lattice is. -/
abbrev LegalInitialStrips (D : Diagram) (I J : ShapeIdeal D) :=
  {K : ShapeIdeal D // IsIntermediate D I J K ∧
    IsVerticalStrip (intervalCells D I K)}

noncomputable instance legalInitialStripsFintype (D : Diagram)
    (I J : ShapeIdeal D) : Fintype (LegalInitialStrips D I J) := by
  classical
  infer_instance

/-- The finite set of all admissible first-available-cell selections.
This uses the powerset of the *finite moving interval*; there is no
finiteness assumption on all subsets of ℕ × ℕ. -/
noncomputable def initialStripSelections (D : Diagram)
    (I J : ShapeIdeal D) (lo : ℕ → ℕ) : Finset Diagram := by
  classical
  exact ((intervalCells D I J).powerset).filter
    (IsInitialStripSelection D I J lo)

@[simp] theorem mem_initialStripSelections (D : Diagram)
    (I J : ShapeIdeal D) (lo : ℕ → ℕ) (S : Diagram) :
    S ∈ initialStripSelections D I J lo ↔
      IsInitialStripSelection D I J lo S := by
  classical
  simp only [initialStripSelections, Finset.mem_filter,
    Finset.mem_powerset]
  constructor
  · intro h
    exact h.2
  · intro h
    exact ⟨h.1, h⟩

/-- A prefix selection is encoded by membership in the finite
enumerator above, so this subtype has a genuine `Fintype` instance. -/
abbrev InitialStripChoices (D : Diagram) (I J : ShapeIdeal D)
    (lo : ℕ → ℕ) :=
  {S : Diagram // S ∈ initialStripSelections D I J lo}

noncomputable instance initialStripChoicesFintype (D : Diagram)
    (I J : ShapeIdeal D) (lo : ℕ → ℕ) :
    Fintype (InitialStripChoices D I J lo) := by
  classical
  exact Finset.fintypeCoeSort (initialStripSelections D I J lo)

/-- A genuine equivalence between legal initial vertical strips and
independent *column-prefix constrained* cell selections. No artificial
`Fintype` on all finite diagrams is required. -/
noncomputable def legalStripsEquivPrefixSelections (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r) :
    LegalInitialStrips D I J ≃ InitialStripChoices D I J lo := by
  classical
  let toS : LegalInitialStrips D I J → InitialStripChoices D I J lo :=
    fun K => ⟨intervalCells D I K.1,
      (mem_initialStripSelections D I J lo _).mpr
        (intermediate_verticalStrip_is_initial D hsk I K.1 J
          K.2.1.1 K.2.1.2 K.2.2 n lo hi hmem)⟩
  let fromS : InitialStripChoices D I J lo → LegalInitialStrips D I J :=
    fun S =>
      let hS : IsInitialStripSelection D I J lo S.1 :=
        (mem_initialStripSelections D I J lo S.1).mp S.2
      ⟨idealFromInitialSelection D n lo hi hmem hlo hhi I J S.1 hS,
        idealFromInitialSelection_intermediate D n lo hi hmem
          hlo hhi I J hIJ S.1 hS,
        idealFromInitialSelection_vertical D n lo hi hmem
          hlo hhi I J S.1 hS⟩
  refine ⟨toS, fromS, ?_, ?_⟩
  · intro K
    apply Subtype.ext
    have hS : IsInitialStripSelection D I J lo
        (intervalCells D I K.1) :=
      intermediate_verticalStrip_is_initial D hsk I K.1 J
        K.2.1.1 K.2.1.2 K.2.2 n lo hi hmem
    have hRec := idealFromInitialSelection_interval D n lo hi
      hmem hlo hhi I J (intervalCells D I K.1) hS
    apply ideals_eq_of_same_interval D I _ _
      (idealFromInitialSelection_intermediate D n lo hi hmem
        hlo hhi I J hIJ (intervalCells D I K.1) hS).1 K.2.1.1
    exact hRec
  · intro S
    apply Subtype.ext
    have hS : IsInitialStripSelection D I J lo S.1 :=
      (mem_initialStripSelections D I J lo S.1).mp S.2
    exact idealFromInitialSelection_interval D n lo hi
      hmem hlo hhi I J S.1 hS

/-- Purely formal reindexing of *any* finite weighted sum over legal
initial strips, by the explicit geometric prefix-selection equivalence.
This bridge can be used for both the inverse and derivative sums. -/
theorem legalStrips_sum_as_prefixSelections (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (F : ShapeIdeal D → ℚ) :
    (∑ K : LegalInitialStrips D I J, F K.1) =
      ∑ S : InitialStripChoices D I J lo,
        F (idealFromInitialSelection D n lo hi hmem hlo hhi
          I J S.1
          ((mem_initialStripSelections D I J lo S.1).mp S.2)) := by
  classical
  let e := legalStripsEquivPrefixSelections D hsk I J
    hIJ n lo hi hmem hlo hhi
  exact Fintype.sum_equiv e
    (fun K : LegalInitialStrips D I J => F K.1)
    (fun S : InitialStripChoices D I J lo =>
      F (idealFromInitialSelection D n lo hi hmem hlo hhi
        I J S.1
        ((mem_initialStripSelections D I J lo S.1).mp S.2)))
    (by
      intro K
      change F K.1 = F (e.symm (e K)).1
      rw [e.symm_apply_apply])

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Every summand outside the *finite type* of legal strips vanishes.
This removes all inadmissible intermediate ideals from the first
convolution without changing any coefficient. -/
theorem Q_mul_T_as_legal_initial_strips (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) :
    (Q D x * T D x) I J =
      ∑ K : LegalInitialStrips D I J,
        verticalStripCoefficient x (intervalCells D I K.1) *
          x ^ columnCount (intervalCells D K.1 J) := by
  classical
  rw [Q_mul_T_entry]
  let s : Finset (ShapeIdeal D) := Finset.univ.filter
    (fun K => IsIntermediate D I J K ∧
      IsVerticalStrip (intervalCells D I K))
  have hsub :
      (∑ K : LegalInitialStrips D I J,
        verticalStripCoefficient x (intervalCells D I K.1) *
          x ^ columnCount (intervalCells D K.1 J)) =
      ∑ K ∈ s,
        verticalStripCoefficient x (intervalCells D I K) *
          x ^ columnCount (intervalCells D K J) := by
    symm
    exact Finset.sum_subtype s
      (fun K => by simp [s])
      (fun K => verticalStripCoefficient x (intervalCells D I K) *
        x ^ columnCount (intervalCells D K J))
  rw [hsub]
  dsimp [s]
  simp only [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro K _
  by_cases hIKJ : IsIntermediate D I J K
  · by_cases hstrip : IsVerticalStrip (intervalCells D I K)
    · simp [IsIntermediate, hIKJ.1, hIKJ.2, hstrip]
    · have hz := verticalStripCoefficient_non_vertical x
        (intervalCells D I K) hstrip
      simp [IsIntermediate, hIKJ.1, hIKJ.2, hstrip, hz]
  · have hnot : ¬(I ≤ K ∧ K ≤ J) := by
      intro hh
      exact hIKJ ⟨hh.1, hh.2⟩
    simp [hnot, hIKJ]

/-- The differentiated convolution has *the same* legal-strip indexing
set as the inverse convolution. Only its terminal weight differs. -/
theorem Q_mul_Tprime_as_legal_initial_strips (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) :
    (Q D x * Tprime D x) I J =
      ∑ K : LegalInitialStrips D I J,
        verticalStripCoefficient x (intervalCells D I K.1) *
          ((columnCount (intervalCells D K.1 J) : ℚ) *
            x ^ (columnCount (intervalCells D K.1 J) - 1)) := by
  classical
  rw [Q_mul_Tprime_entry]
  let s : Finset (ShapeIdeal D) := Finset.univ.filter
    (fun K => IsIntermediate D I J K ∧
      IsVerticalStrip (intervalCells D I K))
  have hsub :
      (∑ K : LegalInitialStrips D I J,
        verticalStripCoefficient x (intervalCells D I K.1) *
          ((columnCount (intervalCells D K.1 J) : ℚ) *
            x ^ (columnCount (intervalCells D K.1 J) - 1))) =
      ∑ K ∈ s,
        verticalStripCoefficient x (intervalCells D I K) *
          ((columnCount (intervalCells D K J) : ℚ) *
            x ^ (columnCount (intervalCells D K J) - 1)) := by
    symm
    exact Finset.sum_subtype s
      (fun K => by simp [s])
      (fun K => verticalStripCoefficient x (intervalCells D I K) *
        ((columnCount (intervalCells D K J) : ℚ) *
          x ^ (columnCount (intervalCells D K J) - 1)))
  rw [hsub]
  dsimp [s]
  simp only [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro K _
  by_cases hIKJ : IsIntermediate D I J K
  · by_cases hstrip : IsVerticalStrip (intervalCells D I K)
    · simp [IsIntermediate, hIKJ.1, hIKJ.2, hstrip]
    · have hz := verticalStripCoefficient_non_vertical x
        (intervalCells D I K) hstrip
      simp [IsIntermediate, hIKJ.1, hIKJ.2, hstrip, hz]
  · have hnot : ¬(I ≤ K ∧ K ≤ J) := by
      intro hh
      exact hIKJ ⟨hh.1, hh.2⟩
    simp [hnot, hIKJ]

/-- First convolution rewritten as an exact finite sum over actual
row-prefix selections of the moving interval (not a conditional
geometric identity). This is the input for the row-group product formula. -/
theorem Q_mul_T_as_prefix_selections (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r) :
    (Q D x * T D x) I J =
      ∑ S : InitialStripChoices D I J lo,
        verticalStripCoefficient x S.1 *
          x ^ columnCount (intervalCells D
            (idealFromInitialSelection D n lo hi hmem hlo hhi
              I J S.1
              ((mem_initialStripSelections D I J lo S.1).mp S.2)) J) := by
  classical
  rw [Q_mul_T_as_legal_initial_strips]
  let F : ShapeIdeal D → ℚ := fun K =>
    verticalStripCoefficient x (intervalCells D I K) *
      x ^ columnCount (intervalCells D K J)
  apply Eq.trans
    (legalStrips_sum_as_prefixSelections D hsk I J
      hIJ n lo hi hmem hlo hhi F)
  apply Finset.sum_congr rfl
  intro S _
  have hS : IsInitialStripSelection D I J lo S.1 :=
    (mem_initialStripSelections D I J lo S.1).mp S.2
  have hval := idealFromInitialSelection_interval D n lo hi
    hmem hlo hhi I J S.1 hS
  dsimp only [F]
  rw [hval]

/-- The derivative convolution admits precisely the same geometric
parametrization; this is why both summations can be handled by a single
row-group partition in the remaining argument. -/
theorem Q_mul_Tprime_as_prefix_selections (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r) :
    (Q D x * Tprime D x) I J =
      ∑ S : InitialStripChoices D I J lo,
        verticalStripCoefficient x S.1 *
          ((columnCount (intervalCells D
            (idealFromInitialSelection D n lo hi hmem hlo hhi
              I J S.1
              ((mem_initialStripSelections D I J lo S.1).mp S.2)) J) : ℚ) *
            x ^ (columnCount (intervalCells D
              (idealFromInitialSelection D n lo hi hmem hlo hhi
                I J S.1
                ((mem_initialStripSelections D I J lo S.1).mp S.2)) J) - 1)) := by
  classical
  rw [Q_mul_Tprime_as_legal_initial_strips]
  let F : ShapeIdeal D → ℚ := fun K =>
    verticalStripCoefficient x (intervalCells D I K) *
      ((columnCount (intervalCells D K J) : ℚ) *
        x ^ (columnCount (intervalCells D K J) - 1))
  apply Eq.trans
    (legalStrips_sum_as_prefixSelections D hsk I J
      hIJ n lo hi hmem hlo hhi F)
  apply Finset.sum_congr rfl
  intro S _
  have hS : IsInitialStripSelection D I J lo S.1 :=
    (mem_initialStripSelections D I J lo S.1).mp S.2
  have hval := idealFromInitialSelection_interval D n lo hi
    hmem hlo hhi I J S.1 hS
  dsimp only [F]
  rw [hval]

end TableauTransfer
end OrderIdealSpecializations

