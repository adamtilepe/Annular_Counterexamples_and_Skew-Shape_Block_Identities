-- the preceding construction uses noncomputable filters and if-then-else tests on propositions.
-- Make their classical decidability available also in theorem statements.
attribute [local instance] Classical.propDecidable

/-- Rows with a fixed left endpoint form a consecutive interval for
any skew diagram; **no connectedness assumption** is required. -/
theorem skew_leftBoundaryRowGroup_interval (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (j r s t : ℕ)
    (hr : r ∈ leftBoundaryRowGroup B lo j)
    (hs : s ∈ leftBoundaryRowGroup B lo j)
    (hrt : r ≤ t) (hts : t ≤ s) :
    t ∈ leftBoundaryRowGroup B lo j := by
  classical
  obtain ⟨hrOcc, hrEq⟩ :=
    (mem_leftBoundaryRowGroup B lo j r).mp hr
  obtain ⟨hsOcc, hsEq⟩ :=
    (mem_leftBoundaryRowGroup B lo j s).mp hs
  obtain ⟨cr, hcr, hcrRow⟩ := Finset.mem_image.mp hrOcc
  obtain ⟨cs, hcs, hcsRow⟩ := Finset.mem_image.mp hsOcc
  have hrn : r < n := by
    have h := (hmem cr.1 cr.2).mp hcr
    omega
  have hsn : s < n := by
    have h := (hmem cs.1 cs.2).mp hcs
    omega
  have htn : t < n := by omega
  have htLo : lo t = j := by
    have hrt' := finiteInterval_antitone lo n hlo r t hrt htn
    have hts' := finiteInterval_antitone lo n hlo t s hts hsn
    omega
  have hsHi : j < hi s := by
    have hrow : cs.1 = s := by simpa using hcsRow
    have hdata := (hmem cs.1 cs.2).mp hcs
    rw [hrow] at hdata
    rw [← hsEq]
    exact lt_of_le_of_lt hdata.2.1 hdata.2.2
  have htHi : j < hi t := by
    have hts' := finiteInterval_antitone hi n hhi t s hts hsn
    omega
  have htCell : (t, j) ∈ B :=
    (hmem t j).mpr ⟨htn, le_of_eq htLo, htHi⟩
  apply (mem_leftBoundaryRowGroup B lo j t).mpr
  exact ⟨Finset.mem_image.mpr ⟨(t, j), htCell, rfl⟩, htLo⟩

/-- Initial selections have consecutive cells in each column without
requiring the ambient skew diagram itself to be connected. -/
theorem skew_initialSelection_column_consecutive (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (S : Diagram) (hS : IsHeadPrefixSelection B lo S)
    (j r s t : ℕ) (hr : (r, j) ∈ S) (hs : (s, j) ∈ S)
    (hrt : r ≤ t) (hts : t ≤ s) :
    (t, j) ∈ S := by
  have hrB : (r, j) ∈ B := hS.1 hr
  have hsB : (s, j) ∈ B := hS.1 hs
  have hrOcc : r ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨(r, j), hrB, rfl⟩
  have hsOcc : s ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨(s, j), hsB, rfl⟩
  have hrG : r ∈ leftBoundaryRowGroup B lo j :=
    (mem_leftBoundaryRowGroup B lo j r).mpr
      ⟨hrOcc, (hS.2.1 r j hr).symm⟩
  have hsG : s ∈ leftBoundaryRowGroup B lo j :=
    (mem_leftBoundaryRowGroup B lo j s).mpr
      ⟨hsOcc, (hS.2.1 s j hs).symm⟩
  have htG := skew_leftBoundaryRowGroup_interval B
    n lo hi hmem hlo hhi j r s t hrG hsG hrt hts
  have htB := headCell_of_leftBoundaryRowGroup B
    n lo hi hmem j t htG
  exact hS.2.2 t s j hts htB hs

/-- The genuine vertical-strip coefficient factors over independent
head-row prefixes for *every* skew interval, connected or otherwise. -/
theorem headTuples_q_is_product_skew (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (P : HeadPrefixTuples B lo) (x : ℚ) :
    verticalStripCoefficient x (headTuplesCells B lo P) =
      ∏ g : HeadColumn B lo,
        oneColumnInverseCoefficient x (P g).1.card := by
  classical
  let S := headTuplesCells B lo P
  have hSel := headTuplesCells_isHeadPrefixSelection B
    n lo hi hmem hlo P
  have hVert : IsVerticalStrip S := by
    intro a ha b hb hab
    have haC := hSel.2.1 a.1 a.2 ha
    have hbC := hSel.2.1 b.1 b.2 hb
    rw [hab] at haC
    exact haC.trans hbC.symm
  calc
    verticalStripCoefficient x S =
        verticalStripCoefficient x
          (restrictToColumns S (headColumnIndices B lo)) := by
          rw [headTuples_restrict_headColumns]
    _ = ∏ j ∈ headColumnIndices B lo,
          verticalStripCoefficient x (selectedColumnSlice S j) :=
          verticalStripCoefficient_restrict_prod x S hVert _
    _ = ∏ g : HeadColumn B lo,
          oneColumnInverseCoefficient x (P g).1.card := by
          rw [← Finset.prod_attach]
          change
            (∏ g ∈ (headColumnIndices B lo).attach,
              verticalStripCoefficient x (selectedColumnSlice S g.1)) =
            (∏ g ∈ (headColumnIndices B lo).attach,
              oneColumnInverseCoefficient x (P g).1.card)
          apply Finset.prod_congr rfl
          intro g _
          have hcol : ∀ c ∈ selectedColumnSlice S g.1,
              c.2 = g.1 := by
            intro c hc
            exact ((mem_selectedColumnSlice S g.1 c).mp hc).2
          have hconv : ∀ r s t : ℕ,
              (r, g.1) ∈ selectedColumnSlice S g.1 →
              (s, g.1) ∈ selectedColumnSlice S g.1 →
              r ≤ t → t ≤ s →
              (t, g.1) ∈ selectedColumnSlice S g.1 := by
            intro r s t hr hs hrt hts
            have hrS := ((mem_selectedColumnSlice S g.1 (r, g.1)).mp hr).1
            have hsS := ((mem_selectedColumnSlice S g.1 (s, g.1)).mp hs).1
            have hChoice :=
              (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
            have hstart : r ∈ leftBoundaryRowGroup B lo g.1 := by
              obtain ⟨g', hEq, hSelected⟩ :=
                (mem_headTuplesCells B lo P r g.1).mp hrS
              have hgeq : g' = g := Subtype.ext hEq
              subst g'
              exact hChoice.1 hSelected
            have hend : s ∈ leftBoundaryRowGroup B lo g.1 := by
              obtain ⟨g', hEq, hSelected⟩ :=
                (mem_headTuplesCells B lo P s g.1).mp hsS
              have hgeq : g' = g := Subtype.ext hEq
              subst g'
              exact hChoice.1 hSelected
            have hneeded : t ∈ leftBoundaryRowGroup B lo g.1 :=
              skew_leftBoundaryRowGroup_interval B n lo hi hmem
                hlo hhi g.1 r s t hstart hend hrt hts
            have htChosen := hChoice.2 t hneeded s
              (by
                obtain ⟨g', hEq, hSelected⟩ :=
                  (mem_headTuplesCells B lo P s g.1).mp hsS
                have hgeq : g' = g := Subtype.ext hEq
                subst g'
                exact hSelected) hts
            have htS := (mem_headTuplesCells B lo P t g.1).mpr
              ⟨g, rfl, htChosen⟩
            exact (mem_selectedColumnSlice S g.1 (t, g.1)).mpr
              ⟨htS, rfl⟩
          rw [verticalStripCoefficient_consecutive_column x
            (selectedColumnSlice S g.1) g.1 hcol hconv,
            headTuples_slice_card]

