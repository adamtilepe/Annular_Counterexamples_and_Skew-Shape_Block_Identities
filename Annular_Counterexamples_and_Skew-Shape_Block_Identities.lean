/-! ### §5.3 — Recovering the height of the diagram. -/

noncomputable instance headRowGroupSubtypeFintype (B : Diagram)
    (lo : ℕ → ℕ) (g : HeadColumn B lo) :
    Fintype {r : ℕ // r ∈ leftBoundaryRowGroup B lo g.1} := by
  classical
  exact Finset.fintypeCoeSort _

noncomputable instance occupiedRowsSubtypeFintype (B : Diagram) :
    Fintype {r : ℕ // r ∈ occupiedRows B} := by
  classical
  exact Finset.fintypeCoeSort _

/-- The left-boundary row groups partition the occupied rows, with
no omissions or repetitions. -/
noncomputable def headRowGroupSigmaEquiv (B : Diagram)
    (lo : ℕ → ℕ) :
    (Σ g : HeadColumn B lo,
      {r : ℕ // r ∈ leftBoundaryRowGroup B lo g.1}) ≃
      {r : ℕ // r ∈ occupiedRows B} := by
  classical
  refine ⟨
    (fun p => ⟨p.2.1,
      ((mem_leftBoundaryRowGroup B lo p.1.1 p.2.1).mp p.2.2).1⟩),
    (fun r =>
      ⟨(⟨lo r.1, Finset.mem_image.mpr ⟨r.1, r.2, rfl⟩⟩ :
        HeadColumn B lo),
       ⟨r.1, (mem_leftBoundaryRowGroup B lo (lo r.1) r.1).mpr
          ⟨r.2, rfl⟩⟩⟩),
    ?_, ?_⟩
  · rintro ⟨⟨j, hj⟩, ⟨r, hr⟩⟩
    have heq : lo r = j :=
      ((mem_leftBoundaryRowGroup B lo j r).mp hr).2
    subst j
    rfl
  · intro r
    apply Subtype.ext
    rfl

/-- The total length of the independent head groups is exactly the
number of occupied rows; this identifies the height in the polynomial
formula with the manuscript's `h(B)`. -/
theorem headRowGroup_card_sum (B : Diagram) (lo : ℕ → ℕ) :
    (∑ g : HeadColumn B lo,
      (leftBoundaryRowGroup B lo g.1).card) = rowCount B := by
  classical
  have hc := Fintype.card_congr (headRowGroupSigmaEquiv B lo)
  have hcSigma :
      Fintype.card (Σ g : HeadColumn B lo,
        {r : ℕ // r ∈ leftBoundaryRowGroup B lo g.1}) =
      ∑ g : HeadColumn B lo,
        (leftBoundaryRowGroup B lo g.1).card := by
    rw [Fintype.card_sigma]
    apply Finset.sum_congr rfl
    intro g _
    simp [Fintype.card_coe]
  have hcRows :
      Fintype.card {r : ℕ // r ∈ occupiedRows B} =
        (occupiedRows B).card := by
    simp [Fintype.card_coe]
  change _ = (occupiedRows B).card
  rw [← hcSigma, hc, hcRows]

/-- The connected bivariate sum, now stated with the actual occupied
row-count and column-count of the diagram. -/
theorem connected_headTuples_bivariate_closed (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (x y : ℚ) :
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        y ^ columnCount (B \ headTuplesCells B lo P)) =
      y ^ (columnCount B - 1) * (y - x) *
        (1 - x) ^ (rowCount B - 1) := by
  rw [connected_headTuples_bivariate_sum B hconn
    n lo hi hmem hlo j₀ hj₀ hrem₀ x y,
    headRowGroup_card_sum B lo]

end TableauTransfer
