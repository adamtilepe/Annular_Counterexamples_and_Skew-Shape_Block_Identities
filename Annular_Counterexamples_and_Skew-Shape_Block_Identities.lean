/-- The first connected-interval convolution vanishes at the special
point `y = x`.  This is a direct corollary of the *fully evaluated*
bivariate prefix sum, without any coefficientwise cancellation
assumption or division by the parameter. -/
theorem connected_headTuples_cancellation (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (x : ℚ) :
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        x ^ columnCount (B \ headTuplesCells B lo P)) = 0 := by
  rw [connected_headTuples_bivariate_closed B hconn
    n lo hi hmem hlo j₀ hj₀ hrem₀ x x]
  ring

end TableauTransfer
