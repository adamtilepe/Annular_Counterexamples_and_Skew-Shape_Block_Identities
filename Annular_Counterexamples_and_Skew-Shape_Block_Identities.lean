open CanonicalBlocks

/-- The selected cells of one head column of an assembled tuple
are exactly the chosen group rows, placed in that column. -/
theorem headTuples_slice_eq (B : Diagram) (lo : ℕ → ℕ)
    (P : HeadPrefixTuples B lo) (g : HeadColumn B lo) :
    selectedColumnSlice (headTuplesCells B lo P) g.1 =
      (P g).1.image (fun r : ℕ => (r, g.1)) := by
  classical
  ext c
  rw [mem_selectedColumnSlice]
  constructor
  · rintro ⟨hc, hcol⟩
    obtain ⟨g', hcg, hgr⟩ :=
      (mem_headTuplesCells B lo P c.1 c.2).mp hc
    have hgg : g' = g := Subtype.ext (hcg.trans hcol)
    subst g'
    apply Finset.mem_image.mpr
    refine ⟨c.1, hgr, ?_⟩
    exact Prod.ext rfl hcol.symm
  · intro hc
    obtain ⟨r, hr, heq⟩ := Finset.mem_image.mp hc
    have hrow : r = c.1 := congrArg Prod.fst heq
    have hcol : g.1 = c.2 := congrArg Prod.snd heq
    constructor
    · exact (mem_headTuplesCells B lo P c.1 c.2).mpr
        ⟨g, hcol, by simpa only [hrow] using hr⟩
    · exact hcol.symm

/-- The number of cells in a group slice is exactly the number of
selected rows of that group. -/
theorem headTuples_slice_card (B : Diagram) (lo : ℕ → ℕ)
    (P : HeadPrefixTuples B lo) (g : HeadColumn B lo) :
    (selectedColumnSlice (headTuplesCells B lo P) g.1).card =
      (P g).1.card := by
  classical
  rw [headTuples_slice_eq]
  apply Finset.card_image_of_injective
  intro a b h
  exact congrArg Prod.fst h

/-- Every occupied column of an assembled head selection is an
index of the head-column type. -/
theorem headTuples_columns_subset (B : Diagram) (lo : ℕ → ℕ)
    (P : HeadPrefixTuples B lo) :
    occupiedColumnsRaw (headTuplesCells B lo P) ⊆
      headColumnIndices B lo := by
  intro j hj
  obtain ⟨c, hc, heq⟩ := Finset.mem_image.mp hj
  obtain ⟨g, hg, _⟩ :=
    (mem_headTuplesCells B lo P c.1 c.2).mp hc
  have : c.2 ∈ headColumnIndices B lo := by
    rw [← hg]
    exact g.2
  simpa only [heq] using this

/-- Restricting a tuple-built selection to all possible head columns
does not change its cells. -/
theorem headTuples_restrict_headColumns (B : Diagram)
    (lo : ℕ → ℕ) (P : HeadPrefixTuples B lo) :
    restrictToColumns (headTuplesCells B lo P)
      (headColumnIndices B lo) = headTuplesCells B lo P := by
  classical
  ext c
  rw [mem_restrictToColumns]
  constructor
  · exact And.left
  · intro hc
    have hh := headTuples_columns_subset B lo P
    have hj : c.2 ∈ occupiedColumnsRaw (headTuplesCells B lo P) :=
      Finset.mem_image.mpr ⟨c, hc, rfl⟩
    exact ⟨hc, hh hj⟩

/-- The true inverse weight on a whole tuple is the product of the
weights of its constituent row-group prefixes. -/
theorem headTuples_q_is_product (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) (x : ℚ) :
    verticalStripCoefficient x (headTuplesCells B lo P) =
      ∏ g : HeadColumn B lo,
        oneColumnInverseCoefficient x (P g).1.card := by
  classical
  let S := headTuplesCells B lo P
  have hSel := headTuplesCells_isHeadPrefixSelection B
    n lo hi hmem hlo P
  have hVert : IsVerticalStrip S := by
    intro a ha b hb hab
    have haC := hSel.2.1 a.1 a.2 ha
    have hbC := hSel.2.1 b.1 b.2 hb
    rw [hab] at haC
    exact haC.trans hbC.symm
  calc
    verticalStripCoefficient x S =
        verticalStripCoefficient x
          (restrictToColumns S (headColumnIndices B lo)) := by
          rw [headTuples_restrict_headColumns]
    _ = ∏ j ∈ headColumnIndices B lo,
          verticalStripCoefficient x (selectedColumnSlice S j) :=
          verticalStripCoefficient_restrict_prod x S hVert _
    _ = ∏ g : HeadColumn B lo,
          oneColumnInverseCoefficient x (P g).1.card := by
          -- The left product is reindexed by the subtype of the
          -- finite set of occupied head columns.
          rw [← Finset.prod_attach]
          change
            (∏ g ∈ (headColumnIndices B lo).attach,
              verticalStripCoefficient x (selectedColumnSlice S g.1)) =
            (∏ g ∈ (headColumnIndices B lo).attach,
              oneColumnInverseCoefficient x (P g).1.card)
          apply Finset.prod_congr rfl
          intro g _
          have hcol : ∀ c ∈ selectedColumnSlice S g.1,
              c.2 = g.1 := by
            intro c hc
            exact ((mem_selectedColumnSlice S g.1 c).mp hc).2
          have hconv : ∀ r s t : ℕ,
              (r, g.1) ∈ selectedColumnSlice S g.1 →
              (s, g.1) ∈ selectedColumnSlice S g.1 →
              r ≤ t → t ≤ s →
              (t, g.1) ∈ selectedColumnSlice S g.1 := by
            intro r s t hr hs hrt hts
            have hrS := ((mem_selectedColumnSlice S g.1 (r, g.1)).mp hr).1
            have hsS := ((mem_selectedColumnSlice S g.1 (s, g.1)).mp hs).1
            have hrG := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
            have hstart : r ∈ leftBoundaryRowGroup B lo g.1 := by
              have h := (mem_headTuplesCells B lo P r g.1).mp hrS
              obtain ⟨g', hEq, hSelected⟩ := h
              have hgeq : g' = g := Subtype.ext hEq
              subst g'
              exact hrG.1 hSelected
            have hend : s ∈ leftBoundaryRowGroup B lo g.1 := by
              have h := (mem_headTuplesCells B lo P s g.1).mp hsS
              obtain ⟨g', hEq, hSelected⟩ := h
              have hgeq : g' = g := Subtype.ext hEq
              subst g'
              exact hrG.1 hSelected
            -- These two rows lie in one prefix.  To bridge the
            -- intervening rows, use the true connected-skew lemma.
            have hneeded : t ∈ leftBoundaryRowGroup B lo g.1 :=
              connectedSkew_leftBoundaryRowGroup_interval B hconn
                n lo hi hmem hlo g.1 r s t
                hstart hend hrt hts
            have htChosen := hrG.2 t hneeded s
              (by
                have h := (mem_headTuplesCells B lo P s g.1).mp hsS
                obtain ⟨g', hEq, hSelected⟩ := h
                have hgeq : g' = g := Subtype.ext hEq
                subst g'
                exact hSelected) hts
            have htS := (mem_headTuplesCells B lo P t g.1).mpr
              ⟨g, rfl, htChosen⟩
            exact (mem_selectedColumnSlice S g.1 (t, g.1)).mpr
              ⟨htS, rfl⟩
          rw [verticalStripCoefficient_consecutive_column x
            (selectedColumnSlice S g.1) g.1 hcol hconv,
            headTuples_slice_card]

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
