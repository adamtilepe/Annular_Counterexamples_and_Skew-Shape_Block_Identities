universe u

/-! ## §2 — A bivariate interpolation of order and rank polynomials

### Lower ideals and isotone colorings -/

variable {α : Type u} [PartialOrder α]

/-- A lower ideal in a partially ordered type. -/
def IsIdeal (I : Finset α) : Prop :=
  ∀ ⦃a b : α⦄, a ≤ b → b ∈ I → a ∈ I

/-- An order-preserving map to a finite chain. -/
def IsIsotone {t : ℕ} (f : α → Fin t) : Prop :=
  ∀ ⦃a b : α⦄, a ≤ b → f a ≤ f b

@[simp] theorem empty_isIdeal : IsIdeal (∅ : Finset α) := by
  intro a b _ ha
  simp at ha

/-! These two Finset operations require decidable equality.
    No such assumption is imposed on the other poset constructions. -/
section FinsetClosure

variable [DecidableEq α]

/-- The intersection of lower ideals is a lower ideal. -/
theorem inter_isIdeal (I J : Finset α)
    (hI : IsIdeal I) (hJ : IsIdeal J) : IsIdeal (I ∩ J) := by
  intro a b hab hb
  rcases Finset.mem_inter.mp hb with ⟨hbI, hbJ⟩
  exact Finset.mem_inter.mpr ⟨hI hab hbI, hJ hab hbJ⟩

/-- The union of lower ideals is a lower ideal. -/
theorem union_isIdeal (I J : Finset α)
    (hI : IsIdeal I) (hJ : IsIdeal J) : IsIdeal (I ∪ J) := by
  intro a b hab hb
  rcases Finset.mem_union.mp hb with hbI | hbJ
  · exact Finset.mem_union.mpr (Or.inl (hI hab hbI))
  · exact Finset.mem_union.mpr (Or.inr (hJ hab hbJ))

end FinsetClosure

/-! ### §2 — The two-color construction, without a finiteness assumption. -/

/-- Color an ideal by `0`, and its complement by `1`. -/
noncomputable def colorOfIdeal (I : Finset α) : α → Fin 2 := by
  classical
  exact fun a => if a ∈ I then 0 else 1

/-- An ideal gives an order-preserving two-color map. -/
theorem colorOfIdeal_isIsotone (I : Finset α)
    (hI : IsIdeal I) : IsIsotone (colorOfIdeal I) := by
  classical
  intro a b hab
  change (if a ∈ I then (0 : Fin 2) else 1) ≤
    (if b ∈ I then (0 : Fin 2) else 1)
  by_cases hb : b ∈ I
  · have ha : a ∈ I := hI hab hb
    simp only [ite_eq_left ha, ite_eq_left hb, le_refl]
  · by_cases ha : a ∈ I
    · simp only [ite_eq_left ha, ite_eq_right hb]
      decide
    · simp only [ite_eq_right ha, ite_eq_right hb, le_refl]

/-! ### §2 — Finite enumeration and the bivariate invariant. -/
section FiniteEnumeration

variable [Fintype α]

/-- The finite set of lower ideals. -/
noncomputable def ideals : Finset (Finset α) := by
  classical
  exact Finset.univ.filter (IsIdeal (α := α))

@[simp] theorem mem_ideals (I : Finset α) :
    I ∈ ideals (α := α) ↔ IsIdeal I := by
  classical
  simp [ideals]

@[simp] theorem univ_isIdeal : IsIdeal (Finset.univ : Finset α) := by
  intro a b _ _
  simp

@[simp] theorem empty_mem_ideals :
    (∅ : Finset α) ∈ ideals (α := α) := by
  exact (mem_ideals (∅ : Finset α)).2 empty_isIdeal

@[simp] theorem univ_mem_ideals :
    (Finset.univ : Finset α) ∈ ideals (α := α) := by
  exact (mem_ideals (Finset.univ : Finset α)).2 univ_isIdeal

/-- Evaluation of the order polynomial at a natural-number argument. -/
noncomputable def omega (t : ℕ) : ℕ := by
  classical
  exact (Finset.univ.filter (fun f : α → Fin t => IsIsotone f)).card

/-- Every map to the one-element chain is isotone. -/
@[simp] theorem omega_one : omega (α := α) 1 = 1 := by
  classical
  have hf : ∀ f : α → Fin 1, IsIsotone f := by
    intro f a b _
    exact le_of_eq (Subsingleton.elim (f a) (f b))
  simp [omega, hf]

/-- Sum of integer weights over a finite subset. -/
def weight (w : α → ℤ) (I : Finset α) : ℤ := I.sum w

/-- The weighted rank enumerator at a rational argument. -/
noncomputable def weightedRank (w : α → ℤ) (q : ℚ) : ℚ :=
  (ideals (α := α)).sum (fun I => q ^ weight w I)

/-- The ordinary rank enumerator. -/
noncomputable def rank (q : ℚ) : ℚ :=
  (ideals (α := α)).sum (fun I => q ^ I.card)

/-- The interpolating enumerator from manuscript equation (2.2),
    here evaluated at a natural `t` and rational `q`. -/
noncomputable def H (w : α → ℤ) (t : ℕ) (q : ℚ) : ℚ := by
  classical
  exact (ideals (α := α)).sum (fun I =>
    q ^ weight w I *
      (omega (α := {a : α // a ∉ I}) (t - 1) : ℚ))

/-- First elementary specialization: `H(P,w;2,q) = R(P,w;q)`. -/
theorem H_two (w : α → ℤ) (q : ℚ) :
    H w 2 q = weightedRank w q := by
  classical
  simp [H, weightedRank]

/-- At `q=1`, the weighted rank enumerator counts lower ideals. -/
@[simp] theorem weightedRank_one (w : α → ℤ) :
    weightedRank w 1 = (ideals (α := α)).card := by
  simp [weightedRank]

@[simp] theorem rank_one :
    rank (α := α) 1 = (ideals (α := α)).card := by
  simp [rank]

/-! ### §2 — The two-color bijection used in Proposition 2.1. -/

/-- The zero-color class of a map to `Fin 2`. -/
noncomputable def zeroSet (f : α → Fin 2) : Finset α := by
  classical
  exact Finset.univ.filter (fun a => f a = 0)

/-- The zero-color class of an isotone map is an ideal. -/
theorem zeroSet_isIdeal (f : α → Fin 2)
    (hf : IsIsotone f) : IsIdeal (zeroSet f) := by
  classical
  intro a b hab hb
  have hfb : f b = 0 := (Finset.mem_filter.mp hb).2
  have hba : f a ≤ f b := hf hab
  have hfa : f a = 0 := by
    have h : f a ≤ 0 := by simpa [hfb] using hba
    omega
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hfa⟩

omit [PartialOrder α] in
/-- Coloring an ideal and taking the zero-color class recovers it. -/
theorem zeroSet_colorOfIdeal (I : Finset α) :
    zeroSet (colorOfIdeal I) = I := by
  classical
  ext a
  change (a ∈ Finset.univ.filter
    (fun x : α => colorOfIdeal I x = 0)) ↔ a ∈ I
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  by_cases ha : a ∈ I
  · simp [colorOfIdeal, ha]
  · simp [colorOfIdeal, ha]

omit [PartialOrder α] in
/-- A two-color map is uniquely determined by its zero-color class. -/
theorem colorOfIdeal_zeroSet (f : α → Fin 2) :
    colorOfIdeal (zeroSet f) = f := by
  classical
  funext a
  have hm : a ∈ zeroSet f ↔ f a = 0 := by
    simp [zeroSet]
  change (if a ∈ zeroSet f then (0 : Fin 2) else 1) = f a
  by_cases ha : f a = 0
  · have hz : a ∈ zeroSet f := hm.mpr ha
    rw [ite_eq_left hz, ha]
  · have hz : a ∉ zeroSet f := fun h => ha (hm.mp h)
    have h1 : f a = 1 := by omega
    rw [ite_eq_right hz, h1]

/-- The order polynomial at `2` counts all lower ideals. -/
theorem omega_two_eq_ideals_card :
    omega (α := α) 2 = (ideals (α := α)).card := by
  classical
  change (Finset.univ.filter (fun f : α → Fin 2 => IsIsotone f)).card =
      (Finset.univ.filter (IsIdeal (α := α))).card
  calc
    (Finset.univ.filter (fun f : α → Fin 2 => IsIsotone f)).card =
        Fintype.card {f : α → Fin 2 // IsIsotone f} := by
          exact (Fintype.card_subtype
            (fun f : α → Fin 2 => IsIsotone f)).symm
    _ = Fintype.card {I : Finset α // IsIdeal I} := by
          apply Fintype.card_congr
          exact {
            toFun := fun f => ⟨zeroSet f.1, zeroSet_isIdeal f.1 f.2⟩
            invFun := fun I =>
              ⟨colorOfIdeal I.1, colorOfIdeal_isIsotone I.1 I.2⟩
            left_inv := by
              intro f
              apply Subtype.ext
              exact colorOfIdeal_zeroSet f.1
            right_inv := by
              intro I
              apply Subtype.ext
              exact zeroSet_colorOfIdeal I.1
          }
    _ = (Finset.univ.filter (IsIdeal (α := α))).card := by
          exact Fintype.card_subtype (IsIdeal (α := α))

/-- Identity `R_P(1) = Omega(P;2)`. -/
theorem rank_one_eq_omega_two :
    rank (α := α) 1 = (omega (α := α) 2 : ℚ) := by
  rw [rank_one, omega_two_eq_ideals_card]

/-- The two elementary specializations agree at `(t,q)=(2,1)`. -/
theorem H_two_one_eq_omega_two (w : α → ℤ) :
    H w 2 1 = (omega (α := α) 2 : ℚ) := by
  rw [H_two, weightedRank_one, omega_two_eq_ideals_card]


/-! ### §2 — Further identities in the two-specialization proposition. -/

omit [PartialOrder α] in
noncomputable instance complementFintype (I : Finset α) :
    Fintype {a : α // a ∉ I} := by
  classical
  infer_instance

/-- The `q = 1` specialization, written as an explicit ideal sum.
    This is the right-hand side of the recursion in Proposition 2.1. -/
theorem H_one_as_ideal_sum (w : α → ℤ) (t : ℕ) :
    H w t 1 =
      (ideals (α := α)).sum (fun I =>
        (omega (α := {a : α // a ∉ I}) (t - 1) : ℚ)) := by
  simp [H]

/-- At `q = 1`, the interpolating enumerator is independent of its weights. -/
theorem H_one_weight_independent (w v : α → ℤ) (t : ℕ) :
    H w t 1 = H v t 1 := by
  exact (H_one_as_ideal_sum w t).trans (H_one_as_ideal_sum v t).symm

/-- If all weights vanish, every ideal contributes the constant `1` to
    the weighted rank enumerator, independently of the parameter `q`. -/
theorem weightedRank_zero (q : ℚ) :
    weightedRank (fun _ : α => 0) q =
      ((ideals (α := α)).card : ℚ) := by
  simp [weightedRank, weight]

/-- The weight-one specialization of the weighted rank enumerator is the
    ordinary rank enumerator. -/
theorem weightedRank_const_one_eq_rank (q : ℚ) :
    weightedRank (fun _ : α => (1 : ℤ)) q = rank (α := α) q := by
  unfold weightedRank rank
  apply Finset.sum_congr rfl
  intro I _
  have hweight : weight (fun _ : α => (1 : ℤ)) I = (I.card : ℤ) := by
    simp [weight]
  rw [hweight]
  simp

/-- For the zero weighting, the `t = 2` slice counts the ideals. -/
theorem H_two_zero_weight (q : ℚ) :
    H (fun _ : α => 0) 2 q = ((ideals (α := α)).card : ℚ) := by
  rw [H_two, weightedRank_zero]


/-! ### §2 — Splitting an isotone coloring at its zero-color ideal. -/

omit [PartialOrder α] in
/-- The zero-color class of an arbitrary `(t + 1)`-coloring. -/
noncomputable def zeroFiber {t : ℕ} (f : α → Fin (t + 1)) : Finset α := by
  classical
  exact Finset.univ.filter (fun a => f a = 0)

omit [PartialOrder α] in
@[simp] theorem mem_zeroFiber {t : ℕ} (f : α → Fin (t + 1)) (a : α) :
    a ∈ zeroFiber f ↔ f a = 0 := by
  classical
  simp [zeroFiber]

/-- The zero fiber of an isotone coloring is a lower ideal. -/
theorem zeroFiber_isIdeal {t : ℕ} (f : α → Fin (t + 1))
    (hf : IsIsotone f) : IsIdeal (zeroFiber f) := by
  intro a b hab hb
  have hbzero : f b = 0 := (mem_zeroFiber f b).mp hb
  have hle : (f a).val ≤ (f b).val := hf hab
  have hbval : (f b).val = 0 := congrArg Fin.val hbzero
  have hazero : f a = 0 := Fin.ext (by omega)
  exact (mem_zeroFiber f a).mpr hazero

omit [PartialOrder α] in
/-- Remove the zero color and subtract one from all remaining colors. -/
noncomputable def tailColor {t : ℕ} (f : α → Fin (t + 1)) :
    {a : α // a ∉ zeroFiber f} → Fin t := by
  intro a
  have hnonzero : f a.1 ≠ 0 := by
    intro hz
    exact a.2 ((mem_zeroFiber f a.1).mpr hz)
  refine ⟨(f a.1).val - 1, ?_⟩
  have hlt : (f a.1).val < t + 1 := (f a.1).isLt
  have hpos : 0 < (f a.1).val := by
    by_contra hnpos
    have hv : (f a.1).val = 0 := by
      omega
    have hz : f a.1 = 0 := by
      apply Fin.ext
      simpa using hv
    exact hnonzero hz
  omega

/-- The remaining coloring is isotone on the complement. -/
theorem tailColor_isIsotone {t : ℕ} (f : α → Fin (t + 1))
    (hf : IsIsotone f) : IsIsotone (tailColor f) := by
  intro a b hab
  have hle : (f a.1).val ≤ (f b.1).val := hf hab
  change (f a.1).val - 1 ≤ (f b.1).val - 1
  omega

/-! ### §2 — Reassembling the two pieces of an isotone coloring

This is the inverse construction for Proposition 2.1: a lower ideal is
assigned color zero; the isotone coloring of its complement is shifted
upward by one. The resulting map has `t + 1` possible colors. -/

omit [PartialOrder α] [Fintype α] in
/-- Reassemble a zero-color ideal and a coloring of its complement. -/
noncomputable def rebuildColor {t : ℕ} (I : Finset α)
    (g : {a : α // a ∉ I} → Fin t) : α → Fin (t + 1) := by
  classical
  intro a
  by_cases ha : a ∈ I
  · exact 0
  · exact (g ⟨a, ha⟩).succ

omit [Fintype α] in
/-- Reassembling an ideal and an isotone coloring yields an isotone map. -/
theorem rebuildColor_isIsotone {t : ℕ} (I : Finset α)
    (hI : IsIdeal I) (g : {a : α // a ∉ I} → Fin t)
    (hg : IsIsotone g) : IsIsotone (rebuildColor I g) := by
  classical
  intro a b hab
  by_cases hb : b ∈ I
  · have ha : a ∈ I := hI hab hb
    simp [rebuildColor, ha, hb]
  · by_cases ha : a ∈ I
    · simp [rebuildColor, ha, hb]
    · have hle : g ⟨a, ha⟩ ≤ g ⟨b, hb⟩ := hg hab
      simpa [rebuildColor, ha, hb] using hle

omit [PartialOrder α] in
/-- The zero fiber of the reassembled coloring is precisely the ideal. -/
@[simp] theorem zeroFiber_rebuildColor {t : ℕ} (I : Finset α)
    (g : {a : α // a ∉ I} → Fin t) :
    zeroFiber (rebuildColor I g) = I := by
  classical
  ext a
  rw [mem_zeroFiber]
  by_cases ha : a ∈ I
  · simp [rebuildColor, ha]
  · simp [rebuildColor, ha]

omit [PartialOrder α] in
/-- Splitting a coloring and reassembling it gives the original map. -/
theorem rebuildColor_zeroFiber_tailColor {t : ℕ}
    (f : α → Fin (t + 1)) :
    rebuildColor (zeroFiber f) (tailColor f) = f := by
  classical
  funext a
  by_cases ha : a ∈ zeroFiber f
  · have hfa : f a = 0 := (mem_zeroFiber f a).mp ha
    simp [rebuildColor, ha, hfa]
  · have hne : f a ≠ 0 := by
      intro hz
      exact ha ((mem_zeroFiber f a).mpr hz)
    have hpos : 0 < (f a).val := by
      by_contra hnpos
      have hv : (f a).val = 0 := by omega
      have hz : f a = 0 := Fin.ext hv
      exact hne hz
    have hval : ((tailColor f ⟨a, ha⟩).succ).val = (f a).val := by
      change (f a).val - 1 + 1 = (f a).val
      omega
    have hfin : (tailColor f ⟨a, ha⟩).succ = f a := Fin.ext hval
    simpa [rebuildColor, ha] using hfin


/-! ### §2 — Completing Proposition 2.1: the zero-fiber bijection

The next constructions are the inverse pair needed to count isotone
colorings with `t + 1` colors by their zero-color ideal and a coloring
of the complementary induced poset.  All proofs are explicit. -/

/-- Data consisting of a lower ideal and an isotone coloring of its complement. -/
abbrev SplitColorData (t : ℕ) :=
  Σ I : {I : Finset α // IsIdeal I},
    {g : {a : α // a ∉ I.1} → Fin t // IsIsotone g}

/-- Split an isotone coloring into its zero fiber and its remaining colors. -/
noncomputable def splitColorData {t : ℕ}
    (f : {f : α → Fin (t + 1) // IsIsotone f}) :
    SplitColorData (α := α) t :=
  ⟨⟨zeroFiber f.1, zeroFiber_isIdeal f.1 f.2⟩,
   ⟨tailColor f.1, tailColor_isIsotone f.1 f.2⟩⟩

noncomputable instance splitColorDataFintype (t : ℕ) :
    Fintype (SplitColorData (α := α) t) := by
  classical
  unfold SplitColorData
  infer_instance

omit [Fintype α] in
/-- Reassemble an isotone coloring from an ideal and a complement coloring. -/
noncomputable def mergeColorData {t : ℕ}
    (d : SplitColorData (α := α) t) :
    {f : α → Fin (t + 1) // IsIsotone f} :=
  ⟨rebuildColor d.1.1 d.2.1,
   rebuildColor_isIsotone d.1.1 d.1.2 d.2.1 d.2.2⟩

/-- A coloring can be split and reassembled without information loss. -/
@[simp] theorem mergeColorData_splitColorData {t : ℕ}
    (f : {f : α → Fin (t + 1) // IsIsotone f}) :
    mergeColorData (splitColorData f) = f := by
  apply Subtype.ext
  exact rebuildColor_zeroFiber_tailColor f.1

omit [PartialOrder α] in
/-- On a fixed complement, removing the zero color inverts the shift. -/
@[simp] theorem tailColor_rebuildColor_pointwise {t : ℕ}
    (I : Finset α) (g : {a : α // a ∉ I} → Fin t)
    (a : {a : α // a ∉ I}) :
    tailColor (rebuildColor I g)
        ⟨a.1, by simpa [zeroFiber_rebuildColor] using a.2⟩ = g a := by
  apply Fin.ext
  have ha : a.1 ∉ I := a.2
  simp [tailColor, rebuildColor, ha]

/-- The complete inverse identity for split colorings. -/
@[simp] theorem splitColorData_mergeColorData {t : ℕ}
    (d : SplitColorData (α := α) t) :
    splitColorData (mergeColorData d) = d := by
  classical
  rcases d with ⟨⟨I, hI⟩, ⟨g, hg⟩⟩
  have hdep
      (J : Finset α)
      (hJ : J = I)
      (f : {a : α // a ∉ J} → Fin t)
      (hf : IsIsotone f)
      (hfg : ∀ a : {a : α // a ∉ I},
        f ⟨a.1, by
          rw [hJ]
          exact a.2⟩ = g a) :
      HEq
        (⟨f, hf⟩ :
          {f : {a : α // a ∉ J} → Fin t // IsIsotone f})
        (⟨g, hg⟩ :
          {f : {a : α // a ∉ I} → Fin t // IsIsotone f}) := by
    subst J
    apply heq_of_eq
    apply Subtype.ext
    funext a
    exact hfg a
  have hsecond :
      HEq
        (⟨tailColor (rebuildColor I g),
          tailColor_isIsotone (rebuildColor I g)
            (rebuildColor_isIsotone I hI g hg)⟩ :
          {f : {a : α // a ∉ zeroFiber (rebuildColor I g)} →
            Fin t // IsIsotone f})
        (⟨g, hg⟩ :
          {f : {a : α // a ∉ I} → Fin t // IsIsotone f}) := by
    apply hdep
      (zeroFiber (rebuildColor I g))
      (zeroFiber_rebuildColor I g)
      (tailColor (rebuildColor I g))
      (tailColor_isIsotone (rebuildColor I g)
        (rebuildColor_isIsotone I hI g hg))
    intro a
    exact tailColor_rebuildColor_pointwise I g a
  apply Sigma.ext
  · apply Subtype.ext
    exact zeroFiber_rebuildColor I g
  · exact hsecond

/-- A bijection between isotone colorings and ideal/complement data. -/
noncomputable def colorSplitEquiv (t : ℕ) :
    {f : α → Fin (t + 1) // IsIsotone f} ≃
      SplitColorData (α := α) t where
  toFun := splitColorData
  invFun := mergeColorData
  left_inv := mergeColorData_splitColorData
  right_inv := splitColorData_mergeColorData

/-- Cardinality of the split-color data, expressed as a sum over ideals. -/
theorem splitColorData_card (t : ℕ) :
    Fintype.card (SplitColorData (α := α) t) =
      (ideals (α := α)).sum (fun I =>
        omega (α := {a : α // a ∉ I}) t) := by
  classical
  rw [Fintype.card_sigma]
  have hc (I : {I : Finset α // IsIdeal I}) :
      Fintype.card {g : {a : α // a ∉ I.1} → Fin t // IsIsotone g} =
      omega (α := {a : α // a ∉ I.1}) t := by
    classical
    unfold omega
    apply Fintype.card_of_subtype
    intro g
    simp
  simp_rw [hc]
  symm
  exact Finset.sum_subtype (ideals (α := α))
    (fun I => mem_ideals I)
    (fun I => omega (α := {a : α // a ∉ I}) t)

/-- A complete combinatorial recursion for order-polynomial evaluations. -/
theorem omega_succ_as_ideal_sum (t : ℕ) :
    omega (α := α) (t + 1) =
      (ideals (α := α)).sum (fun I =>
        omega (α := {a : α // a ∉ I}) t) := by
  classical
  calc
    omega (α := α) (t + 1) =
        Fintype.card {f : α → Fin (t + 1) // IsIsotone f} := by
          exact (Fintype.card_subtype (IsIsotone (α := α))).symm
    _ = Fintype.card (SplitColorData (α := α) t) :=
          Fintype.card_congr (colorSplitEquiv t)
    _ = _ := splitColorData_card t

/-- The q=1 specialization in Proposition 2.1, at all positive integers. -/
theorem H_one_eq_omega_succ (w : α → ℤ) (t : ℕ) :
    H w (t + 1) 1 = (omega (α := α) (t + 1) : ℚ) := by
  rw [H_one_as_ideal_sum, omega_succ_as_ideal_sum]
  simp

/-- The original specializations of the interpolating enumerator, together. -/
theorem H_specializations (w : α → ℤ) (t : ℕ) (q : ℚ) :
    H w 2 q = weightedRank w q ∧
      H w (t + 1) 1 = (omega (α := α) (t + 1) : ℚ) := by
  exact ⟨H_two w q, H_one_eq_omega_succ w t⟩


/-! ### §2 — Lemma 2.2: the zeta matrix of the finite ideal lattice

The zeta matrix is indexed by lower ideals rather than arbitrary subsets.
Its powers count weak chains, which correspond to isotone colorings. -/

omit [Fintype α] in
/-- The type of lower ideals, used as the matrix index set. -/
abbrev IdealIndex := {I : Finset α // IsIdeal I}

/-- Lower ideals form a finite set of matrix indices. -/
noncomputable instance idealIndexFintype : Fintype (IdealIndex (α := α)) := by
  classical
  infer_instance

omit [Fintype α] in
/-- The empty ideal as a matrix index. -/
def bottomIdeal : IdealIndex (α := α) :=
  ⟨∅, empty_isIdeal⟩

omit [Fintype α] in
noncomputable instance idealIndexDecidableEq :
    DecidableEq (IdealIndex (α := α)) :=
  Classical.decEq _

/-- The full ideal as a matrix index. -/
def topIdeal : IdealIndex (α := α) :=
  ⟨Finset.univ, univ_isIdeal⟩

omit [Fintype α] in
/-- The incidence zeta matrix, with coefficients in the natural numbers. -/
noncomputable def idealZeta :
    Matrix (IdealIndex (α := α)) (IdealIndex (α := α)) ℕ := by
  classical
  exact Matrix.of (fun I J => if I.1 ⊆ J.1 then (1 : ℕ) else 0)

omit [Fintype α] in
/-- The entry is one precisely when the first ideal lies below the second. -/
theorem idealZeta_of_subset (I J : IdealIndex (α := α))
    (h : I.1 ⊆ J.1) : idealZeta (α := α) I J = 1 := by
  classical
  change (if I.1 ⊆ J.1 then (1 : ℕ) else 0) = 1
  exact ite_eq_left h

omit [Fintype α] in
/-- Incomparable ideals give zero entries. -/
theorem idealZeta_of_not_subset (I J : IdealIndex (α := α))
    (h : ¬ I.1 ⊆ J.1) : idealZeta (α := α) I J = 0 := by
  classical
  change (if I.1 ⊆ J.1 then (1 : ℕ) else 0) = 0
  exact ite_eq_right h

omit [Fintype α] in
/-- Every ideal is comparable to itself. -/
@[simp] theorem idealZeta_diagonal (I : IdealIndex (α := α)) :
    idealZeta (α := α) I I = 1 := by
  apply idealZeta_of_subset
  intro a ha
  exact ha

omit [Fintype α] in
/-- The empty ideal is below every ideal. -/
@[simp] theorem idealZeta_bottom (J : IdealIndex (α := α)) :
    idealZeta (α := α) (bottomIdeal (α := α)) J = 1 := by
  apply idealZeta_of_subset
  exact Finset.empty_subset _

/-- Every ideal lies below the full ideal. -/
@[simp] theorem idealZeta_top (I : IdealIndex (α := α)) :
    idealZeta (α := α) I (topIdeal (α := α)) = 1 := by
  apply idealZeta_of_subset
  exact Finset.subset_univ _

/-- One power of the zeta matrix is the zeta matrix itself. -/
theorem idealZeta_pow_one (I J : IdealIndex (α := α)) :
    (idealZeta (α := α) ^ 1) I J = idealZeta (α := α) I J := by
  simp

/-- The entry of the square counts possible intermediate ideals. -/
theorem idealZeta_square_apply (I J : IdealIndex (α := α)) :
    (idealZeta (α := α) * idealZeta (α := α)) I J =
      ∑ K : IdealIndex (α := α),
        idealZeta (α := α) I K * idealZeta (α := α) K J := by
  classical
  exact Matrix.mul_apply

/-- The multiplication recursion for all powers of the zeta matrix. -/
theorem idealZeta_pow_succ (m : ℕ) (I J : IdealIndex (α := α)) :
    (idealZeta (α := α) ^ (m + 1)) I J =
      ∑ K : IdealIndex (α := α),
        (idealZeta (α := α) ^ m) I K * idealZeta (α := α) K J := by
  classical
  rw [pow_succ, Matrix.mul_apply]

/-- From the empty ideal to the full ideal, every intermediate ideal
    contributes exactly once to a two-step weak chain. -/
theorem idealZeta_square_bottom_top :
    (idealZeta (α := α) * idealZeta (α := α))
        (bottomIdeal (α := α)) (topIdeal (α := α)) =
      Fintype.card (IdealIndex (α := α)) := by
  classical
  rw [Matrix.mul_apply]
  simp

/-- The total number of ideal indices agrees with the original ideal count. -/
theorem idealIndex_card :
    Fintype.card (IdealIndex (α := α)) = (ideals (α := α)).card := by
  classical
  exact Fintype.card_subtype (IsIdeal (α := α))

/-- A first nontrivial case of Lemma 2.2: two-step weak chains
    correspond to isotone maps into a two-element chain. -/
theorem idealZeta_square_eq_omega_two :
    (idealZeta (α := α) * idealZeta (α := α))
        (bottomIdeal (α := α)) (topIdeal (α := α)) =
      omega (α := α) 2 := by
  rw [idealZeta_square_bottom_top, idealIndex_card, omega_two_eq_ideals_card]


/-! ### §2 — weak chains of ideals, and the entries of zeta powers

Unlike a purely recursive numerical definition, `WeakIdealChain` is a type of
combinatorial objects.  At length zero it carries an equality of endpoints.
At length `m + 1` it records the penultimate ideal, a chain of length `m`,
and the last inclusion.  The cardinality theorem below identifies these
objects with the coefficients of a power of the incidence zeta matrix. -/

omit [Fintype α] in
/-- A weak chain of `m` inclusions from `I` to `J` in the ideal lattice. -/
def WeakIdealChain :
    (m : ℕ) → IdealIndex (α := α) →
      IdealIndex (α := α) → Type _
  | 0, I, J =>
      {K : IdealIndex (α := α) // K = I ∧ I = J}
  | m + 1, I, J =>
      Σ K : IdealIndex (α := α),
        WeakIdealChain m I K ×
          {_u : Unit // K.1 ⊆ J.1}

/-- Finiteness of recursively encoded weak ideal chains. -/
noncomputable instance weakIdealChainFintypeInst :
    (m : ℕ) → (I J : IdealIndex (α := α)) →
      Fintype (WeakIdealChain (α := α) m I J)
  | 0, I, J => by
      classical
      change Fintype
        {K : IdealIndex (α := α) // K = I ∧ I = J}
      infer_instance
  | m + 1, I, J => by
      classical
      letI : ∀ K : IdealIndex (α := α),
          Fintype (WeakIdealChain (α := α) m I K) :=
        fun K => weakIdealChainFintypeInst m I K
      change Fintype
        (Σ K : IdealIndex (α := α),
          WeakIdealChain (α := α) m I K ×
            {u : Unit // K.1 ⊆ J.1})
      infer_instance

/-- Zero-step chains exist precisely when the endpoints agree. -/
theorem weakIdealChain_card_zero
    (I J : IdealIndex (α := α)) :
    Fintype.card (WeakIdealChain (α := α) 0 I J) =
      if I = J then 1 else 0 := by
  classical
  calc
    Fintype.card (WeakIdealChain (α := α) 0 I J) =
        Fintype.card
          {K : IdealIndex (α := α) // K = I ∧ I = J} := by
            exact Fintype.card_congr (Equiv.refl _)
    _ = if I = J then 1 else 0 := by
          rw [Fintype.card_subtype]
          by_cases h : I = J
          · subst J
            have hs :
                (Finset.univ.filter
                  (fun K : IdealIndex (α := α) => K = I)) = {I} := by
              ext K
              simp
            simp [hs]
          · simp [h]

/-- The cardinality of weak chains obeys the matrix recurrence. -/
theorem weakIdealChain_card_succ (m : ℕ)
    (I J : IdealIndex (α := α)) :
    Fintype.card (WeakIdealChain (α := α) (m + 1) I J) =
      ∑ K : IdealIndex (α := α),
        Fintype.card (WeakIdealChain (α := α) m I K) *
          idealZeta (α := α) K J := by
  classical
  have hlast (K : IdealIndex (α := α)) :
      Fintype.card {u : Unit // K.1 ⊆ J.1} =
        idealZeta (α := α) K J := by
    rw [Fintype.card_subtype]
    by_cases h : K.1 ⊆ J.1
    · rw [idealZeta_of_subset K J h]
      simp [h]
    · rw [idealZeta_of_not_subset K J h]
      simp [h]
  calc
    Fintype.card (WeakIdealChain (α := α) (m + 1) I J) =
        Fintype.card
          (Σ K : IdealIndex (α := α),
            WeakIdealChain (α := α) m I K ×
              {u : Unit // K.1 ⊆ J.1}) := by
            exact Fintype.card_congr (Equiv.refl _)
    _ = ∑ K : IdealIndex (α := α),
          Fintype.card (WeakIdealChain (α := α) m I K) *
            idealZeta (α := α) K J := by
          rw [Fintype.card_sigma]
          apply Finset.sum_congr rfl
          intro K _
          rw [Fintype.card_prod, hlast K]
/-- Every entry of every zeta power counts actual weak chains of ideals. -/
theorem idealZeta_pow_eq_weakIdealChain_card :
    ∀ (m : ℕ) (I J : IdealIndex (α := α)),
      (idealZeta (α := α) ^ m) I J =
        Fintype.card (WeakIdealChain (α := α) m I J) := by
  intro m
  induction m with
  | zero =>
      intro I J
      rw [weakIdealChain_card_zero]
      by_cases h : I = J
      · subst J
        simp
      · simp [h]
  | succ m ih =>
      intro I J
      rw [idealZeta_pow_succ, weakIdealChain_card_succ]
      apply Finset.sum_congr rfl
      intro K _
      rw [ih I K]

/-- In particular, the bottom-to-top entry counts all weak chains of a
    prescribed length, including chains with repeated ideals. -/
theorem idealZeta_pow_bottom_top_eq_weakIdealChain_card (m : ℕ) :
    (idealZeta (α := α) ^ m)
      (bottomIdeal (α := α)) (topIdeal (α := α)) =
      Fintype.card (WeakIdealChain (α := α) m
        (bottomIdeal (α := α)) (topIdeal (α := α))) := by
  exact idealZeta_pow_eq_weakIdealChain_card m _ _

/-- Zeta powers vanish when the starting ideal is not contained in the
    ending ideal.  This will also be useful for the incidence operators. -/
theorem idealZeta_pow_zero_of_not_subset :
    ∀ (m : ℕ) (I J : IdealIndex (α := α)),
      ¬ I.1 ⊆ J.1 → (idealZeta (α := α) ^ m) I J = 0 := by
  intro m
  induction m with
  | zero =>
      intro I J h
      have hneq : I ≠ J := by
        intro hij
        apply h
        rw [hij]
      simp [hneq]
  | succ m ih =>
      intro I J h
      rw [idealZeta_pow_succ]
      apply Finset.sum_eq_zero
      intro K _
      by_cases hIK : I.1 ⊆ K.1
      · have hKJ : ¬ K.1 ⊆ J.1 := by
          intro hkj
          exact h (hIK.trans hkj)
        rw [idealZeta_of_not_subset K J hKJ]
        simp
      · rw [ih I K hIK]
        simp


/-! ### §2 — Lemma 2.2: zeta powers and the order polynomial

The decomposition by the *last* color is dual to the
zero-fiber decomposition already used for Proposition 2.1.  This is
precisely the recursion naturally associated with right multiplication
by the incidence zeta matrix.  No numerical testing or unsupported statement
enters this proof. -/

/-- Cells belonging to a fixed lower ideal, with their induced order. -/
abbrev IdealCells (J : IdealIndex (α := α)) := {a : α // a ∈ J.1}

noncomputable instance idealCellsFintype (J : IdealIndex (α := α)) :
    Fintype (IdealCells J) := by
  classical
  infer_instance

/-- An ambient lower ideal contained in `J`. -/
abbrev BoundedIdeal (J : IdealIndex (α := α)) :=
  {K : IdealIndex (α := α) // K.1 ⊆ J.1}

noncomputable instance boundedIdealFintype (J : IdealIndex (α := α)) :
    Fintype (BoundedIdeal J) := by
  classical
  infer_instance

/-- The cells with a nonmaximal color in a coloring of `J`. -/
noncomputable def lowColorSet {t : ℕ} (J : IdealIndex (α := α))
    (f : IdealCells J → Fin (t + 1)) : Finset α := by
  classical
  exact Finset.univ.filter (fun a =>
    ∃ ha : a ∈ J.1, (f ⟨a, ha⟩).val < t)

@[simp] theorem mem_lowColorSet {t : ℕ} (J : IdealIndex (α := α))
    (f : IdealCells J → Fin (t + 1)) (a : α) :
    a ∈ lowColorSet J f ↔
      ∃ ha : a ∈ J.1, (f ⟨a, ha⟩).val < t := by
  classical
  simp [lowColorSet]

/-- A nonmaximal-color fiber is an ambient lower ideal, contained in `J`. -/
noncomputable def lowColorIdeal {t : ℕ} (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    BoundedIdeal J := by
  classical
  have hI : IsIdeal (lowColorSet J f.1) := by
    intro a b hab hb
    obtain ⟨hbJ, hblt⟩ := (mem_lowColorSet J f.1 b).mp hb
    have haJ : a ∈ J.1 := J.2 hab hbJ
    have hle : (f.1 ⟨a, haJ⟩).val ≤
        (f.1 ⟨b, hbJ⟩).val := f.2 hab
    exact (mem_lowColorSet J f.1 a).mpr
      ⟨haJ, lt_of_le_of_lt hle hblt⟩
  refine ⟨⟨lowColorSet J f.1, hI⟩, ?_⟩
  intro a ha
  obtain ⟨haJ, _⟩ := (mem_lowColorSet J f.1 a).mp ha
  exact haJ

/-- Restrict all nonmaximal colors to the corresponding ideal. -/
noncomputable def lowColorRestrict {t : ℕ} (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    IdealCells (lowColorIdeal J f).1 → Fin t := by
  intro a
  have haJ : a.1 ∈ J.1 := (lowColorIdeal J f).2 a.2
  have hlt : (f.1 ⟨a.1, haJ⟩).val < t := by
    obtain ⟨_, h⟩ := (mem_lowColorSet J f.1 a.1).mp a.2
    exact h
  exact ⟨(f.1 ⟨a.1, haJ⟩).val, hlt⟩

/-- The restricted coloring is still isotone. -/
theorem lowColorRestrict_isIsotone {t : ℕ} (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    IsIsotone (lowColorRestrict J f) := by
  intro a b hab
  have haJ : a.1 ∈ J.1 := (lowColorIdeal J f).2 a.2
  have hbJ : b.1 ∈ J.1 := (lowColorIdeal J f).2 b.2
  have hle : (f.1 ⟨a.1, haJ⟩).val ≤
      (f.1 ⟨b.1, hbJ⟩).val := f.2 hab
  apply Fin.le_iff_val_le_val.mpr
  exact hle

/-- Reconstruct a coloring by assigning the largest color off `K`. -/
noncomputable def highColorMerge {t : ℕ} (J : IdealIndex (α := α))
    (K : BoundedIdeal J) (g : IdealCells K.1 → Fin t) :
    IdealCells J → Fin (t + 1) := by
  classical
  intro a
  by_cases ha : a.1 ∈ K.1.1
  · exact (g ⟨a.1, ha⟩).castSucc
  · exact Fin.last t

omit [Fintype α] in
/-- Rebuilding preserves isotonicity because `K` is a lower ideal. -/
theorem highColorMerge_isIsotone {t : ℕ}
    (J : IdealIndex (α := α)) (K : BoundedIdeal J)
    (g : IdealCells K.1 → Fin t) (hg : IsIsotone g) :
    IsIsotone (highColorMerge J K g) := by
  classical
  intro a b hab
  by_cases hb : b.1 ∈ K.1.1
  · have ha : a.1 ∈ K.1.1 := K.1.2 hab hb
    have hle : (g ⟨a.1, ha⟩).val ≤ (g ⟨b.1, hb⟩).val := hg hab
    exact Fin.le_iff_val_le_val.mpr (by
      simpa [highColorMerge, ha, hb] using hle)
  · have hlt : (highColorMerge J K g a).val < t + 1 :=
      (highColorMerge J K g a).isLt
    have hv : (highColorMerge J K g b).val = t := by
      simp [highColorMerge, hb]
    exact Fin.le_iff_val_le_val.mpr (by omega)

/-- The lower-color fiber of a rebuilt coloring is exactly `K`. -/
@[simp] theorem lowColorSet_highColorMerge {t : ℕ}
    (J : IdealIndex (α := α)) (K : BoundedIdeal J)
    (g : IdealCells K.1 → Fin t) :
    lowColorSet J (highColorMerge J K g) = K.1.1 := by
  classical
  ext a
  constructor
  · intro ha
    obtain ⟨haJ, hlt⟩ :=
      (mem_lowColorSet J (highColorMerge J K g) a).mp ha
    by_contra hna
    have hv : (highColorMerge J K g ⟨a, haJ⟩).val = t := by
      simp [highColorMerge, hna]
    omega
  · intro ha
    have haJ : a ∈ J.1 := K.2 ha
    apply (mem_lowColorSet J (highColorMerge J K g) a).mpr
    refine ⟨haJ, ?_⟩
    simp [highColorMerge, ha]

/-- The entire bounded ideal is recovered, including its proof fields. -/
@[simp] theorem lowColorIdeal_highColorMerge {t : ℕ}
    (J : IdealIndex (α := α)) (K : BoundedIdeal J)
    (g : IdealCells K.1 → Fin t) (hg : IsIsotone g) :
    lowColorIdeal J
        ⟨highColorMerge J K g, highColorMerge_isIsotone J K g hg⟩ = K := by
  apply Subtype.ext
  apply Subtype.ext
  exact lowColorSet_highColorMerge J K g

/-- Splitting and rebuilding the original coloring gives that coloring. -/
theorem highColorMerge_lowColorRestrict {t : ℕ}
    (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    highColorMerge J (lowColorIdeal J f) (lowColorRestrict J f) = f.1 := by
  classical
  funext a
  by_cases ha : a.1 ∈ (lowColorIdeal J f).1.1
  · apply Fin.ext
    simp [highColorMerge, ha, lowColorRestrict]
  · have hge : t ≤ (f.1 a).val := by
      by_contra hn
      have hlt : (f.1 a).val < t := by omega
      exact ha ((mem_lowColorSet J f.1 a.1).mpr ⟨a.2, hlt⟩)
    have heq : (f.1 a).val = t := by
      have hlt := (f.1 a).isLt
      omega
    apply Fin.ext
    simp [highColorMerge, ha, heq]

/-- On the recovered ideal, restricting the rebuilt coloring returns `g`. -/
@[simp] theorem lowColorRestrict_highColorMerge {t : ℕ}
    (J : IdealIndex (α := α)) (K : BoundedIdeal J)
    (g : IdealCells K.1 → Fin t) (hg : IsIsotone g)
    (a : IdealCells K.1) :
    lowColorRestrict J
      ⟨highColorMerge J K g, highColorMerge_isIsotone J K g hg⟩
      ⟨a.1, by
        rw [lowColorIdeal_highColorMerge J K g hg]
        exact a.2⟩ = g a := by
  have ha : a.1 ∈ K.1.1 := a.2
  apply Fin.ext
  simp [lowColorRestrict, highColorMerge, ha]

/-- The dependent family of a bounded ideal and its smaller coloring. -/
abbrev LastColorData (J : IdealIndex (α := α)) (t : ℕ) :=
  Σ K : BoundedIdeal J,
    {g : IdealCells K.1 → Fin t // IsIsotone g}

noncomputable instance lastColorDataFintype
    (J : IdealIndex (α := α)) (t : ℕ) :
    Fintype (LastColorData J t) := by
  classical
  unfold LastColorData
  infer_instance

/-- Extract the small-color ideal and its coloring. -/
noncomputable def splitLastColor {t : ℕ} (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    LastColorData J t :=
  ⟨lowColorIdeal J f, ⟨lowColorRestrict J f,
    lowColorRestrict_isIsotone J f⟩⟩

/-- Reassemble the full coloring from its last-color decomposition. -/
noncomputable def mergeLastColor {t : ℕ} (J : IdealIndex (α := α))
    (d : LastColorData J t) :
    {g : IdealCells J → Fin (t + 1) // IsIsotone g} :=
  ⟨highColorMerge J d.1 d.2.1,
    highColorMerge_isIsotone J d.1 d.2.1 d.2.2⟩

@[simp] theorem mergeLastColor_splitLastColor {t : ℕ}
    (J : IdealIndex (α := α))
    (f : {g : IdealCells J → Fin (t + 1) // IsIsotone g}) :
    mergeLastColor J (splitLastColor J f) = f := by
  apply Subtype.ext
  exact highColorMerge_lowColorRestrict J f

@[simp] theorem splitLastColor_mergeLastColor {t : ℕ}
    (J : IdealIndex (α := α)) (d : LastColorData J t) :
    splitLastColor J (mergeLastColor J d) = d := by
  classical
  rcases d with ⟨K, ⟨g, hg⟩⟩
  have hdep (L : BoundedIdeal J) (hL : L = K)
      (f : IdealCells L.1 → Fin t) (hf : IsIsotone f)
      (hfg : ∀ a : IdealCells K.1,
        f ⟨a.1, by rw [hL]; exact a.2⟩ = g a) :
      HEq (⟨f, hf⟩ :
          {f : IdealCells L.1 → Fin t // IsIsotone f})
          (⟨g, hg⟩ :
          {f : IdealCells K.1 → Fin t // IsIsotone f}) := by
    subst L
    apply heq_of_eq
    apply Subtype.ext
    funext a
    exact hfg a
  have hsecond : HEq
      (⟨lowColorRestrict J (mergeLastColor J ⟨K, ⟨g, hg⟩⟩),
        lowColorRestrict_isIsotone J
          (mergeLastColor J ⟨K, ⟨g, hg⟩⟩)⟩ :
        {f : IdealCells (lowColorIdeal J
            (mergeLastColor J ⟨K, ⟨g, hg⟩⟩)).1 → Fin t // IsIsotone f})
      (⟨g, hg⟩ : {f : IdealCells K.1 → Fin t // IsIsotone f}) := by
    apply hdep
      (lowColorIdeal J (mergeLastColor J ⟨K, ⟨g, hg⟩⟩))
      (lowColorIdeal_highColorMerge J K g hg)
      (lowColorRestrict J (mergeLastColor J ⟨K, ⟨g, hg⟩⟩))
      (lowColorRestrict_isIsotone J (mergeLastColor J ⟨K, ⟨g, hg⟩⟩))
    intro a
    exact lowColorRestrict_highColorMerge J K g hg a
  apply Sigma.ext
  · exact lowColorIdeal_highColorMerge J K g hg
  · exact hsecond

/-- A genuine bijection, not only a numerical recurrence. -/
noncomputable def lastColorEquiv (J : IdealIndex (α := α)) (t : ℕ) :
    {f : IdealCells J → Fin (t + 1) // IsIsotone f} ≃
      LastColorData J t where
  toFun := splitLastColor J
  invFun := mergeLastColor J
  left_inv := mergeLastColor_splitLastColor J
  right_inv := splitLastColor_mergeLastColor J

/-- Finite isotone colorings, with an explicit instance for theorem statements. -/
noncomputable instance isotoneColoringFintype (t : ℕ) :
    Fintype {f : α → Fin t // IsIsotone f} := by
  classical
  infer_instance

/-- Evaluating the order polynomial counts isotone maps. -/
theorem omega_eq_card_isotone (t : ℕ) :
    omega (α := α) t =
      Fintype.card {f : α → Fin t // IsIsotone f} := by
  classical
  unfold omega
  exact (Fintype.card_of_subtype
    (Finset.univ.filter (fun f : α → Fin t => IsIsotone f))
    (by intro f; simp)).symm

/-- Cardinality of the last-color decomposition. -/
theorem lastColorData_card
    (J : IdealIndex (α := α)) (t : ℕ) :
    Fintype.card (LastColorData J t) =
      ∑ K : BoundedIdeal J,
        omega (α := IdealCells K.1) t := by
  classical
  calc
    Fintype.card (LastColorData J t) =
        Nat.card (LastColorData J t) := by
          exact Fintype.card_eq_nat_card
    _ = ∑ K : BoundedIdeal J,
          Nat.card
            {g : IdealCells K.1 → Fin t // IsIsotone g} := by
          change Nat.card
            (Σ K : BoundedIdeal J,
              {g : IdealCells K.1 → Fin t // IsIsotone g}) = _
          exact (Nat.card_sigma
            (β := fun K : BoundedIdeal J =>
              {g : IdealCells K.1 → Fin t // IsIsotone g}))
    _ = ∑ K : BoundedIdeal J,
          omega (α := IdealCells K.1) t := by
          apply Finset.sum_congr rfl
          intro K _
          calc
            Nat.card
                {g : IdealCells K.1 → Fin t // IsIsotone g} =
              Fintype.card
                {g : IdealCells K.1 → Fin t // IsIsotone g} := by
                  exact Nat.card_eq_fintype_card
            _ = omega (α := IdealCells K.1) t :=
                (omega_eq_card_isotone
                  (α := IdealCells K.1) t).symm

/-- The last-color recursion for the order polynomial on each ideal. -/
theorem omega_ideal_succ
    (J : IdealIndex (α := α)) (t : ℕ) :
    omega (α := IdealCells J) (t + 1) =
      ∑ K : BoundedIdeal J,
        omega (α := IdealCells K.1) t := by
  classical
  calc
    omega (α := IdealCells J) (t + 1) =
        Fintype.card
          {f : IdealCells J → Fin (t + 1) // IsIsotone f} := by
            exact omega_eq_card_isotone
              (α := IdealCells J) (t + 1)
    _ = Fintype.card (LastColorData J t) :=
          Fintype.card_congr (lastColorEquiv J t)
    _ = ∑ K : BoundedIdeal J,
          omega (α := IdealCells K.1) t :=
          lastColorData_card J t

/-- The last-color sum over all ideals, weighted by the incidence zeta matrix. -/
theorem omega_ideal_succ_all (J : IdealIndex (α := α)) (t : ℕ) :
    omega (α := IdealCells J) (t + 1) =
      ∑ K : IdealIndex (α := α),
        omega (α := IdealCells K) t * idealZeta (α := α) K J := by
  classical
  rw [omega_ideal_succ]
  let s : Finset (IdealIndex (α := α)) :=
    Finset.univ.filter (fun K => K.1 ⊆ J.1)
  have hsub :
      (∑ K : BoundedIdeal J, omega (α := IdealCells K.1) t) =
        ∑ K ∈ s, omega (α := IdealCells K) t := by
    symm
    exact Finset.sum_subtype s
      (fun K => by simp [s])
      (fun K => omega (α := IdealCells K) t)
  rw [hsub]
  dsimp [s]
  simp only [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro K _
  by_cases h : K.1 ⊆ J.1
  · rw [idealZeta_of_subset K J h]
    simp [h]
  · rw [idealZeta_of_not_subset K J h]
    simp [h]

/-- The bottom-to-`J` entry counts isotone colorings of the induced ideal. -/
theorem idealZeta_pow_bottom_eq_omega_ideal :
    ∀ (m : ℕ) (J : IdealIndex (α := α)),
      (idealZeta (α := α) ^ (m + 1))
        (bottomIdeal (α := α)) J =
        omega (α := IdealCells J) (m + 1) := by
  intro m
  induction m with
  | zero =>
      intro J
      rw [pow_one, idealZeta_bottom, omega_one]
  | succ m ih =>
      intro J
      calc
        (idealZeta (α := α) ^ ((m + 1) + 1))
            (bottomIdeal (α := α)) J =
            ∑ K : IdealIndex (α := α),
              (idealZeta (α := α) ^ (m + 1))
                (bottomIdeal (α := α)) K * idealZeta (α := α) K J := by
              exact idealZeta_pow_succ (m + 1) _ _
        _ = ∑ K : IdealIndex (α := α),
              omega (α := IdealCells K) (m + 1) *
                idealZeta (α := α) K J := by
              apply Finset.sum_congr rfl
              intro K _
              rw [ih K]
        _ = omega (α := IdealCells J) ((m + 1) + 1) :=
              (omega_ideal_succ_all J (m + 1)).symm

/-- Isotone colorings are invariant under the all-elements subtype. -/
theorem omega_topIdeal_eq_omega (m : ℕ) :
    omega (α := IdealCells (topIdeal (α := α))) m =
      omega (α := α) m := by
  classical
  have e :
      {f : IdealCells (topIdeal (α := α)) → Fin m // IsIsotone f} ≃
      {g : α → Fin m // IsIsotone g} :=
    { toFun := fun f =>
        ⟨fun a => f.1 ⟨a, by simp [topIdeal]⟩,
          by
            intro a b hab
            exact f.2 hab⟩
      invFun := fun g =>
        ⟨fun a => g.1 a.1,
          by
            intro a b hab
            exact g.2 hab⟩
      left_inv := by
        intro f
        apply Subtype.ext
        funext a
        rfl
      right_inv := by
        intro g
        apply Subtype.ext
        funext a
        rfl }
  calc
    omega (α := IdealCells (topIdeal (α := α))) m =
        Fintype.card
          {f : IdealCells (topIdeal (α := α)) → Fin m // IsIsotone f} := by
            exact omega_eq_card_isotone
              (α := IdealCells (topIdeal (α := α))) m
    _ = Fintype.card {g : α → Fin m // IsIsotone g} :=
          Fintype.card_congr e
    _ = omega (α := α) m :=
          (omega_eq_card_isotone (α := α) m).symm

/-- Manuscript Lemma 2.2: the zeta matrix counts order-preserving maps. -/
theorem idealZeta_pow_bottom_top_eq_omega (m : ℕ) :
    (idealZeta (α := α) ^ (m + 1))
      (bottomIdeal (α := α)) (topIdeal (α := α)) =
      omega (α := α) (m + 1) := by
  rw [idealZeta_pow_bottom_eq_omega_ideal, omega_topIdeal_eq_omega]

end FiniteEnumeration
end FinitePoset
end OrderIdealSpecializations

/-! ## §2.1 — Fences as skew ribbons

A directed Hasse path is encoded by a Boolean word (`true` = east/upward
cover, `false` = north/downward cover).  The cell order uses English row
coordinates: a move north decreases the row coordinate, whereas a move
east increases the column coordinate.

The results below concern the concrete path model of a skew ribbon.
The characterization of *arbitrary* skew Young diagrams as such paths
is not silently assumed: the ribbon is explicitly given by its path. -/
namespace OrderIdealSpecializations
namespace FenceRibbon

/-- Number of east steps before position `i`. -/
def eastPrefix (steps : ℕ → Bool) : ℕ → ℕ
  | 0 => 0
  | i + 1 => eastPrefix steps i + if steps i then 1 else 0

/-- Number of north steps before position `i`. -/
def northPrefix (steps : ℕ → Bool) : ℕ → ℕ
  | 0 => 0
  | i + 1 => northPrefix steps i + if steps i then 0 else 1

/-- Exactly one direction is chosen at each step. -/
theorem eastPrefix_add_northPrefix (steps : ℕ → Bool) (i : ℕ) :
    eastPrefix steps i + northPrefix steps i = i := by
  induction i with
  | zero => simp [eastPrefix, northPrefix]
  | succ i ih =>
      cases h : steps i <;>
        simp [eastPrefix, northPrefix, h] at * <;> omega

private theorem eastPrefix_le_succ (steps : ℕ → Bool) (i : ℕ) :
    eastPrefix steps i ≤ eastPrefix steps (i + 1) := by
  simp only [eastPrefix]
  omega

private theorem northPrefix_le_succ (steps : ℕ → Bool) (i : ℕ) :
    northPrefix steps i ≤ northPrefix steps (i + 1) := by
  simp only [northPrefix]
  omega

/-- The east-step counter is monotone in the path index. -/
theorem eastPrefix_mono (steps : ℕ → Bool) {i j : ℕ} (h : i ≤ j) :
    eastPrefix steps i ≤ eastPrefix steps j := by
  induction j with
  | zero =>
      have hi : i = 0 := by omega
      subst i
      exact le_refl _
  | succ j ih =>
      by_cases hij : i ≤ j
      · exact (ih hij).trans (eastPrefix_le_succ steps j)
      · have hi : i = j + 1 := by omega
        subst i
        exact le_refl _

/-- The north-step counter is monotone in the path index. -/
theorem northPrefix_mono (steps : ℕ → Bool) {i j : ℕ} (h : i ≤ j) :
    northPrefix steps i ≤ northPrefix steps j := by
  induction j with
  | zero =>
      have hi : i = 0 := by omega
      subst i
      exact le_refl _
  | succ j ih =>
      by_cases hij : i ≤ j
      · exact (ih hij).trans (northPrefix_le_succ steps j)
      · have hi : i = j + 1 := by omega
        subst i
        exact le_refl _

private theorem index_le (n : ℕ) (i : Fin (n + 1)) : i.val ≤ n := by
  have h := i.isLt
  omega

/-- Row coordinate of a ribbon cell, counting rows downward. -/
def ribbonRow (steps : ℕ → Bool) (n : ℕ) (i : Fin (n + 1)) : ℕ :=
  northPrefix steps n - northPrefix steps i.val

/-- Column coordinate of a ribbon cell, counting columns eastward. -/
def ribbonCol (steps : ℕ → Bool) (n : ℕ) (i : Fin (n + 1)) : ℕ :=
  eastPrefix steps i.val

/-- The cell reached after the first `i` steps. -/
def ribbonCell (steps : ℕ → Bool) (n : ℕ) (i : Fin (n + 1)) :
    ℕ × ℕ :=
  (ribbonRow steps n i, ribbonCol steps n i)

/-- Reading the path from southwest to northeast never increases row. -/
theorem ribbonRow_antitone (steps : ℕ → Bool) (n : ℕ)
    {i j : Fin (n + 1)} (hij : i.val ≤ j.val) :
    ribbonRow steps n j ≤ ribbonRow steps n i := by
  unfold ribbonRow
  have h := northPrefix_mono steps hij
  omega

/-- Reading the path from southwest to northeast never decreases column. -/
theorem ribbonCol_mono (steps : ℕ → Bool) (n : ℕ)
    {i j : Fin (n + 1)} (hij : i.val ≤ j.val) :
    ribbonCol steps n i ≤ ribbonCol steps n j := by
  exact eastPrefix_mono steps hij

/-- The path never visits the same grid cell twice. -/
theorem ribbonCell_injective (steps : ℕ → Bool) (n : ℕ) :
    Function.Injective (ribbonCell steps n) := by
  intro i j hij
  have hrow :
      northPrefix steps n - northPrefix steps i.val =
        northPrefix steps n - northPrefix steps j.val :=
    congrArg Prod.fst hij
  have hcol : eastPrefix steps i.val = eastPrefix steps j.val :=
    congrArg Prod.snd hij
  have hi : northPrefix steps i.val ≤ northPrefix steps n :=
    northPrefix_mono steps (index_le n i)
  have hj : northPrefix steps j.val ≤ northPrefix steps n :=
    northPrefix_mono steps (index_le n j)
  have hsum_i := eastPrefix_add_northPrefix steps i.val
  have hsum_j := eastPrefix_add_northPrefix steps j.val
  apply Fin.ext
  omega

/-- Adjacent cells differ by one east or north grid step. -/
theorem ribbonCell_next (steps : ℕ → Bool) (n i : ℕ) (hi : i < n) :
    ribbonCell steps n ⟨i + 1, by omega⟩ =
      if steps i then
        (ribbonRow steps n ⟨i, by omega⟩,
          ribbonCol steps n ⟨i, by omega⟩ + 1)
      else
        (ribbonRow steps n ⟨i, by omega⟩ - 1,
          ribbonCol steps n ⟨i, by omega⟩) := by
  have hmax : northPrefix steps (i + 1) ≤ northPrefix steps n :=
    northPrefix_mono steps (by omega)
  have hmax' : northPrefix steps i ≤ northPrefix steps n :=
    northPrefix_mono steps (by omega)
  cases hs : steps i <;>
    simp [ribbonCell, ribbonRow, ribbonCol, eastPrefix, northPrefix, hs];
    omega

/-- Distinct ribbon cells cannot occupy opposite NW/SE corners. -/
theorem ribbon_no_southeast_pair (steps : ℕ → Bool) (n : ℕ)
    (i j : Fin (n + 1)) :
    ¬ (ribbonRow steps n i < ribbonRow steps n j ∧
       ribbonCol steps n i < ribbonCol steps n j) := by
  intro h
  rcases le_total i.val j.val with hij | hji
  · have hrow := ribbonRow_antitone steps n hij
    omega
  · have hcol := ribbonCol_mono steps n hji
    omega

/-- The cells of the ribbon are the image of its northeast lattice path. -/
def ribbonCells (steps : ℕ → Bool) (n : ℕ) : Set (ℕ × ℕ) :=
  Set.range (ribbonCell steps n)

/-- No four cells of the path form a `2 × 2` square. -/
theorem ribbon_no_two_by_two (steps : ℕ → Bool) (n r c : ℕ) :
    ¬ ((r, c) ∈ ribbonCells steps n ∧
       (r + 1, c) ∈ ribbonCells steps n ∧
       (r, c + 1) ∈ ribbonCells steps n ∧
       (r + 1, c + 1) ∈ ribbonCells steps n) := by
  rintro ⟨h00, _, _, h11⟩
  rcases h00 with ⟨i, hi⟩
  rcases h11 with ⟨j, hj⟩
  have hir : ribbonRow steps n i = r := congrArg Prod.fst hi
  have hic : ribbonCol steps n i = c := congrArg Prod.snd hi
  have hjr : ribbonRow steps n j = r + 1 := congrArg Prod.fst hj
  have hjc : ribbonCol steps n j = c + 1 := congrArg Prod.snd hj
  apply ribbon_no_southeast_pair steps n i j
  constructor <;> omega

/-- The orientation of a Hasse path is read from the east/north word.
    A forward comparison requires no north step; a backward comparison
    requires no east step. The prefix formulation is equivalent to this
    description because the two counters have nonnegative increments. -/
def fenceLE (steps : ℕ → Bool) (i j : ℕ) : Prop :=
  (i ≤ j ∧ northPrefix steps i = northPrefix steps j) ∨
  (j ≤ i ∧ eastPrefix steps j = eastPrefix steps i)

/-- Every east step orients its edge toward increasing index. -/
theorem fenceLE_east (steps : ℕ → Bool) (i : ℕ)
    (h : steps i = true) : fenceLE steps i (i + 1) := by
  left
  constructor
  · omega
  · simp [northPrefix, h]

/-- Every north step orients its edge toward decreasing index. -/
theorem fenceLE_north (steps : ℕ → Bool) (i : ℕ)
    (h : steps i = false) : fenceLE steps (i + 1) i := by
  right
  constructor
  · omega
  · simp [eastPrefix, h]

/-- The directed-path comparison equals componentwise comparison of cells. -/
theorem fenceLE_iff_ribbon_coordinates (steps : ℕ → Bool) (n : ℕ)
    (i j : Fin (n + 1)) :
    fenceLE steps i.val j.val ↔
      ribbonRow steps n i ≤ ribbonRow steps n j ∧
      ribbonCol steps n i ≤ ribbonCol steps n j := by
  constructor
  · intro h
    rcases h with ⟨hij, hn⟩ | ⟨hji, he⟩
    · have he_le := eastPrefix_mono steps hij
      constructor
      · simp only [ribbonRow]
        omega
      · exact he_le
    · have hn_le := northPrefix_mono steps hji
      constructor
      · simp only [ribbonRow]
        omega
      · exact le_of_eq he.symm
  · rintro ⟨hr, hc⟩
    have hni : northPrefix steps i.val ≤ northPrefix steps n :=
      northPrefix_mono steps (index_le n i)
    have hnj : northPrefix steps j.val ≤ northPrefix steps n :=
      northPrefix_mono steps (index_le n j)
    rcases le_total i.val j.val with hij | hji
    · left
      have hn_le := northPrefix_mono steps hij
      constructor
      · exact hij
      · simp only [ribbonRow] at hr
        omega
    · right
      have he_le := eastPrefix_mono steps hji
      constructor
      · exact hji
      · exact le_antisymm he_le hc

/-- An oriented fence with `n` edges, represented by its `n + 1` vertices. -/
structure FenceVertex (steps : ℕ → Bool) (n : ℕ) where
  index : Fin (n + 1)

/-- The intrinsic order of the directed Hasse path.
    The subsequent theorem identifies it with `fenceLE`. -/
instance fencePartialOrder (steps : ℕ → Bool) (n : ℕ) :
    PartialOrder (FenceVertex steps n) where
  le a b :=
    ribbonRow steps n a.index ≤ ribbonRow steps n b.index ∧
    ribbonCol steps n a.index ≤ ribbonCol steps n b.index
  le_refl a := ⟨le_refl _, le_refl _⟩
  le_trans a b c hab hbc :=
    ⟨hab.1.trans hbc.1, hab.2.trans hbc.2⟩
  le_antisymm a b hab hba := by
    have hcoord : ribbonCell steps n a.index = ribbonCell steps n b.index := by
      apply Prod.ext
      · exact le_antisymm hab.1 hba.1
      · exact le_antisymm hab.2 hba.2
    have hi : a.index = b.index := ribbonCell_injective steps n hcoord
    cases a with
    | mk i =>
      cases b with
      | mk j =>
        dsimp at hi
        cases hi
        rfl

/-- A comparison in the fence is exactly a directed-path comparison. -/
theorem fence_order_iff (steps : ℕ → Bool) (n : ℕ)
    (a b : FenceVertex steps n) :
    a ≤ b ↔ fenceLE steps a.index.val b.index.val := by
  exact (fenceLE_iff_ribbon_coordinates steps n a.index b.index).symm

/-- A ribbon cell is a pair of coordinates lying on the constructed path. -/
abbrev RibbonCell (steps : ℕ → Bool) (n : ℕ) :=
  {p : ℕ × ℕ // p ∈ ribbonCells steps n}

/-- Lemma 2.3, constructive direction: the cell poset of the northeast
    skew ribbon is order-isomorphic to the prescribed oriented fence. -/
noncomputable def fenceRibbonOrderIso (steps : ℕ → Bool) (n : ℕ) :
    FenceVertex steps n ≃o RibbonCell steps n := by
  classical
  let f : FenceVertex steps n → RibbonCell steps n :=
    fun a => ⟨ribbonCell steps n a.index, ⟨a.index, rfl⟩⟩
  have hf_injective : Function.Injective f := by
    intro a b hab
    have hc : ribbonCell steps n a.index = ribbonCell steps n b.index :=
      congrArg Subtype.val hab
    have hi : a.index = b.index := ribbonCell_injective steps n hc
    cases a with
    | mk i =>
      cases b with
      | mk j =>
        dsimp at hi
        cases hi
        rfl
  have hf_surjective : Function.Surjective f := by
    intro p
    rcases p with ⟨p, hp⟩
    rcases hp with ⟨i, hi⟩
    refine ⟨⟨i⟩, ?_⟩
    apply Subtype.ext
    exact hi
  let e : FenceVertex steps n ≃ RibbonCell steps n :=
    Equiv.ofBijective f ⟨hf_injective, hf_surjective⟩
  exact
    { toEquiv := e
      map_rel_iff' := by
        intro a b
        change
          (ribbonRow steps n a.index ≤ ribbonRow steps n b.index ∧
           ribbonCol steps n a.index ≤ ribbonCol steps n b.index) ↔
          (ribbonRow steps n a.index ≤ ribbonRow steps n b.index ∧
           ribbonCol steps n a.index ≤ ribbonCol steps n b.index)
        rfl }

/-- Conversely, every ribbon presented by an east/north path has the
    oriented fence as its cell poset. The inverse is an order isomorphism. -/
noncomputable def ribbonFenceOrderIso (steps : ℕ → Bool) (n : ℕ) :
    RibbonCell steps n ≃o FenceVertex steps n :=
  (fenceRibbonOrderIso steps n).symm

end FenceRibbon
end OrderIdealSpecializations

/-! ### §2.1 — Lemma 2.4: unit-bounded weights have gapless ideal support

The proof does not require choosing a path between two arbitrary ideals.
A nonempty lower ideal has a maximal element; removing that element again
produces a lower ideal. Strong induction on the ideal then shows that all
integer weights between zero and its total weight are realized by subideals.
The full no-gap result follows by applying this statement to an ideal below
and an ideal above the desired weight. This is stronger than merely stating
that the minimum and maximum attainable exponents have no gaps.

No unimodality or log-concavity claim is made here. -/
namespace OrderIdealSpecializations
namespace FinitePoset

variable {α : Type*} [PartialOrder α] [Fintype α]

/-- A weight function takes values in the integer interval `[-1,1]`. -/
def UnitBoundedWeights (w : α → ℤ) : Prop :=
  ∀ a : α, -1 ≤ w a ∧ w a ≤ 1

omit [Fintype α] in
/-- Removing a maximal element of a nonempty ideal leaves an ideal.
    This is the one-cell accessibility property of the ideal lattice. -/
theorem exists_maximal_ideal_erase
    [DecidableEq α]
    (I : Finset α) (hI : IsIdeal I) (hne : I.Nonempty) :
    ∃ a : α, a ∈ I ∧ IsIdeal (I.erase a) := by
  classical
  obtain ⟨a, hmax⟩ := Finset.exists_maximal hne
  have ha : a ∈ I := hmax.1
  have hmax' : ∀ ⦃b : α⦄, b ∈ I → a ≤ b → a = b :=
    (maximal_iff.mp hmax).2
  refine ⟨a, ha, ?_⟩
  intro x y hxy hy
  rcases Finset.mem_erase.mp hy with ⟨hyne, hyI⟩
  have hxI : x ∈ I := hI hxy hyI
  have hxne : x ≠ a := by
    intro hxa
    subst x
    have hay : a = y := hmax' hyI hxy
    exact hyne hay.symm
  exact Finset.mem_erase.mpr ⟨hxne, hxI⟩

omit [Fintype α] in
/-- Between zero and the total weight of an ideal, each integer weight
    occurs on a lower ideal contained in the original one. This handles
    both positive and negative total weights. -/
theorem ideal_weight_interval_from_zero
    (w : α → ℤ) (hw : UnitBoundedWeights w)
    (I : Finset α) (hI : IsIdeal I) (z : ℤ)
    (hz : (0 ≤ z ∧ z ≤ weight w I) ∨
          (weight w I ≤ z ∧ z ≤ 0)) :
    ∃ J : Finset α, IsIdeal J ∧ J ⊆ I ∧ weight w J = z := by
  classical
  have main : ∀ S : Finset α, IsIdeal S →
      ∀ v : ℤ,
        ((0 ≤ v ∧ v ≤ weight w S) ∨
         (weight w S ≤ v ∧ v ≤ 0)) →
        ∃ T : Finset α, IsIdeal T ∧ T ⊆ S ∧ weight w T = v := by
    intro S
    refine Finset.strongInductionOn S ?_
    intro T ih hT v hv
    by_cases hEmpty : T = ∅
    · subst T
      have hv0 : v = 0 := by
        have hs0 : weight w (∅ : Finset α) = 0 := by
          simp [weight]
        rw [hs0] at hv
        omega
      refine ⟨∅, empty_isIdeal, ?_, ?_⟩
      · simp
      · simp [weight, hv0]
    · have hne : T.Nonempty := Finset.nonempty_iff_ne_empty.mpr hEmpty
      obtain ⟨a, ha, hErase⟩ := exists_maximal_ideal_erase T hT hne
      have hss : T.erase a ⊂ T := Finset.erase_ssubset ha
      have hweight : weight w T = weight w (T.erase a) + w a := by
        unfold weight
        exact (Finset.sum_erase_add T w ha).symm
      by_cases hIn :
          (0 ≤ v ∧ v ≤ weight w (T.erase a)) ∨
          (weight w (T.erase a) ≤ v ∧ v ≤ 0)
      · obtain ⟨U, hU, hUT, hUv⟩ :=
          ih (T.erase a) hss hErase v hIn
        exact ⟨U, hU, hUT.trans (Finset.erase_subset a T), hUv⟩
      · have hvEq : v = weight w T := by
          have hbound := hw a
          omega
        exact ⟨T, hT, Finset.Subset.refl T, hvEq.symm⟩
  exact main I hI z hz

omit [Fintype α] in
/-- Lemma 2.4 (no-gap form). If two ideal weights straddle an integer,
    that integer is attained by an ideal. The two bounding ideals need
    not be comparable by inclusion. -/
theorem no_gap_between_ideal_weights
    (w : α → ℤ) (hw : UnitBoundedWeights w)
    (A B : Finset α) (hA : IsIdeal A) (hB : IsIdeal B)
    (z : ℤ) (hlo : weight w A ≤ z) (hhi : z ≤ weight w B) :
    ∃ K : Finset α, IsIdeal K ∧ weight w K = z := by
  rcases le_total 0 z with hz | hz
  · obtain ⟨K, hK, _, hKz⟩ :=
      ideal_weight_interval_from_zero w hw B hB z (Or.inl ⟨hz, hhi⟩)
    exact ⟨K, hK, hKz⟩
  · obtain ⟨K, hK, _, hKz⟩ :=
      ideal_weight_interval_from_zero w hw A hA z (Or.inr ⟨hlo, hz⟩)
    exact ⟨K, hK, hKz⟩

/-- The coefficient at exponent `z` in the formal weighted ideal sum:
    it counts lower ideals having weight exactly `z`. -/
noncomputable def weightedRankCoefficient (w : α → ℤ) (z : ℤ) : ℕ := by
  classical
  exact ((ideals (α := α)).filter (fun I => weight w I = z)).card

/-- A realizable weight has a strictly positive coefficient. -/
theorem weightedRankCoefficient_pos_of_ideal
    (w : α → ℤ) (z : ℤ) (K : Finset α)
    (hK : IsIdeal K) (hKz : weight w K = z) :
    0 < weightedRankCoefficient (α := α) w z := by
  classical
  unfold weightedRankCoefficient
  apply Finset.card_pos.mpr
  exact ⟨K, Finset.mem_filter.mpr ⟨(mem_ideals K).mpr hK, hKz⟩⟩

/-- Lemma 2.4, coefficient formulation: under unit-bounded integer
    weights, every exponent lying between two attained ideal weights
    has a nonzero coefficient. -/
theorem weightedRankCoefficient_no_gaps
    (w : α → ℤ) (hw : UnitBoundedWeights w)
    (A B : Finset α) (hA : IsIdeal A) (hB : IsIdeal B)
    (z : ℤ) (hlo : weight w A ≤ z) (hhi : z ≤ weight w B) :
    0 < weightedRankCoefficient (α := α) w z := by
  obtain ⟨K, hK, hKz⟩ :=
    no_gap_between_ideal_weights w hw A B hA hB z hlo hhi
  exact weightedRankCoefficient_pos_of_ideal w z K hK hKz

end FinitePoset
end OrderIdealSpecializations

/-! ### §2.1 — Remark 2.5: gapless support need not be unimodal

The poset is the six-element chain `Fin 6`.  Its seven lower ideals
are initial segments.  The weights, from bottom to top, are
`(-1,1,1,1,1,-1)`; the successive ideal weights are
`(0,-1,0,1,2,3,2)`. The normalized coefficient
sequence is `(1,2,1,2,1)` and that it cannot have a unimodal peak.

The finite computation is linked to the *actual* ideal enumerator,
not merely to a detached list of numbers. -/
namespace OrderIdealSpecializations
namespace ChainCounterexample

/-- The initial segment of the six-element chain of length `k`. -/
def chainIdeal (k : Fin 7) : Finset (Fin 6) :=
  Finset.univ.filter (fun i : Fin 6 => i.val < k.val)

/-- The six weights from Remark 2.5. -/
def chainWeight (i : Fin 6) : ℤ :=
  if i.val = 0 ∨ i.val = 5 then -1 else 1

/-- Every explicitly enumerated initial segment is a lower ideal. -/
theorem chainIdeal_isIdeal (k : Fin 7) :
    FinitePoset.IsIdeal (chainIdeal k) := by
  intro a b hab hb
  simp only [chainIdeal, Finset.mem_filter, Finset.mem_univ, true_and] at hb ⊢
  exact lt_of_le_of_lt (Fin.le_iff_val_le_val.mp hab) hb

/-- Different lengths give different ideals. -/
theorem chainIdeal_injective : Function.Injective chainIdeal := by
  decide

/-- Conversely, there are no ideals of the six-element chain other than
    the seven displayed initial segments. -/
theorem chainIdeal_surjective :
    ∀ I : Finset (Fin 6),
      FinitePoset.IsIdeal I → ∃ k : Fin 7, chainIdeal k = I := by
  classical
  change ∀ I : Finset (Fin 6),
    (∀ a b : Fin 6, a ≤ b → b ∈ I → a ∈ I) →
      ∃ k : Fin 7, chainIdeal k = I
  decide

/-- The weighting satisfies the hypothesis of the no-gap lemma. -/
theorem chainWeight_unitBounded :
    FinitePoset.UnitBoundedWeights chainWeight := by
  intro i
  fin_cases i <;> norm_num [chainWeight]

/-- The weights of the seven ideals, in order of their lengths. -/
theorem chainIdeal_weight_table :
    List.ofFn (fun k : Fin 7 =>
      FinitePoset.weight chainWeight (chainIdeal k)) =
        ([0, -1, 0, 1, 2, 3, 2] : List ℤ) := by
  decide

/-- A computationally explicit count over the seven initial segments. -/
def prefixCoefficient (z : ℤ) : ℕ :=
  ((Finset.univ : Finset (Fin 7)).filter (fun k =>
    FinitePoset.weight chainWeight (chainIdeal k) = z)).card

/-- The computational count agrees with the coefficient defined using
    the full ideal lattice (not just a list of selected ideals). -/
theorem weightedRankCoefficient_eq_prefixCoefficient (z : ℤ) :
    FinitePoset.weightedRankCoefficient (α := Fin 6) chainWeight z =
      prefixCoefficient z := by
  classical
  let s : Finset (Fin 7) :=
    (Finset.univ : Finset (Fin 7)).filter (fun k =>
      FinitePoset.weight chainWeight (chainIdeal k) = z)
  have hsets :
      ((FinitePoset.ideals (α := Fin 6)).filter (fun I =>
        FinitePoset.weight chainWeight I = z)) =
      s.image chainIdeal := by
    ext I
    constructor
    · intro hI
      obtain ⟨hIdeal, hwt⟩ := Finset.mem_filter.mp hI
      obtain ⟨k, hk⟩ :=
        chainIdeal_surjective I ((FinitePoset.mem_ideals I).mp hIdeal)
      apply Finset.mem_image.mpr
      refine ⟨k, ?_, hk⟩
      apply Finset.mem_filter.mpr
      constructor
      · exact Finset.mem_univ k
      · rw [hk]
        exact hwt
    · intro hI
      obtain ⟨k, hk, hkI⟩ := Finset.mem_image.mp hI
      have hwt : FinitePoset.weight chainWeight (chainIdeal k) = z :=
        (Finset.mem_filter.mp hk).2
      apply Finset.mem_filter.mpr
      constructor
      · apply (FinitePoset.mem_ideals I).mpr
        rw [← hkI]
        exact chainIdeal_isIdeal k
      · rw [← hkI]
        exact hwt
  calc
    FinitePoset.weightedRankCoefficient (α := Fin 6) chainWeight z =
        ((FinitePoset.ideals (α := Fin 6)).filter (fun I =>
          FinitePoset.weight chainWeight I = z)).card := by
            rfl
    _ = (s.image chainIdeal).card := congrArg Finset.card hsets
    _ = s.card := Finset.card_image_of_injective s chainIdeal_injective
    _ = prefixCoefficient z := by
          unfold prefixCoefficient
          congr 1

/-- The coefficient of the normalized polynomial at degree `i`.
    Its exponent in the original Laurent polynomial is `i - 1`. -/
def normalizedPrefixCoefficient (i : Fin 5) : ℕ :=
  prefixCoefficient ((i.val : ℤ) - 1)

/-- The numerical coefficient sequence from Remark 2.5. -/
theorem normalizedPrefixCoefficient_table :
    List.ofFn normalizedPrefixCoefficient =
      ([1, 2, 1, 2, 1] : List ℕ) := by
  decide

/-- A five-term sequence is unimodal if it weakly increases up to
    some position and weakly decreases afterward. -/
def UnimodalFive (a : Fin 5 → ℕ) : Prop :=
  ∃ peak : Fin 5,
    (∀ i j : Fin 5, i ≤ j → j ≤ peak → a i ≤ a j) ∧
    (∀ i j : Fin 5, peak ≤ i → i ≤ j → a j ≤ a i)

/-- The middle dip `2,1,2` prevents unimodality. -/
theorem normalizedPrefixCoefficient_not_unimodal :
    ¬ UnimodalFive normalizedPrefixCoefficient := by
  have h1 : normalizedPrefixCoefficient (1 : Fin 5) = 2 := by decide
  have h2 : normalizedPrefixCoefficient (2 : Fin 5) = 1 := by decide
  have h3 : normalizedPrefixCoefficient (3 : Fin 5) = 2 := by decide
  rintro ⟨peak, hinc, hdec⟩
  by_cases hp : (2 : Fin 5) ≤ peak
  · have h12 :
        normalizedPrefixCoefficient (1 : Fin 5) ≤
          normalizedPrefixCoefficient (2 : Fin 5) :=
        hinc 1 2 (by decide) hp
    rw [h1, h2] at h12
    omega
  · have hp' : peak ≤ (2 : Fin 5) :=
      le_of_lt (lt_of_not_ge hp)
    have h23 :
        normalizedPrefixCoefficient (3 : Fin 5) ≤
          normalizedPrefixCoefficient (2 : Fin 5) :=
        hdec 2 3 hp' (by decide)
    rw [h2, h3] at h23
    omega

/-- The same coefficients, this time defined via all genuine lower
    ideals of the chain and the manuscript's `weightedRankCoefficient`. -/
noncomputable def normalizedIdealCoefficient (i : Fin 5) : ℕ :=
  FinitePoset.weightedRankCoefficient (α := Fin 6)
    chainWeight ((i.val : ℤ) - 1)

theorem normalizedIdealCoefficient_eq (i : Fin 5) :
    normalizedIdealCoefficient i = normalizedPrefixCoefficient i := by
  exact weightedRankCoefficient_eq_prefixCoefficient ((i.val : ℤ) - 1)

/-- The normalized weighted *ideal* polynomial has coefficients
    `(1,2,1,2,1)`. -/
theorem normalizedIdealCoefficient_table :
    List.ofFn normalizedIdealCoefficient =
      ([1, 2, 1, 2, 1] : List ℕ) := by
  have heq : normalizedIdealCoefficient = normalizedPrefixCoefficient := by
    funext i
    exact normalizedIdealCoefficient_eq i
  simpa only [heq] using normalizedPrefixCoefficient_table

/-- Remark 2.5: unit-bounded weights and gapless support do not
    guarantee unimodality, even on a finite chain. -/
theorem normalizedIdealCoefficient_not_unimodal :
    ¬ UnimodalFive normalizedIdealCoefficient := by
  have heq : normalizedIdealCoefficient = normalizedPrefixCoefficient := by
    funext i
    exact normalizedIdealCoefficient_eq i
  rw [heq]
  exact normalizedPrefixCoefficient_not_unimodal

end ChainCounterexample
end OrderIdealSpecializations

/-! ## §2.2 — Surface coefficients as weighted ideals

This section isolates the *algebraic* content of equation (2.6).
A principal-coefficient ideal expansion has one monomial for each lower
ideal.  A label `labels p` selects the coefficient variable of a cell,
and `shear` assigns an integer exponent to that variable.

For nonzero rational `q`, substituting `y_j = q ^ shear j` turns each
ideal monomial into `q ^ weight I`.  Multiplying by `q ^ (-shift)`
then translates every exponent by `-shift`.  In geometric applications,
`shift` is the minimal ideal weight, provided the geometric expansion
and tropical normalization have been justified separately.

In particular, the theorems below do not claim to establish the
snake-graph expansion, the lamination shear coordinates, or the
separation formula: these are independent geometric hypotheses. -/
namespace OrderIdealSpecializations
namespace SurfaceCoefficients

universe u v

variable {α : Type u} [PartialOrder α] [Fintype α]
variable {κ : Type v}

/-- Evaluation of a principal-coefficient *ideal* expansion: one
    monomial, obtained by multiplying the cell labels, per ideal. -/
noncomputable def principalIdealEvaluation
    (labels : α → κ) (y : κ → ℚ) : ℚ := by
  classical
  exact (FinitePoset.ideals (α := α)).sum (fun I =>
    I.prod (fun p => y (labels p)))

omit [PartialOrder α] [Fintype α] in
/-- A product of substituted coefficient variables equals the
    integer-power monomial of the total shear weight of its cells. -/
theorem monomial_eq_weight_power
    (labels : α → κ) (shear : κ → ℤ)
    (q : ℚ) (hq : q ≠ 0) (I : Finset α) :
    I.prod (fun p => q ^ shear (labels p)) =
      q ^ FinitePoset.weight (shear ∘ labels) I := by
  classical
  change I.prod (fun p => q ^ shear (labels p)) =
    q ^ I.sum (fun p => shear (labels p))
  induction I using Finset.induction_on with
  | empty =>
      simp
  | @insert a I ha ih =>
      simp only [Finset.prod_insert ha, Finset.sum_insert ha]
      rw [ih, zpow_add₀ hq]

/-- Equation (2.5), after a one-parameter shear substitution:
    the evaluated principal ideal expansion is exactly the weighted
    rank enumerator of the underlying poset. -/
theorem principalIdealEvaluation_eq_weightedRank
    (labels : α → κ) (shear : κ → ℤ)
    (q : ℚ) (hq : q ≠ 0) :
    principalIdealEvaluation labels (fun j => q ^ shear j) =
      FinitePoset.weightedRank (shear ∘ labels) q := by
  classical
  unfold principalIdealEvaluation FinitePoset.weightedRank
  apply Finset.sum_congr rfl
  intro I _
  exact monomial_eq_weight_power labels shear q hq I

/-- The uniform principal specialization is the ordinary rank
    enumerator.  This identity holds even at `q = 0`. -/
theorem principalIdealEvaluation_uniform
    (labels : α → κ) (q : ℚ) :
    principalIdealEvaluation labels (fun _ => q) =
      FinitePoset.rank (α := α) q := by
  classical
  unfold principalIdealEvaluation FinitePoset.rank
  apply Finset.sum_congr rfl
  intro I _
  exact Finset.prod_const (s := I) q

/-- A normalized one-parameter specialization, with a freely chosen
    integer shift (the tropical minimum in the geometric setting). -/
noncomputable def normalizedSurfaceEvaluation
    (labels : α → κ) (shear : κ → ℤ)
    (shift : ℤ) (q : ℚ) : ℚ :=
  q ^ (-shift) * principalIdealEvaluation labels (fun j => q ^ shear j)

/-- The normalized specialization is a sum over genuine ideals,
    whose exponents are their shear weights minus the shift. -/
theorem normalizedSurfaceEvaluation_eq_ideal_sum
    (labels : α → κ) (shear : κ → ℤ)
    (shift : ℤ) (q : ℚ) (hq : q ≠ 0) :
    normalizedSurfaceEvaluation labels shear shift q =
      (FinitePoset.ideals (α := α)).sum (fun I =>
        q ^ (FinitePoset.weight (shear ∘ labels) I - shift)) := by
  classical
  unfold normalizedSurfaceEvaluation
  rw [principalIdealEvaluation_eq_weightedRank labels shear q hq]
  unfold FinitePoset.weightedRank
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro I _
  rw [← zpow_add₀ hq]
  congr 1
  omega

/-- Equation (2.6), in the exact form justified by the ideal model:
    the surface specialization is a shifted `t = 2` slice of `H`. -/
theorem normalizedSurfaceEvaluation_eq_H_two
    (labels : α → κ) (shear : κ → ℤ)
    (shift : ℤ) (q : ℚ) (hq : q ≠ 0) :
    normalizedSurfaceEvaluation labels shear shift q =
      q ^ (-shift) * FinitePoset.H (shear ∘ labels) 2 q := by
  unfold normalizedSurfaceEvaluation
  rw [principalIdealEvaluation_eq_weightedRank labels shear q hq]
  rw [FinitePoset.H_two]

omit [Fintype α] in
/-- If `shift` is a lower bound on all ideal weights, every
    normalized exponent is nonnegative. -/
theorem normalized_exponent_nonnegative
    (labels : α → κ) (shear : κ → ℤ) (shift : ℤ)
    (hshift : ∀ I : Finset α, FinitePoset.IsIdeal I →
      shift ≤ FinitePoset.weight (shear ∘ labels) I)
    (I : Finset α) (hI : FinitePoset.IsIdeal I) :
    0 ≤ FinitePoset.weight (shear ∘ labels) I - shift := by
  exact sub_nonneg.mpr (hshift I hI)

/-- The coefficient at normalized degree `degree`, defined by
    counting the ideals which contribute at that degree. -/
noncomputable def normalizedCoefficient
    (labels : α → κ) (shear : κ → ℤ)
    (shift degree : ℤ) : ℕ := by
  classical
  exact ((FinitePoset.ideals (α := α)).filter (fun I =>
    FinitePoset.weight (shear ∘ labels) I - shift = degree)).card

/-- Translating exponents by `shift` translates their coefficient
    indices; no additional geometric assumption is involved. -/
theorem normalizedCoefficient_eq_weightedRankCoefficient
    (labels : α → κ) (shear : κ → ℤ)
    (shift degree : ℤ) :
    normalizedCoefficient labels shear shift degree =
      FinitePoset.weightedRankCoefficient (shear ∘ labels)
        (degree + shift) := by
  classical
  unfold normalizedCoefficient FinitePoset.weightedRankCoefficient
  apply congrArg Finset.card
  ext I
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hI, hw⟩
    exact ⟨hI, by omega⟩
  · rintro ⟨hI, hw⟩
    exact ⟨hI, by omega⟩

/-- Lemma 2.4 transported to a shear specialization: weights in
    `[-1,1]` imply gapless normalized support, not unimodality. -/
theorem normalizedCoefficient_no_gaps
    (labels : α → κ) (shear : κ → ℤ) (shift : ℤ)
    (hunit : FinitePoset.UnitBoundedWeights (shear ∘ labels))
    (A B : Finset α) (hA : FinitePoset.IsIdeal A)
    (hB : FinitePoset.IsIdeal B) (degree : ℤ)
    (hlo : FinitePoset.weight (shear ∘ labels) A - shift ≤ degree)
    (hhi : degree ≤ FinitePoset.weight (shear ∘ labels) B - shift) :
    0 < normalizedCoefficient labels shear shift degree := by
  rw [normalizedCoefficient_eq_weightedRankCoefficient]
  apply FinitePoset.weightedRankCoefficient_no_gaps
    (shear ∘ labels) hunit A B hA hB (degree + shift)
  · omega
  · omega

end SurfaceCoefficients
end OrderIdealSpecializations

/-! ## §3 — An annular test of two published assertions

The rank-two exchanges below are formalized algebraically. The surface
interpretation uses the sign and single-curve conventions clarified in
the 10 November 2026 correspondence with A. Felikson and W. Kang;
those geometric facts are not Lean theorems.

### §3.1–3.2 — The published induction and the first annular mutation -/
namespace OrderIdealSpecializations
namespace AnnularFirstMutation

/-- The extended Kronecker exchange matrix of equation (3.2).
    Rows 0,1 are mutable; row 2 is frozen. -/
def extendedMatrix (r : ℕ) : Matrix (Fin 3) (Fin 2) ℤ :=
  fun i j =>
    if i = 0 then (if j = 0 then 0 else 2)
    else if i = 1 then (if j = 0 then -2 else 0)
    else if j = 0 then (r : ℤ) else -((r : ℤ) + 1)

/-- The first column is `(0,-2,r)`. -/
theorem first_column (r : ℕ) :
    extendedMatrix r 0 0 = 0 ∧
    extendedMatrix r 1 0 = -2 ∧
    extendedMatrix r 2 0 = (r : ℤ) := by
  simp [extendedMatrix]

/-- Positive part of the exchange monomial in direction 0. -/
def positiveTerm (r : ℕ) (x₁ x₂ q : ℚ) : ℚ :=
  x₁ ^ (extendedMatrix r 0 0).toNat *
  x₂ ^ (extendedMatrix r 1 0).toNat *
  q ^ (extendedMatrix r 2 0).toNat

/-- Negative part of the exchange monomial in direction 0. -/
def negativeTerm (r : ℕ) (x₁ x₂ q : ℚ) : ℚ :=
  x₁ ^ (-(extendedMatrix r 0 0)).toNat *
  x₂ ^ (-(extendedMatrix r 1 0)).toNat *
  q ^ (-(extendedMatrix r 2 0)).toNat

/-- The positive monomial in the first exchange is `q^r`. -/
theorem positiveTerm_eq (r : ℕ) (x₁ x₂ q : ℚ) :
    positiveTerm r x₁ x₂ q = q ^ r := by
  simp [positiveTerm, extendedMatrix]

/-- The negative monomial in the first exchange is `x₂^2`. -/
theorem negativeTerm_eq (r : ℕ) (x₁ x₂ q : ℚ) :
    negativeTerm r x₁ x₂ q = x₂ ^ 2 := by
  simp [negativeTerm, extendedMatrix]

/-- The full first exchange numerator, read from the extended matrix. -/
def exchangeNumerator (r : ℕ) (x₁ x₂ q : ℚ) : ℚ :=
  positiveTerm r x₁ x₂ q + negativeTerm r x₁ x₂ q

theorem exchangeNumerator_eq (r : ℕ) (x₁ x₂ q : ℚ) :
    exchangeNumerator r x₁ x₂ q = x₂ ^ 2 + q ^ r := by
  rw [exchangeNumerator, positiveTerm_eq, negativeTerm_eq]
  ring

/-- The first cluster-variable mutation over rational specializations. -/
def firstMutation (r : ℕ) (x₁ x₂ q : ℚ) : ℚ :=
  exchangeNumerator r x₁ x₂ q / x₁

/-- The exchange identity for nonzero `x₁`. -/
theorem firstMutation_exchange (r : ℕ) (x₁ x₂ q : ℚ)
    (hx₁ : x₁ ≠ 0) :
    x₁ * firstMutation r x₁ x₂ q = x₂ ^ 2 + q ^ r := by
  unfold firstMutation
  rw [exchangeNumerator_eq]
  field_simp [hx₁]

/-- Equation (3.3), after `x₁ = x₂ = 1`. -/
theorem firstMutation_specialized (r : ℕ) (q : ℚ) :
    firstMutation r 1 1 q = 1 + q ^ r := by
  simp [firstMutation, exchangeNumerator_eq]

/-- The actual polynomial produced by the first specialized exchange. -/
noncomputable def firstPolynomial (r : ℕ) : Polynomial ℚ :=
  1 + Polynomial.X ^ r

theorem firstPolynomial_eval (r : ℕ) (q : ℚ) :
    (firstPolynomial r).eval q = firstMutation r 1 1 q := by
  rw [firstMutation_specialized]
  simp [firstPolynomial]

/-- The coefficient function of `1 + q^r` when `r >= 2`. -/
def firstCoefficient (r n : ℕ) : ℚ :=
  if n = 0 then 1 else if n = r then 1 else 0

/-- All coefficients, including the intervening zero coefficients. -/
theorem firstPolynomial_coeff (r n : ℕ) (hr : 2 ≤ r) :
    (firstPolynomial r).coeff n = firstCoefficient r n := by
  have hr0 : r ≠ 0 := by omega
  by_cases hn0 : n = 0
  · subst n
    simp [firstPolynomial, firstCoefficient, Polynomial.coeff_one,
      Polynomial.coeff_X_pow]; omega
  · by_cases hnr : n = r
    · subst n
      simp [firstPolynomial, firstCoefficient, Polynomial.coeff_one,
        Polynomial.coeff_X_pow, hr0]
    · have h0n : 0 ≠ n := Ne.symm hn0
      simp [firstPolynomial, firstCoefficient, Polynomial.coeff_one, Polynomial.coeff_X_pow, hn0,
        hnr]

/-- Unimodality for a finite rational-valued coefficient sequence. -/
def Unimodal {n : ℕ} (a : Fin n → ℚ) : Prop :=
  ∃ peak : Fin n,
    (∀ i j : Fin n, i ≤ j → j ≤ peak → a i ≤ a j) ∧
    (∀ i j : Fin n, peak ≤ i → i ≤ j → a j ≤ a i)

/-- The coefficient sequence of `1 + q^r` is not unimodal for `r >= 2`. -/
theorem firstCoefficient_not_unimodal (r : ℕ) (hr : 2 ≤ r) :
    ¬ Unimodal (fun i : Fin (r + 1) => firstCoefficient r i.val) := by
  let i₀ : Fin (r + 1) := ⟨0, by omega⟩
  let i₁ : Fin (r + 1) := ⟨1, by omega⟩
  let iᵣ : Fin (r + 1) := ⟨r, by omega⟩
  have h01 : i₀ ≤ i₁ := by
    change (0 : ℕ) ≤ 1
    omega
  have h1r : i₁ ≤ iᵣ := by
    change (1 : ℕ) ≤ r
    omega
  have hc0 : firstCoefficient r i₀.val = 1 := by
    simp [i₀, firstCoefficient]
  have hc1 : firstCoefficient r i₁.val = 0 := by
    have h1r' : 1 ≠ r := by omega
    simp [i₁, firstCoefficient, h1r']
  have hcr : firstCoefficient r iᵣ.val = 1 := by
    have hr0 : r ≠ 0 := by omega
    simp [iᵣ, firstCoefficient, hr0]
  rintro ⟨peak, hinc, hdec⟩
  by_cases hp : i₁ ≤ peak
  · have hbad := hinc i₀ i₁ h01 hp
    change firstCoefficient r i₀.val ≤ firstCoefficient r i₁.val at hbad
    rw [hc0, hc1] at hbad
    norm_num at hbad
  · have hp' : peak ≤ i₁ := le_of_lt (lt_of_not_ge hp)
    have hbad := hdec i₁ iᵣ hp' h1r
    change firstCoefficient r iᵣ.val ≤ firstCoefficient r i₁.val at hbad
    rw [hc1, hcr] at hbad
    norm_num at hbad

/-- Theorem 3.2, algebraic conclusion: the true polynomial coefficients
    from the first exchange fail unimodality for every `r >= 2`. -/
theorem firstPolynomial_not_unimodal (r : ℕ) (hr : 2 ≤ r) :
    ¬ Unimodal (fun i : Fin (r + 1) => (firstPolynomial r).coeff i.val) := by
  have hcoeff :
      (fun i : Fin (r + 1) => (firstPolynomial r).coeff i.val) =
        (fun i : Fin (r + 1) => firstCoefficient r i.val) := by
    funext i
    exact firstPolynomial_coeff r i.val hr
  rw [hcoeff]
  exact firstCoefficient_not_unimodal r hr

/-- The degree-one coefficient in `1 + q^2` violates log-concavity:
    `a₁² = 0 < 1 = a₀ * a₂`. -/
theorem firstPolynomial_two_not_logConcave :
    ((firstPolynomial 2).coeff 1) ^ 2 <
      (firstPolynomial 2).coeff 0 * (firstPolynomial 2).coeff 2 := by
  norm_num [firstPolynomial, Polynomial.coeff_one, Polynomial.coeff_X_pow]

end AnnularFirstMutation
end OrderIdealSpecializations

/-! ### §3 — Remark 3.3: the scope of the log-concavity obstruction. -/

/-! ### §3 — Proposition 3.4: four annular mutations

For the frozen row `(1,-2)`, the mutation sequence `(0,1,0,1)`
produces the successive specialized polynomials A, B, C, D.

The four exchange columns follow from the extended-matrix mutation
rule, and certify the successive *polynomial* exchange identities.
The latter contain no division and hold in `ℚ[X]`, so there is no
illicit substitution before division. Finally, all seven coefficients
of D are positive, but its coefficients in degrees 0,1,2 violate
log-concavity. As in Section 3.2, the annular realization of the
frozen row remains a separate geometric verification obligation. -/
namespace OrderIdealSpecializations
namespace AnnularFourthMutation

/-- The Fomin--Zelevinsky mutation of a 3-by-2 extended exchange matrix:
    its first two rows are mutable and its third row is frozen. -/
def mutateExtended (B : Matrix (Fin 3) (Fin 2) ℤ) (k : Fin 2) :
    Matrix (Fin 3) (Fin 2) ℤ :=
  fun i j =>
    if i.val = k.val ∨ j = k then -(B i j)
    else
      B i j +
        max (B i k) 0 * max (B ⟨k.val, by omega⟩ j) 0 -
        max (-(B i k)) 0 * max (-(B ⟨k.val, by omega⟩ j)) 0

/-- The four successive extended exchange matrices, starting with
    the single frozen row `(1,-2)` from equation (3.2). -/
def B₀ : Matrix (Fin 3) (Fin 2) ℤ :=
  AnnularFirstMutation.extendedMatrix 1

def B₁ : Matrix (Fin 3) (Fin 2) ℤ := mutateExtended B₀ 0

def B₂ : Matrix (Fin 3) (Fin 2) ℤ := mutateExtended B₁ 1

def B₃ : Matrix (Fin 3) (Fin 2) ℤ := mutateExtended B₂ 0

def B₄ : Matrix (Fin 3) (Fin 2) ℤ := mutateExtended B₃ 1

/-- The active columns of all four exchanges. These determine,
    respectively, `q + x₂²`, `1 + A²`, `1 + q * B²`, and `1 + C²`. -/
theorem four_active_columns :
    (B₀ 0 0 = 0 ∧ B₀ 1 0 = -2 ∧ B₀ 2 0 = 1) ∧
    (B₁ 0 1 = -2 ∧ B₁ 1 1 = 0 ∧ B₁ 2 1 = 0) ∧
    (B₂ 0 0 = 0 ∧ B₂ 1 0 = -2 ∧ B₂ 2 0 = -1) ∧
    (B₃ 0 1 = -2 ∧ B₃ 1 1 = 0 ∧ B₃ 2 1 = 0) := by
  norm_num [B₀, B₁, B₂, B₃, mutateExtended,
    AnnularFirstMutation.extendedMatrix]

/-- The first new cluster variable, specialized at the initial
    mutable variables `x₁=x₂=1`. -/
noncomputable def A : Polynomial ℚ :=
  1 + Polynomial.X

/-- The second new specialized variable. -/
noncomputable def B : Polynomial ℚ :=
  2 + Polynomial.C (2 : ℚ) * Polynomial.X + Polynomial.X ^ 2

/-- The third new specialized variable. -/
noncomputable def C : Polynomial ℚ :=
  1 + Polynomial.C (3 : ℚ) * Polynomial.X +
    Polynomial.C (5 : ℚ) * Polynomial.X ^ 2 +
    Polynomial.C (3 : ℚ) * Polynomial.X ^ 3 + Polynomial.X ^ 4

/-- The fourth new specialized variable, equation (3.4). -/
noncomputable def D : Polynomial ℚ :=
  1 + Polynomial.C (2 : ℚ) * Polynomial.X +
    Polynomial.C (7 : ℚ) * Polynomial.X ^ 2 +
    Polynomial.C (10 : ℚ) * Polynomial.X ^ 3 +
    Polynomial.C (9 : ℚ) * Polynomial.X ^ 4 +
    Polynomial.C (4 : ℚ) * Polynomial.X ^ 5 + Polynomial.X ^ 6

/-- First exchange after setting `x₁=x₂=1`: `A=1+q`. -/
theorem A_exchange : A = 1 + Polynomial.X := rfl

/-- The second exchange is exact in the polynomial ring. -/
theorem B_exchange : B = 1 + A ^ 2 := by
  simp only [A, B, Polynomial.C_ofNat]
  ring

/-- The third exchange has numerator `1+qB²` and denominator `A`.
    Expressing it without division certifies exact polynomial division. -/
theorem C_exchange : A * C = 1 + Polynomial.X * B ^ 2 := by
  simp only [A, B, C, Polynomial.C_ofNat]
  ring

/-- The fourth exchange has numerator `1+C²` and denominator `B`.
    Again this is an identity of polynomials, not just rational functions. -/
theorem D_exchange : B * D = 1 + C ^ 2 := by
  simp only [B, C, D, Polynomial.C_ofNat]
  ring

/-- The seven coefficients of the final polynomial are precisely
    `(1,2,7,10,9,4,1)`. -/
theorem D_coefficients :
    D.coeff 0 = 1 ∧ D.coeff 1 = 2 ∧ D.coeff 2 = 7 ∧
    D.coeff 3 = 10 ∧ D.coeff 4 = 9 ∧ D.coeff 5 = 4 ∧
    D.coeff 6 = 1 := by
  norm_num [D, Polynomial.coeff_add, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_pow, Polynomial.coeff_one]

/-- Every coefficient within the support interval is strictly positive. -/
theorem D_coeff_positive (i : Fin 7) : 0 < D.coeff i.val := by
  fin_cases i <;>
    norm_num [D, Polynomial.coeff_add, Polynomial.coeff_C_mul,
      Polynomial.coeff_X_pow, Polynomial.coeff_one]

/-- Proposition 3.4: full support does not imply log-concavity.
    Here `a₁²=4 < 7=a₀*a₂`. -/
theorem D_not_logConcave :
    (D.coeff 1) ^ 2 < D.coeff 0 * D.coeff 2 := by
  norm_num [D, Polynomial.coeff_add, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_pow, Polynomial.coeff_one]

end AnnularFourthMutation
end OrderIdealSpecializations

/-! ### §3 — Corollary 3.5: algebraic obstructions

The geometric assertion that the displayed frozen rows arise from
individual annular curves is not represented by the present model.
The following results describe the algebraic consequences of the stated
coefficient specializations; geometric realizability is a separate hypothesis. -/
namespace OrderIdealSpecializations
namespace AnnularConsequences

/-- The first annular polynomial at `r=2` cannot be either of the two
    polynomials claimed as the only possible first induction values. -/
theorem firstPolynomial_two_ne_one :
    AnnularFirstMutation.firstPolynomial 2 ≠ (1 : Polynomial ℚ) := by
  intro h
  have hc := congrArg (fun p : Polynomial ℚ => p.coeff 2) h
  norm_num [AnnularFirstMutation.firstPolynomial,
    Polynomial.coeff_one, Polynomial.coeff_X_pow] at hc

theorem firstPolynomial_two_ne_one_add_X :
    AnnularFirstMutation.firstPolynomial 2 ≠
      (1 + Polynomial.X : Polynomial ℚ) := by
  intro h
  have hc := congrArg (fun p : Polynomial ℚ => p.coeff 2) h
  norm_num [AnnularFirstMutation.firstPolynomial,
    Polynomial.coeff_one, Polynomial.coeff_X_pow] at hc
  simp [Polynomial.coeff_X] at hc

/-- Corollary 3.5, algebraic portion: the first annular exchange
    produces a non-unimodal coefficient sequence, and the final
    four-mutation polynomial violates the log-concavity inequality.
    No claim about geometric existence is hidden in this statement. -/
theorem algebraic_obstructions :
    (¬ AnnularFirstMutation.Unimodal
      (fun i : Fin 3 =>
        (AnnularFirstMutation.firstPolynomial 2).coeff i.val)) ∧
    (AnnularFourthMutation.D.coeff 1) ^ 2 <
      AnnularFourthMutation.D.coeff 0 * AnnularFourthMutation.D.coeff 2 := by
  exact ⟨AnnularFirstMutation.firstPolynomial_not_unimodal 2 (by omega),
    AnnularFourthMutation.D_not_logConcave⟩

end AnnularConsequences
end OrderIdealSpecializations

/-! ### §3 — Proposition 3.6: the one-cell common enumerator

The invariant `FinitePoset.H` is evaluated on a one-cell poset `Fin 1`
with weight `2`. Since the formalized parameter `t` is natural,
the identity is expressed as
`H(t+1;q) = t + q^2`, i.e. as equation (3.5) for positive arguments. -/
namespace OrderIdealSpecializations
namespace OneCellBridge

/-- The single cell receives shear weight two. -/
def oneCellWeight : Fin 1 → ℤ := fun _ => 2

/-- Every subset of a one-element poset is a lower ideal. -/
theorem oneCell_ideals :
    FinitePoset.ideals (α := Fin 1) =
      ({∅, Finset.univ} : Finset (Finset (Fin 1))) := by
  classical
  ext I
  simp only [FinitePoset.mem_ideals, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · intro _
    by_cases hI : (0 : Fin 1) ∈ I
    · right
      ext i
      have hi : i = (0 : Fin 1) := Subsingleton.elim i 0
      subst i
      simp [hI]
    · left
      ext i
      have hi : i = (0 : Fin 1) := Subsingleton.elim i 0
      subst i
      simp [hI]
  · rintro (rfl | rfl)
    · exact FinitePoset.empty_isIdeal
    · exact FinitePoset.univ_isIdeal

/-- The order polynomial of an inhabited subsingleton poset equals
    the number of available colors. -/
theorem omega_subsingleton
    {β : Type*} [PartialOrder β] [Fintype β]
    [Subsingleton β] [Nonempty β] (t : ℕ) :
    FinitePoset.omega (α := β) t = t := by
  classical
  have h_iso (f : β → Fin t) : FinitePoset.IsIsotone f := by
    intro a b _
    exact le_of_eq (congrArg f (Subsingleton.elim a b))
  let e₁ : {f : β → Fin t // FinitePoset.IsIsotone f} ≃ (β → Fin t) :=
    { toFun := fun f => f.1
      invFun := fun f => ⟨f, h_iso f⟩
      left_inv := by
        intro f
        apply Subtype.ext
        rfl
      right_inv := by intro f; rfl }
  let b : β := Classical.choice (inferInstance : Nonempty β)
  let e₂ : (β → Fin t) ≃ Fin t :=
    { toFun := fun f => f b
      invFun := fun x _ => x
      left_inv := by
        intro f
        funext x
        exact congrArg f (Subsingleton.elim b x)
      right_inv := by intro x; rfl }
  calc
    FinitePoset.omega (α := β) t =
        Fintype.card {f : β → Fin t // FinitePoset.IsIsotone f} :=
      FinitePoset.omega_eq_card_isotone (α := β) t
    _ = Fintype.card (β → Fin t) := Fintype.card_congr e₁
    _ = Fintype.card (Fin t) := Fintype.card_congr e₂
    _ = t := by simp

/-- The order polynomial of an empty poset is identically one. -/
theorem omega_isEmpty
    {β : Type*} [PartialOrder β] [Fintype β] [IsEmpty β] (t : ℕ) :
    FinitePoset.omega (α := β) t = 1 := by
  classical
  have h_iso (f : β → Fin t) : FinitePoset.IsIsotone f := by
    intro a b _
    exact isEmptyElim a
  let e₁ : {f : β → Fin t // FinitePoset.IsIsotone f} ≃ (β → Fin t) :=
    { toFun := fun f => f.1
      invFun := fun f => ⟨f, h_iso f⟩
      left_inv := by
        intro f
        apply Subtype.ext
        rfl
      right_inv := by intro f; rfl }
  let e₂ : (β → Fin t) ≃ PUnit.{1} :=
    { toFun := fun _ => PUnit.unit
      invFun := fun _ b => isEmptyElim b
      left_inv := by
        intro f
        funext x
        exact isEmptyElim x
      right_inv := by intro x; cases x; rfl }
  calc
    FinitePoset.omega (α := β) t =
        Fintype.card {f : β → Fin t // FinitePoset.IsIsotone f} :=
      FinitePoset.omega_eq_card_isotone (α := β) t
    _ = Fintype.card (β → Fin t) := Fintype.card_congr e₁
    _ = Fintype.card PUnit.{1} := Fintype.card_congr e₂
    _ = 1 := by simp

/-- Proposition 3.6, equation (3.5): the *general* ideal enumerator
    evaluated on the one-cell poset is `H(t+1;q) = t + q^2`.
    This is a natural-argument version of `H(t;q) = t-1 + q^2`. -/
theorem oneCell_H (t : ℕ) (q : ℚ) :
    FinitePoset.H oneCellWeight (t + 1) q = (t : ℚ) + q ^ 2 := by
  classical
  let : Nonempty {a : Fin 1 // a ∉ (∅ : Finset (Fin 1))} :=
    ⟨⟨0, by simp⟩⟩
  let : IsEmpty {a : Fin 1 // a ∉ (Finset.univ : Finset (Fin 1))} :=
    ⟨fun a => a.2 (Finset.mem_univ a.1)⟩
  have hnot : (∅ : Finset (Fin 1)) ∉
      ({Finset.univ} : Finset (Finset (Fin 1))) := by
    intro hm
    have heq : (∅ : Finset (Fin 1)) = Finset.univ :=
      Finset.mem_singleton.mp hm
    have h0 : (0 : Fin 1) ∈ (∅ : Finset (Fin 1)) := by
      rw [heq]
      simp
    simp at h0
  have ht : t + 1 - 1 = t := by omega
  have homegaEmpty :
      FinitePoset.omega
        (α := {a : Fin 1 // a ∉ (∅ : Finset (Fin 1))}) t = t :=
    omega_subsingleton t
  have homegaFull :
      FinitePoset.omega
        (α := {a : Fin 1 // a ∉ (Finset.univ : Finset (Fin 1))}) t = 1 :=
    omega_isEmpty t
  have hwEmpty :
      FinitePoset.weight oneCellWeight (∅ : Finset (Fin 1)) = 0 := by
    simp [FinitePoset.weight]
  have hwFull :
      FinitePoset.weight oneCellWeight (Finset.univ : Finset (Fin 1)) = 2 := by
    have huniv : (Finset.univ : Finset (Fin 1)) = {0} := by
      ext i
      fin_cases i
      simp
    rw [huniv]
    simp [FinitePoset.weight, oneCellWeight]
  change (FinitePoset.ideals (α := Fin 1)).sum (fun I =>
      q ^ FinitePoset.weight oneCellWeight I *
      (FinitePoset.omega (α := {a : Fin 1 // a ∉ I}) (t + 1 - 1) : ℚ)) =
    (t : ℚ) + q ^ 2
  rw [oneCell_ideals, Finset.sum_insert hnot, Finset.sum_singleton]
  simp only [ht]
  rw [homegaEmpty, homegaFull, hwEmpty, hwFull]
  norm_num

/-- Equation (3.5) written with the manuscript's positive parameter. -/
theorem oneCell_H_pos (t : ℕ) (q : ℚ) (ht : 1 ≤ t) :
    FinitePoset.H oneCellWeight t q = ((t - 1 : ℕ) : ℚ) + q ^ 2 := by
  cases t with
  | zero => omega
  | succ t =>
      simpa [Nat.succ_eq_add_one] using oneCell_H t q

/-- The annular `1+q^2` polynomial is the `t=2` specialization. -/
theorem oneCell_H_two (q : ℚ) :
    FinitePoset.H oneCellWeight 2 q = 1 + q ^ 2 := by
  simpa using oneCell_H 1 q

/-- The other coordinate slice counts isotone maps of one cell. -/
theorem oneCell_H_one (t : ℕ) :
    FinitePoset.H oneCellWeight (t + 1) 1 =
      (FinitePoset.omega (α := Fin 1) (t + 1) : ℚ) := by
  exact FinitePoset.H_one_eq_omega_succ oneCellWeight t

/-- The order polynomial of one cell is `Omega(t)=t`. -/
theorem oneCell_omega (t : ℕ) :
    FinitePoset.omega (α := Fin 1) t = t :=
  omega_subsingleton t

/-- The weighted rank polynomial has the same two terms. -/
theorem oneCell_weightedRank (q : ℚ) :
    FinitePoset.weightedRank oneCellWeight q = 1 + q ^ 2 := by
  calc
    FinitePoset.weightedRank oneCellWeight q =
        FinitePoset.H oneCellWeight 2 q :=
      (FinitePoset.H_two oneCellWeight q).symm
    _ = 1 + q ^ 2 := oneCell_H_two q

/-- The one-cell two-color specialization agrees exactly with the
 already formalized first annular mutation for shear weight two. -/
theorem oneCell_annular_bridge (q : ℚ) :
    FinitePoset.H oneCellWeight 2 q =
      AnnularFirstMutation.firstMutation 2 1 1 q := by
  rw [oneCell_H_two, AnnularFirstMutation.firstMutation_specialized]

end OneCellBridge
end OrderIdealSpecializations

/-! ## §4 — Canonical block partitions of skew diagrams

The root-exclusion convention was explicitly confirmed by Yakob Kahane
(personal correspondence, 10 November 2026) as the intended repair of
the strict inequalities in Definition 4.2 of arXiv:2607.11225v1.
The proof below uses the precise formal definition, not the uncorrected
literal wording of that version.

### §4.1 — Root-excluded boundary conditions -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- A cell is specified by its row and column coordinates. -/
abbrev Cell := ℕ × ℕ

/-- A finite cell diagram.  Skewness and connectivity will be additional
    hypotheses in the geometric lemmas, not implicit in this type. -/
abbrev Diagram := Finset Cell

/-- A cell is the left end of its occupied row (in the diagram). -/
def IsLeftBoundary (D : Diagram) (c : Cell) : Prop :=
  c ∈ D ∧ ∀ j : ℕ, j < c.2 → (c.1, j) ∉ D

/-- A cell is the bottom end of its occupied column.  The row coordinate
    increases downwards in the southwest-first drawing convention. -/
def IsBottomBoundary (D : Diagram) (c : Cell) : Prop :=
  c ∈ D ∧ ∀ i : ℕ, c.1 < i → (i, c.2) ∉ D

/-- The root-excluded left-boundary inequalities in Definition 4.1.
    The label type is `ℕ`; later a bijective labeling will be specified. -/
def LeftRootCondition (D : Diagram) (root : Cell)
    (label : Cell → ℕ) : Prop :=
  ∀ c : Cell, IsLeftBoundary D c → c ≠ root → label c < label root

/-- The root-excluded bottom-boundary inequalities in Definition 4.1. -/
def BottomRootCondition (D : Diagram) (root : Cell)
    (label : Cell → ℕ) : Prop :=
  ∀ c : Cell, IsBottomBoundary D c → c ≠ root → label root < label c

/-- The *local* label condition of a block.  Global compatibility of
    distinct blocks is a separate requirement. -/
def RootBoundaryConditions (D : Diagram) (root : Cell)
    (label : Cell → ℕ) : Prop :=
  LeftRootCondition D root label ∧ BottomRootCondition D root label

/-- Definition 4.1 and Lemma 4.2 (intrinsic root).
    Source comparison: Kahane, page 10, defines its 'leftmost element'
    as having neither a left parent (cell to the west) nor a left child
    (cell to the south). Hence this matches the south-west corner here.
    A unique southwest corner is simultaneously a left-row and
    bottom-column boundary cell. -/
def UniqueSouthwestCorner (D : Diagram) (root : Cell) : Prop :=
  IsLeftBoundary D root ∧ IsBottomBoundary D root ∧
    ∀ c : Cell, IsLeftBoundary D c → IsBottomBoundary D c → c = root

/-- The two nonroot boundary classes are disjoint whenever the diagram
    has a unique southwest corner.  This is the disjointness part of
    Lemma 4.2; deriving uniqueness from skewness and connectivity remains. -/
theorem nonroot_boundaries_disjoint
    {D : Diagram} {root c : Cell}
    (hroot : UniqueSouthwestCorner D root) (hc : c ≠ root) :
    ¬ (IsLeftBoundary D c ∧ IsBottomBoundary D c) := by
  rintro ⟨hl, hb⟩
  exact hc (hroot.2.2 c hl hb)

/-- A singleton cell is the left end of its row. -/
theorem singleton_left_boundary (root : Cell) :
    IsLeftBoundary ({root} : Diagram) root := by
  constructor
  · simp
  · intro j hj hmem
    have hp : (root.1, j) = root := by simpa using hmem
    have hj' : j = root.2 := congrArg Prod.snd hp
    omega

/-- A singleton cell is the bottom end of its column. -/
theorem singleton_bottom_boundary (root : Cell) :
    IsBottomBoundary ({root} : Diagram) root := by
  constructor
  · simp
  · intro i hi hmem
    have hp : (i, root.2) = root := by simpa using hmem
    have hi' : i = root.1 := congrArg Prod.fst hp
    omega

/-- A single-cell diagram has a unique southwest corner. -/
theorem singleton_unique_corner (root : Cell) :
    UniqueSouthwestCorner ({root} : Diagram) root := by
  refine ⟨singleton_left_boundary root, singleton_bottom_boundary root, ?_⟩
  intro c hl _
  simpa using hl.1

/-- With the necessary root exclusion, a one-cell block satisfies both
    strict boundary conditions for every labeling. -/
theorem singleton_root_conditions (root : Cell) (label : Cell → ℕ) :
    RootBoundaryConditions ({root} : Diagram) root label := by
  constructor
  · intro c hl hne
    have hc : c = root := by simpa using hl.1
    exact (hne hc).elim
  · intro c hb hne
    have hc : c = root := by simpa using hb.1
    exact (hne hc).elim

/-- Remark 4.4 — first formal reason for correcting
    Kahane Definition 4.2. In the printed version the quantifier
    'for each y in B' includes the root x; as x has no left parent,
    this would require label x < label x. This is impossible for every
    nonempty connected skew block. The root is excluded explicitly. -/
theorem left_root_exclusion_necessary
    (D : Diagram) (root : Cell) (label : Cell → ℕ)
    (hroot : IsLeftBoundary D root) :
    ¬ (∀ c : Cell, IsLeftBoundary D c → label c < label root) := by
  intro h
  exact (lt_irrefl (label root)) (h root hroot)

/-- Remark 4.4 — second formal reason for correcting
    Kahane Definition 4.2. The root has no left child (southward),
    so the literally quantified condition would require label x > label x.
    This excludes ALL nonempty blocks unless the root is excepted. -/
theorem bottom_root_exclusion_necessary
    (D : Diagram) (root : Cell) (label : Cell → ℕ)
    (hroot : IsBottomBoundary D root) :
    ¬ (∀ c : Cell, IsBottomBoundary D c → label root < label c) := by
  intro h
  exact (lt_irrefl (label root)) (h root hroot)

/-! ### §4.1 — Equation (4.1): the local median/clamping operation

The following arithmetic identities certify the local operation proposed
for the later scanning algorithm.  They do not by themselves establish that
its fibers form skew blocks or that the partition is unique. -/

/-- The finite-bound version of `median(lower, label, upper)`. -/
def medianRoot (lower label upper : ℕ) : ℕ :=
  max lower (min label upper)

/-- The median never lies below its lower bound. -/
theorem medianRoot_lower (a x b : ℕ) :
    a ≤ medianRoot a x b := by
  exact le_max_left a (min x b)

/-- If the bounds are ordered, the median never exceeds the upper bound. -/
theorem medianRoot_upper (a x b : ℕ) (hab : a ≤ b) :
    medianRoot a x b ≤ b := by
  exact max_le hab (min_le_right x b)

/-- A label below the lower bound is clamped to the lower bound. -/
theorem medianRoot_below (a x b : ℕ) (hxa : x ≤ a) :
    medianRoot a x b = a := by
  change max a (min x b) = a
  exact max_eq_left (le_trans (min_le_left x b) hxa)

/-- A label above the upper bound is clamped to that upper bound. -/
theorem medianRoot_above (a x b : ℕ)
    (hab : a ≤ b) (hbx : b ≤ x) :
    medianRoot a x b = b := by
  change max a (min x b) = b
  rw [min_eq_right hbx, max_eq_right hab]

/-- A label in the permitted interval remains unchanged. -/
theorem medianRoot_between (a x b : ℕ)
    (hax : a ≤ x) (hxb : x ≤ b) :
    medianRoot a x b = x := by
  change max a (min x b) = x
  rw [min_eq_left hxb, max_eq_right hax]

/-- In particular a strictly interior label creates its own root label. -/
theorem medianRoot_strict_inside (a x b : ℕ)
    (hax : a < x) (hxb : x < b) :
    medianRoot a x b = x := by
  exact medianRoot_between a x b (le_of_lt hax) (le_of_lt hxb)

/-- The local algorithm chooses either an existing neighboring root or the
    new cell's label, with no fourth possibility. -/
theorem medianRoot_three_cases (a x b : ℕ) (hab : a ≤ b) :
    medianRoot a x b = a ∨
    medianRoot a x b = x ∨
    medianRoot a x b = b := by
  rcases le_total x a with hxa | hax
  · exact Or.inl (medianRoot_below a x b hxa)
  · rcases le_total x b with hxb | hbx
    · exact Or.inr (Or.inl (medianRoot_between a x b hax hxb))
    · exact Or.inr (Or.inr (medianRoot_above a x b hab hbx))

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### Lemma 4.2 — Nonroot boundary-cell counting. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The occupied rows of a finite cell diagram. -/
def occupiedRows (D : Diagram) : Finset ℕ := D.image Prod.fst

/-- The occupied columns of a finite cell diagram. -/
def occupiedColumns (D : Diagram) : Finset ℕ := D.image Prod.snd

/-- Exactly the leftmost cells of occupied rows. -/
noncomputable def leftEnds (D : Diagram) : Finset Cell := by
  classical
  exact D.filter (IsLeftBoundary D)

/-- Exactly the bottommost cells of occupied columns. -/
noncomputable def bottomEnds (D : Diagram) : Finset Cell := by
  classical
  exact D.filter (IsBottomBoundary D)

@[simp] theorem mem_leftEnds {D : Diagram} {c : Cell} :
    c ∈ leftEnds D ↔ IsLeftBoundary D c := by
  classical
  simp [leftEnds, IsLeftBoundary]

@[simp] theorem mem_bottomEnds {D : Diagram} {c : Cell} :
    c ∈ bottomEnds D ↔ IsBottomBoundary D c := by
  classical
  simp [bottomEnds, IsBottomBoundary]

/-- Two leftmost cells in the same occupied row coincide. -/
theorem leftBoundary_unique {D : Diagram} {c d : Cell}
    (hc : IsLeftBoundary D c) (hd : IsLeftBoundary D d)
    (hrow : c.1 = d.1) : c = d := by
  have hcol : c.2 = d.2 := by
    rcases lt_trichotomy c.2 d.2 with h | h | h
    · exfalso
      apply hd.2 c.2 h
      simpa [← hrow] using hc.1
    · exact h
    · exfalso
      apply hc.2 d.2 h
      simpa [hrow] using hd.1
  exact Prod.ext hrow hcol

/-- Two bottommost cells in the same occupied column coincide. -/
theorem bottomBoundary_unique {D : Diagram} {c d : Cell}
    (hc : IsBottomBoundary D c) (hd : IsBottomBoundary D d)
    (hcol : c.2 = d.2) : c = d := by
  have hrow : c.1 = d.1 := by
    rcases lt_trichotomy c.1 d.1 with h | h | h
    · exfalso
      apply hc.2 d.1 h
      simpa [hcol] using hd.1
    · exact h
    · exfalso
      apply hd.2 c.1 h
      simpa [← hcol] using hc.1
  exact Prod.ext hrow hcol

/-- Every occupied row contains a leftmost cell, by taking the
    minimum of its (nonempty, finite) set of occupied columns. -/
theorem exists_leftBoundary_in_row (D : Diagram) (r : ℕ)
    (hr : r ∈ occupiedRows D) :
    ∃ c : Cell, IsLeftBoundary D c ∧ c.1 = r := by
  classical
  obtain ⟨c, hcD, hcr⟩ := Finset.mem_image.mp hr
  let S : Finset ℕ := (D.filter (fun a => a.1 = r)).image Prod.snd
  have hS : S.Nonempty := by
    refine ⟨c.2, ?_⟩
    apply Finset.mem_image.mpr
    exact ⟨c, Finset.mem_filter.mpr ⟨hcD, hcr⟩, rfl⟩
  let j : ℕ := S.min' hS
  have hjS : j ∈ S := Finset.min'_mem S hS
  obtain ⟨d, hd, hdj⟩ := Finset.mem_image.mp hjS
  obtain ⟨hdD, hdr⟩ := Finset.mem_filter.mp hd
  have hcell : (r, j) ∈ D := by
    have heq : d = (r, j) := Prod.ext hdr hdj
    rw [← heq]
    exact hdD
  refine ⟨(r, j), ⟨hcell, ?_⟩, rfl⟩
  intro k hkj hkD
  have hkS : k ∈ S := by
    apply Finset.mem_image.mpr
    exact ⟨(r, k), Finset.mem_filter.mpr ⟨hkD, rfl⟩, rfl⟩
  have hjk : j ≤ k := Finset.min'_le S k hkS
  omega

/-- Every occupied column contains a bottommost cell, by taking
    the maximum of its (nonempty, finite) set of occupied rows. -/
theorem exists_bottomBoundary_in_column (D : Diagram) (s : ℕ)
    (hs : s ∈ occupiedColumns D) :
    ∃ c : Cell, IsBottomBoundary D c ∧ c.2 = s := by
  classical
  obtain ⟨c, hcD, hcs⟩ := Finset.mem_image.mp hs
  let S : Finset ℕ := (D.filter (fun a => a.2 = s)).image Prod.fst
  have hS : S.Nonempty := by
    refine ⟨c.1, ?_⟩
    apply Finset.mem_image.mpr
    exact ⟨c, Finset.mem_filter.mpr ⟨hcD, hcs⟩, rfl⟩
  let i : ℕ := S.max' hS
  have hiS : i ∈ S := Finset.max'_mem S hS
  obtain ⟨d, hd, hdi⟩ := Finset.mem_image.mp hiS
  obtain ⟨hdD, hds⟩ := Finset.mem_filter.mp hd
  have hcell : (i, s) ∈ D := by
    have heq : d = (i, s) := Prod.ext hdi hds
    rw [← heq]
    exact hdD
  refine ⟨(i, s), ⟨hcell, ?_⟩, rfl⟩
  intro k hik hkD
  have hkS : k ∈ S := by
    apply Finset.mem_image.mpr
    exact ⟨(k, s), Finset.mem_filter.mpr ⟨hkD, rfl⟩, rfl⟩
  have hki : k ≤ i := Finset.le_max' S k hkS
  omega

/-- The left boundary has exactly one cell for every occupied row.
    This does not require skewness, connectedness, or a root. -/
theorem card_leftEnds (D : Diagram) :
    (leftEnds D).card = (occupiedRows D).card := by
  classical
  refine Finset.card_bij (s := leftEnds D) (t := occupiedRows D)
    (fun c _ => c.1) ?_ ?_ ?_
  · intro c hc
    exact Finset.mem_image.mpr ⟨c, (mem_leftEnds.mp hc).1, rfl⟩
  · intro c hc d hd hcd
    exact leftBoundary_unique (mem_leftEnds.mp hc)
      (mem_leftEnds.mp hd) hcd
  · intro r hr
    obtain ⟨c, hc, hcr⟩ := exists_leftBoundary_in_row D r hr
    exact ⟨c, mem_leftEnds.mpr hc, hcr⟩

/-- The bottom boundary has exactly one cell for every occupied column. -/
theorem card_bottomEnds (D : Diagram) :
    (bottomEnds D).card = (occupiedColumns D).card := by
  classical
  refine Finset.card_bij (s := bottomEnds D) (t := occupiedColumns D)
    (fun c _ => c.2) ?_ ?_ ?_
  · intro c hc
    exact Finset.mem_image.mpr ⟨c, (mem_bottomEnds.mp hc).1, rfl⟩
  · intro c hc d hd hcd
    exact bottomBoundary_unique (mem_bottomEnds.mp hc)
      (mem_bottomEnds.mp hd) hcd
  · intro s hs
    obtain ⟨c, hc, hcs⟩ := exists_bottomBoundary_in_column D s hs
    exact ⟨c, mem_bottomEnds.mpr hc, hcs⟩

/-- The nonroot left boundary. -/
noncomputable def nonrootLeftEnds (D : Diagram) (root : Cell) : Finset Cell :=
  (leftEnds D).erase root

/-- The nonroot bottom boundary. -/
noncomputable def nonrootBottomEnds (D : Diagram) (root : Cell) : Finset Cell :=
  (bottomEnds D).erase root

/-- In the presence of a unique southwest corner, the two entire
    boundary sets intersect in *exactly* the singleton root. -/
theorem boundary_intersection_eq_singleton
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    leftEnds D ∩ bottomEnds D = {root} := by
  classical
  ext c
  constructor
  · intro hc
    rcases Finset.mem_inter.mp hc with ⟨hl, hb⟩
    have h : c = root :=
      hroot.2.2 c (mem_leftEnds.mp hl) (mem_bottomEnds.mp hb)
    simp [h]
  · intro hc
    have h : c = root := Finset.mem_singleton.mp hc
    subst c
    exact Finset.mem_inter.mpr
      ⟨mem_leftEnds.mpr hroot.1, mem_bottomEnds.mpr hroot.2.1⟩

/-- The first enumerative assertion of Lemma 4.2. -/
theorem card_nonrootLeftEnds_add_one
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    (nonrootLeftEnds D root).card + 1 = (occupiedRows D).card := by
  classical
  calc
    (nonrootLeftEnds D root).card + 1 = (leftEnds D).card := by
      exact Finset.card_erase_add_one (mem_leftEnds.mpr hroot.1)
    _ = (occupiedRows D).card := card_leftEnds D

/-- The second enumerative assertion of Lemma 4.2. -/
theorem card_nonrootBottomEnds_add_one
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    (nonrootBottomEnds D root).card + 1 = (occupiedColumns D).card := by
  classical
  calc
    (nonrootBottomEnds D root).card + 1 = (bottomEnds D).card := by
      exact Finset.card_erase_add_one (mem_bottomEnds.mpr hroot.2.1)
    _ = (occupiedColumns D).card := card_bottomEnds D

/-- The `h-1` form, using the occupied-row count. -/
theorem card_nonrootLeftEnds
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    (nonrootLeftEnds D root).card = (occupiedRows D).card - 1 := by
  have h := card_nonrootLeftEnds_add_one hroot
  omega

/-- The `w-1` form, using the occupied-column count. -/
theorem card_nonrootBottomEnds
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    (nonrootBottomEnds D root).card = (occupiedColumns D).card - 1 := by
  have h := card_nonrootBottomEnds_add_one hroot
  omega

/-- The two nonroot boundary sets are disjoint. -/
theorem nonrootEnds_disjoint
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    Disjoint (nonrootLeftEnds D root) (nonrootBottomEnds D root) := by
  classical
  apply Finset.disjoint_left.mpr
  intro c hcL hcB
  have hL := Finset.mem_erase.mp hcL
  have hB := Finset.mem_erase.mp hcB
  exact nonroot_boundaries_disjoint hroot hL.1
    ⟨mem_leftEnds.mp hL.2, mem_bottomEnds.mp hB.2⟩

/-- The local strict inequalities hold on the *counted* nonroot
    boundary sets, not on the excluded root. -/
theorem labels_on_nonroot_ends
    {D : Diagram} {root : Cell} {label : Cell → ℕ}
    (h : RootBoundaryConditions D root label) :
    (∀ c ∈ nonrootLeftEnds D root, label c < label root) ∧
    (∀ c ∈ nonrootBottomEnds D root, label root < label c) := by
  classical
  constructor
  · intro c hc
    have hc' := Finset.mem_erase.mp hc
    exact h.1 c (mem_leftEnds.mp hc'.2) hc'.1
  · intro c hc
    have hc' := Finset.mem_erase.mp hc
    exact h.2 c (mem_bottomEnds.mp hc'.2) hc'.1

/-- Combined boundary-count conclusion of Lemma 4.2, under the
    (explicit) unique-southwest-corner hypothesis. -/
theorem boundary_counting_lemma
    {D : Diagram} {root : Cell}
    (hroot : UniqueSouthwestCorner D root) :
    (nonrootLeftEnds D root).card + 1 = (occupiedRows D).card ∧
    (nonrootBottomEnds D root).card + 1 = (occupiedColumns D).card ∧
    Disjoint (nonrootLeftEnds D root) (nonrootBottomEnds D root) := by
  exact ⟨card_nonrootLeftEnds_add_one hroot,
    card_nonrootBottomEnds_add_one hroot, nonrootEnds_disjoint hroot⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.2 — Lemma 4.2: Geometry of the unique southwest corner. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- All occupied cells between two cells of the same row are present. -/
def RowConvex (D : Diagram) : Prop :=
  ∀ (r a b j : ℕ), (r, a) ∈ D → (r, b) ∈ D →
    a ≤ j → j ≤ b → (r, j) ∈ D

/-- The left endpoint of each occupied row is no further right than
    that of the occupied row immediately above it. -/
def LeftEndpointsDecrease (D : Diagram) : Prop :=
  ∀ ⦃c d : Cell⦄, IsLeftBoundary D c → IsLeftBoundary D d →
    d.1 = c.1 + 1 → d.2 ≤ c.2

/-- If an occupied row has another occupied row below, then it overlaps
    the row immediately below.  This excludes vertical gaps and records
    edge-connectivity in the row-interval model. -/
def SuccessiveRowsOverlap (D : Diagram) : Prop :=
  ∀ r : ℕ, r ∈ occupiedRows D →
    (∃ s ∈ occupiedRows D, r < s) →
    ∃ j : ℕ, (r, j) ∈ D ∧ (r + 1, j) ∈ D

/-- A concrete skew Young diagram, specified by its row intervals.
    The functions `lo`, `hi` are the two weakly decreasing row boundaries.
    A row is empty when its corresponding interval is empty. -/
def SkewRowIntervals (D : Diagram) : Prop :=
  ∃ (n : ℕ) (lo hi : ℕ → ℕ),
    (∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r) ∧
    (∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r) ∧
    (∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)

/-- Explicit connected skew row geometry: skew intervals together with
    overlap of every pair of successive occupied rows. -/
def ConnectedSkewRows (D : Diagram) : Prop :=
  SkewRowIntervals D ∧ SuccessiveRowsOverlap D

/-- Every skew row-interval diagram is row-convex. -/
theorem skewRowIntervals_rowConvex {D : Diagram}
    (hsk : SkewRowIntervals D) : RowConvex D := by
  obtain ⟨n, lo, hi, hmem, _, _⟩ := hsk
  intro r a b j ha hb haj hjb
  obtain ⟨hr, hla, _⟩ := (hmem r a).mp ha
  obtain ⟨_, _, hbh⟩ := (hmem r b).mp hb
  exact (hmem r j).mpr
    ⟨hr, le_trans hla haj, lt_of_le_of_lt hjb hbh⟩

/-- In the row-interval model, a leftmost cell has exactly the
    lower-endpoint column `lo` of its row. -/
theorem skewRowIntervals_leftEndpointsDecrease {D : Diagram}
    (hsk : SkewRowIntervals D) : LeftEndpointsDecrease D := by
  obtain ⟨n, lo, hi, hmem, hlo, _⟩ := hsk
  have hleft : ∀ c : Cell, IsLeftBoundary D c → c.2 = lo c.1 := by
    intro c hc
    have hcell := (hmem c.1 c.2).mp hc.1
    apply le_antisymm
    · by_contra hn
      have hlt : lo c.1 < c.2 := by omega
      have hnew : (c.1, lo c.1) ∈ D :=
        (hmem c.1 (lo c.1)).mpr
          ⟨hcell.1, le_refl _, lt_trans hlt hcell.2.2⟩
      exact (hc.2 (lo c.1) hlt) hnew
    · exact hcell.2.1
  intro c d hc hd hrow
  have hcmin := hleft c hc
  have hdmin := hleft d hd
  have hdn : d.1 < n := ((hmem d.1 d.2).mp hd.1).1
  have hnext : c.1 + 1 < n := by omega
  calc
    d.2 = lo d.1 := hdmin
    _ = lo (c.1 + 1) := congrArg lo hrow
    _ ≤ lo c.1 := hlo c.1 hnext
    _ = c.2 := hcmin.symm

/-- A leftmost cell that is not in the bottom occupied row has a cell
    immediately underneath it in the same column.  This is the geometric
    reason two different southwest corners cannot occur. -/
theorem leftBoundary_extends_down
    {D : Diagram} (hconv : RowConvex D)
    (hleft : LeftEndpointsDecrease D)
    (hoverlap : SuccessiveRowsOverlap D)
    {c : Cell} (hc : IsLeftBoundary D c)
    (hbelow : ∃ s ∈ occupiedRows D, c.1 < s) :
    (c.1 + 1, c.2) ∈ D := by
  classical
  have hrow : c.1 ∈ occupiedRows D :=
    Finset.mem_image.mpr ⟨c, hc.1, rfl⟩
  obtain ⟨j, hjtop, hjdown⟩ := hoverlap c.1 hrow hbelow
  have hcj : c.2 ≤ j := by
    by_contra hn
    have hjlt : j < c.2 := by omega
    exact (hc.2 j hjlt) hjtop
  have hnextrow : c.1 + 1 ∈ occupiedRows D :=
    Finset.mem_image.mpr ⟨(c.1 + 1, j), hjdown, rfl⟩
  obtain ⟨d, hd, hdr⟩ :=
    exists_leftBoundary_in_row D (c.1 + 1) hnextrow
  have hdleft : d.2 ≤ c.2 := hleft hc hd hdr
  have hdcell : (c.1 + 1, d.2) ∈ D := by
    have heq : d = (c.1 + 1, d.2) := Prod.ext hdr rfl
    exact heq ▸ hd.1
  exact hconv (c.1 + 1) d.2 j c.2 hdcell hjdown hdleft hcj

/-- A finite nonempty diagram has a last occupied row. -/
theorem exists_bottommost_occupied_row
    (D : Diagram) (hD : D.Nonempty) :
    ∃ r : ℕ, r ∈ occupiedRows D ∧
      ∀ s ∈ occupiedRows D, s ≤ r := by
  classical
  obtain ⟨c, hc⟩ := hD
  have hrows : (occupiedRows D).Nonempty :=
    ⟨c.1, Finset.mem_image.mpr ⟨c, hc, rfl⟩⟩
  refine ⟨(occupiedRows D).max' hrows,
    Finset.max'_mem (occupiedRows D) hrows, ?_⟩
  intro s hs
  exact Finset.le_max' (occupiedRows D) s hs

/-- The leftmost cell of the bottom row is the unique southwest corner,
    provided the three row-geometric properties hold. -/
theorem unique_corner_of_row_geometry
    {D : Diagram} (hconv : RowConvex D)
    (hleft : LeftEndpointsDecrease D)
    (hoverlap : SuccessiveRowsOverlap D)
    {r : ℕ} (hr : r ∈ occupiedRows D)
    (hrmax : ∀ s ∈ occupiedRows D, s ≤ r) :
    ∃ root : Cell, UniqueSouthwestCorner D root := by
  classical
  obtain ⟨root, hrootleft, hrootrow⟩ :=
    exists_leftBoundary_in_row D r hr
  have hrootbottom : IsBottomBoundary D root := by
    constructor
    · exact hrootleft.1
    · intro i hi hmem
      have hirow : i ∈ occupiedRows D :=
        Finset.mem_image.mpr ⟨(i, root.2), hmem, rfl⟩
      have hir : i ≤ r := hrmax i hirow
      omega
  refine ⟨root, hrootleft, hrootbottom, ?_⟩
  intro c hcleft hcbottom
  have hcrow : c.1 ∈ occupiedRows D :=
    Finset.mem_image.mpr ⟨c, hcleft.1, rfl⟩
  have hcr : c.1 ≤ r := hrmax c.1 hcrow
  have hsame : c.1 = r := by
    by_contra hn
    have hlt : c.1 < r := by omega
    have hbelow : ∃ s ∈ occupiedRows D, c.1 < s :=
      ⟨r, hr, hlt⟩
    have hdown :=
      leftBoundary_extends_down hconv hleft hoverlap hcleft hbelow
    exact (hcbottom.2 (c.1 + 1) (Nat.lt_succ_self c.1)) hdown
  exact leftBoundary_unique hcleft hrootleft (hsame.trans hrootrow.symm)

/-- Existence and uniqueness of the southwest corner for every nonempty
    connected skew row-interval diagram.  No extra corner axiom is needed. -/
theorem connectedSkewRows_unique_corner
    {D : Diagram} (hD : D.Nonempty) (hsk : ConnectedSkewRows D) :
    ∃ root : Cell, UniqueSouthwestCorner D root := by
  obtain ⟨r, hr, hrmax⟩ := exists_bottommost_occupied_row D hD
  exact unique_corner_of_row_geometry
    (skewRowIntervals_rowConvex hsk.1)
    (skewRowIntervals_leftEndpointsDecrease hsk.1)
    hsk.2 hr hrmax

/-- Lemma 4.2 — connected-skew boundary counting.
    For a nonempty connected skew diagram the root is unique,
    there are h-1 nonroot left-row ends and w-1 nonroot
    bottom-column ends, and these classes are disjoint.
    This is the boundary-counting statement in Lemma 4.2 of the manuscript,
    logically separate from the subsequent uniqueness theorem. -/
theorem connectedSkewRows_boundary_counting
    {D : Diagram} (hD : D.Nonempty) (hsk : ConnectedSkewRows D) :
    ∃ root : Cell,
      UniqueSouthwestCorner D root ∧
      (nonrootLeftEnds D root).card = (occupiedRows D).card - 1 ∧
      (nonrootBottomEnds D root).card = (occupiedColumns D).card - 1 ∧
      Disjoint (nonrootLeftEnds D root) (nonrootBottomEnds D root) := by
  obtain ⟨root, hroot⟩ := connectedSkewRows_unique_corner hD hsk
  exact ⟨root, hroot,
    card_nonrootLeftEnds hroot,
    card_nonrootBottomEnds hroot,
    nonrootEnds_disjoint hroot⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### Lemma 4.3 — Canonical median construction and uniqueness. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- A median with optional lower and upper bounds. -/
def medianOptional (x : ℕ) (lower upper : Option ℕ) : ℕ :=
  match lower, upper with
  | none, none => x
  | some a, none => max a x
  | none, some b => min x b
  | some a, some b => medianRoot a x b

@[simp] theorem medianOptional_none_none (x : ℕ) :
    medianOptional x none none = x := rfl

@[simp] theorem medianOptional_some_none (a x : ℕ) :
    medianOptional x (some a) none = max a x := rfl

@[simp] theorem medianOptional_none_some (x b : ℕ) :
    medianOptional x none (some b) = min x b := rfl

@[simp] theorem medianOptional_some_some (a x b : ℕ) :
    medianOptional x (some a) (some b) = medianRoot a x b := rfl

/-- With only a lower predecessor the chosen label is inherited or new. -/
theorem medianOptional_lower_choices (a x : ℕ) :
    medianOptional x (some a) none = a ∨
    medianOptional x (some a) none = x := by
  rcases le_total x a with h | h
  · exact Or.inl (max_eq_left h)
  · exact Or.inr (max_eq_right h)

/-- With only an upper predecessor the chosen label is new or inherited. -/
theorem medianOptional_upper_choices (x b : ℕ) :
    medianOptional x none (some b) = x ∨
    medianOptional x none (some b) = b := by
  rcases le_total x b with h | h
  · exact Or.inl (min_eq_left h)
  · exact Or.inr (min_eq_right h)

/-- With ordered bounds the label is one of the three proposed sources. -/
theorem medianOptional_three_cases (a x b : ℕ) (hab : a ≤ b) :
    medianOptional x (some a) (some b) = a ∨
    medianOptional x (some a) (some b) = x ∨
    medianOptional x (some a) (some b) = b := by
  exact medianRoot_three_cases a x b hab

/-- Distinct labels identify a genuinely new block precisely in the
    strict interior of the neighboring root labels. -/
theorem medianOptional_new_root_iff (a x b : ℕ)
    (hab : a ≤ b) (hxa : x ≠ a) (hxb : x ≠ b) :
    medianOptional x (some a) (some b) = x ↔ a < x ∧ x < b := by
  constructor
  · intro heq
    have hlow := medianRoot_lower a x b
    have hupp := medianRoot_upper a x b hab
    change medianRoot a x b = x at heq
    rw [heq] at hlow hupp
    omega
  · rintro ⟨hax, hxb⟩
    exact medianRoot_strict_inside a x b hax hxb

/-- Equal neighboring roots force their shared label, whatever x is. -/
theorem medianOptional_same_neighbors (a x : ℕ) :
    medianOptional x (some a) (some a) = a := by
  rcases le_total x a with h | h
  · exact medianRoot_below a x a h
  · exact medianRoot_above a x a (le_refl a) h

/-- The scanning order is south-to-north, then left-to-right. -/
def ScanEarlier (d c : Cell) : Prop :=
  c.1 < d.1 ∨ (d.1 = c.1 ∧ d.2 < c.2)

/-- The two possible already-processed immediate neighbors. -/
def belowCell (c : Cell) : Cell := (c.1 + 1, c.2)
def leftCell (c : Cell) : Cell := (c.1, c.2 - 1)

theorem belowCell_earlier (c : Cell) : ScanEarlier (belowCell c) c := by
  left
  simp [belowCell]

theorem leftCell_earlier (c : Cell) (hc : 0 < c.2) :
    ScanEarlier (leftCell c) c := by
  right
  change c.1 = c.1 ∧ c.2 - 1 < c.2
  constructor
  · rfl
  · omega

theorem scanEarlier_irrefl (c : Cell) : ¬ ScanEarlier c c := by
  simp [ScanEarlier]

theorem scanEarlier_trans {a b c : Cell}
    (hab : ScanEarlier a b) (hbc : ScanEarlier b c) :
    ScanEarlier a c := by
  unfold ScanEarlier at *
  omega

/-- Distinct cells are comparable in the chosen scan order. -/
theorem scanEarlier_total_of_ne {a b : Cell} (hne : a ≠ b) :
    ScanEarlier a b ∨ ScanEarlier b a := by
  by_cases hr : a.1 = b.1
  · have hc : a.2 ≠ b.2 := by
      intro hc
      exact hne (Prod.ext hr hc)
    unfold ScanEarlier
    omega
  · unfold ScanEarlier
    omega

/-- Partial assignments distinguish unprocessed cells from assigned ones. -/
abbrev PartialRoots := Cell → Option ℕ

/-- If there is no cell directly below, its bound is absent. -/
def lowerEntry (D : Diagram) (roots : PartialRoots) (c : Cell) : Option ℕ :=
  if belowCell c ∈ D then roots (belowCell c) else none

/-- If there is no cell immediately left, its bound is absent. -/
def upperEntry (D : Diagram) (roots : PartialRoots) (c : Cell) : Option ℕ :=
  if 0 < c.2 ∧ leftCell c ∈ D then roots (leftCell c) else none

/-- Existing predecessors must be assigned before the local scan. -/
def ReadyForScan (D : Diagram) (roots : PartialRoots) (c : Cell) : Prop :=
  (belowCell c ∈ D → ∃ a : ℕ, roots (belowCell c) = some a) ∧
  (0 < c.2 ∧ leftCell c ∈ D →
    ∃ b : ℕ, roots (leftCell c) = some b)

theorem readyForScan_two_neighbors (D : Diagram)
    (roots : PartialRoots) (c : Cell)
    (hready : ReadyForScan D roots c)
    (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D) :
    ∃ a b : ℕ, roots (belowCell c) = some a ∧
      roots (leftCell c) = some b := by
  obtain ⟨a, ha⟩ := hready.1 hbelow
  obtain ⟨b, hb⟩ := hready.2 hleft
  exact ⟨a, b, ha, hb⟩

/-- One local application of Equation (4.1). -/
def computedRoot (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell) : ℕ :=
  medianOptional (label c) (lowerEntry D roots c) (upperEntry D roots c)

/-- With assigned predecessors the optional recurrence specializes to
    the median with their actual labels. -/
theorem computedRoot_two_neighbors (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (a b : ℕ)
    (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b) :
    computedRoot D label roots c = medianRoot a (label c) b := by
  have hlow : lowerEntry D roots c = some a := by
    simp [lowerEntry, hbelow, ha]
  have hupp : upperEntry D roots c = some b := by
    simp [upperEntry, hleft, hb]
  unfold computedRoot
  rw [hlow, hupp]
  rfl

/-- The selected label stays between the two neighboring root labels. -/
theorem computedRoot_between (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (a b : ℕ) (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b) (hab : a ≤ b) :
    a ≤ computedRoot D label roots c ∧
      computedRoot D label roots c ≤ b := by
  rw [computedRoot_two_neighbors D label roots c a b hbelow hleft ha hb]
  exact ⟨medianRoot_lower a (label c) b,
    medianRoot_upper a (label c) b hab⟩

/-- A label strictly between its neighbors is a new root label. -/
theorem computedRoot_new (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (a b : ℕ) (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b)
    (hax : a < label c) (hxb : label c < b) :
    computedRoot D label roots c = label c := by
  rw [computedRoot_two_neighbors D label roots c a b hbelow hleft ha hb]
  exact medianRoot_strict_inside a (label c) b hax hxb

/-- A label below the lower neighbor attaches to that lower root. -/
theorem computedRoot_lower (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (a b : ℕ) (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b)
    (hxa : label c ≤ a) :
    computedRoot D label roots c = a := by
  rw [computedRoot_two_neighbors D label roots c a b hbelow hleft ha hb]
  exact medianRoot_below a (label c) b hxa

/-- A label above the upper neighbor attaches to the left root. -/
theorem computedRoot_upper (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (a b : ℕ) (hbelow : belowCell c ∈ D)
    (hleft : 0 < c.2 ∧ leftCell c ∈ D)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b)
    (hab : a ≤ b) (hbx : b ≤ label c) :
    computedRoot D label roots c = b := by
  rw [computedRoot_two_neighbors D label roots c a b hbelow hleft ha hb]
  exact medianRoot_above a (label c) b hab hbx

/-- An isolated scan cell is necessarily its own new root. -/
theorem computedRoot_no_neighbors (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (hbelow : belowCell c ∉ D)
    (hleft : ¬ (0 < c.2 ∧ leftCell c ∈ D)) :
    computedRoot D label roots c = label c := by
  simp [computedRoot, lowerEntry, upperEntry, hbelow, hleft]

/-- Update only the current cell; all previously assigned others survive. -/
def writeRoot (roots : PartialRoots) (c : Cell) (r : ℕ) : PartialRoots :=
  fun d => if d = c then some r else roots d

@[simp] theorem writeRoot_at (roots : PartialRoots) (c : Cell) (r : ℕ) :
    writeRoot roots c r c = some r := by
  simp [writeRoot]

theorem writeRoot_other (roots : PartialRoots) (c d : Cell) (r : ℕ)
    (hne : d ≠ c) : writeRoot roots c r d = roots d := by
  simp [writeRoot, hne]

/-- An actual one-cell update of a partial median-scan assignment. -/
def medianScanStep (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell) : PartialRoots :=
  writeRoot roots c (computedRoot D label roots c)

@[simp] theorem medianScanStep_at (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell) :
    medianScanStep D label roots c c = some (computedRoot D label roots c) := by
  simp [medianScanStep]

theorem medianScanStep_other (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c d : Cell) (hne : d ≠ c) :
    medianScanStep D label roots c d = roots d := by
  exact writeRoot_other roots c d (computedRoot D label roots c) hne

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Median construction — finite update histories. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- Apply the local median rule successively to a finite history of cells. -/
def scanHistory (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (roots : PartialRoots) : PartialRoots :=
  history.foldl (medianScanStep D label) roots

@[simp] theorem scanHistory_nil (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) :
    scanHistory D label [] roots = roots := rfl

@[simp] theorem scanHistory_cons (D : Diagram) (label : Cell → ℕ)
    (c : Cell) (cs : List Cell) (roots : PartialRoots) :
    scanHistory D label (c :: cs) roots =
      scanHistory D label cs (medianScanStep D label roots c) := rfl

/-- A cell absent from the history keeps its initial assignment. -/
theorem scanHistory_preserves_outside (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (c : Cell) :
    ∀ roots : PartialRoots, c ∉ history →
      scanHistory D label history roots c = roots c := by
  induction history with
  | nil =>
      intro roots _
      rfl
  | cons d ds ih =>
      intro roots hnot
      have hne : c ≠ d := by
        intro heq
        apply hnot
        simp [heq]
      have htail : c ∉ ds := by
        intro hmem
        apply hnot
        simp [hmem]
      calc
        scanHistory D label (d :: ds) roots c =
            scanHistory D label ds (medianScanStep D label roots d) c := rfl
        _ = medianScanStep D label roots d c :=
          ih (medianScanStep D label roots d) htail
        _ = roots c := medianScanStep_other D label roots d c hne

/-- A repetition-free history assigns a genuine root label to each
    of its processed cells, regardless of the initial partial assignment. -/
theorem scanHistory_assigns (D : Diagram) (label : Cell → ℕ) :
    ∀ (history : List Cell), history.Nodup →
      ∀ c : Cell, c ∈ history → ∀ roots : PartialRoots,
        ∃ r : ℕ, scanHistory D label history roots c = some r := by
  intro history
  induction history with
  | nil =>
      intro _ c hc roots
      simp at hc
  | cons d ds ih =>
      intro hnd c hc roots
      have hnot : d ∉ ds := (List.nodup_cons.mp hnd).1
      have hndds : ds.Nodup := (List.nodup_cons.mp hnd).2
      rcases List.mem_cons.mp hc with heq | hmem
      · subst c
        refine ⟨computedRoot D label roots d, ?_⟩
        calc
          scanHistory D label (d :: ds) roots d =
              scanHistory D label ds (medianScanStep D label roots d) d := rfl
          _ = medianScanStep D label roots d d :=
            scanHistory_preserves_outside D label ds d
              (medianScanStep D label roots d) hnot
          _ = some (computedRoot D label roots d) :=
            medianScanStep_at D label roots d
      · exact ih hndds c hmem (medianScanStep D label roots d)

/-- Start the history with no cell assigned. -/
def unassignedRoots : PartialRoots := fun _ => none

/-- The partial root map after processing the indicated history. -/
def rootsAfterHistory (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) : PartialRoots :=
  scanHistory D label history unassignedRoots

/-- Every listed cell has a root label, provided there are no repetitions. -/
theorem rootsAfterHistory_assigned (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (hnd : history.Nodup)
    (c : Cell) (hc : c ∈ history) :
    ∃ r : ℕ, rootsAfterHistory D label history c = some r := by
  exact scanHistory_assigns D label history hnd c hc unassignedRoots

/-- Cells not yet listed have no root label. -/
theorem rootsAfterHistory_unassigned (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (c : Cell) (hc : c ∉ history) :
    rootsAfterHistory D label history c = none := by
  exact scanHistory_preserves_outside D label history c unassignedRoots hc

/-- The abstract chronological condition for scanning a cell: all of its
 earlier cells in the diagram occur in the already processed history. -/
def EarlierCellsProcessed (D : Diagram) (history : List Cell)
    (c : Cell) : Prop :=
  ∀ d : Cell, d ∈ D → ScanEarlier d c → d ∈ history

/-- Under that chronological condition, both existing immediate
 predecessors have already been visited. -/
theorem earlierCellsProcessed_neighbors (D : Diagram)
    (history : List Cell) (c : Cell)
    (hprev : EarlierCellsProcessed D history c) :
    (belowCell c ∈ D → belowCell c ∈ history) ∧
    (0 < c.2 ∧ leftCell c ∈ D → leftCell c ∈ history) := by
  constructor
  · intro hb
    exact hprev (belowCell c) hb (belowCell_earlier c)
  · intro hl
    exact hprev (leftCell c) hl.2 (leftCell_earlier c hl.1)

/-- In a repetition-free history containing every earlier diagram cell,
    the next cell is ready for the genuine local median rule. -/
theorem rootsAfterHistory_ready (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (hnd : history.Nodup) (c : Cell)
    (hprev : EarlierCellsProcessed D history c) :
    ReadyForScan D (rootsAfterHistory D label history) c := by
  obtain ⟨hbelow, hleft⟩ :=
    earlierCellsProcessed_neighbors D history c hprev
  constructor
  · intro hb
    exact rootsAfterHistory_assigned D label history hnd
      (belowCell c) (hbelow hb)
  · intro hl
    exact rootsAfterHistory_assigned D label history hnd
      (leftCell c) (hleft hl)

/-- Concatenating a final cell really performs its median update last. -/
theorem scanHistory_append_one (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (c : Cell) (roots : PartialRoots) :
    scanHistory D label (history ++ [c]) roots =
      medianScanStep D label (scanHistory D label history roots) c := by
  induction history generalizing roots with
  | nil => rfl
  | cons d ds ih =>
      calc
        scanHistory D label ((d :: ds) ++ [c]) roots =
            scanHistory D label (ds ++ [c])
              (medianScanStep D label roots d) := rfl
        _ = medianScanStep D label
              (scanHistory D label ds (medianScanStep D label roots d)) c :=
          ih (medianScanStep D label roots d)
        _ = medianScanStep D label
              (scanHistory D label (d :: ds) roots) c := rfl

/-- The most recently processed cell receives precisely its computed median. -/
theorem rootsAfterHistory_append_at (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (c : Cell) :
    rootsAfterHistory D label (history ++ [c]) c =
      some (computedRoot D label (rootsAfterHistory D label history) c) := by
  change scanHistory D label (history ++ [c]) unassignedRoots c =
    some (computedRoot D label
      (scanHistory D label history unassignedRoots) c)
  rw [scanHistory_append_one]
  exact medianScanStep_at D label
    (scanHistory D label history unassignedRoots) c

/-- Appending a different cell does not alter any previous assignment. -/
theorem rootsAfterHistory_append_other (D : Diagram) (label : Cell → ℕ)
    (history : List Cell) (c d : Cell) (hne : d ≠ c) :
    rootsAfterHistory D label (history ++ [c]) d =
      rootsAfterHistory D label history d := by
  change scanHistory D label (history ++ [c]) unassignedRoots d =
    scanHistory D label history unassignedRoots d
  rw [scanHistory_append_one]
  exact medianScanStep_other D label
    (scanHistory D label history unassignedRoots) c d hne

/-- Whenever a repetition-free enumeration covers the diagram, the finite
    iteration gives a root label to every cell of that diagram.  Its
    canonical-order property is a *separate* theorem still to be proved. -/
theorem rootsAfterHistory_total_on_diagram (D : Diagram)
    (label : Cell → ℕ) (history : List Cell)
    (hnd : history.Nodup)
    (hcover : ∀ c : Cell, c ∈ D → c ∈ history) :
    ∀ c : Cell, c ∈ D →
      ∃ r : ℕ, rootsAfterHistory D label history c = some r := by
  intro c hc
  exact rootsAfterHistory_assigned D label history hnd c (hcover c hc)

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Median construction — canonical order of the cells. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The non-strict form of the south-to-north, left-to-right scan order. -/
def ScanLE (a b : Cell) : Prop := a = b ∨ ScanEarlier a b

instance scanLE_trans : IsTrans Cell ScanLE where
  trans a b c hab hbc := by
    rcases hab with hab | hab
    · subst b
      exact hbc
    rcases hbc with hbc | hbc
    · subst c
      exact Or.inr hab
    · exact Or.inr (scanEarlier_trans hab hbc)

instance scanLE_antisymm : Std.Antisymm ScanLE where
  antisymm a b hab hba := by
    rcases hab with heq | hab
    · exact heq
    rcases hba with heq | hba
    · exact heq.symm
    · exact False.elim ((scanEarlier_irrefl a) (scanEarlier_trans hab hba))

instance scanLE_total : Std.Total ScanLE where
  total a b := by
    by_cases heq : a = b
    · exact Or.inl (Or.inl heq)
    · rcases scanEarlier_total_of_ne heq with hab | hba
      · exact Or.inl (Or.inr hab)
      · exact Or.inr (Or.inr hba)

/-- Sort each diagram by decreasing row, then increasing column. -/
noncomputable def canonicalScanHistory (D : Diagram) : List Cell := by
  classical
  exact D.sort ScanLE

/-- The canonical scan contains exactly the cells of the diagram. -/
theorem canonicalScanHistory_mem (D : Diagram) (c : Cell) :
    c ∈ canonicalScanHistory D ↔ c ∈ D := by
  classical
  unfold canonicalScanHistory
  exact Finset.mem_sort ScanLE

/-- Each diagram cell occurs only once in the canonical scan. -/
theorem canonicalScanHistory_nodup (D : Diagram) :
    (canonicalScanHistory D).Nodup := by
  classical
  unfold canonicalScanHistory
  exact Finset.sort_nodup D ScanLE

/-- The canonical history is sorted by the chronological relation. -/
theorem canonicalScanHistory_pairwise (D : Diagram) :
    List.Pairwise ScanLE (canonicalScanHistory D) := by
  classical
  unfold canonicalScanHistory
  exact Finset.pairwise_sort D ScanLE

/-- Any diagram cell earlier than the current cell occurs in its prefix,
not in the current position or in the remaining suffix. -/
theorem canonicalScanHistory_predecessor_in_prefix (D : Diagram)
    (past future : List Cell) (c d : Cell)
    (h : canonicalScanHistory D = past ++ c :: future)
    (hd : d ∈ D) (hdc : ScanEarlier d c) :
    d ∈ past := by
  have hmem : d ∈ past ++ c :: future := by
    rw [← h]
    exact (canonicalScanHistory_mem D d).2 hd
  have hpair : List.Pairwise ScanLE (past ++ c :: future) := by
    rw [← h]
    exact canonicalScanHistory_pairwise D
  rcases List.mem_append.mp hmem with hp | ht
  · exact hp
  rcases List.mem_cons.mp ht with heq | hf
  · subst d
    exact False.elim ((scanEarlier_irrefl c) hdc)
  have htail : List.Pairwise ScanLE (c :: future) :=
    (List.pairwise_append.mp hpair).2.1
  have hcd : ScanLE c d :=
    (List.pairwise_cons.mp htail).1 d hf
  rcases hcd with heq | hcd
  · subst d
    exact False.elim ((scanEarlier_irrefl c) hdc)
  · exact False.elim ((scanEarlier_irrefl c) (scanEarlier_trans hcd hdc))

/-- Every cell is ready for the local median recurrence when reached
by the canonical enumeration. -/
theorem canonicalScanHistory_ready (D : Diagram) (label : Cell → ℕ)
    (past future : List Cell) (c : Cell)
    (h : canonicalScanHistory D = past ++ c :: future) :
    ReadyForScan D (rootsAfterHistory D label past) c := by
  have hnd : past.Nodup := by
    have hall : (past ++ c :: future).Nodup := by
      rw [← h]
      exact canonicalScanHistory_nodup D
    exact List.Nodup.of_append_left hall
  have hprev : EarlierCellsProcessed D past c := by
    intro d hd hdc
    exact canonicalScanHistory_predecessor_in_prefix D past future c d h hd hdc
  exact rootsAfterHistory_ready D label past hnd c hprev

/-- The canonical scan yields a root label for every cell of the diagram. -/
theorem canonicalScanHistory_total (D : Diagram) (label : Cell → ℕ) :
    ∀ c : Cell, c ∈ D →
      ∃ r : ℕ, rootsAfterHistory D label (canonicalScanHistory D) c = some r := by
  exact rootsAfterHistory_total_on_diagram D label (canonicalScanHistory D)
    (canonicalScanHistory_nodup D)
    (fun c hc => (canonicalScanHistory_mem D c).2 hc)

/-- Outside the diagram, the canonical scan leaves root labels undefined. -/
theorem canonicalScanHistory_outside (D : Diagram) (label : Cell → ℕ)
    (c : Cell) (hc : c ∉ D) :
    rootsAfterHistory D label (canonicalScanHistory D) c = none := by
  apply rootsAfterHistory_unassigned
  intro hmem
  exact hc ((canonicalScanHistory_mem D c).1 hmem)

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Median construction — roots, provenance and fibers. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- For any optional bounds, the median chooses either the new label
or one of the two *present* bounds. No assumption that the bounds
are ordered is needed for this exhaustive statement. -/
theorem medianOptional_source (x : ℕ) (lo hi : Option ℕ) :
    medianOptional x lo hi = x ∨
    (∃ a : ℕ, lo = some a ∧ medianOptional x lo hi = a) ∨
    (∃ b : ℕ, hi = some b ∧ medianOptional x lo hi = b) := by
  cases lo with
  | none =>
      cases hi with
      | none => exact Or.inl rfl
      | some b =>
          rcases medianOptional_upper_choices x b with hx | hb
          · exact Or.inl hx
          · exact Or.inr (Or.inr ⟨b, rfl, hb⟩)
  | some a =>
      cases hi with
      | none =>
          rcases medianOptional_lower_choices a x with ha | hx
          · exact Or.inr (Or.inl ⟨a, rfl, ha⟩)
          · exact Or.inl hx
      | some b =>
          by_cases hab : a ≤ b
          · rcases medianOptional_three_cases a x b hab with ha | hx | hb
            · exact Or.inr (Or.inl ⟨a, rfl, ha⟩)
            · exact Or.inl hx
            · exact Or.inr (Or.inr ⟨b, rfl, hb⟩)
          · have hba : b ≤ a := by omega
            have ha : medianOptional x (some a) (some b) = a := by
              change max a (min x b) = a
              exact max_eq_left (le_trans (min_le_right x b) hba)
            exact Or.inr (Or.inl ⟨a, rfl, ha⟩)

/-- A lower entry can only come from the already stored lower neighbor. -/
theorem lowerEntry_some (D : Diagram) (roots : PartialRoots)
    (c : Cell) (a : ℕ) (h : lowerEntry D roots c = some a) :
    roots (belowCell c) = some a := by
  by_cases hb : belowCell c ∈ D
  · simpa [lowerEntry, hb] using h
  · simp [lowerEntry, hb] at h

/-- An upper entry can only come from the already stored left neighbor. -/
theorem upperEntry_some (D : Diagram) (roots : PartialRoots)
    (c : Cell) (b : ℕ) (h : upperEntry D roots c = some b) :
    roots (leftCell c) = some b := by
  by_cases hl : 0 < c.2 ∧ leftCell c ∈ D
  · simpa [upperEntry, hl] using h
  · simp [upperEntry, hl] at h

/-- The computed root is the cell's own label or a label already
stored at some cell. This property does not require a skew diagram. -/
theorem computedRoot_source (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell) :
    computedRoot D label roots c = label c ∨
      ∃ d : Cell, roots d = some (computedRoot D label roots c) := by
  rcases medianOptional_source (label c)
      (lowerEntry D roots c) (upperEntry D roots c) with
      hself | ⟨a, ha, hroot⟩ | ⟨b, hb, hroot⟩
  · exact Or.inl hself
  · have hstored := lowerEntry_some D roots c a ha
    change computedRoot D label roots c = a at hroot
    refine Or.inr ⟨belowCell c, ?_⟩
    rw [hroot]
    exact hstored
  · have hstored := upperEntry_some D roots c b hb
    change computedRoot D label roots c = b at hroot
    refine Or.inr ⟨leftCell c, ?_⟩
    rw [hroot]
    exact hstored

/-- After a finite history, every assigned root label either came
from one of the cells of that history or was already in the initial
partial assignment. This is a genuine induction invariant. -/
theorem scanHistory_value_origin (D : Diagram) (label : Cell → ℕ) :
    ∀ (history : List Cell) (roots : PartialRoots)
      (d : Cell) (r : ℕ),
      scanHistory D label history roots d = some r →
      (∃ c : Cell, c ∈ history ∧ label c = r) ∨
      (∃ c : Cell, roots c = some r) := by
  intro history
  induction history with
  | nil =>
      intro roots d r h
      exact Or.inr ⟨d, h⟩
  | cons c cs ih =>
      intro roots d r h
      change scanHistory D label cs (medianScanStep D label roots c) d =
        some r at h
      rcases ih (medianScanStep D label roots c) d r h with
        ⟨e, he, hlabel⟩ | ⟨e, he⟩
      · exact Or.inl ⟨e, by simp [he], hlabel⟩
      · by_cases hec : e = c
        · subst e
          have hcroot : computedRoot D label roots c = r := by
            have h0 : some (computedRoot D label roots c) = some r := by
              calc
                some (computedRoot D label roots c) =
                    medianScanStep D label roots c c :=
                  (medianScanStep_at D label roots c).symm
                _ = some r := he
            injection h0 with hz
          rcases computedRoot_source D label roots c with
            hself | ⟨e, he'⟩
          · exact Or.inl ⟨c, by simp, hself.symm.trans hcroot⟩
          · exact Or.inr ⟨e, by simpa [hcroot] using he'⟩
        · have hprev : roots e = some r := by
            calc
              roots e = medianScanStep D label roots c e :=
                (medianScanStep_other D label roots c e hec).symm
              _ = some r := he
          exact Or.inr ⟨e, hprev⟩

/-- Every final root label is a label attached to an actual cell of
D, not a value fabricated by the iteration. -/
theorem canonicalRoot_value_origin (D : Diagram)
    (label : Cell → ℕ) (c : Cell) (r : ℕ)
    (h : rootsAfterHistory D label (canonicalScanHistory D) c = some r) :
    ∃ d : Cell, d ∈ D ∧ label d = r := by
  change scanHistory D label (canonicalScanHistory D) unassignedRoots c =
    some r at h
  rcases scanHistory_value_origin D label
      (canonicalScanHistory D) unassignedRoots c r h with
      ⟨d, hd, hlabel⟩ | ⟨d, hd⟩
  · exact ⟨d, (canonicalScanHistory_mem D d).mp hd, hlabel⟩
  · simp [unassignedRoots] at hd

/-- The set of cells assigned a particular root label by the *complete*
canonical scan. This is the construction block, before any connectivity
or shape properties have been shown. -/
noncomputable def canonicalRootFiber (D : Diagram)
    (label : Cell → ℕ) (r : ℕ) : Finset Cell := by
  classical
  exact D.filter (fun c =>
    rootsAfterHistory D label (canonicalScanHistory D) c = some r)

@[simp] theorem mem_canonicalRootFiber (D : Diagram)
    (label : Cell → ℕ) (r : ℕ) (c : Cell) :
    c ∈ canonicalRootFiber D label r ↔
      c ∈ D ∧
        rootsAfterHistory D label (canonicalScanHistory D) c = some r := by
  classical
  simp [canonicalRootFiber]

/-- Each construction block is contained in the original diagram. -/
theorem canonicalRootFiber_subset (D : Diagram) (label : Cell → ℕ)
    (r : ℕ) : canonicalRootFiber D label r ⊆ D := by
  intro c hc
  exact ((mem_canonicalRootFiber D label r c).mp hc).1

/-- Every diagram cell belongs to some construction block. -/
theorem canonicalRootFiber_cover (D : Diagram) (label : Cell → ℕ)
    (c : Cell) (hc : c ∈ D) :
    ∃ r : ℕ, c ∈ canonicalRootFiber D label r := by
  obtain ⟨r, hr⟩ := canonicalScanHistory_total D label c hc
  exact ⟨r, (mem_canonicalRootFiber D label r c).mpr ⟨hc, hr⟩⟩

/-- Two root labels cannot claim the same cell unless they agree. -/
theorem canonicalRootFiber_unique (D : Diagram) (label : Cell → ℕ)
    (c : Cell) (a b : ℕ)
    (ha : c ∈ canonicalRootFiber D label a)
    (hb : c ∈ canonicalRootFiber D label b) : a = b := by
  have h1 := ((mem_canonicalRootFiber D label a c).mp ha).2
  have h2 := ((mem_canonicalRootFiber D label b c).mp hb).2
  have heq : (some a : Option ℕ) = some b := h1.symm.trans h2
  injection heq with h

/-- Fibers indexed by distinct labels are disjoint. -/
theorem canonicalRootFiber_disjoint (D : Diagram) (label : Cell → ℕ)
    (a b : ℕ) (hab : a ≠ b) :
    Disjoint (canonicalRootFiber D label a)
      (canonicalRootFiber D label b) := by
  classical
  apply Finset.disjoint_left.mpr
  intro c ha hb
  exact hab (canonicalRootFiber_unique D label c a b ha hb)

/-- A nonempty fiber is indexed by a label that occurred in D. -/
theorem canonicalRootFiber_nonempty_origin (D : Diagram)
    (label : Cell → ℕ) (r : ℕ)
    (h : (canonicalRootFiber D label r).Nonempty) :
    ∃ d : Cell, d ∈ D ∧ label d = r := by
  obtain ⟨c, hc⟩ := h
  exact canonicalRoot_value_origin D label c r
    ((mem_canonicalRootFiber D label r c).mp hc).2

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Lemma 4.3: Connectivity and geometry of the fibers
### Connectivity of each root fiber

A genuine bijective labeling of a finite skew diagram assigns *distinct*
labels to its cells. This hypothesis is indispensable for connectivity:
if two unrelated cells have the same label, the median procedure may put
them in the same (disconnected) fiber.

Connectivity follows from a root-route invariant. When a cell is added, the
median either keeps the cell's own label or inherits a label of the lower
or left predecessor. Each inherited label is accompanied by a route of
adjacent cells to an original cell bearing that label. The invariant is
maintained throughout a scan with no repeated cells. Injectivity of the
original labeling ensures that any two routes with the same label end at
the same anchor. This proves graph connectivity of the corresponding
fiber, without presupposing skewness or invoking a pre-existing block
partition.

The statements here concern *connectivity only*. The geometric skew-
diagram structure and the two strict boundary inequalities will be handled
in subsequent parts of Lemma 4.3. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The local median either chooses the label of the new cell, or
inherits exactly the label already assigned to an existing predecessor.
Unlike the earlier root-label provenance lemma, the alternatives explicitly
identify which predecessor and establish that it belongs to the diagram. -/
theorem computedRoot_self_or_predecessor (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell) :
    computedRoot D label roots c = label c ∨
    (belowCell c ∈ D ∧
      roots (belowCell c) = some (computedRoot D label roots c)) ∨
    (0 < c.2 ∧ leftCell c ∈ D ∧
      roots (leftCell c) = some (computedRoot D label roots c)) := by
  rcases medianOptional_source (label c)
      (lowerEntry D roots c) (upperEntry D roots c) with
      hself | ⟨a, ha, hroot⟩ | ⟨b, hb, hroot⟩
  · exact Or.inl hself
  · have hmem : belowCell c ∈ D := by
      by_contra hn
      simp [lowerEntry, hn] at ha
    have hstored := lowerEntry_some D roots c a ha
    change computedRoot D label roots c = a at hroot
    exact Or.inr (Or.inl ⟨hmem, by rw [hroot]; exact hstored⟩)
  · have hmem : 0 < c.2 ∧ leftCell c ∈ D := by
      by_contra hn
      simp [upperEntry, hn] at hb
    have hstored := upperEntry_some D roots c b hb
    change computedRoot D label roots c = b at hroot
    exact Or.inr (Or.inr ⟨hmem.1, hmem.2,
      by rw [hroot]; exact hstored⟩)

/-- A directed, root-preserving walk from a cell to a chosen anchor.
Every vertex in the walk belongs to `D` and has the same assigned root.
The steps use only the south and west predecessors, so they follow the
chronological direction of the median scan. -/
inductive RootRoute (D : Diagram) (roots : PartialRoots) (r : ℕ) :
    Cell → Cell → Prop where
  | stop (c : Cell) (hc : c ∈ D) (hr : roots c = some r) :
      RootRoute D roots r c c
  | viaBelow (c d : Cell) (hc : c ∈ D)
      (hbelow : belowCell c ∈ D)
      (hrc : roots c = some r)
      (hrbelow : roots (belowCell c) = some r)
      (hrest : RootRoute D roots r (belowCell c) d) :
      RootRoute D roots r c d
  | viaLeft (c d : Cell) (hc : c ∈ D)
      (hcol : 0 < c.2) (hleft : leftCell c ∈ D)
      (hrc : roots c = some r)
      (hrleft : roots (leftCell c) = some r)
      (hrest : RootRoute D roots r (leftCell c) d) :
      RootRoute D roots r c d

/-- Root routes survive any update that preserves existing root labels.
This is the key to transferring a route from a scanned prefix to the
prefix after appending one more, previously unassigned cell. -/
theorem rootRoute_mono {D : Diagram} {old new : PartialRoots}
    {r : ℕ} {c d : Cell}
    (hmono : ∀ x : Cell, old x = some r → new x = some r)
    (hroute : RootRoute D old r c d) : RootRoute D new r c d := by
  induction hroute with
  | stop c hc hr =>
      exact RootRoute.stop c hc (hmono c hr)
  | viaBelow c d hc hb hrc hrb _ ih =>
      exact RootRoute.viaBelow c d hc hb
        (hmono c hrc) (hmono (belowCell c) hrb) ih
  | viaLeft c d hc hcol hl hrc hrl _ ih =>
      exact RootRoute.viaLeft c d hc hcol hl
        (hmono c hrc) (hmono (leftCell c) hrl) ih

/-- Every assigned label has a route from each cell carrying it to an
anchor in the original diagram whose *original* label is that value. -/
def HasRootRoutes (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) : Prop :=
  ∀ (c : Cell) (r : ℕ), roots c = some r →
    ∃ d : Cell, d ∈ D ∧ label d = r ∧ RootRoute D roots r c d

/-- There are initially no assigned labels and hence no route obligations. -/
theorem unassigned_hasRootRoutes (D : Diagram) (label : Cell → ℕ) :
    HasRootRoutes D label unassignedRoots := by
  intro c r h
  simp [unassignedRoots] at h

/-- One new cell preserves the root-route invariant, provided its
location was unassigned before the update. -/
theorem medianScanStep_hasRootRoutes (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell) (hcD : c ∈ D)
    (hfree : roots c = none)
    (hInv : HasRootRoutes D label roots) :
    HasRootRoutes D label (medianScanStep D label roots c) := by
  have hmono : ∀ (x : Cell) (r : ℕ),
      roots x = some r → medianScanStep D label roots c x = some r := by
    intro x r hx
    by_cases hxc : x = c
    · subst x
      rw [hfree] at hx
      cases hx
    · rw [medianScanStep_other D label roots c x hxc]
      exact hx
  intro x r hx
  by_cases hxc : x = c
  · subst x
    have hroot : computedRoot D label roots c = r := by
      have heq : some (computedRoot D label roots c) = some r := by
        calc
          some (computedRoot D label roots c) =
              medianScanStep D label roots c c :=
            (medianScanStep_at D label roots c).symm
          _ = some r := hx
      exact Option.some.inj heq
    rcases computedRoot_self_or_predecessor D label roots c with
      hself | ⟨hbD, hb⟩ | ⟨hcol, hlD, hl⟩
    · refine ⟨c, hcD, hself.symm.trans hroot, ?_⟩
      exact RootRoute.stop c hcD hx
    · have hbr : roots (belowCell c) = some r := by
        rw [← hroot]
        exact hb
      obtain ⟨d, hdD, hlabel, hroute⟩ := hInv (belowCell c) r hbr
      refine ⟨d, hdD, hlabel, ?_⟩
      exact RootRoute.viaBelow c d hcD hbD hx
        (hmono (belowCell c) r hbr)
        (rootRoute_mono (fun x h => hmono x r h) hroute)
    · have hlr : roots (leftCell c) = some r := by
        rw [← hroot]
        exact hl
      obtain ⟨d, hdD, hlabel, hroute⟩ := hInv (leftCell c) r hlr
      refine ⟨d, hdD, hlabel, ?_⟩
      exact RootRoute.viaLeft c d hcD hcol hlD hx
        (hmono (leftCell c) r hlr)
        (rootRoute_mono (fun x h => hmono x r h) hroute)
  · have hold : roots x = some r := by
      rw [medianScanStep_other D label roots c x hxc] at hx
      exact hx
    obtain ⟨d, hdD, hlabel, hroute⟩ := hInv x r hold
    exact ⟨d, hdD, hlabel,
      rootRoute_mono (fun x h => hmono x r h) hroute⟩

/-- Scanning a repetition-free list of currently unassigned diagram
cells preserves routes. The proof is a true induction on the finite
history; no geometry or uniqueness of block partition is assumed. -/
theorem scanHistory_hasRootRoutes (D : Diagram) (label : Cell → ℕ) :
    ∀ (history : List Cell) (roots : PartialRoots),
      history.Nodup →
      (∀ c : Cell, c ∈ history → c ∈ D) →
      (∀ c : Cell, c ∈ history → roots c = none) →
      HasRootRoutes D label roots →
      HasRootRoutes D label (scanHistory D label history roots) := by
  intro history
  induction history with
  | nil =>
      intro roots _ _ _ hInv
      exact hInv
  | cons c cs ih =>
      intro roots hnd hwithin hfree hInv
      have hcD : c ∈ D := hwithin c (by simp)
      have hcfree : roots c = none := hfree c (by simp)
      have hnot : c ∉ cs := (List.nodup_cons.mp hnd).1
      have htailnd : cs.Nodup := (List.nodup_cons.mp hnd).2
      have htailWithin : ∀ d : Cell, d ∈ cs → d ∈ D := by
        intro d hd
        exact hwithin d (by simp [hd])
      have htailFree : ∀ d : Cell, d ∈ cs →
          medianScanStep D label roots c d = none := by
        intro d hd
        have hne : d ≠ c := by
          intro heq
          subst d
          exact hnot hd
        rw [medianScanStep_other D label roots c d hne]
        exact hfree d (by simp [hd])
      change HasRootRoutes D label
        (scanHistory D label cs (medianScanStep D label roots c))
      exact ih (medianScanStep D label roots c) htailnd
        htailWithin htailFree
        (medianScanStep_hasRootRoutes D label roots c hcD hcfree hInv)

/-- After the full canonical scan, every assigned cell has a root-route
inside the diagram to a cell that originally bore its root label. -/
theorem canonicalRoot_hasRoute (D : Diagram) (label : Cell → ℕ)
    (c : Cell) (r : ℕ)
    (hc : rootsAfterHistory D label (canonicalScanHistory D) c = some r) :
    ∃ d : Cell, d ∈ D ∧ label d = r ∧
      RootRoute D (rootsAfterHistory D label (canonicalScanHistory D)) r c d := by
  have hInv := scanHistory_hasRootRoutes D label
    (canonicalScanHistory D) unassignedRoots
    (canonicalScanHistory_nodup D)
    (fun d hd => (canonicalScanHistory_mem D d).mp hd)
    (fun _ _ => rfl)
    (unassigned_hasRootRoutes D label)
  exact hInv c r hc

/-- Orthogonal adjacency in the integer grid, with each step written in
one of the south/west directions or its reversal. -/
def GridAdjacent (a b : Cell) : Prop :=
  b = belowCell a ∨ a = belowCell b ∨
  (0 < a.2 ∧ b = leftCell a) ∨ (0 < b.2 ∧ a = leftCell b)

/-- An undirected path of diagram cells carrying one and the same root.
This is an explicit edge-path connectivity predicate, not a mere claim
about membership in a common fiber. -/
inductive FiberWalk (D : Diagram) (roots : PartialRoots) (r : ℕ) :
    Cell → Cell → Prop where
  | refl (c : Cell) (hc : c ∈ D) (hr : roots c = some r) :
      FiberWalk D roots r c c
  | edge (a b : Cell) (ha : a ∈ D) (hb : b ∈ D)
      (hra : roots a = some r) (hrb : roots b = some r)
      (hadj : GridAdjacent a b) : FiberWalk D roots r a b
  | symm {a b : Cell} (h : FiberWalk D roots r a b) :
      FiberWalk D roots r b a
  | trans {a b c : Cell} (h₁ : FiberWalk D roots r a b)
      (h₂ : FiberWalk D roots r b c) : FiberWalk D roots r a c

/-- Each route to an original root is an undirected walk within its
fiber, because every route step is an adjacent, equal-root pair. -/
theorem rootRoute_to_fiberWalk {D : Diagram} {roots : PartialRoots}
    {r : ℕ} {c d : Cell} (hroute : RootRoute D roots r c d) :
    FiberWalk D roots r c d := by
  induction hroute with
  | stop c hc hr =>
      exact FiberWalk.refl c hc hr
  | viaBelow c d hc hb hrc hrb _ ih =>
      exact FiberWalk.trans
        (FiberWalk.edge c (belowCell c) hc hb hrc hrb (Or.inl rfl)) ih
  | viaLeft c d hc hcol hl hrc hrl _ ih =>
      exact FiberWalk.trans
        (FiberWalk.edge c (leftCell c) hc hl hrc hrl
          (Or.inr (Or.inr (Or.inl ⟨hcol, rfl⟩)))) ih

/-- Connectivity theorem for canonical root fibers: for pairwise distinct cell
labels, every nonempty canonical fiber is graph-connected. Indeed any
two of its cells can be joined by a path of orthogonally adjacent cells,
all in that same fiber. No skewness assumption is needed for this step. -/
theorem canonicalRootFiber_connected (D : Diagram) (label : Cell → ℕ)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) (c d : Cell)
    (hc : c ∈ canonicalRootFiber D label r)
    (hd : d ∈ canonicalRootFiber D label r) :
    FiberWalk D (rootsAfterHistory D label (canonicalScanHistory D)) r c d := by
  obtain ⟨a, haD, har, hrouteA⟩ := canonicalRoot_hasRoute D label c r
    ((mem_canonicalRootFiber D label r c).mp hc).2
  obtain ⟨b, hbD, hbr, hrouteB⟩ := canonicalRoot_hasRoute D label d r
    ((mem_canonicalRootFiber D label r d).mp hd).2
  have hab : a = b := hinj a haD b hbD (har.trans hbr.symm)
  subst b
  exact FiberWalk.trans (rootRoute_to_fiberWalk hrouteA)
    (FiberWalk.symm (rootRoute_to_fiberWalk hrouteB))

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — the skew-square lemma and local order. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- A skew row-interval diagram fills the southwest cell of a 2-by-2
square whenever its southeast and northwest cells are occupied. -/
theorem skewRowIntervals_southwest_square {D : Diagram}
    (hsk : SkewRowIntervals D) (r j : ℕ)
    (hbelow : (r + 1, j) ∈ D)
    (hleft : 0 < j ∧ (r, j - 1) ∈ D) :
    (r + 1, j - 1) ∈ D := by
  obtain ⟨n, lo, hi, hmem, hlo, _⟩ := hsk
  have hb := (hmem (r + 1) j).mp hbelow
  have hl := (hmem r (j - 1)).mp hleft.2
  have hlo' : lo (r + 1) ≤ lo r := hlo r hb.1
  apply (hmem (r + 1) (j - 1)).mpr
  constructor
  · exact hb.1
  constructor
  · omega
  · omega

/-- Lemma 4.3 — interblock root order.
    Source: Kahane Definition 4.2 refers to Definition 3.2:
    whenever a cell of B_i is below another cell in B_j in the poset,
    the root labels must be strictly ordered if i != j.
    Here we impose WEAK local order at neighboring cells (equality is
    permitted within a block). Their equivalence to the FULL global
    block order of Kahane Definition 3.2 is established below by
    `rootLocallyOrdered_iff_kahaneGlobal`, under totality, outside-none,
    and `SkewRowIntervals`. -/
def RootLocallyOrdered (D : Diagram) (roots : PartialRoots) : Prop :=
  (∀ c : Cell, c ∈ D → ∀ a b : ℕ,
    roots (belowCell c) = some a → roots c = some b → a ≤ b) ∧
  (∀ c : Cell, c ∈ D → ∀ a b : ℕ,
    roots c = some a → roots (leftCell c) = some b → a ≤ b)

/-- An assigned cell already has assigned roots on all its occupied
predecessors. This is automatic for a prefix of a proper scan, but is
spelled out here as a separate invariant. -/
def RootPastComplete (D : Diagram) (roots : PartialRoots) : Prop :=
  ∀ c : Cell, c ∈ D → ∀ r : ℕ, roots c = some r →
    (belowCell c ∈ D → ∃ a : ℕ, roots (belowCell c) = some a) ∧
    (0 < c.2 ∧ leftCell c ∈ D →
      ∃ b : ℕ, roots (leftCell c) = some b)

/-- The two roots bounding a median update are correctly ordered.
This is the first genuinely two-dimensional geometric invariant. -/
theorem predecessor_bounds_ordered {D : Diagram}
    (hsk : SkewRowIntervals D) (roots : PartialRoots)
    (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots) (c : Cell)
    (hbD : belowCell c ∈ D)
    (hlD : 0 < c.2 ∧ leftCell c ∈ D)
    (a b : ℕ)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b) : a ≤ b := by
  have hswD : belowCell (leftCell c) ∈ D := by
    have hs := skewRowIntervals_southwest_square hsk c.1 c.2
      (by simpa [belowCell] using hbD)
      ⟨hlD.1, by simpa [leftCell] using hlD.2⟩
    simpa [belowCell, leftCell] using hs
  obtain ⟨s, hs⟩ := (hpast (leftCell c) hlD.2 b hb).1 hswD
  have hcomm : leftCell (belowCell c) = belowCell (leftCell c) := by
    simp [leftCell, belowCell]
  have has : a ≤ s := by
    apply hord.2 (belowCell c) hbD a s ha
    rw [hcomm]
    exact hs
  have hsb : s ≤ b := hord.1 (leftCell c) hlD.2 s b hs hb
  exact has.trans hsb

/-- With the geometric ordering invariant, the median is between the
assigned lower and upper roots whenever both neighbors exist. -/
theorem computedRoot_ordered_bounds {D : Diagram}
    (hsk : SkewRowIntervals D) (label : Cell → ℕ)
    (roots : PartialRoots) (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots) (c : Cell)
    (hbD : belowCell c ∈ D)
    (hlD : 0 < c.2 ∧ leftCell c ∈ D)
    (a b : ℕ)
    (ha : roots (belowCell c) = some a)
    (hb : roots (leftCell c) = some b) :
    a ≤ computedRoot D label roots c ∧
      computedRoot D label roots c ≤ b := by
  apply computedRoot_between D label roots c a b hbD hlD ha hb
  exact predecessor_bounds_ordered hsk roots hord hpast c hbD hlD a b ha hb

/-- A nonincreasing root assignment along each occupied row, without
assuming that all roots are defined. -/
def RowRootAntitone (D : Diagram) (roots : PartialRoots) : Prop :=
  ∀ row a b x y : ℕ, a ≤ b →
    (row, a) ∈ D → (row, b) ∈ D →
    roots (row, a) = some x → roots (row, b) = some y → y ≤ x

/-- If total roots decrease along every row, each root fiber is itself
row-convex. Notice that this conclusion uses the *actual* canonical
root fibers, not an independently defined surrogate partition. -/
theorem canonicalRootFiber_rowConvex_of_antitone (D : Diagram)
    (label : Cell → ℕ) (hconv : RowConvex D)
    (hanti : RowRootAntitone D
      (rootsAfterHistory D label (canonicalScanHistory D)))
    (root : ℕ) : RowConvex (canonicalRootFiber D label root) := by
  intro row a b j ha hb haj hjb
  have ha' := (mem_canonicalRootFiber D label root (row, a)).mp ha
  have hb' := (mem_canonicalRootFiber D label root (row, b)).mp hb
  have hjD : (row, j) ∈ D :=
    hconv row a b j ha'.1 hb'.1 haj hjb
  obtain ⟨x, hx⟩ := canonicalScanHistory_total D label (row, j) hjD
  have hxroot : x ≤ root :=
    hanti row a j root x haj ha'.1 hjD ha'.2 hx
  have hrootx : root ≤ x :=
    hanti row j b x root hjb hjD hb'.1 hx hb'.2
  have hxr : x = root := le_antisymm hxroot hrootx
  exact (mem_canonicalRootFiber D label root (row, j)).mpr
    ⟨hjD, by simpa [hxr] using hx⟩


/-- The entirely unassigned state satisfies both induction invariants. -/
theorem unassignedRoots_locallyOrdered (D : Diagram) :
    RootLocallyOrdered D unassignedRoots := by
  constructor
  · intro c hc a b ha hb
    simp [unassignedRoots] at hb
  · intro c hc a b ha hb
    simp [unassignedRoots] at ha

theorem unassignedRoots_pastComplete (D : Diagram) :
    RootPastComplete D unassignedRoots := by
  intro c hc r hr
  simp [unassignedRoots] at hr

/-- Even when the left neighbor is absent, the local median cannot
fall below an assigned lower root. -/
theorem computedRoot_lowerBound {D : Diagram}
    (hsk : SkewRowIntervals D) (label : Cell → ℕ)
    (roots : PartialRoots) (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots) (c : Cell)
    (hready : ReadyForScan D roots c)
    (hbD : belowCell c ∈ D) (a : ℕ)
    (ha : roots (belowCell c) = some a) :
    a ≤ computedRoot D label roots c := by
  by_cases hlD : 0 < c.2 ∧ leftCell c ∈ D
  · obtain ⟨b, hb⟩ := hready.2 hlD
    exact (computedRoot_ordered_bounds hsk label roots hord hpast c
      hbD hlD a b ha hb).1
  · have heq : computedRoot D label roots c = max a (label c) := by
      simp [computedRoot, lowerEntry, upperEntry, hbD, hlD, ha]
    rw [heq]
    exact le_max_left a (label c)

/-- Even when the lower neighbor is absent, the local median cannot
exceed an assigned left root. -/
theorem computedRoot_upperBound {D : Diagram}
    (hsk : SkewRowIntervals D) (label : Cell → ℕ)
    (roots : PartialRoots) (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots) (c : Cell)
    (hready : ReadyForScan D roots c)
    (hlD : 0 < c.2 ∧ leftCell c ∈ D) (b : ℕ)
    (hb : roots (leftCell c) = some b) :
    computedRoot D label roots c ≤ b := by
  by_cases hbD : belowCell c ∈ D
  · obtain ⟨a, ha⟩ := hready.1 hbD
    exact (computedRoot_ordered_bounds hsk label roots hord hpast c
      hbD hlD a b ha hb).2
  · have heq : computedRoot D label roots c = min (label c) b := by
      simp [computedRoot, lowerEntry, upperEntry, hbD, hlD, hb]
    rw [heq]
    exact min_le_right (label c) b

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — global invariant of root order. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- Every partial canonical history is supported on the actual diagram. -/
theorem rootsAfterHistory_supported (D : Diagram) (label : Cell → ℕ)
    (history : List Cell)
    (hwithin : ∀ c : Cell, c ∈ history → c ∈ D) :
    ∀ c : Cell, c ∉ D → rootsAfterHistory D label history c = none := by
  intro c hc
  apply rootsAfterHistory_unassigned
  intro hmem
  exact hc (hwithin c hmem)

/-- The cell immediately below is never the cell itself. -/
theorem belowCell_ne_self (c : Cell) : belowCell c ≠ c := by
  intro h
  have hrow := congrArg Prod.fst h
  dsimp [belowCell] at hrow
  omega

/-- At positive column index, the cell to the left is different. -/
theorem leftCell_ne_self (c : Cell) (hpos : 0 < c.2) :
    leftCell c ≠ c := by
  intro h
  have hcol := congrArg Prod.snd h
  dsimp [leftCell] at hcol
  omega

/-- When the current cell is fresh and all its predecessors are ready,
updating it preserves predecessor-completeness of all assigned cells. -/
theorem medianScanStep_pastComplete (D : Diagram)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (hpast : RootPastComplete D roots)
    (hready : ReadyForScan D roots c) :
    RootPastComplete D (medianScanStep D label roots c) := by
  intro d hd r hroot
  by_cases hdc : d = c
  · subst d
    constructor
    · intro hbD
      obtain ⟨a, ha⟩ := hready.1 hbD
      refine ⟨a, ?_⟩
      simpa only [medianScanStep_other D label roots c (belowCell c)
        (belowCell_ne_self c)] using ha
    · intro hlD
      obtain ⟨b, hb⟩ := hready.2 hlD
      refine ⟨b, ?_⟩
      simpa only [medianScanStep_other D label roots c (leftCell c)
        (leftCell_ne_self c hlD.1)] using hb
  · have hrootOld : roots d = some r := by
      simpa only [medianScanStep_other D label roots c d hdc] using hroot
    obtain ⟨hbelow, hleft⟩ := hpast d hd r hrootOld
    constructor
    · intro hbD
      obtain ⟨a, ha⟩ := hbelow hbD
      by_cases heq : belowCell d = c
      · refine ⟨computedRoot D label roots c, ?_⟩
        rw [heq]
        exact medianScanStep_at D label roots c
      · refine ⟨a, ?_⟩
        simpa only [medianScanStep_other D label roots c (belowCell d) heq]
          using ha
    · intro hlD
      obtain ⟨b, hb⟩ := hleft hlD
      by_cases heq : leftCell d = c
      · refine ⟨computedRoot D label roots c, ?_⟩
        rw [heq]
        exact medianScanStep_at D label roots c
      · refine ⟨b, ?_⟩
        simpa only [medianScanStep_other D label roots c (leftCell d) heq]
          using hb

/-- The genuine induction step for the root-order invariant. A newly
assigned cell cannot lie before any already assigned neighbor, since
predecessor-completeness would force that cell to have been assigned. -/
theorem medianScanStep_locallyOrdered {D : Diagram}
    (hsk : SkewRowIntervals D) (label : Cell → ℕ)
    (roots : PartialRoots) (c : Cell)
    (hcD : c ∈ D) (hfree : roots c = none)
    (hsupport : ∀ d : Cell, d ∉ D → roots d = none)
    (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots)
    (hready : ReadyForScan D roots c) :
    RootLocallyOrdered D (medianScanStep D label roots c) := by
  constructor
  · intro d hd a b ha hb
    by_cases hdc : d = c
    · subst d
      have hb' : computedRoot D label roots c = b := by
        simpa only [medianScanStep_at, Option.some.injEq] using hb
      have ha' : roots (belowCell c) = some a := by
        simpa only [medianScanStep_other D label roots c (belowCell c)
          (belowCell_ne_self c)] using ha
      by_cases hbelowD : belowCell c ∈ D
      · have hle := computedRoot_lowerBound hsk label roots hord hpast c
          hready hbelowD a ha'
        omega
      · have hn := hsupport (belowCell c) hbelowD
        rw [hn] at ha'
        cases ha'
    · have hb' : roots d = some b := by
        simpa only [medianScanStep_other D label roots c d hdc] using hb
      by_cases hpred : belowCell d = c
      · have hcBelowD : belowCell d ∈ D := by
          rw [hpred]
          exact hcD
        obtain ⟨v, hv⟩ := (hpast d hd b hb').1 hcBelowD
        rw [hpred, hfree] at hv
        cases hv
      · have ha' : roots (belowCell d) = some a := by
          simpa only [medianScanStep_other D label roots c (belowCell d)
            hpred] using ha
        exact hord.1 d hd a b ha' hb'
  · intro d hd a b ha hb
    by_cases hdc : d = c
    · subst d
      have ha' : computedRoot D label roots c = a := by
        simpa only [medianScanStep_at, Option.some.injEq] using ha
      by_cases hzero : c.2 = 0
      · have hsame : leftCell c = c := by
          rcases c with ⟨row, col⟩
          change col = 0 at hzero
          subst col
          rfl
        have hb' : computedRoot D label roots c = b := by
          rw [hsame] at hb
          simpa only [medianScanStep_at, Option.some.injEq] using hb
        omega
      · have hpos : 0 < c.2 := by omega
        have hb' : roots (leftCell c) = some b := by
          simpa only [medianScanStep_other D label roots c (leftCell c)
            (leftCell_ne_self c hpos)] using hb
        by_cases hleftD : leftCell c ∈ D
        · have hle := computedRoot_upperBound hsk label roots hord hpast
            c hready ⟨hpos, hleftD⟩ b hb'
          omega
        · have hn := hsupport (leftCell c) hleftD
          rw [hn] at hb'
          cases hb'
    · have ha' : roots d = some a := by
        simpa only [medianScanStep_other D label roots c d hdc] using ha
      by_cases hpred : leftCell d = c
      · have hpos : 0 < d.2 := by
          by_contra hnot
          have hz : d.2 = 0 := by omega
          have hsame : leftCell d = d := by
            rcases d with ⟨row, col⟩
            change col = 0 at hz
            subst col
            rfl
          exact hdc (hsame.symm.trans hpred)
        have hcLeftD : leftCell d ∈ D := by
          rw [hpred]
          exact hcD
        obtain ⟨v, hv⟩ := (hpast d hd a ha').2 ⟨hpos, hcLeftD⟩
        rw [hpred, hfree] at hv
        cases hv
      · have hb' : roots (leftCell d) = some b := by
          simpa only [medianScanStep_other D label roots c (leftCell d)
            hpred] using hb
        exact hord.2 d hd a b ha' hb'

/-- The two invariants persist through the canonical history. This
lemma is an induction on the unprocessed suffix, so at each step its
processed prefix contains precisely the earlier cells. -/
theorem canonicalScanHistory_invariants_suffix (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    ∀ (future past : List Cell),
      canonicalScanHistory D = past ++ future →
      RootLocallyOrdered D (rootsAfterHistory D label past) →
      RootPastComplete D (rootsAfterHistory D label past) →
      RootLocallyOrdered D
        (rootsAfterHistory D label (past ++ future)) ∧
      RootPastComplete D
        (rootsAfterHistory D label (past ++ future)) := by
  intro future
  induction future with
  | nil =>
      intro past _ hord hpast
      simpa using (And.intro hord hpast)
  | cons c future ih =>
      intro past h hord hpast
      have hcD : c ∈ D := by
        apply (canonicalScanHistory_mem D c).mp
        rw [h]
        simp
      have hnd : (past ++ c :: future).Nodup := by
        rw [← h]
        exact canonicalScanHistory_nodup D
      have hndExtended : ((past ++ [c]) ++ future).Nodup := by
        simpa [List.append_assoc] using hnd
      have hprefixNodup : (past ++ [c]).Nodup :=
        List.Nodup.of_append_left hndExtended
      have hcNotPast : c ∉ past := by
        intro hc
        have hdistinct :=
          (List.nodup_append.mp hprefixNodup).2.2
        have hne : c ≠ c := hdistinct c hc c (by simp)
        exact hne rfl
      have hfree : rootsAfterHistory D label past c = none :=
        rootsAfterHistory_unassigned D label past c hcNotPast
      have hwithin : ∀ d : Cell, d ∈ past → d ∈ D := by
        intro d hd
        apply (canonicalScanHistory_mem D d).mp
        rw [h]
        simp [hd]
      have hsupport : ∀ d : Cell, d ∉ D →
          rootsAfterHistory D label past d = none :=
        rootsAfterHistory_supported D label past hwithin
      have hready : ReadyForScan D (rootsAfterHistory D label past) c :=
        canonicalScanHistory_ready D label past future c h
      have hstepOrder := medianScanStep_locallyOrdered hsk label
        (rootsAfterHistory D label past) c hcD hfree hsupport hord hpast hready
      have hstepPast := medianScanStep_pastComplete D label
        (rootsAfterHistory D label past) c hpast hready
      have happend : rootsAfterHistory D label (past ++ [c]) =
          medianScanStep D label (rootsAfterHistory D label past) c := by
        unfold rootsAfterHistory
        exact scanHistory_append_one D label past c unassignedRoots
      have hordNext : RootLocallyOrdered D
          (rootsAfterHistory D label (past ++ [c])) := by
        rw [happend]
        exact hstepOrder
      have hpastNext : RootPastComplete D
          (rootsAfterHistory D label (past ++ [c])) := by
        rw [happend]
        exact hstepPast
      have hnext : canonicalScanHistory D =
          (past ++ [c]) ++ future := by
        simpa [List.append_assoc] using h
      have hresult := ih (past ++ [c]) hnext hordNext hpastNext
      simpa [List.append_assoc] using hresult

/-- The canonical median scan has globally ordered neighboring roots
for every skew row-interval diagram, with no assumption on labeling. -/
theorem canonicalScanHistory_locallyOrdered (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    RootLocallyOrdered D
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  have hinitOrder : RootLocallyOrdered D
      (rootsAfterHistory D label []) :=
    unassignedRoots_locallyOrdered D
  have hinitPast : RootPastComplete D
      (rootsAfterHistory D label []) :=
    unassignedRoots_pastComplete D
  exact (canonicalScanHistory_invariants_suffix D label hsk
    (canonicalScanHistory D) [] (by simp) hinitOrder hinitPast).1

/-- Predecessor completeness also holds for the full canonical scan. -/
theorem canonicalScanHistory_pastComplete (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    RootPastComplete D
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  have hinitOrder : RootLocallyOrdered D
      (rootsAfterHistory D label []) :=
    unassignedRoots_locallyOrdered D
  have hinitPast : RootPastComplete D
      (rootsAfterHistory D label []) :=
    unassignedRoots_pastComplete D
  exact (canonicalScanHistory_invariants_suffix D label hsk
    (canonicalScanHistory D) [] (by simp) hinitOrder hinitPast).2

/-- Stepwise antitonicity extends along any horizontal row interval. -/
theorem canonicalScanHistory_rowAntitone (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    RowRootAntitone D
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  let roots := rootsAfterHistory D label (canonicalScanHistory D)
  have hord : RootLocallyOrdered D roots :=
    canonicalScanHistory_locallyOrdered D label hsk
  have hconv : RowConvex D := skewRowIntervals_rowConvex hsk
  have htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r :=
    canonicalScanHistory_total D label
  intro row a b x y hab ha hb hxa hyb
  revert y hb hyb
  induction b, hab using Nat.le_induction with
  | base =>
      intro y _ hyb
      have hxy : x = y := Option.some.inj (hxa.symm.trans hyb)
      omega
  | succ b hab ih =>
      intro y hbs hyb
      have hbD : (row, b) ∈ D :=
        hconv row a (b + 1) b ha hbs (by omega) (by omega)
      obtain ⟨v, hv⟩ := htotal (row, b) hbD
      have hstep : y ≤ v := hord.2 (row, b + 1) hbs y v hyb
        (by simpa [leftCell] using hv)
      exact hstep.trans (ih v hbD hv)

/-- The row-convexity of canonical root fibers is now unconditional
under the skew-shape axioms; it no longer assumes antitonicity. -/
theorem canonicalRootFiber_rowConvex (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (root : ℕ) :
    RowConvex (canonicalRootFiber D label root) := by
  exact canonicalRootFiber_rowConvex_of_antitone D label
    (skewRowIntervals_rowConvex hsk)
    (canonicalScanHistory_rowAntitone D label hsk) root

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — column and rectangle convexity

The global median-order invariant established above controls both horizontal
and vertical directions. The vertical local inequalities yield
global column antitonicity, then obtain column-convex canonical fibers.

More strongly, if two cells of one fiber are comparable in the product
order, every diagram cell in the coordinate rectangle between them has
that same root. The skew row-interval hypotheses ensure the whole
rectangle is present in the ambient diagram. This is a genuine geometric
consequence of the existing canonical median scan; no block partition or
skewness of a fiber is assumed. The complete skew-shape assertion and
Kahane's strict boundary conditions remain for subsequent arguments. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- A numerical sequence whose successive values decrease also decreases
between arbitrary indices in the finite range where the step hypothesis
holds. -/
theorem finiteInterval_antitone (f : ℕ → ℕ) (n : ℕ)
    (hstep : ∀ r : ℕ, r + 1 < n → f (r + 1) ≤ f r) :
    ∀ a b : ℕ, a ≤ b → b < n → f b ≤ f a := by
  intro a b hab
  induction b, hab using Nat.le_induction with
  | base =>
      intro _
      exact le_refl (f a)
  | succ b hab ih =>
      intro hb
      exact (hstep b (by omega)).trans (ih (by omega))

/-- A skew row-interval diagram contains the entire coordinate rectangle
between any two occupied cells that are comparable in both coordinates. -/
theorem skewRowIntervals_rectangle (D : Diagram)
    (hsk : SkewRowIntervals D) (a b c : Cell)
    (ha : a ∈ D) (hb : b ∈ D)
    (hrac : a.1 ≤ c.1) (hrcb : c.1 ≤ b.1)
    (hcac : a.2 ≤ c.2) (hccb : c.2 ≤ b.2) :
    c ∈ D := by
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  have ha' := (hmem a.1 a.2).mp ha
  have hb' := (hmem b.1 b.2).mp hb
  have hcn : c.1 < n := by omega
  have hlow : lo c.1 ≤ lo a.1 :=
    finiteInterval_antitone lo n hlo a.1 c.1 hrac hcn
  have hhigh : hi b.1 ≤ hi c.1 :=
    finiteInterval_antitone hi n hhi c.1 b.1 hrcb hb'.1
  apply (hmem c.1 c.2).mpr
  refine ⟨hcn, ?_, ?_⟩
  · exact (hlow.trans ha'.2.1).trans hcac
  · exact lt_of_le_of_lt hccb (lt_of_lt_of_le hb'.2.2 hhigh)

/-- Vertical convexity, dual to the horizontal convexity already proved
for every skew row-interval diagram. -/
def ColumnConvex (D : Diagram) : Prop :=
  ∀ (col a b i : ℕ), (a, col) ∈ D → (b, col) ∈ D →
    a ≤ i → i ≤ b → (i, col) ∈ D

theorem skewRowIntervals_columnConvex {D : Diagram}
    (hsk : SkewRowIntervals D) : ColumnConvex D := by
  intro col a b i ha hb hai hib
  exact skewRowIntervals_rectangle D hsk (a, col) (b, col) (i, col)
    ha hb hai hib (le_refl _) (le_refl _)

/-- The roots of assigned cells do not increase as one moves down a
column. The statement permits partial assignments. -/
def ColumnRootAntitone (D : Diagram) (roots : PartialRoots) : Prop :=
  ∀ col a b x y : ℕ, a ≤ b →
    (a, col) ∈ D → (b, col) ∈ D →
    roots (a, col) = some x → roots (b, col) = some y → y ≤ x

/-- Successive vertical root comparisons telescope because skew-shape
columns contain no gaps, and the full canonical history assigns all
occupied cells. -/
theorem canonicalScanHistory_columnAntitone (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    ColumnRootAntitone D
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  let roots := rootsAfterHistory D label (canonicalScanHistory D)
  have hord : RootLocallyOrdered D roots :=
    canonicalScanHistory_locallyOrdered D label hsk
  have hconv : ColumnConvex D := skewRowIntervals_columnConvex hsk
  have htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r :=
    canonicalScanHistory_total D label
  intro col a b x y hab ha hb hxa hyb
  revert y hb hyb
  induction b, hab using Nat.le_induction with
  | base =>
      intro y _ hyb
      have hxy : x = y := Option.some.inj (hxa.symm.trans hyb)
      omega
  | succ b hab ih =>
      intro y hbs hyb
      have hbD : (b, col) ∈ D :=
        hconv col a (b + 1) b ha hbs (by omega) (by omega)
      obtain ⟨v, hv⟩ := htotal (b, col) hbD
      have hstep : y ≤ v := hord.1 (b, col) hbD y v
        (by simpa [belowCell] using hyb) hv
      exact hstep.trans (ih v hbD hv)

/-- A canonical fiber contains every intermediate cell of a column
between two of its cells, with no injectivity requirement on labels. -/
theorem canonicalRootFiber_columnConvex (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) (root : ℕ) :
    ColumnConvex (canonicalRootFiber D label root) := by
  have hconv : ColumnConvex D := skewRowIntervals_columnConvex hsk
  have hanti := canonicalScanHistory_columnAntitone D label hsk
  intro col a b i ha hb hai hib
  obtain ⟨haD, haR⟩ :=
    (mem_canonicalRootFiber D label root (a, col)).mp ha
  obtain ⟨hbD, hbR⟩ :=
    (mem_canonicalRootFiber D label root (b, col)).mp hb
  have hiD : (i, col) ∈ D := hconv col a b i haD hbD hai hib
  obtain ⟨x, hx⟩ := canonicalScanHistory_total D label (i, col) hiD
  have hxroot : x ≤ root :=
    hanti col a i root x hai haD hiD haR hx
  have hrootx : root ≤ x :=
    hanti col i b x root hib hiD hbD hx hbR
  have hxr : x = root := le_antisymm hxroot hrootx
  exact (mem_canonicalRootFiber D label root (i, col)).mpr
    ⟨hiD, by simpa [hxr] using hx⟩

/-- If two occupied cells are coordinatewise ordered, the canonical
root at the southeast cell is no greater than at the northwest cell. -/
theorem canonicalScanHistory_gridAntitone (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D)
    (a b : Cell) (haD : a ∈ D) (hbD : b ∈ D)
    (hrow : a.1 ≤ b.1) (hcol : a.2 ≤ b.2)
    (ra rb : ℕ)
    (ha : rootsAfterHistory D label (canonicalScanHistory D) a = some ra)
    (hb : rootsAfterHistory D label (canonicalScanHistory D) b = some rb) :
    rb ≤ ra := by
  have hmiddle : (a.1, b.2) ∈ D :=
    skewRowIntervals_rectangle D hsk a b (a.1, b.2)
      haD hbD (le_refl _) hrow hcol (le_refl _)
  obtain ⟨m, hm⟩ :=
    canonicalScanHistory_total D label (a.1, b.2) hmiddle
  have hhor : m ≤ ra :=
    (canonicalScanHistory_rowAntitone D label hsk)
      a.1 a.2 b.2 ra m hcol haD hmiddle ha hm
  have hver : rb ≤ m :=
    (canonicalScanHistory_columnAntitone D label hsk)
      b.2 a.1 b.1 m rb hrow hmiddle hbD hm hb
  exact hver.trans hhor

/-- Coordinate-rectangle convexity of a diagram: if its northwest and
southeast endpoints are present, so is every intermediate cell. -/
def GridOrderConvex (E : Diagram) : Prop :=
  ∀ a b c : Cell, a ∈ E → b ∈ E →
    a.1 ≤ c.1 → c.1 ≤ b.1 →
    a.2 ≤ c.2 → c.2 ≤ b.2 → c ∈ E

/-- The canonical fibers are coordinate-rectangle convex. In particular,
the statement simultaneously exploits the original skew shape and the
root order actually obtained from the median algorithm. -/
theorem canonicalRootFiber_gridOrderConvex (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) (root : ℕ) :
    GridOrderConvex (canonicalRootFiber D label root) := by
  intro a b c ha hb hrac hrcb hcac hccb
  obtain ⟨haD, haR⟩ :=
    (mem_canonicalRootFiber D label root a).mp ha
  obtain ⟨hbD, hbR⟩ :=
    (mem_canonicalRootFiber D label root b).mp hb
  have hcD : c ∈ D :=
    skewRowIntervals_rectangle D hsk a b c
      haD hbD hrac hrcb hcac hccb
  obtain ⟨x, hx⟩ := canonicalScanHistory_total D label c hcD
  have hxroot : x ≤ root :=
    canonicalScanHistory_gridAntitone D label hsk a c haD hcD
      hrac hcac root x haR hx
  have hrootx : root ≤ x :=
    canonicalScanHistory_gridAntitone D label hsk c b hcD hbD
      hrcb hccb x root hx hbR
  have hxr : x = root := le_antisymm hxroot hrootx
  exact (mem_canonicalRootFiber D label root c).mpr
    ⟨hcD, by simpa [hxr] using hx⟩

/-- The three established geometric convexity properties collected
without assuming the fibers already are skew Young diagrams. -/
theorem canonicalRootFiber_three_convexities (D : Diagram)
    (label : Cell → ℕ) (hsk : SkewRowIntervals D) (root : ℕ) :
    RowConvex (canonicalRootFiber D label root) ∧
    ColumnConvex (canonicalRootFiber D label root) ∧
    GridOrderConvex (canonicalRootFiber D label root) := by
  exact ⟨canonicalRootFiber_rowConvex D label hsk root,
    canonicalRootFiber_columnConvex D label hsk root,
    canonicalRootFiber_gridOrderConvex D label hsk root⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — monotone row boundaries. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- A cell is the rightmost occupied cell of its row. This is the
horizontal counterpart to `IsLeftBoundary` defined in Section 4.1. -/
def IsRightBoundary (E : Diagram) (c : Cell) : Prop :=
  c ∈ E ∧ ∀ j : ℕ, c.2 < j → (c.1, j) ∉ E

/-- The right endpoint of one occupied row cannot lie strictly left of
its left endpoint. No convexity assumption is needed. -/
theorem leftBoundary_le_rightBoundary_sameRow
    (E : Diagram) (left right : Cell)
    (hl : IsLeftBoundary E left) (hr : IsRightBoundary E right)
    (hsame : left.1 = right.1) : left.2 ≤ right.2 := by
  by_contra hnot
  have hlt : right.2 < left.2 := by omega
  have hcell : (right.1, left.2) ∈ E := by
    have heq : (right.1, left.2) = left :=
      Prod.ext hsame.symm rfl
    simpa only [heq] using hl.1
  exact hr.2 left.2 hlt hcell

/-- In a grid-order-convex diagram, occupied left endpoints cannot move
right as we descend from one occupied row to another. This holds for
arbitrarily separated rows, not merely consecutive ones. -/
theorem gridOrderConvex_leftBoundary_antitone (E : Diagram)
    (hgrid : GridOrderConvex E) (a b : Cell)
    (ha : IsLeftBoundary E a) (hb : IsLeftBoundary E b)
    (hrows : a.1 ≤ b.1) : b.2 ≤ a.2 := by
  by_contra hnot
  have hcols : a.2 < b.2 := by omega
  have hcell : (b.1, a.2) ∈ E := by
    apply hgrid a b (b.1, a.2) ha.1 hb.1
    · exact hrows
    · exact le_refl _
    · exact le_refl _
    · exact le_of_lt hcols
  exact hb.2 a.2 hcols hcell

/-- The analogous statement for right endpoints: a southeast shift of
the right edge would force an occupied cell strictly beyond the right
edge of the upper row. -/
theorem gridOrderConvex_rightBoundary_antitone (E : Diagram)
    (hgrid : GridOrderConvex E) (a b : Cell)
    (ha : IsRightBoundary E a) (hb : IsRightBoundary E b)
    (hrows : a.1 ≤ b.1) : b.2 ≤ a.2 := by
  by_contra hnot
  have hcols : a.2 < b.2 := by omega
  have hcell : (a.1, b.2) ∈ E := by
    apply hgrid a b (a.1, b.2) ha.1 hb.1
    · exact le_refl _
    · exact hrows
    · exact le_of_lt hcols
    · exact le_refl _
  exact ha.2 b.2 hcols hcell

/-- Weak monotonicity of the right boundary on successive occupied
rows; the left-hand analogue `LeftEndpointsDecrease` is from 4.2. -/
def RightEndpointsDecrease (E : Diagram) : Prop :=
  ∀ ⦃c d : Cell⦄, IsRightBoundary E c → IsRightBoundary E d →
    d.1 = c.1 + 1 → d.2 ≤ c.2

/-- Grid-order convexity already implies both consecutive-row
boundary monotonicity conditions. -/
theorem gridOrderConvex_boundary_monotonicity (E : Diagram)
    (hgrid : GridOrderConvex E) :
    LeftEndpointsDecrease E ∧ RightEndpointsDecrease E := by
  constructor
  · intro c d hc hd hrow
    exact gridOrderConvex_leftBoundary_antitone E hgrid c d hc hd
      (by omega)
  · intro c d hc hd hrow
    exact gridOrderConvex_rightBoundary_antitone E hgrid c d hc hd
      (by omega)

/-- The left boundary of any canonical root fiber is monotone between
all occupied rows, and not just adjacent rows. -/
theorem canonicalRootFiber_leftBoundary_antitone
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (root : ℕ)
    (a b : Cell)
    (ha : IsLeftBoundary (canonicalRootFiber D label root) a)
    (hb : IsLeftBoundary (canonicalRootFiber D label root) b)
    (hrows : a.1 ≤ b.1) : b.2 ≤ a.2 := by
  exact gridOrderConvex_leftBoundary_antitone
    (canonicalRootFiber D label root)
    (canonicalRootFiber_gridOrderConvex D label hsk root)
    a b ha hb hrows

/-- The right boundary of any canonical root fiber is also monotone
between all occupied rows. -/
theorem canonicalRootFiber_rightBoundary_antitone
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (root : ℕ)
    (a b : Cell)
    (ha : IsRightBoundary (canonicalRootFiber D label root) a)
    (hb : IsRightBoundary (canonicalRootFiber D label root) b)
    (hrows : a.1 ≤ b.1) : b.2 ≤ a.2 := by
  exact gridOrderConvex_rightBoundary_antitone
    (canonicalRootFiber D label root)
    (canonicalRootFiber_gridOrderConvex D label hsk root)
    a b ha hb hrows

/-- The row-interval and boundary-order properties of every canonical
root fiber. This formulation does not hide any assumption that the
fiber is already a skew diagram. -/
theorem canonicalRootFiber_row_boundary_geometry
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (root : ℕ) :
    RowConvex (canonicalRootFiber D label root) ∧
    LeftEndpointsDecrease (canonicalRootFiber D label root) ∧
    RightEndpointsDecrease (canonicalRootFiber D label root) := by
  exact ⟨canonicalRootFiber_rowConvex D label hsk root,
    (gridOrderConvex_boundary_monotonicity
      (canonicalRootFiber D label root)
      (canonicalRootFiber_gridOrderConvex D label hsk root)).1,
    (gridOrderConvex_boundary_monotonicity
      (canonicalRootFiber D label root)
      (canonicalRootFiber_gridOrderConvex D label hsk root)).2⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — contiguous occupied rows

The preceding geometric deductions ensure convexity of the
individual occupied rows and monotonicity of their left/right boundaries.
They do not, by themselves, rule out an empty row separating two occupied
ones: disconnected diagrams can have exactly that defect.

The connectivity statement established above implies that every path
crossing the horizontal cut between rows `k` and `k+1` must contain a
vertical edge across that cut. In a connected canonical root fiber, this
proves consecutive-row overlap, hence absence of empty intermediate rows.

This closes the *row-support* obligation for the skew-shape representation.
Turning the row boundaries into explicit functions `lo` and `hi` in
`SkewRowIntervals` is still a separate (finite endpoint) construction. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The two endpoints of a walk lie on opposite sides of the horizontal
cut separating rows `k` and `k+1`. -/
def WalkCrossesRowCut (a b : Cell) (k : ℕ) : Prop :=
  (a.1 ≤ k ∧ k < b.1) ∨ (b.1 ≤ k ∧ k < a.1)

/-- A vertical edge of the fiber crossing the horizontal cut. Both
endpoints are in the original diagram and carry the same root. -/
def RootEdgeAcrossRow (D : Diagram) (roots : PartialRoots)
    (r k : ℕ) : Prop :=
  ∃ j : ℕ, (k, j) ∈ D ∧ roots (k, j) = some r ∧
    (k + 1, j) ∈ D ∧ roots (k + 1, j) = some r

/-- A graph walk whose endpoints straddle a horizontal cut must use
an actual vertical edge across that cut. Horizontal edges cannot do so.
This purely graph-theoretic statement is independent of skewness. -/
theorem fiberWalk_crosses_row_cut {D : Diagram} {roots : PartialRoots}
    {r : ℕ} {a b : Cell}
    (walk : FiberWalk D roots r a b) :
    ∀ k : ℕ, WalkCrossesRowCut a b k → RootEdgeAcrossRow D roots r k := by
  induction walk with
  | refl c hc hr =>
      intro k hk
      rcases hk with hk | hk <;> omega
  | edge a b ha hb hra hrb hadj =>
      intro k hk
      rcases hadj with hab | hba | ⟨_, hab⟩ | ⟨_, hba⟩
      · have hcut : k = a.1 := by
          rcases hk with hk | hk
          · rw [hab] at hk
            dsimp [belowCell] at hk
            omega
          · rw [hab] at hk
            dsimp [belowCell] at hk
            omega
        subst k
        refine ⟨a.2, ha, hra, ?_, ?_⟩
        · simpa [hab, belowCell] using hb
        · simpa [hab, belowCell] using hrb
      · have hcut : k = b.1 := by
          rcases hk with hk | hk
          · rw [hba] at hk
            dsimp [belowCell] at hk
            omega
          · rw [hba] at hk
            dsimp [belowCell] at hk
            omega
        subst k
        refine ⟨b.2, hb, hrb, ?_, ?_⟩
        · simpa [hba, belowCell] using ha
        · simpa [hba, belowCell] using hra
      · have hrow : b.1 = a.1 := by
          simpa [leftCell] using congrArg Prod.fst hab
        rcases hk with hk | hk <;> omega
      · have hrow : a.1 = b.1 := by
          simpa [leftCell] using congrArg Prod.fst hba
        rcases hk with hk | hk <;> omega
  | symm h ih =>
      intro k hk
      rcases hk with hk | hk
      · exact ih k (Or.inr hk)
      · exact ih k (Or.inl hk)
  | trans h₁ h₂ ih₁ ih₂ =>
      rename_i start mid finish
      intro k hk
      rcases hk with ⟨ha, hb⟩ | ⟨hb, ha⟩
      · by_cases hm : mid.1 ≤ k
        · exact ih₂ k (Or.inl ⟨hm, hb⟩)
        · exact ih₁ k (Or.inl ⟨ha, by omega⟩)
      · by_cases hm : mid.1 ≤ k
        · exact ih₁ k (Or.inr ⟨hm, ha⟩)
        · exact ih₂ k (Or.inr ⟨hb, by omega⟩)

/-- A finite diagram has no empty row between occupied rows. -/
def RowSupportInterval (E : Diagram) : Prop :=
  ∀ a b k : ℕ, a ∈ occupiedRows E → b ∈ occupiedRows E →
    a ≤ k → k ≤ b → k ∈ occupiedRows E

/-- Every canonical root fiber has interval-shaped row support as soon
as the original labels are injective on the diagram. -/
theorem canonicalRootFiber_rowSupportInterval (D : Diagram)
    (label : Cell → ℕ)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) : RowSupportInterval (canonicalRootFiber D label r) := by
  intro a b k ha hb hak hkb
  obtain ⟨x, hx, hxa⟩ := Finset.mem_image.mp ha
  obtain ⟨y, hy, hyb⟩ := Finset.mem_image.mp hb
  by_cases hkb' : k = b
  · simpa [hkb'] using hb
  have hklt : k < b := by omega
  have hwalk := canonicalRootFiber_connected D label hinj r x y hx hy
  have hcut : WalkCrossesRowCut x y k := by
    left
    constructor
    · omega
    · omega
  obtain ⟨j, hjD, hjR, _, _⟩ :=
    fiberWalk_crosses_row_cut hwalk k hcut
  have hj : (k, j) ∈ canonicalRootFiber D label r :=
    (mem_canonicalRootFiber D label r (k, j)).mpr ⟨hjD, hjR⟩
  exact Finset.mem_image.mpr ⟨(k, j), hj, rfl⟩

/-- A stronger consequence: if an occupied row has any occupied row
below it, then the next row shares an entire vertical edge of the fiber
with it. This is precisely `SuccessiveRowsOverlap`. -/
theorem canonicalRootFiber_successiveRowsOverlap (D : Diagram)
    (label : Cell → ℕ)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) : SuccessiveRowsOverlap (canonicalRootFiber D label r) := by
  intro row hrow hbelow
  obtain ⟨s, hs, hrs⟩ := hbelow
  obtain ⟨x, hx, hxr⟩ := Finset.mem_image.mp hrow
  obtain ⟨y, hy, hys⟩ := Finset.mem_image.mp hs
  have hwalk := canonicalRootFiber_connected D label hinj r x y hx hy
  have hcut : WalkCrossesRowCut x y row := by
    left
    constructor
    · omega
    · omega
  obtain ⟨j, hjD, hjR, hnextD, hnextR⟩ :=
    fiberWalk_crosses_row_cut hwalk row hcut
  exact ⟨j,
    (mem_canonicalRootFiber D label r (row, j)).mpr ⟨hjD, hjR⟩,
    (mem_canonicalRootFiber D label r (row + 1, j)).mpr
      ⟨hnextD, hnextR⟩⟩

/-- Bundle all of the row-geometric invariants established in the
canonical construction. Unlike the unconditional convexity lemmas,
the overlap assertion uses injectivity of the original labeling. -/
theorem canonicalRootFiber_complete_row_geometry (D : Diagram)
    (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) :
    RowConvex (canonicalRootFiber D label r) ∧
    LeftEndpointsDecrease (canonicalRootFiber D label r) ∧
    RightEndpointsDecrease (canonicalRootFiber D label r) ∧
    RowSupportInterval (canonicalRootFiber D label r) ∧
    SuccessiveRowsOverlap (canonicalRootFiber D label r) := by
  obtain ⟨hconv, hleft, hright⟩ :=
    canonicalRootFiber_row_boundary_geometry D label hsk r
  exact ⟨hconv, hleft, hright,
    canonicalRootFiber_rowSupportInterval D label hinj r,
    canonicalRootFiber_successiveRowsOverlap D label hinj r⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Geometry of fibers — reconstruction as connected skew diagrams. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- Each occupied row has a rightmost cell. -/
theorem exists_rightBoundary_in_row (E : Diagram) (row : ℕ)
    (hrow : row ∈ occupiedRows E) :
    ∃ c : Cell, IsRightBoundary E c ∧ c.1 = row := by
  classical
  obtain ⟨c, hcE, hcr⟩ := Finset.mem_image.mp hrow
  let S : Finset ℕ := (E.filter (fun d => d.1 = row)).image Prod.snd
  have hS : S.Nonempty := by
    refine ⟨c.2, ?_⟩
    exact Finset.mem_image.mpr
      ⟨c, Finset.mem_filter.mpr ⟨hcE, hcr⟩, rfl⟩
  let j : ℕ := S.max' hS
  have hjS : j ∈ S := Finset.max'_mem S hS
  obtain ⟨d, hd, hdj⟩ := Finset.mem_image.mp hjS
  obtain ⟨hdE, hdr⟩ := Finset.mem_filter.mp hd
  have hcell : (row, j) ∈ E := by
    have heq : d = (row, j) := Prod.ext hdr hdj
    rw [← heq]
    exact hdE
  refine ⟨(row, j), ⟨hcell, ?_⟩, rfl⟩
  intro k hjk hkE
  have hkS : k ∈ S := by
    exact Finset.mem_image.mpr
      ⟨(row, k), Finset.mem_filter.mpr ⟨hkE, rfl⟩, rfl⟩
  have hkj : k ≤ j := Finset.le_max' S k hkS
  omega

/-- A canonical numerical left endpoint for each occupied row.
The value on unoccupied rows is immaterial and will be overridden in
the explicit skew-row-interval construction. -/
noncomputable def rowFirstColumn (E : Diagram) (row : ℕ) : ℕ :=
  if h : row ∈ occupiedRows E then
    (Classical.choose (exists_leftBoundary_in_row E row h)).2
  else 0

/-- A canonical numerical right endpoint for each occupied row. -/
noncomputable def rowLastColumn (E : Diagram) (row : ℕ) : ℕ :=
  if h : row ∈ occupiedRows E then
    (Classical.choose (exists_rightBoundary_in_row E row h)).2
  else 0

/-- The chosen left endpoint really is the leftmost occupied cell. -/
theorem rowFirstColumn_isLeft (E : Diagram) (row : ℕ)
    (hrow : row ∈ occupiedRows E) :
    IsLeftBoundary E (row, rowFirstColumn E row) := by
  classical
  unfold rowFirstColumn
  simp only [dite_eq_left hrow]
  have hc := Classical.choose_spec (exists_leftBoundary_in_row E row hrow)
  have hcell :
      (row, (Classical.choose (exists_leftBoundary_in_row E row hrow)).2) =
        Classical.choose (exists_leftBoundary_in_row E row hrow) :=
    Prod.ext hc.2.symm rfl
  simpa only [hcell] using hc.1

/-- The chosen right endpoint really is the rightmost occupied cell. -/
theorem rowLastColumn_isRight (E : Diagram) (row : ℕ)
    (hrow : row ∈ occupiedRows E) :
    IsRightBoundary E (row, rowLastColumn E row) := by
  classical
  unfold rowLastColumn
  simp only [dite_eq_left hrow]
  have hc := Classical.choose_spec (exists_rightBoundary_in_row E row hrow)
  have hcell :
      (row, (Classical.choose (exists_rightBoundary_in_row E row hrow)).2) =
        Classical.choose (exists_rightBoundary_in_row E row hrow) :=
    Prod.ext hc.2.symm rfl
  simpa only [hcell] using hc.1

/-- An occupied cell lies between the two extremal columns of its row. -/
theorem rowFirst_le_mem_le_last (E : Diagram)
    (row j : ℕ) (hj : (row, j) ∈ E) :
    rowFirstColumn E row ≤ j ∧ j ≤ rowLastColumn E row := by
  have hrow : row ∈ occupiedRows E :=
    Finset.mem_image.mpr ⟨(row, j), hj, rfl⟩
  have hleft := rowFirstColumn_isLeft E row hrow
  have hright := rowLastColumn_isRight E row hrow
  constructor
  · by_contra hn
    have hjlt : j < rowFirstColumn E row := by omega
    exact (hleft.2 j hjlt) hj
  · by_contra hn
    have hjgt : rowLastColumn E row < j := by omega
    exact (hright.2 j hjgt) hj

/-- On an occupied row, row-convexity makes the boundary interval exact. -/
theorem mem_iff_between_rowEndpoints (E : Diagram)
    (hconv : RowConvex E) (row j : ℕ)
    (hrow : row ∈ occupiedRows E) :
    (row, j) ∈ E ↔
      rowFirstColumn E row ≤ j ∧ j ≤ rowLastColumn E row := by
  constructor
  · intro hj
    exact rowFirst_le_mem_le_last E row j hj
  · intro hj
    exact hconv row (rowFirstColumn E row) (rowLastColumn E row) j
      (rowFirstColumn_isLeft E row hrow).1
      (rowLastColumn_isRight E row hrow).1 hj.1 hj.2

/-- Grid-order convexity implies row-convexity. -/
theorem gridOrderConvex_rowConvex (E : Diagram)
    (hgrid : GridOrderConvex E) : RowConvex E := by
  intro row a b j ha hb haj hjb
  exact hgrid (row, a) (row, b) (row, j) ha hb
    (le_refl _) (le_refl _) haj hjb

/-- Nonempty row support, combined with grid-order convexity,
produces actual weakly decreasing row-interval boundaries.
The empty diagram is included, represented with zero rows. -/
theorem skewRowIntervals_of_gridOrderConvex_rowSupport (E : Diagram)
    (hgrid : GridOrderConvex E) (hsupport : RowSupportInterval E) :
    SkewRowIntervals E := by
  classical
  by_cases hE : E.Nonempty
  · obtain ⟨c, hcE⟩ := hE
    have hrows : (occupiedRows E).Nonempty :=
      ⟨c.1, Finset.mem_image.mpr ⟨c, hcE, rfl⟩⟩
    let top : ℕ := (occupiedRows E).min' hrows
    let bottom : ℕ := (occupiedRows E).max' hrows
    have htop : top ∈ occupiedRows E :=
      Finset.min'_mem (occupiedRows E) hrows
    have hbottom : bottom ∈ occupiedRows E :=
      Finset.max'_mem (occupiedRows E) hrows
    have hmin : ∀ r ∈ occupiedRows E, top ≤ r := by
      intro r hr
      exact Finset.min'_le (occupiedRows E) r hr
    have hmax : ∀ r ∈ occupiedRows E, r ≤ bottom := by
      intro r hr
      exact Finset.le_max' (occupiedRows E) r hr
    have hfilled : ∀ r : ℕ, top ≤ r → r ≤ bottom →
        r ∈ occupiedRows E := by
      intro r htr hrb
      exact hsupport top bottom r htop hbottom htr hrb
    have hconv : RowConvex E := gridOrderConvex_rowConvex E hgrid
    let M : ℕ := rowLastColumn E top + 1
    let lo : ℕ → ℕ := fun r =>
      if r < top then M else rowFirstColumn E r
    let hi : ℕ → ℕ := fun r =>
      if r < top then M else rowLastColumn E r + 1
    have htopBounds : rowFirstColumn E top ≤ rowLastColumn E top :=
      leftBoundary_le_rightBoundary_sameRow E
        (top, rowFirstColumn E top) (top, rowLastColumn E top)
        (rowFirstColumn_isLeft E top htop)
        (rowLastColumn_isRight E top htop) rfl
    refine ⟨bottom + 1, lo, hi, ?_, ?_, ?_⟩
    · intro row j
      constructor
      · intro hjE
        have hr : row ∈ occupiedRows E :=
          Finset.mem_image.mpr ⟨(row, j), hjE, rfl⟩
        have hrowLo : ¬ row < top := by
          have ht := hmin row hr
          omega
        have hrowHi : row < bottom + 1 := by
          have hb := hmax row hr
          omega
        obtain ⟨hjlo, hjhi⟩ := rowFirst_le_mem_le_last E row j hjE
        change row < bottom + 1 ∧ lo row ≤ j ∧ j < hi row
        simpa only [lo, hi, ite_eq_right hrowLo] using
          (show row < bottom + 1 ∧ rowFirstColumn E row ≤ j ∧
            j < rowLastColumn E row + 1 from ⟨hrowHi, hjlo, by omega⟩)
      · rintro ⟨hrowHi, hjlo, hjhi⟩
        by_cases hpre : row < top
        · have hlow : M ≤ j := by
            simpa only [lo, ite_eq_left hpre] using hjlo
          have hhigh : j < M := by
            simpa only [hi, ite_eq_left hpre] using hjhi
          omega
        · have hrow : row ∈ occupiedRows E :=
            hfilled row (by omega) (by omega)
          have hlow : rowFirstColumn E row ≤ j := by
            simpa only [lo, ite_eq_right hpre] using hjlo
          have hhigh : j ≤ rowLastColumn E row := by
            have hh : j < rowLastColumn E row + 1 := by
              simpa only [hi, ite_eq_right hpre] using hjhi
            omega
          exact (mem_iff_between_rowEndpoints E hconv row j hrow).mpr
            ⟨hlow, hhigh⟩
    · intro row hrowHi
      by_cases hpre : row < top
      · by_cases hpreNext : row + 1 < top
        · simp only [lo, ite_eq_left hpre, ite_eq_left hpreNext, le_refl]
        · have hnext : row + 1 = top := by omega
          have htarget : rowFirstColumn E top ≤ M := by
            dsimp [M]
            omega
          simpa [lo, hpre, hpreNext, hnext] using htarget
      · have hpreNext : ¬ row + 1 < top := by omega
        have hr : row ∈ occupiedRows E :=
          hfilled row (by omega) (by omega)
        have hrNext : row + 1 ∈ occupiedRows E :=
          hfilled (row + 1) (by omega) (by omega)
        have hstep := gridOrderConvex_leftBoundary_antitone E hgrid
          (row, rowFirstColumn E row)
          (row + 1, rowFirstColumn E (row + 1))
          (rowFirstColumn_isLeft E row hr)
          (rowFirstColumn_isLeft E (row + 1) hrNext) (by omega)
        simpa only [lo, ite_eq_right hpre, ite_eq_right hpreNext] using hstep
    · intro row hrowHi
      by_cases hpre : row < top
      · by_cases hpreNext : row + 1 < top
        · simp only [hi, ite_eq_left hpre, ite_eq_left hpreNext, le_refl]
        · have hnext : row + 1 = top := by omega
          have htarget : rowLastColumn E top + 1 ≤ M := le_refl _
          simp [hi, hpre, hnext, M]
      · have hpreNext : ¬ row + 1 < top := by omega
        have hr : row ∈ occupiedRows E :=
          hfilled row (by omega) (by omega)
        have hrNext : row + 1 ∈ occupiedRows E :=
          hfilled (row + 1) (by omega) (by omega)
        have hstep := gridOrderConvex_rightBoundary_antitone E hgrid
          (row, rowLastColumn E row)
          (row + 1, rowLastColumn E (row + 1))
          (rowLastColumn_isRight E row hr)
          (rowLastColumn_isRight E (row + 1) hrNext) (by omega)
        have hstep' : rowLastColumn E (row + 1) + 1 ≤
            rowLastColumn E row + 1 := by omega
        simpa only [hi, ite_eq_right hpre, ite_eq_right hpreNext] using hstep'
  · have hnone : ∀ c : Cell, c ∉ E := by
      intro c hc
      exact hE ⟨c, hc⟩
    refine ⟨0, (fun _ => 0), (fun _ => 0), ?_, ?_, ?_⟩
    · intro row j
      constructor
      · intro hj
        exact False.elim (hnone (row, j) hj)
      · intro h
        omega
    · intro row h
      omega
    · intro row h
      omega

/-- Every canonical root fiber is a skew Young row-interval diagram.
This is a *derived* property of the median scan, not a fiber-specific
assumption. The injectivity hypothesis is the permutation-labeling condition
used to obtain interval-shaped row support earlier in this lemma. -/
theorem canonicalRootFiber_skewRowIntervals
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (root : ℕ) :
    SkewRowIntervals (canonicalRootFiber D label root) := by
  exact skewRowIntervals_of_gridOrderConvex_rowSupport
    (canonicalRootFiber D label root)
    (canonicalRootFiber_gridOrderConvex D label hsk root)
    (canonicalRootFiber_rowSupportInterval D label hinj root)

/-- In particular, every canonical root fiber satisfies the connected
skew-row conditions: skew intervals together with overlap of successive
occupied rows. The empty fiber satisfies these conditions vacuously. -/
theorem canonicalRootFiber_connectedSkewRows
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (root : ℕ) :
    ConnectedSkewRows (canonicalRootFiber D label root) := by
  exact ⟨canonicalRootFiber_skewRowIntervals D label hsk hinj root,
    canonicalRootFiber_successiveRowsOverlap D label hinj root⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Lemma 4.3: Validity of the corrected block conditions
### The actual root and the strict boundary inequalities

The preceding sections established that canonical median fibers are
connected skew diagrams.  The root of a nonempty fiber is now identified
without adding any extra assumptions: a `RootRoute` always moves south or
west, and it terminates at a cell whose original label is the fiber label.
Injectivity therefore gives a unique anchor which lies southwest of every
other fiber cell. The two *strict* inequalities governing
inheriting a lower or left predecessor's label. These are the local
ingredients needed to certify Kahane's boundary conditions globally. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The endpoint of any root route still carries the root label. -/
theorem rootRoute_endpoint
    {D : Diagram} {roots : PartialRoots} {r : ℕ} {c d : Cell}
    (route : RootRoute D roots r c d) : roots d = some r := by
  induction route with
  | stop _ _ hr => exact hr
  | viaBelow _ _ _ _ _ _ _ ih => exact ih
  | viaLeft _ _ _ _ _ _ _ _ ih => exact ih

/-- A directed root route only goes down or left: its endpoint is
southwest of its start in the chosen row-coordinate convention. -/
theorem rootRoute_southwest
    {D : Diagram} {roots : PartialRoots} {r : ℕ} {c d : Cell}
    (route : RootRoute D roots r c d) :
    c.1 ≤ d.1 ∧ d.2 ≤ c.2 := by
  induction route with
  | stop c _ _ => exact ⟨le_refl _, le_refl _⟩
  | viaBelow c d _ _ _ _ _ ih =>
      constructor
      · have hr := ih.1
        dsimp [belowCell] at hr
        omega
      · have hc := ih.2
        dsimp [belowCell] at hc
        omega
  | viaLeft c d _ _ _ _ _ _ ih =>
      constructor
      · have hr := ih.1
        dsimp [leftCell] at hr
        omega
      · have hc := ih.2
        dsimp [leftCell] at hc
        omega

/-- Every nonempty canonical fiber has a unique original-label anchor,
lying southwest of all cells of that fiber. -/
theorem canonicalRootFiber_southwest_anchor
    (D : Diagram) (label : Cell → ℕ)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) (hE : (canonicalRootFiber D label r).Nonempty) :
    ∃ a : Cell,
      a ∈ canonicalRootFiber D label r ∧ label a = r ∧
      ∀ c : Cell, c ∈ canonicalRootFiber D label r →
        c.1 ≤ a.1 ∧ a.2 ≤ c.2 := by
  obtain ⟨c, hc⟩ := hE
  obtain ⟨a, haD, har, hroute⟩ :=
    canonicalRoot_hasRoute D label c r
      ((mem_canonicalRootFiber D label r c).mp hc).2
  have haRoot := rootRoute_endpoint hroute
  have haFiber : a ∈ canonicalRootFiber D label r :=
    (mem_canonicalRootFiber D label r a).mpr ⟨haD, haRoot⟩
  refine ⟨a, haFiber, har, ?_⟩
  intro d hd
  obtain ⟨b, hbD, hbr, hdRoute⟩ :=
    canonicalRoot_hasRoute D label d r
      ((mem_canonicalRootFiber D label r d).mp hd).2
  have hba : b = a := hinj b hbD a haD (hbr.trans har.symm)
  have hsw := rootRoute_southwest hdRoute
  simpa only [hba] using hsw

/-- The original-label anchor is the unique southwest corner of its
nonempty canonical fiber. This uses actual connected skew geometry,
not a root condition inserted into the definition. -/
theorem canonicalRootFiber_anchor_unique_corner
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) (hE : (canonicalRootFiber D label r).Nonempty) :
    ∃ a : Cell,
      UniqueSouthwestCorner (canonicalRootFiber D label r) a ∧
      label a = r := by
  let E := canonicalRootFiber D label r
  obtain ⟨a, haE, har, hsw⟩ :=
    canonicalRootFiber_southwest_anchor D label hinj r hE
  have haLeft : IsLeftBoundary E a := by
    constructor
    · exact haE
    · intro j hj hjE
      obtain ⟨_, hcol⟩ := hsw (a.1, j) hjE
      dsimp at hcol
      omega
  have haBottom : IsBottomBoundary E a := by
    constructor
    · exact haE
    · intro i hi hiE
      obtain ⟨hrow, _⟩ := hsw (i, a.2) hiE
      dsimp at hrow
      omega
  obtain ⟨corner, hcorner⟩ :=
    connectedSkewRows_unique_corner hE
      (canonicalRootFiber_connectedSkewRows D label hsk hinj r)
  have hca : a = corner := hcorner.2.2 a haLeft haBottom
  have hunique : UniqueSouthwestCorner E a := by
    rcases hcorner with ⟨_, _, hunique⟩
    refine ⟨haLeft, haBottom, ?_⟩
    intro c hl hb
    exact (hunique c hl hb).trans hca.symm
  exact ⟨a, hunique, har⟩

/-! The following arithmetic alternatives do not use the existence
of a partition. They extract strict inequalities directly from the
median update, including the cases of one missing predecessor. -/

/-- A median that is not the cell's own label has been inherited either
from below (with a strictly greater label) or from the left (with a
strictly smaller label). The two-predecessor case uses their proven
order and is therefore not simply a tautology about `max` and `min`. -/
theorem computedRoot_strict_inheritance
    {D : Diagram} (hsk : SkewRowIntervals D)
    (label : Cell → ℕ) (roots : PartialRoots)
    (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots)
    (c : Cell) (hready : ReadyForScan D roots c)
    (hne : computedRoot D label roots c ≠ label c) :
    (belowCell c ∈ D ∧
      roots (belowCell c) = some (computedRoot D label roots c) ∧
      label c < computedRoot D label roots c) ∨
    (0 < c.2 ∧ leftCell c ∈ D ∧
      roots (leftCell c) = some (computedRoot D label roots c) ∧
      computedRoot D label roots c < label c) := by
  by_cases hbD : belowCell c ∈ D
  · obtain ⟨a, ha⟩ := hready.1 hbD
    by_cases hlD : 0 < c.2 ∧ leftCell c ∈ D
    · obtain ⟨b, hb⟩ := hready.2 hlD
      have hab : a ≤ b :=
        predecessor_bounds_ordered hsk roots hord hpast c hbD hlD a b ha hb
      by_cases hxa : label c < a
      · have heq : computedRoot D label roots c = a :=
          computedRoot_lower D label roots c a b hbD hlD ha hb (by omega)
        left
        refine ⟨hbD, ?_, ?_⟩
        · simpa only [heq] using ha
        · omega
      · by_cases hbx : b < label c
        · have heq : computedRoot D label roots c = b :=
            computedRoot_upper D label roots c a b hbD hlD ha hb hab
              (by omega)
          right
          refine ⟨hlD.1, hlD.2, ?_, ?_⟩
          · simpa only [heq] using hb
          · omega
        · have heq : computedRoot D label roots c = label c := by
            rw [computedRoot_two_neighbors D label roots c a b hbD hlD ha hb]
            exact medianRoot_between a (label c) b (by omega) (by omega)
          exact (hne heq).elim
    · have heq : computedRoot D label roots c = max a (label c) := by
        simp [computedRoot, lowerEntry, upperEntry, hbD, hlD, ha]
      have hxa : label c < a := by
        by_contra hnot
        have hsame : computedRoot D label roots c = label c := by
          rw [heq]
          exact max_eq_right (by omega)
        exact hne hsame
      have hclamp : computedRoot D label roots c = a := by
        rw [heq]
        exact max_eq_left (by omega)
      left
      refine ⟨hbD, ?_, ?_⟩
      · simpa only [hclamp] using ha
      · omega
  · by_cases hlD : 0 < c.2 ∧ leftCell c ∈ D
    · obtain ⟨b, hb⟩ := hready.2 hlD
      have heq : computedRoot D label roots c = min (label c) b := by
        simp [computedRoot, lowerEntry, upperEntry, hbD, hlD, hb]
      have hbx : b < label c := by
        by_contra hnot
        have hsame : computedRoot D label roots c = label c := by
          rw [heq]
          exact min_eq_left (by omega)
        exact hne hsame
      have hclamp : computedRoot D label roots c = b := by
        rw [heq]
        exact min_eq_right (by omega)
      right
      refine ⟨hlD.1, hlD.2, ?_, ?_⟩
      · simpa only [hclamp] using hb
      · omega
    · have heq : computedRoot D label roots c = label c :=
        computedRoot_no_neighbors D label roots c hbD hlD
      exact (hne heq).elim

/-- The source of each assigned root is recorded with the strict
inequality appropriate to the direction from which it was inherited. -/
def AssignedRootChoices (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) : Prop :=
  ∀ (c : Cell) (r : ℕ), roots c = some r →
    label c = r ∨
    (belowCell c ∈ D ∧ roots (belowCell c) = some r ∧ label c < r) ∨
    (0 < c.2 ∧ leftCell c ∈ D ∧
      roots (leftCell c) = some r ∧ r < label c)

/-- The unassigned state satisfies the provenance invariant trivially. -/
theorem unassigned_assignedRootChoices (D : Diagram) (label : Cell → ℕ) :
    AssignedRootChoices D label unassignedRoots := by
  intro c r hr
  simp [unassignedRoots] at hr

/-- A fresh median update preserves strict provenance of every assigned
root. Earlier assignments are unchanged, while the new one is covered
by `computedRoot_strict_inheritance`. -/
theorem medianScanStep_assignedRootChoices
    {D : Diagram} (hsk : SkewRowIntervals D)
    (label : Cell → ℕ) (roots : PartialRoots) (c : Cell)
    (hfree : roots c = none)
    (hord : RootLocallyOrdered D roots)
    (hpast : RootPastComplete D roots)
    (hready : ReadyForScan D roots c)
    (hchoice : AssignedRootChoices D label roots) :
    AssignedRootChoices D label (medianScanStep D label roots c) := by
  have hmono : ∀ (d : Cell) (r : ℕ),
      roots d = some r → medianScanStep D label roots c d = some r := by
    intro d r hdr
    by_cases hdc : d = c
    · subst d
      rw [hfree] at hdr
      cases hdr
    · rw [medianScanStep_other D label roots c d hdc]
      exact hdr
  intro d r hdr
  by_cases hdc : d = c
  · subst d
    have hr : computedRoot D label roots c = r := by
      apply Option.some.inj
      calc
        some (computedRoot D label roots c) =
            medianScanStep D label roots c c :=
          (medianScanStep_at D label roots c).symm
        _ = some r := hdr
    by_cases hself : label c = r
    · exact Or.inl hself
    · have hne : computedRoot D label roots c ≠ label c := by
        intro heq
        exact hself (heq.symm.trans hr)
      rcases computedRoot_strict_inheritance hsk label roots hord hpast
        c hready hne with hbelow | hleft
      · rcases hbelow with ⟨hbD, hbr, hlt⟩
        refine Or.inr (Or.inl ⟨hbD, ?_, ?_⟩)
        · exact hmono (belowCell c) r (by simpa only [hr] using hbr)
        · simpa only [hr] using hlt
      · rcases hleft with ⟨hpos, hlD, hlr, hlt⟩
        refine Or.inr (Or.inr ⟨hpos, hlD, ?_, ?_⟩)
        · exact hmono (leftCell c) r (by simpa only [hr] using hlr)
        · simpa only [hr] using hlt
  · have hold : roots d = some r := by
      simpa only [medianScanStep_other D label roots c d hdc] using hdr
    rcases hchoice d r hold with hself | hbelow | hleft
    · exact Or.inl hself
    · rcases hbelow with ⟨hbD, hbr, hlt⟩
      exact Or.inr (Or.inl ⟨hbD, hmono (belowCell d) r hbr, hlt⟩)
    · rcases hleft with ⟨hpos, hlD, hlr, hlt⟩
      exact Or.inr (Or.inr ⟨hpos, hlD, hmono (leftCell d) r hlr, hlt⟩)

/-- Induction on the unprocessed suffix, simultaneously using the
previously proved scan-order and predecessor-completeness invariants. -/
theorem canonicalScanHistory_rootChoices_suffix
    (D : Diagram) (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    ∀ (future past : List Cell),
      canonicalScanHistory D = past ++ future →
      RootLocallyOrdered D (rootsAfterHistory D label past) →
      RootPastComplete D (rootsAfterHistory D label past) →
      AssignedRootChoices D label (rootsAfterHistory D label past) →
      AssignedRootChoices D label
        (rootsAfterHistory D label (past ++ future)) := by
  intro future
  induction future with
  | nil =>
      intro past _ _ _ hchoice
      simpa using hchoice
  | cons c future ih =>
      intro past h hord hpast hchoice
      have hcD : c ∈ D := by
        apply (canonicalScanHistory_mem D c).mp
        rw [h]
        simp
      have hnd : (past ++ c :: future).Nodup := by
        rw [← h]
        exact canonicalScanHistory_nodup D
      have hndPrefix : (past ++ [c]).Nodup := by
        have hnd' : ((past ++ [c]) ++ future).Nodup := by
          simpa [List.append_assoc] using hnd
        exact List.Nodup.of_append_left hnd'
      have hcNotPast : c ∉ past := by
        intro hc
        have hdistinct := (List.nodup_append.mp hndPrefix).2.2
        exact (hdistinct c hc c (by simp)) rfl
      have hfree : rootsAfterHistory D label past c = none :=
        rootsAfterHistory_unassigned D label past c hcNotPast
      have hwithin : ∀ d : Cell, d ∈ past → d ∈ D := by
        intro d hd
        apply (canonicalScanHistory_mem D d).mp
        rw [h]
        simp [hd]
      have hsupport : ∀ d : Cell, d ∉ D →
          rootsAfterHistory D label past d = none :=
        rootsAfterHistory_supported D label past hwithin
      have hready : ReadyForScan D (rootsAfterHistory D label past) c :=
        canonicalScanHistory_ready D label past future c h
      have hstepOrder := medianScanStep_locallyOrdered hsk label
        (rootsAfterHistory D label past) c hcD hfree hsupport
        hord hpast hready
      have hstepPast := medianScanStep_pastComplete D label
        (rootsAfterHistory D label past) c hpast hready
      have hstepChoice := medianScanStep_assignedRootChoices hsk label
        (rootsAfterHistory D label past) c hfree hord hpast hready hchoice
      have happend : rootsAfterHistory D label (past ++ [c]) =
          medianScanStep D label (rootsAfterHistory D label past) c := by
        unfold rootsAfterHistory
        exact scanHistory_append_one D label past c unassignedRoots
      have hnext : canonicalScanHistory D =
          (past ++ [c]) ++ future := by
        simpa [List.append_assoc] using h
      have hresult := ih (past ++ [c]) hnext
        (by rw [happend]; exact hstepOrder)
        (by rw [happend]; exact hstepPast)
        (by rw [happend]; exact hstepChoice)
      simpa [List.append_assoc] using hresult

/-- The full canonical scan satisfies the strict provenance invariant,
with no additional assumptions beyond skewness of the original shape. -/
theorem canonicalScanHistory_assignedRootChoices
    (D : Diagram) (label : Cell → ℕ) (hsk : SkewRowIntervals D) :
    AssignedRootChoices D label
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  exact canonicalScanHistory_rootChoices_suffix D label hsk
    (canonicalScanHistory D) [] (by simp)
    (unassignedRoots_locallyOrdered D)
    (unassignedRoots_pastComplete D)
    (unassigned_assignedRootChoices D label)

/-- A nonroot left boundary cell of a fiber has a smaller original
label than its root, while a nonroot bottom boundary cell has a larger
original label. These are Kahane's two strict block inequalities. -/
theorem canonicalRootFiber_strict_boundary_conditions
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) (hE : (canonicalRootFiber D label r).Nonempty) :
    ∃ a : Cell,
      UniqueSouthwestCorner (canonicalRootFiber D label r) a ∧
      RootBoundaryConditions (canonicalRootFiber D label r) a label := by
  let E := canonicalRootFiber D label r
  obtain ⟨a, hcorner, har⟩ :=
    canonicalRootFiber_anchor_unique_corner D label hsk hinj r hE
  have haD : a ∈ D :=
    canonicalRootFiber_subset D label r hcorner.1.1
  have hchoice := canonicalScanHistory_assignedRootChoices D label hsk
  have hrootConditions : RootBoundaryConditions E a label := by
    constructor
    · intro c hc hne
      have hcD : c ∈ D := canonicalRootFiber_subset D label r hc.1
      have hcR := ((mem_canonicalRootFiber D label r c).mp hc.1).2
      have hcNeLabel : label c ≠ r := by
        intro heq
        exact hne (hinj c hcD a haD (heq.trans har.symm))
      rcases hchoice c r hcR with hself | hbelow | hleft
      · exact False.elim (hcNeLabel hself)
      · simpa only [har] using hbelow.2.2
      · obtain ⟨hpos, hlD, hlR, _⟩ := hleft
        have hleftE : leftCell c ∈ E :=
          (mem_canonicalRootFiber D label r (leftCell c)).mpr ⟨hlD, hlR⟩
        exact False.elim (hc.2 (c.2 - 1) (by omega)
          (by simpa [leftCell] using hleftE))
    · intro c hc hne
      have hcD : c ∈ D := canonicalRootFiber_subset D label r hc.1
      have hcR := ((mem_canonicalRootFiber D label r c).mp hc.1).2
      have hcNeLabel : label c ≠ r := by
        intro heq
        exact hne (hinj c hcD a haD (heq.trans har.symm))
      rcases hchoice c r hcR with hself | hbelow | hleft
      · exact False.elim (hcNeLabel hself)
      · obtain ⟨hbD, hbR, _⟩ := hbelow
        have hbE : belowCell c ∈ E :=
          (mem_canonicalRootFiber D label r (belowCell c)).mpr ⟨hbD, hbR⟩
        exact False.elim (hc.2 (c.1 + 1) (by omega)
          (by simpa [belowCell] using hbE))
      · simpa only [har] using hleft.2.2.2
  exact ⟨a, hcorner, hrootConditions⟩

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Corrected block conditions — order and existence. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The block order that follows from the chosen coordinate convention:
when `a` is northwest of `b`, the root label at `b` is at most the root
label at `a`.  The two cells may belong to the same block. -/
def OrderedRootFibers (D : Diagram) (label : Cell → ℕ) : Prop :=
  ∀ (a b : Cell) (ra rb : ℕ),
    a ∈ canonicalRootFiber D label ra →
    b ∈ canonicalRootFiber D label rb →
    a.1 ≤ b.1 → a.2 ≤ b.2 → rb ≤ ra

/-- The canonical fibers satisfy the global order between blocks,
without imposing an independent ordering hypothesis on the partition. -/
theorem canonicalRootFibers_ordered
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) :
    OrderedRootFibers D label := by
  intro a b ra rb ha hb hrow hcol
  have ha' := (mem_canonicalRootFiber D label ra a).mp ha
  have hb' := (mem_canonicalRootFiber D label rb b).mp hb
  exact canonicalScanHistory_gridAntitone D label hsk
    a b ha'.1 hb'.1 hrow hcol ra rb ha'.2 hb'.2

/-- For two *different* blocks, the corresponding root-label inequality
is strict whenever their cells are coordinatewise comparable. -/
theorem canonicalRootFibers_strict_order
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (a b : Cell) (ra rb : ℕ)
    (ha : a ∈ canonicalRootFiber D label ra)
    (hb : b ∈ canonicalRootFiber D label rb)
    (hrow : a.1 ≤ b.1) (hcol : a.2 ≤ b.2)
    (hne : ra ≠ rb) : rb < ra := by
  have hle : rb ≤ ra :=
    canonicalRootFibers_ordered D label hsk a b ra rb ha hb hrow hcol
  omega

/-- Every active root is an actual label of a cell in the original
finite diagram.  Hence there are only finitely many possible blocks. -/
theorem nonemptyRootFiber_mem_labelImage
    (D : Diagram) (label : Cell → ℕ) (r : ℕ)
    (hne : (canonicalRootFiber D label r).Nonempty) :
    r ∈ D.image label := by
  obtain ⟨c, hc, hr⟩ := canonicalRootFiber_nonempty_origin D label r hne
  exact Finset.mem_image.mpr ⟨c, hc, hr⟩

/-- A bundle of the genuine existence obligations for the corrected
Kahane blocks. It deliberately does not assert uniqueness among
arbitrary block partitions: unique membership in these *canonical*
fibers is a different and already proven statement. -/
def CanonicalBlockExistenceCertificate
    (D : Diagram) (label : Cell → ℕ) : Prop :=
  (∀ c : Cell, c ∈ D →
    ∃! r : ℕ, c ∈ canonicalRootFiber D label r) ∧
  (∀ r : ℕ, (canonicalRootFiber D label r).Nonempty →
    ConnectedSkewRows (canonicalRootFiber D label r) ∧
    ∃ a : Cell,
      UniqueSouthwestCorner (canonicalRootFiber D label r) a ∧
      RootBoundaryConditions (canonicalRootFiber D label r) a label ∧
      label a = r) ∧
  OrderedRootFibers D label

/-- Lemma 4.3 — existence of canonical admissible root assignments.
    Source target: Kahane LEMMA 4.3, under the root-exclusion repair
    of his Definition 4.2. All cells are in exactly one canonical fiber;
    all nonempty fibers are connected skew diagrams with the southwest
    root, root-excluded strict inequalities and the local/global block-order
    invariant. Existence is complemented by the uniqueness theorem below. -/
theorem canonicalBlock_existence_certificate
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b) :
    CanonicalBlockExistenceCertificate D label := by
  refine ⟨?_, ?_, canonicalRootFibers_ordered D label hsk⟩
  · intro c hc
    obtain ⟨r, hr⟩ := canonicalRootFiber_cover D label c hc
    refine ⟨r, hr, ?_⟩
    intro s hs
    exact (canonicalRootFiber_unique D label c r s hr hs).symm
  · intro r hne
    have hgeometry : ConnectedSkewRows (canonicalRootFiber D label r) :=
      canonicalRootFiber_connectedSkewRows D label hsk hinj r
    obtain ⟨a, hcorner, hboundary⟩ :=
      canonicalRootFiber_strict_boundary_conditions
        D label hsk hinj r hne
    obtain ⟨b, hcornerB, hlabelB⟩ :=
      canonicalRootFiber_anchor_unique_corner D label hsk hinj r hne
    have hab : a = b :=
      hcornerB.2.2 a hcorner.1 hcorner.2.1
    refine ⟨hgeometry, a, hcorner, hboundary, ?_⟩
    simpa only [hab] using hlabelB

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Lemma 4.3: Converse and uniqueness of the partition. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- The fiber of an arbitrary (not necessarily canonical) root assignment. -/
noncomputable def arbitraryRootFiber (D : Diagram)
    (roots : PartialRoots) (r : ℕ) : Diagram := by
  classical
  exact D.filter (fun c => roots c = some r)

@[simp] theorem mem_arbitraryRootFiber (D : Diagram)
    (roots : PartialRoots) (r : ℕ) (c : Cell) :
    c ∈ arbitraryRootFiber D roots r ↔ c ∈ D ∧ roots c = some r := by
  classical
  simp [arbitraryRootFiber]

/-- Lemma 4.3 — definition of a corrected valid partition.
    Mirrors Kahane Definition 4.2 EXCEPT (i) the mandatory exclusion
    of the root from strict boundary inequalities and (ii) the use of
    `RootLocallyOrdered` rather than the raw global order in Kahane
    Definition 3.2. The two conditions are proved equivalent below
    for total root assignments, and the equivalent definition with
    GLOBAL order is `KahaneOrderedBlockAssignment`. The definition
    does not presuppose the median algorithm. -/
def AdmissibleBlockAssignment (D : Diagram) (label : Cell → ℕ)
    (roots : PartialRoots) : Prop :=
  (∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r) ∧
  (∀ c : Cell, c ∉ D → roots c = none) ∧
  RootLocallyOrdered D roots ∧
  (∀ r : ℕ, (arbitraryRootFiber D roots r).Nonempty →
    ConnectedSkewRows (arbitraryRootFiber D roots r) ∧
    ∃ a : Cell,
      UniqueSouthwestCorner (arbitraryRootFiber D roots r) a ∧
      RootBoundaryConditions (arbitraryRootFiber D roots r) a label ∧
      label a = r)

/-- If a row-convex fiber has no immediate cell to the left of c, then
c is the left end of its occupied row. -/
theorem leftBoundary_of_no_left_neighbor
    {E : Diagram} {c : Cell} (hconv : RowConvex E)
    (hc : c ∈ E)
    (hno : ¬ (0 < c.2 ∧ leftCell c ∈ E)) :
    IsLeftBoundary E c := by
  refine ⟨hc, ?_⟩
  intro j hj hjE
  have hpos : 0 < c.2 := by omega
  have hprev : (c.1, c.2 - 1) ∈ E :=
    hconv c.1 j c.2 (c.2 - 1) hjE hc (by omega) (by omega)
  exact hno ⟨hpos, by simpa [leftCell] using hprev⟩

/-- Similarly, column convexity turns the absence of an immediate lower
neighbor into the full bottom-boundary condition. -/
theorem bottomBoundary_of_no_below_neighbor
    {E : Diagram} {c : Cell} (hconv : ColumnConvex E)
    (hc : c ∈ E) (hno : belowCell c ∉ E) :
    IsBottomBoundary E c := by
  refine ⟨hc, ?_⟩
  intro i hi hiE
  have hnext : (c.1 + 1, c.2) ∈ E :=
    hconv c.2 c.1 i (c.1 + 1) hc hiE (by omega) (by omega)
  exact hno (by simpa [belowCell] using hnext)

/-- Every admissible partition obeys the strict inheritance rule.
In particular, the local provenance theorem proved earlier for the
canonical scan is actually forced by the block geometry. -/
theorem admissibleBlockAssignment_rootChoices
    (D : Diagram) (label : Cell → ℕ) (roots : PartialRoots)
    (hvalid : AdmissibleBlockAssignment D label roots) :
    AssignedRootChoices D label roots := by
  intro c r hr
  have hcD : c ∈ D := by
    by_contra hcD
    have hnone := hvalid.2.1 c hcD
    rw [hnone] at hr
    cases hr
  let E := arbitraryRootFiber D roots r
  have hcE : c ∈ E :=
    (mem_arbitraryRootFiber D roots r c).mpr ⟨hcD, hr⟩
  have hE : E.Nonempty := ⟨c, hcE⟩
  obtain ⟨hshape, a, hcorner, hboundary, haLabel⟩ :=
    hvalid.2.2.2 r hE
  by_cases hself : label c = r
  · exact Or.inl hself
  have hne : c ≠ a := by
    intro hca
    subst c
    exact hself haLabel
  have hrowconv : RowConvex E := skewRowIntervals_rowConvex hshape.1
  have hcolconv : ColumnConvex E := skewRowIntervals_columnConvex hshape.1
  by_cases hb : belowCell c ∈ E
  · by_cases hl : 0 < c.2 ∧ leftCell c ∈ E
    · by_cases hlt : label c < r
      · refine Or.inr (Or.inl ⟨?_, ?_, hlt⟩)
        · exact ((mem_arbitraryRootFiber D roots r (belowCell c)).mp hb).1
        · exact ((mem_arbitraryRootFiber D roots r (belowCell c)).mp hb).2
      · have hgt : r < label c := by omega
        refine Or.inr (Or.inr ⟨hl.1, ?_, ?_, hgt⟩)
        · exact ((mem_arbitraryRootFiber D roots r (leftCell c)).mp hl.2).1
        · exact ((mem_arbitraryRootFiber D roots r (leftCell c)).mp hl.2).2
    · have hleft : IsLeftBoundary E c :=
        leftBoundary_of_no_left_neighbor hrowconv hcE hl
      have hlt : label c < r := by
        calc
          label c < label a := hboundary.1 c hleft hne
          _ = r := haLabel
      refine Or.inr (Or.inl ⟨?_, ?_, hlt⟩)
      · exact ((mem_arbitraryRootFiber D roots r (belowCell c)).mp hb).1
      · exact ((mem_arbitraryRootFiber D roots r (belowCell c)).mp hb).2
  · by_cases hl : 0 < c.2 ∧ leftCell c ∈ E
    · have hbottom : IsBottomBoundary E c :=
        bottomBoundary_of_no_below_neighbor hcolconv hcE hb
      have hgt : r < label c := by
        calc
          r = label a := haLabel.symm
          _ < label c := hboundary.2 c hbottom hne
      refine Or.inr (Or.inr ⟨hl.1, ?_, ?_, hgt⟩)
      · exact ((mem_arbitraryRootFiber D roots r (leftCell c)).mp hl.2).1
      · exact ((mem_arbitraryRootFiber D roots r (leftCell c)).mp hl.2).2
    · have hleft : IsLeftBoundary E c :=
        leftBoundary_of_no_left_neighbor hrowconv hcE hl
      have hbottom : IsBottomBoundary E c :=
        bottomBoundary_of_no_below_neighbor hcolconv hcE hb
      exact False.elim (hne (hcorner.2.2 c hleft hbottom))

/-- Local order and strict provenance *force* the optional median.
This proof makes no reference to the scanning procedure or to a specially
chosen canonical assignment. -/
theorem strictRootChoices_force_median
    (D : Diagram) (label : Cell → ℕ) (roots : PartialRoots)
    (hord : RootLocallyOrdered D roots)
    (hchoice : AssignedRootChoices D label roots)
    (c : Cell) (hc : c ∈ D) (r : ℕ)
    (hr : roots c = some r) :
    computedRoot D label roots c = r := by
  have hlowerBound : ∀ a : ℕ,
      lowerEntry D roots c = some a → a ≤ r := by
    intro a ha
    exact hord.1 c hc a r (lowerEntry_some D roots c a ha) hr
  have hupperBound : ∀ b : ℕ,
      upperEntry D roots c = some b → r ≤ b := by
    intro b hb
    exact hord.2 c hc r b hr (upperEntry_some D roots c b hb)
  rcases hchoice c r hr with hself | hbelow | hleft
  · calc
      computedRoot D label roots c = label c := by
        cases hlo : lowerEntry D roots c with
        | none =>
            cases hup : upperEntry D roots c with
            | none => simp [computedRoot, hlo, hup]
            | some b =>
                have hxb : label c ≤ b := by
                  rw [hself]
                  exact hupperBound b hup
                simpa only [computedRoot, hlo, hup,
                  medianOptional_none_some] using (min_eq_left hxb)
        | some a =>
            have hax : a ≤ label c := by
              rw [hself]
              exact hlowerBound a hlo
            cases hup : upperEntry D roots c with
            | none =>
                simpa only [computedRoot, hlo, hup,
                  medianOptional_some_none] using (max_eq_right hax)
            | some b =>
                have hxb : label c ≤ b := by
                  rw [hself]
                  exact hupperBound b hup
                simpa only [computedRoot, hlo, hup,
                  medianOptional_some_some] using
                    (medianRoot_between a (label c) b hax hxb)
      _ = r := hself
  · obtain ⟨hbD, hbR, hlt⟩ := hbelow
    have hlo : lowerEntry D roots c = some r := by
      simp [lowerEntry, hbD, hbR]
    cases hup : upperEntry D roots c with
    | none =>
        simpa only [computedRoot, hlo, hup,
          medianOptional_some_none] using
            (max_eq_left (show label c ≤ r by omega))
    | some b =>
        simpa only [computedRoot, hlo, hup,
          medianOptional_some_some] using
            (medianRoot_below r (label c) b (by omega))
  · obtain ⟨hpos, hlD, hlR, hgt⟩ := hleft
    have hup : upperEntry D roots c = some r := by
      simp [upperEntry, hpos, hlD, hlR]
    cases hlo : lowerEntry D roots c with
    | none =>
        simpa only [computedRoot, hlo, hup,
          medianOptional_none_some] using
            (min_eq_right (show r ≤ label c by omega))
    | some a =>
        have har : a ≤ r := hlowerBound a hlo
        simpa only [computedRoot, hlo, hup,
          medianOptional_some_some] using
            (medianRoot_above a (label c) r har (by omega))

/-- Two full root assignments respecting local order and strict
provenance necessarily coincide on the diagram. The induction is over
*all* canonical cells, not over a handpicked subset of roots. -/
theorem orderedStrictAssignments_unique
    (D : Diagram) (label : Cell → ℕ)
    (F G : PartialRoots)
    (hFtotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, F c = some r)
    (hGtotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, G c = some r)
    (hFord : RootLocallyOrdered D F)
    (hGord : RootLocallyOrdered D G)
    (hFchoice : AssignedRootChoices D label F)
    (hGchoice : AssignedRootChoices D label G) :
    ∀ c : Cell, c ∈ D → F c = G c := by
  have hInd : ∀ (future past : List Cell),
      canonicalScanHistory D = past ++ future →
      (∀ d : Cell, d ∈ past → F d = G d) →
      ∀ d : Cell, d ∈ past ++ future → F d = G d := by
    intro future
    induction future with
    | nil =>
        intro past _ hag d hd
        exact hag d (by simpa using hd)
    | cons c future ih =>
        intro past hscan hag
        have hcD : c ∈ D := by
          apply (canonicalScanHistory_mem D c).mp
          rw [hscan]
          simp
        have hlow : lowerEntry D F c = lowerEntry D G c := by
          by_cases hb : belowCell c ∈ D
          · have hEq : F (belowCell c) = G (belowCell c) :=
              hag _ (canonicalScanHistory_predecessor_in_prefix
                D past future c (belowCell c) hscan hb (belowCell_earlier c))
            simp [lowerEntry, hb, hEq]
          · simp [lowerEntry, hb]
        have hupp : upperEntry D F c = upperEntry D G c := by
          by_cases hl : 0 < c.2 ∧ leftCell c ∈ D
          · have hEq : F (leftCell c) = G (leftCell c) :=
              hag _ (canonicalScanHistory_predecessor_in_prefix
                D past future c (leftCell c) hscan hl.2
                  (leftCell_earlier c hl.1))
            simp [upperEntry, hl, hEq]
          · simp [upperEntry, hl]
        have hmed : computedRoot D label F c =
            computedRoot D label G c := by
          simp only [computedRoot, hlow, hupp]
        obtain ⟨r, hr⟩ := hFtotal c hcD
        obtain ⟨s, hs⟩ := hGtotal c hcD
        have hfr : computedRoot D label F c = r :=
          strictRootChoices_force_median D label F hFord hFchoice c hcD r hr
        have hgs : computedRoot D label G c = s :=
          strictRootChoices_force_median D label G hGord hGchoice c hcD s hs
        have hcEq : F c = G c := by
          calc
            F c = some r := hr
            _ = some (computedRoot D label F c) := by rw [hfr]
            _ = some (computedRoot D label G c) := congrArg some hmed
            _ = some s := by rw [hgs]
            _ = G c := hs.symm
        have hagNext : ∀ d : Cell, d ∈ past ++ [c] → F d = G d := by
          intro d hd
          rcases List.mem_append.mp hd with hp | hc
          · exact hag d hp
          · have hdc : d = c := by simpa using hc
            simpa only [hdc] using hcEq
        have hnext : canonicalScanHistory D =
            (past ++ [c]) ++ future := by
          simpa [List.append_assoc] using hscan
        have hresult := ih (past ++ [c]) hnext hagNext
        simpa [List.append_assoc] using hresult
  have hresult := hInd (canonicalScanHistory D) [] (by simp)
    (by intro d hd; simp at hd)
  intro c hcD
  exact hresult c (by
    simpa using (canonicalScanHistory_mem D c).2 hcD)

/-- Lemma 4.3 — uniqueness of admissible canonical root assignments.
    This proves uniqueness among *all* `AdmissibleBlockAssignment`s,
    NOT only among outputs of the median scan. Hypotheses are the
    corrected intrinsic boundary conditions and LOCAL interblock order,
    not the median recurrence. The final combined result follows below. -/
theorem admissibleBlockAssignment_unique
    (D : Diagram) (label : Cell → ℕ)
    (F G : PartialRoots)
    (hF : AdmissibleBlockAssignment D label F)
    (hG : AdmissibleBlockAssignment D label G) :
    ∀ c : Cell, c ∈ D → F c = G c := by
  exact orderedStrictAssignments_unique D label F G
    hF.1 hG.1 hF.2.2.1 hG.2.2.1
    (admissibleBlockAssignment_rootChoices D label F hF)
    (admissibleBlockAssignment_rootChoices D label G hG)

/-- The canonical scan is itself an admissible root assignment;
this invokes the existence certificate already established above. -/
theorem canonicalRoots_admissible
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b) :
    AdmissibleBlockAssignment D label
      (rootsAfterHistory D label (canonicalScanHistory D)) := by
  have hcert := canonicalBlock_existence_certificate D label hsk hinj
  refine ⟨canonicalScanHistory_total D label, ?_,
    canonicalScanHistory_locallyOrdered D label hsk, ?_⟩
  · intro c hcD
    apply rootsAfterHistory_unassigned D label (canonicalScanHistory D) c
    intro hc
    exact hcD ((canonicalScanHistory_mem D c).mp hc)
  · intro r hnonempty
    have hE : (canonicalRootFiber D label r).Nonempty := by
      simpa [arbitraryRootFiber, canonicalRootFiber] using hnonempty
    obtain ⟨hshape, a, hcorner, hboundary, hlabel⟩ := hcert.2.1 r hE
    simpa [arbitraryRootFiber, canonicalRootFiber] using
      (show ConnectedSkewRows (canonicalRootFiber D label r) ∧
        ∃ a : Cell,
          UniqueSouthwestCorner (canonicalRootFiber D label r) a ∧
          RootBoundaryConditions (canonicalRootFiber D label r) a label ∧
          label a = r from
            ⟨hshape, a, hcorner, hboundary, hlabel⟩)

/-- Lemma 4.3 — canonical block partition, existence and uniqueness.
    This formalizes the existence and uniqueness assertion in manuscript
    Lemma 4.3, under the explicitly root-excluded convention.
    Assumptions: D satisfies `SkewRowIntervals`, labels are injective.
    Conclusion: a UNIQUE admissible assignment on D (not necessarily
    unique outside D, where all admissible assignments are `none`).
    Every fiber is a connected skew block with a southwest root and
    corrected strict boundary labels. DOES NOT prove the literal
    uncorrected Kahane Definition 4.2 (which is inconsistent), nor
    assert that the resulting statistic equals his intended statistic
    without resolving the root-exclusion typo. The global-order
    equivalence is now proved in `rootLocallyOrdered_iff_kahaneGlobal`. -/
theorem correctedCanonicalBlocks_exists_unique
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b) :
    ∃ roots : PartialRoots,
      AdmissibleBlockAssignment D label roots ∧
      ∀ other : PartialRoots,
        AdmissibleBlockAssignment D label other →
        ∀ c : Cell, c ∈ D → other c = roots c := by
  let roots := rootsAfterHistory D label (canonicalScanHistory D)
  have hvalid : AdmissibleBlockAssignment D label roots :=
    canonicalRoots_admissible D label hsk hinj
  refine ⟨roots, hvalid, ?_⟩
  intro other hother c hc
  exact admissibleBlockAssignment_unique D label other roots
    hother hvalid c hc

end CanonicalBlocks
end OrderIdealSpecializations

/-! ### §4.3 — Lemma 4.3: Final bridge to Kahane's global block order

The following equivalence compares two orders on block roots:
* `RootLocallyOrdered` only compares roots at adjacent cells;
* `KahaneGlobalBlockOrder` is the corrected form of Kahane v1
  Definition 3.2 applied to his skew-shape Definition 4.2: if a cell of
  block B is strictly BELOW a cell of block C in the skew poset, the
  root label of B must be strictly smaller than the root label of C.

With rows increasing southward and columns increasing eastward, the
comparison is `northwest <= southeast` coordinatewise; the SOUTHEAST
cell is lower in Kahane's poset. Equal labels are allowed ONLY within a
single block, and the global condition is strict for distinct roots.

The equivalence is proved for arbitrary total root assignments, not just
for the particular assignment produced by the canonical median scan.
It uses the skew-diagram geometry and the fact that roots outside D are
`none`. No median recursion or root-boundary hypothesis is used. -/
namespace OrderIdealSpecializations
namespace CanonicalBlocks

/-- Lemma 4.3 — Kahane Definition 3.2, global block order.
    The pair `(a,b)` consists of a northwestern and a southeastern cell;
    `b` precedes `a` in Kahane's skew-poset orientation. If their roots
    differ, the root of the block containing `b` has smaller label. -/
def KahaneGlobalBlockOrder (D : Diagram) (roots : PartialRoots) : Prop :=
  ∀ (a b : Cell) (ra rb : ℕ),
    a ∈ D → b ∈ D → a.1 ≤ b.1 → a.2 ≤ b.2 →
    roots a = some ra → roots b = some rb →
    ra ≠ rb → rb < ra

/-- In a skew row-interval diagram, the southwest corner of any pair
    of comparable cells is present. In particular, the local horizontal
    and vertical comparisons can be composed inside the diagram. -/
theorem skewRowIntervals_comparable_southwest_corner
    (D : Diagram) (hsk : SkewRowIntervals D)
    (a b : Cell) (ha : a ∈ D) (hb : b ∈ D)
    (hrow : a.1 ≤ b.1) (hcol : a.2 ≤ b.2) :
    (b.1, a.2) ∈ D := by
  obtain ⟨n, lo, hi, hmem, hlo, _⟩ := hsk
  have ha' := (hmem a.1 a.2).mp ha
  have hb' := (hmem b.1 b.2).mp hb
  have hlo' : lo b.1 ≤ lo a.1 :=
    finiteInterval_antitone lo n hlo a.1 b.1 hrow hb'.1
  apply (hmem b.1 a.2).mpr
  exact ⟨hb'.1, hlo'.trans ha'.2.1,
    lt_of_le_of_lt hcol hb'.2.2⟩

/-- The local order along adjacent horizontal cells extends to two
    arbitrary cells of one row, using row convexity and totality. -/
theorem localRootOrder_horizontal
    (D : Diagram) (roots : PartialRoots)
    (hlocal : RootLocallyOrdered D roots)
    (htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r)
    (hconv : RowConvex D)
    (row i j : ℕ) (hij : i ≤ j)
    (hi : (row, i) ∈ D) (hj : (row, j) ∈ D)
    (u v : ℕ) (hu : roots (row, i) = some u)
    (hv : roots (row, j) = some v) : v ≤ u := by
  revert v hj hv
  induction j, hij using Nat.le_induction with
  | base =>
      intro _ v hv
      have heq : u = v := Option.some.inj (hu.symm.trans hv)
      omega
  | succ j hij ih =>
      intro hj v hv
      have hmD : (row, j) ∈ D :=
        hconv row i (j + 1) j hi hj (by omega) (by omega)
      obtain ⟨m, hm⟩ := htotal (row, j) hmD
      have hstep : v ≤ m := hlocal.2 (row, j + 1) hj v m hv
        (by simpa [leftCell] using hm)
      exact hstep.trans (ih hmD m hm)

/-- The local order along adjacent vertical cells extends to two
    arbitrary cells of one column, using column convexity and totality. -/
theorem localRootOrder_vertical
    (D : Diagram) (roots : PartialRoots)
    (hlocal : RootLocallyOrdered D roots)
    (htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r)
    (hconv : ColumnConvex D)
    (col i j : ℕ) (hij : i ≤ j)
    (hi : (i, col) ∈ D) (hj : (j, col) ∈ D)
    (u v : ℕ) (hu : roots (i, col) = some u)
    (hv : roots (j, col) = some v) : v ≤ u := by
  revert v hj hv
  induction j, hij using Nat.le_induction with
  | base =>
      intro _ v hv
      have heq : u = v := Option.some.inj (hu.symm.trans hv)
      omega
  | succ j hij ih =>
      intro hj v hv
      have hmD : (j, col) ∈ D :=
        hconv col i (j + 1) j hi hj (by omega) (by omega)
      obtain ⟨m, hm⟩ := htotal (j, col) hmD
      have hstep : v ≤ m := hlocal.1 (j, col) hmD v m
        (by simpa [belowCell] using hv) hm
      exact hstep.trans (ih hmD m hm)

/-- Lemma 4.3 — local order IMPLIES Kahane's global
    interblock order, on any skew row-interval diagram and for any total
    root assignment. The inequality is strict for DISTINCT blocks. -/
theorem kahaneGlobalBlockOrder_of_local
    (D : Diagram) (roots : PartialRoots)
    (hsk : SkewRowIntervals D)
    (htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r)
    (hlocal : RootLocallyOrdered D roots) :
    KahaneGlobalBlockOrder D roots := by
  intro a b ra rb ha hb hrow hcol hra hrb hne
  have hcorner : (b.1, a.2) ∈ D :=
    skewRowIntervals_comparable_southwest_corner D hsk a b
      ha hb hrow hcol
  obtain ⟨m, hm⟩ := htotal (b.1, a.2) hcorner
  have hhor : rb ≤ m :=
    localRootOrder_horizontal D roots hlocal htotal
      (skewRowIntervals_rowConvex hsk)
      b.1 a.2 b.2 hcol hcorner hb m rb hm hrb
  have hver : m ≤ ra :=
    localRootOrder_vertical D roots hlocal htotal
      (skewRowIntervals_columnConvex hsk)
      a.2 a.1 b.1 hrow ha hcorner ra m hra hm
  omega

/-- Lemma 4.3 — Kahane's global interblock order IMPLIES
    the local root order when assignments outside D are undefined.
    In equal-root neighboring cells, the required weak inequality is
    reflexive; in distinct-root cells, global strict order applies. -/
theorem rootLocallyOrdered_of_kahaneGlobal
    (D : Diagram) (roots : PartialRoots)
    (houtside : ∀ c : Cell, c ∉ D → roots c = none)
    (hglobal : KahaneGlobalBlockOrder D roots) :
    RootLocallyOrdered D roots := by
  constructor
  · intro c hc a b hbelow hcur
    have hbD : belowCell c ∈ D := by
      by_contra hn
      have hnroot := houtside (belowCell c) hn
      rw [hnroot] at hbelow
      cases hbelow
    by_cases heq : a = b
    · omega
    · have hlt : a < b :=
        hglobal c (belowCell c) b a hc hbD
          (by simp [belowCell]) (by simp [belowCell])
          hcur hbelow (by omega)
      omega
  · intro c hc a b hcur hleft
    have hlD : leftCell c ∈ D := by
      by_contra hn
      have hnroot := houtside (leftCell c) hn
      rw [hnroot] at hleft
      cases hleft
    by_cases heq : a = b
    · omega
    · have hlt : a < b :=
        hglobal (leftCell c) c b a hlD hc
          (by simp [leftCell]) (by simp [leftCell])
          hleft hcur (by omega)
      omega

/-- Lemma 4.3 — equivalence of local and global root orders
    used throughout the Lean development and the GLOBAL order imposed
    by Kahane Definition 3.2, under the explicit assumptions that D
    is a skew diagram and the assignment is total on D and none off D. -/
theorem rootLocallyOrdered_iff_kahaneGlobal
    (D : Diagram) (roots : PartialRoots)
    (hsk : SkewRowIntervals D)
    (htotal : ∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r)
    (houtside : ∀ c : Cell, c ∉ D → roots c = none) :
    RootLocallyOrdered D roots ↔ KahaneGlobalBlockOrder D roots := by
  constructor
  · exact kahaneGlobalBlockOrder_of_local D roots hsk htotal
  · exact rootLocallyOrdered_of_kahaneGlobal D roots houtside

/-- Lemma 4.3 — intrinsic valid block partition with the
    GLOBAL strict block order of Kahane Definition 3.2, rather than a
    local condition. The other requirements match Definition 4.1 and
    `AdmissibleBlockAssignment`. -/
def KahaneOrderedBlockAssignment
    (D : Diagram) (label : Cell → ℕ) (roots : PartialRoots) : Prop :=
  (∀ c : Cell, c ∈ D → ∃ r : ℕ, roots c = some r) ∧
  (∀ c : Cell, c ∉ D → roots c = none) ∧
  KahaneGlobalBlockOrder D roots ∧
  (∀ r : ℕ, (arbitraryRootFiber D roots r).Nonempty →
    ConnectedSkewRows (arbitraryRootFiber D roots r) ∧
    ∃ a : Cell,
      UniqueSouthwestCorner (arbitraryRootFiber D roots r) a ∧
      RootBoundaryConditions (arbitraryRootFiber D roots r) a label ∧
      label a = r)

/-- Lemma 4.3 — two formulations of admissibility are
    interchangeable, for ALL assignments, without presupposing their
    uniqueness or requiring that they arise from the median scan. -/
theorem admissible_iff_kahaneOrdered
    (D : Diagram) (label : Cell → ℕ) (roots : PartialRoots)
    (hsk : SkewRowIntervals D) :
    AdmissibleBlockAssignment D label roots ↔
      KahaneOrderedBlockAssignment D label roots := by
  constructor
  · rintro ⟨htotal, houtside, hlocal, hblocks⟩
    exact ⟨htotal, houtside,
      (rootLocallyOrdered_iff_kahaneGlobal D roots hsk
        htotal houtside).mp hlocal, hblocks⟩
  · rintro ⟨htotal, houtside, hglobal, hblocks⟩
    exact ⟨htotal, houtside,
      (rootLocallyOrdered_iff_kahaneGlobal D roots hsk
        htotal houtside).mpr hglobal, hblocks⟩

/-- Lemma 4.3 — canonical partition with global block order
    from Kahane Definition 3.2 and the necessary ROOT EXCLUSION from
    the printed Definition 4.2. This is the amended Lemma 4.3 in Kahane's
    numbering. Existence and uniqueness are unconditional among
    globally valid block partitions (for injective labels), not merely
    among partitions produced by the median algorithm. -/
theorem correctedKahaneBlocks_exists_unique
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b) :
    ∃ roots : PartialRoots,
      KahaneOrderedBlockAssignment D label roots ∧
      ∀ other : PartialRoots,
        KahaneOrderedBlockAssignment D label other →
        ∀ c : Cell, c ∈ D → other c = roots c := by
  obtain ⟨roots, hvalid, hunique⟩ :=
    correctedCanonicalBlocks_exists_unique D label hsk hinj
  refine ⟨roots, (admissible_iff_kahaneOrdered D label roots hsk).mp
    hvalid, ?_⟩
  intro other hother c hc
  exact hunique other
    ((admissible_iff_kahaneOrdered D label other hsk).mpr hother)
    c hc

end CanonicalBlocks
end OrderIdealSpecializations

/-!
## §4.4 — Root convention and comparison with Kahane

The strict boundary inequalities exclude the southwest root itself.
The necessity of this exclusion follows from `left_root_exclusion_necessary`
and `bottom_root_exclusion_necessary`: otherwise a root would have to be
strictly smaller or strictly larger than its own label.

`rootLocallyOrdered_iff_kahaneGlobal` identifies the local adjacent-root
condition with the corresponding global strict order for a total root
assignment. Together with the median construction, it yields
`correctedKahaneBlocks_exists_unique`.

The equivalence of this root-excluded statistic with the intended statistic
in Kahane's published source depends on the precise source version and
its parent/child conventions. This is a bibliographic and mathematical
comparison, not a consequence of Lean's kernel verification.
-/

/-!
## §5 — A commuting tableau transfer family
### §5.1 — Two-color tableau transfer and matrix identities

For ideals I ⊆ J, the transfer entry T_x[I,J] records the number of
columns of J \ I. The kernel A_z[I,J] is supported on connected,
nonempty skew differences. The matrix Z is the zeta matrix of the
ideal lattice. The principal statements of this section are
`tableau_transfer_matrices_commute`,
`vertical_strip_inverse_and_log_derivative`, and
`connected_block_kernels_commute`.
-/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Cells of a fixed *finite* diagram, with their inherited poset order. -/
abbrev ShapeCell (D : Diagram) := {c : Cell // c ∈ D}

noncomputable instance shapeCellFintype (D : Diagram) :
    Fintype (ShapeCell D) := by
  classical
  infer_instance

/-- Matrix indices: the lower ideals of the finite diagram poset. -/
abbrev ShapeIdeal (D : Diagram) :=
  FinitePoset.IdealIndex (α := ShapeCell D)

/-- The cells added when going from ideal I to ideal J. -/
noncomputable def intervalCells (D : Diagram)
    (I J : ShapeIdeal D) : Diagram := by
  classical
  exact (J.1 \ I.1).image (fun c : ShapeCell D => c.1)

/-- Number of occupied columns of a finite cell set. -/
def columnCount (E : Diagram) : ℕ :=
  (E.image Prod.snd).card

/-- Number of occupied rows of a finite cell set. -/
def rowCount (E : Diagram) : ℕ :=
  (E.image Prod.fst).card

@[simp] theorem columnCount_empty : columnCount (∅ : Diagram) = 0 := by
  simp [columnCount]

@[simp] theorem rowCount_empty : rowCount (∅ : Diagram) = 0 := by
  simp [rowCount]

/-- The interval has width zero exactly when there are no new cells. -/
theorem interval_width_zero_iff (D : Diagram) (I J : ShapeIdeal D) :
    columnCount (intervalCells D I J) = 0 ↔ J.1 ⊆ I.1 := by
  classical
  constructor
  · intro h c hcJ
    by_contra hcI
    have hdiff : c ∈ J.1 \ I.1 :=
      Finset.mem_sdiff.mpr ⟨hcJ, hcI⟩
    have hcell : c.1 ∈ intervalCells D I J := by
      exact Finset.mem_image.mpr ⟨c, hdiff, rfl⟩
    have hcol : c.1.2 ∈ (intervalCells D I J).image Prod.snd := by
      exact Finset.mem_image.mpr ⟨c.1, hcell, rfl⟩
    have hempty : (intervalCells D I J).image Prod.snd = ∅ :=
      Finset.card_eq_zero.mp h
    simp [hempty] at hcol
  · intro h
    have he : J.1 \ I.1 = ∅ := Finset.sdiff_eq_empty_iff_subset.mpr h
    simp [intervalCells, columnCount, he]

/-- T_x is the finite transfer matrix from manuscript (5.1). -/
noncomputable def T (D : Diagram) (x : ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then x ^ columnCount (intervalCells D I J) else 0)

/-- Z is the incidence zeta matrix over ℚ. -/
noncomputable def Z (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J => if I.1 ⊆ J.1 then 1 else 0)

/-- The connected-increment kernel A_z of manuscript (5.2). -/
noncomputable def A (D : Diagram) (z : ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊂ J.1 ∧ ConnectedSkewRows (intervalCells D I J) then
      z ^ (rowCount (intervalCells D I J) - 1) *
        (1 - z) ^ (columnCount (intervalCells D I J) - 1)
    else 0)

/-- Entry of T_x on a comparable pair of ideals. -/
theorem T_of_subset (D : Diagram) (x : ℚ) (I J : ShapeIdeal D)
    (h : I.1 ⊆ J.1) :
    T D x I J = x ^ columnCount (intervalCells D I J) := by
  change (if I.1 ⊆ J.1 then
    x ^ columnCount (intervalCells D I J) else 0) =
    x ^ columnCount (intervalCells D I J)
  exact ite_eq_left h

/-- Transfer entries vanish outside the incidence order. -/
theorem T_of_not_subset (D : Diagram) (x : ℚ) (I J : ShapeIdeal D)
    (h : ¬ I.1 ⊆ J.1) :
    T D x I J = 0 := by
  change (if I.1 ⊆ J.1 then
    x ^ columnCount (intervalCells D I J) else 0) = 0
  exact ite_eq_right h

/-- The diagonal of every T_x equals one. -/
@[simp] theorem T_diagonal (D : Diagram) (x : ℚ) (I : ShapeIdeal D) :
    T D x I I = 1 := by
  simp [T, intervalCells, columnCount]

/-- At x=1, T_x becomes the zeta matrix Z. -/
theorem T_one (D : Diagram) : T D 1 = Z D := by
  classical
  ext I J
  by_cases h : I.1 ⊆ J.1
  · simp [T, Z]
  · simp [T, Z]

/-- At x=0, T_x is the identity, including off-diagonal entries. -/
theorem T_zero (D : Diagram) : T D 0 = 1 := by
  classical
  ext I J
  by_cases heq : I = J
  · subst J
    simp
  · by_cases hsub : I.1 ⊆ J.1
    · have hw : columnCount (intervalCells D I J) ≠ 0 := by
        intro hz
        have hrev : J.1 ⊆ I.1 :=
          (interval_width_zero_iff D I J).mp hz
        have he : I = J := by
          apply Subtype.ext
          exact le_antisymm hsub hrev
        exact heq he
      simp [T, hw, heq]
    · rw [T_of_not_subset D 0 I J hsub]
      simp [heq]

/-- A_z is strictly triangular: it has zero diagonal. -/
@[simp] theorem A_diagonal (D : Diagram) (z : ℚ) (I : ShapeIdeal D) :
    A D z I I = 0 := by
  simp [A]

/-- A_z vanishes unless the first ideal is strictly smaller. -/
theorem A_of_not_ssubset (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊂ J.1) :
    A D z I J = 0 := by
  simp [A, h]

/-- A_z vanishes for disconnected increments. -/
theorem A_of_not_connected (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D)
    (h : ¬ ConnectedSkewRows (intervalCells D I J)) :
    A D z I J = 0 := by
  simp [A, h]

/-- The explicit local connected-shape entry of A_z. -/
theorem A_of_connected (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D) (hproper : I.1 ⊂ J.1)
    (hconnected : ConnectedSkewRows (intervalCells D I J)) :
    A D z I J =
      z ^ (rowCount (intervalCells D I J) - 1) *
        (1 - z) ^ (columnCount (intervalCells D I J) - 1) := by
  simp [A, hproper, hconnected]

/-- Exact two-color expansion of a product of transfer matrices.
The forthcoming commutation lemma requires a genuine bijection/symmetry
argument for this sum: it does NOT follow by swapping x and y termwise. -/
theorem T_mul_entry (D : Diagram) (x y : ℚ)
    (I J : ShapeIdeal D) :
    (T D x * T D y) I J =
      ∑ K : ShapeIdeal D,
        if I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 then
          x ^ columnCount (intervalCells D I K) *
            y ^ columnCount (intervalCells D K J)
        else 0 := by
  classical
  rw [Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro K _
  by_cases hik : I.1 ⊆ K.1
  · by_cases hkj : K.1 ⊆ J.1
    · rw [T_of_subset D x I K hik,
          T_of_subset D y K J hkj,
          ite_eq_left (show I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 from
            ⟨hik, hkj⟩)]
    · rw [T_of_not_subset D y K J hkj, mul_zero,
          ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
            fun hh => hkj hh.2)]
  · rw [T_of_not_subset D x I K hik, zero_mul,
        ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
          fun hh => hik hh.1)]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Transfer commutativity and binary reverse plane partitions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The intermediate ideals between I and J are the two-colour fillings
of the skew interval J \ I (first colour: K \ I; second: J \ K). -/
def IsIntermediate (D : CanonicalBlocks.Diagram) (I J K : ShapeIdeal D) : Prop :=
  I.1 ⊆ K.1 ∧ K.1 ⊆ J.1

/-- The two-colour weight of an intermediate ideal, extended by zero
outside the interval. -/
noncomputable def twoColorWeight (D : CanonicalBlocks.Diagram) (x y : ℚ)
    (I J K : ShapeIdeal D) : ℚ := by
  classical
  exact if IsIntermediate D I J K then
    x ^ columnCount (intervalCells D I K) *
      y ^ columnCount (intervalCells D K J)
  else 0

/-- The product of transfers is exactly the two-colour generating sum. -/
theorem T_mul_twoColor (D : CanonicalBlocks.Diagram) (x y : ℚ)
    (I J : ShapeIdeal D) :
    (T D x * T D y) I J =
      ∑ K : ShapeIdeal D, twoColorWeight D x y I J K := by
  rw [T_mul_entry]
  apply Finset.sum_congr rfl
  intro K hK
  by_cases h : I.1 ⊆ K.1 ∧ K.1 ⊆ J.1
  · simp [twoColorWeight, IsIntermediate, h]
  · simp [twoColorWeight, IsIntermediate]

/-- A switching bijection for an interval exchanges the two column counts.
The actual construction of such bijections for all skew diagrams is the
nontrivial combinatorial content of the two-colour symmetry theorem. -/
structure ColumnSwitch (D : Diagram) (I J : ShapeIdeal D) where
  toEquiv : ShapeIdeal D ≃ ShapeIdeal D
  interval_iff : ∀ K : ShapeIdeal D,
    IsIntermediate D I J K ↔ IsIntermediate D I J (toEquiv K)
  first_to_second : ∀ K : ShapeIdeal D,
    IsIntermediate D I J K →
      columnCount (intervalCells D I K) =
        columnCount (intervalCells D (toEquiv K) J)
  second_to_first : ∀ K : ShapeIdeal D,
    IsIntermediate D I J K →
      columnCount (intervalCells D K J) =
        columnCount (intervalCells D I (toEquiv K))

/-- The weight of one two-colour filling equals the reversed weight
of its image under a column switch. -/
theorem twoColorWeight_switched
    (D : CanonicalBlocks.Diagram) (x y : ℚ) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D) :
    twoColorWeight D x y I J K =
      twoColorWeight D y x I J (S.toEquiv K) := by
  unfold twoColorWeight
  by_cases hk : IsIntermediate D I J K
  · rw [ite_eq_left hk, ite_eq_left ((S.interval_iff K).mp hk)]
    rw [← S.second_to_first K hk, ← S.first_to_second K hk]
    exact mul_comm _ _
  · have hk' : ¬ IsIntermediate D I J (S.toEquiv K) := by
      intro h'
      exact hk ((S.interval_iff K).mpr h')
    simp [hk, hk']

/-- A single column-switch bijection proves the two-colour symmetry
for the corresponding skew interval, for all rational x and y. -/
theorem twoColor_sum_switched
    (D : CanonicalBlocks.Diagram) (x y : ℚ) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) :
    (∑ K : ShapeIdeal D, twoColorWeight D x y I J K) =
      ∑ K : ShapeIdeal D, twoColorWeight D y x I J K := by
  classical
  exact Fintype.sum_equiv S.toEquiv
    (fun K => twoColorWeight D x y I J K)
    (fun K => twoColorWeight D y x I J K)
    (twoColorWeight_switched D x y I J S)

/-- If each ideal interval admits a weight-swapping column-switch
bijection, the corresponding tableau transfer matrices commute.
The unconditional existence of the switches for skew row-interval diagrams
is established by the subsequent Bender–Knuth construction. -/
theorem T_commute_of_columnSwitches (D : CanonicalBlocks.Diagram)
    (hSwitch : ∀ I J : ShapeIdeal D, Nonempty (ColumnSwitch D I J))
    (x y : ℚ) : T D x * T D y = T D y * T D x := by
  classical
  ext I J
  obtain ⟨S⟩ := hSwitch I J
  calc
    (T D x * T D y) I J =
        ∑ K : ShapeIdeal D, twoColorWeight D x y I J K :=
      T_mul_twoColor D x y I J
    _ = ∑ K : ShapeIdeal D, twoColorWeight D y x I J K :=
      twoColor_sum_switched D x y I J S
    _ = (T D y * T D x) I J :=
      (T_mul_twoColor D y x I J).symm

/-- An incomparable pair of ideals has no intermediate two-colour filling. -/
theorem not_intermediate_of_not_subset (D : CanonicalBlocks.Diagram)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊆ J.1)
    (K : ShapeIdeal D) : ¬ IsIntermediate D I J K := by
  intro hK
  exact h (hK.1.trans hK.2)

/-- Outside the incidence order the transfer product is zero. -/
theorem T_mul_of_not_subset (D : CanonicalBlocks.Diagram) (x y : ℚ)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊆ J.1) :
    (T D x * T D y) I J = 0 := by
  rw [T_mul_twoColor]
  apply Finset.sum_eq_zero
  intro K _
  have hk : ¬ IsIntermediate D I J K :=
    not_intermediate_of_not_subset D I J h K
  simp [twoColorWeight, hk]

/-- The commutation identity is already unconditional if one
of the two parameters is zero. -/
theorem T_commute_with_zero (D : CanonicalBlocks.Diagram) (x : ℚ) :
    T D x * T D 0 = T D 0 * T D x := by
  simp only [T_zero, mul_one, one_mul]

/-- On an incomparable pair the switching bijection can be the identity:
there are no valid fillings to constrain the column counts. -/
def columnSwitch_of_not_subset (D : CanonicalBlocks.Diagram)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊆ J.1) :
    ColumnSwitch D I J where
  toEquiv := Equiv.refl (ShapeIdeal D)
  interval_iff := by
    intro K
    rfl
  first_to_second := by
    intro K hK
    exact False.elim ((not_intermediate_of_not_subset D I J h K) hK)
  second_to_first := by
    intro K hK
    exact False.elim ((not_intermediate_of_not_subset D I J h K) hK)

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Lemma 5.1: Column-profile decomposition and conservation. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The columns occupied by the skew interval `J \ I`. -/
noncomputable def intervalColumns (D : Diagram)
    (I J : ShapeIdeal D) : Finset ℕ :=
  (intervalCells D I J).image Prod.snd

/-- Column count really is the cardinality of `intervalColumns`. -/
theorem intervalColumns_card (D : Diagram) (I J : ShapeIdeal D) :
    (intervalColumns D I J).card =
      columnCount (intervalCells D I J) := by
  rfl

/-- Every cell in an interval actually lies in the ambient diagram. -/
theorem intervalCells_subset_diagram (D : Diagram)
    (I J : ShapeIdeal D) : intervalCells D I J ⊆ D := by
  classical
  intro c hc
  change c ∈ (J.1 \ I.1).image (fun a : ShapeCell D => a.1) at hc
  rcases Finset.mem_image.mp hc with ⟨a, _, rfl⟩
  exact a.property

/-- Every occupied interval column is an occupied ambient column. -/
theorem intervalColumns_subset_diagram (D : Diagram)
    (I J : ShapeIdeal D) :
    intervalColumns D I J ⊆ D.image Prod.snd := by
  classical
  intro c hc
  change c ∈ (intervalCells D I J).image Prod.snd at hc
  rcases Finset.mem_image.mp hc with ⟨p, hp, rfl⟩
  exact Finset.mem_image.mpr
    ⟨p, intervalCells_subset_diagram D I J hp, rfl⟩

/-- An interval cannot occupy more columns than its ambient diagram. -/
theorem interval_columnCount_le (D : Diagram)
    (I J : ShapeIdeal D) :
    columnCount (intervalCells D I J) ≤ columnCount D := by
  classical
  exact Finset.card_le_card (intervalColumns_subset_diagram D I J)

/-- For three nested ideals, the skew difference is a DISJOINT union
of its two consecutive differences. This is set-theoretic (cellwise). -/
theorem intervalCells_split (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    intervalCells D I J =
      intervalCells D I K ∪ intervalCells D K J := by
  classical
  have hsplit : J.1 \ I.1 = (K.1 \ I.1) ∪ (J.1 \ K.1) := by
    ext c
    simp only [Finset.mem_sdiff, Finset.mem_union]
    constructor
    · rintro ⟨hcJ, hcI⟩
      by_cases hcK : c ∈ K.1
      · exact Or.inl ⟨hcK, hcI⟩
      · exact Or.inr ⟨hcJ, hcK⟩
    · intro hc
      rcases hc with ⟨hcK, hcI⟩ | ⟨hcJ, hcK⟩
      · exact ⟨hKJ hcK, hcI⟩
      · exact ⟨hcJ, fun hcI => hcK (hIK hcI)⟩
  unfold intervalCells
  rw [hsplit, Finset.image_union]

/-- Although the cell pieces in `intervalCells_split` are disjoint,
their *sets of columns* can overlap, precisely at mixed columns. -/
theorem intervalColumns_split (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    intervalColumns D I J =
      intervalColumns D I K ∪ intervalColumns D K J := by
  classical
  unfold intervalColumns
  rw [intervalCells_split D I K J hIK hKJ, Finset.image_union]

/-- The columns containing both colours in the intermediate filling K. -/
noncomputable def mixedColumns (D : Diagram)
    (I J K : ShapeIdeal D) : Finset ℕ :=
  intervalColumns D I K ∩ intervalColumns D K J

/-- Columns containing only colour one. -/
noncomputable def pureFirstColumns (D : Diagram)
    (I J K : ShapeIdeal D) : Finset ℕ :=
  intervalColumns D I K \ intervalColumns D K J

/-- Columns containing only colour two. -/
noncomputable def pureSecondColumns (D : Diagram)
    (I J K : ShapeIdeal D) : Finset ℕ :=
  intervalColumns D K J \ intervalColumns D I K

/-- A mixed column is simultaneously a first- and second-colour column. -/
theorem mixedColumns_subset_first (D : Diagram)
    (I J K : ShapeIdeal D) :
    mixedColumns D I J K ⊆ intervalColumns D I K := by
  classical
  exact Finset.inter_subset_left

/-- The same mixed column is a second-colour column. -/
theorem mixedColumns_subset_second (D : Diagram)
    (I J K : ShapeIdeal D) :
    mixedColumns D I J K ⊆ intervalColumns D K J := by
  classical
  exact Finset.inter_subset_right

/-- Two pure colour classes are disjoint. -/
theorem pureColumns_disjoint (D : Diagram)
    (I J K : ShapeIdeal D) :
    Disjoint (pureFirstColumns D I J K)
      (pureSecondColumns D I J K) := by
  classical
  simp only [pureFirstColumns, pureSecondColumns]
  apply Finset.disjoint_left.mpr
  intro c hc hd
  have hc' := (Finset.mem_sdiff.mp hc).1
  exact (Finset.mem_sdiff.mp hd).2 hc'

/-- A first-only column is never mixed. -/
theorem pureFirst_mixed_disjoint (D : Diagram)
    (I J K : ShapeIdeal D) :
    Disjoint (pureFirstColumns D I J K)
      (mixedColumns D I J K) := by
  classical
  simp only [pureFirstColumns, mixedColumns]
  apply Finset.disjoint_left.mpr
  intro c hc hd
  exact (Finset.mem_sdiff.mp hc).2 (Finset.mem_inter.mp hd).2

/-- A second-only column is never mixed. -/
theorem pureSecond_mixed_disjoint (D : Diagram)
    (I J K : ShapeIdeal D) :
    Disjoint (pureSecondColumns D I J K)
      (mixedColumns D I J K) := by
  classical
  simp only [pureSecondColumns, mixedColumns]
  apply Finset.disjoint_left.mpr
  intro c hc hd
  exact (Finset.mem_sdiff.mp hc).2 (Finset.mem_inter.mp hd).1

/-- The two-colour columns cover exactly the columns in the full interval. -/
theorem pureMixedColumns_cover (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    pureFirstColumns D I J K ∪
        pureSecondColumns D I J K ∪ mixedColumns D I J K =
      intervalColumns D I J := by
  classical
  rw [intervalColumns_split D I K J hIK hKJ]
  ext c
  simp only [Finset.mem_union, pureFirstColumns, pureSecondColumns,
    mixedColumns, Finset.mem_sdiff, Finset.mem_inter]
  tauto

/-- Exact inclusion--exclusion formula for the numbers of columns
occupied by the two colours. The overlap is the number of mixed columns. -/
theorem columnCount_twoColors_add_mixed (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    columnCount (intervalCells D I J) +
        (mixedColumns D I J K).card =
      columnCount (intervalCells D I K) +
        columnCount (intervalCells D K J) := by
  classical
  have h := Finset.card_union_add_card_inter
    (intervalColumns D I K) (intervalColumns D K J)
  rw [← intervalColumns_split D I K J hIK hKJ] at h
  simpa only [intervalColumns_card, mixedColumns] using h

/-- The two colour counts may exceed the width of the full skew shape
only by the number of mixed columns (in particular, never by more). -/
theorem columnCount_twoColors_le (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    columnCount (intervalCells D I J) ≤
      columnCount (intervalCells D I K) +
        columnCount (intervalCells D K J) := by
  have h := columnCount_twoColors_add_mixed D I K J hIK hKJ
  omega

/-- The first colour occupies its pure columns plus the mixed ones. -/
theorem firstColor_pureMixed_card (D : Diagram)
    (I J K : ShapeIdeal D) :
    (pureFirstColumns D I J K).card +
      (mixedColumns D I J K).card =
        columnCount (intervalCells D I K) := by
  classical
  exact Finset.card_sdiff_add_card_inter
    (intervalColumns D I K) (intervalColumns D K J)

/-- The second colour occupies its pure columns plus the mixed ones. -/
theorem secondColor_pureMixed_card (D : Diagram)
    (I J K : ShapeIdeal D) :
    (pureSecondColumns D I J K).card +
      (mixedColumns D I J K).card =
        columnCount (intervalCells D K J) := by
  classical
  have h := Finset.card_sdiff_add_card_inter
    (intervalColumns D K J) (intervalColumns D I K)
  simpa only [pureSecondColumns, mixedColumns,
    Finset.inter_comm, intervalColumns_card] using h

/-- A weight-preserving switch must preserve the number of mixed columns,
because the full interval width is independent of the intermediate ideal. -/
theorem columnSwitch_preserves_mixedColumns_card
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D)
    (hK : IsIntermediate D I J K) :
    (mixedColumns D I J K).card =
      (mixedColumns D I J (S.toEquiv K)).card := by
  have hK' : IsIntermediate D I J (S.toEquiv K) :=
    (S.interval_iff K).mp hK
  have h₁ := columnCount_twoColors_add_mixed D I K J hK.1 hK.2
  have h₂ := columnCount_twoColors_add_mixed D I (S.toEquiv K) J
    hK'.1 hK'.2
  have hfirst := S.first_to_second K hK
  have hsecond := S.second_to_first K hK
  omega

/-- Under a switch, the number of first-pure columns becomes the
number of second-pure columns. -/
theorem columnSwitch_pureFirst_to_pureSecond
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D)
    (hK : IsIntermediate D I J K) :
    (pureFirstColumns D I J K).card =
      (pureSecondColumns D I J (S.toEquiv K)).card := by
  have h₁ := firstColor_pureMixed_card D I J K
  have h₂ := secondColor_pureMixed_card D I J (S.toEquiv K)
  have h₃ := columnSwitch_preserves_mixedColumns_card D I J S K hK
  have h₄ := S.first_to_second K hK
  omega

/-- Under a switch, the number of second-pure columns becomes the
number of first-pure columns. -/
theorem columnSwitch_pureSecond_to_pureFirst
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D)
    (hK : IsIntermediate D I J K) :
    (pureSecondColumns D I J K).card =
      (pureFirstColumns D I J (S.toEquiv K)).card := by
  have h₁ := secondColor_pureMixed_card D I J K
  have h₂ := firstColor_pureMixed_card D I J (S.toEquiv K)
  have h₃ := columnSwitch_preserves_mixedColumns_card D I J S K hK
  have h₄ := S.second_to_first K hK
  omega

/-! ### §5.1 — Exact finite profile counts, rather than an assumed involution

These counts are finite natural numbers that can be enumerated and
independently audited. Equality under swapping the two indices is the
numerical content of the two-colour symmetry; proving it for every
skew shape is still the nontrivial universal task. -/

/-- First and second occupied-column counts attached to an intermediate ideal. -/
noncomputable def columnProfile (D : Diagram) (I J K : ShapeIdeal D) : ℕ × ℕ :=
  (columnCount (intervalCells D I K),
   columnCount (intervalCells D K J))

/-- The finite set of intermediates with an exact two-colour profile. -/
noncomputable def profileFiber (D : Diagram)
    (I J : ShapeIdeal D) (a b : ℕ) : Finset (ShapeIdeal D) := by
  classical
  exact Finset.univ.filter (fun K =>
    IsIntermediate D I J K ∧ columnProfile D I J K = (a, b))

/-- How many intermediate ideals carry this column profile. -/
noncomputable def profileCount (D : Diagram)
    (I J : ShapeIdeal D) (a b : ℕ) : ℕ :=
  (profileFiber D I J a b).card

/-- Characterization of membership in a fixed-profile fiber. -/
theorem mem_profileFiber (D : Diagram) (I J K : ShapeIdeal D)
    (a b : ℕ) :
    K ∈ profileFiber D I J a b ↔
      IsIntermediate D I J K ∧ columnProfile D I J K = (a, b) := by
  classical
  simp [profileFiber]

/-- All relevant exponents lie in the finite range 0 .. columnCount D. -/
theorem columnProfile_bounded (D : Diagram)
    (I J K : ShapeIdeal D) :
    (columnProfile D I J K).1 ≤ columnCount D ∧
      (columnProfile D I J K).2 ≤ columnCount D := by
  exact ⟨interval_columnCount_le D I K,
    interval_columnCount_le D K J⟩

/-- For a genuine intermediate, a profile (a,b) is constrained by
its number of mixed columns. This is a certificate checkable without
any generalized Bender--Knuth algorithm. -/
theorem profile_width_identity (D : Diagram)
    (I J K : ShapeIdeal D)
    (h : IsIntermediate D I J K) :
    columnCount (intervalCells D I J) +
        (mixedColumns D I J K).card =
      (columnProfile D I J K).1 + (columnProfile D I J K).2 := by
  exact columnCount_twoColors_add_mixed D I K J h.1 h.2

/-- Profile contributions are nonzero only for bounded exponents. -/
theorem profileFiber_empty_of_first_large (D : Diagram)
    (I J : ShapeIdeal D) (a b : ℕ) (ha : columnCount D < a) :
    profileFiber D I J a b = ∅ := by
  classical
  ext K
  constructor
  · intro hK
    have h := (mem_profileFiber D I J K a b).mp hK
    have hb := (columnProfile_bounded D I J K).1
    rw [h.2] at hb
    exact False.elim ((not_le_of_gt ha) hb)
  · intro hK
    simp at hK

/-- Symmetric large-index support for the second colour. -/
theorem profileFiber_empty_of_second_large (D : Diagram)
    (I J : ShapeIdeal D) (a b : ℕ) (hb : columnCount D < b) :
    profileFiber D I J a b = ∅ := by
  classical
  ext K
  constructor
  · intro hK
    have h := (mem_profileFiber D I J K a b).mp hK
    have ha := (columnProfile_bounded D I J K).2
    rw [h.2] at ha
    exact False.elim ((not_le_of_gt hb) ha)
  · intro hK
    simp at hK

/-- An actual switch gives exact equality of the profile counts.
The converse (for arbitrary finite fiber equivalences) is standard
finite-set matching, but the genuine challenge is proving the count
equalities *without assuming a switch*. -/
theorem profileCount_symmetric_of_switch
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (a b : ℕ) :
    profileCount D I J a b = profileCount D I J b a := by
  classical
  unfold profileCount
  apply Finset.card_bij (fun K _ => S.toEquiv K)
  · intro K hK
    have h := (mem_profileFiber D I J K a b).mp hK
    have h' : IsIntermediate D I J (S.toEquiv K) :=
      (S.interval_iff K).mp h.1
    apply (mem_profileFiber D I J (S.toEquiv K) b a).mpr
    refine ⟨h', ?_⟩
    have hp : columnProfile D I J K = (a, b) := h.2
    have ha : columnCount (intervalCells D I K) = a :=
      congrArg Prod.fst hp
    have hb : columnCount (intervalCells D K J) = b :=
      congrArg Prod.snd hp
    have hfirst := S.first_to_second K h.1
    have hsecond := S.second_to_first K h.1
    apply Prod.ext
    · exact hsecond.symm.trans hb
    · exact hfirst.symm.trans ha
  · intro K hK L hL he
    exact S.toEquiv.injective he
  · intro L hL
    let K := S.toEquiv.symm L
    have hK' : S.toEquiv K = L := S.toEquiv.apply_symm_apply L
    have hh := (mem_profileFiber D I J L b a).mp hL
    have hK : IsIntermediate D I J K := by
      apply (S.interval_iff K).mpr
      simpa [hK'] using hh.1
    refine ⟨K, ?_, hK'⟩
    apply (mem_profileFiber D I J K a b).mpr
    refine ⟨hK, ?_⟩
    have hp := hh.2
    have hb : columnCount (intervalCells D I L) = b :=
      congrArg Prod.fst hp
    have ha : columnCount (intervalCells D L J) = a :=
      congrArg Prod.snd hp
    have hfirst := S.first_to_second K hK
    have hsecond := S.second_to_first K hK
    rw [hK'] at hfirst hsecond
    apply Prod.ext
    · exact hfirst.trans ha
    · exact hsecond.trans hb

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — A three-state (pure-1 / pure-2 / mixed) reformulation. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Number of columns containing exclusively the first colour. -/
noncomputable def pureFirstCount (D : Diagram) (I J K : ShapeIdeal D) : ℕ :=
  (pureFirstColumns D I J K).card

/-- Number of columns containing exclusively the second colour. -/
noncomputable def pureSecondCount (D : Diagram) (I J K : ShapeIdeal D) : ℕ :=
  (pureSecondColumns D I J K).card

/-- Number of columns containing both colours. -/
noncomputable def mixedCount (D : Diagram) (I J K : ShapeIdeal D) : ℕ :=
  (mixedColumns D I J K).card

/-- Occupied first-colour columns consist of pure-first plus mixed. -/
theorem first_width_eq_pure_add_mixed
    (D : Diagram) (I J K : ShapeIdeal D) :
    columnCount (intervalCells D I K) =
      pureFirstCount D I J K + mixedCount D I J K := by
  exact (firstColor_pureMixed_card D I J K).symm

/-- Occupied second-colour columns consist of pure-second plus mixed. -/
theorem second_width_eq_pure_add_mixed
    (D : Diagram) (I J K : ShapeIdeal D) :
    columnCount (intervalCells D K J) =
      pureSecondCount D I J K + mixedCount D I J K := by
  exact (secondColor_pureMixed_card D I J K).symm

/-- The FULL width counts every column once, including mixed columns. -/
theorem interval_width_eq_three_counts
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    columnCount (intervalCells D I J) =
      pureFirstCount D I J K +
        pureSecondCount D I J K + mixedCount D I J K := by
  have h := columnCount_twoColors_add_mixed D I K J hIK hKJ
  have hfirst := first_width_eq_pure_add_mixed D I J K
  have hsecond := second_width_eq_pure_add_mixed D I J K
  simp only [mixedCount] at *
  omega

/-- In particular mixed columns cannot outnumber all columns. -/
theorem mixedCount_le_interval_width
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    mixedCount D I J K ≤ columnCount (intervalCells D I J) := by
  have h := interval_width_eq_three_counts D I K J hIK hKJ
  omega

/-- And each pure colour class is bounded by the interval width. -/
theorem pureFirstCount_le_interval_width
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    pureFirstCount D I J K ≤ columnCount (intervalCells D I J) := by
  have h := interval_width_eq_three_counts D I K J hIK hKJ
  omega

/-- Symmetric upper bound for second-only columns. -/
theorem pureSecondCount_le_interval_width
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    pureSecondCount D I J K ≤ columnCount (intervalCells D I J) := by
  have h := interval_width_eq_three_counts D I K J hIK hKJ
  omega

/-- Mixed columns are the *only* source of overcount when adding
numbers of occupied columns for the two colours. -/
theorem excess_columns_exactly_mixed
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1) :
    columnCount (intervalCells D I K) +
        columnCount (intervalCells D K J) -
          columnCount (intervalCells D I J) =
      mixedCount D I J K := by
  have h := columnCount_twoColors_add_mixed D I K J hIK hKJ
  simp only [mixedCount] at *
  omega

/-- If there are NO mixed columns, the two occupied-column sets
are disjoint, and the sum of their widths is the full width. -/
theorem width_add_of_no_mixed
    (D : Diagram) (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1)
    (hzero : mixedCount D I J K = 0) :
    columnCount (intervalCells D I K) +
        columnCount (intervalCells D K J) =
      columnCount (intervalCells D I J) := by
  have h := columnCount_twoColors_add_mixed D I K J hIK hKJ
  simp only [mixedCount] at *
  omega

/-- A mixed-column profile determines the total width. -/
theorem mixedCount_of_profile (D : Diagram)
    (I J K : ShapeIdeal D) (a b : ℕ)
    (hK : IsIntermediate D I J K)
    (hp : columnProfile D I J K = (a, b)) :
    columnCount (intervalCells D I J) + mixedCount D I J K = a + b := by
  have h := profile_width_identity D I J K hK
  rw [hp] at h
  exact h

/-- The exact weight associated with one intermediate ideal is
x^(pure first) * y^(pure second) * (xy)^(mixed).
This is the three-state decomposition of the two-colour RPP weight. -/
theorem twoColor_monomial_three_states
    (D : Diagram) (x y : ℚ) (I J K : ShapeIdeal D) :
    x ^ columnCount (intervalCells D I K) *
        y ^ columnCount (intervalCells D K J) =
      x ^ pureFirstCount D I J K *
        y ^ pureSecondCount D I J K *
          (x * y) ^ mixedCount D I J K := by
  rw [first_width_eq_pure_add_mixed D I J K,
      second_width_eq_pure_add_mixed D I J K]
  rw [pow_add, pow_add, mul_pow]
  ring

/-- The three-state monomial, extended by zero off the ideal interval. -/
noncomputable def threeStateWeight
    (D : Diagram) (x y : ℚ) (I J K : ShapeIdeal D) : ℚ := by
  classical
  exact if IsIntermediate D I J K then
    x ^ pureFirstCount D I J K *
      y ^ pureSecondCount D I J K *
        (x * y) ^ mixedCount D I J K
  else 0

/-- Algebraically, three-state weights are EXACTLY the original
column weights. This uses no commutation assumption or switch. -/
theorem twoColorWeight_eq_threeStateWeight
    (D : Diagram) (x y : ℚ) (I J K : ShapeIdeal D) :
    twoColorWeight D x y I J K =
      threeStateWeight D x y I J K := by
  classical
  unfold twoColorWeight threeStateWeight
  by_cases h : IsIntermediate D I J K
  · simp only [ite_eq_left h]
    exact twoColor_monomial_three_states D x y I J K
  · simp [h]

/-- Consequently the matrix product is an explicit three-state sum.
This is a NONCONDITIONAL exact formula, usable for any finite diagram. -/
theorem T_mul_threeState
    (D : Diagram) (x y : ℚ) (I J : ShapeIdeal D) :
    (T D x * T D y) I J =
      ∑ K : ShapeIdeal D, threeStateWeight D x y I J K := by
  rw [T_mul_twoColor D x y I J]
  apply Finset.sum_congr rfl
  intro K _
  exact twoColorWeight_eq_threeStateWeight D x y I J K

/-- The two pure-column counts are exchanged by every column switch. -/
theorem columnSwitch_pureCounts_swap
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D)
    (hK : IsIntermediate D I J K) :
    pureFirstCount D I J K = pureSecondCount D I J (S.toEquiv K) ∧
      pureSecondCount D I J K = pureFirstCount D I J (S.toEquiv K) := by
  exact ⟨columnSwitch_pureFirst_to_pureSecond D I J S K hK,
    columnSwitch_pureSecond_to_pureFirst D I J S K hK⟩

/-- The complete three-state triple is reversed at its pure-colour
coordinates and fixed at the mixed coordinate under a switch. -/
theorem columnSwitch_threeCounts_swap
    (D : Diagram) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) (K : ShapeIdeal D)
    (hK : IsIntermediate D I J K) :
    (pureFirstCount D I J (S.toEquiv K),
       pureSecondCount D I J (S.toEquiv K),
         mixedCount D I J (S.toEquiv K)) =
      (pureSecondCount D I J K,
       pureFirstCount D I J K,
         mixedCount D I J K) := by
  have hp := columnSwitch_pureCounts_swap D I J S K hK
  have hm := columnSwitch_preserves_mixedColumns_card D I J S K hK
  simp only [Prod.mk.injEq]
  exact ⟨hp.2.symm, hp.1.symm, hm.symm⟩

/-- The three-state sum shares the same conditional symmetry as the
two-colour transfer, but the relevant conserved quantities are explicit. -/
theorem threeState_sum_switched
    (D : Diagram) (x y : ℚ) (I J : ShapeIdeal D)
    (S : ColumnSwitch D I J) :
    (∑ K : ShapeIdeal D, threeStateWeight D x y I J K) =
      ∑ K : ShapeIdeal D, threeStateWeight D y x I J K := by
  classical
  simp_rw [← twoColorWeight_eq_threeStateWeight]
  exact twoColor_sum_switched D x y I J S

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — special family: diagrams with at most ONE column

This is a genuine, UNCONDITIONAL commutation result (no ColumnSwitch
hypothesis).  On a one-column diagram every nonempty ideal difference
has width exactly one, so T_x is affine in the *same* fixed strict
incidence matrix.  Affine expressions in one matrix always commute.

This is a sanity check and a boundary case of the manuscript Lemma 5.1.
It is not a proof of the general multi-column theorem. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Strict incidence matrix: its (I,J) coefficient is one precisely
when I is a PROPER subideal of J. -/
noncomputable def strictIncidence (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J => if I.1 ⊂ J.1 then 1 else 0)

/-- Its diagonal is always zero. -/
@[simp] theorem strictIncidence_diagonal (D : Diagram)
    (I : ShapeIdeal D) : strictIncidence D I I = 0 := by
  simp [strictIncidence]

/-- Exact value on properly nested ideals. -/
theorem strictIncidence_of_ssubset (D : Diagram)
    (I J : ShapeIdeal D) (h : I.1 ⊂ J.1) :
    strictIncidence D I J = 1 := by
  change (if I.1 ⊂ J.1 then (1 : ℚ) else 0) = 1
  exact ite_eq_left h

/-- Strict incidence vanishes on any pair not in strict inclusion. -/
theorem strictIncidence_of_not_ssubset (D : Diagram)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊂ J.1) :
    strictIncidence D I J = 0 := by
  change (if I.1 ⊂ J.1 then (1 : ℚ) else 0) = 0
  exact ite_eq_right h

/-- The abstract algebraic mechanism: two affine expressions in the
SAME square matrix commute, regardless of the matrix. -/
theorem affine_matrix_commutes
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (M : Matrix ι ι ℚ) (x y : ℚ) :
    (1 + x • M) * (1 + y • M) =
      (1 + y • M) * (1 + x • M) := by
  have hxy : (x • M) * (y • M) = (y • M) * (x • M) := by
    calc
      (x • M) * (y • M) = (x * y) • (M * M) := by
        rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul]
      _ = (y * x) • (M * M) := by rw [mul_comm x y]
      _ = (y • M) * (x • M) := by
        rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  simp only [add_mul, mul_add, one_mul, mul_one]
  rw [hxy]
  abel

/-- A nonempty interval in a one-column diagram has exactly one
occupied column: `0 < width` because the interval is nonempty,
and `width ≤ 1` by containment in D. -/
theorem proper_interval_width_one
    (D : Diagram) (hD : columnCount D ≤ 1)
    (I J : ShapeIdeal D) (h : I.1 ⊂ J.1) :
    columnCount (intervalCells D I J) = 1 := by
  have hle : columnCount (intervalCells D I J) ≤ 1 :=
    (interval_columnCount_le D I J).trans hD
  have hne : columnCount (intervalCells D I J) ≠ 0 := by
    intro hz
    have hrev := (interval_width_zero_iff D I J).mp hz
    exact (not_le_of_gt h) hrev
  omega

/-- On a one-column diagram, T_x is an affine expression in the
fixed strict incidence matrix, for every rational x. -/
theorem T_affine_of_one_column
    (D : Diagram) (hD : columnCount D ≤ 1) (x : ℚ) :
    T D x = 1 + x • strictIncidence D := by
  classical
  ext I J
  by_cases heq : I = J
  · subst J
    simp [strictIncidence]
  · by_cases hsub : I.1 ⊆ J.1
    · have hne : I.1 ≠ J.1 := fun h => heq (Subtype.ext h)
      have hproper : I.1 ⊂ J.1 :=
        Finset.ssubset_iff_subset_ne.mpr ⟨hsub, hne⟩
      have hw := proper_interval_width_one D hD I J hproper
      rw [T_of_subset D x I J hsub, hw]
      simp only [Matrix.add_apply, Matrix.smul_apply]
      rw [strictIncidence_of_ssubset D I J hproper]
      simp [heq]
    · have hnotproper : ¬ I.1 ⊂ J.1 := fun hh => hsub hh.subset
      rw [T_of_not_subset D x I J hsub]
      simp only [Matrix.add_apply, Matrix.smul_apply]
      rw [strictIncidence_of_not_ssubset D I J hnotproper]
      simp [heq]

/-- Lemma 5.1, one-column case: the transfer matrices commute. -/
theorem T_commute_one_column
    (D : Diagram) (hD : columnCount D ≤ 1)
    (x y : ℚ) : T D x * T D y = T D y * T D x := by
  rw [T_affine_of_one_column D hD x,
      T_affine_of_one_column D hD y]
  exact affine_matrix_commutes (strictIncidence D) x y

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Lemma 5.1: binary tableaux and column-switching symmetry

The first identity is a bijection between:

  * lower ideals K satisfying I ⊆ K ⊆ J; and
  * isotone binary tableaux on D, forced to be 0 on I and 1 off J.

Thus only the cells of the interval J \ I are free, and their colors
form a reverse plane partition with entries 0 and 1.  The two column
statistics of this tableau coincide with the original exponents in
T_x T_y.  This is the rigorous interface for the generalized
Bender--Knuth switching map. The tableau correspondence itself holds
without a skew-shape hypothesis. The later switching construction uses
the geometry of skew diagrams. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- A two-colour reverse plane partition of the interval J \ I,
represented on the fixed ambient finite cell poset.  Zero means the
first colour and one the second colour.  The prescribed values on I
and outside J ensure that exactly the cells of J \ I can vary. -/
abbrev BinaryIntervalRPP (D : Diagram) (I J : ShapeIdeal D) :=
  { f : ShapeCell D → Fin 2 //
      FinitePoset.IsIsotone f ∧
      (∀ c : ShapeCell D, c ∈ I.1 → f c = 0) ∧
      (∀ c : ShapeCell D, c ∉ J.1 → f c = 1) }

/-- The finite type of the intermediate ideals in [I,J]. -/
abbrev IntermediateIdeals (D : Diagram) (I J : ShapeIdeal D) :=
  { K : ShapeIdeal D // IsIntermediate D I J K }

noncomputable instance intermediateIdealsFintype (D : Diagram)
    (I J : ShapeIdeal D) : Fintype (IntermediateIdeals D I J) := by
  classical
  infer_instance

noncomputable instance binaryIntervalRPPFintype (D : Diagram)
    (I J : ShapeIdeal D) : Fintype (BinaryIntervalRPP D I J) := by
  classical
  infer_instance

/-- An intermediate ideal colors K by zero and its complement by one. -/
noncomputable def intermediateToRPP (D : Diagram) (I J : ShapeIdeal D)
    (K : IntermediateIdeals D I J) : BinaryIntervalRPP D I J := by
  classical
  refine ⟨FinitePoset.colorOfIdeal K.1.1,
    FinitePoset.colorOfIdeal_isIsotone K.1.1 K.1.2, ?_, ?_⟩
  · intro c hc
    have hK : c ∈ K.1.1 := K.2.1 hc
    simp [FinitePoset.colorOfIdeal, hK]
  · intro c hc
    have hK : c ∉ K.1.1 := fun h => hc (K.2.2 h)
    simp [FinitePoset.colorOfIdeal, hK]

/-- The zero-colour class of an isotone filling is an intermediate ideal. -/
noncomputable def rppToIntermediate (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : IntermediateIdeals D I J := by
  classical
  refine ⟨⟨FinitePoset.zeroSet f.1,
    FinitePoset.zeroSet_isIdeal f.1 f.2.1⟩, ?_⟩
  constructor
  · intro c hc
    have hz : f.1 c = 0 := f.2.2.1 c hc
    simpa [FinitePoset.zeroSet] using hz
  · intro c hc
    by_contra hJ
    have h1 : f.1 c = 1 := f.2.2.2 c hJ
    have h0 : f.1 c = 0 := by
      simpa [FinitePoset.zeroSet] using hc
    exact (by decide : (0 : Fin 2) ≠ 1) (h0.symm.trans h1)

/-- The intermediate-ideal / binary-RPP correspondence is a true
bijection: both inverses are proved, without counting or choice. -/
noncomputable def intermediateIdealsEquivRPP (D : Diagram)
    (I J : ShapeIdeal D) :
    IntermediateIdeals D I J ≃ BinaryIntervalRPP D I J where
  toFun := intermediateToRPP D I J
  invFun := rppToIntermediate D I J
  left_inv := by
    intro K
    apply Subtype.ext
    apply Subtype.ext
    exact FinitePoset.zeroSet_colorOfIdeal K.1.1
  right_inv := by
    intro f
    apply Subtype.ext
    exact FinitePoset.colorOfIdeal_zeroSet f.1

/-- The first-colour cells of a binary tableau, among the cells
not already fixed to the initial ideal I. -/
noncomputable def rppFirstCells (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c => c ∉ I.1 ∧ f.1 c = 0)

/-- The second-colour cells, inside the final ideal J. -/
noncomputable def rppSecondCells (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c => c ∈ J.1 ∧ f.1 c = 1)

/-- For the filling associated to K, its first-colour cells are
exactly K \ I. -/
theorem rppFirstCells_intermediate (D : Diagram)
    (I J : ShapeIdeal D) (K : IntermediateIdeals D I J) :
    rppFirstCells D I J (intermediateToRPP D I J K) =
      K.1.1 \ I.1 := by
  classical
  ext c
  change (c ∈ Finset.univ.filter
    (fun c : ShapeCell D => c ∉ I.1 ∧
      FinitePoset.colorOfIdeal K.1.1 c = 0)) ↔
        c ∈ K.1.1 \ I.1
  simp only [Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_sdiff]
  by_cases hc : c ∈ K.1.1
  · simp [FinitePoset.colorOfIdeal, hc]
  · simp [FinitePoset.colorOfIdeal, hc]

/-- The second-colour cells of the filling of K are exactly J \ K. -/
theorem rppSecondCells_intermediate (D : Diagram)
    (I J : ShapeIdeal D) (K : IntermediateIdeals D I J) :
    rppSecondCells D I J (intermediateToRPP D I J K) =
      J.1 \ K.1.1 := by
  classical
  ext c
  change (c ∈ Finset.univ.filter
    (fun c : ShapeCell D => c ∈ J.1 ∧
      FinitePoset.colorOfIdeal K.1.1 c = 1)) ↔
        c ∈ J.1 \ K.1.1
  simp only [Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_sdiff]
  by_cases hc : c ∈ K.1.1
  · simp [FinitePoset.colorOfIdeal, hc]
  · simp [FinitePoset.colorOfIdeal, hc]

/-- The occupied columns of the first colour. -/
noncomputable def rppFirstColumns (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : Finset ℕ :=
  (rppFirstCells D I J f).image (fun c : ShapeCell D => c.1.2)

/-- The occupied columns of the second colour. -/
noncomputable def rppSecondColumns (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : Finset ℕ :=
  (rppSecondCells D I J f).image (fun c : ShapeCell D => c.1.2)

/-- The first-column support in the RPP is the same column support as
in the original transfer-matrix interval I ⊆ K. -/
theorem rppFirstColumns_intermediate (D : Diagram)
    (I J : ShapeIdeal D) (K : IntermediateIdeals D I J) :
    rppFirstColumns D I J (intermediateToRPP D I J K) =
      intervalColumns D I K.1 := by
  classical
  unfold rppFirstColumns intervalColumns intervalCells
  rw [rppFirstCells_intermediate D I J K, Finset.image_image]
  rfl

/-- The analogous equality for second-colour columns. -/
theorem rppSecondColumns_intermediate (D : Diagram)
    (I J : ShapeIdeal D) (K : IntermediateIdeals D I J) :
    rppSecondColumns D I J (intermediateToRPP D I J K) =
      intervalColumns D K.1 J := by
  classical
  unfold rppSecondColumns intervalColumns intervalCells
  rw [rppSecondCells_intermediate D I J K, Finset.image_image]
  rfl

/-- The weight of a binary RPP is defined from *occupied columns*,
not from the total number of cells of either colour. -/
noncomputable def rppColumnWeight (D : Diagram) (I J : ShapeIdeal D)
    (x y : ℚ) (f : BinaryIntervalRPP D I J) : ℚ :=
  x ^ (rppFirstColumns D I J f).card *
    y ^ (rppSecondColumns D I J f).card

/-- The RPP and matrix-product monomials agree for every K. -/
theorem rppColumnWeight_intermediate (D : Diagram)
    (I J : ShapeIdeal D) (x y : ℚ)
    (K : IntermediateIdeals D I J) :
    rppColumnWeight D I J x y (intermediateToRPP D I J K) =
      x ^ columnCount (intervalCells D I K.1) *
        y ^ columnCount (intervalCells D K.1 J) := by
  rw [rppColumnWeight,
    rppFirstColumns_intermediate D I J K,
    rppSecondColumns_intermediate D I J K]
  rfl

/-- Zero/one tableaux are interchangeable with intermediate ideals
for the purposes of building a switching involution. -/
theorem rpp_equiv_intermediate_roundtrip (D : Diagram)
    (I J : ShapeIdeal D) (f : BinaryIntervalRPP D I J) :
    intermediateToRPP D I J (rppToIntermediate D I J f) = f := by
  exact (intermediateIdealsEquivRPP D I J).apply_symm_apply f

/-- Conversely, the tableau-to-ideal-to-tableau operation is also exact. -/
theorem intermediate_equiv_rpp_roundtrip (D : Diagram)
    (I J : ShapeIdeal D) (K : IntermediateIdeals D I J) :
    rppToIntermediate D I J (intermediateToRPP D I J K) = K := by
  exact (intermediateIdealsEquivRPP D I J).symm_apply_apply K

/-- Shape-independent support of the two-colour weight: a term outside
[I,J] vanishes. This permits a later RPP-only sum. -/
theorem twoColorWeight_zero_outside_interval (D : Diagram)
    (I J K : ShapeIdeal D) (x y : ℚ)
    (h : ¬ IsIntermediate D I J K) :
    twoColorWeight D x y I J K = 0 := by
  simp [twoColorWeight, h]

/-- On the interval the two-color weight is exactly the tableau weight
without any residual piecewise condition. -/
theorem twoColorWeight_as_RPP (D : Diagram)
    (I J : ShapeIdeal D) (x y : ℚ)
    (K : IntermediateIdeals D I J) :
    twoColorWeight D x y I J K.1 =
      rppColumnWeight D I J x y (intermediateToRPP D I J K) := by
  have hk : IsIntermediate D I J K.1 := K.2
  rw [rppColumnWeight_intermediate D I J x y K]
  simp [twoColorWeight, hk]


/-- The transfer-matrix product is a sum over genuine intermediate
ideals only, rather than a sum over all ideals with zero extensions. -/
theorem T_mul_intermediateIdeals (D : Diagram) (I J : ShapeIdeal D)
    (x y : ℚ) :
    (T D x * T D y) I J =
      ∑ K : IntermediateIdeals D I J,
        x ^ columnCount (intervalCells D I K.1) *
          y ^ columnCount (intervalCells D K.1 J) := by
  classical
  rw [T_mul_twoColor]
  let s : Finset (ShapeIdeal D) :=
    Finset.univ.filter (IsIntermediate D I J)
  have hsub :
      (∑ K : IntermediateIdeals D I J,
        x ^ columnCount (intervalCells D I K.1) *
          y ^ columnCount (intervalCells D K.1 J)) =
        ∑ K ∈ s,
          x ^ columnCount (intervalCells D I K) *
            y ^ columnCount (intervalCells D K J) := by
    symm
    exact Finset.sum_subtype s
      (fun K => by simp [s])
      (fun K => x ^ columnCount (intervalCells D I K) *
        y ^ columnCount (intervalCells D K J))
  rw [hsub]
  dsimp [s]
  simp only [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro K _
  unfold twoColorWeight
  by_cases hk : IsIntermediate D I J K
  · simp [hk]
  · simp [hk]

/-- Lemma 5.1: exact two-color reverse plane partition expansion.
This is a genuine unconditional theorem about matrix coefficients.
Symmetry in x and y is established separately below. -/
theorem T_mul_as_binaryRPP_sum (D : Diagram) (I J : ShapeIdeal D)
    (x y : ℚ) :
    (T D x * T D y) I J =
      ∑ f : BinaryIntervalRPP D I J, rppColumnWeight D I J x y f := by
  rw [T_mul_intermediateIdeals D I J x y]
  exact Fintype.sum_equiv (intermediateIdealsEquivRPP D I J)
    (fun K =>
      x ^ columnCount (intervalCells D I K.1) *
        y ^ columnCount (intervalCells D K.1 J))
    (fun f => rppColumnWeight D I J x y f)
    (by
      intro K
      exact (rppColumnWeight_intermediate D I J x y K).symm)


/-! ### §5.1 — Clean interface to switching binary reverse plane partitions

The next structure states exactly the data to construct by the
Galashin--Grinberg--Liu algorithm.  Unlike `ColumnSwitch`, it acts ONLY
on the genuine tableaux of [I,J]; no artificial extension to all
shape ideals is needed.  The theorem below derives Lemma 5.1 from
such switches.  It does NOT construct the switches. -/

/-- A column-weight exchanging equivalence of binary reverse plane
partitions on one specified interval. -/
structure BinaryRPPColumnSwitch (D : Diagram) (I J : ShapeIdeal D) where
  toEquiv : BinaryIntervalRPP D I J ≃ BinaryIntervalRPP D I J
  first_to_second : ∀ f : BinaryIntervalRPP D I J,
    (rppFirstColumns D I J f).card =
      (rppSecondColumns D I J (toEquiv f)).card
  second_to_first : ∀ f : BinaryIntervalRPP D I J,
    (rppSecondColumns D I J f).card =
      (rppFirstColumns D I J (toEquiv f)).card

/-- A switch exchanges the two weights, on individual tableaux. -/
theorem rppColumnWeight_switched (D : Diagram) (I J : ShapeIdeal D)
    (S : BinaryRPPColumnSwitch D I J) (x y : ℚ)
    (f : BinaryIntervalRPP D I J) :
    rppColumnWeight D I J x y f =
      rppColumnWeight D I J y x (S.toEquiv f) := by
  unfold rppColumnWeight
  rw [S.first_to_second f, S.second_to_first f]
  exact mul_comm _ _

/-- A weight-switching equivalence makes the two-colour RPP
enumerator symmetric, by an actual reindexing of a finite sum. -/
theorem rppColumnSum_switched (D : Diagram) (I J : ShapeIdeal D)
    (S : BinaryRPPColumnSwitch D I J) (x y : ℚ) :
    (∑ f : BinaryIntervalRPP D I J, rppColumnWeight D I J x y f) =
      ∑ f : BinaryIntervalRPP D I J, rppColumnWeight D I J y x f := by
  classical
  exact Fintype.sum_equiv S.toEquiv
    (fun f => rppColumnWeight D I J x y f)
    (fun f => rppColumnWeight D I J y x f)
    (rppColumnWeight_switched D I J S x y)

/-- Lemma 5.1: commutation from the existence of binary tableau switches.
An explicit construction below establishes the required hypothesis. -/
theorem T_commute_of_binaryRPPSwitches (D : Diagram)
    (hSwitch : ∀ I J : ShapeIdeal D,
      Nonempty (BinaryRPPColumnSwitch D I J))
    (x y : ℚ) : T D x * T D y = T D y * T D x := by
  classical
  ext I J
  obtain ⟨S⟩ := hSwitch I J
  calc
    (T D x * T D y) I J =
        ∑ f : BinaryIntervalRPP D I J,
          rppColumnWeight D I J x y f :=
      T_mul_as_binaryRPP_sum D I J x y
    _ = ∑ f : BinaryIntervalRPP D I J,
          rppColumnWeight D I J y x f :=
      rppColumnSum_switched D I J S x y
    _ = (T D y * T D x) I J :=
      (T_mul_as_binaryRPP_sum D I J y x).symm

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Lemma 5.1: Generalized Bender--Knuth: pure-column flip. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- A column consists entirely of zeros.  The condition is applied
only at a column containing the distinguished cell `c`. -/
def IsPureZeroColumn {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) : Prop :=
  ∀ d : ShapeCell D, d.1.2 = c.1.2 → f d = 0

/-- A column consists entirely of ones. -/
def IsPureOneColumn {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) : Prop :=
  ∀ d : ShapeCell D, d.1.2 = c.1.2 → f d = 1

/-- Column purity is invariant under changing the distinguished
cell within the same column. -/
theorem pureZero_transport {D : Diagram}
    (f : ShapeCell D → Fin 2) {c d : ShapeCell D}
    (h : d.1.2 = c.1.2) :
    IsPureZeroColumn f c ↔ IsPureZeroColumn f d := by
  constructor
  · intro hc e he
    exact hc e (he.trans h)
  · intro hd e he
    exact hd e (he.trans h.symm)

/-- The same invariance for a pure-one column. -/
theorem pureOne_transport {D : Diagram}
    (f : ShapeCell D → Fin 2) {c d : ShapeCell D}
    (h : d.1.2 = c.1.2) :
    IsPureOneColumn f c ↔ IsPureOneColumn f d := by
  constructor
  · intro hc e he
    exact hc e (he.trans h)
  · intro hd e he
    exact hd e (he.trans h.symm)

/-- A nonempty column cannot consist entirely of both values. -/
theorem pureZero_pureOne_false {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h0 : IsPureZeroColumn f c)
    (h1 : IsPureOneColumn f c) : False := by
  have hz : f c = 0 := h0 c rfl
  have ho : f c = 1 := h1 c rfl
  exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)

/-- The raw flip, defined on arbitrary binary fillings.  It exchanges
pure zero and pure one columns and keeps mixed columns fixed. -/
noncomputable def flipPureColumns (D : Diagram)
    (f : ShapeCell D → Fin 2) : ShapeCell D → Fin 2 := by
  classical
  exact fun c =>
    if IsPureZeroColumn f c then 1
    else if IsPureOneColumn f c then 0
    else f c

/-- A pure-zero column becomes a pure-one column, pointwise. -/
theorem flipPureColumns_zero {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h : IsPureZeroColumn f c) :
    flipPureColumns D f c = 1 := by
  simp [flipPureColumns, h]

/-- A pure-one column becomes a pure-zero column, pointwise. -/
theorem flipPureColumns_one {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h : IsPureOneColumn f c) :
    flipPureColumns D f c = 0 := by
  have hn : ¬ IsPureZeroColumn f c := by
    intro h0
    exact pureZero_pureOne_false f c h0 h
  simp [flipPureColumns, hn, h]

/-- A mixed column keeps all its entries. -/
theorem flipPureColumns_mixed {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h0 : ¬ IsPureZeroColumn f c)
    (h1 : ¬ IsPureOneColumn f c) :
    flipPureColumns D f c = f c := by
  simp [flipPureColumns, h0, h1]

/-- Flipping a pure-zero column produces a pure-one column. -/
theorem flipPureColumns_pureOne_of_pureZero {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h : IsPureZeroColumn f c) :
    IsPureOneColumn (flipPureColumns D f) c := by
  intro d hd
  have hd0 : IsPureZeroColumn f d :=
    (pureZero_transport f hd).mp h
  exact flipPureColumns_zero f d hd0

/-- Flipping a pure-one column produces a pure-zero column. -/
theorem flipPureColumns_pureZero_of_pureOne {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (h : IsPureOneColumn f c) :
    IsPureZeroColumn (flipPureColumns D f) c := by
  intro d hd
  have hd1 : IsPureOneColumn f d :=
    (pureOne_transport f hd).mp h
  exact flipPureColumns_one f d hd1

/-- The raw flip is unchanged everywhere in a mixed column. -/
theorem flipPureColumns_mixed_column {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D)
    (hn0 : ¬ IsPureZeroColumn f c)
    (hn1 : ¬ IsPureOneColumn f c)
    (d : ShapeCell D) (hd : d.1.2 = c.1.2) :
    flipPureColumns D f d = f d := by
  have hn0d : ¬ IsPureZeroColumn f d := by
    intro h0d
    exact hn0 ((pureZero_transport f hd).mpr h0d)
  have hn1d : ¬ IsPureOneColumn f d := by
    intro h1d
    exact hn1 ((pureOne_transport f hd).mpr h1d)
  exact flipPureColumns_mixed f d hn0d hn1d

/-- The raw pure-column flip is an involution, including mixed columns. -/
theorem flipPureColumns_involutive (D : Diagram)
    (f : ShapeCell D → Fin 2) :
    flipPureColumns D (flipPureColumns D f) = f := by
  funext c
  by_cases h0 : IsPureZeroColumn f c
  · have h1' := flipPureColumns_pureOne_of_pureZero f c h0
    calc
      flipPureColumns D (flipPureColumns D f) c = 0 :=
        flipPureColumns_one (flipPureColumns D f) c h1'
      _ = f c := (h0 c rfl).symm
  · by_cases h1 : IsPureOneColumn f c
    · have h0' := flipPureColumns_pureZero_of_pureOne f c h1
      calc
        flipPureColumns D (flipPureColumns D f) c = 1 :=
          flipPureColumns_zero (flipPureColumns D f) c h0'
        _ = f c := (h1 c rfl).symm
    · have hstay : ∀ d : ShapeCell D, d.1.2 = c.1.2 →
          flipPureColumns D f d = f d :=
        flipPureColumns_mixed_column f c h0 h1
      have h0' : ¬ IsPureZeroColumn (flipPureColumns D f) c := by
        intro hz
        apply h0
        intro d hd
        exact (hstay d hd).symm.trans (hz d hd)
      have h1' : ¬ IsPureOneColumn (flipPureColumns D f) c := by
        intro ho
        apply h1
        intro d hd
        exact (hstay d hd).symm.trans (ho d hd)
      exact (flipPureColumns_mixed (flipPureColumns D f) c h0' h1').trans
        (hstay c rfl)

/-- The pure-column flip is a genuine equivalence on all binary fillings.
It is not, by itself, a map on binary reverse plane partitions. -/
noncomputable def flipPureColumnsEquiv (D : Diagram) :
    (ShapeCell D → Fin 2) ≃ (ShapeCell D → Fin 2) where
  toFun := flipPureColumns D
  invFun := flipPureColumns D
  left_inv := flipPureColumns_involutive D
  right_inv := flipPureColumns_involutive D

/-- Vertical isotonicity: values are weakly increasing down columns. -/
def VerticalBinaryIsotone (D : Diagram)
    (f : ShapeCell D → Fin 2) : Prop :=
  ∀ c d : ShapeCell D,
    c.1.2 = d.1.2 → c.1.1 ≤ d.1.1 → f c ≤ f d

/-- Columnwise weak increase survives the pure-column flip. -/
theorem flipPureColumns_vertical (D : Diagram)
    (f : ShapeCell D → Fin 2) (hf : VerticalBinaryIsotone D f) :
    VerticalBinaryIsotone D (flipPureColumns D f) := by
  intro c d hcol hrow
  by_cases h0 : IsPureZeroColumn f c
  · have hd0 : IsPureZeroColumn f d :=
      (pureZero_transport f hcol.symm).mp h0
    rw [flipPureColumns_zero f c h0, flipPureColumns_zero f d hd0]
  · by_cases h1 : IsPureOneColumn f c
    · have hd1 : IsPureOneColumn f d :=
        (pureOne_transport f hcol.symm).mp h1
      rw [flipPureColumns_one f c h1, flipPureColumns_one f d hd1]
    · rw [flipPureColumns_mixed f c h0 h1,
          flipPureColumns_mixed_column f c h0 h1 d hcol.symm]
      exact hf c d hcol hrow

/-- Weakly column-monotone binary fillings, with no row constraint. -/
abbrev VerticalBinaryTable (D : Diagram) :=
  { f : ShapeCell D → Fin 2 // VerticalBinaryIsotone D f }

/-- The pure-column flip is an involution on column-monotone tables. -/
noncomputable def flipVerticalBinaryTable (D : Diagram) :
    VerticalBinaryTable D ≃ VerticalBinaryTable D where
  toFun f := ⟨flipPureColumns D f.1, flipPureColumns_vertical D f.1 f.2⟩
  invFun f := ⟨flipPureColumns D f.1, flipPureColumns_vertical D f.1 f.2⟩
  left_inv := by
    intro f
    apply Subtype.ext
    exact congrArg (fun g => g) (flipPureColumns_involutive D f.1)
  right_inv := by
    intro f
    apply Subtype.ext
    exact flipPureColumns_involutive D f.1


/-! ### §5.1 — Exchange of the two column-support statistics. -/

/-- A zero appears in the column of `c`. -/
def HasZeroInColumn {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) : Prop :=
  ∃ d : ShapeCell D, d.1.2 = c.1.2 ∧ f d = 0

/-- A one appears in the column of `c`. -/
def HasOneInColumn {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) : Prop :=
  ∃ d : ShapeCell D, d.1.2 = c.1.2 ∧ f d = 1

/-- Every element of `Fin 2` is either zero or one. -/
theorem finTwo_zero_or_one (v : Fin 2) : v = 0 ∨ v = 1 := by
  fin_cases v <;> simp

/-- Not being pure zero means that a one occurs in the column. -/
theorem not_pureZero_iff_hasOne {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) :
    ¬ IsPureZeroColumn f c ↔ HasOneInColumn f c := by
  classical
  constructor
  · intro h
    by_contra hn
    apply h
    intro d hd
    rcases finTwo_zero_or_one (f d) with hz | ho
    · exact hz
    · exact False.elim (hn ⟨d, hd, ho⟩)
  · rintro ⟨d, hd, ho⟩ hp
    have hz := hp d hd
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)

/-- Not being pure one means that a zero occurs in the column. -/
theorem not_pureOne_iff_hasZero {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) :
    ¬ IsPureOneColumn f c ↔ HasZeroInColumn f c := by
  classical
  constructor
  · intro h
    by_contra hn
    apply h
    intro d hd
    rcases finTwo_zero_or_one (f d) with hz | ho
    · exact False.elim (hn ⟨d, hd, hz⟩)
    · exact ho
  · rintro ⟨d, hd, hz⟩ hp
    have ho := hp d hd
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)

/-- A zero appears in a column after flipping if and only if a one
appeared in that column before flipping.  In mixed columns the actual
entries do not move; in pure columns all entries change colour. -/
theorem hasZero_flip_iff_hasOne {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) :
    HasZeroInColumn (flipPureColumns D f) c ↔ HasOneInColumn f c := by
  by_cases h0 : IsPureZeroColumn f c
  · have hn1 : ¬ HasOneInColumn f c :=
      (not_pureZero_iff_hasOne f c).not.mp (not_not.mpr h0)
    have hflip1 := flipPureColumns_pureOne_of_pureZero f c h0
    have hn0 : ¬ HasZeroInColumn (flipPureColumns D f) c := by
      rintro ⟨d, hd, hz⟩
      have ho := hflip1 d hd
      exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
    exact ⟨fun h => False.elim (hn0 h), fun h => False.elim (hn1 h)⟩
  · by_cases h1 : IsPureOneColumn f c
    · have ho : HasOneInColumn f c := ⟨c, rfl, h1 c rfl⟩
      have hz : HasZeroInColumn (flipPureColumns D f) c :=
        ⟨c, rfl, flipPureColumns_one f c h1⟩
      exact ⟨fun _ => ho, fun _ => hz⟩
    · have ho : HasOneInColumn f c :=
        (not_pureZero_iff_hasOne f c).mp h0
      have hz : HasZeroInColumn f c :=
        (not_pureOne_iff_hasZero f c).mp h1
      obtain ⟨d, hd, hdz⟩ := hz
      have hflip : HasZeroInColumn (flipPureColumns D f) c :=
        ⟨d, hd, (flipPureColumns_mixed_column f c h0 h1 d hd).trans hdz⟩
      exact ⟨fun _ => ho, fun _ => hflip⟩

/-- The other column-support exchange follows from involutivity. -/
theorem hasOne_flip_iff_hasZero {D : Diagram}
    (f : ShapeCell D → Fin 2) (c : ShapeCell D) :
    HasOneInColumn (flipPureColumns D f) c ↔ HasZeroInColumn f c := by
  have h := hasZero_flip_iff_hasOne (flipPureColumns D f) c
  rw [flipPureColumns_involutive D f] at h
  exact h.symm

/-- The set of occupied zero-columns of an arbitrary binary filling. -/
noncomputable def rawZeroColumns (D : Diagram)
    (f : ShapeCell D → Fin 2) : Finset ℕ := by
  classical
  exact (Finset.univ.filter (fun c : ShapeCell D => f c = 0)).image
    (fun c : ShapeCell D => c.1.2)

/-- The set of occupied one-columns of an arbitrary binary filling. -/
noncomputable def rawOneColumns (D : Diagram)
    (f : ShapeCell D → Fin 2) : Finset ℕ := by
  classical
  exact (Finset.univ.filter (fun c : ShapeCell D => f c = 1)).image
    (fun c : ShapeCell D => c.1.2)

/-- Membership in the zero-column support is existential. -/
theorem mem_rawZeroColumns {D : Diagram}
    (f : ShapeCell D → Fin 2) (j : ℕ) :
    j ∈ rawZeroColumns D f ↔
      ∃ c : ShapeCell D, c.1.2 = j ∧ f c = 0 := by
  classical
  simp only [rawZeroColumns, Finset.mem_image,
    Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨c, hz, hc⟩
    exact ⟨c, hc, hz⟩
  · rintro ⟨c, hc, hz⟩
    exact ⟨c, hz, hc⟩

/-- Membership in the one-column support is existential. -/
theorem mem_rawOneColumns {D : Diagram}
    (f : ShapeCell D → Fin 2) (j : ℕ) :
    j ∈ rawOneColumns D f ↔
      ∃ c : ShapeCell D, c.1.2 = j ∧ f c = 1 := by
  classical
  simp only [rawOneColumns, Finset.mem_image,
    Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨c, ho, hc⟩
    exact ⟨c, hc, ho⟩
  · rintro ⟨c, hc, ho⟩
    exact ⟨c, ho, hc⟩

/-- The two sets of occupied columns are interchanged by the raw flip. -/
theorem rawZeroColumns_flip_eq_rawOneColumns (D : Diagram)
    (f : ShapeCell D → Fin 2) :
    rawZeroColumns D (flipPureColumns D f) = rawOneColumns D f := by
  classical
  ext j
  rw [mem_rawZeroColumns, mem_rawOneColumns]
  constructor
  · rintro ⟨c, hc, hz⟩
    have hh : HasZeroInColumn (flipPureColumns D f) c := ⟨c, rfl, hz⟩
    obtain ⟨d, hd, ho⟩ := (hasZero_flip_iff_hasOne f c).mp hh
    exact ⟨d, hd.trans hc, ho⟩
  · rintro ⟨c, hc, ho⟩
    have hh : HasOneInColumn f c := ⟨c, rfl, ho⟩
    obtain ⟨d, hd, hz⟩ := (hasZero_flip_iff_hasOne f c).mpr hh
    exact ⟨d, hd.trans hc, hz⟩

/-- Symmetric exchange of the occupied one-column set. -/
theorem rawOneColumns_flip_eq_rawZeroColumns (D : Diagram)
    (f : ShapeCell D → Fin 2) :
    rawOneColumns D (flipPureColumns D f) = rawZeroColumns D f := by
  have h := rawZeroColumns_flip_eq_rawOneColumns D (flipPureColumns D f)
  rw [flipPureColumns_involutive D f] at h
  exact h.symm

/-- Both column-count weights swap simultaneously. -/
theorem flipPureColumns_swaps_columnCounts (D : Diagram)
    (f : ShapeCell D → Fin 2) :
    (rawZeroColumns D (flipPureColumns D f)).card =
      (rawOneColumns D f).card ∧
    (rawOneColumns D (flipPureColumns D f)).card =
      (rawZeroColumns D f).card := by
  constructor
  · rw [rawZeroColumns_flip_eq_rawOneColumns]
  · rw [rawOneColumns_flip_eq_rawZeroColumns]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Interval-wise column transformations. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.1 — Interval-wise column transformations. -/

/-- The precise finite cell set on which the 0/1 switching acts. -/
noncomputable abbrev MovingShape (D : Diagram) (I J : ShapeIdeal D) : Diagram :=
  intervalCells D I J

/-- Raw binary tables on only the moving cells of [I,J]. -/
abbrev MovingFilling (D : Diagram) (I J : ShapeIdeal D) :=
  ShapeCell (MovingShape D I J) → Fin 2

/-- Reinsert a moving cell into the ambient diagram. -/
def movingCellToAmbient (D : Diagram) (I J : ShapeIdeal D)
    (c : ShapeCell (MovingShape D I J)) : ShapeCell D :=
  ⟨c.1, intervalCells_subset_diagram D I J c.2⟩

/-- The moving-cell embedding preserves both coordinates. -/
@[simp] theorem movingCellToAmbient_val (D : Diagram)
    (I J : ShapeIdeal D) (c : ShapeCell (MovingShape D I J)) :
    (movingCellToAmbient D I J c).1 = c.1 := rfl

/-- An ambient cell lies in the moving diagram iff it lies in J but not I. -/
theorem moving_cell_mem_iff (D : Diagram) (I J : ShapeIdeal D)
    (c : ShapeCell D) :
    c.1 ∈ MovingShape D I J ↔ c ∈ J.1 ∧ c ∉ I.1 := by
  classical
  constructor
  · intro hc
    change c.1 ∈ (J.1 \ I.1).image (fun a : ShapeCell D => a.1) at hc
    rcases Finset.mem_image.mp hc with ⟨a, ha, hac⟩
    have heq : a = c := Subtype.ext hac
    subst a
    exact Finset.mem_sdiff.mp ha
  · intro hc
    change c.1 ∈ (J.1 \ I.1).image (fun a : ShapeCell D => a.1)
    exact Finset.mem_image.mpr ⟨c, Finset.mem_sdiff.mpr hc, rfl⟩

/-- Forget the frozen 0's on I and the frozen 1's outside J. -/
def rppMovingFilling (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) : MovingFilling D I J :=
  fun c => f.1 (movingCellToAmbient D I J c)

/-- Restricting a genuine binary RPP preserves vertical weak increase. -/
theorem rppMovingFilling_vertical (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) :
    VerticalBinaryIsotone (MovingShape D I J) (rppMovingFilling D I J f) := by
  intro c d hcol hrow
  have hle : movingCellToAmbient D I J c ≤ movingCellToAmbient D I J d := by
    change c.1.1 ≤ d.1.1 ∧ c.1.2 ≤ d.1.2
    exact ⟨hrow, le_of_eq hcol⟩
  exact f.2.1 hle

/-- The moving filling has the correct zero-column support. -/
theorem moving_zeroColumns_eq_first (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) :
    rawZeroColumns (MovingShape D I J) (rppMovingFilling D I J f) =
      rppFirstColumns D I J f := by
  classical
  ext k
  rw [mem_rawZeroColumns]
  change (∃ c : ShapeCell (MovingShape D I J),
    c.1.2 = k ∧ f.1 (movingCellToAmbient D I J c) = 0) ↔
    k ∈ (rppFirstCells D I J f).image (fun a : ShapeCell D => a.1.2)
  simp only [Finset.mem_image, rppFirstCells, Finset.mem_filter,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨c, hc, hz⟩
    let a := movingCellToAmbient D I J c
    have hmem : a ∈ J.1 ∧ a ∉ I.1 :=
      (moving_cell_mem_iff D I J a).mp c.2
    exact ⟨a, ⟨hmem.2, hz⟩, hc⟩
  · rintro ⟨a, ⟨haI, hz⟩, hak⟩
    have haJ : a ∈ J.1 := by
      by_contra hnJ
      have ho : f.1 a = 1 := f.2.2.2 a hnJ
      exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
    let c : ShapeCell (MovingShape D I J) :=
      ⟨a.1, (moving_cell_mem_iff D I J a).mpr ⟨haJ, haI⟩⟩
    exact ⟨c, hak, hz⟩

/-- And its one-column support is exactly the second-colour support. -/
theorem moving_oneColumns_eq_second (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) :
    rawOneColumns (MovingShape D I J) (rppMovingFilling D I J f) =
      rppSecondColumns D I J f := by
  classical
  ext k
  rw [mem_rawOneColumns]
  change (∃ c : ShapeCell (MovingShape D I J),
    c.1.2 = k ∧ f.1 (movingCellToAmbient D I J c) = 1) ↔
    k ∈ (rppSecondCells D I J f).image (fun a : ShapeCell D => a.1.2)
  simp only [Finset.mem_image, rppSecondCells, Finset.mem_filter,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨c, hc, ho⟩
    let a := movingCellToAmbient D I J c
    have hmem : a ∈ J.1 ∧ a ∉ I.1 :=
      (moving_cell_mem_iff D I J a).mp c.2
    exact ⟨a, ⟨hmem.1, ho⟩, hc⟩
  · rintro ⟨a, ⟨haJ, ho⟩, hak⟩
    have haI : a ∉ I.1 := by
      intro hI
      have hz : f.1 a = 0 := f.2.2.1 a hI
      exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
    let c : ShapeCell (MovingShape D I J) :=
      ⟨a.1, (moving_cell_mem_iff D I J a).mpr ⟨haJ, haI⟩⟩
    exact ⟨c, hak, ho⟩

/-- The initial pure-column flip, now on exactly J \ I. -/
noncomputable def flipMovingFilling (D : Diagram) (I J : ShapeIdeal D)
    (f : MovingFilling D I J) : MovingFilling D I J :=
  flipPureColumns (MovingShape D I J) f

/-- The interval flip is an involution, with no ambient-cell artifacts. -/
theorem flipMovingFilling_involutive (D : Diagram) (I J : ShapeIdeal D)
    (f : MovingFilling D I J) :
    flipMovingFilling D I J (flipMovingFilling D I J f) = f :=
  flipPureColumns_involutive (MovingShape D I J) f

/-- It preserves vertical monotonicity on the moving shape. -/
theorem flipMovingFilling_vertical (D : Diagram) (I J : ShapeIdeal D)
    (f : MovingFilling D I J)
    (hf : VerticalBinaryIsotone (MovingShape D I J) f) :
    VerticalBinaryIsotone (MovingShape D I J)
      (flipMovingFilling D I J f) :=
  flipPureColumns_vertical (MovingShape D I J) f hf

/-- Its occupied zero-columns are exactly the former one-columns. -/
theorem flipMovingFilling_zeroColumns (D : Diagram) (I J : ShapeIdeal D)
    (f : MovingFilling D I J) :
    rawZeroColumns (MovingShape D I J) (flipMovingFilling D I J f) =
      rawOneColumns (MovingShape D I J) f :=
  rawZeroColumns_flip_eq_rawOneColumns (MovingShape D I J) f

/-- Its occupied one-columns are exactly the former zero-columns. -/
theorem flipMovingFilling_oneColumns (D : Diagram) (I J : ShapeIdeal D)
    (f : MovingFilling D I J) :
    rawOneColumns (MovingShape D I J) (flipMovingFilling D I J f) =
      rawZeroColumns (MovingShape D I J) f :=
  rawOneColumns_flip_eq_rawZeroColumns (MovingShape D I J) f

/-- The crucial weight exchange, stated on the genuine tableau interval.
Horizontal row monotonicity is NOT claimed for the flipped table. -/
theorem flipMovingFilling_weight_exchange (D : Diagram)
    (I J : ShapeIdeal D) (f : BinaryIntervalRPP D I J) (x y : ℚ) :
    x ^ (rawZeroColumns (MovingShape D I J)
      (flipMovingFilling D I J (rppMovingFilling D I J f))).card *
    y ^ (rawOneColumns (MovingShape D I J)
      (flipMovingFilling D I J (rppMovingFilling D I J f))).card =
      rppColumnWeight D I J y x f := by
  rw [flipMovingFilling_zeroColumns, flipMovingFilling_oneColumns,
    moving_zeroColumns_eq_first, moving_oneColumns_eq_second]
  unfold rppColumnWeight
  exact mul_comm _ _

/-! ### §5.1 — Elementary column moves. -/

/-- Every vertical column of an allowable binary table has form
0,...,0,1,...,1. This bit is the value at a given row with cut s. -/
def cutBit (s row : ℕ) : Fin 2 := if row < s then 0 else 1

/-- A cut column is weakly increasing from top to bottom. -/
theorem cutBit_mono (s a b : ℕ) (h : a ≤ b) :
    cutBit s a ≤ cutBit s b := by
  by_cases ha : a < s
  · by_cases hb : b < s
    · simp [cutBit, ha, hb]
    · simp [cutBit, ha, hb]
  · have hb : ¬ b < s := by omega
    simp [cutBit, ha, hb]

/-- Modify precisely the columns k and k+1 of a raw binary table. -/
def replaceAdjacentColumns (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ) :
    ShapeCell B → Fin 2 :=
  fun c => if c.1.2 = k then left c
    else if c.1.2 = k + 1 then right c else f c

/-- No cell outside the adjacent pair is changed. -/
theorem replaceAdjacentColumns_outside (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ)
    (c : ShapeCell B) (hk : c.1.2 ≠ k) (hk1 : c.1.2 ≠ k + 1) :
    replaceAdjacentColumns B f left right k c = f c := by
  simp [replaceAdjacentColumns, hk, hk1]

/-- The new value in the left affected column is given by `left`. -/
theorem replaceAdjacentColumns_left (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ)
    (c : ShapeCell B) (hk : c.1.2 = k) :
    replaceAdjacentColumns B f left right k c = left c := by
  simp [replaceAdjacentColumns, hk]

/-- The new value in the right affected column is given by `right`. -/
theorem replaceAdjacentColumns_right (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ)
    (c : ShapeCell B) (hk : c.1.2 = k + 1) :
    replaceAdjacentColumns B f left right k c = right c := by
  have hn : c.1.2 ≠ k := by omega
  simp [replaceAdjacentColumns, hk]

/-- Vertical monotonicity is preserved by a replacement whose two
new column functions are themselves vertically monotone. -/
theorem replaceAdjacentColumns_vertical (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ)
    (hf : VerticalBinaryIsotone B f)
    (hl : VerticalBinaryIsotone B left)
    (hr : VerticalBinaryIsotone B right) :
    VerticalBinaryIsotone B (replaceAdjacentColumns B f left right k) := by
  intro c d hcol hrow
  by_cases hc : c.1.2 = k
  · have hd : d.1.2 = k := hcol.symm.trans hc
    rw [replaceAdjacentColumns_left B f left right k c hc,
      replaceAdjacentColumns_left B f left right k d hd]
    exact hl c d hcol hrow
  · by_cases hc1 : c.1.2 = k + 1
    · have hd1 : d.1.2 = k + 1 := hcol.symm.trans hc1
      rw [replaceAdjacentColumns_right B f left right k c hc1,
        replaceAdjacentColumns_right B f left right k d hd1]
      exact hr c d hcol hrow
    · have hd : d.1.2 ≠ k := by
        intro he
        exact hc (hcol.trans he)
      have hd1 : d.1.2 ≠ k + 1 := by
        intro he
        exact hc1 (hcol.trans he)
      rw [replaceAdjacentColumns_outside B f left right k c hc hc1,
        replaceAdjacentColumns_outside B f left right k d hd hd1]
      exact hf c d hcol hrow

/-- Published rule (M1): mixed left column, pure-zero right column.
At threshold s, the left column becomes zero-pure and the right column
gets the mixed profile with separator s. -/
def resolveM1 (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) : ShapeCell B → Fin 2 :=
  replaceAdjacentColumns B f (fun _ => 0) (fun c => cutBit s c.1.1) k

/-- Published rule (2M): pure-one left, mixed right. -/
def resolve2M (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) : ShapeCell B → Fin 2 :=
  replaceAdjacentColumns B f (fun c => cutBit s c.1.1) (fun _ => 1) k

/-- Published rule (21): pure-one left, pure-zero right. -/
def resolve21 (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) : ShapeCell B → Fin 2 :=
  replaceAdjacentColumns B f (fun _ => 0) (fun _ => 1) k

/-- The M1 move keeps every column vertically weakly increasing. -/
theorem resolveM1_vertical (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (hf : VerticalBinaryIsotone B f) :
    VerticalBinaryIsotone B (resolveM1 B f k s) := by
  unfold resolveM1
  apply replaceAdjacentColumns_vertical B f (fun _ => 0)
    (fun c => cutBit s c.1.1) k hf
  · intro c d _ _
    simp
  · intro c d _ hrow
    exact cutBit_mono s c.1.1 d.1.1 hrow

/-- The 2M move keeps every column vertically weakly increasing. -/
theorem resolve2M_vertical (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (hf : VerticalBinaryIsotone B f) :
    VerticalBinaryIsotone B (resolve2M B f k s) := by
  unfold resolve2M
  apply replaceAdjacentColumns_vertical B f
    (fun c => cutBit s c.1.1) (fun _ => 1) k hf
  · intro c d _ hrow
    exact cutBit_mono s c.1.1 d.1.1 hrow
  · intro c d _ _
    simp

/-- The 21 move keeps every column vertically weakly increasing. -/
theorem resolve21_vertical (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) (hf : VerticalBinaryIsotone B f) :
    VerticalBinaryIsotone B (resolve21 B f k) := by
  unfold resolve21
  apply replaceAdjacentColumns_vertical B f (fun _ => 0) (fun _ => 1) k hf
  · intro c d _ _
    simp
  · intro c d _ _
    simp

/-- All three resolution rules leave every column outside k,k+1 fixed. -/
theorem resolveM1_outside (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B)
    (hk : c.1.2 ≠ k) (hk1 : c.1.2 ≠ k + 1) :
    resolveM1 B f k s c = f c :=
  replaceAdjacentColumns_outside B f (fun _ => 0)
    (fun c => cutBit s c.1.1) k c hk hk1

theorem resolve2M_outside (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B)
    (hk : c.1.2 ≠ k) (hk1 : c.1.2 ≠ k + 1) :
    resolve2M B f k s c = f c :=
  replaceAdjacentColumns_outside B f
    (fun c => cutBit s c.1.1) (fun _ => 1) k c hk hk1

theorem resolve21_outside (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) (c : ShapeCell B)
    (hk : c.1.2 ≠ k) (hk1 : c.1.2 ≠ k + 1) :
    resolve21 B f k c = f c :=
  replaceAdjacentColumns_outside B f (fun _ => 0) (fun _ => 1) k c hk hk1

/-- A descent between two adjacent columns at a common row. -/
def HasBinaryDescent (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) : Prop :=
  ∃ c d : ShapeCell B,
    c.1.1 = d.1.1 ∧ c.1.2 = k ∧ d.1.2 = k + 1 ∧
      f c = 1 ∧ f d = 0

/-- After M1 the affected pair can no longer contain a row descent. -/
theorem resolveM1_no_descent (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) : ¬ HasBinaryDescent B (resolveM1 B f k s) k := by
  rintro ⟨c, d, _, hc, _, hfc, _⟩
  have hz : resolveM1 B f k s c = 0 :=
    replaceAdjacentColumns_left B f (fun _ => 0)
      (fun c => cutBit s c.1.1) k c hc
  exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans hfc)

/-- After 2M the affected pair can no longer contain a row descent. -/
theorem resolve2M_no_descent (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) : ¬ HasBinaryDescent B (resolve2M B f k s) k := by
  rintro ⟨c, d, _, _, hd, _, hfd⟩
  have ho : resolve2M B f k s d = 1 :=
    replaceAdjacentColumns_right B f
      (fun c => cutBit s c.1.1) (fun _ => 1) k d hd
  exact (by decide : (0 : Fin 2) ≠ 1) (hfd.symm.trans ho)

/-- After 21 the affected pair can no longer contain a row descent. -/
theorem resolve21_no_descent (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) : ¬ HasBinaryDescent B (resolve21 B f k) k := by
  rintro ⟨c, d, _, hc, _, hfc, _⟩
  have hz : resolve21 B f k c = 0 :=
    replaceAdjacentColumns_left B f (fun _ => 0) (fun _ => 1) k c hc
  exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans hfc)

/-- Genuine reverse plane partitions never have a binary descent. -/
theorem movingRPP_no_descent (D : Diagram) (I J : ShapeIdeal D)
    (f : BinaryIntervalRPP D I J) (k : ℕ) :
    ¬ HasBinaryDescent (MovingShape D I J) (rppMovingFilling D I J f) k := by
  rintro ⟨c, d, hrow, hc, hd, hfc, hfd⟩
  have hle : movingCellToAmbient D I J c ≤ movingCellToAmbient D I J d := by
    change c.1.1 ≤ d.1.1 ∧ c.1.2 ≤ d.1.2
    exact ⟨le_of_eq hrow, by omega⟩
  have horder := f.2.1 hle
  change f.1 (movingCellToAmbient D I J c) = 1 at hfc
  change f.1 (movingCellToAmbient D I J d) = 0 at hfd
  rw [hfc, hfd] at horder
  exact (by decide : ¬ ((1 : Fin 2) ≤ 0)) horder

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — certified local support of the three rules. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- A zero occurs in physical column k. -/
def ColumnHasZero (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : Prop :=
  ∃ c : ShapeCell B, c.1.2 = k ∧ f c = 0

/-- A one occurs in physical column k. -/
def ColumnHasOne (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : Prop :=
  ∃ c : ShapeCell B, c.1.2 = k ∧ f c = 1

/-- The two sides of a mixed column are both nonempty. -/
def ColumnMixed (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : Prop :=
  ColumnHasZero B f k ∧ ColumnHasOne B f k

/-- A pure-zero column is nonempty and contains no ones. -/
def ColumnPureZero (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : Prop :=
  ColumnHasZero B f k ∧ ¬ ColumnHasOne B f k

/-- A pure-one column is nonempty and contains no zeros. -/
def ColumnPureOne (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : Prop :=
  ¬ ColumnHasZero B f k ∧ ColumnHasOne B f k

/-- The target column really permits a nontrivial cut at row s. -/
def CutFitsColumn (B : Diagram) (k s : ℕ) : Prop :=
  (∃ c : ShapeCell B, c.1.2 = k ∧ c.1.1 < s) ∧
    (∃ c : ShapeCell B, c.1.2 = k ∧ s ≤ c.1.1)

/-- The old mixed column has exactly the profile with separator s. -/
def HasSeparator (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) : Prop :=
  ∀ c : ShapeCell B, c.1.2 = k → f c = cutBit s c.1.1

/-- Exact left and right outputs in case M1. -/
theorem resolveM1_left_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B) (hc : c.1.2 = k) :
    resolveM1 B f k s c = 0 :=
  replaceAdjacentColumns_left B f (fun _ => 0)
    (fun c => cutBit s c.1.1) k c hc

theorem resolveM1_right_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B) (hc : c.1.2 = k + 1) :
    resolveM1 B f k s c = cutBit s c.1.1 :=
  replaceAdjacentColumns_right B f (fun _ => 0)
    (fun c => cutBit s c.1.1) k c hc

/-- Exact left and right outputs in case 2M. -/
theorem resolve2M_left_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B) (hc : c.1.2 = k) :
    resolve2M B f k s c = cutBit s c.1.1 :=
  replaceAdjacentColumns_left B f (fun c => cutBit s c.1.1)
    (fun _ => 1) k c hc

theorem resolve2M_right_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ) (c : ShapeCell B) (hc : c.1.2 = k + 1) :
    resolve2M B f k s c = 1 :=
  replaceAdjacentColumns_right B f (fun c => cutBit s c.1.1)
    (fun _ => 1) k c hc

/-- Exact left and right outputs in case 21. -/
theorem resolve21_left_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) (c : ShapeCell B) (hc : c.1.2 = k) :
    resolve21 B f k c = 0 :=
  replaceAdjacentColumns_left B f (fun _ => 0)
    (fun _ => 1) k c hc

theorem resolve21_right_value (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) (c : ShapeCell B) (hc : c.1.2 = k + 1) :
    resolve21 B f k c = 1 :=
  replaceAdjacentColumns_right B f (fun _ => 0)
    (fun _ => 1) k c hc

/-- A fitted cut produces a genuinely mixed column. This is the
fundamental geometric condition behind M1 and 2M. -/
theorem fittedCut_mixed (B : Diagram) (k s : ℕ)
    (h : CutFitsColumn B k s) :
    ColumnMixed B (fun c : ShapeCell B => cutBit s c.1.1) k := by
  obtain ⟨⟨a, ha, har⟩, ⟨b, hb, hbr⟩⟩ := h
  constructor
  · exact ⟨a, ha, by simp [cutBit, har]⟩
  · have hn : ¬ b.1.1 < s := by omega
    exact ⟨b, hb, by simp [cutBit, hn]⟩

/-- On the affected pair, count columns containing a 0. -/
noncomputable def localZeroCount (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : ℕ := by
  classical
  exact (if ColumnHasZero B f k then 1 else 0) +
    (if ColumnHasZero B f (k + 1) then 1 else 0)

/-- On the affected pair, count columns containing a 1. -/
noncomputable def localOneCount (B : Diagram) (f : ShapeCell B → Fin 2) (k : ℕ) : ℕ := by
  classical
  exact (if ColumnHasOne B f k then 1 else 0) +
    (if ColumnHasOne B f (k + 1) then 1 else 0)

/-- For M1, the local 0/1-column counts survive transfer of the cut.
The threshold fit is an explicit *geometric* condition. -/
theorem resolveM1_local_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ)
    (hleft : ColumnMixed B f k)
    (hright : ColumnPureZero B f (k + 1))
    (hfit : CutFitsColumn B (k + 1) s) :
    localZeroCount B (resolveM1 B f k s) k = localZeroCount B f k ∧
    localOneCount B (resolveM1 B f k s) k = localOneCount B f k := by
  have hzl : ColumnHasZero B (resolveM1 B f k s) k := by
    rcases hleft.1 with ⟨c, hc, _⟩
    exact ⟨c, hc, resolveM1_left_value B f k s c hc⟩
  have hnl : ¬ ColumnHasOne B (resolveM1 B f k s) k := by
    rintro ⟨c, hc, ho⟩
    have hz := resolveM1_left_value B f k s c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hzr : ColumnHasZero B (resolveM1 B f k s) (k + 1) := by
    rcases hfit.1 with ⟨c, hc, hr⟩
    refine ⟨c, hc, ?_⟩
    rw [resolveM1_right_value B f k s c hc]
    simp [cutBit, hr]
  have hor : ColumnHasOne B (resolveM1 B f k s) (k + 1) := by
    rcases hfit.2 with ⟨c, hc, hr⟩
    refine ⟨c, hc, ?_⟩
    rw [resolveM1_right_value B f k s c hc]
    have hn : ¬ c.1.1 < s := by omega
    simp [cutBit, hn]
  constructor
  · simp [localZeroCount, hzl, hzr, hleft.1, hright.1]
  · simp [localOneCount, hnl, hor, hleft.2, hright.2]

/-- Symmetric local weight preservation in case 2M. -/
theorem resolve2M_local_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ)
    (hleft : ColumnPureOne B f k)
    (hright : ColumnMixed B f (k + 1))
    (hfit : CutFitsColumn B k s) :
    localZeroCount B (resolve2M B f k s) k = localZeroCount B f k ∧
    localOneCount B (resolve2M B f k s) k = localOneCount B f k := by
  have hzl : ColumnHasZero B (resolve2M B f k s) k := by
    rcases hfit.1 with ⟨c, hc, hr⟩
    refine ⟨c, hc, ?_⟩
    rw [resolve2M_left_value B f k s c hc]
    simp [cutBit, hr]
  have hol : ColumnHasOne B (resolve2M B f k s) k := by
    rcases hfit.2 with ⟨c, hc, hr⟩
    refine ⟨c, hc, ?_⟩
    rw [resolve2M_left_value B f k s c hc]
    have hn : ¬ c.1.1 < s := by omega
    simp [cutBit, hn]
  have hnr : ¬ ColumnHasZero B (resolve2M B f k s) (k + 1) := by
    rintro ⟨c, hc, hz⟩
    have ho := resolve2M_right_value B f k s c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hor : ColumnHasOne B (resolve2M B f k s) (k + 1) := by
    rcases hright.2 with ⟨c, hc, _⟩
    exact ⟨c, hc, resolve2M_right_value B f k s c hc⟩
  constructor
  · simp [localZeroCount, hzl, hnr, hleft.1, hright.1]
  · simp [localOneCount, hol, hor, hleft.2, hright.2]

/-- The pure-to-pure case 21 needs no threshold or geometry. -/
theorem resolve21_local_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ)
    (hleft : ColumnPureOne B f k)
    (hright : ColumnPureZero B f (k + 1)) :
    localZeroCount B (resolve21 B f k) k = localZeroCount B f k ∧
    localOneCount B (resolve21 B f k) k = localOneCount B f k := by
  have hzl : ColumnHasZero B (resolve21 B f k) k := by
    rcases hleft.2 with ⟨c, hc, _⟩
    exact ⟨c, hc, resolve21_left_value B f k c hc⟩
  have hnl : ¬ ColumnHasOne B (resolve21 B f k) k := by
    rintro ⟨c, hc, ho⟩
    have hz := resolve21_left_value B f k c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hnr : ¬ ColumnHasZero B (resolve21 B f k) (k + 1) := by
    rintro ⟨c, hc, hz⟩
    have ho := resolve21_right_value B f k c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hor : ColumnHasOne B (resolve21 B f k) (k + 1) := by
    rcases hright.1 with ⟨c, hc, _⟩
    exact ⟨c, hc, resolve21_right_value B f k c hc⟩
  constructor
  · simp [localZeroCount, hzl, hnr, hleft.1, hright.1]
  · simp [localOneCount, hnl, hor, hleft.2, hright.2]

/-- A local move relation on vertical binary tables: all three moves
are explicit and preserve vertical isotonicity. This is not the
transitive-closure normalization relation, which is . -/
inductive LocalColumnResolution (B : Diagram) :
    VerticalBinaryTable B → VerticalBinaryTable B → Prop where
  | m1 (f : VerticalBinaryTable B) (k s : ℕ)
      (hleft : ColumnMixed B f.1 k)
      (hright : ColumnPureZero B f.1 (k + 1))
      (hcut : HasSeparator B f.1 k s)
      (hfit : CutFitsColumn B (k + 1) s)
      (hdescent : HasBinaryDescent B f.1 k) :
      LocalColumnResolution B f
        ⟨resolveM1 B f.1 k s, resolveM1_vertical B f.1 k s f.2⟩
  | twoM (f : VerticalBinaryTable B) (k s : ℕ)
      (hleft : ColumnPureOne B f.1 k)
      (hright : ColumnMixed B f.1 (k + 1))
      (hcut : HasSeparator B f.1 (k + 1) s)
      (hfit : CutFitsColumn B k s)
      (hdescent : HasBinaryDescent B f.1 k) :
      LocalColumnResolution B f
        ⟨resolve2M B f.1 k s, resolve2M_vertical B f.1 k s f.2⟩
  | oneTwo (f : VerticalBinaryTable B) (k : ℕ)
      (hleft : ColumnPureOne B f.1 k)
      (hright : ColumnPureZero B f.1 (k + 1))
      (hdescent : HasBinaryDescent B f.1 k) :
      LocalColumnResolution B f
        ⟨resolve21 B f.1 k, resolve21_vertical B f.1 k f.2⟩

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — existence of separators and skew-shape fit. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The finite set of rows containing a one in physical column k. -/
noncomputable def columnOneRows (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) : Finset ℕ := by
  classical
  exact (Finset.univ.filter (fun c : ShapeCell B =>
    c.1.2 = k ∧ f c = 1)).image (fun c => c.1.1)

/-- Membership in this finite set is an existence statement. -/
theorem mem_columnOneRows (B : Diagram)
    (f : ShapeCell B → Fin 2) (k r : ℕ) :
    r ∈ columnOneRows B f k ↔
      ∃ c : ShapeCell B, c.1.2 = k ∧ f c = 1 ∧ c.1.1 = r := by
  classical
  simp only [columnOneRows, Finset.mem_image,
    Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨c, ⟨hc, ho⟩, hr⟩
    exact ⟨c, hc, ho, hr⟩
  · rintro ⟨c, hc, ho, hr⟩
    exact ⟨c, ⟨hc, ho⟩, hr⟩

/-- Every mixed, vertically monotone column has a separator and both
sides of that separator are occupied. -/
theorem mixedColumn_exists_separator (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hv : VerticalBinaryIsotone B f)
    (hm : ColumnMixed B f k) :
    ∃ s : ℕ, HasSeparator B f k s ∧ CutFitsColumn B k s := by
  classical
  obtain ⟨⟨a, ha, haz⟩, ⟨b, hb, hbo⟩⟩ := hm
  have hne : (columnOneRows B f k).Nonempty := by
    exact ⟨b.1.1, (mem_columnOneRows B f k b.1.1).mpr
      ⟨b, hb, hbo, rfl⟩⟩
  let s : ℕ := (columnOneRows B f k).min' hne
  have hs_mem : s ∈ columnOneRows B f k :=
    Finset.min'_mem (columnOneRows B f k) hne
  obtain ⟨w, hwcol, hwo, hwrow⟩ :=
    (mem_columnOneRows B f k s).mp hs_mem
  have hone_le : ∀ c : ShapeCell B,
      c.1.2 = k → f c = 1 → s ≤ c.1.1 := by
    intro c hc ho
    exact Finset.min'_le (columnOneRows B f k) c.1.1
      ((mem_columnOneRows B f k c.1.1).mpr ⟨c, hc, ho, rfl⟩)
  have hzero_lt : ∀ c : ShapeCell B,
      c.1.2 = k → f c = 0 → c.1.1 < s := by
    intro c hc hz
    by_contra hlt
    have hle : s ≤ c.1.1 := by omega
    have horder : f w ≤ f c :=
      hv w c (hwcol.trans hc.symm) (by omega)
    rw [hwo, hz] at horder
    exact (by decide : ¬ ((1 : Fin 2) ≤ 0)) horder
  refine ⟨s, ?_, ?_⟩
  · intro c hc
    rcases finTwo_zero_or_one (f c) with hz | ho
    · have hlt := hzero_lt c hc hz
      simpa [cutBit, hlt] using hz
    · have hge := hone_le c hc ho
      have hnot : ¬ c.1.1 < s := by omega
      simpa [cutBit, hnot] using ho
  · exact ⟨⟨a, ha, hzero_lt a ha haz⟩,
      ⟨w, hwcol, by omega⟩⟩

/-- In an M1 descent, the skew shape supplies the two cells required
to move the mixed-column separator one column to the right. -/
theorem skew_M1_cut_fits (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hm : ColumnMixed B f k)
    (hsep : HasSeparator B f k s)
    (hdesc : HasBinaryDescent B f k) :
    CutFitsColumn B (k + 1) s := by
  obtain ⟨⟨z, hzcol, hz0⟩, _⟩ := hm
  obtain ⟨l, r, hrow, hlcol, hrcol, hlo, _⟩ := hdesc
  have hzrow : z.1.1 < s := by
    have heq := hsep z hzcol
    rw [hz0] at heq
    by_contra hneg
    have hnot : ¬ z.1.1 < s := by omega
    simp [cutBit, hnot] at heq
  have hlrow : s ≤ l.1.1 := by
    have heq := hsep l hlcol
    rw [hlo] at heq
    by_contra hneg
    have hlt : l.1.1 < s := by omega
    simp [cutBit, hlt] at heq
  have hzr : z.1.1 ≤ r.1.1 := by omega
  have hcell : (z.1.1, k + 1) ∈ B := by
    apply skewRowIntervals_rectangle B hsk z.1 r.1 (z.1.1, k + 1)
      z.2 r.2
    · omega
    · omega
    · omega
    · omega
  exact ⟨⟨⟨(z.1.1, k + 1), hcell⟩, rfl, hzrow⟩,
    ⟨r, hrcol, by omega⟩⟩

/-- In a 2M descent, the skew southwest corner fills in the target
left column at the separator level. -/
theorem skew_2M_cut_fits (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hm : ColumnMixed B f (k + 1))
    (hsep : HasSeparator B f (k + 1) s)
    (hdesc : HasBinaryDescent B f k) :
    CutFitsColumn B k s := by
  obtain ⟨_, ⟨o, hocol, hoone⟩⟩ := hm
  obtain ⟨l, r, hrow, hlcol, hrcol, _, hrzero⟩ := hdesc
  have hrrow : r.1.1 < s := by
    have heq := hsep r hrcol
    rw [hrzero] at heq
    by_contra hneg
    have hn : ¬ r.1.1 < s := by omega
    simp [cutBit, hn] at heq
  have horow : s ≤ o.1.1 := by
    have heq := hsep o hocol
    rw [hoone] at heq
    by_contra hneg
    have hlt : o.1.1 < s := by omega
    simp [cutBit, hlt] at heq
  have hrowle : l.1.1 ≤ o.1.1 := by omega
  have hcell : (o.1.1, k) ∈ B := by
    have hcorner : (o.1.1, l.1.2) ∈ B :=
      skewRowIntervals_comparable_southwest_corner B hsk
        l.1 o.1 l.2 o.2 hrowle (by omega)
    simpa only [hlcol] using hcorner
  exact ⟨⟨l, hlcol, by omega⟩,
    ⟨⟨(o.1.1, k), hcell⟩, rfl, horow⟩⟩

/-- The local move is admissible on a skew diagram with the specified
column profile and a binary descent. -/
theorem skew_M1_resolution_exists (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (hleft : ColumnMixed B f.1 k)
    (hright : ColumnPureZero B f.1 (k + 1))
    (hdesc : HasBinaryDescent B f.1 k) :
    ∃ g : VerticalBinaryTable B, LocalColumnResolution B f g := by
  obtain ⟨s, hs, _⟩ := mixedColumn_exists_separator B f.1 k f.2 hleft
  let hfit := skew_M1_cut_fits B hsk f.1 k s hleft hs hdesc
  exact ⟨⟨resolveM1 B f.1 k s, resolveM1_vertical B f.1 k s f.2⟩,
    LocalColumnResolution.m1 f k s hleft hright hs hfit hdesc⟩

/-- The analogous unconditional skew-geometric existence for 2M. -/
theorem skew_2M_resolution_exists (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (hleft : ColumnPureOne B f.1 k)
    (hright : ColumnMixed B f.1 (k + 1))
    (hdesc : HasBinaryDescent B f.1 k) :
    ∃ g : VerticalBinaryTable B, LocalColumnResolution B f g := by
  obtain ⟨s, hs, _⟩ := mixedColumn_exists_separator B f.1 (k + 1) f.2 hright
  let hfit := skew_2M_cut_fits B hsk f.1 k s hright hs hdesc
  exact ⟨⟨resolve2M B f.1 k s, resolve2M_vertical B f.1 k s f.2⟩,
    LocalColumnResolution.twoM f k s hleft hright hs hfit hdesc⟩

/-- The 21 case needs no separator at all. -/
theorem skew_21_resolution_exists (B : Diagram)
    (f : VerticalBinaryTable B) (k : ℕ)
    (hleft : ColumnPureOne B f.1 k)
    (hright : ColumnPureZero B f.1 (k + 1))
    (hdesc : HasBinaryDescent B f.1 k) :
    ∃ g : VerticalBinaryTable B, LocalColumnResolution B f g :=
  ⟨⟨resolve21 B f.1 k, resolve21_vertical B f.1 k f.2⟩,
    LocalColumnResolution.oneTwo f k hleft hright hdesc⟩

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Invariants of certified local resolutions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- EVERY local resolution (M1, 2M or 21) preserves both local column
counts of the affected pair, not just an arbitrarily chosen case. -/
theorem localColumnResolution_preserves_pair_counts (B : Diagram)
    {f g : VerticalBinaryTable B}
    (h : LocalColumnResolution B f g) :
    ∃ k : ℕ,
      localZeroCount B g.1 k = localZeroCount B f.1 k ∧
      localOneCount B g.1 k = localOneCount B f.1 k := by
  cases h with
  | m1 k s hl hr hs hf hd =>
      exact ⟨k, resolveM1_local_counts B f.1 k s hl hr hf⟩
  | twoM k s hl hr hs hf hd =>
      exact ⟨k, resolve2M_local_counts B f.1 k s hl hr hf⟩
  | oneTwo k hl hr hd =>
      exact ⟨k, resolve21_local_counts B f.1 k hl hr⟩

/-- EVERY local resolution removes its chosen descent. Later descents
at neighboring columns may remain or appear: those are addressed in
 by well-founded normalization, not by a false claim that one
move creates a globally row-monotone tableau. -/
theorem localColumnResolution_eliminates_chosen_descent (B : Diagram)
    {f g : VerticalBinaryTable B}
    (h : LocalColumnResolution B f g) :
    ∃ k : ℕ,
      HasBinaryDescent B f.1 k ∧ ¬ HasBinaryDescent B g.1 k := by
  cases h with
  | m1 k s hl hr hs hf hd =>
      exact ⟨k, hd, resolveM1_no_descent B f.1 k s⟩
  | twoM k s hl hr hs hf hd =>
      exact ⟨k, hd, resolve2M_no_descent B f.1 k s⟩
  | oneTwo k hl hr hd =>
      exact ⟨k, hd, resolve21_no_descent B f.1 k⟩

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Classification of local descents. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The sole signature obstruction to the three Galashin--Grinberg--Liu
moves is a descent formed by two *mixed* columns. Benign tables avoid
such descents; will prove this from monotonicity of separators
and show it survives normalization. -/
def NoMixedMixedDescent (B : Diagram)
    (f : ShapeCell B → Fin 2) : Prop :=
  ∀ k : ℕ, HasBinaryDescent B f k →
    ¬ (ColumnMixed B f k ∧ ColumnMixed B f (k + 1))

/-- Complete local existence theorem for the three genuine rules on
skew diagrams, conditional ONLY on absence of a mixed/mixed descent.
The separator and its geometric fit are constructed, not assumed. -/
theorem skew_local_resolution_exists (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (hdesc : HasBinaryDescent B f.1 k)
    (hbenign : NoMixedMixedDescent B f.1) :
    ∃ g : VerticalBinaryTable B, LocalColumnResolution B f g := by
  have hdescSaved : HasBinaryDescent B f.1 k := hdesc
  obtain ⟨l, r, hrow, hkl, hkr, hlone, hrzero⟩ := hdesc
  have hleftOne : ColumnHasOne B f.1 k := ⟨l, hkl, hlone⟩
  have hrightZero : ColumnHasZero B f.1 (k + 1) := ⟨r, hkr, hrzero⟩
  by_cases hleftZero : ColumnHasZero B f.1 k
  · by_cases hrightOne : ColumnHasOne B f.1 (k + 1)
    · have hbad : ColumnMixed B f.1 k ∧
          ColumnMixed B f.1 (k + 1) :=
        ⟨⟨hleftZero, hleftOne⟩, ⟨hrightZero, hrightOne⟩⟩
      exact False.elim ((hbenign k hdescSaved) hbad)
    · exact skew_M1_resolution_exists B hsk f k
        ⟨hleftZero, hleftOne⟩ ⟨hrightZero, hrightOne⟩ hdescSaved
  · by_cases hrightOne : ColumnHasOne B f.1 (k + 1)
    · exact skew_2M_resolution_exists B hsk f k
        ⟨hleftZero, hleftOne⟩ ⟨hrightZero, hrightOne⟩ hdescSaved
    · exact skew_21_resolution_exists B f k
        ⟨hleftZero, hleftOne⟩ ⟨hrightZero, hrightOne⟩ hdescSaved

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — from pairwise conservation to GLOBAL column-weight conservation. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Deleting an element changes cardinality by its membership indicator. -/
theorem card_erase_indicator (S : Finset ℕ) (k : ℕ) :
    (S.erase k).card + (if k ∈ S then 1 else 0) = S.card := by
  classical
  by_cases hk : k ∈ S
  · simpa only [ite_eq_left hk] using (Finset.card_erase_add_one hk)
  · simp [hk]

/-- Exact cardinality decomposition into the untouched columns and two
adjacent columns. -/
theorem card_erase_adjacent (S : Finset ℕ) (k : ℕ) :
    ((S.erase k).erase (k + 1)).card +
      (if k ∈ S then 1 else 0) +
      (if k + 1 ∈ S then 1 else 0) = S.card := by
  classical
  have hfirst := card_erase_indicator S k
  have hsecond := card_erase_indicator (S.erase k) (k + 1)
  have hne : k + 1 ≠ k := by omega
  have hiff : (k + 1 ∈ S.erase k) ↔ k + 1 ∈ S := by
    simp [Finset.mem_erase]
  by_cases hh : k + 1 ∈ S
  · have hh' : k + 1 ∈ S.erase k := hiff.mpr hh
    simp only [ite_eq_left hh, ite_eq_left hh'] at *
    omega
  · have hh' : k + 1 ∉ S.erase k := fun h => hh (hiff.mp h)
    simp only [ite_eq_right hh, ite_eq_right hh'] at *
    omega

/-- Two finite column sets have equal cardinality when they coincide
away from {k,k+1} and have the same membership count in this pair. -/
theorem card_eq_of_agree_outside_pair (S T : Finset ℕ) (k : ℕ)
    (houtside : ∀ j : ℕ, j ≠ k → j ≠ k + 1 → (j ∈ S ↔ j ∈ T))
    (hpair : (if k ∈ S then 1 else 0) +
        (if k + 1 ∈ S then 1 else 0) =
      (if k ∈ T then 1 else 0) +
        (if k + 1 ∈ T then 1 else 0)) :
    S.card = T.card := by
  classical
  have hcore : (S.erase k).erase (k + 1) =
      (T.erase k).erase (k + 1) := by
    ext j
    simp only [Finset.mem_erase]
    by_cases hj1 : j = k + 1
    · simp [hj1]
    · by_cases hj : j = k
      · simp [hj]
      · simpa [hj, hj1] using (houtside j hj hj1)
  have hS := card_erase_adjacent S k
  have hT := card_erase_adjacent T k
  rw [hcore] at hS
  omega

/-- Changing only columns k,k+1 does not affect whether any other
column contains a 0. -/
theorem replaceAdjacent_hasZero_outside (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k j : ℕ)
    (hj : j ≠ k) (hj1 : j ≠ k + 1) :
    ColumnHasZero B (replaceAdjacentColumns B f left right k) j ↔
      ColumnHasZero B f j := by
  constructor
  · rintro ⟨c, hc, hz⟩
    have hck : c.1.2 ≠ k := by
      intro he
      exact hj (hc.symm.trans he)
    have hck1 : c.1.2 ≠ k + 1 := by
      intro he
      exact hj1 (hc.symm.trans he)
    exact ⟨c, hc, (replaceAdjacentColumns_outside B f left right k c hck hck1).symm.trans hz⟩
  · rintro ⟨c, hc, hz⟩
    have hck : c.1.2 ≠ k := by
      intro he
      exact hj (hc.symm.trans he)
    have hck1 : c.1.2 ≠ k + 1 := by
      intro he
      exact hj1 (hc.symm.trans he)
    exact ⟨c, hc, (replaceAdjacentColumns_outside B f left right k c hck hck1).trans hz⟩

/-- The same property for columns containing a 1. -/
theorem replaceAdjacent_hasOne_outside (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k j : ℕ)
    (hj : j ≠ k) (hj1 : j ≠ k + 1) :
    ColumnHasOne B (replaceAdjacentColumns B f left right k) j ↔
      ColumnHasOne B f j := by
  constructor
  · rintro ⟨c, hc, ho⟩
    have hck : c.1.2 ≠ k := by
      intro he
      exact hj (hc.symm.trans he)
    have hck1 : c.1.2 ≠ k + 1 := by
      intro he
      exact hj1 (hc.symm.trans he)
    exact ⟨c, hc, (replaceAdjacentColumns_outside B f left right k c hck hck1).symm.trans ho⟩
  · rintro ⟨c, hc, ho⟩
    have hck : c.1.2 ≠ k := by
      intro he
      exact hj (hc.symm.trans he)
    have hck1 : c.1.2 ≠ k + 1 := by
      intro he
      exact hj1 (hc.symm.trans he)
    exact ⟨c, hc, (replaceAdjacentColumns_outside B f left right k c hck hck1).trans ho⟩

/-- If a replacement preserves the local pair statistics, its entire
column content vector (0-column count and 1-column count) is preserved. -/
theorem replaceAdjacent_preserves_global_counts (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k : ℕ)
    (hpair :
      localZeroCount B (replaceAdjacentColumns B f left right k) k =
        localZeroCount B f k ∧
      localOneCount B (replaceAdjacentColumns B f left right k) k =
        localOneCount B f k) :
    (rawZeroColumns B (replaceAdjacentColumns B f left right k)).card =
        (rawZeroColumns B f).card ∧
    (rawOneColumns B (replaceAdjacentColumns B f left right k)).card =
        (rawOneColumns B f).card := by
  classical
  constructor
  · apply card_eq_of_agree_outside_pair
      (rawZeroColumns B (replaceAdjacentColumns B f left right k))
      (rawZeroColumns B f) k
    · intro j hj hj1
      simpa only [mem_rawZeroColumns, ColumnHasZero] using
        (replaceAdjacent_hasZero_outside B f left right k j hj hj1)
    · classical
      by_cases h₀ : ColumnHasZero B (replaceAdjacentColumns B f left right k) k
      <;> by_cases h₁ : ColumnHasZero B (replaceAdjacentColumns B f left right k) (k + 1)
      <;> by_cases h₂ : ColumnHasZero B f k
      <;> by_cases h₃ : ColumnHasZero B f (k + 1)
      <;> simpa [mem_rawZeroColumns, localZeroCount, ColumnHasZero,
        h₀, h₁, h₂, h₃] using hpair.1
  · apply card_eq_of_agree_outside_pair
      (rawOneColumns B (replaceAdjacentColumns B f left right k))
      (rawOneColumns B f) k
    · intro j hj hj1
      simpa only [mem_rawOneColumns, ColumnHasOne] using
        (replaceAdjacent_hasOne_outside B f left right k j hj hj1)
    · classical
      have h := hpair.2
      simp only [localOneCount, ColumnHasOne] at h
      simp only [mem_rawOneColumns]
      by_cases h₀ : ∃ c : ShapeCell B, c.1.2 = k ∧
          replaceAdjacentColumns B f left right k c = 1
      <;> by_cases h₁ : ∃ c : ShapeCell B, c.1.2 = k + 1 ∧
          replaceAdjacentColumns B f left right k c = 1
      <;> by_cases h₂ : ∃ c : ShapeCell B, c.1.2 = k ∧ f c = 1
      <;> by_cases h₃ : ∃ c : ShapeCell B, c.1.2 = k + 1 ∧ f c = 1
      <;> simp only [h₀, h₁, h₂, h₃, ite_true, ite_false] at h ⊢
      <;> omega

/-- Global two-colour column-content preservation for M1. -/
theorem resolveM1_global_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ)
    (hl : ColumnMixed B f k) (hr : ColumnPureZero B f (k + 1))
    (hfit : CutFitsColumn B (k + 1) s) :
    (rawZeroColumns B (resolveM1 B f k s)).card =
        (rawZeroColumns B f).card ∧
    (rawOneColumns B (resolveM1 B f k s)).card =
        (rawOneColumns B f).card := by
  exact replaceAdjacent_preserves_global_counts B f (fun _ => 0)
    (fun c => cutBit s c.1.1) k (resolveM1_local_counts B f k s hl hr hfit)

/-- Global two-colour column-content preservation for 2M. -/
theorem resolve2M_global_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k s : ℕ)
    (hl : ColumnPureOne B f k) (hr : ColumnMixed B f (k + 1))
    (hfit : CutFitsColumn B k s) :
    (rawZeroColumns B (resolve2M B f k s)).card =
        (rawZeroColumns B f).card ∧
    (rawOneColumns B (resolve2M B f k s)).card =
        (rawOneColumns B f).card := by
  exact replaceAdjacent_preserves_global_counts B f
    (fun c => cutBit s c.1.1) (fun _ => 1) k
    (resolve2M_local_counts B f k s hl hr hfit)

/-- Global two-colour column-content preservation for 21. -/
theorem resolve21_global_counts (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ)
    (hl : ColumnPureOne B f k) (hr : ColumnPureZero B f (k + 1)) :
    (rawZeroColumns B (resolve21 B f k)).card =
        (rawZeroColumns B f).card ∧
    (rawOneColumns B (resolve21 B f k)).card =
        (rawOneColumns B f).card := by
  exact replaceAdjacent_preserves_global_counts B f (fun _ => 0)
    (fun _ => 1) k (resolve21_local_counts B f k hl hr)

/-- Main structural invariant: every certified local descent resolution
preserves BOTH global column-count statistics, with no further
hypothesis and no reference to a still-unbuilt normalization. -/
theorem localColumnResolution_preserves_global_counts (B : Diagram)
    {f g : VerticalBinaryTable B} (h : LocalColumnResolution B f g) :
    (rawZeroColumns B g.1).card = (rawZeroColumns B f.1).card ∧
    (rawOneColumns B g.1).card = (rawOneColumns B f.1).card := by
  cases h with
  | m1 k s hl hr hs hf hd =>
      exact resolveM1_global_counts B f.1 k s hl hr hf
  | twoM k s hl hr hs hf hd =>
      exact resolve2M_global_counts B f.1 k s hl hr hf
  | oneTwo k hl hr hd =>
      exact resolve21_global_counts B f.1 k hl hr

end TableauTransfer
end OrderIdealSpecializations


/-! ### §5.1 — Lemma 5.1: normalization infrastructure. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.1 — Reduction relation, normal tables and invariants. -/

/-- Zero or more certified column-resolution steps. -/
abbrev ResolutionReach (B : Diagram) :
    VerticalBinaryTable B → VerticalBinaryTable B → Prop :=
  Relation.ReflTransGen (LocalColumnResolution B)

/-- A vertically monotone binary table with no horizontal descent. -/
def IsNormalBinaryTable (B : Diagram) (f : VerticalBinaryTable B) : Prop :=
  ∀ k : ℕ, ¬ HasBinaryDescent B f.1 k

/-- A local resolution is impossible at a normal table. -/
theorem normal_no_resolution (B : Diagram) (f : VerticalBinaryTable B)
    (hf : IsNormalBinaryTable B f) (g : VerticalBinaryTable B) :
    ¬ LocalColumnResolution B f g := by
  intro h
  obtain ⟨k, hdescent, _⟩ :=
    localColumnResolution_eliminates_chosen_descent B h
  exact hf k hdescent

/-- For a skew diagram without mixed/mixed descents, lack of a local
resolution is exactly the absence of horizontal descents. -/
theorem irreducible_iff_normal (B : Diagram) (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hbenign : NoMixedMixedDescent B f.1) :
    (∀ g : VerticalBinaryTable B, ¬ LocalColumnResolution B f g) ↔
      IsNormalBinaryTable B f := by
  constructor
  · intro hno k hdescent
    obtain ⟨g, hfg⟩ :=
      skew_local_resolution_exists B hsk f k hdescent hbenign
    exact hno g hfg
  · exact normal_no_resolution B f

/-- All resolution histories preserve both *global* column statistics,
not just single steps. -/
theorem resolutionReach_preserves_global_counts (B : Diagram)
    {f g : VerticalBinaryTable B} (h : ResolutionReach B f g) :
    (rawZeroColumns B g.1).card = (rawZeroColumns B f.1).card ∧
    (rawOneColumns B g.1).card = (rawOneColumns B f.1).card := by
  induction h with
  | refl => exact ⟨rfl, rfl⟩
  | tail hxy hyz ih =>
      obtain ⟨hzero, hone⟩ :=
        localColumnResolution_preserves_global_counts B hyz
      exact ⟨hzero.trans ih.1, hone.trans ih.2⟩

/-! ### §5.1 — Abstract normalization: completely proved, no hidden axioms. -/

section AbstractNormalization

variable {α : Type*} (r : α → α → Prop)

/-- A normal element has no outgoing reduction step. -/
def IsIrreducible (a : α) : Prop := ∀ b : α, ¬ r a b

/-- If a normal element reaches `b`, then the path was trivial. -/
theorem reachable_from_irreducible {a b : α}
    (ha : IsIrreducible r a)
    (h : Relation.ReflTransGen r a b) : b = a := by
  rcases Relation.ReflTransGen.cases_head h with hab | ⟨c, hac, _⟩
  · exact hab.symm
  · exact False.elim (ha c hac)

/-- Any reduction system whose steps strictly decrease a natural-number
measure has an irreducible reduct from every starting point. -/
theorem irreducible_reduct_exists (energy : α → ℕ)
    (hdecrease : ∀ {a b : α}, r a b → energy b < energy a)
    (a : α) :
    ∃ b : α, Relation.ReflTransGen r a b ∧ IsIrreducible r b := by
  classical
  have aux : ∀ n : ℕ, ∀ a : α, energy a = n →
      ∃ b : α, Relation.ReflTransGen r a b ∧ IsIrreducible r b := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro a ha
        by_cases hstep : ∃ b : α, r a b
        · obtain ⟨b, hab⟩ := hstep
          have hb_lt : energy b < n := by
            rw [← ha]
            exact hdecrease hab
          obtain ⟨c, hbc, hc⟩ := ih (energy b) hb_lt b rfl
          exact ⟨c, Relation.ReflTransGen.head hab hbc, hc⟩
        · refine ⟨a, Relation.ReflTransGen.refl, ?_⟩
          intro b hab
          exact hstep ⟨b, hab⟩
  exact aux (energy a) a rfl

/-- The genuine local diamond condition for two different one-step
reductions of the same object. -/
def LocallyJoinable : Prop :=
  ∀ a b c : α, r a b → r a c →
    ∃ d : α, Relation.ReflTransGen r b d ∧ Relation.ReflTransGen r c d

/-- Newman's normal-form uniqueness theorem: a natural-valued strict
termination measure and local joinability suffice for uniqueness of every
reachable irreducible reduct. The induction is entirely explicit. -/
theorem unique_irreducible_reduct (energy : α → ℕ)
    (hdecrease : ∀ {a b : α}, r a b → energy b < energy a)
    (hdiamond : LocallyJoinable r)
    (a b c : α)
    (hab : Relation.ReflTransGen r a b)
    (hac : Relation.ReflTransGen r a c)
    (hbn : IsIrreducible r b)
    (hcn : IsIrreducible r c) : b = c := by
  classical
  have aux : ∀ n : ℕ, ∀ a : α, energy a = n →
      ∀ b c : α, Relation.ReflTransGen r a b →
        Relation.ReflTransGen r a c →
        IsIrreducible r b → IsIrreducible r c → b = c := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro a ha b c hab hac hbn hcn
        rcases Relation.ReflTransGen.cases_head hab with hab0 | ⟨u, hau, hub⟩
        · subst b
          have hca : c = a := reachable_from_irreducible r hbn hac
          exact hca.symm
        · rcases Relation.ReflTransGen.cases_head hac with hac0 | ⟨v, hav, hvc⟩
          · subst c
            exact False.elim (hcn u hau)
          · obtain ⟨d, hud, hvd⟩ := hdiamond a u v hau hav
            obtain ⟨e, hde, hen⟩ :=
              irreducible_reduct_exists r energy hdecrease d
            have hue : Relation.ReflTransGen r u e := hud.trans hde
            have hve : Relation.ReflTransGen r v e := hvd.trans hde
            have hult : energy u < n := by
              rw [← ha]
              exact hdecrease hau
            have hvlt : energy v < n := by
              rw [← ha]
              exact hdecrease hav
            have hbe : b = e := ih (energy u) hult u rfl b e hub hue hbn hen
            have hce : c = e := ih (energy v) hvlt v rfl c e hvc hve hcn hen
            exact hbe.trans hce.symm
  exact aux (energy a) a rfl b c hab hac hbn hcn

/-- A canonical normal form can be chosen, provided a concrete decrease
proof and a concrete diamond proof have been supplied. -/
noncomputable def canonicalNormalForm (energy : α → ℕ)
    (hdecrease : ∀ {a b : α}, r a b → energy b < energy a)
    (a : α) : α :=
  Classical.choose (irreducible_reduct_exists r energy hdecrease a)

theorem canonicalNormalForm_spec (energy : α → ℕ)
    (hdecrease : ∀ {a b : α}, r a b → energy b < energy a)
    (a : α) :
    Relation.ReflTransGen r a (canonicalNormalForm r energy hdecrease a) ∧
      IsIrreducible r (canonicalNormalForm r energy hdecrease a) :=
  Classical.choose_spec (irreducible_reduct_exists r energy hdecrease a)

theorem canonicalNormalForm_eq_of_diamond (energy : α → ℕ)
    (hdecrease : ∀ {a b : α}, r a b → energy b < energy a)
    (hdiamond : LocallyJoinable r)
    {a b : α} (hab : Relation.ReflTransGen r a b)
    (hbn : IsIrreducible r b) :
    canonicalNormalForm r energy hdecrease a = b := by
  obtain ⟨hreach, hnormal⟩ :=
    canonicalNormalForm_spec r energy hdecrease a
  exact unique_irreducible_reduct r energy hdecrease hdiamond
    a (canonicalNormalForm r energy hdecrease a) b hreach hab hnormal hbn

end AbstractNormalization

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — a concrete, strictly decreasing resolution energy. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Physical columns of a finite diagram; empty gaps are excluded. -/
def physicalColumns (B : Diagram) : Finset ℕ :=
  B.image (fun c : Cell => c.2)

theorem physicalColumns_of_zero (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hz : ColumnHasZero B f k) : k ∈ physicalColumns B := by
  obtain ⟨c, hc, _⟩ := hz
  exact Finset.mem_image.mpr ⟨c.1, c.2, hc⟩

theorem physicalColumns_of_one (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (ho : ColumnHasOne B f k) : k ∈ physicalColumns B := by
  obtain ⟨c, hc, _⟩ := ho
  exact Finset.mem_image.mpr ⟨c.1, c.2, hc⟩

/-- Signature 0/1/2 for pure-one/mixed/pure-zero columns. -/
noncomputable def columnSignature (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) : ℕ := by
  classical
  exact if ColumnHasZero B f k then
    (if ColumnHasOne B f k then 1 else 2) else 0

theorem signature_pureZero (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (h : ColumnPureZero B f k) : columnSignature B f k = 2 := by
  classical
  simp [columnSignature, h.1, h.2]

theorem signature_pureOne (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (h : ColumnPureOne B f k) : columnSignature B f k = 0 := by
  classical
  simp [columnSignature, h.1]

theorem signature_mixed (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (h : ColumnMixed B f k) : columnSignature B f k = 1 := by
  classical
  simp [columnSignature, h.1, h.2]

theorem signature_replace_outside (B : Diagram)
    (f left right : ShapeCell B → Fin 2) (k j : ℕ)
    (hj : j ≠ k) (hj1 : j ≠ k + 1) :
    columnSignature B (replaceAdjacentColumns B f left right k) j =
      columnSignature B f j := by
  classical
  unfold columnSignature
  rw [replaceAdjacent_hasZero_outside B f left right k j hj hj1,
      replaceAdjacent_hasOne_outside B f left right k j hj hj1]

/-- An adjacent exchange from (a,b) to (b,a), with a<b, strictly
reduces the weighted signature sum. This lemma is independent of any
particular tableau or diagram. -/
theorem weighted_adjacent_exchange_strict (S : Finset ℕ) (k : ℕ)
    (hk : k ∈ S) (hk1 : k + 1 ∈ S)
    (old new : ℕ → ℕ) (a b : ℕ)
    (hab : a < b)
    (h0 : old k = a) (h1 : old (k + 1) = b)
    (h0' : new k = b) (h1' : new (k + 1) = a)
    (houtside : ∀ j ∈ S, j ≠ k → j ≠ k + 1 →
      old j = new j) :
    (∑ j ∈ S, j * new j) < (∑ j ∈ S, j * old j) := by
  classical
  let R : Finset ℕ := (S.erase k).erase (k + 1)
  have hk1e : k + 1 ∈ S.erase k := by
    apply Finset.mem_erase.mpr
    constructor
    · omega
    · exact hk1
  have hcore :
      (∑ j ∈ R, j * old j) =
        (∑ j ∈ R, j * new j) := by
    apply Finset.sum_congr rfl
    intro j hj
    have hjR : j ∈ (S.erase k).erase (k + 1) := hj
    have hjE : j ∈ S.erase k :=
      (Finset.mem_erase.mp hjR).2
    have hjS : j ∈ S :=
      (Finset.mem_erase.mp hjE).2
    have hjneq : j ≠ k :=
      (Finset.mem_erase.mp hjE).1
    have hjneq1 : j ≠ k + 1 :=
      (Finset.mem_erase.mp hjR).1
    rw [houtside j hjS hjneq hjneq1]
  have hsplit (u : ℕ → ℕ) :
      (∑ j ∈ S, j * u j) =
        (∑ j ∈ R, j * u j) +
          k * u k + (k + 1) * u (k + 1) := by
    have hfirst :=
      Finset.sum_erase_add S (fun j => j * u j) hk
    have hsecond :=
      Finset.sum_erase_add
        (S.erase k) (fun j => j * u j) hk1e
    dsimp [R]
    omega
  have hOld := hsplit old
  have hNew := hsplit new
  rw [h0, h1] at hOld
  rw [h0', h1'] at hNew
  have hpoly :
      k * b + (k + 1) * a + b =
        k * a + (k + 1) * b + a := by
    ring
  omega

/-- The explicit potential used for termination in the source proof. -/
noncomputable def resolutionEnergy (B : Diagram)
    (f : ShapeCell B → Fin 2) : ℕ :=
  ∑ k ∈ physicalColumns B, k * columnSignature B f k

/-- M1 swaps the adjacent signatures 1,2 to 2,1. -/
theorem resolveM1_signature_swap (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hl : ColumnMixed B f k)
    (hr : ColumnPureZero B f (k + 1))
    (hfit : CutFitsColumn B (k + 1) s) :
    columnSignature B f k = 1 ∧
    columnSignature B f (k + 1) = 2 ∧
    columnSignature B (resolveM1 B f k s) k = 2 ∧
    columnSignature B (resolveM1 B f k s) (k + 1) = 1 := by
  have hzl : ColumnHasZero B (resolveM1 B f k s) k := by
    obtain ⟨c, hc, _⟩ := hl.1
    exact ⟨c, hc, resolveM1_left_value B f k s c hc⟩
  have hnl : ¬ ColumnHasOne B (resolveM1 B f k s) k := by
    rintro ⟨c, hc, he⟩
    have hz := resolveM1_left_value B f k s c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans he)
  have hzr : ColumnHasZero B (resolveM1 B f k s) (k + 1) := by
    obtain ⟨c, hc, hrow⟩ := hfit.1
    refine ⟨c, hc, ?_⟩
    rw [resolveM1_right_value B f k s c hc]
    simp [cutBit, hrow]
  have hor : ColumnHasOne B (resolveM1 B f k s) (k + 1) := by
    obtain ⟨c, hc, hrow⟩ := hfit.2
    refine ⟨c, hc, ?_⟩
    rw [resolveM1_right_value B f k s c hc]
    have hnot : ¬ c.1.1 < s := by omega
    simp [cutBit, hnot]
  exact ⟨signature_mixed B f k hl,
    signature_pureZero B f (k + 1) hr,
    signature_pureZero B (resolveM1 B f k s) k ⟨hzl, hnl⟩,
    signature_mixed B (resolveM1 B f k s) (k + 1) ⟨hzr, hor⟩⟩

/-- 2M swaps the adjacent signatures 0,1 to 1,0. -/
theorem resolve2M_signature_swap (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hl : ColumnPureOne B f k)
    (hr : ColumnMixed B f (k + 1))
    (hfit : CutFitsColumn B k s) :
    columnSignature B f k = 0 ∧
    columnSignature B f (k + 1) = 1 ∧
    columnSignature B (resolve2M B f k s) k = 1 ∧
    columnSignature B (resolve2M B f k s) (k + 1) = 0 := by
  have hzl : ColumnHasZero B (resolve2M B f k s) k := by
    obtain ⟨c, hc, hrow⟩ := hfit.1
    refine ⟨c, hc, ?_⟩
    rw [resolve2M_left_value B f k s c hc]
    simp [cutBit, hrow]
  have hol : ColumnHasOne B (resolve2M B f k s) k := by
    obtain ⟨c, hc, hrow⟩ := hfit.2
    refine ⟨c, hc, ?_⟩
    rw [resolve2M_left_value B f k s c hc]
    have hnot : ¬ c.1.1 < s := by omega
    simp [cutBit, hnot]
  have hnr : ¬ ColumnHasZero B (resolve2M B f k s) (k + 1) := by
    rintro ⟨c, hc, hz⟩
    have ho := resolve2M_right_value B f k s c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hor : ColumnHasOne B (resolve2M B f k s) (k + 1) := by
    obtain ⟨c, hc, _⟩ := hr.2
    exact ⟨c, hc, resolve2M_right_value B f k s c hc⟩
  exact ⟨signature_pureOne B f k hl,
    signature_mixed B f (k + 1) hr,
    signature_mixed B (resolve2M B f k s) k ⟨hzl, hol⟩,
    signature_pureOne B (resolve2M B f k s) (k + 1) ⟨hnr, hor⟩⟩

/-- 21 swaps the adjacent signatures 0,2 to 2,0. -/
theorem resolve21_signature_swap (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hl : ColumnPureOne B f k)
    (hr : ColumnPureZero B f (k + 1)) :
    columnSignature B f k = 0 ∧
    columnSignature B f (k + 1) = 2 ∧
    columnSignature B (resolve21 B f k) k = 2 ∧
    columnSignature B (resolve21 B f k) (k + 1) = 0 := by
  have hzl : ColumnHasZero B (resolve21 B f k) k := by
    obtain ⟨c, hc, _⟩ := hl.2
    exact ⟨c, hc, resolve21_left_value B f k c hc⟩
  have hnl : ¬ ColumnHasOne B (resolve21 B f k) k := by
    rintro ⟨c, hc, ho⟩
    have hz := resolve21_left_value B f k c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hnr : ¬ ColumnHasZero B (resolve21 B f k) (k + 1) := by
    rintro ⟨c, hc, hz⟩
    have ho := resolve21_right_value B f k c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  have hor : ColumnHasOne B (resolve21 B f k) (k + 1) := by
    obtain ⟨c, hc, _⟩ := hr.1
    exact ⟨c, hc, resolve21_right_value B f k c hc⟩
  exact ⟨signature_pureOne B f k hl,
    signature_pureZero B f (k + 1) hr,
    signature_pureZero B (resolve21 B f k) k ⟨hzl, hnl⟩,
    signature_pureOne B (resolve21 B f k) (k + 1) ⟨hnr, hor⟩⟩

/-- Concrete termination invariant: every certified local move strictly
reduces the weighted signature sum, including the rules M1, 2M and 21. -/
theorem localColumnResolution_energy_strict (B : Diagram)
    {f g : VerticalBinaryTable B}
    (h : LocalColumnResolution B f g) :
    resolutionEnergy B g.1 < resolutionEnergy B f.1 := by
  cases h with
  | m1 k s hl hr hs hf hd =>
      obtain ⟨hs0, hs1, hs0', hs1'⟩ :=
        resolveM1_signature_swap B f.1 k s hl hr hf
      exact weighted_adjacent_exchange_strict (physicalColumns B) k
        (physicalColumns_of_zero B f.1 k hl.1)
        (physicalColumns_of_zero B f.1 (k + 1) hr.1)
        (columnSignature B f.1) (columnSignature B (resolveM1 B f.1 k s))
        1 2 (by omega) hs0 hs1 hs0' hs1'
        (by
          intro j hj hj0 hj1
          exact (signature_replace_outside B f.1 (fun _ => 0)
            (fun c => cutBit s c.1.1) k j hj0 hj1).symm)
  | twoM k s hl hr hs hf hd =>
      obtain ⟨hs0, hs1, hs0', hs1'⟩ :=
        resolve2M_signature_swap B f.1 k s hl hr hf
      exact weighted_adjacent_exchange_strict (physicalColumns B) k
        (physicalColumns_of_one B f.1 k hl.2)
        (physicalColumns_of_zero B f.1 (k + 1) hr.1)
        (columnSignature B f.1) (columnSignature B (resolve2M B f.1 k s))
        0 1 (by omega) hs0 hs1 hs0' hs1'
        (by
          intro j hj hj0 hj1
          exact (signature_replace_outside B f.1
            (fun c => cutBit s c.1.1) (fun _ => 1) k j hj0 hj1).symm)
  | oneTwo k hl hr hd =>
      obtain ⟨hs0, hs1, hs0', hs1'⟩ :=
        resolve21_signature_swap B f.1 k hl hr
      exact weighted_adjacent_exchange_strict (physicalColumns B) k
        (physicalColumns_of_one B f.1 k hl.2)
        (physicalColumns_of_zero B f.1 (k + 1) hr.1)
        (columnSignature B f.1) (columnSignature B (resolve21 B f.1 k))
        0 2 (by omega) hs0 hs1 hs0' hs1'
        (by
          intro j hj hj0 hj1
          exact (signature_replace_outside B f.1
            (fun _ => 0) (fun _ => 1) k j hj0 hj1).symm)

/-- Termination now specializes UNCONDITIONALLY to the concrete rules:
every vertical binary table admits a finite chain ending at a table
with no further certified local resolution. This is the local form of the
terminal table has no horizontal descent: benignity is needed for that. -/
theorem concrete_resolution_terminates (B : Diagram)
    (f : VerticalBinaryTable B) :
    ∃ g : VerticalBinaryTable B,
      ResolutionReach B f g ∧
      (∀ h : VerticalBinaryTable B, ¬ LocalColumnResolution B g h) := by
  have hdec : ∀ {a b : VerticalBinaryTable B},
      LocalColumnResolution B a b →
        resolutionEnergy B b.1 < resolutionEnergy B a.1 := by
    intro a b h
    exact localColumnResolution_energy_strict B h
  exact irreducible_reduct_exists (LocalColumnResolution B)
    (fun t => resolutionEnergy B t.1) hdec f

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Mixed-column separator invariants. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- This is the pairwise formulation of the descending separator list
in Galashin--Grinberg--Liu, Definition 5.1: every mixed column to the
left has separator weakly *below* that of every mixed column to its
right (row indices increase downward). -/
def MixedSeparatorsAntitone (B : Diagram)
    (f : ShapeCell B → Fin 2) : Prop :=
  ∀ k l s t : ℕ, k < l →
    ColumnMixed B f k → ColumnMixed B f l →
    HasSeparator B f k s → HasSeparator B f l t → t ≤ s

/-- A benign vertical binary table cannot have an adjacent descent
between two mixed columns. Unlike the weaker `NoMixedMixedDescent`,
this invariant also compares mixed columns separated by pure columns. -/
theorem mixedSeparatorsAntitone_noMixedMixedDescent (B : Diagram)
    (f : ShapeCell B → Fin 2)
    (hf : VerticalBinaryIsotone B f)
    (hbenign : MixedSeparatorsAntitone B f) :
    NoMixedMixedDescent B f := by
  intro k hd hboth
  obtain ⟨hl, hr⟩ := hboth
  obtain ⟨s, hs, _⟩ := mixedColumn_exists_separator B f k hf hl
  obtain ⟨t, ht, _⟩ := mixedColumn_exists_separator B f (k + 1) hf hr
  have hts : t ≤ s :=
    hbenign k (k + 1) s t (by omega) hl hr hs ht
  obtain ⟨a, b, hrow, hcola, hcolb, haone, hbzero⟩ := hd
  have hsrow : s ≤ a.1.1 := by
    have heq := hs a hcola
    rw [haone] at heq
    by_contra hn
    have hlt : a.1.1 < s := by omega
    simp [cutBit, hlt] at heq
  have hrowt : b.1.1 < t := by
    have heq := ht b hcolb
    rw [hbzero] at heq
    by_contra hn
    have hge : ¬ b.1.1 < t := by omega
    simp [cutBit, hge] at heq
  omega

/-- Every descent in a benign skew table has an eligible certified local
resolution, with no extra assumption on the absence of mixed/mixed
descents: that fact is now proved from the separator invariant. -/
theorem benign_skew_local_resolution_exists (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (hbenign : MixedSeparatorsAntitone B f.1)
    (hd : HasBinaryDescent B f.1 k) :
    ∃ g : VerticalBinaryTable B, LocalColumnResolution B f g := by
  exact skew_local_resolution_exists B hsk f k hd
    (mixedSeparatorsAntitone_noMixedMixedDescent B f.1 f.2 hbenign)

/-- For benign skew tables, 'no possible resolution' is precisely
'no horizontal descent'. -/
theorem benign_irreducible_iff_normal (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hbenign : MixedSeparatorsAntitone B f.1) :
    (∀ g : VerticalBinaryTable B, ¬ LocalColumnResolution B f g) ↔
      IsNormalBinaryTable B f := by
  exact irreducible_iff_normal B hsk f
    (mixedSeparatorsAntitone_noMixedMixedDescent B f.1 f.2 hbenign)

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Preservation of separator order. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- In a vertically convex occupied column, a mixed binary profile
has a unique separating row. -/
theorem mixed_separator_unique (B : Diagram)
    (hconv : ColumnConvex B)
    (f : ShapeCell B → Fin 2) (k s t : ℕ)
    (hm : ColumnMixed B f k)
    (hs : HasSeparator B f k s)
    (ht : HasSeparator B f k t) : s = t := by
  obtain ⟨⟨z, hzcol, hzero⟩, ⟨o, hocol, hone⟩⟩ := hm
  have hzero_lt (u : ℕ) (hu : HasSeparator B f k u) : z.1.1 < u := by
    have hz := hu z hzcol
    rw [hzero] at hz
    by_contra hn
    have hnot : ¬ z.1.1 < u := by omega
    simp [cutBit, hnot] at hz
  have hone_ge (u : ℕ) (hu : HasSeparator B f k u) : u ≤ o.1.1 := by
    have ho := hu o hocol
    rw [hone] at ho
    by_contra hn
    have hlt : o.1.1 < u := by omega
    simp [cutBit, hlt] at ho
  have hzle : z.1.1 ≤ o.1.1 := by
    have h1 := hzero_lt s hs
    have h2 := hone_ge s hs
    omega
  have hzmem : (z.1.1, k) ∈ B := by
    have heq : (z.1.1, k) = z.1 := by
      apply Prod.ext
      · rfl
      · exact hzcol.symm
    rw [heq]
    exact z.property
  have homem : (o.1.1, k) ∈ B := by
    have heq : (o.1.1, k) = o.1 := by
      apply Prod.ext
      · rfl
      · exact hocol.symm
    rw [heq]
    exact o.property
  have hnotst : ¬ s < t := by
    intro hst
    have hmem : (s, k) ∈ B :=
      hconv k z.1.1 o.1.1 s hzmem homem
        (le_of_lt (hzero_lt s hs)) (hone_ge s hs)
    let c : ShapeCell B := ⟨(s, k), hmem⟩
    have hc_one : f c = (1 : Fin 2) := by
      have hh := hs c (by rfl)
      simpa [cutBit, c] using hh
    have hc_zero : f c = (0 : Fin 2) := by
      have hh := ht c (by rfl)
      simpa [cutBit, c, hst] using hh
    exact (by decide : (1 : Fin 2) ≠ 0) (hc_one.symm.trans hc_zero)
  have hnotts : ¬ t < s := by
    intro hts
    have hmem : (t, k) ∈ B :=
      hconv k z.1.1 o.1.1 t hzmem homem
        (le_of_lt (hzero_lt t ht)) (hone_ge t ht)
    let c : ShapeCell B := ⟨(t, k), hmem⟩
    have hc_one : f c = (1 : Fin 2) := by
      have hh := ht c (by rfl)
      simpa [cutBit, c] using hh
    have hc_zero : f c = (0 : Fin 2) := by
      have hh := hs c (by rfl)
      simpa [cutBit, c, hts] using hh
    exact (by decide : (1 : Fin 2) ≠ 0) (hc_one.symm.trans hc_zero)
  omega

/-- Outside the changed pair, mixedness and separators are unchanged. -/
theorem mixed_separator_replace_outside (B : Diagram)
    (f left right : ShapeCell B → Fin 2)
    (k j t : ℕ) (hj : j ≠ k) (hj1 : j ≠ k + 1)
    (hm : ColumnMixed B (replaceAdjacentColumns B f left right k) j)
    (hs : HasSeparator B (replaceAdjacentColumns B f left right k) j t) :
    ColumnMixed B f j ∧ HasSeparator B f j t := by
  have hz := (replaceAdjacent_hasZero_outside B f left right k j hj hj1).mp hm.1
  have ho := (replaceAdjacent_hasOne_outside B f left right k j hj hj1).mp hm.2
  refine ⟨⟨hz, ho⟩, ?_⟩
  intro c hc
  have hck : c.1.2 ≠ k := by omega
  have hck1 : c.1.2 ≠ k + 1 := by omega
  have heq := replaceAdjacentColumns_outside B f left right k c hck hck1
  have hprofile := hs c hc
  rw [heq] at hprofile
  exact hprofile

/-- Pulling back every new mixed column to an old one, by an
order-preserving index map, preserves the benign separator order. -/
theorem benign_of_ordered_profile_pullback (B : Diagram)
    (old new : ShapeCell B → Fin 2) (back : ℕ → ℕ)
    (hold : MixedSeparatorsAntitone B old)
    (hprofile : ∀ j t : ℕ, ColumnMixed B new j →
      HasSeparator B new j t →
        ColumnMixed B old (back j) ∧ HasSeparator B old (back j) t)
    (horder : ∀ j l : ℕ, j < l →
      ColumnMixed B new j → ColumnMixed B new l → back j < back l) :
    MixedSeparatorsAntitone B new := by
  intro j l s t hjl hj hl hsj htl
  obtain ⟨hjo, hso⟩ := hprofile j s hj hsj
  obtain ⟨hlo, hto⟩ := hprofile l t hl htl
  exact hold (back j) (back l) s t
    (horder j l hjl hj hl) hjo hlo hso hto

/-- Pulling a mixed token one place to the right, over a pure column,
does not change the order of mixed tokens. -/
theorem back_M1_strict (k j l : ℕ)
    (hjl : j < l) (hj : j ≠ k) (hl : l ≠ k) :
    (if j = k + 1 then k else j) <
      (if l = k + 1 then k else l) := by
  by_cases h1 : j = k + 1 <;> by_cases h2 : l = k + 1
    <;> simp only [h1, h2, ite_true, ite_false] <;> omega

/-- Pulling a mixed token one place to the left preserves its order
relative to every other mixed token. -/
theorem back_2M_strict (k j l : ℕ)
    (hjl : j < l) (_hj : j ≠ k + 1) (hl : l ≠ k + 1) :
    (if j = k then k + 1 else j) <
      (if l = k then k + 1 else l) := by
  by_cases h1 : j = k <;> by_cases h2 : l = k
    <;> simp only [h1, h2, ite_true, ite_false] <;> omega

/-- Every M1 move preserves benignity, because its mixed column moves
one position right without crossing another mixed column. -/
theorem resolveM1_preserves_benign (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hbenign : MixedSeparatorsAntitone B f)
    (hl : ColumnMixed B f k)
    (hr : ColumnPureZero B f (k + 1))
    (hcut : HasSeparator B f k s)
    (hfit : CutFitsColumn B (k + 1) s) :
    MixedSeparatorsAntitone B (resolveM1 B f k s) := by
  have hconv := skewRowIntervals_columnConvex hsk
  obtain ⟨_, _, hAfterLeft, _⟩ :=
    resolveM1_signature_swap B f k s hl hr hfit
  let back : ℕ → ℕ := fun j => if j = k + 1 then k else j
  apply benign_of_ordered_profile_pullback B f (resolveM1 B f k s) back hbenign
  · intro j t hm ht
    have hj : j ≠ k := by
      intro hj0
      subst j
      have hOne := signature_mixed B (resolveM1 B f k s) k hm
      omega
    by_cases hj1 : j = k + 1
    · subst j
      have hnewsep : HasSeparator B (resolveM1 B f k s) (k + 1) s := by
        intro c hc
        exact resolveM1_right_value B f k s c hc
      have hts : t = s :=
        mixed_separator_unique B hconv (resolveM1 B f k s)
          (k + 1) t s hm ht hnewsep
      subst t
      simpa [back] using (show
        ColumnMixed B f k ∧ HasSeparator B f k s from ⟨hl, hcut⟩)
    · have hout := mixed_separator_replace_outside B f
        (fun _ => 0) (fun c => cutBit s c.1.1) k j t hj hj1 hm ht
      simpa [back, hj1] using hout
  · intro j l hjl hj hl'
    have hj0 : j ≠ k := by
      intro he
      subst j
      have hOne := signature_mixed B (resolveM1 B f k s) k hj
      omega
    have hl0 : l ≠ k := by
      intro he
      subst l
      have hOne := signature_mixed B (resolveM1 B f k s) k hl'
      omega
    exact back_M1_strict k j l hjl hj0 hl0

/-- Every 2M move preserves benignity, moving one mixed column one
position left without crossing any other mixed column. -/
theorem resolve2M_preserves_benign (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hbenign : MixedSeparatorsAntitone B f)
    (hl : ColumnPureOne B f k)
    (hr : ColumnMixed B f (k + 1))
    (hcut : HasSeparator B f (k + 1) s)
    (hfit : CutFitsColumn B k s) :
    MixedSeparatorsAntitone B (resolve2M B f k s) := by
  have hconv := skewRowIntervals_columnConvex hsk
  obtain ⟨_, _, _, hAfterRight⟩ :=
    resolve2M_signature_swap B f k s hl hr hfit
  let back : ℕ → ℕ := fun j => if j = k then k + 1 else j
  apply benign_of_ordered_profile_pullback B f (resolve2M B f k s) back hbenign
  · intro j t hm ht
    have hj1 : j ≠ k + 1 := by
      intro hj0
      subst j
      have hOne := signature_mixed B (resolve2M B f k s) (k + 1) hm
      omega
    by_cases hj : j = k
    · subst j
      have hnewsep : HasSeparator B (resolve2M B f k s) k s := by
        intro c hc
        exact resolve2M_left_value B f k s c hc
      have hts : t = s :=
        mixed_separator_unique B hconv (resolve2M B f k s)
          k t s hm ht hnewsep
      subst t
      simpa [back] using (show
        ColumnMixed B f (k + 1) ∧ HasSeparator B f (k + 1) s from ⟨hr, hcut⟩)
    · have hout := mixed_separator_replace_outside B f
        (fun c => cutBit s c.1.1) (fun _ => 1) k j t hj hj1 hm ht
      simpa [back, hj] using hout
  · intro j l hjl hj hl'
    have hj0 : j ≠ k + 1 := by
      intro he
      subst j
      have hOne := signature_mixed B (resolve2M B f k s) (k + 1) hj
      omega
    have hl0 : l ≠ k + 1 := by
      intro he
      subst l
      have hOne := signature_mixed B (resolve2M B f k s) (k + 1) hl'
      omega
    exact back_2M_strict k j l hjl hj0 hl0

/-- A 21 move has no mixed column at either changed position, before
or after; other mixed profiles remain untouched. -/
theorem resolve21_preserves_benign (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hbenign : MixedSeparatorsAntitone B f)
    (hl : ColumnPureOne B f k)
    (hr : ColumnPureZero B f (k + 1)) :
    MixedSeparatorsAntitone B (resolve21 B f k) := by
  obtain ⟨_, _, hAfterLeft, hAfterRight⟩ :=
    resolve21_signature_swap B f k hl hr
  apply benign_of_ordered_profile_pullback B f (resolve21 B f k) id hbenign
  · intro j t hm ht
    have hj : j ≠ k := by
      intro he
      subst j
      have hOne := signature_mixed B (resolve21 B f k) k hm
      omega
    have hj1 : j ≠ k + 1 := by
      intro he
      subst j
      have hOne := signature_mixed B (resolve21 B f k) (k + 1) hm
      omega
    simpa only [id_eq] using
      (mixed_separator_replace_outside B f (fun _ => 0) (fun _ => 1)
        k j t hj hj1 hm ht)
  · intro j l hjl _ _
    exact hjl

/-- The full benign invariant is stable under each of the three
certified local moves on a skew diagram. -/
theorem localColumnResolution_preserves_benign (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : VerticalBinaryTable B}
    (h : LocalColumnResolution B f g)
    (hf : MixedSeparatorsAntitone B f.1) :
    MixedSeparatorsAntitone B g.1 := by
  cases h with
  | m1 k s hl hr hs hfit hd =>
      exact resolveM1_preserves_benign B hsk f.1 k s hf hl hr hs hfit
  | twoM k s hl hr hs hfit hd =>
      exact resolve2M_preserves_benign B hsk f.1 k s hf hl hr hs hfit
  | oneTwo k hl hr hd =>
      exact resolve21_preserves_benign B f.1 k hf hl hr

/-- Benignity survives an arbitrarily long finite sequence of
certified local resolution moves. -/
theorem resolutionReach_preserves_benign (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : VerticalBinaryTable B}
    (h : ResolutionReach B f g)
    (hf : MixedSeparatorsAntitone B f.1) :
    MixedSeparatorsAntitone B g.1 := by
  induction h with
  | refl => exact hf
  | tail hab hbc ih =>
      exact localColumnResolution_preserves_benign B hsk hbc ih

/-- Existence half of normalization: every benign vertical binary
table of skew shape reaches a horizontally and vertically monotone
binary table through certified local moves. The corresponding global assertion is established below:
uniqueness of the terminal table. -/
theorem benign_skew_normal_form_exists (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hf : MixedSeparatorsAntitone B f.1) :
    ∃ g : VerticalBinaryTable B,
      ResolutionReach B f g ∧ IsNormalBinaryTable B g ∧
      MixedSeparatorsAntitone B g.1 := by
  obtain ⟨g, hreach, hterminal⟩ := concrete_resolution_terminates B f
  have hbenign : MixedSeparatorsAntitone B g.1 :=
    resolutionReach_preserves_benign B hsk hreach hf
  have hnormal : IsNormalBinaryTable B g :=
    (benign_irreducible_iff_normal B hsk g hbenign).mp hterminal
  exact ⟨g, hreach, hnormal, hbenign⟩

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Local confluence at a three-column overlap. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The two length-three braids around a shared mixed column produce
exactly the same binary filling. This is the *endpoint identity* of
the overlapping critical pair (2M, M1). Establishing that all six
moves are eligible in a benign skew diagram is a separate geometric
obligation, and is not asserted by this identity alone. -/
theorem resolve_overlap_braid_endpoint (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ) :
    resolveM1 B
        (resolve21 B (resolve2M B f k s) (k + 1)) k s =
      resolve2M B
        (resolve21 B (resolveM1 B f (k + 1) s) k) (k + 1) s := by
  funext c
  by_cases hk : c.1.2 = k
  · have hk1 : c.1.2 ≠ k + 1 := by omega
    have hk2 : c.1.2 ≠ k + 1 + 1 := by omega
    simp [resolveM1, resolve2M, resolve21, replaceAdjacentColumns, hk]
    omega
  · by_cases hk1 : c.1.2 = k + 1
    · have hk2 : c.1.2 ≠ k + 1 + 1 := by omega
      simp [resolveM1, resolve2M, replaceAdjacentColumns, hk1]
    · by_cases hk2 : c.1.2 = k + 1 + 1
      · have hneq : k + 1 + 1 ≠ k := by omega
        simp [resolveM1, resolve2M, resolve21,
          replaceAdjacentColumns, hk2, hneq]
      · simp [resolveM1, resolve2M, resolve21,
          replaceAdjacentColumns, hk, hk1, hk2]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Disjoint local resolutions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Two adjacent-pair replacements commute when their pairs are
disjoint. All three Bender--Knuth resolution operations have precisely
this form, with replacement functions independent of the original
filling. The remaining critical peaks are the overlapping pairs. -/
theorem replaceAdjacentColumns_commute_disjoint (B : Diagram)
    (f p q u v : ShapeCell B → Fin 2) (k l : ℕ)
    (hkl : k + 1 < l) :
    replaceAdjacentColumns B (replaceAdjacentColumns B f p q k) u v l =
      replaceAdjacentColumns B (replaceAdjacentColumns B f u v l) p q k := by
  have hkl0 : k ≠ l := by omega
  have hkl1 : k ≠ l + 1 := by omega
  have hk1l0 : k + 1 ≠ l := by omega
  have hk1l1 : k + 1 ≠ l + 1 := by omega
  have hlk0 : l ≠ k := Ne.symm hkl0
  have hlk1 : l ≠ k + 1 := Ne.symm hk1l0
  have hl1k0 : l + 1 ≠ k := Ne.symm hkl1
  have hl1k1 : l + 1 ≠ k + 1 := Ne.symm hk1l1
  funext c
  by_cases hk : c.1.2 = k
  · have hk1 : c.1.2 ≠ k + 1 := by omega
    have hl : c.1.2 ≠ l := by omega
    have hl1 : c.1.2 ≠ l + 1 := by omega
    simp [replaceAdjacentColumns, hk, hkl0, hkl1]
  · by_cases hk1 : c.1.2 = k + 1
    · have hl : c.1.2 ≠ l := by omega
      have hl1 : c.1.2 ≠ l + 1 := by omega
      simp [replaceAdjacentColumns, hk1, hkl0, hk1l0]
    · by_cases hl : c.1.2 = l
      · have hl1 : c.1.2 ≠ l + 1 := by omega
        simp [replaceAdjacentColumns, hl, hlk0, hlk1]
      · by_cases hl1 : c.1.2 = l + 1
        · simp [replaceAdjacentColumns, hl1, hlk0, hl1k0]
        · simp [replaceAdjacentColumns, hk, hk1, hl, hl1]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — the geometric six-cell critical overlap. -/
namespace OrderIdealSpecializations
namespace TableauTransfer
open CanonicalBlocks

/-- A geometric cut can be realized in the two consecutive rows around it. -/
theorem cutFits_boundary_rows (B : Diagram) (hconv : ColumnConvex B)
    (j s : ℕ) (hfit : CutFitsColumn B j s) :
    0 < s ∧ (s - 1, j) ∈ B ∧ (s, j) ∈ B := by
  obtain ⟨⟨a, haj, har⟩, ⟨b, hbj, hbr⟩⟩ := hfit
  have hmemA : (a.1.1, j) ∈ B := by
    have heq : (a.1.1, j) = a.1 := Prod.ext rfl haj.symm
    rw [heq]
    exact a.property
  have hmemB : (b.1.1, j) ∈ B := by
    have heq : (b.1.1, j) = b.1 := Prod.ext rfl hbj.symm
    rw [heq]
    exact b.property
  have hspos : 0 < s := by omega
  refine ⟨hspos, ?_, ?_⟩
  · exact hconv j a.1.1 b.1.1 (s - 1) hmemA hmemB
      (by omega) (by omega)
  · exact hconv j a.1.1 b.1.1 s hmemA hmemB
      (by omega) (by omega)

/-- Transport the presence of a zero through equality on one column. -/
theorem columnHasZero_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (j : ℕ)
    (hfg : ∀ c : ShapeCell B, c.1.2 = j → f c = g c) :
    ColumnHasZero B f j ↔ ColumnHasZero B g j := by
  constructor
  · rintro ⟨c, hc, hval⟩
    exact ⟨c, hc, (hfg c hc) ▸ hval⟩
  · rintro ⟨c, hc, hval⟩
    exact ⟨c, hc, (hfg c hc).symm ▸ hval⟩

/-- Transport the presence of a one through equality on one column. -/
theorem columnHasOne_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (j : ℕ)
    (hfg : ∀ c : ShapeCell B, c.1.2 = j → f c = g c) :
    ColumnHasOne B f j ↔ ColumnHasOne B g j := by
  constructor
  · rintro ⟨c, hc, hval⟩
    exact ⟨c, hc, (hfg c hc) ▸ hval⟩
  · rintro ⟨c, hc, hval⟩
    exact ⟨c, hc, (hfg c hc).symm ▸ hval⟩

/-- Transport a mixed profile through equality on the whole column. -/
theorem columnMixed_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (j : ℕ)
    (hfg : ∀ c : ShapeCell B, c.1.2 = j → f c = g c) :
    ColumnMixed B f j ↔ ColumnMixed B g j := by
  exact and_congr (columnHasZero_congr B f g j hfg)
    (columnHasOne_congr B f g j hfg)

/-- Transport a pure zero column through equality on the whole column. -/
theorem columnPureZero_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (j : ℕ)
    (hfg : ∀ c : ShapeCell B, c.1.2 = j → f c = g c) :
    ColumnPureZero B f j ↔ ColumnPureZero B g j := by
  exact and_congr (columnHasZero_congr B f g j hfg)
    (not_congr (columnHasOne_congr B f g j hfg))

/-- Transport a pure one column through equality on the whole column. -/
theorem columnPureOne_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (j : ℕ)
    (hfg : ∀ c : ShapeCell B, c.1.2 = j → f c = g c) :
    ColumnPureOne B f j ↔ ColumnPureOne B g j := by
  exact and_congr (not_congr (columnHasZero_congr B f g j hfg))
    (columnHasOne_congr B f g j hfg)

/-- A nonempty column constantly filled with zero is zero-pure. -/
theorem pureZero_of_constant (B : Diagram)
    (g : ShapeCell B → Fin 2) (j : ℕ)
    (hne : ∃ c : ShapeCell B, c.1.2 = j)
    (hconst : ∀ c : ShapeCell B, c.1.2 = j → g c = 0) :
    ColumnPureZero B g j := by
  constructor
  · obtain ⟨c, hc⟩ := hne
    exact ⟨c, hc, hconst c hc⟩
  · rintro ⟨c, hc, ho⟩
    have hz := hconst c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)

/-- A nonempty column constantly filled with one is one-pure. -/
theorem pureOne_of_constant (B : Diagram)
    (g : ShapeCell B → Fin 2) (j : ℕ)
    (hne : ∃ c : ShapeCell B, c.1.2 = j)
    (hconst : ∀ c : ShapeCell B, c.1.2 = j → g c = 1) :
    ColumnPureOne B g j := by
  constructor
  · rintro ⟨c, hc, hz⟩
    have ho := hconst c hc
    exact (by decide : (0 : Fin 2) ≠ 1) (hz.symm.trans ho)
  · obtain ⟨c, hc⟩ := hne
    exact ⟨c, hc, hconst c hc⟩

/-- A fitted separator and the corresponding column values give mixedness. -/
theorem mixed_of_cut_profile (B : Diagram)
    (g : ShapeCell B → Fin 2) (j s : ℕ)
    (hfit : CutFitsColumn B j s)
    (hcut : HasSeparator B g j s) : ColumnMixed B g j := by
  rcases hfit with ⟨⟨a, ha, har⟩, ⟨b, hb, hbr⟩⟩
  constructor
  · refine ⟨a, ha, ?_⟩
    rw [hcut a ha]
    simp [cutBit, har]
  · refine ⟨b, hb, ?_⟩
    rw [hcut b hb]
    have hn : ¬ b.1.1 < s := by omega
    simp [cutBit, hn]

/-- The separator of a mixed column necessarily fits that column. -/
theorem mixed_separator_fits (B : Diagram)
    (hconv : ColumnConvex B)
    (f : ShapeCell B → Fin 2) (hf : VerticalBinaryIsotone B f)
    (j s : ℕ) (hm : ColumnMixed B f j)
    (hs : HasSeparator B f j s) : CutFitsColumn B j s := by
  obtain ⟨t, ht, hfit⟩ := mixedColumn_exists_separator B f j hf hm
  have heq : t = s := mixed_separator_unique B hconv f j t s hm ht hs
  simpa [heq] using hfit

/-- A row witness of a binary descent, convenient for constructing
certified steps in the critical triple. -/
theorem descent_of_values_in_row (B : Diagram)
    (g : ShapeCell B → Fin 2) (j r : ℕ)
    (hl : (r, j) ∈ B) (hr : (r, j + 1) ∈ B)
    (hzero : g ⟨(r, j + 1), hr⟩ = 0)
    (hone : g ⟨(r, j), hl⟩ = 1) :
    HasBinaryDescent B g j := by
  exact ⟨⟨(r, j), hl⟩, ⟨(r, j + 1), hr⟩,
    rfl, rfl, rfl, hone, hzero⟩

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — The overlapping three-column diamond. -/
namespace OrderIdealSpecializations
namespace TableauTransfer
open CanonicalBlocks

/-- The critical peak 2M at k, M1 at k+1 is joinable by two more
*certified* reductions on each branch. The proof constructs every
intermediate descent and every intermediate pure/mixed profile. -/
theorem critical_2M_M1_diamond (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k s : ℕ)
    (hleft : ColumnPureOne B f.1 k)
    (hmiddle : ColumnMixed B f.1 (k + 1))
    (hright : ColumnPureZero B f.1 (k + 1 + 1))
    (hcut : HasSeparator B f.1 (k + 1) s)
    (hfitL : CutFitsColumn B k s)
    (hfitR : CutFitsColumn B (k + 1 + 1) s)
    (hdescL : HasBinaryDescent B f.1 k)
    (hdescR : HasBinaryDescent B f.1 (k + 1)) :
    ∃ d : VerticalBinaryTable B,
      ResolutionReach B
        ⟨resolve2M B f.1 k s, resolve2M_vertical B f.1 k s f.2⟩ d ∧
      ResolutionReach B
        ⟨resolveM1 B f.1 (k + 1) s,
          resolveM1_vertical B f.1 (k + 1) s f.2⟩ d := by
  have hconv : ColumnConvex B := skewRowIntervals_columnConvex hsk
  have hfitM : CutFitsColumn B (k + 1) s :=
    mixed_separator_fits B hconv f.1 f.2 (k + 1) s hmiddle hcut
  obtain ⟨hspos, hleftLow, hleftHigh⟩ :=
    cutFits_boundary_rows B hconv k s hfitL
  obtain ⟨_, hmidLow, hmidHigh⟩ :=
    cutFits_boundary_rows B hconv (k + 1) s hfitM
  obtain ⟨_, hrightLow, hrightHigh⟩ :=
    cutFits_boundary_rows B hconv (k + 1 + 1) s hfitR
  let a : VerticalBinaryTable B :=
    ⟨resolve2M B f.1 k s, resolve2M_vertical B f.1 k s f.2⟩
  let a2 : VerticalBinaryTable B :=
    ⟨resolve21 B a.1 (k + 1), resolve21_vertical B a.1 (k + 1) a.2⟩
  let d : VerticalBinaryTable B :=
    ⟨resolveM1 B a2.1 k s, resolveM1_vertical B a2.1 k s a2.2⟩
  let b : VerticalBinaryTable B :=
    ⟨resolveM1 B f.1 (k + 1) s,
      resolveM1_vertical B f.1 (k + 1) s f.2⟩
  let b2 : VerticalBinaryTable B :=
    ⟨resolve21 B b.1 k, resolve21_vertical B b.1 k b.2⟩
  let e : VerticalBinaryTable B :=
    ⟨resolve2M B b2.1 (k + 1) s,
      resolve2M_vertical B b2.1 (k + 1) s b2.2⟩
  have hA_one : ColumnPureOne B a.1 (k + 1) := by
    apply pureOne_of_constant B a.1 (k + 1)
    · obtain ⟨c, hc, _⟩ := hmiddle.2
      exact ⟨c, hc⟩
    · intro c hc
      exact resolve2M_right_value B f.1 k s c hc
  have hA_right : ColumnPureZero B a.1 (k + 1 + 1) := by
    apply (columnPureZero_congr B f.1 a.1 (k + 1 + 1) ?_).mp hright
    intro c hc
    exact (resolve2M_outside B f.1 k s c (by omega) (by omega)).symm
  have hA_middle_descent : HasBinaryDescent B a.1 (k + 1) := by
    obtain ⟨c, z, hrow, hc, hz, _, hzero⟩ := hdescR
    refine ⟨c, z, hrow, hc, hz, ?_, ?_⟩
    · exact resolve2M_right_value B f.1 k s c hc
    · change resolve2M B f.1 k s z = 0
      rw [resolve2M_outside B f.1 k s z (by omega) (by omega)]
      exact hzero
  have hA_to_a2 : LocalColumnResolution B a a2 :=
    LocalColumnResolution.oneTwo a (k + 1)
      hA_one hA_right hA_middle_descent
  have hA_mixed : ColumnMixed B a.1 k := by
    apply mixed_of_cut_profile B a.1 k s hfitL
    intro c hc
    exact resolve2M_left_value B f.1 k s c hc
  have hA2_mixed : ColumnMixed B a2.1 k := by
    apply (columnMixed_congr B a.1 a2.1 k ?_).mp hA_mixed
    intro c hc
    exact (resolve21_outside B a.1 (k + 1) c
      (by omega) (by omega)).symm
  have hA2_zero : ColumnPureZero B a2.1 (k + 1) := by
    apply pureZero_of_constant B a2.1 (k + 1)
    · obtain ⟨c, hc, _⟩ := hA_one.2
      exact ⟨c, hc⟩
    · intro c hc
      exact resolve21_left_value B a.1 (k + 1) c hc
  have hA2_cut : HasSeparator B a2.1 k s := by
    intro c hc
    change resolve21 B a.1 (k + 1) c = cutBit s c.1.1
    rw [resolve21_outside B a.1 (k + 1) c
      (by omega) (by omega)]
    exact resolve2M_left_value B f.1 k s c hc
  have hA2_descent : HasBinaryDescent B a2.1 k := by
    apply descent_of_values_in_row B a2.1 k s hleftHigh hmidHigh
    · exact resolve21_left_value B a.1 (k + 1)
        ⟨(s, k + 1), hmidHigh⟩ rfl
    · change resolve21 B (resolve2M B f.1 k s) (k + 1)
        ⟨(s, k), hleftHigh⟩ = 1
      have hk0 : k ≠ k + 1 := by omega
      have hk1 : k ≠ (k + 1) + 1 := by omega
      rw [resolve21_outside B (resolve2M B f.1 k s) (k + 1)
        ⟨(s, k), hleftHigh⟩ hk0 hk1]
      rw [resolve2M_left_value B f.1 k s
        ⟨(s, k), hleftHigh⟩ rfl]
      simp [cutBit]
  have hA2_to_d : LocalColumnResolution B a2 d :=
    LocalColumnResolution.m1 a2 k s hA2_mixed hA2_zero
      hA2_cut hfitM hA2_descent
  have hB_left : ColumnPureOne B b.1 k := by
    apply (columnPureOne_congr B f.1 b.1 k ?_).mp hleft
    intro c hc
    exact (resolveM1_outside B f.1 (k + 1) s c
      (by omega) (by omega)).symm
  have hB_middle : ColumnPureZero B b.1 (k + 1) := by
    apply pureZero_of_constant B b.1 (k + 1)
    · obtain ⟨c, hc, _⟩ := hmiddle.1
      exact ⟨c, hc⟩
    · intro c hc
      exact resolveM1_left_value B f.1 (k + 1) s c hc
  have hB_left_descent : HasBinaryDescent B b.1 k := by
    obtain ⟨c, z, hrow, hc, hz, hone, _⟩ := hdescL
    refine ⟨c, z, hrow, hc, hz, ?_, ?_⟩
    · change resolveM1 B f.1 (k + 1) s c = 1
      rw [resolveM1_outside B f.1 (k + 1) s c
        (by omega) (by omega)]
      exact hone
    · exact resolveM1_left_value B f.1 (k + 1) s z hz
  have hB_to_b2 : LocalColumnResolution B b b2 :=
    LocalColumnResolution.oneTwo b k
      hB_left hB_middle hB_left_descent
  have hB2_one : ColumnPureOne B b2.1 (k + 1) := by
    apply pureOne_of_constant B b2.1 (k + 1)
    · obtain ⟨c, hc, _⟩ := hB_middle.1
      exact ⟨c, hc⟩
    · intro c hc
      exact resolve21_right_value B b.1 k c hc
  have hB_cut : HasSeparator B b.1 (k + 1 + 1) s := by
    intro c hc
    exact resolveM1_right_value B f.1 (k + 1) s c hc
  have hB_mixed : ColumnMixed B b.1 (k + 1 + 1) :=
    mixed_of_cut_profile B b.1 (k + 1 + 1) s hfitR hB_cut
  have hB2_mixed : ColumnMixed B b2.1 (k + 1 + 1) := by
    apply (columnMixed_congr B b.1 b2.1 (k + 1 + 1) ?_).mp hB_mixed
    intro c hc
    exact (resolve21_outside B b.1 k c
      (by omega) (by omega)).symm
  have hB2_cut : HasSeparator B b2.1 (k + 1 + 1) s := by
    intro c hc
    change resolve21 B b.1 k c = cutBit s c.1.1
    rw [resolve21_outside B b.1 k c
      (by omega) (by omega)]
    exact hB_cut c hc
  have hB2_descent : HasBinaryDescent B b2.1 (k + 1) := by
    apply descent_of_values_in_row B b2.1 (k + 1) (s - 1)
      hmidLow hrightLow
    · change resolve21 B (resolveM1 B f.1 (k + 1) s) k
        ⟨(s - 1, k + 1 + 1), hrightLow⟩ = 0
      have hk0 : k + 1 + 1 ≠ k := by omega
      have hk1 : k + 1 + 1 ≠ k + 1 := by omega
      rw [resolve21_outside B (resolveM1 B f.1 (k + 1) s) k
        ⟨(s - 1, k + 1 + 1), hrightLow⟩ hk0 hk1]
      rw [resolveM1_right_value B f.1 (k + 1) s
        ⟨(s - 1, k + 1 + 1), hrightLow⟩ rfl]
      have hlt : s - 1 < s := by omega
      simp [cutBit, hlt]
    · exact resolve21_right_value B b.1 k
        ⟨(s - 1, k + 1), hmidLow⟩ rfl
  have hB2_to_e : LocalColumnResolution B b2 e :=
    LocalColumnResolution.twoM b2 (k + 1) s
      hB2_one hB2_mixed hB2_cut hfitM hB2_descent
  have hdeq : d = e := by
    apply Subtype.ext
    change resolveM1 B
        (resolve21 B (resolve2M B f.1 k s) (k + 1)) k s =
      resolve2M B
        (resolve21 B (resolveM1 B f.1 (k + 1) s) k) (k + 1) s
    exact resolve_overlap_braid_endpoint B f.1 k s
  refine ⟨d, ?_, ?_⟩
  · exact Relation.ReflTransGen.head hA_to_a2
      (Relation.ReflTransGen.head hA2_to_d Relation.ReflTransGen.refl)
  · have hB2_to_d : LocalColumnResolution B b2 d := by
      rw [hdeq]
      exact hB2_to_e
    exact Relation.ReflTransGen.head hB_to_b2
      (Relation.ReflTransGen.head hB2_to_d Relation.ReflTransGen.refl)

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.1 — Packaged rule descriptions and general local confluence. -/
namespace OrderIdealSpecializations
namespace TableauTransfer
open CanonicalBlocks

/-- The three possible moves, with a cut parameter only when needed. -/
inductive BinaryResolutionRule where
  | m1 (s : ℕ)
  | twoM (s : ℕ)
  | oneTwo
  deriving DecidableEq

/-- The left replacement profile of an abstractly specified move. -/
def ruleLeft (B : Diagram) : BinaryResolutionRule → ShapeCell B → Fin 2
  | .m1 _ => fun _ => 0
  | .twoM s => fun c => cutBit s c.1.1
  | .oneTwo => fun _ => 0

/-- The right replacement profile of an abstractly specified move. -/
def ruleRight (B : Diagram) : BinaryResolutionRule → ShapeCell B → Fin 2
  | .m1 s => fun c => cutBit s c.1.1
  | .twoM _ => fun _ => 1
  | .oneTwo => fun _ => 1

/-- All three rules are instances of the same adjacent-pair replacement. -/
def runBinaryRule (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) (r : BinaryResolutionRule) : ShapeCell B → Fin 2 :=
  replaceAdjacentColumns B f (ruleLeft B r) (ruleRight B r) k

@[simp] theorem runBinaryRule_m1 (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ) :
    runBinaryRule B f k (.m1 s) = resolveM1 B f k s := rfl

@[simp] theorem runBinaryRule_twoM (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ) :
    runBinaryRule B f k (.twoM s) = resolve2M B f k s := rfl

@[simp] theorem runBinaryRule_oneTwo (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    runBinaryRule B f k .oneTwo = resolve21 B f k := rfl

/-- The rule acts on vertically monotone fillings without leaving them. -/
def runBinaryRuleVertical (B : Diagram) (f : VerticalBinaryTable B)
    (k : ℕ) (r : BinaryResolutionRule) : VerticalBinaryTable B := by
  cases r with
  | m1 s =>
      exact ⟨runBinaryRule B f.1 k (.m1 s),
        resolveM1_vertical B f.1 k s f.2⟩
  | twoM s =>
      exact ⟨runBinaryRule B f.1 k (.twoM s),
        resolve2M_vertical B f.1 k s f.2⟩
  | oneTwo =>
      exact ⟨runBinaryRule B f.1 k .oneTwo,
        resolve21_vertical B f.1 k f.2⟩

/-- The underlying filling of the certified rule is its raw replacement.
The proof is by the three constructors, and uses no added assumptions. -/
theorem runBinaryRuleVertical_val (B : Diagram)
    (f : VerticalBinaryTable B) (k : ℕ) (r : BinaryResolutionRule) :
    (runBinaryRuleVertical B f k r).1 = runBinaryRule B f.1 k r := by
  cases r <;> rfl

/-- Rule validity contains exactly the hypotheses of the existing
certified local-resolution constructors. -/
def BinaryRuleValid (B : Diagram) (f : ShapeCell B → Fin 2)
    (k : ℕ) : BinaryResolutionRule → Prop
  | .m1 s =>
      ColumnMixed B f k ∧ ColumnPureZero B f (k + 1) ∧
        HasSeparator B f k s ∧ CutFitsColumn B (k + 1) s ∧
        HasBinaryDescent B f k
  | .twoM s =>
      ColumnPureOne B f k ∧ ColumnMixed B f (k + 1) ∧
        HasSeparator B f (k + 1) s ∧ CutFitsColumn B k s ∧
        HasBinaryDescent B f k
  | .oneTwo =>
      ColumnPureOne B f k ∧ ColumnPureZero B f (k + 1) ∧
        HasBinaryDescent B f k

/-- Package a valid raw rule as one step of the original relation. -/
theorem validBinaryRule_local (B : Diagram)
    (f : VerticalBinaryTable B) (k : ℕ) (r : BinaryResolutionRule)
    (hvalid : BinaryRuleValid B f.1 k r) :
    LocalColumnResolution B f (runBinaryRuleVertical B f k r) := by
  cases r with
  | m1 s =>
      obtain ⟨hl, hr, hs, hfit, hd⟩ := hvalid
      exact LocalColumnResolution.m1 f k s hl hr hs hfit hd
  | twoM s =>
      obtain ⟨hl, hr, hs, hfit, hd⟩ := hvalid
      exact LocalColumnResolution.twoM f k s hl hr hs hfit hd
  | oneTwo =>
      obtain ⟨hl, hr, hd⟩ := hvalid
      exact LocalColumnResolution.oneTwo f k hl hr hd

/-- Conversely, every original certified step is a valid binary rule. -/
theorem local_has_binary_rule (B : Diagram)
    {f g : VerticalBinaryTable B}
    (h : LocalColumnResolution B f g) :
    ∃ (k : ℕ) (r : BinaryResolutionRule),
      BinaryRuleValid B f.1 k r ∧ runBinaryRuleVertical B f k r = g := by
  cases h with
  | m1 k s hl hr hs hfit hd =>
      exact ⟨k, .m1 s, ⟨hl, hr, hs, hfit, hd⟩, rfl⟩
  | twoM k s hl hr hs hfit hd =>
      exact ⟨k, .twoM s, ⟨hl, hr, hs, hfit, hd⟩, rfl⟩
  | oneTwo k hl hr hd =>
      exact ⟨k, .oneTwo, ⟨hl, hr, hd⟩, rfl⟩

/-- Validity of a descent is invariant under agreement on both columns. -/
theorem binaryDescent_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (k : ℕ)
    (hleft : ∀ c : ShapeCell B, c.1.2 = k → f c = g c)
    (hright : ∀ c : ShapeCell B, c.1.2 = k + 1 → f c = g c) :
    HasBinaryDescent B f k ↔ HasBinaryDescent B g k := by
  constructor
  · rintro ⟨c, d, hrow, hc, hd, hone, hzero⟩
    refine ⟨c, d, hrow, hc, hd, ?_, ?_⟩
    · exact (hleft c hc) ▸ hone
    · exact (hright d hd) ▸ hzero
  · rintro ⟨c, d, hrow, hc, hd, hone, hzero⟩
    refine ⟨c, d, hrow, hc, hd, ?_, ?_⟩
    · exact (hleft c hc).symm ▸ hone
    · exact (hright d hd).symm ▸ hzero

/-- Validity of *any* of the three rules transports when the underlying
filling agrees on the two involved columns. -/
theorem binaryRuleValid_congr (B : Diagram)
    (f g : ShapeCell B → Fin 2) (k : ℕ) (r : BinaryResolutionRule)
    (hl : ∀ c : ShapeCell B, c.1.2 = k → f c = g c)
    (hr : ∀ c : ShapeCell B, c.1.2 = k + 1 → f c = g c) :
    BinaryRuleValid B f k r ↔ BinaryRuleValid B g k r := by
  have hcutLeft (s : ℕ) :
      HasSeparator B f k s ↔ HasSeparator B g k s := by
    constructor
    · intro h c hc
      exact (hl c hc) ▸ (h c hc)
    · intro h c hc
      exact (hl c hc).symm ▸ (h c hc)
  have hcutRight (s : ℕ) :
      HasSeparator B f (k + 1) s ↔
        HasSeparator B g (k + 1) s := by
    constructor
    · intro h c hc
      exact (hr c hc) ▸ (h c hc)
    · intro h c hc
      exact (hr c hc).symm ▸ (h c hc)
  have hdesc := binaryDescent_congr B f g k hl hr
  cases r with
  | m1 s =>
      simp only [BinaryRuleValid]
      exact and_congr (columnMixed_congr B f g k hl)
        (and_congr (columnPureZero_congr B f g (k + 1) hr)
          (and_congr (hcutLeft s) (and_congr Iff.rfl hdesc)))
  | twoM s =>
      simp only [BinaryRuleValid]
      exact and_congr (columnPureOne_congr B f g k hl)
        (and_congr (columnMixed_congr B f g (k + 1) hr)
          (and_congr (hcutRight s) (and_congr Iff.rfl hdesc)))
  | oneTwo =>
      simp only [BinaryRuleValid]
      exact and_congr (columnPureOne_congr B f g k hl)
        (and_congr (columnPureZero_congr B f g (k + 1) hr) hdesc)

/-- Outside its adjacent pair, a packaged rule leaves the filling fixed. -/
theorem binaryRule_outside (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) (r : BinaryResolutionRule)
    (c : ShapeCell B) (hk : c.1.2 ≠ k) (hk1 : c.1.2 ≠ k + 1) :
    runBinaryRule B f k r c = f c :=
  replaceAdjacentColumns_outside B f (ruleLeft B r)
    (ruleRight B r) k c hk hk1

/-- Executing two disjoint packaged moves commutes on the nose. -/
theorem binaryRules_commute_disjoint (B : Diagram)
    (f : ShapeCell B → Fin 2) (k l : ℕ)
    (r t : BinaryResolutionRule) (hkl : k + 1 < l) :
    runBinaryRule B (runBinaryRule B f k r) l t =
      runBinaryRule B (runBinaryRule B f l t) k r := by
  exact replaceAdjacentColumns_commute_disjoint B f
    (ruleLeft B r) (ruleRight B r)
    (ruleLeft B t) (ruleRight B t) k l hkl

/-- A concrete one-step diamond on disjoint adjacent pairs, including
both transported validity proofs, rather than just an equality of raw
fillings. -/
theorem disjoint_binary_rules_diamond (B : Diagram)
    (f : VerticalBinaryTable B) (k l : ℕ)
    (r t : BinaryResolutionRule) (hkl : k + 1 < l)
    (hr : BinaryRuleValid B f.1 k r)
    (ht : BinaryRuleValid B f.1 l t) :
    ∃ d : VerticalBinaryTable B,
      ResolutionReach B (runBinaryRuleVertical B f k r) d ∧
      ResolutionReach B (runBinaryRuleVertical B f l t) d := by
  let a := runBinaryRuleVertical B f k r
  let b := runBinaryRuleVertical B f l t
  have ha_val : a.1 = runBinaryRule B f.1 k r := by
    exact runBinaryRuleVertical_val B f k r
  have hb_val : b.1 = runBinaryRule B f.1 l t := by
    exact runBinaryRuleVertical_val B f l t
  have hta : BinaryRuleValid B a.1 l t := by
    apply (binaryRuleValid_congr B f.1 a.1 l t ?_ ?_).mp ht
    · intro c hc
      rw [ha_val]
      exact (binaryRule_outside B f.1 k r c
        (by omega) (by omega)).symm
    · intro c hc
      rw [ha_val]
      exact (binaryRule_outside B f.1 k r c
        (by omega) (by omega)).symm
  have hrb : BinaryRuleValid B b.1 k r := by
    apply (binaryRuleValid_congr B f.1 b.1 k r ?_ ?_).mp hr
    · intro c hc
      rw [hb_val]
      exact (binaryRule_outside B f.1 l t c
        (by omega) (by omega)).symm
    · intro c hc
      rw [hb_val]
      exact (binaryRule_outside B f.1 l t c
        (by omega) (by omega)).symm
  let d := runBinaryRuleVertical B a l t
  let e := runBinaryRuleVertical B b k r
  have hde : d = e := by
    apply Subtype.ext
    change d.1 = e.1
    have hd_val : d.1 = runBinaryRule B a.1 l t := by
      exact runBinaryRuleVertical_val B a l t
    have he_val : e.1 = runBinaryRule B b.1 k r := by
      exact runBinaryRuleVertical_val B b k r
    rw [hd_val, he_val, ha_val, hb_val]
    exact binaryRules_commute_disjoint B f.1 k l r t hkl
  have had : LocalColumnResolution B a d :=
    validBinaryRule_local B a l t hta
  have hbe : LocalColumnResolution B b e :=
    validBinaryRule_local B b k r hrb
  refine ⟨d, ?_, ?_⟩
  · exact Relation.ReflTransGen.head had Relation.ReflTransGen.refl
  · have hbd : LocalColumnResolution B b d := by
      rw [hde]
      exact hbe
    exact Relation.ReflTransGen.head hbd Relation.ReflTransGen.refl

/-- If two valid rules share the same left index, they necessarily
have identical output. Any two purported separators agree by vertical
convexity. -/
theorem same_index_binary_rule_unique (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (r t : BinaryResolutionRule)
    (hr : BinaryRuleValid B f.1 k r)
    (ht : BinaryRuleValid B f.1 k t) :
    runBinaryRuleVertical B f k r =
      runBinaryRuleVertical B f k t := by
  have hconv := skewRowIntervals_columnConvex hsk
  cases r with
  | m1 s =>
      obtain ⟨hM, hZ, hs, _, _⟩ := hr
      cases t with
      | m1 u =>
          obtain ⟨_, _, hu, _, _⟩ := ht
          have heq : s = u :=
            mixed_separator_unique B hconv f.1 k s u hM hs hu
          subst u
          rfl
      | twoM u =>
          exact False.elim (ht.1.1 hM.1)
      | oneTwo =>
          exact False.elim (ht.1.1 hM.1)
  | twoM s =>
      obtain ⟨hO, hM, hs, _, _⟩ := hr
      cases t with
      | m1 u =>
          exact False.elim (hO.1 ht.1.1)
      | twoM u =>
          obtain ⟨_, _, hu, _, _⟩ := ht
          have heq : s = u :=
            mixed_separator_unique B hconv f.1 (k + 1) s u hM hs hu
          subst u
          rfl
      | oneTwo =>
          exact False.elim (ht.2.1.2 hM.2)
  | oneTwo =>
      obtain ⟨hO, hZ, _⟩ := hr
      cases t with
      | m1 u =>
          exact False.elim (hO.1 ht.1.1)
      | twoM u =>
          exact False.elim (hZ.2 ht.2.1.2)
      | oneTwo =>
          rfl

/-- The unique overlapping pattern is 2M on the left and M1 on the
right. Its genuine three-step joining diagram was constructed above. -/
theorem adjacent_binary_rules_diamond (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B) (k : ℕ)
    (r t : BinaryResolutionRule)
    (hr : BinaryRuleValid B f.1 k r)
    (ht : BinaryRuleValid B f.1 (k + 1) t) :
    ∃ d : VerticalBinaryTable B,
      ResolutionReach B (runBinaryRuleVertical B f k r) d ∧
      ResolutionReach B (runBinaryRuleVertical B f (k + 1) t) d := by
  have hconv := skewRowIntervals_columnConvex hsk
  cases r with
  | m1 s =>
      obtain ⟨_, hZ, _, _, _⟩ := hr
      cases t with
      | m1 u =>
          exact False.elim (hZ.2 ht.1.2)
      | twoM u =>
          exact False.elim (hZ.2 ht.1.2)
      | oneTwo =>
          exact False.elim (hZ.2 ht.1.2)
  | twoM s =>
      obtain ⟨hO, hM, hs, hfitL, hdL⟩ := hr
      cases t with
      | m1 u =>
          obtain ⟨hm2, hZ, hu, hfitR, hdR⟩ := ht
          have heq : s = u :=
            mixed_separator_unique B hconv f.1 (k + 1) s u hM hs hu
          subst u
          exact critical_2M_M1_diamond B hsk f k s
            hO hM hZ hs hfitL hfitR hdL hdR
      | twoM u =>
          exact False.elim (ht.1.1 hM.1)
      | oneTwo =>
          exact False.elim (ht.1.1 hM.1)
  | oneTwo =>
      obtain ⟨_, hZ, _⟩ := hr
      cases t with
      | m1 u =>
          exact False.elim (hZ.2 ht.1.2)
      | twoM u =>
          exact False.elim (hZ.2 ht.1.2)
      | oneTwo =>
          exact False.elim (hZ.2 ht.1.2)

/-- Concrete local confluence for *every* certified one-step pair on a
skew row diagram. This discharges Newman's critical hypothesis. -/
theorem localColumnResolution_locally_joinable (B : Diagram)
    (hsk : SkewRowIntervals B) :
    LocallyJoinable (LocalColumnResolution B) := by
  intro f g h hfg hfh
  obtain ⟨k, r, hr, hgeq⟩ := local_has_binary_rule B hfg
  obtain ⟨l, t, ht, hheq⟩ := local_has_binary_rule B hfh
  subst g
  subst h
  by_cases heq : k = l
  · subst l
    have hsame := same_index_binary_rule_unique B hsk f k r t hr ht
    refine ⟨runBinaryRuleVertical B f k r,
      Relation.ReflTransGen.refl, ?_⟩
    rw [← hsame]
  · by_cases hkl : k + 1 < l
    · exact disjoint_binary_rules_diamond B f k l r t hkl hr ht
    · by_cases hlk : l + 1 < k
      · obtain ⟨d, hld, hkd⟩ :=
          disjoint_binary_rules_diamond B f l k t r hlk ht hr
        exact ⟨d, hkd, hld⟩
      · have hadj : l = k + 1 ∨ k = l + 1 := by omega
        rcases hadj with hl | hk
        · subst l
          exact adjacent_binary_rules_diamond B hsk f k r t hr ht
        · subst k
          obtain ⟨d, hld, hkd⟩ :=
            adjacent_binary_rules_diamond B hsk f l t r ht hr
          exact ⟨d, hkd, hld⟩

/-- The local normalization theorem: every benign skew vertical binary
filling has a unique reachable normal binary filling. -/
theorem benign_skew_normal_form_exists_unique (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hf : MixedSeparatorsAntitone B f.1) :
    ∃! g : VerticalBinaryTable B,
      ResolutionReach B f g ∧ IsNormalBinaryTable B g := by
  obtain ⟨g, hfg, hnorm, _⟩ :=
    benign_skew_normal_form_exists B hsk f hf
  refine ⟨g, ⟨hfg, hnorm⟩, ?_⟩
  intro h ⟨hfh, hnormh⟩
  have hdec : ∀ {a b : VerticalBinaryTable B},
      LocalColumnResolution B a b →
        resolutionEnergy B b.1 < resolutionEnergy B a.1 := by
    intro a b hstep
    exact localColumnResolution_energy_strict B hstep
  have hgn : IsIrreducible (LocalColumnResolution B) g :=
    normal_no_resolution B g hnorm
  have hhn : IsIrreducible (LocalColumnResolution B) h :=
    normal_no_resolution B h hnormh
  have heq := unique_irreducible_reduct
    (LocalColumnResolution B) (fun q => resolutionEnergy B q.1)
    hdec (localColumnResolution_locally_joinable B hsk)
    f g h hfg hfh hgn hhn
  exact heq.symm

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Lemma 5.1: flip invariants and abstract involution. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Existence of a zero after flipping is equivalent to existence of
an old one, column by column. -/
theorem columnHasZero_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    ColumnHasZero B (flipPureColumns B f) k ↔ ColumnHasOne B f k := by
  constructor
  · intro hz
    have hm : k ∈ rawZeroColumns B (flipPureColumns B f) :=
      (mem_rawZeroColumns (flipPureColumns B f) k).2 hz
    rw [rawZeroColumns_flip_eq_rawOneColumns] at hm
    exact (mem_rawOneColumns f k).1 hm
  · intro ho
    have hm : k ∈ rawOneColumns B f :=
      (mem_rawOneColumns f k).2 ho
    rw [← rawZeroColumns_flip_eq_rawOneColumns B f] at hm
    exact (mem_rawZeroColumns (flipPureColumns B f) k).1 hm

/-- The dual flip identity for the other colour. -/
theorem columnHasOne_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    ColumnHasOne B (flipPureColumns B f) k ↔ ColumnHasZero B f k := by
  constructor
  · intro ho
    have hm : k ∈ rawOneColumns B (flipPureColumns B f) :=
      (mem_rawOneColumns (flipPureColumns B f) k).2 ho
    rw [rawOneColumns_flip_eq_rawZeroColumns] at hm
    exact (mem_rawZeroColumns f k).1 hm
  · intro hz
    have hm : k ∈ rawZeroColumns B f :=
      (mem_rawZeroColumns f k).2 hz
    rw [← rawOneColumns_flip_eq_rawZeroColumns B f] at hm
    exact (mem_rawOneColumns (flipPureColumns B f) k).1 hm

/-- Flipping does not change whether a column is mixed. -/
theorem columnMixed_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    ColumnMixed B (flipPureColumns B f) k ↔ ColumnMixed B f k := by
  simp only [ColumnMixed, columnHasZero_flip_iff,
    columnHasOne_flip_iff, and_comm]

/-- Flipping exchanges the two kinds of nonempty pure columns. -/
theorem columnPureZero_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    ColumnPureZero B (flipPureColumns B f) k ↔ ColumnPureOne B f k := by
  unfold ColumnPureZero ColumnPureOne
  rw [columnHasZero_flip_iff, columnHasOne_flip_iff]
  exact and_comm

theorem columnPureOne_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ) :
    ColumnPureOne B (flipPureColumns B f) k ↔ ColumnPureZero B f k := by
  unfold ColumnPureOne ColumnPureZero
  rw [columnHasZero_flip_iff, columnHasOne_flip_iff]
  exact and_comm

/-- A mixed column is unchanged at every cell, not merely in counts. -/
theorem flip_mixed_pointwise (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hm : ColumnMixed B f k) (c : ShapeCell B)
    (hc : c.1.2 = k) :
    flipPureColumns B f c = f c := by
  obtain ⟨hz, ho⟩ := hm
  obtain ⟨z, hzcol, hzero⟩ := hz
  obtain ⟨o, hocol, hone⟩ := ho
  have hn0 : ¬ IsPureZeroColumn f c := by
    intro hp
    have hz' : f o = 0 := hp o (hocol.trans hc.symm)
    exact (by decide : (0 : Fin 2) ≠ 1) (hz'.symm.trans hone)
  have hn1 : ¬ IsPureOneColumn f c := by
    intro hp
    have ho' : f z = 1 := hp z (hzcol.trans hc.symm)
    exact (by decide : (0 : Fin 2) ≠ 1) (hzero.symm.trans ho')
  exact flipPureColumns_mixed f c hn0 hn1

/-- A separator in a mixed column is unaffected by the flip. -/
theorem hasSeparator_flip_iff (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hm : ColumnMixed B f k) :
    HasSeparator B (flipPureColumns B f) k s ↔
      HasSeparator B f k s := by
  constructor
  · intro h c hc
    have heq := flip_mixed_pointwise B f k hm c hc
    exact heq.symm.trans (h c hc)
  · intro h c hc
    have heq := flip_mixed_pointwise B f k hm c hc
    exact heq.trans (h c hc)

/-- The precise GGL benign invariant is preserved by flip. -/
theorem mixedSeparatorsAntitone_flip (B : Diagram)
    (f : ShapeCell B → Fin 2)
    (hf : MixedSeparatorsAntitone B f) :
    MixedSeparatorsAntitone B (flipPureColumns B f) := by
  intro k l s t hkl hmk hml hsk htl
  have hmk' : ColumnMixed B f k :=
    (columnMixed_flip_iff B f k).mp hmk
  have hml' : ColumnMixed B f l :=
    (columnMixed_flip_iff B f l).mp hml
  have hsk' : HasSeparator B f k s :=
    (hasSeparator_flip_iff B f k s hmk').mp hsk
  have htl' : HasSeparator B f l t :=
    (hasSeparator_flip_iff B f l t hml').mp htl
  exact hf k l s t hkl hmk' hml' hsk' htl'

/- Abstract normalization under a terminating local rewriting relation. -/
section FlipNormalization

variable {α : Type*}
variable (r : α → α → Prop)

/-- The reverse of any reduction path under an anti-automorphism. -/
theorem reverse_reach_of_flip (F : α ≃ α)
    (hrev : ∀ {a b : α}, r a b → r (F b) (F a))
    {a b : α} (h : Relation.ReflTransGen r a b) :
    Relation.ReflTransGen r (F b) (F a) := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      exact Relation.ReflTransGen.head (hrev hbc) ih

/-- Choose the unique normal reduct of a point. -/
noncomputable def abstractNormalForm
    (normal : α → Prop)
    (huniq : ∀ a : α, ∃! b : α,
      Relation.ReflTransGen r a b ∧ normal b)
    (a : α) : α :=
  Classical.choose (huniq a).exists

theorem abstractNormalForm_spec
    (normal : α → Prop)
    (huniq : ∀ a : α, ∃! b : α,
      Relation.ReflTransGen r a b ∧ normal b)
    (a : α) :
    Relation.ReflTransGen r a (abstractNormalForm r normal huniq a) ∧
      normal (abstractNormalForm r normal huniq a) :=
  Classical.choose_spec (huniq a).exists

/-- Uniqueness is used at the endpoint, not smuggled into a definition. -/
theorem abstractNormalForm_eq_of_reach
    (normal : α → Prop)
    (huniq : ∀ a : α, ∃! b : α,
      Relation.ReflTransGen r a b ∧ normal b)
    (a b : α)
    (hab : Relation.ReflTransGen r a b) (hb : normal b) :
    abstractNormalForm r normal huniq a = b := by
  exact (huniq a).unique
    (abstractNormalForm_spec r normal huniq a) ⟨hab, hb⟩

/-- Involutivity of flip followed by the canonical normal form.
This uses both local reversal and global normalization uniqueness. -/
theorem abstract_BK_involutive (F : α ≃ α)
    (hFinvol : ∀ a : α, F (F a) = a)
    (hrev : ∀ {a b : α}, r a b → r (F b) (F a))
    (normal : α → Prop)
    (huniq : ∀ a : α, ∃! b : α,
      Relation.ReflTransGen r a b ∧ normal b)
    (a : α) (ha : normal a) :
    abstractNormalForm r normal huniq
      (F (abstractNormalForm r normal huniq (F a))) = a := by
  have hreach : Relation.ReflTransGen r (F a)
      (abstractNormalForm r normal huniq (F a)) :=
    (abstractNormalForm_spec r normal huniq (F a)).1
  have hreverse := reverse_reach_of_flip r F hrev hreach
  rw [hFinvol] at hreverse
  exact abstractNormalForm_eq_of_reach r normal huniq _ a
    hreverse ha

/-- The normal subspace inherits the genuine generalized BK equivalence. -/
noncomputable def abstract_BK_equiv (F : α ≃ α)
    (hFinvol : ∀ a : α, F (F a) = a)
    (hrev : ∀ {a b : α}, r a b → r (F b) (F a))
    (normal : α → Prop)
    (huniq : ∀ a : α, ∃! b : α,
      Relation.ReflTransGen r a b ∧ normal b) :
    {a : α // normal a} ≃ {a : α // normal a} where
  toFun a :=
    ⟨abstractNormalForm r normal huniq (F a.1),
      (abstractNormalForm_spec r normal huniq (F a.1)).2⟩
  invFun a :=
    ⟨abstractNormalForm r normal huniq (F a.1),
      (abstractNormalForm_spec r normal huniq (F a.1)).2⟩
  left_inv := by
    intro a
    apply Subtype.ext
    exact abstract_BK_involutive r F hFinvol hrev normal huniq a.1 a.2
  right_inv := by
    intro a
    apply Subtype.ext
    exact abstract_BK_involutive r F hFinvol hrev normal huniq a.1 a.2

end FlipNormalization

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Inversion of local resolutions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- A mixed profile realizes both sides of its separating cut. -/
theorem mixedSeparator_cutFits (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hm : ColumnMixed B f k)
    (hs : HasSeparator B f k s) : CutFitsColumn B k s := by
  obtain ⟨⟨z, hzcol, hzero⟩, ⟨o, hocol, hone⟩⟩ := hm
  have hzrow : z.1.1 < s := by
    have heq := hs z hzcol
    rw [hzero] at heq
    by_contra hn
    have hn' : ¬ z.1.1 < s := by omega
    simp [cutBit, hn'] at heq
  have horow : s ≤ o.1.1 := by
    have heq := hs o hocol
    rw [hone] at heq
    by_contra hn
    have hlt : o.1.1 < s := by omega
    simp [cutBit, hlt] at heq
  exact ⟨⟨z, hzcol, hzrow⟩, ⟨o, hocol, horow⟩⟩

/-- In a nonempty pure-zero column, the raw flip is identically one. -/
theorem flip_on_pureZero (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hp : ColumnPureZero B f k)
    (c : ShapeCell B) (hc : c.1.2 = k) :
    flipPureColumns B f c = 1 := by
  have hzero : IsPureZeroColumn f c := by
    intro d hd
    have hdk : d.1.2 = k := hd.trans hc
    rcases finTwo_zero_or_one (f d) with hz | ho
    · exact hz
    · exact False.elim (hp.2 ⟨d, hdk, ho⟩)
  exact flipPureColumns_zero f c hzero

/-- In a nonempty pure-one column, the raw flip is identically zero. -/
theorem flip_on_pureOne (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hp : ColumnPureOne B f k)
    (c : ShapeCell B) (hc : c.1.2 = k) :
    flipPureColumns B f c = 0 := by
  have hone : IsPureOneColumn f c := by
    intro d hd
    have hdk : d.1.2 = k := hd.trans hc
    rcases finTwo_zero_or_one (f d) with hz | ho
    · exact False.elim (hp.1 ⟨d, hdk, hz⟩)
    · exact ho
  exact flipPureColumns_one f c hone

/-- Flipping at a cell only depends on values within its column. -/
theorem flip_congr_column (B : Diagram)
    (f g : ShapeCell B → Fin 2) (c : ShapeCell B)
    (hfg : ∀ d : ShapeCell B, d.1.2 = c.1.2 → f d = g d) :
    flipPureColumns B f c = flipPureColumns B g c := by
  classical
  have hzero : IsPureZeroColumn f c ↔ IsPureZeroColumn g c := by
    constructor
    · intro hf d hd
      exact (hfg d hd).symm.trans (hf d hd)
    · intro hg d hd
      exact (hfg d hd).trans (hg d hd)
  have hone : IsPureOneColumn f c ↔ IsPureOneColumn g c := by
    constructor
    · intro hf d hd
      exact (hfg d hd).symm.trans (hf d hd)
    · intro hg d hd
      exact (hfg d hd).trans (hg d hd)
  simp only [flipPureColumns]
  rw [← propext hzero, ← propext hone, hfg c rfl]

/-- If a mixed/zero pair is resolved, the left column becomes pure zero
and the right column becomes mixed, as actual predicates. -/
theorem resolveM1_actual_profiles (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hl : ColumnMixed B f k) (hr : ColumnPureZero B f (k + 1))
    (hfit : CutFitsColumn B (k + 1) s) :
    ColumnPureZero B (resolveM1 B f k s) k ∧
      ColumnMixed B (resolveM1 B f k s) (k + 1) := by
  have hsig := resolveM1_signature_swap B f k s hl hr hfit
  have hzero : ColumnHasZero B (resolveM1 B f k s) k := by
    rcases hl.1 with ⟨z, hz, _⟩
    exact ⟨z, hz, resolveM1_left_value B f k s z hz⟩
  have hnoone : ¬ ColumnHasOne B (resolveM1 B f k s) k := by
    rintro ⟨z, hz, ho⟩
    have hz0 := resolveM1_left_value B f k s z hz
    exact (by decide : (0 : Fin 2) ≠ 1) (hz0.symm.trans ho)
  have hmixed : ColumnMixed B (resolveM1 B f k s) (k + 1) := by
    have hfit' := fittedCut_mixed B (k + 1) s hfit
    constructor
    · obtain ⟨z, hz, hzero'⟩ := hfit'.1
      exact ⟨z, hz, (resolveM1_right_value B f k s z hz).trans hzero'⟩
    · obtain ⟨o, ho, hone'⟩ := hfit'.2
      exact ⟨o, ho, (resolveM1_right_value B f k s o ho).trans hone'⟩
  exact ⟨⟨hzero, hnoone⟩, hmixed⟩

/-- The symmetric actual profiles after a 2M resolution. -/
theorem resolve2M_actual_profiles (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (_hl : ColumnPureOne B f k) (hr : ColumnMixed B f (k + 1))
    (hfit : CutFitsColumn B k s) :
    ColumnMixed B (resolve2M B f k s) k ∧
      ColumnPureOne B (resolve2M B f k s) (k + 1) := by
  have hmixed : ColumnMixed B (resolve2M B f k s) k := by
    obtain ⟨hz, ho⟩ := fittedCut_mixed B k s hfit
    constructor
    · obtain ⟨z, hzc, hzero⟩ := hz
      exact ⟨z, hzc, (resolve2M_left_value B f k s z hzc).trans hzero⟩
    · obtain ⟨o, hoc, hone⟩ := ho
      exact ⟨o, hoc, (resolve2M_left_value B f k s o hoc).trans hone⟩
  have hnonzero : ¬ ColumnHasZero B (resolve2M B f k s) (k + 1) := by
    rintro ⟨z, hzc, hzero⟩
    have hone := resolve2M_right_value B f k s z hzc
    exact (by decide : (0 : Fin 2) ≠ 1) (hzero.symm.trans hone)
  have hone : ColumnHasOne B (resolve2M B f k s) (k + 1) := by
    obtain ⟨o, hoc, _⟩ := hr.2
    exact ⟨o, hoc, resolve2M_right_value B f k s o hoc⟩
  exact ⟨hmixed, ⟨hnonzero, hone⟩⟩

/-- The two pure-column signatures are exchanged by 21. -/
theorem resolve21_actual_profiles (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hl : ColumnPureOne B f k) (hr : ColumnPureZero B f (k + 1)) :
    ColumnPureZero B (resolve21 B f k) k ∧
      ColumnPureOne B (resolve21 B f k) (k + 1) := by
  have hzero : ColumnHasZero B (resolve21 B f k) k := by
    obtain ⟨z, hzc, _⟩ := hl.2
    exact ⟨z, hzc, resolve21_left_value B f k z hzc⟩
  have hnoone : ¬ ColumnHasOne B (resolve21 B f k) k := by
    rintro ⟨z, hzc, hone⟩
    have hzero' := resolve21_left_value B f k z hzc
    exact (by decide : (0 : Fin 2) ≠ 1) (hzero'.symm.trans hone)
  have hnonzero : ¬ ColumnHasZero B (resolve21 B f k) (k + 1) := by
    rintro ⟨z, hzc, hzero'⟩
    have hone := resolve21_right_value B f k z hzc
    exact (by decide : (0 : Fin 2) ≠ 1) (hzero'.symm.trans hone)
  have hone : ColumnHasOne B (resolve21 B f k) (k + 1) := by
    obtain ⟨o, hoc, _⟩ := hr.1
    exact ⟨o, hoc, resolve21_right_value B f k o hoc⟩
  exact ⟨⟨hzero, hnoone⟩, ⟨hnonzero, hone⟩⟩

/-- Algebraic reversal of M1 by 2M after flipping. -/
theorem flip_resolveM1_reverse (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hl : ColumnMixed B f k) (hr : ColumnPureZero B f (k + 1))
    (hs : HasSeparator B f k s)
    (hfit : CutFitsColumn B (k + 1) s) :
    resolve2M B (flipPureColumns B (resolveM1 B f k s)) k s =
      flipPureColumns B f := by
  have hpost := (resolveM1_actual_profiles B f k s hl hr hfit)
  funext c
  by_cases hc : c.1.2 = k
  · rw [resolve2M_left_value B _ k s c hc]
    rw [flip_mixed_pointwise B f k hl c hc, hs c hc]
  · by_cases hc1 : c.1.2 = k + 1
    · rw [resolve2M_right_value B _ k s c hc1]
      exact (flip_on_pureZero B f (k + 1) hr c hc1).symm
    · rw [resolve2M_outside B _ k s c hc hc1]
      apply flip_congr_column B (resolveM1 B f k s) f c
      intro d hd
      have hdk : d.1.2 ≠ k := by omega
      have hdk1 : d.1.2 ≠ k + 1 := by omega
      exact resolveM1_outside B f k s d hdk hdk1

/-- Algebraic reversal of 2M by M1 after flipping. -/
theorem flip_resolve2M_reverse (B : Diagram)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hl : ColumnPureOne B f k) (hr : ColumnMixed B f (k + 1))
    (hs : HasSeparator B f (k + 1) s)
    (_hfit : CutFitsColumn B k s) :
    resolveM1 B (flipPureColumns B (resolve2M B f k s)) k s =
      flipPureColumns B f := by
  funext c
  by_cases hc : c.1.2 = k
  · rw [resolveM1_left_value B _ k s c hc]
    exact (flip_on_pureOne B f k hl c hc).symm
  · by_cases hc1 : c.1.2 = k + 1
    · rw [resolveM1_right_value B _ k s c hc1]
      rw [flip_mixed_pointwise B f (k + 1) hr c hc1, hs c hc1]
    · rw [resolveM1_outside B _ k s c hc hc1]
      apply flip_congr_column B (resolve2M B f k s) f c
      intro d hd
      have hdk : d.1.2 ≠ k := by omega
      have hdk1 : d.1.2 ≠ k + 1 := by omega
      exact resolve2M_outside B f k s d hdk hdk1

/-- The 21 flip reversal is algebraically self-dual. -/
theorem flip_resolve21_reverse (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hl : ColumnPureOne B f k) (hr : ColumnPureZero B f (k + 1)) :
    resolve21 B (flipPureColumns B (resolve21 B f k)) k =
      flipPureColumns B f := by
  funext c
  by_cases hc : c.1.2 = k
  · rw [resolve21_left_value B _ k c hc]
    exact (flip_on_pureOne B f k hl c hc).symm
  · by_cases hc1 : c.1.2 = k + 1
    · rw [resolve21_right_value B _ k c hc1]
      exact (flip_on_pureZero B f (k + 1) hr c hc1).symm
    · rw [resolve21_outside B _ k c hc hc1]
      apply flip_congr_column B (resolve21 B f k) f c
      intro d hd
      have hdk : d.1.2 ≠ k := by omega
      have hdk1 : d.1.2 ≠ k + 1 := by omega
      exact resolve21_outside B f k d hdk hdk1

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Reverse descent geometry. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The reversed M1 operation has a genuine descent after flipping.
The crucial overlapping low row is supplied by skew rectangle convexity. -/
theorem flip_resolveM1_hasDescent (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hm : ColumnMixed B f k)
    (hp : ColumnPureZero B f (k + 1))
    (hcut : HasSeparator B f k s)
    (hfit : CutFitsColumn B (k + 1) s)
    (hd : HasBinaryDescent B f k) :
    HasBinaryDescent B
      (flipPureColumns B (resolveM1 B f k s)) k := by
  obtain ⟨z, hzcol, hzero⟩ := hm.1
  obtain ⟨a, b, hrow, hacol, hbcol, haone, _⟩ := hd
  have hzrow : z.1.1 < s := by
    have hval := hcut z hzcol
    rw [hzero] at hval
    by_contra hn
    have hr : ¬ z.1.1 < s := by omega
    simp [cutBit, hr] at hval
  have haabove : s ≤ a.1.1 := by
    have hval := hcut a hacol
    rw [haone] at hval
    by_contra hn
    have hr : a.1.1 < s := by omega
    simp [cutBit, hr] at hval
  have hbrge : s ≤ b.1.1 := by omega
  have hrightCell : (z.1.1, k + 1) ∈ B := by
    apply skewRowIntervals_rectangle B hsk z.1 b.1
      (z.1.1, k + 1) z.property b.property
    · omega
    · omega
    · omega
    · omega
  let d : ShapeCell B := ⟨(z.1.1, k + 1), hrightCell⟩
  have hprofile := resolveM1_actual_profiles B f k s hm hp hfit
  have hzflip : flipPureColumns B (resolveM1 B f k s) z = 1 :=
    flip_on_pureZero B (resolveM1 B f k s) k hprofile.1 z hzcol
  have hdflip : flipPureColumns B (resolveM1 B f k s) d = 0 := by
    rw [flip_mixed_pointwise B (resolveM1 B f k s)
      (k + 1) hprofile.2 d (by rfl)]
    rw [resolveM1_right_value B f k s d (by rfl)]
    simp [cutBit, d, hzrow]
  exact ⟨z, d, rfl, hzcol, rfl, hzflip, hdflip⟩

/-- The reversed 2M operation has a genuine descent after flipping.
This time the skew southwest-corner lemma supplies the high row. -/
theorem flip_resolve2M_hasDescent (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : ShapeCell B → Fin 2) (k s : ℕ)
    (hp : ColumnPureOne B f k)
    (hm : ColumnMixed B f (k + 1))
    (hcut : HasSeparator B f (k + 1) s)
    (hfit : CutFitsColumn B k s)
    (hd : HasBinaryDescent B f k) :
    HasBinaryDescent B
      (flipPureColumns B (resolve2M B f k s)) k := by
  obtain ⟨o, hocol, hone⟩ := hm.2
  obtain ⟨a, b, hrow, hacol, hbcol, _, hbzero⟩ := hd
  have horow : s ≤ o.1.1 := by
    have hval := hcut o hocol
    rw [hone] at hval
    by_contra hn
    have hr : o.1.1 < s := by omega
    simp [cutBit, hr] at hval
  have hbrow : b.1.1 < s := by
    have hval := hcut b hbcol
    rw [hbzero] at hval
    by_contra hn
    have hr : ¬ b.1.1 < s := by omega
    simp [cutBit, hr] at hval
  have ha_lt : a.1.1 ≤ o.1.1 := by omega
  have hleftCell : (o.1.1, k) ∈ B := by
    have hc := skewRowIntervals_comparable_southwest_corner B hsk
      a.1 o.1 a.property o.property ha_lt (by omega)
    have hpair : (o.1.1, a.1.2) = (o.1.1, k) := by
      exact Prod.ext rfl hacol
    rw [hpair] at hc
    exact hc
  let c : ShapeCell B := ⟨(o.1.1, k), hleftCell⟩
  have hprofile := resolve2M_actual_profiles B f k s hp hm hfit
  have hcflip : flipPureColumns B (resolve2M B f k s) c = 1 := by
    rw [flip_mixed_pointwise B (resolve2M B f k s)
      k hprofile.1 c (by rfl)]
    rw [resolve2M_left_value B f k s c (by rfl)]
    have hn : ¬ c.1.1 < s := by
      change ¬ o.1.1 < s
      omega
    simp [cutBit, hn]
  have hoflip : flipPureColumns B (resolve2M B f k s) o = 0 :=
    flip_on_pureOne B (resolve2M B f k s) (k + 1)
      hprofile.2 o hocol
  exact ⟨c, o, rfl, rfl, hocol, hcflip, hoflip⟩

/-- Flipping the result of a pure 21 resolution recreates a descent
at the same place, with the original descent witnesses. -/
theorem flip_resolve21_hasDescent (B : Diagram)
    (f : ShapeCell B → Fin 2) (k : ℕ)
    (hl : ColumnPureOne B f k)
    (hr : ColumnPureZero B f (k + 1))
    (hd : HasBinaryDescent B f k) :
    HasBinaryDescent B (flipPureColumns B (resolve21 B f k)) k := by
  obtain ⟨a, b, hrow, hacol, hbcol, _, _⟩ := hd
  have hprofile := resolve21_actual_profiles B f k hl hr
  have haflip : flipPureColumns B (resolve21 B f k) a = 1 :=
    flip_on_pureZero B (resolve21 B f k) k hprofile.1 a hacol
  have hbflip : flipPureColumns B (resolve21 B f k) b = 0 :=
    flip_on_pureOne B (resolve21 B f k) (k + 1) hprofile.2 b hbcol
  exact ⟨a, b, hrow, hacol, hbcol, haflip, hbflip⟩

/-- The completely concrete version of GGL Lemma 5.6(c).
Each of the three one-step resolutions is reversed by the raw flip. -/
theorem localColumnResolution_flip_reverse (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : VerticalBinaryTable B}
    (hfg : LocalColumnResolution B f g) :
    LocalColumnResolution B
      (flipVerticalBinaryTable B g)
      (flipVerticalBinaryTable B f) := by
  cases hfg with
  | m1 k s hl hr hs hfit hd =>
      let g : VerticalBinaryTable B :=
        ⟨resolveM1 B f.1 k s, resolveM1_vertical B f.1 k s f.2⟩
      let fg := flipVerticalBinaryTable B g
      let ff := flipVerticalBinaryTable B f
      have hprof := resolveM1_actual_profiles B f.1 k s hl hr hfit
      have hleft : ColumnPureOne B fg.1 k :=
        (columnPureOne_flip_iff B _ k).2 hprof.1
      have hright : ColumnMixed B fg.1 (k + 1) :=
        (columnMixed_flip_iff B _ (k + 1)).2 hprof.2
      have hseparator : HasSeparator B fg.1 (k + 1) s := by
        apply (hasSeparator_flip_iff B _ (k + 1) s hprof.2).2
        intro c hc
        exact resolveM1_right_value B f.1 k s c hc
      have hfitLeft : CutFitsColumn B k s :=
        mixedSeparator_cutFits B f.1 k s hl hs
      have hdescent : HasBinaryDescent B fg.1 k :=
        flip_resolveM1_hasDescent B hsk f.1 k s hl hr hs hfit hd
      have hstep : LocalColumnResolution B fg
          ⟨resolve2M B fg.1 k s,
            resolve2M_vertical B fg.1 k s fg.2⟩ :=
        LocalColumnResolution.twoM fg k s hleft hright
          hseparator hfitLeft hdescent
      have hsame : (⟨resolve2M B fg.1 k s,
            resolve2M_vertical B fg.1 k s fg.2⟩ : VerticalBinaryTable B) =
          ff := by
        apply Subtype.ext
        exact flip_resolveM1_reverse B f.1 k s hl hr hs hfit
      change LocalColumnResolution B fg ff
      rw [← hsame]
      exact hstep
  | twoM k s hl hr hs hfit hd =>
      let g : VerticalBinaryTable B :=
        ⟨resolve2M B f.1 k s, resolve2M_vertical B f.1 k s f.2⟩
      let fg := flipVerticalBinaryTable B g
      let ff := flipVerticalBinaryTable B f
      have hprof := resolve2M_actual_profiles B f.1 k s hl hr hfit
      have hleft : ColumnMixed B fg.1 k :=
        (columnMixed_flip_iff B _ k).2 hprof.1
      have hright : ColumnPureZero B fg.1 (k + 1) :=
        (columnPureZero_flip_iff B _ (k + 1)).2 hprof.2
      have hseparator : HasSeparator B fg.1 k s := by
        apply (hasSeparator_flip_iff B _ k s hprof.1).2
        intro c hc
        exact resolve2M_left_value B f.1 k s c hc
      have hfitRight : CutFitsColumn B (k + 1) s :=
        mixedSeparator_cutFits B f.1 (k + 1) s hr hs
      have hdescent : HasBinaryDescent B fg.1 k :=
        flip_resolve2M_hasDescent B hsk f.1 k s hl hr hs hfit hd
      have hstep : LocalColumnResolution B fg
          ⟨resolveM1 B fg.1 k s,
            resolveM1_vertical B fg.1 k s fg.2⟩ :=
        LocalColumnResolution.m1 fg k s hleft hright
          hseparator hfitRight hdescent
      have hsame : (⟨resolveM1 B fg.1 k s,
            resolveM1_vertical B fg.1 k s fg.2⟩ : VerticalBinaryTable B) =
          ff := by
        apply Subtype.ext
        exact flip_resolve2M_reverse B f.1 k s hl hr hs hfit
      change LocalColumnResolution B fg ff
      rw [← hsame]
      exact hstep
  | oneTwo k hl hr hd =>
      let g : VerticalBinaryTable B :=
        ⟨resolve21 B f.1 k, resolve21_vertical B f.1 k f.2⟩
      let fg := flipVerticalBinaryTable B g
      let ff := flipVerticalBinaryTable B f
      have hprof := resolve21_actual_profiles B f.1 k hl hr
      have hleft : ColumnPureOne B fg.1 k :=
        (columnPureOne_flip_iff B _ k).2 hprof.1
      have hright : ColumnPureZero B fg.1 (k + 1) :=
        (columnPureZero_flip_iff B _ (k + 1)).2 hprof.2
      have hdescent : HasBinaryDescent B fg.1 k :=
        flip_resolve21_hasDescent B f.1 k hl hr hd
      have hstep : LocalColumnResolution B fg
          ⟨resolve21 B fg.1 k,
            resolve21_vertical B fg.1 k fg.2⟩ :=
        LocalColumnResolution.oneTwo fg k hleft hright hdescent
      have hsame : (⟨resolve21 B fg.1 k,
            resolve21_vertical B fg.1 k fg.2⟩ : VerticalBinaryTable B) =
          ff := by
        apply Subtype.ext
        exact flip_resolve21_reverse B f.1 k hl hr
      change LocalColumnResolution B fg ff
      rw [← hsame]
      exact hstep

/-- GGL Lemma 5.7(c) for arbitrarily long resolution paths. -/
theorem resolutionReach_flip_reverse (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : VerticalBinaryTable B}
    (hfg : ResolutionReach B f g) :
    ResolutionReach B (flipVerticalBinaryTable B g)
      (flipVerticalBinaryTable B f) := by
  exact reverse_reach_of_flip (LocalColumnResolution B)
    (flipVerticalBinaryTable B)
    (fun {_ _} h => localColumnResolution_flip_reverse B hsk h) hfg

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Skewness of ideal differences. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The right endpoint of the cells of an ideal on a fixed row, using
zero for cells on other rows and the ambient left boundary as a floor. -/
noncomputable def idealRowCut (D : Diagram) (K : ShapeIdeal D)
    (lo : ℕ → ℕ) (r : ℕ) : ℕ := by
  classical
  exact max (lo r)
    (K.1.sup (fun c : ShapeCell D =>
      if c.1.1 = r then c.1.2 + 1 else 0))

/-- In a skew row-interval diagram, an ideal is exactly a left prefix
of every row.  Its endpoint is `idealRowCut`. -/
theorem ideal_row_iff_cut (D : Diagram) (K : ShapeIdeal D)
    (lo : ℕ → ℕ)
    (hlo : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2)
    (c : ShapeCell D) :
    c ∈ K.1 ↔ c.1.2 < idealRowCut D K lo c.1.1 := by
  classical
  constructor
  · intro hc
    have hsup : c.1.2 + 1 ≤
        K.1.sup (fun d : ShapeCell D =>
          if d.1.1 = c.1.1 then d.1.2 + 1 else 0) := by
      have h := Finset.le_sup (s := K.1)
        (f := fun d : ShapeCell D =>
          if d.1.1 = c.1.1 then d.1.2 + 1 else 0) hc
      simpa using h
    have hmax := le_max_right (lo c.1.1)
      (K.1.sup (fun d : ShapeCell D =>
        if d.1.1 = c.1.1 then d.1.2 + 1 else 0))
    unfold idealRowCut
    omega
  · intro hcut
    by_contra hnK
    have hbound : K.1.sup
        (fun d : ShapeCell D =>
          if d.1.1 = c.1.1 then d.1.2 + 1 else 0) ≤ c.1.2 := by
      apply Finset.sup_le
      intro d hd
      by_cases hdrow : d.1.1 = c.1.1
      · simp only [hdrow, ite_true]
        by_contra hn
        have hcol : c.1.2 ≤ d.1.2 := by omega
        have hcd : c ≤ d := by
          change c.1.1 ≤ d.1.1 ∧ c.1.2 ≤ d.1.2
          exact ⟨le_of_eq hdrow.symm, hcol⟩
        exact hnK (K.2 hcd hd)
      · simp [hdrow]
    have hlow := hlo c
    have hmax : max (lo c.1.1)
        (K.1.sup (fun d : ShapeCell D =>
          if d.1.1 = c.1.1 then d.1.2 + 1 else 0)) ≤ c.1.2 :=
      max_le hlow hbound
    unfold idealRowCut at hcut
    omega

/-- The right boundary of the intersection with an ideal weakly
decreases down the diagram, exactly as a skew boundary must. -/
theorem idealRowCut_antitone (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (K : ShapeIdeal D) (r : ℕ) (hr : r + 1 < n) :
    idealRowCut D K lo (r + 1) ≤ idealRowCut D K lo r := by
  classical
  unfold idealRowCut
  apply max_le
  · have := hlo r hr
    exact le_trans this (le_max_left _ _)
  · have hsup :
        K.1.sup (fun d : ShapeCell D =>
          if d.1.1 = r + 1 then d.1.2 + 1 else 0) ≤
        max (lo r) (K.1.sup (fun d : ShapeCell D =>
          if d.1.1 = r then d.1.2 + 1 else 0)) := by
      apply Finset.sup_le
      intro d hd
      by_cases hdr : d.1.1 = r + 1
      · simp only [hdr, ite_true]
        by_cases hsmall : d.1.2 < lo r
        · omega
        · have hnext : (r + 1, d.1.2) ∈ D := by
            have heq : (r + 1, d.1.2) = d.1 :=
              Prod.ext hdr.symm rfl
            rw [heq]
            exact d.property
          have hdata := (hmem (r + 1) d.1.2).mp hnext
          have hup : (r, d.1.2) ∈ D :=
            (hmem r d.1.2).mpr
              ⟨by omega, by omega,
                lt_of_lt_of_le hdata.2.2 (hhi r hr)⟩
          let u : ShapeCell D := ⟨(r, d.1.2), hup⟩
          have hud : u ≤ d := by
            change r ≤ d.1.1 ∧ d.1.2 ≤ d.1.2
            exact ⟨by omega, le_refl _⟩
          have huK : u ∈ K.1 := K.2 hud hd
          have hle := Finset.le_sup (s := K.1)
            (f := fun e : ShapeCell D =>
              if e.1.1 = r then e.1.2 + 1 else 0) huK
          have hcol : d.1.2 + 1 ≤
              K.1.sup (fun e : ShapeCell D =>
                if e.1.1 = r then e.1.2 + 1 else 0) := by
            simpa [u] using hle
          exact hcol.trans (le_max_right _ _)
      · simp only [hdr, ite_false]
        exact Nat.zero_le _
    exact hsup

/-- An interval of two ideals is a skew row-interval diagram whenever
the underlying finite diagram itself is a skew row-interval diagram. -/
theorem movingShape_skew (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D) :
    SkewRowIntervals (MovingShape D I J) := by
  classical
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  let lower : ℕ → ℕ := idealRowCut D I lo
  let upper : ℕ → ℕ := idealRowCut D J lo
  have hloCell : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
    intro c
    exact ((hmem c.1.1 c.1.2).mp c.property).2.1
  have hupper (K : ShapeIdeal D) (r : ℕ) :
      K.1.sup (fun c : ShapeCell D =>
        if c.1.1 = r then c.1.2 + 1 else 0) ≤ hi r := by
    apply Finset.sup_le
    intro c hc
    by_cases hr : c.1.1 = r
    · simp only [hr, ite_true]
      have hdata := (hmem c.1.1 c.1.2).mp c.property
      have hhi' : c.1.2 + 1 ≤ hi r := by
        have hcHi : c.1.2 < hi c.1.1 := hdata.2.2
        rw [hr] at hcHi
        omega
      exact hhi'
    · simp only [hr, ite_false]
      exact Nat.zero_le _
  refine ⟨n, lower, upper, ?_, ?_, ?_⟩
  · intro r j
    constructor
    · intro hB
      change (r, j) ∈ intervalCells D I J at hB
      rcases Finset.mem_image.mp hB with ⟨c, hc, hval⟩
      obtain ⟨hcJ, hcI⟩ := Finset.mem_sdiff.mp hc
      have heq : c.1 = (r, j) := hval
      have hcrow : c.1.1 = r := congrArg Prod.fst heq
      have hccol : c.1.2 = j := congrArg Prod.snd heq
      have hboundI : lower r ≤ j := by
        have hn := (ideal_row_iff_cut D I lo hloCell c).not.mp hcI
        have hn' : ¬ j < lower r := by
          change ¬ j < idealRowCut D I lo r
          simpa only [hcrow, hccol] using hn
        omega
      have hboundJ : j < upper r := by
        have hh := (ideal_row_iff_cut D J lo hloCell c).mp hcJ
        change j < idealRowCut D J lo r
        simpa only [hcrow, hccol] using hh
      have hrange := (hmem r j).mp (heq ▸ c.property)
      exact ⟨hrange.1, hboundI, hboundJ⟩
    · rintro ⟨hr, hlow, hhigh⟩
      have hsup := hupper J r
      have hlole : lo r ≤ lower r := by
        dsimp [lower, idealRowCut]
        exact le_max_left _ _
      have hJmax : upper r ≤ max (lo r) (hi r) := by
        dsimp [upper, idealRowCut]
        exact max_le_max (le_refl _) hsup
      have hjD : (r, j) ∈ D := by
        apply (hmem r j).mpr
        have hjhi : j < hi r := by
          by_cases hle : lo r ≤ hi r
          · have heq : max (lo r) (hi r) = hi r := max_eq_right hle
            omega
          · have heq : max (lo r) (hi r) = lo r := max_eq_left (by omega)
            omega
        exact ⟨hr, le_trans hlole hlow, hjhi⟩
      let c : ShapeCell D := ⟨(r, j), hjD⟩
      have hcJ : c ∈ J.1 := by
        apply (ideal_row_iff_cut D J lo hloCell c).mpr
        exact hhigh
      have hcI : c ∉ I.1 := by
        intro hI
        have hcut := (ideal_row_iff_cut D I lo hloCell c).mp hI
        have hbad : j < lower r := by
          change j < idealRowCut D I lo r
          simpa only [c, Subtype.coe_mk, Prod.fst, Prod.snd] using hcut
        omega
      change (r, j) ∈ (J.1 \ I.1).image (fun c : ShapeCell D => c.1)
      exact Finset.mem_image.mpr
        ⟨c, Finset.mem_sdiff.mpr ⟨hcJ, hcI⟩, rfl⟩
  · intro r hr
    exact idealRowCut_antitone D n lo hi hmem hlo hhi I r hr
  · intro r hr
    exact idealRowCut_antitone D n lo hi hmem hlo hhi J r hr

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Normal forms and reverse plane partitions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Absence of adjacent descents implies weak row increase along
all cells of any fixed row of a skew diagram. -/
theorem normal_row_isotone (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hf : IsNormalBinaryTable B f)
    (r j l : ℕ) (hj : (r, j) ∈ B)
    (hl : (r, l) ∈ B) (hjl : j ≤ l) :
    f.1 ⟨(r, j), hj⟩ ≤ f.1 ⟨(r, l), hl⟩ := by
  have hconv := skewRowIntervals_rowConvex hsk
  have aux : ∀ m : ℕ, j ≤ m → ∀ hm : (r, m) ∈ B,
      f.1 ⟨(r, j), hj⟩ ≤ f.1 ⟨(r, m), hm⟩ := by
    intro m hle
    induction m, hle using Nat.le_induction with
    | base =>
        intro hm
        exact le_refl _
    | succ m hle ih =>
        intro hnext
        have hm : (r, m) ∈ B :=
          hconv r j (m + 1) m hj hnext hle (by omega)
        have hleft : f.1 ⟨(r, j), hj⟩ ≤
            f.1 ⟨(r, m), hm⟩ := ih hm
        let c : ShapeCell B := ⟨(r, m), hm⟩
        let d : ShapeCell B := ⟨(r, m + 1), hnext⟩
        have hright : f.1 c ≤ f.1 d := by
          rcases finTwo_zero_or_one (f.1 c) with hz | ho
          · simp [hz]
          · rcases finTwo_zero_or_one (f.1 d) with hz | ho'
            · have hdesc : HasBinaryDescent B f.1 m :=
                ⟨c, d, rfl, rfl, rfl, ho, hz⟩
              exact False.elim (hf m hdesc)
            · simp [ho, ho']
        exact hleft.trans hright
  exact aux l hjl hl

/-- A vertical binary table is globally isotone exactly when there
are no horizontal descents, for skew diagrams. -/
theorem normal_binary_isotone (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hf : IsNormalBinaryTable B f) :
    FinitePoset.IsIsotone f.1 := by
  intro a b hab
  have hab' : a.1.1 ≤ b.1.1 ∧ a.1.2 ≤ b.1.2 := by
    exact hab
  have hcorner : (b.1.1, a.1.2) ∈ B :=
    skewRowIntervals_comparable_southwest_corner B hsk
      a.1 b.1 a.property b.property hab'.1 hab'.2
  let mid : ShapeCell B := ⟨(b.1.1, a.1.2), hcorner⟩
  have hvertical : f.1 a ≤ f.1 mid :=
    f.2 a mid (by rfl) hab'.1
  have hhorizontal : f.1 mid ≤ f.1 b := by
    have h := normal_row_isotone B hsk f hf
      b.1.1 a.1.2 b.1.2 hcorner b.property hab'.2
    exact h
  exact hvertical.trans hhorizontal

/-- Every normal skew table is benign, as required in Definition 5.1
of Galashin--Grinberg--Liu. -/
theorem normal_binary_benign (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : VerticalBinaryTable B)
    (hn : IsNormalBinaryTable B f) :
    MixedSeparatorsAntitone B f.1 := by
  have hconv := skewRowIntervals_columnConvex hsk
  have hmono := normal_binary_isotone B hsk f hn
  intro j l s t hjl hmj hml hs ht
  by_contra hnot
  have hst : s < t := by omega
  have hfitJ : CutFitsColumn B j s :=
    mixedSeparator_cutFits B f.1 j s hmj hs
  have hfitL : CutFitsColumn B l t :=
    mixedSeparator_cutFits B f.1 l t hml ht
  obtain ⟨_, _, hcellJ⟩ := cutFits_boundary_rows B hconv j s hfitJ
  obtain ⟨htpos, hcellL, _⟩ := cutFits_boundary_rows B hconv l t hfitL
  let a : ShapeCell B := ⟨(s, j), hcellJ⟩
  let b : ShapeCell B := ⟨(t - 1, l), hcellL⟩
  have hle : a ≤ b := by
    change s ≤ t - 1 ∧ j ≤ l
    omega
  have ha : f.1 a = 1 := by
    have hh := hs a (by rfl)
    have hnotlt : ¬ s < s := by omega
    simpa [cutBit, a, hnotlt] using hh
  have hb : f.1 b = 0 := by
    have hh := ht b (by rfl)
    have hlt : t - 1 < t := by omega
    simpa [cutBit, b, hlt] using hh
  have horder := hmono hle
  rw [ha, hb] at horder
  exact (by decide : ¬ ((1 : Fin 2) ≤ 0)) horder

/-- Extend a filling on J\I to the ambient diagram: I is frozen to
zero, the complement of J is frozen to one. -/
noncomputable def extendMovingFilling (D : Diagram)
    (I J : ShapeIdeal D)
    (f : MovingFilling D I J) : ShapeCell D → Fin 2 := by
  classical
  exact fun c =>
    if hcI : c ∈ I.1 then 0
    else if hcJ : c ∈ J.1 then
      f ⟨c.1, (moving_cell_mem_iff D I J c).mpr ⟨hcJ, hcI⟩⟩
    else 1

/-- On the moving interval, extending and restricting are inverse. -/
theorem extendMovingFilling_at_moving (D : Diagram)
    (I J : ShapeIdeal D) (f : MovingFilling D I J)
    (c : ShapeCell (MovingShape D I J)) :
    extendMovingFilling D I J f (movingCellToAmbient D I J c) = f c := by
  have hmem := (moving_cell_mem_iff D I J
    (movingCellToAmbient D I J c)).mp c.property
  simp only [extendMovingFilling, dite_eq_right hmem.2,
    dite_eq_left hmem.1]
  rfl

/-- If I⊆J and the moving filling is isotone, the extended filling
is isotone on the ambient cell poset. -/
theorem extendMovingFilling_isotone (D : Diagram)
    (I J : ShapeIdeal D) (_hIJ : I.1 ⊆ J.1)
    (f : MovingFilling D I J)
    (hf : FinitePoset.IsIsotone f) :
    FinitePoset.IsIsotone (extendMovingFilling D I J f) := by
  intro a b hab
  by_cases hbI : b ∈ I.1
  · have haI : a ∈ I.1 := I.2 hab hbI
    simp [extendMovingFilling, hbI, haI]
  · by_cases haI : a ∈ I.1
    · simp [extendMovingFilling, haI]
    · by_cases hbJ : b ∈ J.1
      · have haJ : a ∈ J.1 := J.2 hab hbJ
        have haB : a.1 ∈ MovingShape D I J :=
          (moving_cell_mem_iff D I J a).mpr ⟨haJ, haI⟩
        have hbB : b.1 ∈ MovingShape D I J :=
          (moving_cell_mem_iff D I J b).mpr ⟨hbJ, hbI⟩
        have hle : (⟨a.1, haB⟩ : ShapeCell (MovingShape D I J)) ≤
            ⟨b.1, hbB⟩ := by
          exact hab
        have hmono := hf hle
        simpa only [extendMovingFilling,
          dite_eq_right haI, dite_eq_right hbI,
          dite_eq_left haJ, dite_eq_left hbJ] using hmono
      · have hbval : extendMovingFilling D I J f b = 1 := by
          simp [extendMovingFilling, hbI, hbJ]
        rw [hbval]
        rcases finTwo_zero_or_one (extendMovingFilling D I J f a) with hz | ho
        · simp [hz]
        · simp [ho]

/-- A normal vertical interval table extends uniquely to a binary RPP. -/
noncomputable def normalToRPP (D : Diagram)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (hsk : SkewRowIntervals (MovingShape D I J))
    (f : VerticalBinaryTable (MovingShape D I J))
    (hn : IsNormalBinaryTable (MovingShape D I J) f) :
    BinaryIntervalRPP D I J := by
  classical
  let g := extendMovingFilling D I J f.1
  refine ⟨g, ?_, ?_, ?_⟩
  · exact extendMovingFilling_isotone D I J hIJ f.1
      (normal_binary_isotone (MovingShape D I J) hsk f hn)
  · intro c hc
    simp [g, extendMovingFilling, hc]
  · intro c hcJ
    have hcI : c ∉ I.1 := by
      intro hcI
      exact hcJ (hIJ hcI)
    simp [g, extendMovingFilling, hcI, hcJ]

/-- Restrict a genuine binary RPP to an explicitly normal vertical table. -/
noncomputable def rppToNormalMoving (D : Diagram)
    (I J : ShapeIdeal D) (f : BinaryIntervalRPP D I J) :
    {g : VerticalBinaryTable (MovingShape D I J) //
      IsNormalBinaryTable (MovingShape D I J) g} :=
  ⟨⟨rppMovingFilling D I J f,
    rppMovingFilling_vertical D I J f⟩,
    fun k => movingRPP_no_descent D I J f k⟩

/-- Restriction after the canonical extension recovers the moving table. -/
theorem normalToRPP_restrict (D : Diagram)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (hsk : SkewRowIntervals (MovingShape D I J))
    (f : VerticalBinaryTable (MovingShape D I J))
    (hn : IsNormalBinaryTable (MovingShape D I J) f) :
    rppMovingFilling D I J (normalToRPP D I J hIJ hsk f hn) = f.1 := by
  funext c
  exact extendMovingFilling_at_moving D I J f.1 c

/-- Conversely, extending the restriction of an ambient RPP recovers it. -/
theorem rpp_extend_restrict (D : Diagram)
    (I J : ShapeIdeal D) (_hIJ : I.1 ⊆ J.1)
    (f : BinaryIntervalRPP D I J) :
    extendMovingFilling D I J (rppMovingFilling D I J f) = f.1 := by
  funext c
  by_cases hcI : c ∈ I.1
  · have hz := f.2.2.1 c hcI
    simp [extendMovingFilling, hcI, hz]
  · by_cases hcJ : c ∈ J.1
    · have hcB : c.1 ∈ MovingShape D I J :=
        (moving_cell_mem_iff D I J c).mpr ⟨hcJ, hcI⟩
      simp only [extendMovingFilling,
        dite_eq_right hcI, dite_eq_left hcJ]
      rfl
    · have ho := f.2.2.2 c hcJ
      simp [extendMovingFilling, hcI, hcJ, ho]

/-- The RPP/normal-table identification is a true equivalence. -/
noncomputable def rppEquivNormalMoving (D : Diagram)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (hsk : SkewRowIntervals (MovingShape D I J)) :
    BinaryIntervalRPP D I J ≃
      {g : VerticalBinaryTable (MovingShape D I J) //
        IsNormalBinaryTable (MovingShape D I J) g} where
  toFun := rppToNormalMoving D I J
  invFun g := normalToRPP D I J hIJ hsk g.1 g.2
  left_inv := by
    intro f
    apply Subtype.ext
    exact rpp_extend_restrict D I J hIJ f
  right_inv := by
    intro g
    apply Subtype.ext
    apply Subtype.ext
    exact normalToRPP_restrict D I J hIJ hsk g.1 g.2

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Generalized Bender–Knuth involution. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Benign vertical tables are the natural rewriting space. -/
abbrev BenignVerticalTable (B : Diagram) :=
  {f : VerticalBinaryTable B // MixedSeparatorsAntitone B f.1}

/-- Flip is an equivalence on benign vertical tables, rather than
only on unconstrained binary fillings. -/
noncomputable def benignFlipEquiv (B : Diagram) :
    BenignVerticalTable B ≃ BenignVerticalTable B where
  toFun f :=
    ⟨flipVerticalBinaryTable B f.1,
      mixedSeparatorsAntitone_flip B f.1.1 f.2⟩
  invFun f :=
    ⟨flipVerticalBinaryTable B f.1,
      mixedSeparatorsAntitone_flip B f.1.1 f.2⟩
  left_inv := by
    intro f
    apply Subtype.ext
    apply Subtype.ext
    exact flipPureColumns_involutive B f.1.1
  right_inv := by
    intro f
    apply Subtype.ext
    apply Subtype.ext
    exact flipPureColumns_involutive B f.1.1

/-- The benign flip is its own inverse. -/
theorem benignFlip_involutive (B : Diagram)
    (f : BenignVerticalTable B) :
    benignFlipEquiv B (benignFlipEquiv B f) = f :=
  (benignFlipEquiv B).left_inv f

/-- A single local reduction, restricted to benign vertical tables. -/
def BenignResolution (B : Diagram) :
    BenignVerticalTable B → BenignVerticalTable B → Prop :=
  fun f g => LocalColumnResolution B f.1 g.1

/-- Forgetting the benign evidence maps a reduction history to the
underlying history on vertical binary tables. -/
theorem benignReach_forget (B : Diagram)
    {f g : BenignVerticalTable B}
    (h : Relation.ReflTransGen (BenignResolution B) f g) :
    ResolutionReach B f.1 g.1 := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      exact Relation.ReflTransGen.tail ih hbc

/-- The preservation of benignity from lets us lift ANY
certified resolution path to the benign subtype. -/
theorem benignReach_lift_aux (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : VerticalBinaryTable B}
    (h : ResolutionReach B f g)
    (hf : MixedSeparatorsAntitone B f.1) :
    ∃ hg : MixedSeparatorsAntitone B g.1,
      Relation.ReflTransGen (BenignResolution B)
        (⟨f, hf⟩ : BenignVerticalTable B)
        (⟨g, hg⟩ : BenignVerticalTable B) := by
  induction h with
  | refl =>
      exact ⟨hf, Relation.ReflTransGen.refl⟩
  | tail hab hbc ih =>
      obtain ⟨hb, hreach⟩ := ih
      have hc := localColumnResolution_preserves_benign B hsk hbc hb
      exact ⟨hc, Relation.ReflTransGen.tail hreach hbc⟩

/-- Lift a path between two already-certified benign tables. -/
theorem benignReach_lift (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : BenignVerticalTable B}
    (h : ResolutionReach B f.1 g.1) :
    Relation.ReflTransGen (BenignResolution B) f g := by
  obtain ⟨hg, hreach⟩ := benignReach_lift_aux B hsk h f.2
  have heq : (⟨g.1, hg⟩ : BenignVerticalTable B) = g := by
    apply Subtype.ext
    rfl
  rw [heq] at hreach
  exact hreach

/-- Uniqueness of benign normal reducts, now in the exact type used
by the abstract flip-normalization theorem. -/
theorem benign_normal_exists_unique (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : BenignVerticalTable B) :
    ∃! g : BenignVerticalTable B,
      Relation.ReflTransGen (BenignResolution B) f g ∧
        IsNormalBinaryTable B g.1 := by
  obtain ⟨g, ⟨hreach, hnorm⟩, hunique⟩ :=
    benign_skew_normal_form_exists_unique B hsk f.1 f.2
  have hg : MixedSeparatorsAntitone B g.1 :=
    resolutionReach_preserves_benign B hsk hreach f.2
  let bg : BenignVerticalTable B := ⟨g, hg⟩
  have hbg : Relation.ReflTransGen (BenignResolution B) f bg :=
    benignReach_lift B hsk hreach
  refine ⟨bg, ⟨hbg, hnorm⟩, ?_⟩
  intro z hz
  have hplain := benignReach_forget B hz.1
  have heq : z.1 = g := hunique z.1 ⟨hplain, hz.2⟩
  exact Subtype.ext heq

/-- The flip reverses every benign local step, by the concrete
three-case proof; no new hypothesis about the rewriting system. -/
theorem benignResolution_flip_reverse (B : Diagram)
    (hsk : SkewRowIntervals B)
    {f g : BenignVerticalTable B}
    (h : BenignResolution B f g) :
    BenignResolution B (benignFlipEquiv B g) (benignFlipEquiv B f) :=
  localColumnResolution_flip_reverse B hsk h

/-- The generalized Bender--Knuth involution on normal benign tables,
constructed from the unique normal form and the pure-column flip. -/
noncomputable def benignNormalBKEquiv (B : Diagram)
    (hsk : SkewRowIntervals B) :
    {f : BenignVerticalTable B // IsNormalBinaryTable B f.1} ≃
      {f : BenignVerticalTable B // IsNormalBinaryTable B f.1} :=
  abstract_BK_equiv (BenignResolution B)
    (benignFlipEquiv B)
    (benignFlip_involutive B)
    (fun {_ _} h => benignResolution_flip_reverse B hsk h)
    (fun f => IsNormalBinaryTable B f.1)
    (benign_normal_exists_unique B hsk)

/-- The normalization part of the involution preserves the two
column statistics, while the initial flip exchanges them. -/
theorem benignNormalBK_swaps_counts (B : Diagram)
    (hsk : SkewRowIntervals B)
    (f : {g : BenignVerticalTable B // IsNormalBinaryTable B g.1}) :
    (rawZeroColumns B ((benignNormalBKEquiv B hsk f).1.1.1)).card =
      (rawOneColumns B f.1.1.1).card ∧
    (rawOneColumns B ((benignNormalBKEquiv B hsk f).1.1.1)).card =
      (rawZeroColumns B f.1.1.1).card := by
  let F := benignFlipEquiv B
  let r := BenignResolution B
  let normal : BenignVerticalTable B → Prop :=
    fun g => IsNormalBinaryTable B g.1
  let huniq := benign_normal_exists_unique B hsk
  have hreached : Relation.ReflTransGen r (F f.1)
      (benignNormalBKEquiv B hsk f).1 :=
    (abstractNormalForm_spec r normal huniq (F f.1)).1
  have hunderlying : ResolutionReach B (F f.1).1
      (benignNormalBKEquiv B hsk f).1.1 :=
    benignReach_forget B hreached
  have hcounts := resolutionReach_preserves_global_counts B hunderlying
  have hflip := flipPureColumns_swaps_columnCounts B f.1.1.1
  have h0 : (F f.1).1.1 = flipPureColumns B f.1.1.1 := rfl
  rw [h0] at hcounts
  exact ⟨hcounts.1.trans hflip.1, hcounts.2.trans hflip.2⟩

/-- Each normal vertical table has the canonical benign proof. -/
noncomputable def normalBenignEquiv (B : Diagram)
    (hsk : SkewRowIntervals B) :
    {f : VerticalBinaryTable B // IsNormalBinaryTable B f} ≃
      {f : BenignVerticalTable B // IsNormalBinaryTable B f.1} where
  toFun f :=
    ⟨⟨f.1, normal_binary_benign B hsk f.1 f.2⟩, f.2⟩
  invFun f := ⟨f.1.1, f.2⟩
  left_inv := by
    intro f
    apply Subtype.ext
    rfl
  right_inv := by
    intro f
    apply Subtype.ext
    apply Subtype.ext
    rfl

end TableauTransfer
end OrderIdealSpecializations



/-! ### §5.1 — Transfer-matrix commutativity. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The canonical interval-to-normal-table equivalence.  The
hypothesis that I⊆J is used only for extending back to D. -/
noncomputable def rppEquivBenignNormal (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) :
    BinaryIntervalRPP D I J ≃
      {g : BenignVerticalTable (MovingShape D I J) //
        IsNormalBinaryTable (MovingShape D I J) g.1} :=
  (rppEquivNormalMoving D I J hIJ (movingShape_skew D hsk I J)).trans
    (normalBenignEquiv (MovingShape D I J)
      (movingShape_skew D hsk I J))

/-- The underlying moving filling of the converted normal table is
literally the restriction of the original binary RPP. -/
theorem rppEquivBenignNormal_val (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (f : BinaryIntervalRPP D I J) :
    ((rppEquivBenignNormal D hsk I J hIJ f).1.1.1) =
      rppMovingFilling D I J f := by
  rfl

/-- The first weight statistic agrees with the moving zero support. -/
theorem rppBenignNormal_zero_count (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (f : BinaryIntervalRPP D I J) :
    (rawZeroColumns (MovingShape D I J)
      ((rppEquivBenignNormal D hsk I J hIJ f).1.1.1)).card =
      (rppFirstColumns D I J f).card := by
  rw [rppEquivBenignNormal_val D hsk I J hIJ f]
  exact congrArg Finset.card (moving_zeroColumns_eq_first D I J f)

/-- The second weight statistic agrees with the moving one support. -/
theorem rppBenignNormal_one_count (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (f : BinaryIntervalRPP D I J) :
    (rawOneColumns (MovingShape D I J)
      ((rppEquivBenignNormal D hsk I J hIJ f).1.1.1)).card =
      (rppSecondColumns D I J f).card := by
  rw [rppEquivBenignNormal_val D hsk I J hIJ f]
  exact congrArg Finset.card (moving_oneColumns_eq_second D I J f)

/-- The genuine generalized Bender--Knuth equivalence on tableaux
of any interval I⊆J inside an arbitrary skew diagram D. -/
noncomputable def binaryRPPBKEquiv (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) :
    BinaryIntervalRPP D I J ≃ BinaryIntervalRPP D I J :=
  let B := MovingShape D I J
  let Q := rppEquivBenignNormal D hsk I J hIJ
  let E := benignNormalBKEquiv B (movingShape_skew D hsk I J)
  (Q.trans E).trans Q.symm

/-- Composing the three equivalences and their inverses gives the
required identity at the normal-table level. -/
theorem binaryRPPBK_conjugacy (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (f : BinaryIntervalRPP D I J) :
    rppEquivBenignNormal D hsk I J hIJ
        (binaryRPPBKEquiv D hsk I J hIJ f) =
      benignNormalBKEquiv (MovingShape D I J)
        (movingShape_skew D hsk I J)
        (rppEquivBenignNormal D hsk I J hIJ f) := by
  dsimp [binaryRPPBKEquiv]
  exact (rppEquivBenignNormal D hsk I J hIJ).apply_symm_apply _

/-- The involution exchanges the two *occupied-column* statistics,
not just the number of zero/one cells. -/
theorem binaryRPPBK_swaps_counts (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (f : BinaryIntervalRPP D I J) :
    (rppFirstColumns D I J f).card =
      (rppSecondColumns D I J
        (binaryRPPBKEquiv D hsk I J hIJ f)).card ∧
    (rppSecondColumns D I J f).card =
      (rppFirstColumns D I J
        (binaryRPPBKEquiv D hsk I J hIJ f)).card := by
  let B := MovingShape D I J
  let Q := rppEquivBenignNormal D hsk I J hIJ
  let E := benignNormalBKEquiv B (movingShape_skew D hsk I J)
  let S := binaryRPPBKEquiv D hsk I J hIJ
  have hfirst :
      (rawZeroColumns B (Q f).1.1.1).card =
        (rppFirstColumns D I J f).card :=
    rppBenignNormal_zero_count D hsk I J hIJ f
  have hsecond :
      (rawOneColumns B (Q f).1.1.1).card =
        (rppSecondColumns D I J f).card :=
    rppBenignNormal_one_count D hsk I J hIJ f
  have hfirst' :
      (rawZeroColumns B (E (Q f)).1.1.1).card =
        (rppFirstColumns D I J (S f)).card := by
    have h := rppBenignNormal_zero_count D hsk I J hIJ (S f)
    rw [binaryRPPBK_conjugacy D hsk I J hIJ f] at h
    exact h
  have hsecond' :
      (rawOneColumns B (E (Q f)).1.1.1).card =
        (rppSecondColumns D I J (S f)).card := by
    have h := rppBenignNormal_one_count D hsk I J hIJ (S f)
    rw [binaryRPPBK_conjugacy D hsk I J hIJ f] at h
    exact h
  have hswap := benignNormalBK_swaps_counts B
    (movingShape_skew D hsk I J) (Q f)
  exact ⟨hfirst.symm.trans (hswap.2.symm.trans hsecond'),
    hsecond.symm.trans (hswap.1.symm.trans hfirst')⟩

/-- If I is not contained in J, there is no binary interval RPP:
its forced zero and one conditions would disagree. -/
theorem binaryRPP_empty_of_not_subset (D : Diagram)
    (I J : ShapeIdeal D) (hIJ : ¬ I.1 ⊆ J.1) :
    IsEmpty (BinaryIntervalRPP D I J) := by
  constructor
  intro f
  apply hIJ
  intro c hc
  by_contra hnJ
  have hzero : f.1 c = 0 := f.2.2.1 c hc
  have hone : f.1 c = 1 := f.2.2.2 c hnJ
  exact (by decide : (0 : Fin 2) ≠ 1) (hzero.symm.trans hone)

/-- A genuine switching equivalence exists for every pair of ideals,
including empty intervals, without additional hypotheses. -/
noncomputable def binaryRPPColumnSwitch_skew (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D) :
    BinaryRPPColumnSwitch D I J := by
  classical
  by_cases hIJ : I.1 ⊆ J.1
  · let S := binaryRPPBKEquiv D hsk I J hIJ
    have hswitch := binaryRPPBK_swaps_counts D hsk I J hIJ
    exact ⟨S, (fun f => (hswitch f).1),
      (fun f => (hswitch f).2)⟩
  · have hf : IsEmpty (BinaryIntervalRPP D I J) :=
      binaryRPP_empty_of_not_subset D I J hIJ
    let S : BinaryIntervalRPP D I J ≃ BinaryIntervalRPP D I J :=
      Equiv.refl _
    exact ⟨S,
      (fun f => False.elim (hf.false f)),
      (fun f => False.elim (hf.false f))⟩

/-- **Lemma 5.1 (Two-color tableau transfer).**
Lemma 5.1. For EVERY finite skew diagram, the transfer
matrices commute. The proof is by the generalized Bender--Knuth
involution, and the switching hypothesis is discharged above. -/
theorem tableau_transfer_matrices_commute (D : Diagram)
    (hsk : SkewRowIntervals D) (x y : ℚ) :
    T D x * T D y = T D y * T D x := by
  apply T_commute_of_binaryRPPSwitches D
  · intro I J
    exact ⟨binaryRPPColumnSwitch_skew D hsk I J⟩

end TableauTransfer
end OrderIdealSpecializations


/-! ### §5.2 — Definition 5.2 and Lemma 5.3: vertical-strip inversion

The complete definition below matches the strip coefficient in the
manuscript.  The elementary matrix algebra and the row-group telescoping
identity are established here.  The last two geometric cancellation
identities are isolated explicitly: no inverse formula for an arbitrary
skew diagram is asserted until these have proofs.

A vertical run is a maximal contiguous string of cells in one column.
Its bottom cell has no cell immediately below it inside the strip.
Thus its number of components is the number of such bottom cells. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.2 — Definition 5.2: the coefficient of a vertical strip. -/

/-- A diagram has at most one cell in each row. -/
def IsVerticalStrip (E : Diagram) : Prop :=
  ∀ c ∈ E, ∀ d ∈ E, c.1 = d.1 → c.2 = d.2

/-- Bottom cells of consecutive vertical runs of a finite cell set. -/
noncomputable def verticalRunEnds (E : Diagram) : Finset Cell := by
  classical
  exact E.filter (fun c => (c.1 + 1, c.2) ∉ E)

/-- For a vertical strip this is its number of connected vertical runs. -/
noncomputable def verticalRunCount (E : Diagram) : ℕ :=
  (verticalRunEnds E).card

/-- The scalar weight q_x(S) of manuscript Definition 5.2.
It is zero unless S is a vertical strip. -/
noncomputable def verticalStripCoefficient (x : ℚ) (E : Diagram) : ℚ := by
  classical
  exact if IsVerticalStrip E then
    (-x) ^ verticalRunCount E *
      (1 - x) ^ (E.card - verticalRunCount E)
    else 0

/-- The identity q_x(∅)=1 is included in the uniform formula. -/
@[simp] theorem verticalStripCoefficient_empty (x : ℚ) :
    verticalStripCoefficient x (∅ : Diagram) = 1 := by
  classical
  simp [verticalStripCoefficient, IsVerticalStrip,
    verticalRunCount, verticalRunEnds]

/-- Unsupported shapes have zero coefficient. -/
theorem verticalStripCoefficient_non_vertical (x : ℚ) (E : Diagram)
    (h : ¬ IsVerticalStrip E) :
    verticalStripCoefficient x E = 0 := by
  simp [verticalStripCoefficient, h]

/-- Every run-end is a cell of its underlying strip. -/
theorem verticalRunEnds_subset (E : Diagram) :
    verticalRunEnds E ⊆ E := by
  classical
  intro c hc
  exact (Finset.mem_filter.mp hc).1

/-- The component exponent never exceeds the size of the strip. -/
theorem verticalRunCount_le_card (E : Diagram) :
    verticalRunCount E ≤ E.card := by
  classical
  exact Finset.card_le_card (verticalRunEnds_subset E)

/-- The inverse *construction* Q_x of manuscript Definition 5.2.
Every entry is defined explicitly, without referring to T_x⁻¹. -/
noncomputable def Q (D : Diagram) (x : ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then
      verticalStripCoefficient x (intervalCells D I J)
    else 0)

/-- An incident pair receives the prescribed vertical-strip coefficient. -/
theorem Q_of_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (h : I.1 ⊆ J.1) :
    Q D x I J = verticalStripCoefficient x (intervalCells D I J) := by
  change (if I.1 ⊆ J.1 then
    verticalStripCoefficient x (intervalCells D I J) else 0) = _
  exact ite_eq_left h

/-- An incomparable pair has coefficient zero. -/
theorem Q_of_not_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊆ J.1) :
    Q D x I J = 0 := by
  change (if I.1 ⊆ J.1 then
    verticalStripCoefficient x (intervalCells D I J) else 0) = 0
  exact ite_eq_right h

/-- Q_x has constant diagonal 1. -/
@[simp] theorem Q_diagonal (D : Diagram) (x : ℚ)
    (I : ShapeIdeal D) : Q D x I I = 1 := by
  rw [Q_of_subset D x I I (Finset.Subset.rfl)]
  simp [intervalCells]

/-- The coefficient vanishes when the added cells are not a vertical strip. -/
theorem Q_of_non_vertical (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (h : ¬ IsVerticalStrip (intervalCells D I J)) :
    Q D x I J = 0 := by
  rw [Q_of_subset D x I J hIJ]
  exact verticalStripCoefficient_non_vertical x _ h

/-! ### §5.2 — The polynomial derivative of the transfer family. -/

/-- Polynomial lift of the transfer matrix T_x, entry by entry. -/
noncomputable def Tpolynomial (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then
      Polynomial.X ^ columnCount (intervalCells D I J)
    else 0)

/-- Explicit entrywise derivative T'_x; for width zero it is zero. -/
noncomputable def Tprime (D : Diagram) (x : ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then
      (columnCount (intervalCells D I J) : ℚ) *
        x ^ (columnCount (intervalCells D I J) - 1)
    else 0)

/-- The derivative formula on comparable ideals. -/
theorem Tprime_of_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (h : I.1 ⊆ J.1) :
    Tprime D x I J =
      (columnCount (intervalCells D I J) : ℚ) *
        x ^ (columnCount (intervalCells D I J) - 1) := by
  change (if I.1 ⊆ J.1 then
    (columnCount (intervalCells D I J) : ℚ) *
      x ^ (columnCount (intervalCells D I J) - 1) else 0) = _
  exact ite_eq_left h

/-- The derivative also vanishes on incomparable ideals. -/
theorem Tprime_of_not_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (h : ¬ I.1 ⊆ J.1) :
    Tprime D x I J = 0 := by
  change (if I.1 ⊆ J.1 then
    (columnCount (intervalCells D I J) : ℚ) *
      x ^ (columnCount (intervalCells D I J) - 1) else 0) = 0
  exact ite_eq_right h

/-- The derivative has a zero diagonal. -/
@[simp] theorem Tprime_diagonal (D : Diagram) (x : ℚ)
    (I : ShapeIdeal D) : Tprime D x I I = 0 := by
  rw [Tprime_of_subset D x I I (Finset.Subset.rfl)]
  simp [intervalCells, columnCount]

/-- The expression Tprime is the actual formal polynomial derivative. -/
theorem Tprime_is_polynomial_derivative (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) :
    Tprime D x I J =
      (Polynomial.derivative (Tpolynomial D I J)).eval x := by
  classical
  change
    (if I.1 ⊆ J.1 then
      (columnCount (intervalCells D I J) : ℚ) *
        x ^ (columnCount (intervalCells D I J) - 1)
    else 0) =
      (Polynomial.derivative
        (if I.1 ⊆ J.1 then
          (Polynomial.X : Polynomial ℚ) ^
            columnCount (intervalCells D I J)
        else (0 : Polynomial ℚ))).eval x
  by_cases hIJ : I.1 ⊆ J.1
  · simp [hIJ, Polynomial.derivative_X_pow]
  · simp [hIJ]

/-! ### §5.3 — Lemma 5.3: finite convolution formulas and reductions. -/

/-- Exact entrywise expansion of Q_x T_x. -/
theorem Q_mul_T_entry (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) :
    (Q D x * T D x) I J =
      ∑ K : ShapeIdeal D,
        if I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 then
          verticalStripCoefficient x (intervalCells D I K) *
            x ^ columnCount (intervalCells D K J)
        else 0 := by
  classical
  rw [Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro K _
  by_cases hik : I.1 ⊆ K.1
  · by_cases hkj : K.1 ⊆ J.1
    · rw [Q_of_subset D x I K hik,
          T_of_subset D x K J hkj,
          ite_eq_left (show I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 from
            ⟨hik, hkj⟩)]
    · rw [T_of_not_subset D x K J hkj, mul_zero,
          ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
            fun hh => hkj hh.2)]
  · rw [Q_of_not_subset D x I K hik, zero_mul,
        ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
          fun hh => hik hh.1)]

/-- Exact entrywise expansion of Q_x T'_x. -/
theorem Q_mul_Tprime_entry (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) :
    (Q D x * Tprime D x) I J =
      ∑ K : ShapeIdeal D,
        if I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 then
          verticalStripCoefficient x (intervalCells D I K) *
            ((columnCount (intervalCells D K J) : ℚ) *
              x ^ (columnCount (intervalCells D K J) - 1))
        else 0 := by
  classical
  rw [Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro K _
  by_cases hik : I.1 ⊆ K.1
  · by_cases hkj : K.1 ⊆ J.1
    · rw [Q_of_subset D x I K hik,
          Tprime_of_subset D x K J hkj,
          ite_eq_left (show I.1 ⊆ K.1 ∧ K.1 ⊆ J.1 from
            ⟨hik, hkj⟩)]
    · rw [Tprime_of_not_subset D x K J hkj, mul_zero,
          ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
            fun hh => hkj hh.2)]
  · rw [Q_of_not_subset D x I K hik, zero_mul,
        ite_eq_right (show ¬(I.1 ⊆ K.1 ∧ K.1 ⊆ J.1) from
          fun hh => hik hh.1)]

/-- Both convolution products vanish off the incidence order. -/
theorem Q_mul_T_of_not_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : ¬ I.1 ⊆ J.1) :
    (Q D x * T D x) I J = 0 := by
  classical
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro K _
  by_cases hik : I.1 ⊆ K.1
  · have hkj : ¬ K.1 ⊆ J.1 := by
      intro h
      exact hIJ (hik.trans h)
    rw [T_of_not_subset D x K J hkj, mul_zero]
  · rw [Q_of_not_subset D x I K hik, zero_mul]

/-- The derivative convolution also vanishes off the incidence order. -/
theorem Q_mul_Tprime_of_not_subset (D : Diagram) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : ¬ I.1 ⊆ J.1) :
    (Q D x * Tprime D x) I J = 0 := by
  classical
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro K _
  by_cases hik : I.1 ⊆ K.1
  · have hkj : ¬ K.1 ⊆ J.1 := by
      intro h
      exact hIJ (hik.trans h)
    rw [Tprime_of_not_subset D x K J hkj, mul_zero]
  · rw [Q_of_not_subset D x I K hik, zero_mul]

/-- Every diagonal entry of Q_x T_x equals one. -/
theorem Q_mul_T_diagonal (D : Diagram) (x : ℚ)
    (I : ShapeIdeal D) : (Q D x * T D x) I I = 1 := by
  classical
  rw [Matrix.mul_apply]
  have hsum :
      (∑ K : ShapeIdeal D, Q D x I K * T D x K I) =
        Q D x I I * T D x I I := by
    apply Finset.sum_eq_single I
    · intro K _ hKI
      by_cases hik : I.1 ⊆ K.1
      · have hki : ¬ K.1 ⊆ I.1 := by
          intro h
          apply hKI
          apply Subtype.ext
          exact Finset.Subset.antisymm h hik
        rw [T_of_not_subset D x K I hki, mul_zero]
      · rw [Q_of_not_subset D x I K hik, zero_mul]
    · intro hI
      exact False.elim (hI (Finset.mem_univ I))
  rw [hsum]
  simp

/-- Every diagonal entry of Q_x T'_x equals zero. -/
theorem Q_mul_Tprime_diagonal (D : Diagram) (x : ℚ)
    (I : ShapeIdeal D) : (Q D x * Tprime D x) I I = 0 := by
  classical
  rw [Matrix.mul_apply]
  have hsum :
      (∑ K : ShapeIdeal D, Q D x I K * Tprime D x K I) =
        Q D x I I * Tprime D x I I := by
    apply Finset.sum_eq_single I
    · intro K _ hKI
      by_cases hik : I.1 ⊆ K.1
      · have hki : ¬ K.1 ⊆ I.1 := by
          intro h
          apply hKI
          apply Subtype.ext
          exact Finset.Subset.antisymm h hik
        rw [Tprime_of_not_subset D x K I hki, mul_zero]
      · rw [Q_of_not_subset D x I K hik, zero_mul]
    · intro hI
      exact False.elim (hI (Finset.mem_univ I))
  rw [hsum]
  simp

/-- The one-dimensional row-group identity used in the manuscript's
geometric strip cancellation proof (equation (5.6)). -/
theorem verticalStrip_group_telescope (x : ℚ) (r : ℕ) :
    1 + (∑ j ∈ Finset.range r, (-x) * (1 - x) ^ j) =
      (1 - x) ^ r := by
  induction r with
  | zero => simp
  | succ r ih =>
      calc
        1 + (∑ j ∈ Finset.range (r + 1),
              (-x) * (1 - x) ^ j) =
            (1 + (∑ j ∈ Finset.range r,
              (-x) * (1 - x) ^ j)) +
                (-x) * (1 - x) ^ r := by
                  rw [Finset.sum_range_succ]
                  ring
        _ = (1 - x) ^ r + (-x) * (1 - x) ^ r := by
              rw [ih]
        _ = (1 - x) ^ (r + 1) := by
              rw [pow_succ]
              ring

/-- Multiplicative form of the telescoping identity for independent
row groups: the local factorization required in (5.6). -/
theorem verticalStrip_group_product (x : ℚ) (S : Finset ℕ)
    (sizes : ℕ → ℕ) :
    (∏ i ∈ S,
      (1 + (∑ j ∈ Finset.range (sizes i),
        (-x) * (1 - x) ^ j))) =
      (1 - x) ^ (∑ i ∈ S, sizes i) := by
  simp_rw [verticalStrip_group_telescope x]
  exact Finset.prod_pow_eq_pow_sum S sizes (1 - x)

/-- The algebraic cancellation in the connected case of (5.4),
after the initial strips have been grouped. -/
theorem connected_strip_cancellation_algebra
    (x : ℚ) (h w : ℕ) :
    x ^ (w + 1) * (1 - x) ^ (h + 1) +
      (x ^ w - x ^ (w + 1)) *
        (-x * (1 - x) ^ h) = 0 := by
  simp only [pow_succ]
  ring

/-- The differentiated scalar counterpart, including the one-column
boundary case w=0 where the derivative of x^0 is zero. -/
theorem connected_strip_derivative_algebra
    (x : ℚ) (h w : ℕ) :
    ((w + 1 : ℕ) : ℚ) * x ^ w * (1 - x) ^ (h + 1) +
      (((w : ℚ) * x ^ (w - 1)) -
        ((w + 1 : ℕ) : ℚ) * x ^ w) *
        (-x * (1 - x) ^ h) =
      x ^ w * (1 - x) ^ h := by
  cases w with
  | zero =>
      simp [pow_succ]
      ring
  | succ w =>
      simp only [Nat.succ_sub_one, Nat.cast_succ, pow_succ]
      ring

/-! ### §5.3 — Initial-strip convolution and cancellation. -/

/-- A proof of the two proper-interval cancellations finishes Lemma 5.3.
This theorem is conditional on the explicitly stated geometric sums. -/
theorem lemma_5_3_of_proper_interval_sums (D : Diagram) (x : ℚ)
    (hcancel : ∀ I J : ShapeIdeal D, I.1 ⊂ J.1 →
      (Q D x * T D x) I J = 0)
    (hderiv : ∀ I J : ShapeIdeal D, I.1 ⊂ J.1 →
      (Q D x * Tprime D x) I J = A D (1 - x) I J) :
    Q D x * T D x = 1 ∧
      Q D x * Tprime D x = A D (1 - x) := by
  classical
  constructor
  · ext I J
    by_cases heq : I = J
    · subst J
      simp [Q_mul_T_diagonal]
    · have hone : (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ) I J = 0 := by
        simp [heq]
      by_cases hIJ : I.1 ⊆ J.1
      · have hproper : I.1 ⊂ J.1 :=
          Finset.ssubset_iff_subset_ne.mpr
            ⟨hIJ, by
              intro hh
              apply heq
              apply Subtype.ext
              exact hh⟩
        rw [hcancel I J hproper, hone]
      · rw [Q_mul_T_of_not_subset D x I J hIJ, hone]
  · ext I J
    by_cases heq : I = J
    · subst J
      simp [Q_mul_Tprime_diagonal]
    · by_cases hIJ : I.1 ⊆ J.1
      · have hproper : I.1 ⊂ J.1 :=
          Finset.ssubset_iff_subset_ne.mpr
            ⟨hIJ, by
              intro hh
              apply heq
              apply Subtype.ext
              exact hh⟩
        exact hderiv I J hproper
      · have hnot : ¬ I.1 ⊂ J.1 := by
          intro hh
          exact hIJ hh.subset
        rw [Q_mul_Tprime_of_not_subset D x I J hIJ,
          A_of_not_ssubset D (1 - x) I J hnot]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.3 — Lemma 5.3: algebraic engine for row-group cancellation. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

/-- A single column contributes `1` if no cell is added, and
`-x * (1-x)^r` when `r+1` successive cells are added in one run. -/
def oneColumnInverseCoefficient (x : ℚ) : ℕ → ℚ
  | 0 => 1
  | r + 1 => -x * (1 - x) ^ r

@[simp] theorem oneColumnInverseCoefficient_zero (x : ℚ) :
    oneColumnInverseCoefficient x 0 = 1 := rfl

@[simp] theorem oneColumnInverseCoefficient_succ (x : ℚ) (r : ℕ) :
    oneColumnInverseCoefficient x (r + 1) = -x * (1 - x) ^ r := rfl

/-- All prefixes of an initial vertical run have total inverse
weight `(1-x)^r`. This is the one-column inversion recurrence. -/
theorem oneColumnInverseCoefficient_prefix (x : ℚ) (r : ℕ) :
    (∑ j ∈ Finset.range (r + 1), oneColumnInverseCoefficient x j) =
      (1 - x) ^ r := by
  induction r with
  | zero =>
      simp [oneColumnInverseCoefficient]
  | succ r ih =>
      rw [Finset.sum_range_succ, ih]
      rw [oneColumnInverseCoefficient_succ, pow_succ]
      ring

/-- The non-diagonal one-column convolution vanishes. -/
theorem oneColumnInverseCoefficient_cancels (x : ℚ) (r : ℕ) :
    oneColumnInverseCoefficient x (r + 1) +
      x * (∑ j ∈ Finset.range (r + 1),
        oneColumnInverseCoefficient x j) = 0 := by
  rw [oneColumnInverseCoefficient_prefix,
    oneColumnInverseCoefficient_succ]
  ring

/-- Enumerating a group of `r` consecutive rows of the same left
boundary: an empty prefix contributes `1`, each nonempty prefix of
`j+1` rows contributes `-x * (1-x)^j`. -/
def initialRowGroupSum (x : ℚ) (r : ℕ) : ℚ :=
  1 + ∑ j ∈ Finset.range r, (-x) * (1 - x) ^ j

/-- The one-group identity from the manuscript, with no shape
assumptions or hidden combinatorial premise. -/
theorem initialRowGroupSum_eq (x : ℚ) (r : ℕ) :
    initialRowGroupSum x r = (1 - x) ^ r := by
  exact verticalStrip_group_telescope x r

/-- Independent row groups multiply. Their contribution is a single
power whose exponent is the sum of the lengths of the groups. -/
theorem initialRowGroups_product (x : ℚ) (S : Finset ℕ)
    (sizes : ℕ → ℕ) :
    (∏ i ∈ S, initialRowGroupSum x (sizes i)) =
      (1 - x) ^ (∑ i ∈ S, sizes i) := by
  simpa only [initialRowGroupSum] using
    (verticalStrip_group_product x S sizes)

/-- Select all cells in one distinguished nonempty group, leaving
all other groups unrestricted. This is the algebra behind (5.7). -/
theorem initialRowGroups_distinguished (x : ℚ)
    (S : Finset ℕ) (sizes : ℕ → ℕ) (s : ℕ)
    (hs : s ∈ S) (hpos : 0 < sizes s) :
    (-x) * (1 - x) ^ (sizes s - 1) *
        (∏ i ∈ S.erase s, initialRowGroupSum x (sizes i)) =
      (-x) * (1 - x) ^ ((∑ i ∈ S, sizes i) - 1) := by
  have hsum := Finset.sum_erase_add S sizes hs
  have hexponent :
      sizes s - 1 + (∑ i ∈ S.erase s, sizes i) =
        (∑ i ∈ S, sizes i) - 1 := by
    omega
  have hother :
      (∏ i ∈ S.erase s, initialRowGroupSum x (sizes i)) =
        (1 - x) ^ (∑ i ∈ S.erase s, sizes i) :=
    initialRowGroups_product x (S.erase s) sizes
  calc
    (-x) * (1 - x) ^ (sizes s - 1) *
        (∏ i ∈ S.erase s, initialRowGroupSum x (sizes i)) =
      (-x) * ((1 - x) ^ (sizes s - 1) *
        (1 - x) ^ (∑ i ∈ S.erase s, sizes i)) := by
          rw [hother]
          ring
    _ = (-x) * (1 - x) ^
        (sizes s - 1 + ∑ i ∈ S.erase s, sizes i) := by
          rw [pow_add]
    _ = (-x) * (1 - x) ^ ((∑ i ∈ S, sizes i) - 1) := by
          rw [hexponent]

/-- The *two* scalar conclusions of Lemma 5.3 are automatic once
admissible strips have been enumerated by independent row groups.
The missing geometric theorem must justify that enumeration for the
actual finite sum over intermediate ideals. -/
theorem initialRowGroups_connected_cancellation
    (x : ℚ) (S : Finset ℕ) (sizes : ℕ → ℕ)
    (s : ℕ) (hs : s ∈ S) (hpos : 0 < sizes s)
    (h w : ℕ) (hsum : (∑ i ∈ S, sizes i) = h + 1) :
    x ^ (w + 1) * (∏ i ∈ S,
        initialRowGroupSum x (sizes i)) +
      (x ^ w - x ^ (w + 1)) *
        ((-x) * (1 - x) ^ (sizes s - 1) *
          (∏ i ∈ S.erase s, initialRowGroupSum x (sizes i))) = 0
    ∧
    ((w + 1 : ℕ) : ℚ) * x ^ w *
        (∏ i ∈ S, initialRowGroupSum x (sizes i)) +
      (((w : ℚ) * x ^ (w - 1)) -
        ((w + 1 : ℕ) : ℚ) * x ^ w) *
        ((-x) * (1 - x) ^ (sizes s - 1) *
          (∏ i ∈ S.erase s, initialRowGroupSum x (sizes i))) =
      x ^ w * (1 - x) ^ h := by
  have hfull := initialRowGroups_product x S sizes
  have hspecial := initialRowGroups_distinguished x S sizes s hs hpos
  constructor
  · rw [hfull, hspecial, hsum]
    exact connected_strip_cancellation_algebra x h w
  · rw [hfull, hspecial, hsum]
    exact connected_strip_derivative_algebra x h w

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.3 — Abstract factorization over disconnected components

These two statements isolate the only use of disconnectedness in the
matrix argument: every nonempty component has zero inverse convolution,
so a product of two or more such factors is zero, as is its derivative.
They are pure finite-product results; the decomposition of a *skew
interval* into independent components is a separate geometric theorem. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

/-- If one component has a vanishing convolution, the product of
component convolutions vanishes. -/
theorem component_convolution_product_zero
    (S : Finset ℕ) (f : ℕ → ℚ)
    (hz : ∃ i ∈ S, f i = 0) :
    (∏ i ∈ S, f i) = 0 := by
  rcases hz with ⟨i, hi, hf⟩
  exact Finset.prod_eq_zero hi hf

/-- If there are at least two nonempty components, and each has
vanishing inverse convolution, every summand of the product rule has
another zero factor. This is the abstract disconnected derivative case. -/
theorem component_convolution_derivative_zero
    (S : Finset ℕ) (f g : ℕ → ℚ)
    (hz : ∀ i ∈ S, f i = 0)
    (hsecond : ∀ i ∈ S, ∃ j ∈ S, j ≠ i) :
    (∑ i ∈ S, g i * (∏ j ∈ S.erase i, f j)) = 0 := by
  apply Finset.sum_eq_zero
  intro i hi
  obtain ⟨j, hj, hji⟩ := hsecond i hi
  have hje : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
  have hprod : (∏ j ∈ S.erase i, f j) = 0 :=
    Finset.prod_eq_zero hje (hz j hj)
  rw [hprod, mul_zero]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.3 — Strip-selection parametrization. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Membership in an interval is membership in the second ideal but not
in the first, with the ambient-shape condition made explicit. -/
theorem mem_intervalCells_iff_ideal_membership (D : Diagram)
    (I K : ShapeIdeal D) (r j : ℕ) :
    (r, j) ∈ intervalCells D I K ↔
      ∃ h : (r, j) ∈ D,
        (⟨(r, j), h⟩ : ShapeCell D) ∈ K.1 ∧
        (⟨(r, j), h⟩ : ShapeCell D) ∉ I.1 := by
  classical
  change (r, j) ∈ (K.1 \ I.1).image
    (fun c : ShapeCell D => c.1) ↔ _
  constructor
  · intro h
    obtain ⟨c, hc, heq⟩ := Finset.mem_image.mp h
    obtain ⟨hcK, hcI⟩ := Finset.mem_sdiff.mp hc
    have hval : c.1 = (r, j) := heq
    cases c with
    | mk v hv =>
        dsimp at hval
        subst v
        exact ⟨hv, hcK, hcI⟩
  · rintro ⟨hD, hK, hI⟩
    exact Finset.mem_image.mpr
      ⟨⟨(r, j), hD⟩, Finset.mem_sdiff.mpr ⟨hK, hI⟩, rfl⟩

/-- Membership in the moving interval is exactly the inequality between
the two row cutoffs, provided the `lo` function is below every cell of D.
This lemma does not require comparable ideals. -/
theorem mem_intervalCells_iff_row_cuts (D : Diagram)
    (I K : ShapeIdeal D) (lo : ℕ → ℕ)
    (hlo : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2)
    (r j : ℕ) :
    (r, j) ∈ intervalCells D I K ↔
      (r, j) ∈ D ∧
      idealRowCut D I lo r ≤ j ∧
      j < idealRowCut D K lo r := by
  classical
  constructor
  · intro h
    obtain ⟨hD, hK, hI⟩ :=
      (mem_intervalCells_iff_ideal_membership D I K r j).mp h
    let c : ShapeCell D := ⟨(r, j), hD⟩
    have hKcut : j < idealRowCut D K lo r := by
      have hh := (ideal_row_iff_cut D K lo hlo c).mp hK
      simpa only [c, Subtype.coe_mk, Prod.fst, Prod.snd] using hh
    have hInot : ¬ j < idealRowCut D I lo r := by
      have hh := (ideal_row_iff_cut D I lo hlo c).not.mp hI
      simpa only [c, Subtype.coe_mk, Prod.fst, Prod.snd] using hh
    exact ⟨hD, by omega, hKcut⟩
  · rintro ⟨hD, hlow, hhigh⟩
    let c : ShapeCell D := ⟨(r, j), hD⟩
    have hK : c ∈ K.1 := by
      apply (ideal_row_iff_cut D K lo hlo c).mpr
      simpa only [c, Subtype.coe_mk, Prod.fst, Prod.snd] using hhigh
    have hI : c ∉ I.1 := by
      intro hcI
      have hcut := (ideal_row_iff_cut D I lo hlo c).mp hcI
      have hj : j < idealRowCut D I lo r := by
        simpa only [c, Subtype.coe_mk, Prod.fst, Prod.snd] using hcut
      omega
    exact (mem_intervalCells_iff_ideal_membership D I K r j).mpr
      ⟨hD, hK, hI⟩

/-- Every ideal row prefix stays inside the right ambient row boundary,
except that an empty row can have `lo r > hi r`. The maximum accounts
uniformly for this case, including the empty diagram. -/
theorem idealRowCut_le_ambient_upper (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (K : ShapeIdeal D) (r : ℕ) :
    idealRowCut D K lo r ≤ max (lo r) (hi r) := by
  classical
  unfold idealRowCut
  apply max_le_max (le_refl _)
  apply Finset.sup_le
  intro c _
  by_cases hr : c.1.1 = r
  · simp only [hr, ite_true]
    have hh := (hmem c.1.1 c.1.2).mp c.property
    have hu : c.1.2 + 1 ≤ hi r := by
      have hh' : c.1.2 < hi c.1.1 := hh.2.2
      rw [hr] at hh'
      omega
    exact hu
  · simp [hr]

/-- The principal structural characterization needed in Lemma 5.3:
the difference of two order ideals is a vertical strip if and only if
their row boundaries differ by at most one. -/
theorem verticalStrip_iff_row_cuts_step (D : Diagram)
    (hsk : SkewRowIntervals D) (I K : ShapeIdeal D) :
    IsVerticalStrip (intervalCells D I K) ↔
      ∀ n : ℕ, ∀ lo hi : ℕ → ℕ,
        (∀ r j : ℕ,
          (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r) →
        ∀ r : ℕ, r < n →
          idealRowCut D K lo r ≤ idealRowCut D I lo r + 1 := by
  classical
  constructor
  · intro hstrip n lo hi hmem r hr
    have hlo : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
      intro c
      exact ((hmem c.1.1 c.1.2).mp c.property).2.1
    let a := idealRowCut D I lo r
    let b := idealRowCut D K lo r
    by_contra hbound
    have hab : a + 1 < b := by omega
    have hambient : b ≤ max (lo r) (hi r) :=
      idealRowCut_le_ambient_upper D n lo hi hmem K r
    have hleft : lo r ≤ a := by
      dsimp [a, idealRowCut]
      exact le_max_left _ _
    have hright : a + 1 < hi r := by
      by_cases h : lo r ≤ hi r
      · rw [max_eq_right h] at hambient
        omega
      · have he : max (lo r) (hi r) = lo r :=
          max_eq_left (by omega)
        rw [he] at hambient
        omega
    have hD0 : (r, a) ∈ D :=
      (hmem r a).mpr ⟨hr, hleft, by omega⟩
    have hD1 : (r, a + 1) ∈ D :=
      (hmem r (a + 1)).mpr ⟨hr, by omega, hright⟩
    have ha : (r, a) ∈ intervalCells D I K :=
      (mem_intervalCells_iff_row_cuts D I K lo hlo r a).mpr
        ⟨hD0, le_refl _, by omega⟩
    have hb : (r, a + 1) ∈ intervalCells D I K :=
      (mem_intervalCells_iff_row_cuts D I K lo hlo r (a + 1)).mpr
        ⟨hD1, by omega, hab⟩
    have heq : a = a + 1 := hstrip (r, a) ha (r, a + 1) hb rfl
    omega
  · intro hgap c hc d hd hrow
    obtain ⟨n, lo, hi, hmem, _, _⟩ := hsk
    have hlo : ∀ e : ShapeCell D, lo e.1.1 ≤ e.1.2 := by
      intro e
      exact ((hmem e.1.1 e.1.2).mp e.property).2.1
    obtain ⟨hcD, hcLow, hcHigh⟩ :=
      (mem_intervalCells_iff_row_cuts D I K lo hlo c.1 c.2).mp hc
    obtain ⟨hdD, hdLow, hdHigh⟩ :=
      (mem_intervalCells_iff_row_cuts D I K lo hlo d.1 d.2).mp hd
    have hr : c.1 < n := ((hmem c.1 c.2).mp hcD).1
    have hstep := hgap n lo hi hmem c.1 hr
    have hhigh' : d.2 < idealRowCut D K lo c.1 := by
      simpa only [hrow] using hdHigh
    have hlow' : idealRowCut D I lo c.1 ≤ d.2 := by
      simpa only [hrow] using hdLow
    omega

/-- For a vertical strip of newly added cells, every selected cell is
exactly the first cell available after the smaller ideal in its row.
This is a much stronger statement than the cardinality bound. -/
theorem verticalStrip_added_cell_is_first (D : Diagram)
    (hsk : SkewRowIntervals D) (I K : ShapeIdeal D)
    (hstrip : IsVerticalStrip (intervalCells D I K))
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (r j : ℕ) (hc : (r, j) ∈ intervalCells D I K) :
    j = idealRowCut D I lo r := by
  have hlo : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
    intro c
    exact ((hmem c.1.1 c.1.2).mp c.property).2.1
  obtain ⟨hD, hl, hh⟩ :=
    (mem_intervalCells_iff_row_cuts D I K lo hlo r j).mp hc
  have hr : r < n := ((hmem r j).mp hD).1
  have hgap := (verticalStrip_iff_row_cuts_step D hsk I K).mp
    hstrip n lo hi hmem r hr
  omega

/-- A converse to the first-available-cell lemma: if every newly added
cell lies at the old row cutoff, there is at most one such cell per row.
This direction works for arbitrary finite diagrams. -/
theorem verticalStrip_of_cells_at_cut (D : Diagram)
    (I K : ShapeIdeal D) (lo : ℕ → ℕ)
    (hfirst : ∀ r j : ℕ, (r, j) ∈ intervalCells D I K →
      j = idealRowCut D I lo r) :
    IsVerticalStrip (intervalCells D I K) := by
  intro c hc d hd hrow
  have hc' := hfirst c.1 c.2 hc
  have hd' := hfirst d.1 d.2 hd
  rw [hrow] at hc'
  exact hc'.trans hd'.symm

/-- The set of new cells is upward-prefix-closed in a *fixed column*:
selecting a later row forces every earlier still-available cell in the
same column to be selected as well. This is the ideal constraint that
will turn the row-cut choices into contiguous groups. -/
theorem added_cells_prefix_in_column (D : Diagram)
    (I K J : ShapeIdeal D) (r s j : ℕ)
    (hrs : r ≤ s)
    (hupper : (r, j) ∈ intervalCells D I J)
    (hlower : (s, j) ∈ intervalCells D I K) :
    (r, j) ∈ intervalCells D I K := by
  obtain ⟨hrD, _, hrI⟩ :=
    (mem_intervalCells_iff_ideal_membership D I J r j).mp hupper
  obtain ⟨hsD, hsK, _⟩ :=
    (mem_intervalCells_iff_ideal_membership D I K s j).mp hlower
  let a : ShapeCell D := ⟨(r, j), hrD⟩
  let b : ShapeCell D := ⟨(s, j), hsD⟩
  have hab : a ≤ b := by
    change r ≤ s ∧ j ≤ j
    exact ⟨hrs, le_refl _⟩
  have haK : a ∈ K.1 := K.2 hab hsK
  exact (mem_intervalCells_iff_ideal_membership D I K r j).mpr
    ⟨hrD, haK, hrI⟩

/-- Rewriting the vertical-strip coefficient using the proved row-cut
criterion. This is the entrywise gate for the grouping argument. -/
theorem verticalStripCoefficient_of_row_cuts_step (D : Diagram)
    (hsk : SkewRowIntervals D) (I K : ShapeIdeal D)
    (x : ℚ)
    (hcuts : ∀ n : ℕ, ∀ lo hi : ℕ → ℕ,
      (∀ r j : ℕ,
        (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r) →
      ∀ r : ℕ, r < n →
        idealRowCut D K lo r ≤ idealRowCut D I lo r + 1) :
    verticalStripCoefficient x (intervalCells D I K) =
      (-x) ^ verticalRunCount (intervalCells D I K) *
        (1 - x) ^
          ((intervalCells D I K).card -
            verticalRunCount (intervalCells D I K)) := by
  have hs : IsVerticalStrip (intervalCells D I K) :=
    (verticalStrip_iff_row_cuts_step D hsk I K).mpr hcuts
  simp [verticalStripCoefficient, hs]

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.3 — Lemma 5.3: initial-strip parametrization. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Iterated version of `idealRowCut_antitone`. The row cut of an ideal
cannot increase when passing to a later row of the ambient skew diagram. -/
theorem idealRowCut_antitone_le (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (K : ShapeIdeal D) (r s : ℕ)
    (hrs : r ≤ s) (hs : s < n) :
    idealRowCut D K lo s ≤ idealRowCut D K lo r := by
  exact finiteInterval_antitone
    (idealRowCut D K lo) n
    (idealRowCut_antitone D n lo hi hmem hlo hhi K)
    r s hrs hs

/-- An initial strip selection is a set of moving cells with one simple
geometric rule (first available cell in each chosen row) and one order
rule (initial prefix within each column). All conditions refer to the
*real interval* `J \ I`, never to the ambient diagram outside it. -/
def IsInitialStripSelection (D : Diagram) (I J : ShapeIdeal D)
    (lo : ℕ → ℕ) (S : Diagram) : Prop :=
  S ⊆ intervalCells D I J ∧
  (∀ r j : ℕ, (r, j) ∈ S →
    j = idealRowCut D I lo r) ∧
  (∀ r s j : ℕ, r ≤ s →
    (r, j) ∈ intervalCells D I J →
    (s, j) ∈ S → (r, j) ∈ S)

/-- An initial-strip selection is a vertical strip, because the first
available cell of each row is unique. -/
theorem initialStripSelection_vertical (D : Diagram)
    (I J : ShapeIdeal D) (lo : ℕ → ℕ) (S : Diagram)
    (hS : IsInitialStripSelection D I J lo S) :
    IsVerticalStrip S := by
  intro c hc d hd hrow
  have hcj := hS.2.1 c.1 c.2 hc
  have hdj := hS.2.1 d.1 d.2 hd
  rw [hrow] at hcj
  exact hcj.trans hdj.symm

/-- The initial strips from actual intermediate ideals automatically
satisfy the first-available-cell and column-prefix conditions. -/
theorem intermediate_verticalStrip_is_initial (D : Diagram)
    (hsk : SkewRowIntervals D) (I K J : ShapeIdeal D)
    (_hIK : I.1 ⊆ K.1) (hKJ : K.1 ⊆ J.1)
    (hstrip : IsVerticalStrip (intervalCells D I K))
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r) :
    IsInitialStripSelection D I J lo (intervalCells D I K) := by
  classical
  refine ⟨?_, ?_, ?_⟩
  · intro c hc
    obtain ⟨hD, hK, hI⟩ :=
      (mem_intervalCells_iff_ideal_membership D I K c.1 c.2).mp hc
    exact (mem_intervalCells_iff_ideal_membership D I J c.1 c.2).mpr
      ⟨hD, hKJ hK, hI⟩
  · intro r j hc
    exact verticalStrip_added_cell_is_first D hsk I K hstrip
      n lo hi hmem r j hc
  · intro r s j hrs hrB hsS
    exact added_cells_prefix_in_column D I K J r s j hrs hrB hsS

/-- An actual diagram selection is read inside the ambient cell type
by filtering `univ`; the resulting finite set is free of duplicates. -/
noncomputable def selectionAmbientCells (D : Diagram) (S : Diagram) :
    Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c : ShapeCell D => c.1 ∈ S)

@[simp] theorem mem_selectionAmbientCells (D : Diagram) (S : Diagram)
    (c : ShapeCell D) :
    c ∈ selectionAmbientCells D S ↔ c.1 ∈ S := by
  classical
  simp [selectionAmbientCells]

/-- The union of I and a valid initial strip is again a lower ideal.
The proof uses the *monotonicity of the old row cut*: an earlier moving
cell below a chosen first cell can only lie in the same column. -/
noncomputable def idealFromInitialSelection (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (I J : ShapeIdeal D) (S : Diagram)
    (hS : IsInitialStripSelection D I J lo S) : ShapeIdeal D := by
  classical
  let E : Finset (ShapeCell D) := selectionAmbientCells D S
  refine ⟨I.1 ∪ E, ?_⟩
  intro a b hab hb
  rcases Finset.mem_union.mp hb with hbI | hbE
  · exact Finset.mem_union.mpr (Or.inl (I.2 hab hbI))
  · have hbS : b.1 ∈ S :=
      (mem_selectionAmbientCells D S b).mp hbE
    have hbB : b.1 ∈ intervalCells D I J := hS.1 hbS
    obtain ⟨_, hbJ, _⟩ :=
      (mem_intervalCells_iff_ideal_membership D I J b.1.1 b.1.2).mp hbB
    have haJ : a ∈ J.1 := J.2 hab hbJ
    by_cases haI : a ∈ I.1
    · exact Finset.mem_union.mpr (Or.inl haI)
    · have haB : a.1 ∈ intervalCells D I J :=
        (mem_intervalCells_iff_ideal_membership D I J a.1.1 a.1.2).mpr
          ⟨a.property, haJ, haI⟩
      have hloCell : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
        intro c
        exact ((hmem c.1.1 c.1.2).mp c.property).2.1
      have haLow : idealRowCut D I lo a.1.1 ≤ a.1.2 :=
        ((mem_intervalCells_iff_row_cuts D I J lo hloCell
          a.1.1 a.1.2).mp haB).2.1
      have hbFirst : b.1.2 = idealRowCut D I lo b.1.1 :=
        hS.2.1 b.1.1 b.1.2 hbS
      have hrows : a.1.1 ≤ b.1.1 := hab.1
      have hcols : a.1.2 ≤ b.1.2 := hab.2
      have hbr : b.1.1 < n := ((hmem b.1.1 b.1.2).mp b.property).1
      have hcut := idealRowCut_antitone_le D n lo hi
        hmem hlo hhi I a.1.1 b.1.1 hrows hbr
      have hcol : a.1.2 = b.1.2 := by omega
      have haS : a.1 ∈ S := by
        have hh := hS.2.2 a.1.1 b.1.1 a.1.2
          hrows haB
        apply hh
        simpa only [hcol] using hbS
      exact Finset.mem_union.mpr
        (Or.inr ((mem_selectionAmbientCells D S a).mpr haS))

/-- The new ideal is automatically intermediate between I and J. -/
theorem idealFromInitialSelection_intermediate (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊆ J.1)
    (S : Diagram) (hS : IsInitialStripSelection D I J lo S) :
    IsIntermediate D I J
      (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS) := by
  classical
  constructor
  · intro c hc
    change c ∈ I.1 ∪ selectionAmbientCells D S
    exact Finset.mem_union.mpr (Or.inl hc)
  · intro c hc
    change c ∈ I.1 ∪ selectionAmbientCells D S at hc
    rcases Finset.mem_union.mp hc with hcI | hcS
    · exact hIJ hcI
    · have hcSelected : c.1 ∈ S :=
        (mem_selectionAmbientCells D S c).mp hcS
      have hcB : c.1 ∈ intervalCells D I J := hS.1 hcSelected
      obtain ⟨_, hcJ, _⟩ :=
        (mem_intervalCells_iff_ideal_membership D I J
          c.1.1 c.1.2).mp hcB
      exact hcJ

/-- Recovering the selected cells from the constructed intermediate
ideal: no cells of the initial ideal are accidentally counted. -/
theorem idealFromInitialSelection_interval (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (I J : ShapeIdeal D) (S : Diagram)
    (hS : IsInitialStripSelection D I J lo S) :
    intervalCells D I
      (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS) = S := by
  classical
  ext p
  constructor
  · intro hp
    obtain ⟨hpD, hpK, hpI⟩ :=
      (mem_intervalCells_iff_ideal_membership D I
        (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS)
        p.1 p.2).mp hp
    change (⟨p, hpD⟩ : ShapeCell D) ∈
      I.1 ∪ selectionAmbientCells D S at hpK
    rcases Finset.mem_union.mp hpK with hpIn | hpSelected
    · exact False.elim (hpI hpIn)
    · exact (mem_selectionAmbientCells D S ⟨p, hpD⟩).mp hpSelected
  · intro hp
    have hpB : p ∈ intervalCells D I J := hS.1 hp
    obtain ⟨hpD, _, hpI⟩ :=
      (mem_intervalCells_iff_ideal_membership D I J p.1 p.2).mp hpB
    have hpSelected : (⟨p, hpD⟩ : ShapeCell D) ∈
        selectionAmbientCells D S :=
      (mem_selectionAmbientCells D S ⟨p, hpD⟩).mpr hp
    have hpK : (⟨p, hpD⟩ : ShapeCell D) ∈
        (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS).1 := by
      change (⟨p, hpD⟩ : ShapeCell D) ∈
        I.1 ∪ selectionAmbientCells D S
      exact Finset.mem_union.mpr (Or.inr hpSelected)
    exact (mem_intervalCells_iff_ideal_membership D I
      (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS)
      p.1 p.2).mpr ⟨hpD, hpK, hpI⟩

/-- The new ideal also satisfies the vertical-strip condition. -/
theorem idealFromInitialSelection_vertical (D : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (I J : ShapeIdeal D) (S : Diagram)
    (hS : IsInitialStripSelection D I J lo S) :
    IsVerticalStrip (intervalCells D I
      (idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS)) := by
  rw [idealFromInitialSelection_interval]
  exact initialStripSelection_vertical D I J lo S hS

/-! ### §5.3 — initialStripSelection exists unique intermediate. -/

/-- Legal initial strips and column-prefix selections determine each
other uniquely, for a fixed pair of comparable ideals. -/
theorem initialStripSelection_exists_unique_intermediate (D : Diagram)
    (_hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (S : Diagram) (hS : IsInitialStripSelection D I J lo S) :
    ∃! K : ShapeIdeal D,
      IsIntermediate D I J K ∧
      IsVerticalStrip (intervalCells D I K) ∧
      intervalCells D I K = S := by
  let K := idealFromInitialSelection D n lo hi hmem hlo hhi I J S hS
  refine ⟨K, ?_, ?_⟩
  · exact ⟨idealFromInitialSelection_intermediate D n lo hi hmem
      hlo hhi I J hIJ S hS,
      idealFromInitialSelection_vertical D n lo hi hmem hlo hhi I J S hS,
      idealFromInitialSelection_interval D n lo hi hmem hlo hhi I J S hS⟩
  · intro L hL
    apply Subtype.ext
    ext c
    have hIL := hL.1.1
    have hIK : I.1 ⊆ K.1 :=
      (idealFromInitialSelection_intermediate D n lo hi hmem
        hlo hhi I J hIJ S hS).1
    by_cases hcI : c ∈ I.1
    · exact ⟨fun _ => hIK hcI, fun _ => hIL hcI⟩
    · have hLK : c ∈ L.1 ↔ c.1 ∈ S := by
        have hmemL : c.1 ∈ intervalCells D I L ↔
            c ∈ L.1 ∧ c ∉ I.1 := moving_cell_mem_iff D I L c
        rw [hL.2.2] at hmemL
        simpa [hcI] using hmemL.symm
      have hKK : c ∈ K.1 ↔ c.1 ∈ S := by
        have hmemK : c.1 ∈ intervalCells D I K ↔
            c ∈ K.1 ∧ c ∉ I.1 := moving_cell_mem_iff D I K c
        rw [idealFromInitialSelection_interval D n lo hi
          hmem hlo hhi I J S hS] at hmemK
        simpa [hcI] using hmemK.symm
      exact hLK.trans hKK.symm

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
