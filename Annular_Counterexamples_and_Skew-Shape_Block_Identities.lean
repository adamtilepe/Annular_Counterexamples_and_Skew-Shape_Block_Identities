open CanonicalBlocks

/-! ### §5.3 — Width of an interval after a selected initial strip. -/

/-- A column that could possibly disappear under first-cell
selections must consist entirely of row-head cells. -/
def RemovableHeadColumn (B : Diagram) (lo : ℕ → ℕ)
    (j : ℕ) : Prop :=
  ∀ r : ℕ, (r, j) ∈ B → lo r = j

/-- A complete column disappears precisely when every cell of that
column is in the chosen set. This general statement does not use
connectedness, skewness, or even the vertical-strip condition. -/
theorem column_absent_iff_all_selected (B S : Diagram) (j : ℕ) :
    j ∉ occupiedColumnsRaw (B \ S) ↔
      ∀ r : ℕ, (r, j) ∈ B → (r, j) ∈ S := by
  classical
  constructor
  · intro habs r hr
    by_contra hnot
    apply habs
    exact Finset.mem_image.mpr
      ⟨(r, j), Finset.mem_sdiff.mpr ⟨hr, hnot⟩, rfl⟩
  · intro hall habs
    obtain ⟨c, hc, hcol⟩ := Finset.mem_image.mp habs
    obtain ⟨hcB, hcNotS⟩ := Finset.mem_sdiff.mp hc
    have hcEq : c = (c.1, j) := Prod.ext rfl hcol
    have hmem : (c.1, j) ∈ B := by
      rw [hcEq] at hcB
      exact hcB
    have hSelected := hall c.1 hmem
    apply hcNotS
    exact hcEq.symm ▸ hSelected

/-- An initially selected set can erase a column only if all its
cells are row heads of the original interval. -/
theorem vanished_column_is_head (B S : Diagram)
    (lo : ℕ → ℕ) (hS : IsHeadPrefixSelection B lo S)
    (j : ℕ) (hvanish : j ∉ occupiedColumnsRaw (B \ S)) :
    RemovableHeadColumn B lo j := by
  intro r hr
  have hselected := (column_absent_iff_all_selected B S j).mp
    hvanish r hr
  exact (hS.2.1 r j hselected).symm

/-- Surviving columns, with the existential predicate made decidable
inside the definition rather than at theorem elaboration time. -/
noncomputable def survivingColumns (B S : Diagram) : Finset ℕ := by
  classical
  exact (occupiedColumnsRaw B).filter
    (fun j => ∃ r : ℕ, (r, j) ∈ B ∧ (r, j) ∉ S)

/-- The occupied columns of the remaining diagram are exactly the
columns that still contain an unselected cell. -/
theorem occupiedColumns_sdiff_filter (B S : Diagram) :
    occupiedColumnsRaw (B \ S) = survivingColumns B S := by
  classical
  ext j
  simp only [survivingColumns, occupiedColumnsRaw, Finset.mem_image,
    Finset.mem_filter, Finset.mem_sdiff]
  constructor
  · rintro ⟨c, ⟨hcB, hcNotS⟩, heq⟩
    refine ⟨⟨c, hcB, heq⟩, c.1, ?_⟩
    have hcEq : c = (c.1, j) := Prod.ext rfl heq
    constructor
    · rw [hcEq] at hcB
      exact hcB
    · rw [hcEq] at hcNotS
      exact hcNotS
  · rintro ⟨_, r, hrB, hrNotS⟩
    exact ⟨(r, j), ⟨hrB, hrNotS⟩, rfl⟩

/-- The width of the remaining diagram as a sum of zero-one
indicators. This avoids subtraction of natural cardinalities. -/
theorem columnCount_sdiff_as_sum (B S : Diagram) :
    columnCount (B \ S) =
      ∑ j ∈ occupiedColumnsRaw B,
        if j ∈ survivingColumns B S then 1 else 0 := by
  classical
  change (occupiedColumnsRaw (B \ S)).card = _
  rw [occupiedColumns_sdiff_filter]
  unfold survivingColumns
  rw [Finset.card_filter]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [Finset.mem_filter, hj, true_and]

/-- For an actual tuple of prefixes, a column disappears iff it is
a removable head column and *all* rows belonging to that column are
selected. The argument is independent of the number of components. -/
theorem headTuple_column_disappears (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) (j : ℕ) :
    j ∉ occupiedColumnsRaw (B \ headTuplesCells B lo P) ↔
      RemovableHeadColumn B lo j ∧
        ∀ r ∈ leftBoundaryRowGroup B lo j,
          (r, j) ∈ headTuplesCells B lo P := by
  classical
  have hS := headTuplesCells_isHeadPrefixSelection B
    n lo hi hmem hlo P
  constructor
  · intro habs
    have hAll := (column_absent_iff_all_selected B
      (headTuplesCells B lo P) j).mp habs
    refine ⟨vanished_column_is_head B _ lo hS j habs, ?_⟩
    intro r hr
    exact hAll r (headCell_of_leftBoundaryRowGroup B
      n lo hi hmem j r hr)
  · rintro ⟨hrem, hfull⟩
    apply (column_absent_iff_all_selected B
      (headTuplesCells B lo P) j).mpr
    intro r hr
    have hgroup : r ∈ leftBoundaryRowGroup B lo j :=
      mem_leftBoundaryRowGroup_of_headCell B lo r j hr
        (hrem r hr).symm
    exact hfull r hgroup

end TableauTransfer
end OrderIdealSpecializations

