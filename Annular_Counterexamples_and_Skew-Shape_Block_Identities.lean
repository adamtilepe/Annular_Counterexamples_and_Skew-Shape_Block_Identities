/-! ### §5.3 — Exact two-variable evaluation for a removable row group. -/

/-- A group which cannot erase its containing column contributes its
usual telescopic factor multiplied by the column variable. -/
theorem nonremovable_row_group_sum (x y : ℚ) (r : ℕ) :
    (∑ k ∈ Finset.range (r + 1),
      oneColumnInverseCoefficient x k * y) =
      y * (1 - x) ^ r := by
  rw [← Finset.sum_mul, oneColumnInverseCoefficient_prefix]
  ring

/-- The *new* scalar factor: if the final, full prefix removes an
entire column, that choice contributes 1 in the width variable,
whereas every shorter prefix leaves the column and contributes y.
The resulting factor is `(y-x)(1-x)^(r-1)`.

This identity is the simultaneous source of connected cancellation
(at y=x) and of the surviving first derivative. -/
theorem removable_row_group_sum (x y : ℚ) (r : ℕ)
    (hr : 0 < r) :
    (∑ k ∈ Finset.range (r + 1),
      oneColumnInverseCoefficient x k *
        (if k = r then 1 else y)) =
      (y - x) * (1 - x) ^ (r - 1) := by
  obtain ⟨s, rfl⟩ : ∃ s : ℕ, r = s + 1 :=
    ⟨r - 1, by omega⟩
  rw [Finset.sum_range_succ]
  have hbefore :
      (∑ k ∈ Finset.range (s + 1),
        oneColumnInverseCoefficient x k *
          (if k = s + 1 then 1 else y)) =
      y * (∑ k ∈ Finset.range (s + 1),
        oneColumnInverseCoefficient x k) := by
    calc
      _ = ∑ k ∈ Finset.range (s + 1),
          oneColumnInverseCoefficient x k * y := by
            apply Finset.sum_congr rfl
            intro k hk
            have hne : k ≠ s + 1 := by
              have hlt := Finset.mem_range.mp hk
              omega
            simp [hne]
      _ = y * (∑ k ∈ Finset.range (s + 1),
          oneColumnInverseCoefficient x k) := by
            rw [← Finset.sum_mul]
            ring
  rw [hbefore, oneColumnInverseCoefficient_prefix]
  simp only [ite_true, oneColumnInverseCoefficient_succ,
    Nat.add_sub_cancel_right]
  ring

end TableauTransfer
end OrderIdealSpecializations

