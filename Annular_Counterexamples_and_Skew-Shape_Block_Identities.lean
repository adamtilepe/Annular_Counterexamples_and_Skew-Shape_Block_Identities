open CanonicalBlocks

/-- A single occupied column is automatically a vertical strip. -/
theorem oneColumn_isVerticalStrip (E : Diagram) (j : ℕ)
    (hcol : ∀ c ∈ E, c.2 = j) : IsVerticalStrip E := by
  intro c hc d hd _
  exact (hcol c hc).trans (hcol d hd).symm

/-- In a nonempty single-column set with no gaps, exactly its last
cell is a run-end. -/
theorem verticalRunCount_one_of_consecutive_column
    (E : Diagram) (j : ℕ) (hne : E.Nonempty)
    (hcol : ∀ c ∈ E, c.2 = j)
    (hconv : ∀ r s t : ℕ, (r, j) ∈ E →
      (s, j) ∈ E → r ≤ t → t ≤ s → (t, j) ∈ E) :
    verticalRunCount E = 1 := by
  classical
  let R : Finset ℕ := E.image Prod.fst
  have hR : R.Nonempty := by
    obtain ⟨c, hc⟩ := hne
    exact ⟨c.1, Finset.mem_image.mpr ⟨c, hc, rfl⟩⟩
  let m : ℕ := R.max' hR
  have hmR : m ∈ R := Finset.max'_mem R hR
  obtain ⟨last, hlast, hlastrow⟩ := Finset.mem_image.mp hmR
  have hlastcol : last.2 = j := hcol last hlast
  have hlastEq : last = (m, j) := Prod.ext hlastrow hlastcol
  have htop : (m, j) ∈ E := hlastEq ▸ hlast
  have hbound : ∀ c ∈ E, c.1 ≤ m := by
    intro c hc
    exact Finset.le_max' R c.1
      (Finset.mem_image.mpr ⟨c, hc, rfl⟩)
  have htopEnd : (m, j) ∈ verticalRunEnds E := by
    apply Finset.mem_filter.mpr
    refine ⟨htop, ?_⟩
    intro hnext
    have hh := hbound (m + 1, j) hnext
    omega
  have huniq : ∀ c ∈ verticalRunEnds E, c = (m, j) := by
    intro c hc
    obtain ⟨hcE, hcEnd⟩ :
      c ∈ E ∧ (c.1 + 1, c.2) ∉ E := by
        simpa only [verticalRunEnds, Finset.mem_filter] using hc
    have hcm : c.1 ≤ m := hbound c hcE
    have hce : (c.1, j) ∈ E := by
      have hcEq : c = (c.1, j) :=
        Prod.ext rfl (hcol c hcE)
      exact hcEq ▸ hcE
    have hroweq : c.1 = m := by
      by_contra hne'
      have hlt : c.1 < m := by omega
      have hsucc := hconv c.1 m (c.1 + 1)
        hce htop (by omega) (by omega)
      apply hcEnd
      simpa only [hcol c hcE] using hsucc
    exact Prod.ext hroweq (hcol c hcE)
  have hends : verticalRunEnds E = {(m, j)} := by
    ext c
    constructor
    · intro hc
      simpa only [Finset.mem_singleton] using huniq c hc
    · intro hc
      have heq : c = (m, j) := Finset.mem_singleton.mp hc
      simpa only [heq] using htopEnd
  change (verticalRunEnds E).card = 1
  rw [hends, Finset.card_singleton]

/-- Consequently each consecutive column contributes exactly the
one-column inverse coefficient of its number of cells. -/
theorem verticalStripCoefficient_consecutive_column (x : ℚ)
    (E : Diagram) (j : ℕ)
    (hcol : ∀ c ∈ E, c.2 = j)
    (hconv : ∀ r s t : ℕ, (r, j) ∈ E →
      (s, j) ∈ E → r ≤ t → t ≤ s → (t, j) ∈ E) :
    verticalStripCoefficient x E =
      oneColumnInverseCoefficient x E.card := by
  classical
  by_cases hE : E.Nonempty
  · have hstrip := oneColumn_isVerticalStrip E j hcol
    have hrun := verticalRunCount_one_of_consecutive_column
      E j hE hcol hconv
    have hpos : 0 < E.card := Finset.card_pos.mpr hE
    obtain ⟨k, hk⟩ : ∃ k : ℕ, E.card = k + 1 := by
      exact ⟨E.card - 1, by omega⟩
    simp only [verticalStripCoefficient, ite_eq_left hstrip,
      hrun, hk, Nat.add_sub_cancel_right,
      oneColumnInverseCoefficient_succ, pow_one]
  · have he : E = ∅ := Finset.not_nonempty_iff_eq_empty.mp hE
    subst E
    simp [verticalStripCoefficient_empty]

/-- The column slices of a prefix-closed selection in a connected
skew shape are consecutive vertical runs. -/
theorem selectedColumnSlice_consecutive_of_initial (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (S : Diagram) (hSB : S ⊆ B)
    (hfirst : ∀ r j : ℕ, (r, j) ∈ S → j = lo r)
    (hprefix : ∀ r s j : ℕ, r ≤ s →
      (r, j) ∈ B → (s, j) ∈ S → (r, j) ∈ S)
    (j : ℕ) :
    ∀ r s t : ℕ,
      (r, j) ∈ selectedColumnSlice S j →
      (s, j) ∈ selectedColumnSlice S j →
      r ≤ t → t ≤ s →
      (t, j) ∈ selectedColumnSlice S j := by
  intro r s t hr hs hrt hts
  have hrS : (r, j) ∈ S :=
    ((mem_selectedColumnSlice S j (r, j)).mp hr).1
  have hsS : (s, j) ∈ S :=
    ((mem_selectedColumnSlice S j (s, j)).mp hs).1
  have htS := connected_initialSelection_column_consecutive
    B hconn n lo hi hmem hlo S hSB hfirst hprefix
    j r s t hrS hsS hrt hts
  exact (mem_selectedColumnSlice S j (t, j)).mpr ⟨htS, rfl⟩

/-- **Concrete geometric product formula for the inverse coefficient.**
For an actual prefix selection in a connected skew diagram, each
occupied column contributes independently according to its selected
number of consecutive rows.  No factorization hypothesis is assumed. -/
theorem initialSelection_q_product (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (S : Diagram) (hSB : S ⊆ B)
    (hfirst : ∀ r j : ℕ, (r, j) ∈ S → j = lo r)
    (hprefix : ∀ r s j : ℕ, r ≤ s →
      (r, j) ∈ B → (s, j) ∈ S → (r, j) ∈ S)
    (x : ℚ) :
    verticalStripCoefficient x S =
      ∏ j ∈ occupiedColumnsRaw S,
        oneColumnInverseCoefficient x
          (selectedColumnSlice S j).card := by
  classical
  have hstrip : IsVerticalStrip S := by
    intro c hc d hd hrow
    have hcj := hfirst c.1 c.2 hc
    have hdj := hfirst d.1 d.2 hd
    rw [hrow] at hcj
    exact hcj.trans hdj.symm
  rw [verticalStripCoefficient_prod_columns x S hstrip]
  apply Finset.prod_congr rfl
  intro j hj
  apply verticalStripCoefficient_consecutive_column x
  · intro c hc
    exact ((mem_selectedColumnSlice S j c).mp hc).2
  · exact selectedColumnSlice_consecutive_of_initial
      B hconn n lo hi hmem hlo S hSB hfirst hprefix j

end TableauTransfer
