open CanonicalBlocks

/-- The left endpoint of an occupied row of the difference J\I is
exactly the first cell *not already in I*. This identifies the
geometric group boundaries with the cut functions of the ideal model. -/
theorem moving_row_left_eq_idealCut (D : Diagram)
    (I J : ShapeIdeal D)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmemD : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (nB : ℕ) (loB hiB : ℕ → ℕ)
    (hmemB : ∀ r j : ℕ,
      (r, j) ∈ intervalCells D I J ↔
        r < nB ∧ loB r ≤ j ∧ j < hiB r)
    (r : ℕ) (hr : r ∈ occupiedRows (intervalCells D I J)) :
    loB r = idealRowCut D I lo r := by
  classical
  have hLoD : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
    intro c
    exact ((hmemD c.1.1 c.1.2).mp c.property).2.1
  obtain ⟨p, hp, hpRow⟩ := Finset.mem_image.mp hr
  have hpr : (r, p.2) ∈ intervalCells D I J := by
    have hcell := hp
    have heq : p = (r, p.2) := Prod.ext hpRow rfl
    exact heq ▸ hcell
  have hprB := (hmemB r p.2).mp hpr
  have hprD :=
    (mem_intervalCells_iff_row_cuts D I J lo hLoD r p.2).mp hpr
  let lower : ℕ := idealRowCut D I lo r
  let upper : ℕ := idealRowCut D J lo r
  have hlobound : lo r ≤ lower := by
    dsimp [lower, idealRowCut]
    exact le_max_left _ _
  have hcutUpper : lower < upper := by
    dsimp [lower, upper]
    omega
  have hcutD : (r, lower) ∈ D := by
    have hdata := (hmemD r p.2).mp hprD.1
    apply (hmemD r lower).mpr
    exact ⟨hdata.1, hlobound, by omega⟩
  have hcutB : (r, lower) ∈ intervalCells D I J := by
    apply (mem_intervalCells_iff_row_cuts D I J lo hLoD r lower).mpr
    exact ⟨hcutD, le_refl _, hcutUpper⟩
  have hcutBdata := (hmemB r lower).mp hcutB
  have hLoBIn : (r, loB r) ∈ intervalCells D I J := by
    apply (hmemB r (loB r)).mpr
    exact ⟨hprB.1, le_refl _, by omega⟩
  have hLoBdata :=
    (mem_intervalCells_iff_row_cuts D I J lo hLoD
      r (loB r)).mp hLoBIn
  change loB r = lower
  omega

/-- Head selections of the genuine interval are *equivalent*, as
predicates, to the initial-strip selections previously characterized
by the ideal's row-cut function. -/
theorem initial_selection_iff_head_selection (D : Diagram)
    (I J : ShapeIdeal D)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmemD : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (nB : ℕ) (loB hiB : ℕ → ℕ)
    (hmemB : ∀ r j : ℕ,
      (r, j) ∈ intervalCells D I J ↔
        r < nB ∧ loB r ≤ j ∧ j < hiB r)
    (S : Diagram) :
    IsInitialStripSelection D I J lo S ↔
      IsHeadPrefixSelection (intervalCells D I J) loB S := by
  constructor
  · intro hS
    refine ⟨hS.1, ?_, hS.2.2⟩
    intro r j hj
    exact initialSelection_first_in_movingShape D I J
      n lo hi hmemD nB loB hiB hmemB S hS r j hj
  · intro hS
    refine ⟨hS.1, ?_, hS.2.2⟩
    intro r j hj
    have hr : r ∈ occupiedRows (intervalCells D I J) :=
      Finset.mem_image.mpr ⟨(r, j), hS.1 hj, rfl⟩
    have heq := moving_row_left_eq_idealCut D I J
      n lo hi hmemD nB loB hiB hmemB r hr
    exact (hS.2.1 r j hj).trans heq

/-- A direct identity-on-cells equivalence between the previous
initial-strip type and the canonical head-prefix type on the moving
diagram. -/
noncomputable def initialStripChoicesEquivHead (D : Diagram)
    (I J : ShapeIdeal D)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmemD : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (nB : ℕ) (loB hiB : ℕ → ℕ)
    (hmemB : ∀ r j : ℕ,
      (r, j) ∈ intervalCells D I J ↔
        r < nB ∧ loB r ≤ j ∧ j < hiB r) :
    InitialStripChoices D I J lo ≃
      HeadPrefixSelection (intervalCells D I J) loB := by
  classical
  refine ⟨
    (fun S => ⟨S.1, (mem_headPrefixSelections _ loB S.1).mpr
      ((initial_selection_iff_head_selection D I J
        n lo hi hmemD nB loB hiB hmemB S.1).mp
        ((mem_initialStripSelections D I J lo S.1).mp S.2))⟩),
    (fun S => ⟨S.1, (mem_initialStripSelections D I J lo S.1).mpr
      ((initial_selection_iff_head_selection D I J
        n lo hi hmemD nB loB hiB hmemB S.1).mpr
        ((mem_headPrefixSelections _ loB S.1).mp S.2))⟩),
    ?_, ?_⟩
  · intro S
    exact Subtype.ext rfl
  · intro S
    exact Subtype.ext rfl

end TableauTransfer
