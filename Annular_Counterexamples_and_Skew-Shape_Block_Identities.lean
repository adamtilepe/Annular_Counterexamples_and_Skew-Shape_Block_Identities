open CanonicalBlocks

/-- A first available cell of the interval, as measured by the old
ideal cut, is also the leftmost cell in the actual skew interval.
This bridges the two (a priori different) row-boundary representations. -/
theorem initialSelection_first_in_movingShape (D : Diagram)
    (I J : ShapeIdeal D)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmemD : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (nB : ℕ) (loB hiB : ℕ → ℕ)
    (hmemB : ∀ r j : ℕ,
      (r, j) ∈ intervalCells D I J ↔
        r < nB ∧ loB r ≤ j ∧ j < hiB r)
    (S : Diagram) (hS : IsInitialStripSelection D I J lo S)
    (r j : ℕ) (hrj : (r, j) ∈ S) :
    j = loB r := by
  classical
  have hLoD : ∀ c : ShapeCell D, lo c.1.1 ≤ c.1.2 := by
    intro c
    exact ((hmemD c.1.1 c.1.2).mp c.property).2.1
  have hfirst : j = idealRowCut D I lo r := hS.2.1 r j hrj
  have hB : (r, j) ∈ intervalCells D I J := hS.1 hrj
  have hjB := (hmemB r j).mp hB
  have hle : loB r ≤ j := hjB.2.1
  by_contra hne
  have hlt : loB r < j := by omega
  have hleftB : (r, loB r) ∈ intervalCells D I J := by
    apply (hmemB r (loB r)).mpr
    exact ⟨hjB.1, le_refl _, by omega⟩
  have hlow :=
    (mem_intervalCells_iff_row_cuts D I J lo hLoD
      r (loB r)).mp hleftB
  omega

/-- **the preceding lemmas geometric weight bridge for real intervals.**
If B = J\I is connected, every legal initial strip has an inverse
coefficient which is the product of the one-column run coefficients.
The factorization follows from the geometric constraints on an
initial vertical strip in a connected skew diagram. -/
theorem actualInitialStrip_q_product (D : Diagram)
    (_hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hconn : ConnectedSkewRows (intervalCells D I J))
    (S : Diagram) (x : ℚ)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmemD : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hloD : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhiD : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (hS : IsInitialStripSelection D I J lo S) :
    verticalStripCoefficient x S =
      ∏ j ∈ occupiedColumnsRaw S,
        oneColumnInverseCoefficient x
          (selectedColumnSlice S j).card := by
  classical
  let B : Diagram := intervalCells D I J
  have hBskew : SkewRowIntervals B :=
    movingShape_skew D ⟨n, lo, hi, hmemD, hloD, hhiD⟩ I J
  obtain ⟨nB, loB, hiB, hmemB, hloB, _hhiB⟩ := hBskew
  have hSB : S ⊆ B := hS.1
  have hFirst : ∀ r j : ℕ, (r, j) ∈ S → j = loB r := by
    intro r j hrj
    exact initialSelection_first_in_movingShape D I J
      n lo hi hmemD nB loB hiB hmemB S hS r j hrj
  have hPrefix : ∀ r s j : ℕ, r ≤ s →
      (r, j) ∈ B → (s, j) ∈ S → (r, j) ∈ S := hS.2.2
  exact initialSelection_q_product B hconn
    nB loB hiB hmemB hloB S hSB hFirst hPrefix x

