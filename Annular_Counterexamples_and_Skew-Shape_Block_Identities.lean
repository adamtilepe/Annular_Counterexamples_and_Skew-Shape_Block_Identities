/-! ### §6.1 — Canonical partition by admissible chains. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- An abstract connected chain is monotone in its ideal index. The
proof uses only consecutive strict inclusions, not connectedness. -/
theorem connectedBlockChain_ideals_mono
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i j : Fin (k + 1)) (hij : i ≤ j) :
    (C.ideals i).1 ⊆ (C.ideals j).1 := by
  classical
  have haux : ∀ m : ℕ, ∀ hm : m ≤ k,
      ∀ r : ℕ, ∀ hr : r ≤ m,
      (C.ideals ⟨r, by omega⟩).1 ⊆
        (C.ideals ⟨m, by omega⟩).1 := by
    intro m
    induction m with
    | zero =>
        intro hm r hr
        have hzero : r = 0 := by omega
        subst r
        exact Finset.Subset.rfl
    | succ m ih =>
        intro hm r hr
        by_cases hlast : r = m + 1
        · subst r
          exact Finset.Subset.rfl
        · have hprev : r ≤ m := by omega
          have hstep :
              (C.ideals (⟨m, by omega⟩ : Fin k).castSucc).1 ⊆
                (C.ideals (⟨m, by omega⟩ : Fin k).succ).1 :=
            (C.steps ⟨m, by omega⟩).1.subset
          exact (ih (by omega) r hprev).trans hstep
  exact haux j.val (by omega) i.val (by omega)

/-- Exact membership description for the i-th connected increment,
using the ambient finite cell subtype. -/
theorem mem_chainBlock_iff
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) (c : ShapeCell D) :
    c.1 ∈ chainBlock C i ↔
      c ∈ (C.ideals i.succ).1 ∧
        c ∉ (C.ideals i.castSucc).1 := by
  classical
  change c.1 ∈
    (((C.ideals i.succ).1 \ (C.ideals i.castSucc).1).image
       (fun d : ShapeCell D => d.1)) ↔ _
  constructor
  · intro hc
    obtain ⟨d, hd, hdval⟩ := Finset.mem_image.mp hc
    have heq : d = c := Subtype.ext hdval
    subst d
    exact Finset.mem_sdiff.mp hd
  · rintro ⟨hcJ, hcI⟩
    exact Finset.mem_image.mpr
      ⟨c, Finset.mem_sdiff.mpr ⟨hcJ, hcI⟩, rfl⟩

/-- A cell cannot be contributed by two DIFFERENT steps of one chain. -/
theorem chainBlock_index_unique
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i j : Fin k) (c : ShapeCell D)
    (hi : c.1 ∈ chainBlock C i)
    (hj : c.1 ∈ chainBlock C j) : i = j := by
  have hi' := (mem_chainBlock_iff C i c).mp hi
  have hj' := (mem_chainBlock_iff C j c).mp hj
  rcases lt_trichotomy i j with hlt | heq | hgt
  · have hsub : (C.ideals i.succ).1 ⊆
        (C.ideals j.castSucc).1 :=
      connectedBlockChain_ideals_mono C i.succ j.castSucc (by
        change i.val + 1 ≤ j.val
        omega)
    exact (hj'.2 (hsub hi'.1)).elim
  · exact heq
  · have hsub : (C.ideals j.succ).1 ⊆
        (C.ideals i.castSucc).1 :=
      connectedBlockChain_ideals_mono C j.succ i.castSucc (by
        change j.val + 1 ≤ i.val
        omega)
    exact (hi'.2 (hsub hj'.1)).elim

/-- Every cell in the full ideal, but not in the empty ideal, must
enter during the enumeration. The proof tracks first appearance by induction
on the finite step number and never assumes an implicit partition. -/
theorem chainBlock_index_exists
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) :
    ∃ i : Fin k, c.1 ∈ chainBlock C i := by
  classical
  have haux : ∀ m : ℕ, ∀ hm : m ≤ k,
      ∀ c : ShapeCell D,
        c ∈ (C.ideals ⟨m, by omega⟩).1 →
        c ∈ (C.ideals ⟨0, Nat.zero_lt_succ k⟩).1 ∨
          ∃ i : Fin k, i.val < m ∧ c.1 ∈ chainBlock C i := by
    intro m
    induction m with
    | zero =>
        intro hm d hd
        exact Or.inl hd
    | succ m ih =>
        intro hm d hd
        have hm_lt : m < k := by omega
        let i : Fin k := ⟨m, hm_lt⟩
        by_cases hprev : d ∈ (C.ideals i.castSucc).1
        · rcases ih (by omega) d hprev with hzero | ⟨j, hjlt, hjmem⟩
          · exact Or.inl hzero
          · exact Or.inr ⟨j, by omega, hjmem⟩
        · right
          refine ⟨i, by dsimp [i]; omega, ?_⟩
          apply (mem_chainBlock_iff C i d).mpr
          exact ⟨hd, hprev⟩
  have htop : c ∈ (C.ideals ⟨k, Nat.lt_succ_self k⟩).1 := by
    rw [C.finishes]
    exact Finset.mem_univ c
  have hbottom : c ∉ (C.ideals ⟨0, Nat.zero_lt_succ k⟩).1 := by
    rw [C.starts]
    simp [FinitePoset.bottomIdeal]
  rcases haux k (le_refl k) c htop with hc | ⟨i, _, hi⟩
  · exact (hbottom hc).elim
  · exact ⟨i, hi⟩

/-- The increments of a connected-block chain partition ALL the cells
of D, uniquely. This is the exact finite covering result needed for
the reverse direction of the fixed-chain label-counting problem. -/
theorem chainBlock_existsUnique_index
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) :
    ∃! i : Fin k, c.1 ∈ chainBlock C i := by
  obtain ⟨i, hi⟩ := chainBlock_index_exists C c
  exact ⟨i, hi, fun j hj => (chainBlock_index_unique C j i c hj hi)⟩

/-- The uniquely determined step at which a cell enters the ideal chain. -/
noncomputable def chainBlockIndex
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) : Fin k :=
  Classical.choose (chainBlock_index_exists C c)

/-- The selected step really contains its cell. -/
theorem chainBlockIndex_spec
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) :
    c.1 ∈ chainBlock C (chainBlockIndex C c) :=
  Classical.choose_spec (chainBlock_index_exists C c)

/-- Any membership in another step identifies that step with the
canonical index of the cell. -/
theorem chainBlockIndex_eq_of_mem
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) (i : Fin k)
    (hc : c.1 ∈ chainBlock C i) :
    chainBlockIndex C c = i := by
  exact chainBlock_index_unique C (chainBlockIndex C c) i c
    (chainBlockIndex_spec C c) hc

/-!
The reverse boundary->canonical-partition theorem is the NEXT bridge:
the i-th root is assigned to each cell through `chainBlockIndex`
without an additional covering assumption. It still requires checking
the global root order and invoking `correctedKahaneBlocks_exists_unique`.
The universal rational slot/Beta identity is established later in this section.
-/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — reconstructing the finite block-root assignment. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Assign to each cell the label of the unique chain increment to
which that cell belongs; outside the diagram leave the root unassigned. -/
noncomputable def chainRootAssignment
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) : PartialRoots := by
  classical
  exact fun c => if hc : c ∈ D then
    some (roots (chainBlockIndex C ⟨c, hc⟩)) else none

/-- The assignment is total on D, with the root of the unique step. -/
theorem chainRootAssignment_inside
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (c : ShapeCell D) :
    chainRootAssignment C roots c.1 =
      some (roots (chainBlockIndex C c)) := by
  classical
  simp only [chainRootAssignment, dite_eq_left c.property]

/-- The assignment does not introduce cells outside D. -/
theorem chainRootAssignment_outside
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (c : Cell) (hc : c ∉ D) :
    chainRootAssignment C roots c = none := by
  classical
  simp only [chainRootAssignment, dite_eq_right hc]

/-- For DISTINCT prescribed root labels, the fiber at the i-th root
is EXACTLY the i-th connected skew increment, as an equality of
finite diagrams. In particular this reconstruction cannot collapse
two separate blocks into a single fiber. -/
theorem chainRootAssignment_fiber
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (hrinj : Function.Injective roots)
    (i : Fin k) :
    arbitraryRootFiber D (chainRootAssignment C roots) (roots i) =
      chainBlock C i := by
  classical
  ext c
  rw [mem_arbitraryRootFiber]
  constructor
  · rintro ⟨hcD, hroot⟩
    have hroot' :
        roots (chainBlockIndex C ⟨c, hcD⟩) = roots i := by
      have hh := chainRootAssignment_inside C roots ⟨c, hcD⟩
      rw [hh] at hroot
      exact Option.some.inj hroot
    have hidx : chainBlockIndex C ⟨c, hcD⟩ = i :=
      hrinj hroot'
    simpa only [hidx] using
      (chainBlockIndex_spec C ⟨c, hcD⟩)
  · intro hc
    have hcD : c ∈ D :=
      intervalCells_subset_diagram D _ _ hc
    have hidx : chainBlockIndex C ⟨c, hcD⟩ = i :=
      chainBlockIndex_eq_of_mem C ⟨c, hcD⟩ i hc
    refine ⟨hcD, ?_⟩
    rw [chainRootAssignment_inside C roots ⟨c, hcD⟩]
    rw [hidx]

/-- For a strictly decreasing sequence of roots, distinct steps have
distinct root labels. -/
theorem chainRootLabels_injective
    {D : Diagram} {k : ℕ} (_C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (hanti : StrictAnti roots) :
    Function.Injective roots := hanti.injective

/-- Each chain increment has the expected root fiber for the
independently reconstructed assignment. -/
theorem chainRootAssignment_fiber_of_strictAnti
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (hanti : StrictAnti roots)
    (i : Fin k) :
    arbitraryRootFiber D (chainRootAssignment C roots) (roots i) =
      chainBlock C i :=
  chainRootAssignment_fiber C roots hanti.injective i

/-! ### §6.1 — Completion of the chain-labeling equivalence. -/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — boundary comparisons imply canonical chain compatibility. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A cell in an earlier lower ideal cannot first enter at a later
construction. This follows from the lower-ideal property of the chain. -/
theorem chainBlockIndex_monotone
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (a b : ShapeCell D) (hab : a ≤ b) :
    chainBlockIndex C a ≤ chainBlockIndex C b := by
  classical
  let i := chainBlockIndex C a
  let j := chainBlockIndex C b
  have hai := (mem_chainBlock_iff C i a).mp
    (chainBlockIndex_spec C a)
  have hbj := (mem_chainBlock_iff C j b).mp
    (chainBlockIndex_spec C b)
  by_contra hbad
  have hji : j.val < i.val := by
    have hnot : ¬ i ≤ j := hbad
    omega
  have hsub : (C.ideals j.succ).1 ⊆
      (C.ideals i.castSucc).1 :=
    connectedBlockChain_ideals_mono C j.succ i.castSucc (by
      change j.val + 1 ≤ i.val
      omega)
  have haJ : a ∈ (C.ideals j.succ).1 :=
    (C.ideals j.succ).2 hab hbj.1
  exact hai.2 (hsub haJ)

/-- The reconstructed root assignment is strictly antitone on
comparable cells of different blocks, as required by Kahane's actual
global-order convention. No boundary-label assumption is used here. -/
theorem chainRootAssignment_global_order
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (roots : Fin k → ℕ) (hanti : StrictAnti roots) :
    KahaneGlobalBlockOrder D (chainRootAssignment C roots) := by
  classical
  intro a b ra rb ha hb hrow hcol hra hrb hne
  let aa : ShapeCell D := ⟨a, ha⟩
  let bb : ShapeCell D := ⟨b, hb⟩
  have hab : aa ≤ bb := by
    change a ≤ b
    exact ⟨hrow, hcol⟩
  have hidx : chainBlockIndex C aa ≤ chainBlockIndex C bb :=
    chainBlockIndex_monotone C aa bb hab
  have hra' : roots (chainBlockIndex C aa) = ra := by
    have hh := chainRootAssignment_inside C roots aa
    rw [hh] at hra
    exact Option.some.inj hra
  have hrb' : roots (chainBlockIndex C bb) = rb := by
    have hh := chainRootAssignment_inside C roots bb
    rw [hh] at hrb
    exact Option.some.inj hrb
  have hneq : chainBlockIndex C aa ≠ chainBlockIndex C bb := by
    intro heq
    apply hne
    calc
      ra = roots (chainBlockIndex C aa) := hra'.symm
      _ = roots (chainBlockIndex C bb) := by rw [heq]
      _ = rb := hrb'
  have hlt : chainBlockIndex C aa < chainBlockIndex C bb :=
    lt_of_le_of_ne hidx hneq
  have hrootlt := hanti hlt
  omega

/-- The *precise* finite boundary inequalities for a prescribed chain:
roots decrease along the ideal chain, the root of each block has its
assigned label, and every non-root boundary cell satisfies Definition
4.1. This is a property of independent labels and the FIXED chain; no
reference to the canonical scan occurs in its definition. -/
def ChainBoundaryCompatible
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ) : Prop :=
  StrictAnti roots ∧
  (∀ i : Fin k,
    labelingOf D σ (chainBlockAnchor C i) = roots i) ∧
  (∀ i : Fin k,
    RootBoundaryConditions (chainBlock C i)
      (chainBlockAnchor C i) (labelingOf D σ))

/-- The independently assigned fibers satisfy ALL requirements of the
corrected globally ordered Kahane block partition. -/
theorem chainBoundaryCompatible_kahaneOrdered
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ)
    (h : ChainBoundaryCompatible C σ roots) :
    KahaneOrderedBlockAssignment D (labelingOf D σ)
      (chainRootAssignment C roots) := by
  classical
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro c hc
    let d : ShapeCell D := ⟨c, hc⟩
    refine ⟨roots (chainBlockIndex C d), ?_⟩
    exact chainRootAssignment_inside C roots d
  · intro c hc
    exact chainRootAssignment_outside C roots c hc
  · exact chainRootAssignment_global_order C roots h.1
  · intro r hnon
    have hr : ∃ i : Fin k, roots i = r := by
      obtain ⟨c, hc⟩ := hnon
      obtain ⟨hcD, hcRoot⟩ :=
        (mem_arbitraryRootFiber D (chainRootAssignment C roots) r c).mp hc
      let d : ShapeCell D := ⟨c, hcD⟩
      have hh := chainRootAssignment_inside C roots d
      rw [hh] at hcRoot
      exact ⟨chainBlockIndex C d, Option.some.inj hcRoot⟩
    obtain ⟨i, rfl⟩ := hr
    rw [chainRootAssignment_fiber C roots h.1.injective i]
    exact ⟨(C.steps i).2,
      chainBlockAnchor C i,
      chainBlockAnchor_corner C i,
      h.2.2 i, h.2.1 i⟩

/-- The reverse implication: a fixed chain whose roots satisfy exactly
Kahane's local boundary comparisons is the canonical chain of the
labeling. The argument uses the full uniqueness theorem of Lemma 4.3. -/
theorem chainBoundaryCompatible_canonical_fiber
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (h : ChainBoundaryCompatible C σ roots)
    (i : Fin k) :
    chainBlock C i =
      canonicalRootFiber D (labelingOf D σ) (roots i) := by
  classical
  let label := labelingOf D σ
  let F := chainRootAssignment C roots
  let G := rootsAfterHistory D label (canonicalScanHistory D)
  have hF : AdmissibleBlockAssignment D label F :=
    (admissible_iff_kahaneOrdered D label F hsk).mpr
      (chainBoundaryCompatible_kahaneOrdered C σ roots h)
  have hG : AdmissibleBlockAssignment D label G :=
    canonicalRoots_admissible D label hsk (labelingOf_injectiveOn D σ)
  have hsame : ∀ c : Cell, c ∈ D → F c = G c :=
    admissibleBlockAssignment_unique D label F G hF hG
  have hfiber : arbitraryRootFiber D F (roots i) =
      canonicalRootFiber D label (roots i) := by
    ext c
    rw [mem_arbitraryRootFiber, mem_canonicalRootFiber]
    constructor
    · rintro ⟨hc, hroot⟩
      exact ⟨hc, by simpa only [hsame c hc] using hroot⟩
    · rintro ⟨hc, hroot⟩
      exact ⟨hc, (hsame c hc).trans hroot⟩
  exact (chainRootAssignment_fiber C roots h.1.injective i).symm.trans
    hfiber

/-- Recover the COMPLETE compatibility predicate from just the
strict root ordering and inequalities within each fixed chain block.
In particular the reverse direction of the boundary comparison problem
is not left as an assumption or an informal bijection. -/
theorem chainBoundaryCompatible_implies_compatible
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (h : ChainBoundaryCompatible C σ roots) :
    ConnectedChainCompatibleLabeling C σ roots := by
  classical
  refine ⟨?_, h.1, ?_⟩
  · intro i
    exact chainBoundaryCompatible_canonical_fiber hsk C σ roots h i
  · intro r hr
    obtain ⟨c, hc⟩ := (mem_activeRootLabels_iff D σ r).mp hr
    have hcD : c ∈ D :=
      canonicalRootFiber_subset D (labelingOf D σ) r hc
    let d : ShapeCell D := ⟨c, hcD⟩
    let i := chainBlockIndex C d
    have hic : c ∈ chainBlock C i := chainBlockIndex_spec C d
    rw [chainBoundaryCompatible_canonical_fiber hsk C σ roots h i] at hic
    have hic' := (mem_canonicalRootFiber D (labelingOf D σ) (roots i) c).mp hic
    have hc' := (mem_canonicalRootFiber D (labelingOf D σ) r c).mp hc
    have heq : roots i = r := Option.some.inj
      (hic'.2.symm.trans hc'.2)
    exact ⟨i, heq⟩

/-- FULLY EQUIVALENT descriptions of which standard labelings realize
one prescribed chain: (1) canonical fibers and ordered roots; (2) root
inequalities plus the local boundary conditions of Definition 4.1.
The latter is the correct input to the factorial slot count. -/
theorem chainBoundaryCompatible_iff_compatible
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ) :
    ChainBoundaryCompatible C σ roots ↔
      ConnectedChainCompatibleLabeling C σ roots := by
  constructor
  · exact chainBoundaryCompatible_implies_compatible hsk C σ roots
  · intro hc
    have hinfo := compatibleChain_anchor_and_boundary hsk C σ roots hc
    exact ⟨hc.2.1, hinfo.1, hinfo.2⟩

/-! ### §6.1 — Auxiliary combinatorial identities. -/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: rational beta calculus (numeric bridge). -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The rational polynomial primitive is additive, by the polynomial sum
operator (rather than assuming any analytic integration properties). -/
theorem primitiveFromZero_add (p q : Polynomial ℚ) :
    primitiveFromZero (p + q) =
      primitiveFromZero p + primitiveFromZero q := by
  classical
  unfold primitiveFromZero
  apply Polynomial.sum_add_index p q
  · intro n
    simp
  · intro n a b
    simp only [add_div, map_add]

/-- The rational primitive of zero is zero. -/
theorem primitiveFromZero_zero :
    primitiveFromZero (0 : Polynomial ℚ) = 0 := by
  simp [primitiveFromZero]

/-- Exact rational integration is additive. -/
theorem integrateUnit_add (p q : Polynomial ℚ) :
    integrateUnit (p + q) = integrateUnit p + integrateUnit q := by
  unfold integrateUnit
  rw [primitiveFromZero_add, Polynomial.eval_add]

/-- Zero has zero unit integral. -/
theorem integrateUnit_zero : integrateUnit (0 : Polynomial ℚ) = 0 := by
  simp [integrateUnit, primitiveFromZero_zero]

/-- Rational integration distributes over an arbitrary FINITE sum. -/
theorem integrateUnit_finset_sum {ι : Type*} (s : Finset ι)
    (p : ι → Polynomial ℚ) :
    integrateUnit (∑ i ∈ s, p i) = ∑ i ∈ s, integrateUnit (p i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [integrateUnit_zero]
  | @insert i s hi ih =>
      simp only [Finset.sum_insert hi]
      rw [integrateUnit_add, ih]

/-- A monomial's rational unit integral, with arbitrary coefficient. -/
theorem integrateUnit_monomial (n : ℕ) (a : ℚ) :
    integrateUnit (Polynomial.monomial n a) =
      a / ((↑(n + 1)) : ℚ) := by
  classical
  unfold integrateUnit primitiveFromZero
  rw [Polynomial.sum_monomial_index]
  · simp only [Polynomial.eval_monomial, one_pow, mul_one]
  · simp

/-- The fundamental unit integral of X^n. -/
theorem integrateUnit_X_pow (n : ℕ) :
    integrateUnit ((Polynomial.X : Polynomial ℚ) ^ n) =
      1 / ((↑(n + 1)) : ℚ) := by
  rw [Polynomial.X_pow_eq_monomial]
  exact integrateUnit_monomial n 1

/-- The exact beta moment, computed via polynomial antiderivatives. -/
noncomputable def rationalBetaMoment (a b : ℕ) : ℚ :=
  integrateUnit ((Polynomial.X : Polynomial ℚ) ^ a *
    (1 - Polynomial.X) ^ b)

/-- The initial beta moment: integrate X^a against the uniform interval. -/
theorem rationalBetaMoment_zero (a : ℕ) :
    rationalBetaMoment a 0 = 1 / ((↑(a + 1)) : ℚ) := by
  simpa only [rationalBetaMoment, pow_zero, mul_one] using
    (integrateUnit_X_pow a)

/-- Pascal's relation for beta integrals. This is the decisive elementary
algebraic recurrence: no real integration or probability is used. -/
theorem rationalBetaMoment_pascal (a b : ℕ) :
    rationalBetaMoment a b =
      rationalBetaMoment a (b + 1) + rationalBetaMoment (a + 1) b := by
  have hpoly :
      (Polynomial.X : Polynomial ℚ) ^ a * (1 - Polynomial.X) ^ b =
        (Polynomial.X : Polynomial ℚ) ^ a * (1 - Polynomial.X) ^ (b + 1) +
        (Polynomial.X : Polynomial ℚ) ^ (a + 1) * (1 - Polynomial.X) ^ b := by
    simp only [pow_succ]
    ring
  change integrateUnit ((Polynomial.X : Polynomial ℚ) ^ a *
    (1 - Polynomial.X) ^ b) =
      integrateUnit ((Polynomial.X : Polynomial ℚ) ^ a *
        (1 - Polynomial.X) ^ (b + 1)) +
      integrateUnit ((Polynomial.X : Polynomial ℚ) ^ (a + 1) *
        (1 - Polynomial.X) ^ b)
  rw [hpoly, integrateUnit_add]

/-- The exact factorial formula for every rational beta moment.
It is proved from the Pascal recurrence, so it does not depend on a
pre-existing analytic beta-function theorem. -/
theorem rationalBetaMoment_factorial (a b : ℕ) :
    rationalBetaMoment a b =
      (Nat.factorial a : ℚ) * (Nat.factorial b : ℚ) /
        (Nat.factorial (a + b + 1) : ℚ) := by
  induction b generalizing a with
  | zero =>
      rw [rationalBetaMoment_zero]
      simp only [add_zero, Nat.factorial_zero, Nat.cast_one, mul_one]
      have hf : (Nat.factorial (a + 1) : ℚ) =
          ((↑(a + 1)) : ℚ) * (Nat.factorial a : ℚ) := by
        rw [Nat.factorial_succ]
        push_cast
        ring
      rw [hf]
      have hfa : (Nat.factorial a : ℚ) ≠ 0 := by positivity
      have ha : ((↑(a + 1)) : ℚ) ≠ 0 := by positivity
      field_simp
  | succ b ih =>
      have hp := rationalBetaMoment_pascal a b
      have hrec : rationalBetaMoment a (b + 1) =
          rationalBetaMoment a b - rationalBetaMoment (a + 1) b := by
        linarith
      rw [hrec, ih a, ih (a + 1)]
      have he1 : (a + 1) + b + 1 = (a + b + 1) + 1 := by omega
      have he2 : a + (b + 1) + 1 = (a + b + 1) + 1 := by omega
      rw [he1, he2]
      rw [Nat.factorial_succ a, Nat.factorial_succ b,
        Nat.factorial_succ (a + b + 1)]
      push_cast
      have hfa : (Nat.factorial a : ℚ) ≠ 0 := by positivity
      have hfb : (Nat.factorial b : ℚ) ≠ 0 := by positivity
      have hfs : (Nat.factorial (a + b + 1) : ℚ) ≠ 0 := by positivity
      have hs : ((↑(a + b + 2)) : ℚ) ≠ 0 := by positivity
      field_simp
      ring

/-! ### §6.1 — Polynomial primitive calculus. -/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: exact arbitrary-depth monomial integration. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- Integrating a single monomial with zero integration constant. -/
theorem primitiveFromZero_monomial_exact (n : ℕ) (a : ℚ) :
    primitiveFromZero (Polynomial.monomial n a) =
      Polynomial.monomial (n + 1) (a / ((↑(n + 1)) : ℚ)) := by
  classical
  unfold primitiveFromZero
  rw [Polynomial.sum_monomial_index]
  simp

/-- A numerical state which records the degree and coefficient after
integrating a sequence of powers of `X`. -/
noncomputable def monomialIntegralState (n : ℕ) (a : ℚ) :
    List ℕ → ℕ × ℚ
  | [] => (n, a)
  | m :: ms =>
      monomialIntegralState (n + m + 1)
        (a / ((↑(n + m + 1)) : ℚ)) ms

/-- EVERY iterated integral of pure monomial kernels is itself one
monomial, and its degree and coefficient obey the preceding finite
recurrence. This works for arbitrarily many roots. -/
theorem iterated_monomial_kernel_exact
    (ms : List ℕ) (n : ℕ) (a : ℚ) :
    ms.foldl (fun F m =>
      primitiveFromZero (F * (Polynomial.X : Polynomial ℚ) ^ m))
      (Polynomial.monomial n a) =
      Polynomial.monomial (monomialIntegralState n a ms).1
        (monomialIntegralState n a ms).2 := by
  induction ms generalizing n a with
  | nil =>
      rfl
  | cons m ms ih =>
      change
        ms.foldl (fun F j =>
          primitiveFromZero (F * (Polynomial.X : Polynomial ℚ) ^ j))
            (primitiveFromZero
              (Polynomial.monomial n a *
                (Polynomial.X : Polynomial ℚ) ^ m)) =
        Polynomial.monomial
          (monomialIntegralState (n + m + 1)
            (a / ((↑(n + m + 1)) : ℚ)) ms).1
          (monomialIntegralState (n + m + 1)
            (a / ((↑(n + m + 1)) : ℚ)) ms).2
      rw [Polynomial.monomial_mul_X_pow,
        primitiveFromZero_monomial_exact]
      exact ih (n + m + 1) (a / ((↑(n + m + 1)) : ℚ))

/-- Evaluating the preceding arbitrary-depth iterated integral at the
unit endpoint yields its coefficient (since `1 ^ degree = 1`). -/
theorem iterated_monomial_kernel_at_one (ms : List ℕ) :
    Polynomial.eval 1
      (ms.foldl (fun F m =>
        primitiveFromZero (F * (Polynomial.X : Polynomial ℚ) ^ m))
        (1 : Polynomial ℚ)) =
      (monomialIntegralState 0 1 ms).2 := by
  have h := iterated_monomial_kernel_exact ms 0 1
  simpa only [Polynomial.monomial_zero_one,
    Polynomial.eval_monomial, one_pow, mul_one] using
    congrArg (Polynomial.eval (1 : ℚ)) h

/-- The primitive also distributes over arbitrary finite sums. This is
needed to expand `(1-X)^u` into a sum of monomial kernels before applying
the arbitrary-depth monomial identity above. -/
theorem primitiveFromZero_finset_sum {ι : Type*}
    (s : Finset ι) (p : ι → Polynomial ℚ) :
    primitiveFromZero (∑ i ∈ s, p i) =
      ∑ i ∈ s, primitiveFromZero (p i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp [primitiveFromZero_zero]
  | @insert i s hi ih =>
      simp only [Finset.sum_insert hi]
      rw [primitiveFromZero_add, ih]

/-! ### §6.1 — Expansion of upper-boundary factors. -/

end OrderedRootIntegral
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- A fully general family of the MULTI-ROOT slot integral: when there
are no upper-boundary leaves, any number of lower-boundary leaves and
roots is handled by the exact monomial recurrence above. This gives a
nontrivial infinite family of 's numerical identities, but it
is one ingredient in the two-sided universal slot-counting theorem. -/
theorem slotKernelIntegral_no_upper (k : ℕ) (l : Fin k → ℕ) :
    slotKernelIntegral k l (fun _ => 0) =
      (monomialIntegralState 0 1
        (((List.finRange k).reverse).map l)).2 := by
  have h := iterated_monomial_kernel_at_one
    (((List.finRange k).reverse).map l)
  simpa only [slotKernelIntegral, pow_zero, mul_one,
    List.foldl_map] using h

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Arbitrary polynomial kernels -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- Iterated zero-constant primitives against an arbitrary list of
polynomial kernels, with arbitrary starting polynomial. -/
noncomputable def integratePolynomialKernels
    (ps : List (Polynomial ℚ)) (F : Polynomial ℚ) : Polynomial ℚ :=
  ps.foldl (fun G p => primitiveFromZero (G * p)) F

/-- The iterated rational integral is additive in its initial polynomial. -/
theorem integratePolynomialKernels_add
    (ps : List (Polynomial ℚ)) (F G : Polynomial ℚ) :
    integratePolynomialKernels ps (F + G) =
      integratePolynomialKernels ps F + integratePolynomialKernels ps G := by
  induction ps generalizing F G with
  | nil =>
      rfl
  | cons p ps ih =>
      change integratePolynomialKernels ps
        (primitiveFromZero ((F + G) * p)) =
          integratePolynomialKernels ps (primitiveFromZero (F * p)) +
            integratePolynomialKernels ps (primitiveFromZero (G * p))
      rw [add_mul, primitiveFromZero_add, ih]

/-- The iterated integral maps the zero polynomial to zero. -/
theorem integratePolynomialKernels_zero
    (ps : List (Polynomial ℚ)) :
    integratePolynomialKernels ps 0 = 0 := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
      change integratePolynomialKernels ps (primitiveFromZero (0 * p)) = 0
      simpa only [zero_mul, primitiveFromZero_zero] using ih

/-- Iterated integration commutes with *arbitrary finite sums*. -/
theorem integratePolynomialKernels_finset_sum
    {ι : Type*} (s : Finset ι) (F : ι → Polynomial ℚ)
    (ps : List (Polynomial ℚ)) :
    integratePolynomialKernels ps (∑ i ∈ s, F i) =
      ∑ i ∈ s, integratePolynomialKernels ps (F i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty, integratePolynomialKernels_zero]
  | @insert i s hi ih =>
      simp only [Finset.sum_insert hi]
      rw [integratePolynomialKernels_add, ih]

/-- The exact rational number obtained by expanding every subsequent
kernel into monomials, multiplying coefficients, and integrating at each
construction. This recursion is finite because every polynomial has finite
support and the list of kernels is finite. -/
noncomputable def polynomialKernelState :
    List (Polynomial ℚ) → ℕ → ℚ → ℚ
  | [], _, a => a
  | p :: ps, n, a =>
      ∑ m ∈ p.support,
        polynomialKernelState ps (n + m + 1)
          (a * p.coeff m / ((↑(n + m + 1)) : ℚ))

/-- The first integration of an arbitrary polynomial against a monomial
has an explicit, finite monomial expansion. -/
theorem primitiveFromZero_monomial_mul_expansion
    (n : ℕ) (a : ℚ) (p : Polynomial ℚ) :
    primitiveFromZero (Polynomial.monomial n a * p) =
      ∑ m ∈ p.support,
        Polynomial.monomial (n + m + 1)
          (a * p.coeff m / ((↑(n + m + 1)) : ℚ)) := by
  classical
  have hp : p = ∑ m ∈ p.support,
      Polynomial.monomial m (p.coeff m) := by
    simpa only [Polynomial.sum_def] using
      (Polynomial.sum_monomial_eq p).symm
  calc
    primitiveFromZero (Polynomial.monomial n a * p) =
        primitiveFromZero (Polynomial.monomial n a *
          ∑ m ∈ p.support, Polynomial.monomial m (p.coeff m)) := by
            exact congrArg
              (fun q : Polynomial ℚ =>
                primitiveFromZero (Polynomial.monomial n a * q)) hp
    _ = primitiveFromZero
          (∑ m ∈ p.support,
            Polynomial.monomial n a * Polynomial.monomial m (p.coeff m)) := by
            rw [Finset.mul_sum]
    _ = ∑ m ∈ p.support,
          primitiveFromZero
            (Polynomial.monomial n a * Polynomial.monomial m (p.coeff m)) := by
            rw [primitiveFromZero_finset_sum]
    _ = ∑ m ∈ p.support,
          Polynomial.monomial (n + m + 1)
            (a * p.coeff m / ((↑(n + m + 1)) : ℚ)) := by
            apply Finset.sum_congr rfl
            intro m hm
            rw [Polynomial.monomial_mul_monomial,
              primitiveFromZero_monomial_exact]

/-- **General finite reduction theorem.** For *any* list of polynomial
kernels, the exact iterated rational integral is the coefficient sum
`polynomialKernelState` above. No restrictions on the degrees or the
signs of the polynomial coefficients. -/
theorem integratePolynomialKernels_eval_monomial
    (ps : List (Polynomial ℚ)) (n : ℕ) (a : ℚ) :
    Polynomial.eval 1
      (integratePolynomialKernels ps (Polynomial.monomial n a)) =
        polynomialKernelState ps n a := by
  induction ps generalizing n a with
  | nil =>
      change Polynomial.eval 1 (Polynomial.monomial n a) = a
      simp only [Polynomial.eval_monomial, one_pow, mul_one]
  | cons p ps ih =>
      change Polynomial.eval 1
        (integratePolynomialKernels ps
          (primitiveFromZero (Polynomial.monomial n a * p))) =
          ∑ m ∈ p.support,
            polynomialKernelState ps (n + m + 1)
              (a * p.coeff m / ((↑(n + m + 1)) : ℚ))
      rw [primitiveFromZero_monomial_mul_expansion,
        integratePolynomialKernels_finset_sum,
        Polynomial.eval_finsetSum]
      apply Finset.sum_congr rfl
      intro m hm
      exact ih (n + m + 1)
        (a * p.coeff m / ((↑(n + m + 1)) : ℚ))

/-- In particular, the existing full multiroot kernel integral of the
manuscript is now given by an explicit finite sum of rational coefficients
for *arbitrary* lower- and upper-boundary counts. This is an exact
analytic identity, without a remaining polynomial integration symbol. -/
theorem slotKernelIntegral_eq_polynomialKernelState
    (k : ℕ) (l u : Fin k → ℕ) :
    slotKernelIntegral k l u =
      polynomialKernelState
        ((List.finRange k).reverse.map (fun i =>
          (Polynomial.X : Polynomial ℚ) ^ (l i) *
            (1 - Polynomial.X) ^ (u i))) 0 1 := by
  have h := integratePolynomialKernels_eval_monomial
    ((List.finRange k).reverse.map (fun i =>
      (Polynomial.X : Polynomial ℚ) ^ (l i) *
        (1 - Polynomial.X) ^ (u i))) 0 1
  simpa only [slotKernelIntegral, integratePolynomialKernels,
    Polynomial.monomial_zero_one] using h

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Concrete-chain kernels are the universal numerical kernels. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A chain's row- and column-boundary counts are exactly the numerical
parameters of the universal slot integral. The descending order of the
roots is respected on both sides. -/
theorem descendingChainKernelIntegral_eq_slotKernelIntegral
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    descendingChainKernelIntegral C =
      slotKernelIntegral k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1) := by
  classical
  have hf :
      (fun i : Fin k =>
        blockKernelPolynomial D
          (C.ideals i.castSucc) (C.ideals i.succ)) =
      (fun i : Fin k =>
        (Polynomial.X : Polynomial ℚ) ^ (rowCount (chainBlock C i) - 1) *
          (1 - Polynomial.X) ^ (columnCount (chainBlock C i) - 1)) := by
    funext i
    change
      (if (C.ideals i.castSucc).1 ⊂ (C.ideals i.succ).1 ∧
          ConnectedSkewRows
            (intervalCells D (C.ideals i.castSucc) (C.ideals i.succ)) then
        (Polynomial.X : Polynomial ℚ) ^
          (rowCount (chainBlock C i) - 1) *
          (1 - Polynomial.X) ^ (columnCount (chainBlock C i) - 1)
       else 0) =
      (Polynomial.X : Polynomial ℚ) ^ (rowCount (chainBlock C i) - 1) *
        (1 - Polynomial.X) ^ (columnCount (chainBlock C i) - 1)
    exact ite_eq_left (C.steps i)
  change
    Polynomial.eval 1
      (((List.finRange k).map (fun i : Fin k =>
        blockKernelPolynomial D
          (C.ideals i.castSucc) (C.ideals i.succ))).reverse.foldl
        (fun F p => primitiveFromZero (F * p)) 1) =
    Polynomial.eval 1
      (((List.finRange k).reverse.map (fun i : Fin k =>
        (Polynomial.X : Polynomial ℚ) ^ (rowCount (chainBlock C i) - 1) *
          (1 - Polynomial.X) ^ (columnCount (chainBlock C i) - 1))).foldl
        (fun F p => primitiveFromZero (F * p)) 1)
  rw [hf, List.map_reverse]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Root-kernel closure identity. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

private theorem polynomial_eq_of_derivative_and_eval_zero
    (p q : Polynomial ℚ)
    (hd : Polynomial.derivative p = Polynomial.derivative q)
    (h0 : p.eval 0 = q.eval 0) : p = q := by
  have hs : Polynomial.derivative (p - q) = 0 := by
    simp only [Polynomial.derivative_sub, hd, sub_self]
  have hc := Polynomial.eq_C_of_derivative_eq_zero hs
  have he : (p - q).eval (0 : ℚ) = 0 := by
    simp only [Polynomial.eval_sub, h0, sub_self]
  have hcoeff : (p - q).coeff 0 = 0 := by
    have heq := congrArg (Polynomial.eval (0 : ℚ)) hc
    rw [he, Polynomial.eval_C] at heq
    exact heq.symm
  have hz : p - q = 0 := by
    simpa only [hcoeff, map_zero] using hc
  exact sub_eq_zero.mp hz

private theorem polynomial_kernel_euler (a b : ℕ) :
    (Polynomial.X : Polynomial ℚ) *
      Polynomial.derivative
        ((Polynomial.X : Polynomial ℚ) ^ a *
          (1 - Polynomial.X) ^ b) =
    (↑(a + b) : Polynomial ℚ) *
      ((Polynomial.X : Polynomial ℚ) ^ a *
        (1 - Polynomial.X) ^ b) -
    (↑b : Polynomial ℚ) *
      ((Polynomial.X : Polynomial ℚ) ^ a *
        (1 - Polynomial.X) ^ (b - 1)) := by
  cases a with
  | zero =>
      cases b with
      | zero => simp
      | succ b =>
          simp only [pow_zero, one_mul, Nat.zero_add, Nat.succ_sub_one]
          rw [Polynomial.derivative_pow_succ]
          simp only [Polynomial.derivative_sub, Polynomial.derivative_one,
            Polynomial.derivative_X, zero_sub, mul_neg, mul_one]
          push_cast
          rw [pow_succ]
          simp only [map_add, map_one, map_natCast]
          ring_nf
  | succ a =>
      cases b with
      | zero =>
          simp only [pow_zero, mul_one, Nat.add_zero, Nat.cast_zero,
            zero_mul, sub_zero]
          rw [Polynomial.derivative_X_pow]
          simp only [Nat.add_sub_cancel, Nat.cast_succ]
          rw [pow_succ]
          simp only [map_add, map_one, map_natCast]
          ring_nf
      | succ b =>
          simp only [Nat.succ_sub_one]
          rw [Polynomial.derivative_mul, Polynomial.derivative_X_pow,
            Polynomial.derivative_pow_succ]
          simp only [Polynomial.derivative_sub, Polynomial.derivative_one,
            Polynomial.derivative_X, zero_sub, mul_neg, mul_one,
            Nat.add_sub_cancel, Nat.cast_add, Nat.cast_succ]
          rw [pow_succ (Polynomial.X : Polynomial ℚ) a,
            pow_succ ((1 : Polynomial ℚ) - Polynomial.X) b]
          simp only [map_add, map_one, map_natCast]
          ring_nf

/-- A kernel for one root, with its `a` lower and `b` upper leaves. -/
noncomputable def eulerRootKernel (a b : ℕ) : Polynomial ℚ :=
  (Polynomial.X : Polynomial ℚ) ^ a * (1 - Polynomial.X) ^ b

/-- The exact iterated integral polynomial, roots listed from largest
label to smallest; the recursion integrates the smallest root first. -/
noncomputable def eulerRootPrimitive : List (ℕ × ℕ) → Polynomial ℚ
  | [] => 1
  | (a, b) :: ps =>
      primitiveFromZero (eulerRootKernel a b * eulerRootPrimitive ps)

/-- Total number of roots and constrained nonroot leaves. -/
def eulerRootMass : List (ℕ × ℕ) → ℕ
  | [] => 0
  | (a, b) :: ps => 1 + a + b + eulerRootMass ps

/-- The weighted sum of primitives obtained by deleting one UPPER leaf.
All upper-leaf positions, including those in later blocks, contribute. -/
noncomputable def eulerUpperDeletion : List (ℕ × ℕ) → Polynomial ℚ
  | [] => 0
  | (a, b) :: ps =>
      (↑b : Polynomial ℚ) *
        eulerRootPrimitive ((a, b - 1) :: ps) +
      primitiveFromZero (eulerRootKernel a b * eulerUpperDeletion ps)

/-- The universal polynomial Euler relation. Evaluating at 1 yields
exactly the recursion by deleting the largest label, with one term for
each upper leaf and an extra term when the largest root is available. -/
theorem eulerRootPrimitive_euler (ps : List (ℕ × ℕ)) :
    (Polynomial.X : Polynomial ℚ) *
        Polynomial.derivative (eulerRootPrimitive ps) =
      (↑(eulerRootMass ps) : Polynomial ℚ) * eulerRootPrimitive ps -
        eulerUpperDeletion ps := by
  induction ps with
  | nil =>
      simp [eulerRootPrimitive, eulerRootMass, eulerUpperDeletion]
  | cons ab ps ih =>
      rcases ab with ⟨a, b⟩
      let K := eulerRootKernel a b
      let F := eulerRootPrimitive ps
      let U := eulerUpperDeletion ps
      let J := primitiveFromZero (K * F)
      let Jm := primitiveFromZero (eulerRootKernel a (b - 1) * F)
      let R := (↑(eulerRootMass ((a,b)::ps)) : Polynomial ℚ) * J -
        ((↑b : Polynomial ℚ) * Jm + primitiveFromZero (K * U))
      have hJ : Polynomial.derivative J = K * F :=
        derivative_primitiveFromZero _
      have hJm : Polynomial.derivative Jm =
          eulerRootKernel a (b - 1) * F :=
        derivative_primitiveFromZero _
      have hP : Polynomial.derivative (primitiveFromZero (K * U)) =
          K * U := derivative_primitiveFromZero _
      have hK : (Polynomial.X : Polynomial ℚ) * Polynomial.derivative K =
          (↑(a + b) : Polynomial ℚ) * K -
            (↑b : Polynomial ℚ) * eulerRootKernel a (b - 1) := by
        exact polynomial_kernel_euler a b
      have hF : (Polynomial.X : Polynomial ℚ) * Polynomial.derivative F =
          (↑(eulerRootMass ps) : Polynomial ℚ) * F - U := ih
      have hder : Polynomial.derivative
          ((Polynomial.X : Polynomial ℚ) * Polynomial.derivative J) =
          Polynomial.derivative R := by
        simp only [R, Polynomial.derivative_mul, Polynomial.derivative_X,
          Polynomial.derivative_sub, Polynomial.derivative_add,
          Polynomial.derivative_natCast, zero_mul, zero_add, one_mul,
          hJ, hJm, hP]
        -- First group the `K'` and `F'` terms by the Euler identities.
        calc
          K * F + Polynomial.X *
              (Polynomial.derivative K * F + K * Polynomial.derivative F) =
              K * F + ((Polynomial.X * Polynomial.derivative K) * F) +
                K * (Polynomial.X * Polynomial.derivative F) := by ring
          _ = (↑(eulerRootMass ((a, b) :: ps)) : Polynomial ℚ) * (K * F) -
                ((↑b : Polynomial ℚ) * (eulerRootKernel a (b - 1) * F) +
                  K * U) := by
                rw [hK, hF]
                simp only [eulerRootMass]
                push_cast
                ring
      have hJ0 : J.eval 0 = 0 := by
        exact primitiveFromZero_eval_zero _
      have hJm0 : Jm.eval 0 = 0 := by
        exact primitiveFromZero_eval_zero _
      have hU0 : (primitiveFromZero (K * U)).eval 0 = 0 :=
        primitiveFromZero_eval_zero _
      have h0 : ((Polynomial.X : Polynomial ℚ) *
            Polynomial.derivative J).eval 0 = R.eval 0 := by
        simp [R, Polynomial.eval_mul, Polynomial.eval_sub,
          Polynomial.eval_add, hJ0, hJm0, hU0]
      have hmain := polynomial_eq_of_derivative_and_eval_zero
        ((Polynomial.X : Polynomial ℚ) * Polynomial.derivative J) R hder h0
      change (Polynomial.X : Polynomial ℚ) *
        Polynomial.derivative J = R
      exact hmain


/-- Exact recurrence for the rational ordered-root integral, obtained
by evaluating the Euler polynomial identity at the upper endpoint. -/
theorem eulerRootPrimitive_eval_one_recurrence
    (a b : ℕ) (ps : List (ℕ × ℕ)) :
    (↑(eulerRootMass ((a, b) :: ps)) : ℚ) *
        (eulerRootPrimitive ((a, b) :: ps)).eval 1 =
      (eulerUpperDeletion ((a, b) :: ps)).eval 1 +
        if b = 0 then (eulerRootPrimitive ps).eval 1 else 0 := by
  have h := congrArg (Polynomial.eval (1 : ℚ))
    (eulerRootPrimitive_euler ((a, b) :: ps))
  have hder : Polynomial.derivative (eulerRootPrimitive ((a, b) :: ps)) =
      eulerRootKernel a b * eulerRootPrimitive ps := by
    exact derivative_primitiveFromZero _
  rw [hder] at h
  simp only [Polynomial.eval_mul, Polynomial.eval_sub,
    Polynomial.eval_X, Polynomial.eval_natCast, one_mul] at h
  have hK : (eulerRootKernel a b).eval (1 : ℚ) =
      if b = 0 then 1 else 0 := by
    cases b with
    | zero => simp [eulerRootKernel]
    | succ b => simp [eulerRootKernel]
  rw [hK] at h
  have hr : (if b = 0 then (eulerRootPrimitive ps).eval 1 else 0) =
      (↑(eulerRootMass ((a, b) :: ps)) : ℚ) *
        (eulerRootPrimitive ((a, b) :: ps)).eval 1 -
          (eulerUpperDeletion ((a, b) :: ps)).eval 1 := by
    simpa only [ite_mul, one_mul, zero_mul] using h
  linear_combination -hr

/-- The recursive polynomial representation coincides with the
reverse-fold ordered integral already present in the established formulation. -/
theorem eulerRootPrimitive_eq_reverse_fold
    (ps : List (ℕ × ℕ)) :
    eulerRootPrimitive ps =
      ps.reverse.foldl
        (fun F ab => primitiveFromZero (F * eulerRootKernel ab.1 ab.2)) 1 := by
  induction ps with
  | nil => rfl
  | cons ab ps ih =>
      rcases ab with ⟨a, b⟩
      simp only [List.reverse_cons, List.foldl_append,
        List.foldl_cons, List.foldl_nil]
      rw [← ih]
      simp only [eulerRootPrimitive]
      rw [mul_comm]

/-- Identifies the new recursive representation with the EXISTING
`slotKernelIntegral`, rather than introducing an unrelated integral. -/
theorem slotKernelIntegral_eq_eulerRootPrimitive
    (k : ℕ) (l u : Fin k → ℕ) :
    slotKernelIntegral k l u =
      (eulerRootPrimitive
        ((List.finRange k).map (fun i => (l i, u i)))).eval 1 := by
  rw [eulerRootPrimitive_eq_reverse_fold]
  unfold slotKernelIntegral
  have hfold (xs : List (Fin k)) :
      (xs.map (fun i =>
        (Polynomial.X : Polynomial ℚ) ^ (l i) *
          (1 - Polynomial.X) ^ (u i))).foldl
          (fun F p => primitiveFromZero (F * p)) 1 =
        (xs.map (fun i => (l i, u i))).foldl
          (fun F ab => primitiveFromZero
            (F * eulerRootKernel ab.1 ab.2)) 1 := by
    simp only [List.foldl_map, eulerRootKernel]
  simpa only [List.map_reverse] using
    congrArg (Polynomial.eval (1 : ℚ))
      (hfold (List.finRange k).reverse)

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: finite factorial gap-counting bridge. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- The total factorial weight associated with the occupancies of a
finite family of gaps. -/
noncomputable def factorialGapWeight {G : Type*} [Fintype G]
    (n : G → ℕ) : ℚ :=
  ∏ g : G, (Nat.factorial (n g) : ℚ)

/-- The occupancy profile after placing one extra, distinct free leaf
in the specified gap. -/
def addFreeLeafToGap {G : Type*} [DecidableEq G]
    (n : G → ℕ) (g : G) : G → ℕ :=
  fun j => n j + if j = g then 1 else 0

/-- For one chosen gap, the extra free leaf has exactly `n g + 1`
possible positions among the previously ordered leaves of that gap. -/
theorem factorialGapWeight_addFreeLeaf
    {G : Type*} [Fintype G] [DecidableEq G]
    (n : G → ℕ) (g : G) :
    factorialGapWeight (addFreeLeafToGap n g) =
      ((n g + 1 : ℕ) : ℚ) * factorialGapWeight n := by
  classical
  unfold factorialGapWeight addFreeLeafToGap
  calc
    (∏ j : G,
      (Nat.factorial (n j + if j = g then 1 else 0) : ℚ)) =
        ∏ j : G,
          (if j = g then ((n g + 1 : ℕ) : ℚ) else 1) *
            (Nat.factorial (n j) : ℚ) := by
              apply Finset.prod_congr rfl
              intro j _
              by_cases hj : j = g
              · subst j
                simp [Nat.factorial_succ]
              · simp [hj]
    _ = (∏ j : G,
          (if j = g then ((n g + 1 : ℕ) : ℚ) else 1)) *
          (∏ j : G, (Nat.factorial (n j) : ℚ)) := by
            rw [Finset.prod_mul_distrib]
    _ = ((n g + 1 : ℕ) : ℚ) *
          (∏ j : G, (Nat.factorial (n j) : ℚ)) := by
            congr 1
            simp

/-- The factorial sum over all places to insert one free leaf.
It is the exact *unnormalized* free-leaf recurrence, independent
of any diagram geometry or restriction on the number of roots. -/
theorem factorialGapWeight_sum_addFreeLeaf
    {G : Type*} [Fintype G] [DecidableEq G]
    (n : G → ℕ) :
    (∑ g : G, factorialGapWeight (addFreeLeafToGap n g)) =
      ((Fintype.card G : ℚ) + ∑ g : G, (n g : ℚ)) *
        factorialGapWeight n := by
  classical
  calc
    (∑ g : G, factorialGapWeight (addFreeLeafToGap n g)) =
        ∑ g : G, (((n g + 1 : ℕ) : ℚ) * factorialGapWeight n) := by
          apply Finset.sum_congr rfl
          intro g _
          exact factorialGapWeight_addFreeLeaf n g
    _ = (∑ g : G, (((n g + 1 : ℕ) : ℚ))) *
          factorialGapWeight n := by
            rw [Finset.sum_mul]
    _ = ((Fintype.card G : ℚ) + ∑ g : G, (n g : ℚ)) *
          factorialGapWeight n := by
            congr 1
            simp [Nat.cast_add, Finset.sum_add_distrib, add_comm]

/-- For `k` ordered roots, the number of gaps is `k+1`. The
statement is valid for any occupancy profile, including empty
ones and arbitrary numbers of free and constrained leaves. -/
theorem factorialFinGapWeight_sum_addFreeLeaf
    (k : ℕ) (n : Fin (k + 1) → ℕ) :
    (∑ g : Fin (k + 1),
      factorialGapWeight (addFreeLeafToGap n g)) =
      (((k + 1 : ℕ) : ℚ) +
        ∑ g : Fin (k + 1), (n g : ℚ)) * factorialGapWeight n := by
  simpa only [Fintype.card_fin] using
    (factorialGapWeight_sum_addFreeLeaf n)

/-- The normalized version of free-leaf insertion: after summing over
all its possible gaps, adding a free leaf changes neither the
probability nor the normalized factorial weight. This is the exact
cancellation needed to remove the parameter `f` from the slot count. -/
theorem factorialFinGapWeight_normalized_free_leaf
    (k : ℕ) (n : Fin (k + 1) → ℕ) :
    (∑ g : Fin (k + 1),
        factorialGapWeight (addFreeLeafToGap n g)) /
        (Nat.factorial (k + (∑ g : Fin (k + 1), n g) + 1) : ℚ) =
      factorialGapWeight n /
        (Nat.factorial (k + (∑ g : Fin (k + 1), n g)) : ℚ) := by
  classical
  let N : ℕ := k + (∑ g : Fin (k + 1), n g)
  have hsum : (∑ g : Fin (k + 1), (n g : ℚ)) =
      ((∑ g : Fin (k + 1), n g : ℕ) : ℚ) := by
    norm_cast
  have hN : (((k + 1 : ℕ) : ℚ) +
      ∑ g : Fin (k + 1), (n g : ℚ)) = (↑(N + 1) : ℚ) := by
    rw [hsum]
    dsimp [N]
    push_cast
    ring
  have hfactor : (Nat.factorial (N + 1) : ℚ) =
      (↑(N + 1) : ℚ) * (Nat.factorial N : ℚ) := by
    rw [Nat.factorial_succ]
    push_cast
    ring
  have hn : (↑(N + 1) : ℚ) ≠ 0 := by positivity
  have hf : (Nat.factorial N : ℚ) ≠ 0 := by positivity
  rw [factorialFinGapWeight_sum_addFreeLeaf, hN]
  change ((↑(N + 1) : ℚ) * factorialGapWeight n) /
      (Nat.factorial (N + 1) : ℚ) =
      factorialGapWeight n / (Nat.factorial N : ℚ)
  rw [hfactor]
  field_simp [hn, hf]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Removing the existential choice of root labels

Before comparing a concrete chain with the universal leaf-and-gap
count, root labels must be determined by the labels on the actual
anchors. The following equations remove the quantifier over `roots`
from the definition of `chainCompatibleStandardLabelings`. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- For a fixed chain and a standard labeling, root values are not
independent data: they are the labels of the actual block anchors. -/
noncomputable def chainAnchorRootLabels
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) : Fin k → ℕ :=
  fun i => labelingOf D σ (chainBlockAnchor C i)

/-- A boundary-compatible choice of roots is uniquely determined
by the anchors. This is not a uniqueness assumption. -/
theorem chainBoundaryCompatible_root_values
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ)
    (hc : ChainBoundaryCompatible C σ roots) :
    roots = chainAnchorRootLabels C σ := by
  funext i
  exact (hc.2.1 i).symm

/-- Exact *quantifier-free* criterion for membership in the finite
set of labelings realizing a concrete chain. Only the strict order
of the anchor labels and the genuinely local boundary conditions
remain. The proof uses the previously established geometric converse. -/
theorem mem_chainCompatibleStandardLabelings_iff_anchor
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D) :
    σ ∈ chainCompatibleStandardLabelings C ↔
      ChainBoundaryCompatible C σ (chainAnchorRootLabels C σ) := by
  classical
  unfold chainCompatibleStandardLabelings
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨roots, hc⟩
    have hboundary : ChainBoundaryCompatible C σ roots :=
      (chainBoundaryCompatible_iff_compatible hsk C σ roots).mpr hc
    have heq : roots = chainAnchorRootLabels C σ :=
      chainBoundaryCompatible_root_values C σ roots hboundary
    rw [← heq]
    exact hboundary
  · intro hc
    exact ⟨chainAnchorRootLabels C σ,
      (chainBoundaryCompatible_iff_compatible hsk C σ
        (chainAnchorRootLabels C σ)).mp hc⟩

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: finite insertion bijection. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- An exact splitting of the universal leaf type when one unrestricted
leaf is adjoined.  The old leaves are on the left; the new distinguished
leaf is on the right. -/
noncomputable def slotLeafFreeSplit
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    SlotLeaf k l u (f + 1) ≃ SlotLeaf k l u f ⊕ PUnit.{1} := by
  let L : Type := Σ i : Fin k, Fin (l i)
  let U : Type := Σ i : Fin k, Fin (u i)
  let e : Fin (f + 1) ≃ Fin f ⊕ PUnit.{1} :=
    (finSuccEquivLast (n := f)).trans
      (Equiv.optionEquivSumPUnit (Fin f))
  exact
    (((Equiv.refl L).sumCongr ((Equiv.refl U).sumCongr e)).trans
      ((Equiv.refl L).sumCongr
        ((Equiv.sumAssoc U (Fin f) PUnit).symm))).trans
      ((Equiv.sumAssoc L (U ⊕ Fin f) PUnit).symm)

@[simp] theorem slotLeafFreeSplit_lower
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : Σ i : Fin k, Fin (l i)) :
    slotLeafFreeSplit k l u f (Sum.inl v) =
      Sum.inl (Sum.inl v) := by
  simp [slotLeafFreeSplit]

@[simp] theorem slotLeafFreeSplit_upper
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : Σ i : Fin k, Fin (u i)) :
    slotLeafFreeSplit k l u f (Sum.inr (Sum.inl v)) =
      Sum.inl (Sum.inr (Sum.inl v)) := by
  simp [slotLeafFreeSplit]

@[simp] theorem slotLeafFreeSplit_old_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) (v : Fin f) :
    slotLeafFreeSplit k l u f
      (Sum.inr (Sum.inr v.castSucc)) =
      Sum.inl (Sum.inr (Sum.inr v)) := by
  simp [slotLeafFreeSplit]

@[simp] theorem slotLeafFreeSplit_new_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotLeafFreeSplit k l u f
      (Sum.inr (Sum.inr (Fin.last f))) =
      Sum.inr PUnit.unit := by
  simp [slotLeafFreeSplit]

/-- The exact old-leaf condition survives the splitting.  This is
substantive: it certifies that *all* of the lower- and upper-leaf
restrictions are unchanged, not merely that their ambient types have
matching cardinalities.

### 6.1: explicit inverses of the canonical free-leaf splitting

Instead of simplifying a dependent match under an opaque `Equiv.symm`,
the four inverse images are recorded as exact equalities. -/
@[simp] theorem slotLeafFreeSplit_symm_lower
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : Σ i : Fin k, Fin (l i)) :
    (slotLeafFreeSplit k l u f).symm (Sum.inl (Sum.inl v)) =
      Sum.inl v := by
  apply (slotLeafFreeSplit k l u f).injective
  simp

@[simp] theorem slotLeafFreeSplit_symm_upper
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : Σ i : Fin k, Fin (u i)) :
    (slotLeafFreeSplit k l u f).symm
        (Sum.inl (Sum.inr (Sum.inl v))) =
      Sum.inr (Sum.inl v) := by
  apply (slotLeafFreeSplit k l u f).injective
  simp

@[simp] theorem slotLeafFreeSplit_symm_old_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : Fin f) :
    (slotLeafFreeSplit k l u f).symm
        (Sum.inl (Sum.inr (Sum.inr v))) =
      Sum.inr (Sum.inr v.castSucc) := by
  apply (slotLeafFreeSplit k l u f).injective
  simp

@[simp] theorem slotLeafFreeSplit_symm_new_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    (slotLeafFreeSplit k l u f).symm (Sum.inr PUnit.unit) =
      Sum.inr (Sum.inr (Fin.last f)) := by
  apply (slotLeafFreeSplit k l u f).injective
  simp

/-- Admissibility for an old leaf is exactly preserved by the split. -/
theorem slotAllowed_freeSplit_existingLeaf
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (v : SlotLeaf k l u f) (g : Fin (k + 1)) :
    SlotAllowed k l u (f + 1)
      ((slotLeafFreeSplit k l u f).symm (Sum.inl v)) g ↔
        SlotAllowed k l u f v g := by
  cases v with
  | inl v =>
      rcases v with ⟨i, j⟩
      simp [slotLeafFreeSplit_symm_lower, SlotAllowed]
  | inr v =>
      cases v with
      | inl v =>
          rcases v with ⟨i, j⟩
          simp [slotLeafFreeSplit_symm_upper, SlotAllowed]
      | inr v =>
          simp [slotLeafFreeSplit_symm_old_free, SlotAllowed]

/-- The added, distinguished leaf is admissible in every gap. -/
theorem slotAllowed_freeSplit_addedLeaf
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (g : Fin (k + 1)) :
    SlotAllowed k l u (f + 1)
      ((slotLeafFreeSplit k l u f).symm (Sum.inr PUnit.unit)) g := by
  simp only [slotLeafFreeSplit_symm_new_free, SlotAllowed]

/-- **The missing combinatorial reindexing.** An admissible assignment
with `f+1` free leaves is EXACTLY an assignment with `f` free leaves
plus one arbitrary gap for the new leaf.  This is a true equivalence of
subtypes with proofs of admissibility, not a counting postulate. -/
noncomputable def allowedSlotAssignment_freeLeafEquiv
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    AllowedSlotAssignment k l u (f + 1) ≃
      AllowedSlotAssignment k l u f × Fin (k + 1) := by
  classical
  let E : SlotLeaf k l u (f + 1) ≃
      (SlotLeaf k l u f ⊕ PUnit.{1}) := slotLeafFreeSplit k l u f
  let new : SlotLeaf k l u (f + 1) :=
    E.symm (Sum.inr PUnit.unit)
  refine {
    toFun := fun b =>
      (⟨(fun v => b.1 (E.symm (Sum.inl v))), by
          intro v
          exact (slotAllowed_freeSplit_existingLeaf k l u f v
            (b.1 (E.symm (Sum.inl v)))).mp (b.2 _)⟩,
       b.1 new)
    invFun := fun ag =>
      ⟨(fun v =>
          match E v with
          | Sum.inl w => ag.1.1 w
          | Sum.inr _ => ag.2), by
        intro v
        cases hv : E v with
        | inl w =>
            have heq : E.symm (Sum.inl w) = v := by
              simpa only [hv] using E.symm_apply_apply v
            have h : SlotAllowed k l u (f + 1)
                (E.symm (Sum.inl w)) (ag.1.1 w) :=
              (slotAllowed_freeSplit_existingLeaf k l u f w
                (ag.1.1 w)).mpr (ag.1.2 w)
            rw [heq] at h
            change SlotAllowed k l u (f + 1) v
              (match E v with
               | Sum.inl w => ag.1.1 w
               | Sum.inr _ => ag.2)
            rw [hv]
            exact h
        | inr z =>
            cases z
            have heq : E.symm (Sum.inr PUnit.unit) = v := by
              simpa only [hv] using E.symm_apply_apply v
            have h : SlotAllowed k l u (f + 1)
                (E.symm (Sum.inr PUnit.unit)) ag.2 :=
              slotAllowed_freeSplit_addedLeaf k l u f ag.2
            rw [heq] at h
            change SlotAllowed k l u (f + 1) v
              (match E v with
               | Sum.inl w => ag.1.1 w
               | Sum.inr _ => ag.2)
            rw [hv]
            exact h⟩
    left_inv := ?_
    right_inv := ?_ }
  · intro b
    apply Subtype.ext
    funext v
    change (match E v with
      | Sum.inl w => b.1 (E.symm (Sum.inl w))
      | Sum.inr _ => b.1 new) = b.1 v
    cases hv : E v with
    | inl w =>
        have heq : E.symm (Sum.inl w) = v := by
          simpa only [hv] using E.symm_apply_apply v
        simp only [heq]
    | inr z =>
        cases z
        have heq : E.symm (Sum.inr PUnit.unit) = v := by
          simpa only [hv] using E.symm_apply_apply v
        simp only [heq, new]
  · rintro ⟨a, g⟩
    apply Prod.ext
    · apply Subtype.ext
      funext v
      change (match E (E.symm (Sum.inl v)) with
        | Sum.inl w => a.1 w
        | Sum.inr _ => g) = a.1 v
      simp only [E.apply_symm_apply]
    · change (match E new with
        | Sum.inl w => a.1 w
        | Sum.inr _ => g) = g
      simp only [new, E.apply_symm_apply]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Exact factorial fibres under the free-leaf equivalence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- Number of (distinguishable) leaves assigned to one gap. -/
noncomputable def slotGapOccupancy
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (g : Fin (k + 1)) : ℕ :=
  (Finset.univ.filter
    (fun v : SlotLeaf k l u f => a.1 v = g)).card

/-- The unnormalized number of internal orders for a fixed assignment. -/
noncomputable def slotGapFactorialWeight
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) : ℚ :=
  factorialGapWeight (slotGapOccupancy k l u f a)

/-- A general finite-type identity: a disjoint extra unit object adds
one element to exactly one fibre of a function. -/
theorem card_filter_sum_one_extra
    {α β : Type*} [Fintype α] [DecidableEq β]
    (a : α → β) (g t : β) :
    (Finset.univ.filter (fun v : α ⊕ PUnit =>
      (Sum.elim a (fun _ => g) v) = t)).card =
      (Finset.univ.filter (fun v : α => a v = t)).card +
        if g = t then 1 else 0 := by
  classical
  let P : α ⊕ PUnit → Prop :=
    fun v => (Sum.elim a (fun _ => g) v) = t
  have hC : (Finset.univ.filter P).card =
      Fintype.card {v : α ⊕ PUnit // P v} := by
    exact (Fintype.card_subtype P).symm
  rw [show (Finset.univ.filter
      (fun v : α ⊕ PUnit => Sum.elim a (fun _ => g) v = t)).card =
        (Finset.univ.filter P).card from rfl, hC]
  calc
    Fintype.card {v : α ⊕ PUnit // P v} =
        Fintype.card ({v : α // a v = t} ⊕
          {v : PUnit // g = t}) := by
            exact Fintype.card_congr (Equiv.subtypeSum (p := P))
    _ = Fintype.card {v : α // a v = t} +
          Fintype.card {v : PUnit // g = t} := Fintype.card_sum
    _ = (Finset.univ.filter (fun v : α => a v = t)).card +
          (if g = t then 1 else 0) := by
        rw [Fintype.card_subtype]
        by_cases h : g = t
        · simp [h]
        · simp [h]

/-- The precise cardinality statement required by the insertion
factorial identity: using the splitting bijection, all old leaves
retain their gaps and precisely one new leaf joins gap `g`. -/
theorem slotGapOccupancy_add_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (g t : Fin (k + 1)) :
    slotGapOccupancy k l u (f + 1)
      ((allowedSlotAssignment_freeLeafEquiv k l u f).symm (a, g)) t =
      slotGapOccupancy k l u f a t + (if g = t then 1 else 0) := by
  classical
  let E := slotLeafFreeSplit k l u f
  let b := (allowedSlotAssignment_freeLeafEquiv k l u f).symm (a, g)
  have hb (v : SlotLeaf k l u (f + 1)) :
      b.1 v = Sum.elim a.1 (fun _ : PUnit.{1} => g) (E v) := by
    dsimp [b, allowedSlotAssignment_freeLeafEquiv]
    cases h : E v with
    | inl w => simp only [Sum.elim_inl]
    | inr z => simp only [Sum.elim_inr]
  unfold slotGapOccupancy
  calc
    (Finset.univ.filter
      (fun v : SlotLeaf k l u (f + 1) => b.1 v = t)).card =
        (Finset.univ.filter (fun w : SlotLeaf k l u f ⊕ PUnit =>
          Sum.elim a.1 (fun _ => g) w = t)).card := by
            apply Finset.card_bijective E E.bijective
            intro v
            simp only [Finset.mem_filter, Finset.mem_univ, true_and]
            simp only [hb v]
    _ = (Finset.univ.filter
          (fun v : SlotLeaf k l u f => a.1 v = t)).card +
          (if g = t then 1 else 0) :=
      card_filter_sum_one_extra a.1 g t

/-- Inserting the last free leaf and choosing its gap changes the
factorial weight by the number of internal positions in this gap. -/
theorem slotGapFactorialWeight_add_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (g : Fin (k + 1)) :
    slotGapFactorialWeight k l u (f + 1)
      ((allowedSlotAssignment_freeLeafEquiv k l u f).symm (a, g)) =
      ((slotGapOccupancy k l u f a g + 1 : ℕ) : ℚ) *
        slotGapFactorialWeight k l u f a := by
  have hocc : slotGapOccupancy k l u (f + 1)
      ((allowedSlotAssignment_freeLeafEquiv k l u f).symm (a, g)) =
      addFreeLeafToGap (slotGapOccupancy k l u f a) g := by
    funext t
    change slotGapOccupancy k l u (f + 1)
        ((allowedSlotAssignment_freeLeafEquiv k l u f).symm (a, g)) t =
      slotGapOccupancy k l u f a t + (if t = g then 1 else 0)
    by_cases h : g = t
    · subst t
      simpa using (slotGapOccupancy_add_free k l u f a g g)
    · have ht : t ≠ g := Ne.symm h
      simpa [h, ht] using (slotGapOccupancy_add_free k l u f a g t)
  unfold slotGapFactorialWeight
  rw [hocc]
  exact factorialGapWeight_addFreeLeaf (slotGapOccupancy k l u f a) g

/-- An admissible slot assignment is a subtype of a function between
finite types; this local finite enumeration is required already when
elaborating the statement of a sum over all assignments. -/
noncomputable instance allowedSlotAssignmentFintype
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    Fintype (AllowedSlotAssignment k l u f) := by
  classical
  exact Fintype.ofFinite _

/-- Reexpress the original slot quotient in terms of the later
factorial-weight definition. The two `Finset.univ` expressions are
propositionally equal even if their synthesized finite enumerations
are not definitionally identical. -/
theorem slotAssignmentRatio_eq_weight_sum
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u f =
      (∑ a : AllowedSlotAssignment k l u f,
        slotGapFactorialWeight k l u f a) /
        (Nat.factorial (k + (∑ i : Fin k, l i) +
          (∑ i : Fin k, u i) + f) : ℚ) := by
  classical
  unfold slotAssignmentRatio
  apply congrArg (fun q : ℚ =>
    q / (Nat.factorial (k + (∑ i : Fin k, l i) +
      (∑ i : Fin k, u i) + f) : ℚ))
  apply Finset.sum_congr (by ext a; simp)
  intro a _
  unfold slotGapFactorialWeight factorialGapWeight slotGapOccupancy
  rfl

/-- Exact sum over *all* slot assignments after adding the last free
leaf.  This reindexing retains the factor depending on the initial occupancy
profile; summation below establishes independence from the assignment. -/
theorem slotGapFactorialWeight_sum_add_free
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    (∑ b : AllowedSlotAssignment k l u (f + 1),
      slotGapFactorialWeight k l u (f + 1) b) =
    ∑ a : AllowedSlotAssignment k l u f,
      (((k + 1 : ℕ) : ℚ) +
        ∑ g : Fin (k + 1),
          (slotGapOccupancy k l u f a g : ℚ)) *
        slotGapFactorialWeight k l u f a := by
  classical
  let e := allowedSlotAssignment_freeLeafEquiv k l u f
  calc
    (∑ b : AllowedSlotAssignment k l u (f + 1),
        slotGapFactorialWeight k l u (f + 1) b) =
      ∑ ag : AllowedSlotAssignment k l u f × Fin (k + 1),
        slotGapFactorialWeight k l u (f + 1) (e.symm ag) := by
          exact Fintype.sum_equiv e _ _
            (fun b => by simp only [e.symm_apply_apply])
    _ = ∑ a : AllowedSlotAssignment k l u f,
          ∑ g : Fin (k + 1),
            slotGapFactorialWeight k l u (f + 1) (e.symm (a, g)) := by
              rw [Fintype.sum_prod_type]
    _ = ∑ a : AllowedSlotAssignment k l u f,
          (((k + 1 : ℕ) : ℚ) +
            ∑ g : Fin (k + 1),
              (slotGapOccupancy k l u f a g : ℚ)) *
                slotGapFactorialWeight k l u f a := by
                  apply Finset.sum_congr rfl
                  intro a _
                  rw [show (∑ g : Fin (k + 1),
                    slotGapFactorialWeight k l u (f + 1) (e.symm (a, g))) =
                    ∑ g : Fin (k + 1),
                      factorialGapWeight
                        (addFreeLeafToGap (slotGapOccupancy k l u f a) g) from by
                          apply Finset.sum_congr rfl
                          intro g _
                          exact (slotGapFactorialWeight_add_free k l u f a g).trans
                            (factorialGapWeight_addFreeLeaf _ g).symm]
                  exact factorialFinGapWeight_sum_addFreeLeaf k
                    (slotGapOccupancy k l u f a)

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Free-leaf cancellation in the ** normalized slot count

The previous theorem supplied the reindexing and the factorial factor.
Now the sum of the gap occupancies is proved to be the total number of
nonroot leaves.  Consequently, the normalized slot sum does not depend
on the number of free leaves: this is an equality of the original two
`slotAssignmentRatio` definitions, not just a symbolic weight identity. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- For any finite function, the sizes of its fibres form a partition
of the whole domain. -/
theorem sum_card_all_fibers
    {α β : Type*} [Fintype α] [Fintype β]
    [DecidableEq β] (a : α → β) :
    (∑ g : β, (Finset.univ.filter (fun v : α => a v = g)).card) =
      Fintype.card α := by
  classical
  calc
    (∑ g : β, (Finset.univ.filter (fun v : α => a v = g)).card) =
        ∑ g : β, ∑ v : α, if a v = g then 1 else 0 := by
          apply Finset.sum_congr rfl
          intro g _
          exact Finset.card_filter (fun v : α => a v = g) Finset.univ
    _ = ∑ v : α, ∑ g : β, if a v = g then 1 else 0 := by
          rw [Finset.sum_comm]
    _ = ∑ v : α, (1 : ℕ) := by
          apply Finset.sum_congr rfl
          intro v _
          simp
    _ = Fintype.card α := by simp

/-- The abstract leaf type has exactly the prescribed number of
lower leaves, upper leaves and unrestricted leaves. -/
theorem card_slotLeaf
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    Fintype.card (SlotLeaf k l u f) =
      (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f := by
  classical
  simp only [SlotLeaf, Fintype.card_sum, Fintype.card_sigma,
    Fintype.card_fin, add_assoc]

/-- Every admissible slot assignment distributes ALL leaves among
exactly `k+1` gaps, with no missing or multiply-counted leaves. -/
theorem sum_slotGapOccupancy
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) :
    (∑ g : Fin (k + 1), slotGapOccupancy k l u f a g) =
      (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f := by
  calc
    _ = Fintype.card (SlotLeaf k l u f) :=
      sum_card_all_fibers a.1
    _ = _ := card_slotLeaf k l u f

/-- The factor from summing all possible insertions of a NEW free leaf
is the number of gaps plus the number of existing leaves, independently
of how the old leaves are distributed among the gaps. -/
theorem slotGapFactorialWeight_sum_add_free_constant
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    (∑ b : AllowedSlotAssignment k l u (f + 1),
      slotGapFactorialWeight k l u (f + 1) b) =
    (((k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f + 1 : ℕ) : ℚ)) *
      (∑ a : AllowedSlotAssignment k l u f,
        slotGapFactorialWeight k l u f a) := by
  classical
  rw [slotGapFactorialWeight_sum_add_free]
  have hfac (a : AllowedSlotAssignment k l u f) :
      (((k + 1 : ℕ) : ℚ) +
        ∑ g : Fin (k + 1),
          (slotGapOccupancy k l u f a g : ℚ)) =
          ((k + (∑ i : Fin k, l i) +
            (∑ i : Fin k, u i) + f + 1 : ℕ) : ℚ) := by
    rw [← Nat.cast_sum, sum_slotGapOccupancy]
    push_cast
    ring
  simp_rw [hfac]
  rw [Finset.mul_sum]

/-- **Complete free-leaf invariance for the original slot ratio.**
The universal two-sided identity therefore needs to be proved only for
`f=0`; no assumption about its truth is used here. -/
theorem slotAssignmentRatio_free_succ
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u (f + 1) =
      slotAssignmentRatio k l u f := by
  classical
  let N : ℕ := k + (∑ i : Fin k, l i) +
    (∑ i : Fin k, u i) + f
  have hN : k + (∑ i : Fin k, l i) +
      (∑ i : Fin k, u i) + (f + 1) = N + 1 := by
    dsimp [N]
    omega
  have hfac : (Nat.factorial (N + 1) : ℚ) =
      ((N + 1 : ℕ) : ℚ) * (Nat.factorial N : ℚ) := by
    rw [Nat.factorial_succ]
    push_cast
    ring
  have hnonzero : ((N + 1 : ℕ) : ℚ) ≠ 0 := by positivity
  have hfact : (Nat.factorial N : ℚ) ≠ 0 := by positivity
  rw [slotAssignmentRatio_eq_weight_sum,
    slotAssignmentRatio_eq_weight_sum]
  rw [hN, slotGapFactorialWeight_sum_add_free_constant]
  change (((N + 1 : ℕ) : ℚ) *
      (∑ a : AllowedSlotAssignment k l u f,
        slotGapFactorialWeight k l u f a)) /
        (Nat.factorial (N + 1) : ℚ) =
    (∑ a : AllowedSlotAssignment k l u f,
      slotGapFactorialWeight k l u f a) /
        (Nat.factorial N : ℚ)
  rw [hfac]
  field_simp [hnonzero, hfact]

/-- Remove ALL unrestricted leaves from the universal slot count. -/
theorem slotAssignmentRatio_free_independent
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u f = slotAssignmentRatio k l u 0 := by
  induction f with
  | zero => rfl
  | succ f ih =>
      exact (slotAssignmentRatio_free_succ k l u f).trans ih

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — slotLeaf zero empty. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- Every leaf at zero roots and zero free leaves would require an
inhabitant of `Fin 0`, which is impossible. -/
theorem slotLeaf_zero_empty (l u : Fin 0 → ℕ) :
    IsEmpty (SlotLeaf 0 l u 0) := by
  constructor
  intro v
  cases v with
  | inl v => exact Fin.elim0 v.1
  | inr v =>
      cases v with
      | inl w => exact Fin.elim0 w.1
      | inr w => exact Fin.elim0 w

/-- The universal identity is independent of the number of free leaves:
it suffices to prove the case `f = 0`, without additional hypotheses. -/
theorem universal_slot_identity_iff_free_zero
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    UniversalSlotIdentity k l u f ↔
      UniversalSlotIdentity k l u 0 := by
  unfold UniversalSlotIdentity
  rw [slotAssignmentRatio_free_independent k l u f]

/-- Zero roots and zero free leaves give one admissible assignment with
weight one, including the empty-boundary case. -/
theorem slotAssignmentRatio_zero_zero
    (l u : Fin 0 → ℕ) :
    slotAssignmentRatio 0 l u 0 = 1 := by
  classical
  let _ : IsEmpty (SlotLeaf 0 l u 0) := slotLeaf_zero_empty l u
  let a0 : AllowedSlotAssignment 0 l u 0 :=
    ⟨(fun v => isEmptyElim v), (fun v => isEmptyElim v)⟩
  have huniq (a : AllowedSlotAssignment 0 l u 0) : a = a0 := by
    apply Subtype.ext
    funext v
    exact isEmptyElim v
  have hu : (Finset.univ : Finset (AllowedSlotAssignment 0 l u 0)) = {a0} := by
    ext a
    simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
    exact huniq a
  have hzero (g : Fin 1) :
      slotGapOccupancy 0 l u 0 a0 g = 0 := by
    unfold slotGapOccupancy
    have hf : (Finset.univ.filter
        (fun v : SlotLeaf 0 l u 0 => a0.1 v = g)) = ∅ := by
      ext v
      exact isEmptyElim v
    rw [hf]
    rfl
  have hw : slotGapFactorialWeight 0 l u 0 a0 = 1 := by
    unfold slotGapFactorialWeight factorialGapWeight
    simp only [hzero, Nat.factorial_zero, Nat.cast_one, Finset.prod_const_one]
  have hsum :
      (∑ a : AllowedSlotAssignment 0 l u 0,
        slotGapFactorialWeight 0 l u 0 a) = 1 := by
    rw [hu]
    simpa only [Finset.sum_singleton] using hw
  have hl : (∑ i : Fin 0, l i) = 0 := by simp
  have hr : (∑ i : Fin 0, u i) = 0 := by simp
  rw [slotAssignmentRatio_eq_weight_sum]
  rw [hsum, hl, hr]
  norm_num

/-- At zero roots, the rational iterated integral is the empty fold. -/
theorem slotKernelIntegral_zero (l u : Fin 0 → ℕ) :
    slotKernelIntegral 0 l u = 1 := by
  unfold slotKernelIntegral
  simp

/-- Euler induction base case: the true universal slot/integral
identity is established for zero roots and *any* free-leaf count. -/
theorem universal_slot_identity_zero
    (l u : Fin 0 → ℕ) (f : ℕ) :
    UniversalSlotIdentity 0 l u f := by
  unfold UniversalSlotIdentity
  rw [slotAssignmentRatio_free_independent,
    slotAssignmentRatio_zero_zero, slotKernelIntegral_zero]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: finite counting with one distinguished root. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- An admissible assignment with one root and no free leaves: each
lower leaf belongs to the lower gap, and each upper leaf to the upper
gap. -/
noncomputable def oneRootCanonicalSlotAssignment
    (l u : Fin 1 → ℕ) : AllowedSlotAssignment 1 l u 0 := by
  classical
  refine ⟨(fun v =>
    match v with
    | .inl _ => 0
    | .inr (.inl _) => 1
    | .inr (.inr z) => Fin.elim0 z), ?_⟩
  intro v
  cases v with
  | inl v =>
      rcases v with ⟨i, j⟩
      change (0 : ℕ) < 1 - i.val
      have hi := i.isLt
      omega
  | inr v =>
      cases v with
      | inl v =>
          rcases v with ⟨i, j⟩
          change 1 - i.val ≤ (1 : ℕ)
          have hi := i.isLt
          omega
      | inr z => exact Fin.elim0 z

/-- There is exactly one gap assignment in the one-root case, once
free leaves have been eliminated by the established insertion bijection. -/
theorem oneRootCanonicalSlotAssignment_unique
    (l u : Fin 1 → ℕ) (a : AllowedSlotAssignment 1 l u 0) :
    a = oneRootCanonicalSlotAssignment l u := by
  apply Subtype.ext
  funext v
  cases v with
  | inl v =>
      rcases v with ⟨i, j⟩
      have h := a.2 (Sum.inl ⟨i, j⟩)
      change (a.1 (Sum.inl ⟨i, j⟩)).val < 1 - i.val at h
      apply Fin.ext
      change (a.1 (Sum.inl ⟨i, j⟩)).val = 0
      have hi := i.isLt
      omega
  | inr v =>
      cases v with
      | inl v =>
          rcases v with ⟨i, j⟩
          have h := a.2 (Sum.inr (Sum.inl ⟨i, j⟩))
          change 1 - i.val ≤ (a.1 (Sum.inr (Sum.inl ⟨i, j⟩))).val at h
          apply Fin.ext
          change (a.1 (Sum.inr (Sum.inl ⟨i, j⟩))).val = 1
          have hg := (a.1 (Sum.inr (Sum.inl ⟨i, j⟩))).isLt
          have hi := i.isLt
          omega
      | inr z => exact Fin.elim0 z

/-- Identify the entire bottom gap of a one-root assignment with its
lower leaves, not merely with a set having the same numerical size. -/
noncomputable def oneRootLowerFiberEquiv (l u : Fin 1 → ℕ) :
    (Σ i : Fin 1, Fin (l i)) ≃
      {v : SlotLeaf 1 l u 0 //
        (oneRootCanonicalSlotAssignment l u).1 v = (0 : Fin 2)} := by
  classical
  refine {
    toFun := fun p => ⟨Sum.inl p, rfl⟩
    invFun := fun q => by
      rcases q with ⟨v, hv⟩
      cases v with
      | inl p => exact p
      | inr v =>
          cases v with
          | inl p =>
              have heq : (1 : Fin 2) = 0 := hv
              exact False.elim ((by decide : (1 : Fin 2) ≠ 0) heq)
          | inr z => exact Fin.elim0 z
    left_inv := ?_
    right_inv := ?_ }
  · intro p
    rfl
  · rintro ⟨v, hv⟩
    cases v with
    | inl p => apply Subtype.ext; rfl
    | inr v =>
        cases v with
        | inl p =>
            have heq : (1 : Fin 2) = 0 := hv
            exact False.elim ((by decide : (1 : Fin 2) ≠ 0) heq)
        | inr z => exact Fin.elim0 z

/-- Dually, the top gap consists exactly of the upper leaves. -/
noncomputable def oneRootUpperFiberEquiv (l u : Fin 1 → ℕ) :
    (Σ i : Fin 1, Fin (u i)) ≃
      {v : SlotLeaf 1 l u 0 //
        (oneRootCanonicalSlotAssignment l u).1 v = (1 : Fin 2)} := by
  classical
  refine {
    toFun := fun p => ⟨Sum.inr (Sum.inl p), rfl⟩
    invFun := fun q => by
      rcases q with ⟨v, hv⟩
      cases v with
      | inl p =>
          have heq : (0 : Fin 2) = 1 := hv
          exact False.elim ((by decide : (0 : Fin 2) ≠ 1) heq)
      | inr v =>
          cases v with
          | inl p => exact p
          | inr z => exact Fin.elim0 z
    left_inv := ?_
    right_inv := ?_ }
  · intro p
    rfl
  · rintro ⟨v, hv⟩
    cases v with
    | inl p =>
        have heq : (0 : Fin 2) = 1 := hv
        exact False.elim ((by decide : (0 : Fin 2) ≠ 1) heq)
    | inr v =>
        cases v with
        | inl p => apply Subtype.ext; rfl
        | inr z => exact Fin.elim0 z

/-- The precise bottom-gap count, with no symmetry assumption about the
boundary multiplicities. -/
theorem oneRootCanonicalSlotAssignment_bottom_card
    (l u : Fin 1 → ℕ) :
    slotGapOccupancy 1 l u 0 (oneRootCanonicalSlotAssignment l u) 0 =
      l 0 := by
  classical
  unfold slotGapOccupancy
  rw [← Fintype.card_subtype
    (fun v : SlotLeaf 1 l u 0 =>
      (oneRootCanonicalSlotAssignment l u).1 v = (0 : Fin 2))]
  have hc := Fintype.card_congr (oneRootLowerFiberEquiv l u)
  rw [← hc]
  simp

/-- The corresponding top-gap count. -/
theorem oneRootCanonicalSlotAssignment_top_card
    (l u : Fin 1 → ℕ) :
    slotGapOccupancy 1 l u 0 (oneRootCanonicalSlotAssignment l u) 1 =
      u 0 := by
  classical
  unfold slotGapOccupancy
  rw [← Fintype.card_subtype
    (fun v : SlotLeaf 1 l u 0 =>
      (oneRootCanonicalSlotAssignment l u).1 v = (1 : Fin 2))]
  have hc := Fintype.card_congr (oneRootUpperFiberEquiv l u)
  rw [← hc]
  simp

/-- The complete one-root numerator is exactly the product of the two
independent factorials. In particular, no Dirichlet formula is used. -/
theorem oneRootSlotWeight_exact (l u : Fin 1 → ℕ) :
    (∑ a : AllowedSlotAssignment 1 l u 0,
        slotGapFactorialWeight 1 l u 0 a) =
      (Nat.factorial (l 0) : ℚ) * (Nat.factorial (u 0) : ℚ) := by
  classical
  have hsingle :
      (Finset.univ : Finset (AllowedSlotAssignment 1 l u 0)) =
        {oneRootCanonicalSlotAssignment l u} := by
    ext a
    simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
    exact oneRootCanonicalSlotAssignment_unique l u a
  rw [hsingle, Finset.sum_singleton]
  unfold slotGapFactorialWeight factorialGapWeight
  have hfin : (Finset.univ : Finset (Fin 2)) = {0, 1} := by
    ext i
    fin_cases i <;> simp
  rw [hfin]
  simp [oneRootCanonicalSlotAssignment_bottom_card,
    oneRootCanonicalSlotAssignment_top_card]

/-- One root, arbitrary numbers of lower, upper AND free leaves: the
universal counting identity is exactly the proved rational beta
integral. -/
theorem universal_slot_identity_one
    (l u : Fin 1 → ℕ) (f : ℕ) :
    UniversalSlotIdentity 1 l u f := by
  classical
  unfold UniversalSlotIdentity
  rw [slotAssignmentRatio_free_independent,
    slotAssignmentRatio_eq_weight_sum,
    oneRootSlotWeight_exact]
  have hl : (∑ i : Fin 1, l i) = l 0 := by simp
  have hu : (∑ i : Fin 1, u i) = u 0 := by simp
  rw [hl, hu]
  have hmass : 1 + l 0 + u 0 + 0 = l 0 + u 0 + 1 := by omega
  rw [hmass]
  have hker : slotKernelIntegral 1 l u =
      rationalBetaMoment (l 0) (u 0) := by
    rw [slotKernelIntegral_eq_eulerRootPrimitive]
    have hfr : List.finRange 1 = [(0 : Fin 1)] := by decide
    rw [hfr]
    simp [eulerRootPrimitive, eulerRootKernel, rationalBetaMoment,
      integrateUnit]
  rw [hker, rationalBetaMoment_factorial]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Top-gap classification: the exact support of the maximum-label deletion. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- A lower-boundary leaf can never be assigned to the gap *above all*
roots, irrespective of the values of the other boundary multiplicities. -/
theorem slotAllowed_lower_not_top
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (i : Fin k) (j : Fin (l i)) :
    ¬ SlotAllowed k l u f (Sum.inl ⟨i, j⟩) (Fin.last k) := by
  intro h
  change k < k - i.val at h
  omega

/-- With no unrestricted leaves, the top gap consists *only* of upper
boundary leaves. This is the classification used to delete the maximum
label in the combinatorial recurrence, not an assumed counting formula. -/
theorem slotAllowed_top_iff_upper
    (k : ℕ) (l u : Fin k → ℕ)
    (v : SlotLeaf k l u 0) :
    SlotAllowed k l u 0 v (Fin.last k) ↔
      ∃ i : Fin k, ∃ j : Fin (u i),
        v = Sum.inr (Sum.inl ⟨i, j⟩) := by
  cases v with
  | inl v =>
      rcases v with ⟨i, j⟩
      constructor
      · intro h
        exact False.elim (slotAllowed_lower_not_top k l u 0 i j h)
      · rintro ⟨i', j', heq⟩
        cases heq
  | inr v =>
      cases v with
      | inl v =>
          rcases v with ⟨i, j⟩
          constructor
          · intro _
            exact ⟨i, j, rfl⟩
          · intro _
            change k - i.val ≤ k
            omega
      | inr z => exact Fin.elim0 z

/-- If there are no upper boundary leaves and no free leaves, the last
gap is necessarily empty. This is the root-deletion branch of the
finite Euler recurrence. -/
theorem slotTopGap_empty_when_no_upper
    (k : ℕ) (l : Fin k → ℕ)
    (a : AllowedSlotAssignment k l (fun _ => 0) 0) :
    slotGapOccupancy k l (fun _ => 0) 0 a (Fin.last k) = 0 := by
  classical
  unfold slotGapOccupancy
  have he : (Finset.univ.filter
        (fun v : SlotLeaf k l (fun _ => 0) 0 =>
          a.1 v = Fin.last k)) = ∅ := by
    ext v
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · intro hv
      have ha := a.2 v
      rw [hv] at ha
      obtain ⟨i, j, _⟩ :=
        (slotAllowed_top_iff_upper k l (fun _ => 0) v).mp ha
      exact Fin.elim0 j
    · intro hv
      simp at hv
  rw [he]
  rfl

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Turning the established Euler relation into explicit finite deletions. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- A one-step upper-leaf deletion, with its multiplicity and the
resulting root word. The last component preserves the ORIGINAL order
of all roots. A block having no upper leaves contributes no deletion. -/
def upperDeleteCases :
    List (ℕ × ℕ) → List (ℕ × List (ℕ × ℕ))
  | [] => []
  | (a, b) :: ps =>
      (if b = 0 then [] else [(b, (a, b - 1) :: ps)]) ++
        (upperDeleteCases ps).map
          (fun x => (x.1, (a, b) :: x.2))

/-- Every upper-leaf deletion reduces the total number of constrained
objects by exactly one. Thus it is a valid recursive argument. -/
theorem upperDeleteCases_mass_lt
    (ps : List (ℕ × ℕ))
    (x : ℕ × List (ℕ × ℕ))
    (hx : x ∈ upperDeleteCases ps) :
    eulerRootMass x.2 < eulerRootMass ps := by
  induction ps generalizing x with
  | nil =>
      simp [upperDeleteCases] at hx
  | cons ab ps ih =>
      rcases ab with ⟨a, b⟩
      simp only [upperDeleteCases, List.mem_append] at hx
      rcases hx with hhead | htail
      · by_cases hb : b = 0
        · simp [hb] at hhead
        · have hcase : x = (b, (a, b - 1) :: ps) := by
            simpa [hb] using hhead
          subst x
          simp only [eulerRootMass]
          omega
      · obtain ⟨y, hy, heq⟩ := List.mem_map.mp htail
        subst x
        have hsmall := ih y hy
        simp only [eulerRootMass]
        omega

/-- Linearity of the rational polynomial primitive in scalar coefficients. -/
theorem primitiveFromZero_C_mul (c : ℚ) (p : Polynomial ℚ) :
    primitiveFromZero (Polynomial.C c * p) =
      Polynomial.C c * primitiveFromZero p := by
  apply polynomial_eq_of_derivative_and_eval_zero
  · simp [Polynomial.derivative_mul, derivative_primitiveFromZero]
  · simp [primitiveFromZero_eval_zero]

/-- Push any fixed polynomial kernel through the sum of a finite list
of weighted polynomial inputs, using only rational linearity. -/
theorem primitiveFromZero_kernel_weighted_list
    (K : Polynomial ℚ) (ps : List (ℕ × Polynomial ℚ)) :
    primitiveFromZero
        (K * (ps.map (fun x => Polynomial.C (x.1 : ℚ) * x.2)).sum) =
      (ps.map (fun x => Polynomial.C (x.1 : ℚ) *
        primitiveFromZero (K * x.2))).sum := by
  induction ps with
  | nil =>
      simp [primitiveFromZero_zero]
  | cons x xs ih =>
      rcases x with ⟨w, p⟩
      simp only [List.map_cons, List.sum_cons, mul_add]
      rw [primitiveFromZero_add]
      have hcomm : K * (Polynomial.C (w : ℚ) * p) =
          Polynomial.C (w : ℚ) * (K * p) := by ring
      rw [hcomm, primitiveFromZero_C_mul, ih]

/-- The original polynomial sum over all upper-leaf deletions really
is the *explicit finite sum* over the lists `upperDeleteCases`.
No extra recurrence or integral assumption is used. -/
theorem eulerUpperDeletion_eq_upperDeleteCases
    (ps : List (ℕ × ℕ)) :
    eulerUpperDeletion ps =
      ((upperDeleteCases ps).map (fun x =>
        Polynomial.C (x.1 : ℚ) * eulerRootPrimitive x.2)).sum := by
  induction ps with
  | nil =>
      simp [eulerUpperDeletion, upperDeleteCases]
  | cons ab ps ih =>
      rcases ab with ⟨a, b⟩
      have hcore :
          primitiveFromZero (eulerRootKernel a b * eulerUpperDeletion ps) =
            ((upperDeleteCases ps).map (fun x =>
              Polynomial.C (x.1 : ℚ) *
                eulerRootPrimitive ((a, b) :: x.2))).sum := by
        rw [ih]
        have h := primitiveFromZero_kernel_weighted_list
          (eulerRootKernel a b)
          ((upperDeleteCases ps).map (fun x =>
            (x.1, eulerRootPrimitive x.2)))
        simpa only [List.map_map, Function.comp_def, eulerRootPrimitive]
          using h
      change (↑b : Polynomial ℚ) *
          eulerRootPrimitive ((a, b - 1) :: ps) +
          primitiveFromZero (eulerRootKernel a b * eulerUpperDeletion ps) =
        (((if b = 0 then [] else [(b, (a, b - 1) :: ps)]) ++
          (upperDeleteCases ps).map (fun x =>
            (x.1, (a, b) :: x.2))).map (fun x =>
              Polynomial.C (x.1 : ℚ) * eulerRootPrimitive x.2)).sum
      rw [hcore, List.map_append, List.sum_append]
      by_cases hb : b = 0
      · subst b
        simp [Function.comp_def]
      · simp [hb, List.map_map, Function.comp_def]

/-- Evaluation at one commutes with summing an arbitrary finite list
of rational polynomials. -/
theorem eval_one_list_sum (ps : List (Polynomial ℚ)) :
    (ps.sum).eval 1 = (ps.map (fun p => p.eval 1)).sum := by
  induction ps with
  | nil => simp
  | cons p ps ih =>
      simpa only [List.sum_cons, List.map_cons, Polynomial.eval_add]
        using congrArg (fun x : ℚ => p.eval 1 + x) ih

/-- Analytic Euler recurrence in an explicit, purely FINITE form.
Its summands are exactly the states with one deleted upper leaf. -/
theorem eulerRootPrimitive_eval_one_deletion_list
    (a b : ℕ) (ps : List (ℕ × ℕ)) :
    (eulerRootMass ((a, b) :: ps) : ℚ) *
      (eulerRootPrimitive ((a, b) :: ps)).eval 1 =
      ((upperDeleteCases ((a, b) :: ps)).map
        (fun x => (x.1 : ℚ) * (eulerRootPrimitive x.2).eval 1)).sum +
        (if b = 0 then (eulerRootPrimitive ps).eval 1 else 0) := by
  rw [eulerRootPrimitive_eval_one_recurrence,
    eulerUpperDeletion_eq_upperDeleteCases]
  rw [eval_one_list_sum]
  simp only [List.map_map, Function.comp_def,
    Polynomial.eval_mul, Polynomial.eval_C]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Formal uniqueness of the Euler deletion recurrence

Any rational statistic of words with the same empty-word value and the
same deletion-of-the-maximum recurrence necessarily equals the ordered
root integral. This eliminates a separate, potentially large, induction
step once the finite slot-counting recurrence is established. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

/-- The recursively integrated rational kernel is uniquely determined
by the finite upper-leaf deletion recurrence and the empty word.
The hypothesis is a STRICTLY SMALLER counting recurrence, not the target
identity between slot assignments and polynomial integrals. -/
theorem eulerRootIntegral_unique_from_deletion
    (F : List (ℕ × ℕ) → ℚ)
    (hempty : F [] = 1)
    (hrec : ∀ (a b : ℕ) (ps : List (ℕ × ℕ)),
      (eulerRootMass ((a, b) :: ps) : ℚ) * F ((a, b) :: ps) =
        ((upperDeleteCases ((a, b) :: ps)).map
          (fun x => (x.1 : ℚ) * F x.2)).sum +
          (if b = 0 then F ps else 0)) :
    ∀ ps : List (ℕ × ℕ),
      F ps = (eulerRootPrimitive ps).eval 1 := by
  have main : ∀ m : ℕ, ∀ ps : List (ℕ × ℕ),
      eulerRootMass ps = m →
        F ps = (eulerRootPrimitive ps).eval 1 := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
        intro ps hm
        cases ps with
        | nil =>
            simp [eulerRootPrimitive, hempty]
        | cons ab ps =>
            rcases ab with ⟨a, b⟩
            let word : List (ℕ × ℕ) := (a, b) :: ps
            have hsmall (x : ℕ × List (ℕ × ℕ))
                (hx : x ∈ upperDeleteCases word) :
                F x.2 = (eulerRootPrimitive x.2).eval 1 := by
              apply ih (eulerRootMass x.2)
              · calc
                  eulerRootMass x.2 < eulerRootMass word :=
                    upperDeleteCases_mass_lt word x hx
                  _ = m := by simpa only [word] using hm
              · rfl
            have hsum :
                ((upperDeleteCases word).map
                  (fun x => (x.1 : ℚ) * F x.2)).sum =
                ((upperDeleteCases word).map
                  (fun x => (x.1 : ℚ) *
                    (eulerRootPrimitive x.2).eval 1)).sum := by
              apply congrArg List.sum
              apply List.map_congr_left
              intro x hx
              rw [hsmall x hx]
            have htail :
                (if b = 0 then F ps else 0) =
                  (if b = 0 then (eulerRootPrimitive ps).eval 1
                   else 0) := by
              by_cases hb : b = 0
              · have hlt : eulerRootMass ps < m := by
                  simp only [eulerRootMass] at hm
                  omega
                simpa [hb] using
                  (ih (eulerRootMass ps) hlt ps rfl)
              · simp [hb]
            have hF := hrec a b ps
            have hJ := eulerRootPrimitive_eval_one_deletion_list a b ps
            change (eulerRootMass word : ℚ) * F word =
              ((upperDeleteCases word).map
                (fun x => (x.1 : ℚ) * F x.2)).sum +
              (if b = 0 then F ps else 0) at hF
            change (eulerRootMass word : ℚ) *
                (eulerRootPrimitive word).eval 1 =
              ((upperDeleteCases word).map
                (fun x => (x.1 : ℚ) *
                  (eulerRootPrimitive x.2).eval 1)).sum +
              (if b = 0 then (eulerRootPrimitive ps).eval 1 else 0) at hJ
            rw [hsum, htail] at hF
            have heq : (eulerRootMass word : ℚ) * F word =
                (eulerRootMass word : ℚ) *
                  (eulerRootPrimitive word).eval 1 := hF.trans hJ.symm
            have hne : (eulerRootMass word : ℚ) ≠ 0 := by
              simp only [word, eulerRootMass]
              positivity
            exact (mul_left_cancel₀ hne heq)
  intro ps
  exact main (eulerRootMass ps) ps rfl

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: the MAXIMUM-LABEL counting recurrence (finite side)

The earlier Euler identity already computes the analytic side.  This
section proves the exact weighted decomposition at the last gap.  It
is a purely finite statement about the *existing* `slotAssignmentRatio`
numerator, not a new or unrelated numerical model.

No theorem below assumes either `UniversalSlotIdentity` or
`FixedChainSlotIdentity`. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Removing one object from a nonempty gap in a factorial profile.
This is the converse of the established insertion formula. -/
theorem factorialGapWeight_remove_one
    {G : Type*} [Fintype G] [DecidableEq G]
    (n : G → ℕ) (g : G) (hg : 0 < n g) :
    factorialGapWeight n =
      (n g : ℚ) *
        factorialGapWeight (fun t => if t = g then n t - 1 else n t) := by
  classical
  let m : G → ℕ := fun t => if t = g then n t - 1 else n t
  have hrecover : addFreeLeafToGap m g = n := by
    funext t
    by_cases ht : t = g
    · subst t
      have hs : n g - 1 + 1 = n g :=
        Nat.sub_add_cancel (Nat.succ_le_iff.mpr hg)
      simpa [addFreeLeafToGap, m] using hs
    · simp [addFreeLeafToGap, m, ht]
  have hm : m g + 1 = n g := by
    dsimp [m]
    simp only [ite_true]
    omega
  have h := factorialGapWeight_addFreeLeaf m g
  rw [hrecover, hm] at h
  exact h

/-- The fibers in the last gap are precisely the possible choices for the
largest label. Their number is the last-gap occupancy. -/
noncomputable def maximumGapLeaves
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) : Finset (SlotLeaf k l u f) :=
  Finset.univ.filter (fun v => a.1 v = Fin.last k)

/-- The factorial weight after deleting a specified maximum-gap leaf.
Every choice of leaf in the same gap has the same reduced factorial weight. -/
noncomputable def maximumGapReducedWeight
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) : ℚ :=
  factorialGapWeight (fun g =>
    if g = Fin.last k then slotGapOccupancy k l u f a g - 1
    else slotGapOccupancy k l u f a g)

/-- For a fixed admissible gap assignment, the factorial weight is
partitioned according to the identity of its largest object: either
the top gap is empty, or one of its distinguishable leaves is maximal.
In the second case its removal divides `m!` into `m` copies of `(m-1)!`.
This is the finite double-counting formula underlying Euler deletion. -/
theorem slotGapFactorialWeight_maximum_split
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) :
    slotGapFactorialWeight k l u f a =
      (if slotGapOccupancy k l u f a (Fin.last k) = 0 then
        slotGapFactorialWeight k l u f a else 0) +
      ∑ _v ∈ maximumGapLeaves k l u f a,
        maximumGapReducedWeight k l u f a := by
  classical
  let n : Fin (k + 1) → ℕ := slotGapOccupancy k l u f a
  let s : Finset (SlotLeaf k l u f) := maximumGapLeaves k l u f a
  have hs : s.card = n (Fin.last k) := by
    rfl
  have hsum :
      (∑ v ∈ s, maximumGapReducedWeight k l u f a) =
        (n (Fin.last k) : ℚ) *
          maximumGapReducedWeight k l u f a := by
    simp only [Finset.sum_const]
    rw [nsmul_eq_mul, hs]
  by_cases hz : n (Fin.last k) = 0
  · have he : s = ∅ := Finset.card_eq_zero.mp (hs.trans hz)
    change factorialGapWeight n =
      (if n (Fin.last k) = 0 then factorialGapWeight n else 0) +
        ∑ v ∈ s, maximumGapReducedWeight k l u f a
    simp [hz, he]
  · have hpositive : 0 < n (Fin.last k) := Nat.pos_of_ne_zero hz
    have hweight : slotGapFactorialWeight k l u f a =
        (n (Fin.last k) : ℚ) * maximumGapReducedWeight k l u f a := by
      simpa only [slotGapFactorialWeight, maximumGapReducedWeight, n]
        using factorialGapWeight_remove_one n (Fin.last k) hpositive
    rw [hweight]
    change (n (Fin.last k) : ℚ) * maximumGapReducedWeight k l u f a =
      (if n (Fin.last k) = 0 then
        (n (Fin.last k) : ℚ) * maximumGapReducedWeight k l u f a else 0) +
      ∑ v ∈ s, maximumGapReducedWeight k l u f a
    simp [hz, hsum]

/-- Sum the maximum-label partition over EVERY admissible assignment.
This is the exact numerator of `slotAssignmentRatio`: no conditional
recurrence and no unproved identity is introduced. -/
theorem slotGapFactorialWeight_sum_maximum_split
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    (∑ a : AllowedSlotAssignment k l u f,
      slotGapFactorialWeight k l u f a) =
      (∑ a : AllowedSlotAssignment k l u f,
        if slotGapOccupancy k l u f a (Fin.last k) = 0 then
          slotGapFactorialWeight k l u f a else 0) +
      (∑ a : AllowedSlotAssignment k l u f,
        ∑ _v ∈ maximumGapLeaves k l u f a,
          maximumGapReducedWeight k l u f a) := by
  classical
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro a _
  exact slotGapFactorialWeight_maximum_split k l u f a

end OrderedRootIntegral
end OrderIdealSpecializations

/-!
The next two facts make the preceding partition a usable deletion
recurrence: a maximal leaf is necessarily an UPPER leaf, and when the
largest root has an upper leaf, the maximum cannot be that root.
-/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- In the absence of free leaves, every construction maximum-gap object
is an upper-boundary leaf of one of the blocks. -/
theorem maximumGapLeaves_upper_only
    (k : ℕ) (l u : Fin k → ℕ)
    (a : AllowedSlotAssignment k l u 0)
    (v : SlotLeaf k l u 0)
    (hv : v ∈ maximumGapLeaves k l u 0 a) :
    ∃ i : Fin k, ∃ j : Fin (u i),
      v = Sum.inr (Sum.inl ⟨i, j⟩) := by
  have htop : a.1 v = Fin.last k :=
    (Finset.mem_filter.mp hv).2
  have ha : SlotAllowed k l u 0 v (Fin.last k) := by
    rw [← htop]
    exact a.2 v
  exact (slotAllowed_top_iff_upper k l u v).mp ha

/-- Each upper leaf of the first (largest) root MUST occupy the final
gap. If one such leaf exists, the root itself cannot be maximal. -/
theorem maximumGap_nonempty_of_first_upper
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (hu : 0 < u 0)
    (a : AllowedSlotAssignment (k + 1) l u 0) :
    0 < slotGapOccupancy (k + 1) l u 0 a (Fin.last (k + 1)) := by
  classical
  let j : Fin (u 0) := ⟨0, hu⟩
  let v : SlotLeaf (k + 1) l u 0 := Sum.inr (Sum.inl ⟨0, j⟩)
  have hav := a.2 v
  have htop : a.1 v = Fin.last (k + 1) := by
    apply Fin.ext
    have hb : (a.1 v).val < k + 2 := (a.1 v).isLt
    change k + 1 ≤ (a.1 v).val at hav
    change (a.1 v).val = k + 1
    omega
  have hv : v ∈ maximumGapLeaves (k + 1) l u 0 a := by
    simp [maximumGapLeaves, htop]
  have hp : 0 < (maximumGapLeaves (k + 1) l u 0 a).card :=
    Finset.card_pos.mpr ⟨v, hv⟩
  exact hp

end OrderedRootIntegral
end OrderIdealSpecializations

/-!
Reindex the weighted maximum-leaf term.  The innermost sum now fixes
an actual leaf and ranges over exactly those assignments which put it
last. This is the form needed for deletion of one upper leaf.
-/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Exchange the sums over assignments and their construction maximal
leaves. This is the actual finite double-counting step, before
relabeling the remaining upper leaves. -/
theorem maximumGap_double_count
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    (∑ a : AllowedSlotAssignment k l u f,
      ∑ _v ∈ maximumGapLeaves k l u f a,
        maximumGapReducedWeight k l u f a) =
      ∑ v : SlotLeaf k l u f,
        ∑ a : AllowedSlotAssignment k l u f,
          if a.1 v = Fin.last k then
            maximumGapReducedWeight k l u f a else 0 := by
  classical
  calc
    (∑ a : AllowedSlotAssignment k l u f,
        ∑ v ∈ maximumGapLeaves k l u f a,
          maximumGapReducedWeight k l u f a) =
      ∑ a : AllowedSlotAssignment k l u f,
        ∑ v : SlotLeaf k l u f,
          if a.1 v = Fin.last k then
            maximumGapReducedWeight k l u f a else 0 := by
              apply Finset.sum_congr rfl
              intro a _
              unfold maximumGapLeaves
              rw [Finset.sum_filter]
    _ = _ := by rw [Finset.sum_comm]

/-- A lower leaf can never be the maximum; its entire contribution to
the double counting is zero, *not* an extra deletion case. -/
theorem maximumGap_lower_leaf_contribution_zero
    (k : ℕ) (l u : Fin k → ℕ)
    (i : Fin k) (j : Fin (l i)) :
    (∑ a : AllowedSlotAssignment k l u 0,
      if a.1 (Sum.inl ⟨i, j⟩) = Fin.last k then
        maximumGapReducedWeight k l u 0 a else 0) = 0 := by
  classical
  apply Finset.sum_eq_zero
  intro a _
  have hnot : a.1 (Sum.inl ⟨i, j⟩) ≠ Fin.last k := by
    intro heq
    have ha := a.2 (Sum.inl ⟨i, j⟩)
    rw [heq] at ha
    exact slotAllowed_lower_not_top k l u 0 i j ha
  simp [hnot]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — When the first root has an upper leaf, its removal is prohibited. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- If an assignment has an empty uppermost gap, the first root has
no upper-boundary leaves. -/
theorem first_upper_zero_of_maximumGap_empty
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (a : AllowedSlotAssignment (k + 1) l u 0)
    (h : slotGapOccupancy (k + 1) l u 0 a (Fin.last (k + 1)) = 0) :
    u 0 = 0 := by
  by_contra hn
  have hp : 0 < u 0 := Nat.pos_of_ne_zero hn
  have htop := maximumGap_nonempty_of_first_upper k l u hp a
  omega

/-- The complete numerator with a first upper leaf consists ONLY of
maximal-upper-leaf contributions, as required by the Euler recurrence.
This removes the forbidden root-deletion term without assumptions on
the other root parameters. -/
theorem slotGapFactorialWeight_sum_only_leaf_deletion
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (hu : 0 < u 0) :
    (∑ a : AllowedSlotAssignment (k + 1) l u 0,
       slotGapFactorialWeight (k + 1) l u 0 a) =
      ∑ v : SlotLeaf (k + 1) l u 0,
        ∑ a : AllowedSlotAssignment (k + 1) l u 0,
          if a.1 v = Fin.last (k + 1) then
            maximumGapReducedWeight (k + 1) l u 0 a else 0 := by
  classical
  rw [slotGapFactorialWeight_sum_maximum_split]
  have hzero :
      (∑ a : AllowedSlotAssignment (k + 1) l u 0,
        if slotGapOccupancy (k + 1) l u 0 a (Fin.last (k + 1)) = 0 then
          slotGapFactorialWeight (k + 1) l u 0 a else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro a _
    have hp := maximumGap_nonempty_of_first_upper k l u hu a
    simp [Nat.ne_of_gt hp]
  rw [hzero, zero_add, maximumGap_double_count]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — chainAnchorAsCell. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Concrete anchor cell in each step of the fixed connected chain. -/
noncomputable def chainAnchorAsCell
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) : ShapeCell D :=
  ⟨chainBlockAnchor C i,
    intervalCells_subset_diagram D
      (C.ideals i.castSucc) (C.ideals i.succ)
      (chainBlockAnchor_corner C i).1.1⟩

/-- The anchor is in exactly the prescribed block, under chainBlockIndex. -/
theorem chainBlockIndex_anchor
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) :
    chainBlockIndex C (chainAnchorAsCell C i) = i := by
  apply chainBlockIndex_eq_of_mem C (chainAnchorAsCell C i) i
  exact (chainBlockAnchor_corner C i).1.1

/-- Anchor cells in different blocks are distinct. -/
theorem chainAnchorAsCell_injective
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Function.Injective (chainAnchorAsCell C) := by
  intro i j heq
  have h := congrArg (chainBlockIndex C) heq
  rw [chainBlockIndex_anchor C i, chainBlockIndex_anchor C j] at h
  exact h

/-- The actual root cells, with their concrete values, not formal tags. -/
noncomputable def chainAnchorCells
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (ShapeCell D) :=
  Finset.univ.image (chainAnchorAsCell C)

/-- Exactly one distinct anchor for every one of the k chain steps. -/
theorem chainAnchorCells_card
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    (chainAnchorCells C).card = k := by
  classical
  calc
    (chainAnchorCells C).card =
        (Finset.univ : Finset (Fin k)).card := by
          exact Finset.card_image_of_injective _
            (chainAnchorAsCell_injective C)
    _ = k := by simp

/-- Concrete root-cell criterion, with no existential root index. -/
theorem mem_chainAnchorCells_iff
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) :
    c ∈ chainAnchorCells C ↔
      c.1 = chainBlockAnchor C (chainBlockIndex C c) := by
  classical
  constructor
  · intro h
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp h
    rw [← hi]
    rw [chainBlockIndex_anchor C i]
    rfl
  · intro h
    apply Finset.mem_image.mpr
    refine ⟨chainBlockIndex C c, Finset.mem_univ _, ?_⟩
    apply Subtype.ext
    exact h.symm

/-- All nonroot left-end cells of the chain, treated as cells of D. -/
noncomputable def chainLeftCells
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c =>
    c.1 ∈ nonrootLeftEnds
      (chainBlock C (chainBlockIndex C c))
      (chainBlockAnchor C (chainBlockIndex C c)))

/-- All nonroot bottom-end cells of the chain, treated as cells of D. -/
noncomputable def chainBottomCells
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c =>
    c.1 ∈ nonrootBottomEnds
      (chainBlock C (chainBlockIndex C c))
      (chainBlockAnchor C (chainBlockIndex C c)))

/-- The cells left over after roots and both kinds of boundary leaves. -/
noncomputable def chainFreeCells
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (ShapeCell D) :=
  Finset.univ \ (chainAnchorCells C ∪ chainLeftCells C ∪ chainBottomCells C)

/-- Root cells do not contribute a strict *nonroot* left inequality. -/
theorem chainAnchorCells_disjoint_left
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Disjoint (chainAnchorCells C) (chainLeftCells C) := by
  classical
  apply Finset.disjoint_left.mpr
  intro c hcR hcL
  have hR := (mem_chainAnchorCells_iff C c).mp hcR
  have hL := (Finset.mem_filter.mp hcL).2
  have hne := (Finset.mem_erase.mp hL).1
  exact hne hR

/-- Root cells do not contribute a strict *nonroot* bottom inequality. -/
theorem chainAnchorCells_disjoint_bottom
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Disjoint (chainAnchorCells C) (chainBottomCells C) := by
  classical
  apply Finset.disjoint_left.mpr
  intro c hcR hcB
  have hR := (mem_chainAnchorCells_iff C c).mp hcR
  have hB := (Finset.mem_filter.mp hcB).2
  have hne := (Finset.mem_erase.mp hB).1
  exact hne hR

/-- No cell is both a left-end leaf and a bottom-end leaf. -/
theorem chainLeftCells_disjoint_bottom
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Disjoint (chainLeftCells C) (chainBottomCells C) := by
  classical
  apply Finset.disjoint_left.mpr
  intro c hcL hcB
  have hL := (Finset.mem_filter.mp hcL).2
  have hB := (Finset.mem_filter.mp hcB).2
  exact (Finset.disjoint_left.mp
    (chainBlock_boundaries_disjoint C (chainBlockIndex C c))) hL hB

/-- Each concrete cell is a root, a left leaf, a bottom leaf, or free. -/
theorem chainCell_in_four_classes
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (c : ShapeCell D) :
    c ∈ chainAnchorCells C ∨ c ∈ chainLeftCells C ∨
      c ∈ chainBottomCells C ∨ c ∈ chainFreeCells C := by
  classical
  by_cases hr : c ∈ chainAnchorCells C
  · exact Or.inl hr
  by_cases hl : c ∈ chainLeftCells C
  · exact Or.inr (Or.inl hl)
  by_cases hb : c ∈ chainBottomCells C
  · exact Or.inr (Or.inr (Or.inl hb))
  right
  right
  right
  exact Finset.mem_sdiff.mpr
    ⟨Finset.mem_univ c, by simp [hr, hl, hb]⟩

/-! ### §6.1 — GeometricSlotIdentity. -/

def GeometricSlotIdentity
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) : Prop :=
  chainCompatibleFraction C =
    slotAssignmentRatio k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card

/-- Once the geometric permutation reindexing and the separately
proved universal slot identity are available, the fixed-chain theorem
is immediate. Neither premise is postulated as a global axiom. -/
theorem fixed_chain_slot_identity_of_bridges
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (hgeom : GeometricSlotIdentity C)
    (huniv : UniversalSlotIdentity k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card) :
    FixedChainSlotIdentity C := by
  unfold FixedChainSlotIdentity GeometricSlotIdentity at *
  calc
    chainCompatibleFraction C =
        slotAssignmentRatio k
          (fun i => rowCount (chainBlock C i) - 1)
          (fun i => columnCount (chainBlock C i) - 1)
          (chainFreeCells C).card := hgeom
    _ = slotKernelIntegral k
          (fun i => rowCount (chainBlock C i) - 1)
          (fun i => columnCount (chainBlock C i) - 1) := huniv
    _ = descendingChainKernelIntegral C :=
          (descendingChainKernelIntegral_eq_slotKernelIntegral C).symm

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Finite root-gap index equivalences. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The root values forced by a standard labeling of a fixed chain. -/
noncomputable def chainActualRootLabels
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) : Fin k → ℕ :=
  fun i => labelingOf D σ (chainBlockAnchor C i)

/-- There is no choice of root values in the chain-labeling correspondence:
    they are forced to be the labels of the intrinsic southwest anchors. -/
theorem mem_chainCompatibleStandardLabelings_iff_boundary
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D) :
    σ ∈ chainCompatibleStandardLabelings C ↔
      ChainBoundaryCompatible C σ (chainActualRootLabels C σ) := by
  classical
  change σ ∈
    (Finset.univ.filter (fun τ : StandardLabeling D =>
      ∃ roots : Fin k → ℕ,
        ConnectedChainCompatibleLabeling C τ roots)) ↔ _
  rw [Finset.mem_filter]
  constructor
  · rintro ⟨_, roots, hc⟩
    have hanchor := (compatibleChain_anchor_and_boundary hsk C σ roots hc).1
    have hroots : chainActualRootLabels C σ = roots := by
      funext i
      exact hanchor i
    rw [hroots]
    exact (chainBoundaryCompatible_iff_compatible hsk C σ roots).2 hc
  · intro hc
    refine ⟨Finset.mem_univ _, chainActualRootLabels C σ, ?_⟩
    exact (chainBoundaryCompatible_iff_compatible hsk C σ
      (chainActualRootLabels C σ)).1 hc

/-- The numerically defined root labels are necessarily strictly
    decreasing for every labeling of the given fixed chain. -/
theorem chainActualRootLabels_strictAnti
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (hσ : σ ∈ chainCompatibleStandardLabelings C) :
    StrictAnti (chainActualRootLabels C σ) := by
  exact ((mem_chainCompatibleStandardLabelings_iff_boundary hsk C σ).mp hσ).1

/-- The nonroot cells of the actual finite diagram, a concrete finite
    domain for the gap assignment rather than a notional list of leaves. -/
noncomputable def chainNonrootCells
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (ShapeCell D) :=
  Finset.univ \ chainAnchorCells C

/-- Given the k root values, count how many roots lie strictly below
    the label of a concrete cell. This is the gap index in increasing
    numeric order of the roots. -/
noncomputable def chainCellGap
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (c : ShapeCell D) : Fin (k + 1) := by
  classical
  let s : Finset (Fin k) :=
    Finset.univ.filter (fun i => chainActualRootLabels C σ i < (σ c).val)
  have hcard : s.card ≤ k := by
    calc
      s.card ≤ (Finset.univ : Finset (Fin k)).card :=
        Finset.card_le_card (Finset.filter_subset _ _)
      _ = k := by simp
  exact ⟨s.card, by omega⟩

/-- A gap assignment extracted from the actual labels. The proof that
    it satisfies the lower/upper SlotAllowed inequalities is exactly
    the finite counting bridge remaining for GeometricSlotIdentity. -/
noncomputable def chainNonrootGapAssignment
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) :
    {c : ShapeCell D // c ∈ chainNonrootCells C} → Fin (k + 1) :=
  fun c => chainCellGap C σ c.1

/-- Independent of any choice of root-value enumeration: the root list
    of a compatible fixed chain is forced by its intrinsic anchors.
    This prepares a genuine counting equivalence, without inserting
    GeometricSlotIdentity as an assumption. -/
theorem compatible_root_values_unique
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (hc : ConnectedChainCompatibleLabeling C σ roots) :
    roots = chainActualRootLabels C σ := by
  funext i
  exact ((compatibleChain_anchor_and_boundary hsk C σ roots hc).1 i).symm

end OrderedRootIntegral
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Every cell is either a root, a strict-left leaf, a strict-bottom
    leaf, or a free leaf. This is the exact *unindexed* cardinal
    decomposition underlying the factorial denominator in 6.1. -/
theorem chainCells_card_four_classes
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Fintype.card (ShapeCell D) =
      k + (chainLeftCells C).card + (chainBottomCells C).card +
        (chainFreeCells C).card := by
  classical
  let R := chainAnchorCells C
  let L := chainLeftCells C
  let U := chainBottomCells C
  have hRL : Disjoint R L := chainAnchorCells_disjoint_left C
  have hRU : Disjoint R U := chainAnchorCells_disjoint_bottom C
  have hLU : Disjoint L U := chainLeftCells_disjoint_bottom C
  have hRUL : Disjoint (R ∪ L) U := by
    apply Finset.disjoint_left.mpr
    intro c hc hu
    rcases Finset.mem_union.mp hc with hr | hl
    · exact (Finset.disjoint_left.mp hRU) hr hu
    · exact (Finset.disjoint_left.mp hLU) hl hu
  have hcardUnion : (R ∪ L ∪ U).card =
      R.card + L.card + U.card := by
    rw [Finset.card_union_of_disjoint hRUL,
      Finset.card_union_of_disjoint hRL]
  have hdiff : (chainFreeCells C).card + (R ∪ L ∪ U).card =
      Fintype.card (ShapeCell D) := by
    change ((Finset.univ : Finset (ShapeCell D)) \ (R ∪ L ∪ U)).card +
      (R ∪ L ∪ U).card = Fintype.card (ShapeCell D)
    simpa only [Finset.card_univ] using
      (Finset.card_sdiff_add_card_eq_card
        (Finset.subset_univ (R ∪ L ∪ U)))
  have hroot : R.card = k := chainAnchorCells_card C
  dsimp only [R, L, U] at hcardUnion hdiff hroot
  omega

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Linear orders within root gaps. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Linear orders within root gaps. -/

/-- The leaves actually assigned to gap `g` by `a`. -/
abbrev SlotGapFiber
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (g : Fin (k + 1)) :=
  {v : SlotLeaf k l u f // a.1 v = g}

/-- An order in each gap is an enumeration of that fiber by
`Fin (number of cells in the fiber)`. -/
abbrev SlotGapOrders
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) :=
  ∀ g : Fin (k + 1),
    SlotGapFiber k l u f a g ≃
      Fin (slotGapOccupancy k l u f a g)

/-- A packet consists of an admissible gap assignment, together with
one completely specified ordering of each of its fibers. -/
abbrev SlotGapPackets (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :=
  Σ a : AllowedSlotAssignment k l u f, SlotGapOrders k l u f a

/-- Exact fiber cardinality, connecting `Finset` and `Fintype`. -/
theorem card_slotGapFiber
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (g : Fin (k + 1)) :
    Fintype.card (SlotGapFiber k l u f a g) =
      slotGapOccupancy k l u f a g := by
  classical
  exact Fintype.card_subtype (fun v : SlotLeaf k l u f => a.1 v = g)

/-- For one fixed gap assignment, the number of possible internal
orders is exactly the product of gap factorials. -/
theorem card_slotGapOrders
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) :
    Fintype.card (SlotGapOrders k l u f a) =
      ∏ g : Fin (k + 1),
        Nat.factorial (slotGapOccupancy k l u f a g) := by
  classical
  rw [Fintype.card_pi]
  apply Finset.prod_congr rfl
  intro g _
  have h := card_slotGapFiber k l u f a g
  let e : SlotGapFiber k l u f a g ≃
      Fin (slotGapOccupancy k l u f a g) :=
    Fintype.equivFinOfCardEq h
  simpa only [h] using (Fintype.card_equiv e)

/-- The sum of factorial gap weights is the cardinality of ONE
finite type, without introducing permutation-list infrastructure. -/
theorem card_slotGapPackets
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    Fintype.card (SlotGapPackets k l u f) =
      ∑ a : AllowedSlotAssignment k l u f,
        ∏ g : Fin (k + 1),
          Nat.factorial (slotGapOccupancy k l u f a g) := by
  classical
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro a _
  exact card_slotGapOrders k l u f a

/-! ### §6.1 — Root and nonroot index sets. -/

/-- An actual nonroot left-boundary cell, tagged by its chain block. -/
abbrev ChainIndexedLeftLeaf
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  Σ i : Fin k,
    {c : Cell // c ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)}

/-- An actual nonroot bottom-boundary cell, tagged by its chain block. -/
abbrev ChainIndexedBottomLeaf
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  Σ i : Fin k,
    {c : Cell // c ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)}

/-- An actual cell lying in neither root nor strict boundary class. -/
abbrev ChainIndexedFreeLeaf
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  {c : ShapeCell D // c ∈ chainFreeCells C}

/-- The concrete counterpart of `SlotLeaf`; the local fin indexing
will be supplied by genuine boundary cardinalities. -/
abbrev ChainConcreteLeaf
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  ChainIndexedLeftLeaf C ⊕
    (ChainIndexedBottomLeaf C ⊕ ChainIndexedFreeLeaf C)

/-- Canonical-size equivalence for each concrete left-boundary class. -/
noncomputable def chainLeftFiberFinEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) :
    {c : Cell // c ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)} ≃
      Fin (rowCount (chainBlock C i) - 1) := by
  classical
  exact Finset.equivFinOfCardEq (chainBlock_left_boundary_card C i)

/-- Canonical-size equivalence for each concrete bottom-boundary class. -/
noncomputable def chainBottomFiberFinEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) :
    {c : Cell // c ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)} ≃
      Fin (columnCount (chainBlock C i) - 1) := by
  classical
  exact Finset.equivFinOfCardEq (chainBlock_bottom_boundary_card C i)

/-- The free-cell class is enumerated by its exact cardinality. -/
noncomputable def chainFreeFiberFinEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    ChainIndexedFreeLeaf C ≃ Fin (chainFreeCells C).card := by
  classical
  exact (chainFreeCells C).equivFin

/-- An honest concrete↔abstract leaf equivalence. All its components
are chosen from finite equivalences certified by cardinality theorems;
no new hypothesis on the diagram is required. -/
noncomputable def chainConcreteSlotEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    ChainConcreteLeaf C ≃
      SlotLeaf k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card := by
  classical
  let L := Equiv.sigmaCongrRight (chainLeftFiberFinEquiv C)
  let U := Equiv.sigmaCongrRight (chainBottomFiberFinEquiv C)
  exact L.sumCongr (U.sumCongr (chainFreeFiberFinEquiv C))

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Transport of root-gap coordinates. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A local left-boundary cell, lifted to the whole finite diagram. -/
noncomputable def chainLiftLeft
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    ShapeCell D := by
  have hcBlock : c.1 ∈ chainBlock C i :=
    (mem_leftEnds.mp (Finset.mem_erase.mp c.2).2).1
  exact ⟨c.1, intervalCells_subset_diagram D
    (C.ideals i.castSucc) (C.ideals i.succ) hcBlock⟩

/-- A local bottom-boundary cell, lifted to the whole finite diagram. -/
noncomputable def chainLiftBottom
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    ShapeCell D := by
  have hcBlock : c.1 ∈ chainBlock C i :=
    (mem_bottomEnds.mp (Finset.mem_erase.mp c.2).2).1
  exact ⟨c.1, intervalCells_subset_diagram D
    (C.ideals i.castSucc) (C.ideals i.succ) hcBlock⟩

/-- The chain index of a lifted left-boundary cell is exactly its tag. -/
theorem chainLiftLeft_index
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainBlockIndex C (chainLiftLeft C i c) = i := by
  apply chainBlockIndex_eq_of_mem C (chainLiftLeft C i c) i
  exact (mem_leftEnds.mp (Finset.mem_erase.mp c.2).2).1

/-- The chain index of a lifted bottom-boundary cell is its tag. -/
theorem chainLiftBottom_index
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainBlockIndex C (chainLiftBottom C i c) = i := by
  apply chainBlockIndex_eq_of_mem C (chainLiftBottom C i c) i
  exact (mem_bottomEnds.mp (Finset.mem_erase.mp c.2).2).1

/-- A lifted left leaf is not an anchor. -/
theorem chainLiftLeft_not_root
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainLiftLeft C i c ∉ chainAnchorCells C := by
  intro hr
  have h := (mem_chainAnchorCells_iff C (chainLiftLeft C i c)).mp hr
  rw [chainLiftLeft_index C i c] at h
  exact (Finset.mem_erase.mp c.2).1 h

/-- A lifted bottom leaf is not an anchor. -/
theorem chainLiftBottom_not_root
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainLiftBottom C i c ∉ chainAnchorCells C := by
  intro hr
  have h := (mem_chainAnchorCells_iff C (chainLiftBottom C i c)).mp hr
  rw [chainLiftBottom_index C i c] at h
  exact (Finset.mem_erase.mp c.2).1 h

/-- Lifted leaves are members of the appropriate global class. -/
theorem chainLiftLeft_mem_global
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainLiftLeft C i c ∈ chainLeftCells C := by
  classical
  change (chainLiftLeft C i c) ∈
    (Finset.univ.filter (fun d : ShapeCell D =>
      d.1 ∈ nonrootLeftEnds
        (chainBlock C (chainBlockIndex C d))
        (chainBlockAnchor C (chainBlockIndex C d))))
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _, ?_⟩
  rw [chainLiftLeft_index C i c]
  exact c.2

theorem chainLiftBottom_mem_global
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k)
    (c : {v : Cell // v ∈
      nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)}) :
    chainLiftBottom C i c ∈ chainBottomCells C := by
  classical
  change (chainLiftBottom C i c) ∈
    (Finset.univ.filter (fun d : ShapeCell D =>
      d.1 ∈ nonrootBottomEnds
        (chainBlock C (chainBlockIndex C d))
        (chainBlockAnchor C (chainBlockIndex C d))))
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _, ?_⟩
  rw [chainLiftBottom_index C i c]
  exact c.2

/-- A complete tagged leaf has a concrete nonroot cell. -/
noncomputable def chainConcreteLeafToNonroot
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    ChainConcreteLeaf C →
      {c : ShapeCell D // c ∈ chainNonrootCells C}
  | Sum.inl ⟨i, c⟩ =>
      ⟨chainLiftLeft C i c,
        Finset.mem_sdiff.mpr
          ⟨Finset.mem_univ _, chainLiftLeft_not_root C i c⟩⟩
  | Sum.inr (Sum.inl ⟨i, c⟩) =>
      ⟨chainLiftBottom C i c,
        Finset.mem_sdiff.mpr
          ⟨Finset.mem_univ _, chainLiftBottom_not_root C i c⟩⟩
  | Sum.inr (Sum.inr c) =>
      ⟨c.1, Finset.mem_sdiff.mpr
        ⟨Finset.mem_univ _, by
          intro hr
          have hc := (Finset.mem_sdiff.mp c.2).2
          exact hc (Finset.mem_union.mpr (Or.inl
            (Finset.mem_union.mpr (Or.inl hr))))⟩⟩

/-- Every nonroot cell has exactly one *canonical tagged representation*:
left leaf, bottom leaf, or free leaf. -/
noncomputable def chainNonrootToConcreteLeaf
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    {c : ShapeCell D // c ∈ chainNonrootCells C} → ChainConcreteLeaf C := by
  classical
  intro c
  by_cases hleft : c.1 ∈ chainLeftCells C
  · exact Sum.inl ⟨chainBlockIndex C c.1,
      ⟨c.1.1, (Finset.mem_filter.mp hleft).2⟩⟩
  by_cases hbottom : c.1 ∈ chainBottomCells C
  · exact Sum.inr (Sum.inl ⟨chainBlockIndex C c.1,
      ⟨c.1.1, (Finset.mem_filter.mp hbottom).2⟩⟩)
  · have hroot : c.1 ∉ chainAnchorCells C :=
      (Finset.mem_sdiff.mp c.2).2
    have hfree : c.1 ∈ chainFreeCells C := by
      apply Finset.mem_sdiff.mpr
      refine ⟨Finset.mem_univ _, ?_⟩
      simp only [Finset.mem_union, not_or]
      exact ⟨⟨hroot, hleft⟩, hbottom⟩
    exact Sum.inr (Sum.inr ⟨c.1, hfree⟩)

/-- Inverse maps, modulo proof-irrelevant subtype certificates. -/
theorem chainConcreteLeafToNonroot_left_inv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Function.LeftInverse
      (chainNonrootToConcreteLeaf C) (chainConcreteLeafToNonroot C) := by
  classical
  intro x
  rcases x with (⟨i, c⟩ | (⟨i, c⟩ | c))
  · have hl : chainLiftLeft C i c ∈ chainLeftCells C :=
      chainLiftLeft_mem_global C i c
    change chainNonrootToConcreteLeaf C
        (chainConcreteLeafToNonroot C (Sum.inl ⟨i, c⟩)) =
      Sum.inl ⟨i, c⟩
    dsimp only [chainConcreteLeafToNonroot]
    unfold chainNonrootToConcreteLeaf
    simp only [dite_eq_left hl]
    apply congrArg Sum.inl
    apply Sigma.subtype_ext
    · exact chainLiftLeft_index C i c
    · rfl
  · have hb : chainLiftBottom C i c ∈ chainBottomCells C :=
      chainLiftBottom_mem_global C i c
    have hnl : chainLiftBottom C i c ∉ chainLeftCells C := by
      intro hl
      exact (Finset.disjoint_left.mp
        (chainLeftCells_disjoint_bottom C)) hl hb
    change chainNonrootToConcreteLeaf C
        (chainConcreteLeafToNonroot C (Sum.inr (Sum.inl ⟨i, c⟩))) =
      Sum.inr (Sum.inl ⟨i, c⟩)
    dsimp only [chainConcreteLeafToNonroot]
    unfold chainNonrootToConcreteLeaf
    simp only [dite_eq_right hnl, dite_eq_left hb]
    apply congrArg (fun x : ChainIndexedBottomLeaf C =>
      (Sum.inr (Sum.inl x) : ChainConcreteLeaf C))
    apply Sigma.subtype_ext
    · exact chainLiftBottom_index C i c
    · rfl
  · have hnl : c.1 ∉ chainLeftCells C := by
      intro hl
      exact (Finset.mem_sdiff.mp c.2).2
        (Finset.mem_union.mpr (Or.inl
          (Finset.mem_union.mpr (Or.inr hl))))
    have hnb : c.1 ∉ chainBottomCells C := by
      intro hb
      exact (Finset.mem_sdiff.mp c.2).2
        (Finset.mem_union.mpr (Or.inr hb))
    change chainNonrootToConcreteLeaf C
        (chainConcreteLeafToNonroot C (Sum.inr (Sum.inr c))) =
      Sum.inr (Sum.inr c)
    simp [chainConcreteLeafToNonroot, chainNonrootToConcreteLeaf,
      hnl, hnb]

/-- From any concrete nonroot cell, decoding its tag restores the cell. -/
theorem chainConcreteLeafToNonroot_right_inv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Function.RightInverse
      (chainNonrootToConcreteLeaf C) (chainConcreteLeafToNonroot C) := by
  classical
  intro c
  by_cases hl : c.1 ∈ chainLeftCells C
  · simp only [chainNonrootToConcreteLeaf, dite_eq_left hl,
      chainConcreteLeafToNonroot]
    apply Subtype.ext
    apply Subtype.ext
    rfl
  · by_cases hb : c.1 ∈ chainBottomCells C
    · simp only [chainNonrootToConcreteLeaf, dite_eq_right hl,
        dite_eq_left hb, chainConcreteLeafToNonroot]
      apply Subtype.ext
      apply Subtype.ext
      rfl
    · simp only [chainNonrootToConcreteLeaf, dite_eq_right hl,
        dite_eq_right hb, chainConcreteLeafToNonroot]

/-- Key structural equivalence: every nonroot diagram cell is
represented *once and only once* in the concrete tagged type. -/
noncomputable def chainNonrootConcreteEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    {c : ShapeCell D // c ∈ chainNonrootCells C} ≃ ChainConcreteLeaf C :=
  { toFun := chainNonrootToConcreteLeaf C
    invFun := chainConcreteLeafToNonroot C
    left_inv := chainConcreteLeafToNonroot_right_inv C
    right_inv := chainConcreteLeafToNonroot_left_inv C }

/-- The full finite geometric domain can now be indexed as `SlotLeaf`,
without postulating a count or inventing an extra disjointness axiom. -/
noncomputable def chainNonrootSlotEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    {c : ShapeCell D // c ∈ chainNonrootCells C} ≃
      SlotLeaf k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card :=
  (chainNonrootConcreteEquiv C).trans (chainConcreteSlotEquiv C)

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Permutation reconstruction from root-gap ranks. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The cardinality of concrete nonroot cells is the sum of all slots. -/
theorem chainNonroot_card_from_slots
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    (chainNonrootCells C).card =
      (∑ i : Fin k, (rowCount (chainBlock C i) - 1)) +
      (∑ i : Fin k, (columnCount (chainBlock C i) - 1)) +
      (chainFreeCells C).card := by
  classical
  have h := Fintype.card_congr (chainNonrootSlotEquiv C)
  rw [Fintype.card_subtype] at h
  have hf : (Finset.univ.filter
      (fun c : ShapeCell D => c ∈ chainNonrootCells C)) =
        chainNonrootCells C := by
    ext c
    simp
  rw [hf] at h
  simpa only [SlotLeaf, Fintype.card_sum, Fintype.card_sigma,
    Fintype.card_fin, add_assoc] using h

/-- Correct cardinality for all cells, roots included. This is the
exact factorial denominator of `slotAssignmentRatio`. -/
theorem chainCell_card_from_slots
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Fintype.card (ShapeCell D) =
      k + (∑ i : Fin k, (rowCount (chainBlock C i) - 1)) +
        (∑ i : Fin k, (columnCount (chainBlock C i) - 1)) +
        (chainFreeCells C).card := by
  classical
  have hcard := chainNonroot_card_from_slots C
  have hroot := chainAnchorCells_card C
  have hpartition :
      (chainNonrootCells C).card + (chainAnchorCells C).card =
        Fintype.card (ShapeCell D) := by
    change ((Finset.univ : Finset (ShapeCell D)) \
       (chainAnchorCells C)).card + (chainAnchorCells C).card =
        Fintype.card (ShapeCell D)
    simpa only [Finset.card_univ] using
      (Finset.card_sdiff_add_card_eq_card
        (Finset.subset_univ (chainAnchorCells C)))
  omega

/-! For a given assignment, build ranks in Fin n from gap occupancy.
Leaf `v` in gap `g` lies at rank
  g + sum_{h < g} m_h + position_g(v).
Root `i` (ranked in DESCENDING root order) lies at rank
  (k - 1 - i) + sum_{h ≤ k - 1 - i} m_h.
These are pairwise distinct and partition 0,...,n-1. -/

/-- Prefix size of gap `g`, including the `g` roots below that gap. -/
noncomputable def gapStart
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (g : Fin (k + 1)) : ℕ :=
  g.val + ∑ h : Fin (k + 1),
    if h < g then slotGapOccupancy k l u f a h else 0

/-- The unique rank of an abstract slot leaf in its assigned gap. -/
noncomputable def gapLeafRank
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) (v : SlotLeaf k l u f) : ℕ :=
  gapStart k l u f a (a.1 v) +
    (o (a.1 v) ⟨v, rfl⟩).val

/-- The root of block i is the separating position following gap
`k-1-i` in increasing rank order. -/
noncomputable def gapRootRank
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f) (i : Fin k) : ℕ :=
  (k - 1 - i.val) +
    ∑ h : Fin (k + 1),
      if h.val ≤ k - 1 - i.val then
        slotGapOccupancy k l u f a h else 0

/-- The root/leaf classification makes a complete type of concrete
cells with no pairwise overlap. One equivalent copy of the roots and
one equivalent copy of the slots account for every cell. -/
abbrev ChainCellPacketDomain
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  (Fin k) ⊕
    SlotLeaf k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card

/-- A packet assigns a numerical rank to each member of the canonical
root/leaf disjoint union. The missing arithmetic lemma is that this
function is a bijection onto Fin n. -/
noncomputable def chainPacketRank
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (a : AllowedSlotAssignment k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card)
    (o : SlotGapOrders k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card a) :
    ChainCellPacketDomain C → ℕ
  | Sum.inl i => gapRootRank k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card a i
  | Sum.inr v => gapLeafRank k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card a o v

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Arithmetic of finite rank assignments. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The start index of gap `g`: `g` roots below it, plus the sizes
of the preceding gaps. Use `range` so the successor recursion is exact. -/
def arithmeticGapStart (m : ℕ → ℕ) (g : ℕ) : ℕ :=
  g + ∑ h ∈ Finset.range g, m h

/-- The next gap begins exactly one position after the intervening root. -/
theorem arithmeticGapStart_succ (m : ℕ → ℕ) (g : ℕ) :
    arithmeticGapStart m (g + 1) =
      arithmeticGapStart m g + m g + 1 := by
  simp only [arithmeticGapStart, Finset.sum_range_succ]
  omega

/-- All starts strictly increase, even when some gaps are empty. -/
theorem arithmeticGapStart_strictMono (m : ℕ → ℕ) :
    StrictMono (arithmeticGapStart m) := by
  apply strictMono_nat_of_lt_succ
  intro g
  rw [arithmeticGapStart_succ]
  omega

/-- Every cell in gap `g` lies before the root immediately following it. -/
theorem arithmeticGapLeaf_before_root (m : ℕ → ℕ) (g p : ℕ)
    (hp : p < m g) :
    arithmeticGapStart m g + p <
      arithmeticGapStart m g + m g := by
  omega

/-- The root after gap `g` lies before every later gap. -/
theorem arithmeticGapRoot_before_later (m : ℕ → ℕ)
    (g h : ℕ) (hgh : g < h) :
    arithmeticGapStart m g + m g < arithmeticGapStart m h := by
  have hnext : arithmeticGapStart m g + m g <
      arithmeticGapStart m (g + 1) := by
    rw [arithmeticGapStart_succ]
    omega
  have hmono : arithmeticGapStart m (g + 1) ≤
      arithmeticGapStart m h :=
    (arithmeticGapStart_strictMono m).monotone (by omega)
  exact lt_of_lt_of_le hnext hmono

/-- Ranks of leaves in distinct gaps cannot collide. -/
theorem arithmeticGapLeaf_before_later_leaf (m : ℕ → ℕ)
    (g h p q : ℕ) (hgh : g < h) (hp : p < m g) :
    arithmeticGapStart m g + p < arithmeticGapStart m h + q := by
  have hroot := arithmeticGapLeaf_before_root m g p hp
  have hgap := arithmeticGapRoot_before_later m g h hgh
  omega

/-- The root after gap `g` also lies before every leaf in gap `h>g`. -/
theorem arithmeticGapRoot_before_later_leaf (m : ℕ → ℕ)
    (g h q : ℕ) (hgh : g < h) :
    arithmeticGapStart m g + m g <
      arithmeticGapStart m h + q := by
  have hgap := arithmeticGapRoot_before_later m g h hgh
  omega

/-- The final gap ends at the total number of inserted roots and leaves. -/
theorem arithmeticGapLast_end (m : ℕ → ℕ) (k : ℕ) :
    arithmeticGapStart m k + m k =
      k + ∑ h ∈ Finset.range (k + 1), m h := by
  simp only [arithmeticGapStart, Finset.sum_range_succ]
  omega

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Counting equivalence for gap packets. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A fixed-chain compatible labeling with its certification. -/
abbrev ChainCompatibleLabelingType
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :=
  {σ : StandardLabeling D // σ ∈ chainCompatibleStandardLabelings C}

/-- The root-gap packet bijection expressed as a finite proposition. -/
def RootGapPacketEquivalence
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) : Prop :=
  Nonempty (
    ChainCompatibleLabelingType C ≃
      SlotGapPackets k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card)

/-- Once the DIRECT geometric equivalence is constructed, its finite
cardinality yields the exact geometric slot identity with no algebraic
or probabilistic assumption. -/
theorem geometric_slot_identity_of_packet_equiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (e : ChainCompatibleLabelingType C ≃
      SlotGapPackets k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card) :
    GeometricSlotIdentity C := by
  classical
  have hnum : (chainCompatibleStandardLabelings C).card =
      Fintype.card (SlotGapPackets k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card) := by
    calc
      (chainCompatibleStandardLabelings C).card =
          Fintype.card (ChainCompatibleLabelingType C) := by
            simp only [ChainCompatibleLabelingType,
              Fintype.card_subtype,
              Finset.filter_mem_eq_inter,
              Finset.univ_inter]
      _ = _ := Fintype.card_congr e
  have hden := chainCell_card_from_slots C
  unfold GeometricSlotIdentity
    chainCompatibleFraction slotAssignmentRatio
  rw [hnum, hden, card_slotGapPackets]
  simp only [Nat.cast_sum, Nat.cast_prod]
  congr 1
  refine Finset.sum_congr ?_ ?_
  · ext a
    simp only [Finset.mem_univ]
  · intro a _
    refine Finset.prod_congr ?_ ?_
    · ext g
      simp only [Finset.mem_univ]
    · intro g _
      have hocc :
          slotGapOccupancy k
            (fun i => rowCount (chainBlock C i) - 1)
            (fun i => columnCount (chainBlock C i) - 1)
            (chainFreeCells C).card a g =
          (Finset.univ.filter
            (fun v : SlotLeaf k
              (fun i => rowCount (chainBlock C i) - 1)
              (fun i => columnCount (chainBlock C i) - 1)
              (chainFreeCells C).card =>
                a.1 v = g)).card := by
        unfold slotGapOccupancy
        apply congrArg Finset.card
        ext v
        simp only [Finset.mem_filter,
          Finset.mem_univ, true_and]
      exact congrArg
        (fun n : ℕ => (Nat.factorial n : ℚ)) hocc

/-- Geometric slot identity obtained from an explicit packet-equivalence
hypothesis. -/
theorem geometric_slot_identity_of_packet_equivalence
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (hp : RootGapPacketEquivalence C) :
    GeometricSlotIdentity C := by
  rcases hp with ⟨e⟩
  exact geometric_slot_identity_of_packet_equiv C e

end OrderedRootIntegral
end OrderIdealSpecializations
/-! ### §6.1 — Interleaved root-gap packet arithmetic. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A leaf of position `p` in gap `g` has rank `start(g)+p`. -/
def chainSlotLeafRank (m : ℕ → ℕ) (g p : ℕ) : ℕ :=
  arithmeticGapStart m g + p

/-- The root immediately above gap `g` has rank `start(g)+m(g)`. -/
def chainSlotRootRank (m : ℕ → ℕ) (g : ℕ) : ℕ :=
  arithmeticGapStart m g + m g

/-- Roots have strictly increasing rank in the index of their preceding gap. -/
theorem chainSlotRootRank_strictMono (m : ℕ → ℕ) :
    StrictMono (chainSlotRootRank m) := by
  intro g h hgh
  have hh := arithmeticGapRoot_before_later m g h hgh
  dsimp [chainSlotRootRank]
  omega

/-- A leaf is below a root iff its gap does not follow that root's gap. -/
theorem chainSlotLeaf_lt_root_iff (m : ℕ → ℕ) (g h p : ℕ)
    (hp : p < m g) :
    chainSlotLeafRank m g p < chainSlotRootRank m h ↔ g ≤ h := by
  constructor
  · intro hlt
    by_contra hnot
    have hrev : h < g := by omega
    have hcontra := arithmeticGapRoot_before_later_leaf m h g p hrev
    dsimp [chainSlotLeafRank, chainSlotRootRank] at hlt
    omega
  · intro hgh
    rcases lt_or_eq_of_le hgh with hlt | heq
    · have hl := arithmeticGapLeaf_before_root m g p hp
      have hr := arithmeticGapRoot_before_later m g h hlt
      dsimp [chainSlotLeafRank, chainSlotRootRank]
      omega
    · subst h
      exact arithmeticGapLeaf_before_root m g p hp

/-- A root is below a leaf iff its gap precedes the leaf's gap. -/
theorem chainSlotRoot_lt_leaf_iff (m : ℕ → ℕ) (h g p : ℕ)
    (hp : p < m g) :
    chainSlotRootRank m h < chainSlotLeafRank m g p ↔ h < g := by
  constructor
  · intro hlt
    by_contra hnot
    have hgh : g ≤ h := by omega
    have hcontra := (chainSlotLeaf_lt_root_iff m g h p hp).2 hgh
    omega
  · intro hgh
    exact arithmeticGapRoot_before_later_leaf m h g p hgh

/-- The gap and local position of a leaf are determined by its rank. -/
theorem chainSlotLeafRank_inj (m : ℕ → ℕ)
    (g h p q : ℕ) (hp : p < m g) (hq : q < m h)
    (heq : chainSlotLeafRank m g p = chainSlotLeafRank m h q) :
    g = h ∧ p = q := by
  by_cases hgh : g = h
  · subst h
    constructor
    · rfl
    · dsimp [chainSlotLeafRank] at heq
      omega
  · rcases lt_or_gt_of_ne hgh with hlt | hgt
    · have hh := arithmeticGapLeaf_before_later_leaf m g h p q hlt hp
      dsimp [chainSlotLeafRank] at heq
      omega
    · have hh := arithmeticGapLeaf_before_later_leaf m h g q p hgt hq
      dsimp [chainSlotLeafRank] at heq
      omega

/-- No root rank can ever coincide with a leaf rank. -/
theorem chainSlotRootRank_ne_leafRank (m : ℕ → ℕ)
    (h g p : ℕ) (hp : p < m g) :
    chainSlotRootRank m h ≠ chainSlotLeafRank m g p := by
  intro heq
  by_cases hgh : h < g
  · have hr := (chainSlotRoot_lt_leaf_iff m h g p hp).2 hgh
    omega
  · have hgh' : g ≤ h := by omega
    have hl := (chainSlotLeaf_lt_root_iff m g h p hp).2 hgh'
    omega

/-- Every leaf lies within its own interval and before the next gap. -/
theorem chainSlotLeafRank_lt_nextGap (m : ℕ → ℕ)
    (g p : ℕ) (hp : p < m g) :
    chainSlotLeafRank m g p < arithmeticGapStart m (g + 1) := by
  rw [arithmeticGapStart_succ]
  dsimp [chainSlotLeafRank]
  omega

/-- Every root is one position before the next gap starts. -/
theorem chainSlotRootRank_succ (m : ℕ → ℕ) (g : ℕ) :
    chainSlotRootRank m g + 1 = arithmeticGapStart m (g + 1) := by
  rw [arithmeticGapStart_succ]
  rfl

/-- A disjoint union of abstract roots and *positioned* leaves has
an injective numerical rank, independent of all geometry. -/
def chainSlotPositionedRank (m : ℕ → ℕ) :
    (ℕ ⊕ (Σ g : ℕ, Fin (m g))) → ℕ
  | Sum.inl g => chainSlotRootRank m g
  | Sum.inr ⟨g, p⟩ => chainSlotLeafRank m g p.val

theorem chainSlotPositionedRank_injective (m : ℕ → ℕ) :
    Function.Injective (chainSlotPositionedRank m) := by
  intro a b hab
  rcases a with (g | ⟨g, p⟩)
  · rcases b with (h | ⟨h, q⟩)
    · have heq : g = h :=
        (chainSlotRootRank_strictMono m).injective
          (by simpa only [chainSlotPositionedRank] using hab)
      cases heq
      rfl
    · have heq : chainSlotRootRank m g = chainSlotLeafRank m h q.val :=
        by simpa only [chainSlotPositionedRank] using hab
      exact False.elim ((chainSlotRootRank_ne_leafRank m g h q.val q.isLt) heq)
  · rcases b with (h | ⟨h, q⟩)
    · have heq : chainSlotRootRank m h = chainSlotLeafRank m g p.val :=
        by simpa only [chainSlotPositionedRank] using hab.symm
      exact False.elim ((chainSlotRootRank_ne_leafRank m h g p.val p.isLt) heq)
    · have heq : chainSlotLeafRank m g p.val = chainSlotLeafRank m h q.val :=
        by simpa only [chainSlotPositionedRank] using hab
      obtain ⟨hg, hp⟩ := chainSlotLeafRank_inj m g h p.val q.val p.isLt q.isLt heq
      subst h
      have hfin : p = q := Fin.ext hp
      cases hfin
      rfl

end OrderedRootIntegral
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Finite classification by root gaps. -/

/-- Extend a finite occupancy profile to the naturals by zero. -/
def chainSlotNatOccupancy (k : ℕ) (m : Fin (k + 1) → ℕ) (g : ℕ) : ℕ :=
  if h : g < k + 1 then m ⟨g, h⟩ else 0

@[simp] theorem chainSlotNatOccupancy_fin (k : ℕ)
    (m : Fin (k + 1) → ℕ) (g : Fin (k + 1)) :
    chainSlotNatOccupancy k m g.val = m g := by
  simp only [chainSlotNatOccupancy, dite_eq_left g.isLt, Fin.eta]

/-- An abstract packet already includes exact positions inside each
fiber, so it can be ranked directly. The root tagged `i` follows gap
`k-1-i`, reflecting its decreasing order in the original chain. -/
def chainSlotFinitePositionRank (k : ℕ) (m : Fin (k + 1) → ℕ) :
    ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) → ℕ
  | Sum.inl i => chainSlotRootRank (chainSlotNatOccupancy k m) (k - 1 - i.val)
  | Sum.inr ⟨g, p⟩ => chainSlotLeafRank (chainSlotNatOccupancy k m) g.val p.val

/-- No two roots or leaves in the finite packet receive the same rank.
This is the injectivity half of the still-missing full finite Equiv. -/
theorem chainSlotFinitePositionRank_injective
    (k : ℕ) (m : Fin (k + 1) → ℕ) :
    Function.Injective (chainSlotFinitePositionRank k m) := by
  intro a b hab
  rcases a with (i | ⟨g, p⟩)
  · rcases b with (j | ⟨h, q⟩)
    · have hgh : k - 1 - i.val = k - 1 - j.val :=
        (chainSlotRootRank_strictMono (chainSlotNatOccupancy k m)).injective
          (by simpa only [chainSlotFinitePositionRank] using hab)
      have hij : i.val = j.val := by
        have hi := i.isLt
        have hj := j.isLt
        omega
      cases Fin.ext hij
      rfl
    · have hq : q.val < chainSlotNatOccupancy k m h.val := by
        simpa only [chainSlotNatOccupancy_fin] using q.isLt
      have heq : chainSlotRootRank (chainSlotNatOccupancy k m) (k - 1 - i.val) =
          chainSlotLeafRank (chainSlotNatOccupancy k m) h.val q.val :=
        by simpa only [chainSlotFinitePositionRank] using hab
      exact False.elim ((chainSlotRootRank_ne_leafRank _ _ _ _ hq) heq)
  · rcases b with (j | ⟨h, q⟩)
    · have hp : p.val < chainSlotNatOccupancy k m g.val := by
        simpa only [chainSlotNatOccupancy_fin] using p.isLt
      have heq : chainSlotRootRank (chainSlotNatOccupancy k m) (k - 1 - j.val) =
          chainSlotLeafRank (chainSlotNatOccupancy k m) g.val p.val :=
        by simpa only [chainSlotFinitePositionRank] using hab.symm
      exact False.elim ((chainSlotRootRank_ne_leafRank _ _ _ _ hp) heq)
    · have hp : p.val < chainSlotNatOccupancy k m g.val := by
        simpa only [chainSlotNatOccupancy_fin] using p.isLt
      have hq : q.val < chainSlotNatOccupancy k m h.val := by
        simpa only [chainSlotNatOccupancy_fin] using q.isLt
      have heq : chainSlotLeafRank (chainSlotNatOccupancy k m) g.val p.val =
          chainSlotLeafRank (chainSlotNatOccupancy k m) h.val q.val :=
        by simpa only [chainSlotFinitePositionRank] using hab
      obtain ⟨hgh, hpq⟩ := chainSlotLeafRank_inj _ _ _ _ _ hp hq heq
      have hh : g = h := Fin.ext hgh
      cases hh
      have hpfin : p = q := Fin.ext hpq
      cases hpfin
      rfl

end OrderedRootIntegral
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Finite bijections from cardinality identities. -/

theorem chainSlotNatOccupancy_range_sum (k : ℕ)
    (m : Fin (k + 1) → ℕ) :
    (∑ g ∈ Finset.range (k + 1), chainSlotNatOccupancy k m g) =
      ∑ g : Fin (k + 1), m g := by
  calc
    (∑ g ∈ Finset.range (k + 1), chainSlotNatOccupancy k m g) =
        ∑ g : Fin (k + 1), chainSlotNatOccupancy k m g.val :=
      (Fin.sum_univ_eq_sum_range (chainSlotNatOccupancy k m) (k + 1)).symm
    _ = ∑ g : Fin (k + 1), m g := by
      simp only [chainSlotNatOccupancy_fin]

/-- Every packet rank belongs to the precise finite interval 0..N-1,
where N is the number of roots plus the number of leaves. -/
theorem chainSlotFinitePositionRank_bound (k : ℕ)
    (m : Fin (k + 1) → ℕ)
    (a : (Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) :
    chainSlotFinitePositionRank k m a <
      k + ∑ g : Fin (k + 1), m g := by
  let M : ℕ → ℕ := chainSlotNatOccupancy k m
  have hN : arithmeticGapStart M k + M k =
      k + ∑ g : Fin (k + 1), m g := by
    rw [arithmeticGapLast_end M k]
    exact congrArg (fun t : ℕ => k + t) (chainSlotNatOccupancy_range_sum k m)
  rcases a with (i | ⟨g, p⟩)
  · have hi := i.isLt
    have hgap : k - 1 - i.val < k := by omega
    have hh := arithmeticGapRoot_before_later M (k - 1 - i.val) k hgap
    change chainSlotRootRank M (k - 1 - i.val) <
      k + ∑ g : Fin (k + 1), m g
    rw [← hN]
    dsimp [chainSlotRootRank]
    omega
  · have hp : p.val < M g.val := by
      simpa only [M, chainSlotNatOccupancy_fin] using p.isLt
    have hg := g.isLt
    change chainSlotLeafRank M g.val p.val <
      k + ∑ g : Fin (k + 1), m g
    rw [← hN]
    by_cases hlast : g.val = k
    · have hp' : p.val < M k := by simpa only [hlast] using hp
      rw [hlast]
      dsimp [chainSlotLeafRank]
      omega
    · have hlt : g.val < k := by omega
      have hleaf := arithmeticGapLeaf_before_root M g.val p.val hp
      have hroot := arithmeticGapRoot_before_later M g.val k hlt
      dsimp [chainSlotLeafRank]
      omega

/-- Exactly N positions are present in the finite packet domain. -/
theorem chainSlotFinitePositionRank_domain_card (k : ℕ)
    (m : Fin (k + 1) → ℕ) :
    Fintype.card ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) =
      k + ∑ g : Fin (k + 1), m g := by
  classical
  simp only [Fintype.card_sum, Fintype.card_sigma,
    Fintype.card_fin]

/-- The finite rank map is SURJECTIVE, without a separate, technical
surjectivity induction: injectivity and equal cardinality suffice. -/
theorem chainSlotFinitePositionFin_bijective (k : ℕ)
    (m : Fin (k + 1) → ℕ) :
    Function.Bijective
      (fun a : (Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g)) =>
        (⟨chainSlotFinitePositionRank k m a,
            chainSlotFinitePositionRank_bound k m a⟩ :
          Fin (k + ∑ g : Fin (k + 1), m g))) := by
  classical
  let rankFn : ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) →
      Fin (k + ∑ g : Fin (k + 1), m g) :=
    fun a => ⟨chainSlotFinitePositionRank k m a,
      chainSlotFinitePositionRank_bound k m a⟩
  have hinj : Function.Injective rankFn := by
    intro a b hab
    apply chainSlotFinitePositionRank_injective k m
    exact congrArg Fin.val hab
  have hcard :
      Fintype.card ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) =
      Fintype.card (Fin (k + ∑ g : Fin (k + 1), m g)) := by
    rw [chainSlotFinitePositionRank_domain_card]
    simp only [Fintype.card_fin]
  exact (Fintype.bijective_iff_injective_and_card rankFn).2
    ⟨hinj, hcard⟩

/-- A full explicit equivalence of **positioned root/leaf packets**
with all numerical labeling ranks. The local orders in gaps provide
the positioned-leaf coordinates; no global permutation search is needed. -/
noncomputable def chainSlotFinitePositionEquiv (k : ℕ)
    (m : Fin (k + 1) → ℕ) :
    ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) ≃
      Fin (k + ∑ g : Fin (k + 1), m g) :=
  Equiv.ofBijective
    (fun a => ⟨chainSlotFinitePositionRank k m a,
      chainSlotFinitePositionRank_bound k m a⟩)
    (chainSlotFinitePositionFin_bijective k m)

end OrderedRootIntegral
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Boundary inequalities for canonical labels. -/

/-- Within the finite packet, a leaf lies below anchor `i` exactly when
its gap is on the allowed left side of that anchor. -/
theorem chainSlotFiniteLeaf_below_root_iff
    (k : ℕ) (m : Fin (k + 1) → ℕ)
    (i : Fin k) (g : Fin (k + 1)) (p : Fin (m g)) :
    chainSlotFinitePositionRank k m (Sum.inr ⟨g, p⟩) <
      chainSlotFinitePositionRank k m (Sum.inl i) ↔
        g.val < k - i.val := by
  let M : ℕ → ℕ := chainSlotNatOccupancy k m
  have hp : p.val < M g.val := by
    simpa only [M, chainSlotNatOccupancy_fin] using p.isLt
  change chainSlotLeafRank M g.val p.val <
    chainSlotRootRank M (k - 1 - i.val) ↔ g.val < k - i.val
  rw [chainSlotLeaf_lt_root_iff M g.val (k - 1 - i.val) p.val hp]
  have hi := i.isLt
  omega

/-- A leaf lies above anchor `i` exactly when its gap is on the
allowed bottom-boundary side. -/
theorem chainSlotFiniteRoot_below_leaf_iff
    (k : ℕ) (m : Fin (k + 1) → ℕ)
    (i : Fin k) (g : Fin (k + 1)) (p : Fin (m g)) :
    chainSlotFinitePositionRank k m (Sum.inl i) <
      chainSlotFinitePositionRank k m (Sum.inr ⟨g, p⟩) ↔
        k - i.val ≤ g.val := by
  let M : ℕ → ℕ := chainSlotNatOccupancy k m
  have hp : p.val < M g.val := by
    simpa only [M, chainSlotNatOccupancy_fin] using p.isLt
  change chainSlotRootRank M (k - 1 - i.val) <
    chainSlotLeafRank M g.val p.val ↔ k - i.val ≤ g.val
  rw [chainSlotRoot_lt_leaf_iff M (k - 1 - i.val) g.val p.val hp]
  have hi := i.isLt
  omega

/-- All anchor ranks decrease with the canonical block index. -/
theorem chainSlotFiniteRoot_strictAnti
    (k : ℕ) (m : Fin (k + 1) → ℕ) :
    StrictAnti (fun i : Fin k =>
      chainSlotFinitePositionRank k m (Sum.inl i)) := by
  intro i j hij
  have hgi : k - 1 - j.val < k - 1 - i.val := by
    have hi := i.isLt
    have hj := j.isLt
    have hij' : i.val < j.val := hij
    omega
  exact (chainSlotRootRank_strictMono (chainSlotNatOccupancy k m)) hgi

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Root/nonroot classification. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Root/nonroot classification. -/

/-- A real cell is either the intrinsic anchor of its unique block or
one of the nonroot leaves. No arbitrary enumeration is used for roots. -/
noncomputable def chainSlotChainCellClassify
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    ShapeCell D → ChainCellPacketDomain C := by
  classical
  intro c
  by_cases hc : c ∈ chainAnchorCells C
  · exact Sum.inl (chainBlockIndex C c)
  · exact Sum.inr ((chainNonrootSlotEquiv C)
      ⟨c, Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hc⟩⟩)

/-- The concrete classification cannot identify two distinct cells. -/
theorem chainSlotChainCellClassify_injective
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Function.Injective (chainSlotChainCellClassify C) := by
  classical
  intro c d hcd
  by_cases hc : c ∈ chainAnchorCells C
  · by_cases hd : d ∈ chainAnchorCells C
    · have hi : chainBlockIndex C c = chainBlockIndex C d := by
        simpa only [chainSlotChainCellClassify, dite_eq_left hc, dite_eq_left hd,
          Sum.inl.injEq] using hcd
      apply Subtype.ext
      calc
        c.1 = chainBlockAnchor C (chainBlockIndex C c) :=
          (mem_chainAnchorCells_iff C c).mp hc
        _ = chainBlockAnchor C (chainBlockIndex C d) := by rw [hi]
        _ = d.1 := ((mem_chainAnchorCells_iff C d).mp hd).symm
    · simp [chainSlotChainCellClassify, hc, hd] at hcd
  · by_cases hd : d ∈ chainAnchorCells C
    · simp [chainSlotChainCellClassify, hc, hd] at hcd
    · have heq :
          (chainNonrootSlotEquiv C)
              ⟨c, Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hc⟩⟩ =
          (chainNonrootSlotEquiv C)
              ⟨d, Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hd⟩⟩ := by
        simpa only [chainSlotChainCellClassify, dite_eq_right hc, dite_eq_right hd,
          Sum.inr.injEq] using hcd
      have hsub := (chainNonrootSlotEquiv C).injective heq
      exact congrArg Subtype.val hsub

/-- Its finite domain and codomain have equal cardinality, since each
chain block contributes one root and the prescribed number of leaves. -/
theorem chainSlotChainCellClassify_card
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Fintype.card (ShapeCell D) =
      Fintype.card (ChainCellPacketDomain C) := by
  classical
  rw [chainCell_card_from_slots C]
  simp only [ChainCellPacketDomain, SlotLeaf,
    Fintype.card_sum, Fintype.card_sigma, Fintype.card_fin, add_assoc]

/-- Concrete classification is an equivalence, not merely a counting
argument. It is now a canonical transport surface for gap packets. -/
noncomputable def chainSlotChainCellRootLeafEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    ShapeCell D ≃ ChainCellPacketDomain C :=
  Equiv.ofBijective (chainSlotChainCellClassify C)
    ((Fintype.bijective_iff_injective_and_card
      (chainSlotChainCellClassify C)).2
        ⟨chainSlotChainCellClassify_injective C,
         chainSlotChainCellClassify_card C⟩)

/-! ### §6.1 — Recovery of leaf coordinates from packets. -/

/-- Each leaf has a unique gap and a unique `Fin m_g` position.
Conversely, the inverse of that gap's order reconstructs the leaf. -/
noncomputable def chainSlotPacketSlotEquiv
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    SlotLeaf k l u f ≃
      (Σ g : Fin (k + 1),
        Fin (slotGapOccupancy k l u f a g)) := by
  classical
  exact
    (Equiv.sigmaFiberEquiv
      (fun v : SlotLeaf k l u f => a.1 v)).symm.trans
      (Equiv.sigmaCongrRight
        (fun g : Fin (k + 1) => o g))

/-- The full root/leaf rank code determines a standard labeling.
No choice of ranks remains: the rank Equiv from part C is explicit,
and the only unavoidable nonconstructivity is the finite enumeration
of the concrete boundary cells from the preceding classification. -/
noncomputable def chainSlotPacketLabeling
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (a : AllowedSlotAssignment k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card)
    (o : SlotGapOrders k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card a) : StandardLabeling D := by
  classical
  let l : Fin k → ℕ := fun i => rowCount (chainBlock C i) - 1
  let u : Fin k → ℕ := fun i => columnCount (chainBlock C i) - 1
  let f : ℕ := (chainFreeCells C).card
  let m : Fin (k + 1) → ℕ := slotGapOccupancy k l u f a
  have hN : k + (∑ g : Fin (k + 1), m g) =
      Fintype.card (ShapeCell D) := by
    rw [show (∑ g : Fin (k + 1), m g) =
      (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f from
        sum_slotGapOccupancy k l u f a]
    simpa only [l, u, f, add_assoc] using
      (chainCell_card_from_slots C).symm
  let E1 : ShapeCell D ≃ ChainCellPacketDomain C :=
    chainSlotChainCellRootLeafEquiv C
  let E2 : ChainCellPacketDomain C ≃
      ((Fin k) ⊕ (Σ g : Fin (k + 1), Fin (m g))) :=
    (Equiv.refl (Fin k)).sumCongr (chainSlotPacketSlotEquiv k l u f a o)
  let E3 := chainSlotFinitePositionEquiv k m
  let E4 : Fin (k + ∑ g : Fin (k + 1), m g) ≃
      Fin (Fintype.card (ShapeCell D)) :=
    Equiv.cast (congrArg Fin hN)
  exact E1.trans (E2.trans (E3.trans E4))

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Root-threshold gap counts. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- There are exactly `k-t` indices in `Fin k` whose values are >= t.
The explicit complement proof avoids guessing a special `Fin.card_Ici` API. -/
theorem root_gap_fin_card_ge (k t : ℕ) (ht : t ≤ k) :
    (Finset.univ.filter (fun j : Fin k => t ≤ j.val)).card = k - t := by
  classical
  let S : Finset (Fin k) := Finset.univ.filter (fun j => j.val < t)
  have hS : S.card = t := by
    simpa only [S, min_eq_right ht] using
      (Fin.card_filter_val_lt (n := k) (m := t))
  have hcomp : (Finset.univ : Finset (Fin k)) \ S =
      Finset.univ.filter (fun j : Fin k => t ≤ j.val) := by
    ext j
    simp only [S, Finset.mem_sdiff, Finset.mem_filter,
      Finset.mem_univ, true_and, true_and, not_lt]
  have hsum := Finset.card_sdiff_add_card_eq_card (Finset.subset_univ S)
  rw [hcomp, hS] at hsum
  simp only [Finset.card_univ, Fintype.card_fin] at hsum
  omega

/-- With strictly descending root values, the roots below the i-th
root are exactly those with strictly larger indices. -/
theorem root_gap_roots_below_root_count
    {k : ℕ} (roots : Fin k → ℕ) (hanti : StrictAnti roots)
    (i : Fin k) :
    (Finset.univ.filter (fun j : Fin k => roots j < roots i)).card =
      k - 1 - i.val := by
  classical
  have hfilter :
      (Finset.univ.filter (fun j : Fin k => roots j < roots i)) =
        (Finset.univ.filter (fun j : Fin k => i.val + 1 ≤ j.val)) := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · intro hj
      by_contra hn
      have hle : j.val ≤ i.val := by omega
      by_cases heq : j = i
      · subst j
        omega
      · have hlt : j < i := Fin.lt_def.mpr (by
          have hne : j.val ≠ i.val := fun h => heq (Fin.ext h)
          omega)
        have hdec := hanti hlt
        omega
    · intro hj
      have hij : i < j := Fin.lt_def.mpr (by omega)
      exact hanti hij
  rw [hfilter, root_gap_fin_card_ge k (i.val + 1) i.isLt]
  omega

/-- The exact gap/root comparison for one nonroot label. -/
theorem root_gap_root_gap_lt_iff
    {k : ℕ} (roots : Fin k → ℕ) (hanti : StrictAnti roots)
    (x : ℕ) (hnotroot : ∀ i : Fin k, x ≠ roots i)
    (i : Fin k) :
    (Finset.univ.filter (fun j : Fin k => roots j < x)).card <
      k - i.val ↔ x < roots i := by
  classical
  let G : Finset (Fin k) :=
    Finset.univ.filter (fun j => roots j < x)
  have hlt (hx : x < roots i) : G.card < k - i.val := by
    have hsub : G ⊆ Finset.univ.filter
        (fun j : Fin k => i.val + 1 ≤ j.val) := by
      intro j hj
      have hjx : roots j < x := (Finset.mem_filter.mp hj).2
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ _, ?_⟩
      by_contra hn
      have hle : j.val ≤ i.val := by omega
      by_cases heq : j = i
      · subst j
        omega
      · have hji : j < i := Fin.lt_def.mpr (by
          have hne : j.val ≠ i.val := fun h => heq (Fin.ext h)
          omega)
        have hdecr := hanti hji
        omega
    have hcard := Finset.card_le_card hsub
    have hsize := root_gap_fin_card_ge k (i.val + 1) i.isLt
    omega
  have hgt (hx : roots i < x) : k - i.val ≤ G.card := by
    have hsub : (Finset.univ.filter (fun j : Fin k => i.val ≤ j.val))
        ⊆ G := by
      intro j hj
      have hij : i.val ≤ j.val := (Finset.mem_filter.mp hj).2
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ _, ?_⟩
      by_cases heq : j = i
      · subst j
        exact hx
      · have hij' : i < j := Fin.lt_def.mpr (by
          have hne : j.val ≠ i.val := fun h => heq (Fin.ext h)
          omega)
        have hdecr := hanti hij'
        omega
    have hcard := Finset.card_le_card hsub
    have hsize := root_gap_fin_card_ge k i.val i.isLt.le
    omega
  constructor
  · intro hg
    have hn := hnotroot i
    by_contra hnot
    have hx : roots i < x := by omega
    exact (not_le_of_gt hg) (hgt hx)
  · exact hlt

/-- The complementary comparison (the right/bottom boundary case). -/
theorem root_gap_root_gap_ge_iff
    {k : ℕ} (roots : Fin k → ℕ) (hanti : StrictAnti roots)
    (x : ℕ) (hnotroot : ∀ i : Fin k, x ≠ roots i)
    (i : Fin k) :
    k - i.val ≤
      (Finset.univ.filter (fun j : Fin k => roots j < x)).card ↔
      roots i < x := by
  have h := root_gap_root_gap_lt_iff roots hanti x hnotroot i
  constructor
  · intro hg
    by_contra hn
    have hx : x < roots i := by have hn' := hnotroot i; omega
    have ht := h.mpr hx
    omega
  · intro hx
    by_contra hn
    have hsmall :
        (Finset.univ.filter (fun j : Fin k => roots j < x)).card <
          k - i.val := by omega
    have hy := h.mp hsmall
    omega

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Abstract root-gap geometry. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- An abstract finite set of `k` roots and its nonroot leaves. -/
abbrev CanonicalPacketCells (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :=
  (Fin k) ⊕ SlotLeaf k l u f

/-- A genuine finite permutation is admissible when it has decreasing
root values and satisfies precisely the strict boundary comparisons. -/
def CanonicalPacketValid
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n) : Prop :=
  StrictAnti (fun i : Fin k => (σ (Sum.inl i)).val) ∧
  (∀ i : Fin k, ∀ p : Fin (l i),
    (σ (Sum.inr (Sum.inl ⟨i, p⟩))).val <
      (σ (Sum.inl i)).val) ∧
  (∀ i : Fin k, ∀ p : Fin (u i),
    (σ (Sum.inl i)).val <
      (σ (Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩)))).val)

/-- The gap number is the count of roots whose numerical labels are
strictly smaller than the given nonroot label. -/
noncomputable def canonicalPacketGap
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (v : SlotLeaf k l u f) : Fin (k + 1) := by
  classical
  let S : Finset (Fin k) := Finset.univ.filter
    (fun i => (σ (Sum.inl i)).val < (σ (Sum.inr v)).val)
  have hcard : S.card ≤ k := by
    calc
      S.card ≤ (Finset.univ : Finset (Fin k)).card :=
        Finset.card_le_card (Finset.filter_subset _ _)
      _ = k := by simp
  exact ⟨S.card, by omega⟩

/-- A leaf never has the same numerical label as any root. -/
theorem canonicalPacketLeaf_ne_root
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (v : SlotLeaf k l u f) (i : Fin k) :
    (σ (Sum.inr v)).val ≠ (σ (Sum.inl i)).val := by
  intro h
  have he : σ (Sum.inr v) = σ (Sum.inl i) := Fin.ext h
  have hx : (Sum.inr v : CanonicalPacketCells k l u f) = Sum.inl i :=
    σ.injective he
  cases hx

/-- An admissible root-ordered labeling produces the required abstract
slot assignment, with each left leaf in a lower gap and each bottom
leaf in an upper gap. This uses NO cardinality assumption on a packet. -/
noncomputable def canonicalPacketAllowedSlotAssignment
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (hvalid : CanonicalPacketValid k l u f n σ) :
    AllowedSlotAssignment k l u f := by
  classical
  refine ⟨canonicalPacketGap k l u f n σ, ?_⟩
  intro v
  let roots : Fin k → ℕ := fun i => (σ (Sum.inl i)).val
  let x : ℕ := (σ (Sum.inr v)).val
  have hanti : StrictAnti roots := hvalid.1
  have hnot : ∀ i : Fin k, x ≠ roots i := by
    intro i
    exact canonicalPacketLeaf_ne_root k l u f n σ v i
  cases v with
  | inl ip =>
      rcases ip with ⟨i, p⟩
      change (canonicalPacketGap k l u f n σ (Sum.inl ⟨i, p⟩)).val <
        k - i.val
      have hcomp : x < roots i := hvalid.2.1 i p
      exact (root_gap_root_gap_lt_iff roots hanti x hnot i).mpr hcomp
  | inr rest =>
      cases rest with
      | inl ip =>
          rcases ip with ⟨i, p⟩
          change k - i.val ≤
            (canonicalPacketGap k l u f n σ
              (Sum.inr (Sum.inl ⟨i, p⟩))).val
          have hcomp : roots i < x := hvalid.2.2 i p
          exact (root_gap_root_gap_ge_iff roots hanti x hnot i).mpr hcomp
      | inr q =>
          trivial

/-- The abstract permutation obtained from a gap packet. -/
noncomputable def canonicalPacketOfPacket
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    CanonicalPacketCells k l u f ≃
      Fin (k + ∑ g : Fin (k + 1), slotGapOccupancy k l u f a g) :=
  ((Equiv.refl (Fin k)).sumCongr (chainSlotPacketSlotEquiv k l u f a o)).trans
    (chainSlotFinitePositionEquiv k (slotGapOccupancy k l u f a))

/-- The labels of the `k` roots obtained from any packet decrease. -/
theorem canonicalPacketOfPacket_strictAnti
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    StrictAnti (fun i : Fin k =>
      ((canonicalPacketOfPacket k l u f a o) (Sum.inl i)).val) := by
  intro i j hij
  change chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inl j) <
    chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inl i)
  exact chainSlotFiniteRoot_strictAnti k (slotGapOccupancy k l u f a) hij

/-- A packet's leaf lies below the i-th root exactly when its gap is
below `k-i`. It uses the FINITE-position rank lemma from the rank classification. -/
theorem canonicalPacketOfPacket_leaf_lt_root_iff
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (v : SlotLeaf k l u f) (i : Fin k) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inr v)).val <
      ((canonicalPacketOfPacket k l u f a o) (Sum.inl i)).val ↔
        (a.1 v).val < k - i.val := by
  change chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inr ⟨a.1 v, o (a.1 v) ⟨v, rfl⟩⟩) <
    chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inl i) ↔ _
  exact chainSlotFiniteLeaf_below_root_iff k
    (slotGapOccupancy k l u f a) i (a.1 v)
    (o (a.1 v) ⟨v, rfl⟩)

/-- Complementary comparison for bottom-boundary leaves. -/
theorem canonicalPacketOfPacket_root_lt_leaf_iff
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (v : SlotLeaf k l u f) (i : Fin k) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inl i)).val <
      ((canonicalPacketOfPacket k l u f a o) (Sum.inr v)).val ↔
        k - i.val ≤ (a.1 v).val := by
  change chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inl i) <
    chainSlotFinitePositionRank k (slotGapOccupancy k l u f a)
      (Sum.inr ⟨a.1 v, o (a.1 v) ⟨v, rfl⟩⟩) ↔ _
  exact chainSlotFiniteRoot_below_leaf_iff k
    (slotGapOccupancy k l u f a) i (a.1 v)
    (o (a.1 v) ⟨v, rfl⟩)

/-- Every packet automatically satisfies ALL abstract boundary and
root-order conditions.  No use of the desired geometric identity. -/
theorem canonicalPacketOfPacket_valid
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    CanonicalPacketValid k l u f _
      (canonicalPacketOfPacket k l u f a o) := by
  constructor
  · exact canonicalPacketOfPacket_strictAnti k l u f a o
  constructor
  · intro i p
    let v : SlotLeaf k l u f := Sum.inl ⟨i, p⟩
    have hal : (a.1 v).val < k - i.val := a.2 v
    exact (canonicalPacketOfPacket_leaf_lt_root_iff k l u f a o v i).mpr hal
  · intro i p
    let v : SlotLeaf k l u f := Sum.inr (Sum.inl ⟨i, p⟩)
    have hal : k - i.val ≤ (a.1 v).val := a.2 v
    exact (canonicalPacketOfPacket_root_lt_leaf_iff k l u f a o v i).mpr hal

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Recovery of slot assignments from labels. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Reversing the index of k roots: exactly g roots are below a leaf
in gap g (regardless of how many leaves inhabit any other gap). -/
theorem root_gap_card_reverse_cut (k : ℕ) (g : Fin (k + 1)) :
    (Finset.univ.filter (fun i : Fin k => k - i.val ≤ g.val)).card =
      g.val := by
  classical
  have hset :
      (Finset.univ.filter (fun i : Fin k => k - i.val ≤ g.val)) =
      Finset.univ.filter (fun i : Fin k => k - g.val ≤ i.val) := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    have hi := i.isLt
    have hg := g.isLt
    omega
  rw [hset, root_gap_fin_card_ge k (k - g.val) (Nat.sub_le _ _)]
  have hg := g.isLt
  omega

/-- A packet *recovers its own original gap assignment* from the
permutation it produced. This eliminates the potentially noncanonical
choice of gap assignments in the converse counting argument. -/
theorem root_gap_gap_of_packet_eq
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (v : SlotLeaf k l u f) :
    canonicalPacketGap k l u f _ (canonicalPacketOfPacket k l u f a o) v =
      a.1 v := by
  classical
  apply Fin.ext
  change
    (Finset.univ.filter (fun i : Fin k =>
      ((canonicalPacketOfPacket k l u f a o) (Sum.inl i)).val <
      ((canonicalPacketOfPacket k l u f a o) (Sum.inr v)).val)).card =
    (a.1 v).val
  have hset :
      (Finset.univ.filter (fun i : Fin k =>
        ((canonicalPacketOfPacket k l u f a o) (Sum.inl i)).val <
        ((canonicalPacketOfPacket k l u f a o) (Sum.inr v)).val)) =
      Finset.univ.filter (fun i : Fin k => k - i.val ≤ (a.1 v).val) := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact canonicalPacketOfPacket_root_lt_leaf_iff k l u f a o v i
  rw [hset]
  exact root_gap_card_reverse_cut k (a.1 v)

/-- The full subtype of admissible gap assignments is recovered;
no assumption on an eventual geometric equivalence is needed. -/
theorem root_gap_allowed_of_packet_eq
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    canonicalPacketAllowedSlotAssignment k l u f _
      (canonicalPacketOfPacket k l u f a o)
      (canonicalPacketOfPacket_valid k l u f a o) = a := by
  apply Subtype.ext
  funext v
  exact root_gap_gap_of_packet_eq k l u f a o v

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Reverse construction for abstract root-gap packets. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Given a bijective numerical labeling, order the leaves in one
assigned gap by their own numerical labels, not by an arbitrary
enumeration. This choice is essential to uniqueness of the inverse. -/
noncomputable def packetSortedOrdersFromLabeling
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (a : AllowedSlotAssignment k l u f) :
    SlotGapOrders k l u f a := by
  classical
  intro g
  let α := SlotGapFiber k l u f a g
  have hinj : Function.Injective
      (fun v : α => (σ (Sum.inr v.1)).val) := by
    intro v w hvw
    apply Subtype.ext
    have hfin : σ (Sum.inr v.1) = σ (Sum.inr w.1) :=
      Fin.ext hvw
    have hsum := σ.injective hfin
    exact Sum.inr.inj hsum
  letI : LinearOrder α :=
    LinearOrder.lift' (fun v : α => (σ (Sum.inr v.1)).val) hinj
  letI : LE α := (inferInstance : LinearOrder α).toLE
  letI : LT α := (inferInstance : LinearOrder α).toLT
  letI : LE α := (inferInstance : LinearOrder α).toLE
  letI : LT α := (inferInstance : LinearOrder α).toLT
  letI : Preorder α := (inferInstance : LinearOrder α).toPreorder
  -- Use only the lifted LinearOrder: installing additional LE/LT
  -- instances here changes the order seen by `StrictMono`.
  exact (Fintype.orderIsoFinOfCardEq α
    (card_slotGapFiber k l u f a g)).symm.toEquiv

/-- Explicit source-to-packet map for any valid abstract labeling:
  1. identify each leaf's gap by counting smaller roots;
  2. order the leaves in that gap by the bijective labeling.
This is a genuine map, not a postulated equivalence. -/
noncomputable def canonicalPacketEncode
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (hvalid : CanonicalPacketValid k l u f n σ) :
    SlotGapPackets k l u f := by
  classical
  let a := canonicalPacketAllowedSlotAssignment k l u f n σ hvalid
  exact ⟨a, packetSortedOrdersFromLabeling k l u f n σ a⟩

/-- The packet-to-labeling map with a CONSTANT codomain, independent
of the choice of gap assignment. This makes injectivity and the two
inverse laws correctly typable in Lean. -/
noncomputable def canonicalPacketOfPacketUniform
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    CanonicalPacketCells k l u f ≃
      Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) := by
  classical
  let m : Fin (k + 1) → ℕ := slotGapOccupancy k l u f a
  have hN : k + (∑ g : Fin (k + 1), m g) =
      k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f := by
    rw [show (∑ g : Fin (k + 1), m g) =
      (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f from
        sum_slotGapOccupancy k l u f a]
    omega
  exact (canonicalPacketOfPacket k l u f a o).trans
    (Equiv.cast (congrArg Fin hN))

/-- Abstract packet-equivalence property, represented as a proposition
whose realizations supply the required equivalence. -/
def CanonicalPacketEquivalence (k : ℕ)
    (l u : Fin k → ℕ) (f : ℕ) : Prop :=
  Nonempty (
    {σ : CanonicalPacketCells k l u f ≃
        Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) //
        CanonicalPacketValid k l u f _ σ} ≃
      SlotGapPackets k l u f)

end OrderedRootIntegral
end OrderIdealSpecializations
/-! ### §6.1 — Order-theoretic uniqueness for packets. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- If two bijections into Fin n induce the same linear ordering on their
common domain, they coincide.  This is independent of diagrams. -/
theorem ordered_packet_equiv_eq_of_same_strict_order
    {α : Type*} {n : ℕ} (e f : α ≃ Fin n)
    (h : ∀ a b : α, e a < e b ↔ f a < f b) : e = f := by
  classical
  let q : Fin n → Fin n := fun i => f (e.symm i)
  have hq : StrictMono q := by
    intro i j hij
    apply (h (e.symm i) (e.symm j)).mp
    simpa [q] using hij
  have hq_univ : q = (fun i : Fin n => i) := by
    have hcard : (Finset.univ : Finset (Fin n)).card = n := by simp
    have h₁ := Finset.orderEmbOfFin_unique
      (s := (Finset.univ : Finset (Fin n))) (k := n)
      hcard (f := q) (fun _ => Finset.mem_univ _) hq
    have h₂ := Finset.orderEmbOfFin_unique
      (s := (Finset.univ : Finset (Fin n))) (k := n)
      hcard (f := fun i : Fin n => i)
      (fun _ => Finset.mem_univ _) (strictMono_id)
    exact h₁.trans h₂.symm
  apply Equiv.ext
  intro a
  have ha := congrFun hq_univ (e a)
  change f (e.symm (e a)) = e a at ha
  simpa using ha.symm

/-- A strictly increasing bijection from a finite linear order to
`Fin n` is its unique sorted enumeration.  This is the algebraic core of
the inverse-law proof for the per-gap order `SlotGapOrders`. -/
theorem ordered_packet_sorted_equiv_unique
    {α : Type*} [LinearOrder α] [Fintype α] {n : ℕ}
    (hcard : Fintype.card α = n)
    (e : α ≃ Fin n) (he : StrictMono e) :
    e = (Fintype.orderIsoFinOfCardEq α hcard).symm.toEquiv := by
  classical
  apply ordered_packet_equiv_eq_of_same_strict_order
  intro a b
  have hleft : e a < e b ↔ a < b := by
    constructor
    · intro hab
      by_contra hn
      have hle : b ≤ a := le_of_not_gt hn
      have hf := he.monotone hle
      exact (not_le_of_gt hab) hf
    · intro hab
      exact he hab
  have hright :
      a < b ↔
        ((Fintype.orderIsoFinOfCardEq α hcard).symm a) <
          ((Fintype.orderIsoFinOfCardEq α hcard).symm b) :=
    (Fintype.orderIsoFinOfCardEq α hcard).symm.lt_iff_lt.symm
  exact hleft.trans hright

/-- Monotonicity of the root-count gap number; no injectivity or
strictly descending hypothesis is needed. -/
theorem ordered_packet_root_count_monotone {k : ℕ}
    (roots : Fin k → ℕ) {x y : ℕ} (hxy : x ≤ y) :
    (Finset.univ.filter (fun i : Fin k => roots i < x)).card ≤
      (Finset.univ.filter (fun i : Fin k => roots i < y)).card := by
  classical
  apply Finset.card_le_card
  intro i hi
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
  omega

/-- If a leaf belongs to a strictly lower-numbered gap, its label
must be smaller.  The converse is false for leaves in the SAME gap. -/
theorem ordered_packet_label_lt_of_root_count_lt {k : ℕ}
    (roots : Fin k → ℕ) {x y : ℕ}
    (h : (Finset.univ.filter (fun i : Fin k => roots i < x)).card <
        (Finset.univ.filter (fun i : Fin k => roots i < y)).card) :
    x < y := by
  by_contra hn
  have hyx : y ≤ x := by omega
  have hc := ordered_packet_root_count_monotone roots hyx
  omega

/-- The gap coordinate of an abstract labeling is automatically
monotone along increasing leaf labels. -/
theorem ordered_packet_abstract_gap_monotone
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    {v w : SlotLeaf k l u f}
    (hvw : (σ (Sum.inr v)).val ≤ (σ (Sum.inr w)).val) :
    (canonicalPacketGap k l u f n σ v).val ≤
      (canonicalPacketGap k l u f n σ w).val := by
  classical
  exact ordered_packet_root_count_monotone
    (fun i : Fin k => (σ (Sum.inl i)).val) hvw

/-- Different gaps necessarily impose the relative order of
nonroot labels in every abstract labeling. -/
theorem ordered_packet_abstract_leaf_lt_of_gap_lt
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    {v w : SlotLeaf k l u f}
    (hgap : (canonicalPacketGap k l u f n σ v).val <
      (canonicalPacketGap k l u f n σ w).val) :
    (σ (Sum.inr v)).val < (σ (Sum.inr w)).val := by
  classical
  exact ordered_packet_label_lt_of_root_count_lt
    (fun i : Fin k => (σ (Sum.inl i)).val) hgap

/-- Transfer a hypothetical completed abstract packet equivalence
through a *proved concrete/abstract compatibility equivalence*.
Neither missing equivalence is silently postulated. -/
theorem ordered_packet_equivalence_from_geometric_maps
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (l u : Fin k → ℕ) (f : ℕ)
    (hl : l = fun i => rowCount (chainBlock C i) - 1)
    (hu : u = fun i => columnCount (chainBlock C i) - 1)
    (hf : f = (chainFreeCells C).card)
    (habstract :
      {σ : CanonicalPacketCells k l u f ≃
          Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) //
          CanonicalPacketValid k l u f _ σ} ≃ SlotGapPackets k l u f)
    (hconcrete : ChainCompatibleLabelingType C ≃
      {σ : CanonicalPacketCells k l u f ≃
          Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) //
          CanonicalPacketValid k l u f _ σ}) :
    RootGapPacketEquivalence C := by
  subst l
  subst u
  subst f
  exact ⟨hconcrete.trans habstract⟩

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Recovery of abstract label orders. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Casting a finite rank along an equality of sizes does not change
its numerical value. This is the only fact required to work with the
constant codomain of `canonicalPacketOfPacketUniform`. -/
theorem packet_label_fin_cast_val {n m : ℕ} (h : n = m) (x : Fin n) :
    ((Equiv.cast (congrArg Fin h)) x).val = x.val := by
  cases h
  rfl

/-- The strict order of the positions inside a *fixed* gap is exactly
the strict order of their local ranks. -/
theorem packet_label_leaf_rank_same_gap_iff
    (m : ℕ → ℕ) (g p q : ℕ) :
    chainSlotLeafRank m g p < chainSlotLeafRank m g q ↔ p < q := by
  simp only [chainSlotLeafRank]
  omega

/-- Every valid leaf position in an earlier gap is below every
position in a later gap. -/
theorem packet_label_leaf_rank_cross_gap
    (m : ℕ → ℕ) (g h p q : ℕ)
    (hgh : g < h) (hp : p < m g) :
    chainSlotLeafRank m g p < chainSlotLeafRank m h q := by
  exact arithmeticGapLeaf_before_later_leaf m g h p q hgh hp

/-- The computed label of any abstract leaf, before the final cast,
is its gap-start plus its locally chosen position. -/
theorem packet_label_packet_leaf_value
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (v : SlotLeaf k l u f) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inr v)).val =
      chainSlotLeafRank (chainSlotNatOccupancy k
        (slotGapOccupancy k l u f a)) (a.1 v).val
          (o (a.1 v) ⟨v, rfl⟩).val := by
  rfl

theorem packet_label_packet_leaf_value_in_fiber
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (g : Fin (k + 1))
    (v : SlotGapFiber k l u f a g) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inr v.1)).val =
      chainSlotLeafRank
        (chainSlotNatOccupancy k (slotGapOccupancy k l u f a))
        g.val (o g v).val := by
  rcases v with ⟨v, hv⟩
  subst g
  exact packet_label_packet_leaf_value k l u f a o v

/-- Within one given gap, numerical labels are increasing exactly
when their internal `Fin` positions are increasing. -/
theorem packet_label_packet_same_gap_lt_iff
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (g : Fin (k + 1))
    (v w : SlotGapFiber k l u f a g) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inr v.1)).val <
        ((canonicalPacketOfPacket k l u f a o) (Sum.inr w.1)).val ↔
      (o g v).val < (o g w).val := by
  rw [packet_label_packet_leaf_value_in_fiber k l u f a o g v,
      packet_label_packet_leaf_value_in_fiber k l u f a o g w]
  exact packet_label_leaf_rank_same_gap_iff
    (chainSlotNatOccupancy k (slotGapOccupancy k l u f a))
    g.val (o g v).val (o g w).val

/-- All leaves of a smaller gap precede all leaves in a larger gap.
This proof also handles zero occupancy in intervening gaps. -/
theorem packet_label_packet_cross_gap_lt
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (g h : Fin (k + 1)) (hgh : g < h)
    (v : SlotGapFiber k l u f a g)
    (w : SlotGapFiber k l u f a h) :
    ((canonicalPacketOfPacket k l u f a o) (Sum.inr v.1)).val <
        ((canonicalPacketOfPacket k l u f a o) (Sum.inr w.1)).val := by
  have hp : (o g v).val <
      chainSlotNatOccupancy k
        (slotGapOccupancy k l u f a) g.val := by
    simpa only [chainSlotNatOccupancy_fin] using (o g v).isLt
  rw [packet_label_packet_leaf_value_in_fiber k l u f a o g v,
      packet_label_packet_leaf_value_in_fiber k l u f a o h w]
  exact packet_label_leaf_rank_cross_gap
    (chainSlotNatOccupancy k (slotGapOccupancy k l u f a))
    g.val h.val (o g v).val (o h w).val hgh hp

/-- The numerical comparison inside each packet gap determines
exactly the chosen order equivalence.  This is the critical remaining
algebraic ingredient for Encoder(Decoder(packet))=packet. -/
theorem packet_label_sorted_orders_of_packet_eq
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (g : Fin (k + 1)) :
    packetSortedOrdersFromLabeling k l u f _
      (canonicalPacketOfPacket k l u f a o) a g = o g := by
  classical
  let α := SlotGapFiber k l u f a g
  let σ := canonicalPacketOfPacket k l u f a o
  have hinj : Function.Injective
      (fun v : α => (σ (Sum.inr v.1)).val) := by
    intro v w hvw
    apply Subtype.ext
    have heq : σ (Sum.inr v.1) = σ (Sum.inr w.1) :=
      Fin.ext hvw
    exact Sum.inr.inj (σ.injective heq)
  let instOrd : LinearOrder α :=
    LinearOrder.lift'
      (fun v : α => (σ (Sum.inr v.1)).val) hinj
  let : LE α := instOrd.toLE
  let : LT α := instOrd.toLT
  let : Preorder α := instOrd.toPreorder
  have hmono : StrictMono (o g) := by
    intro v w hvw
    have hlabel :
        (σ (Sum.inr v.1)).val <
          (σ (Sum.inr w.1)).val := by
      change (σ (Sum.inr v.1)).val <
        (σ (Sum.inr w.1)).val at hvw
      exact hvw
    exact
      (packet_label_packet_same_gap_lt_iff k l u f a o g v w).mp hlabel
  have huniq :
      o g =
        (Fintype.orderIsoFinOfCardEq α
          (card_slotGapFiber k l u f a g)).symm.toEquiv :=
    ordered_packet_sorted_equiv_unique
      (card_slotGapFiber k l u f a g) (o g) hmono
  calc
    packetSortedOrdersFromLabeling k l u f _ σ a g =
        (Fintype.orderIsoFinOfCardEq α
          (card_slotGapFiber k l u f a g)).symm.toEquiv := by
          rfl
    _ = o g := huniq.symm


end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Inverse equivalence from order comparisons. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Root labels of a valid abstract permutation are ordered precisely
in reverse order of their root indices. -/
theorem packet_label_strictAnti_lt_iff {k : ℕ}
    (roots : Fin k → ℕ) (hanti : StrictAnti roots)
    (i j : Fin k) :
    roots i < roots j ↔ j < i := by
  constructor
  · intro h
    by_contra hn
    have hij : i ≤ j := le_of_not_gt hn
    rcases eq_or_lt_of_le hij with heq | hlt
    · subst j
      exact (lt_irrefl (roots i)) h
    · exact (lt_asymm h (hanti hlt)).elim
  · intro hji
    exact hanti hji

/-- In an arbitrary VALID abstract labeling, the comparison of a leaf
with root `i` is completely determined by the encoded gap number. -/
theorem packet_label_valid_leaf_lt_root_iff_gap
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (hvalid : CanonicalPacketValid k l u f n σ)
    (v : SlotLeaf k l u f) (i : Fin k) :
    (σ (Sum.inr v)).val < (σ (Sum.inl i)).val ↔
      ((canonicalPacketAllowedSlotAssignment k l u f n σ hvalid).1 v).val <
        k - i.val := by
  classical
  change (σ (Sum.inr v)).val < (σ (Sum.inl i)).val ↔
    (Finset.univ.filter (fun j : Fin k =>
      (σ (Sum.inl j)).val < (σ (Sum.inr v)).val)).card < k - i.val
  exact (root_gap_root_gap_lt_iff
    (fun j : Fin k => (σ (Sum.inl j)).val)
    hvalid.1 (σ (Sum.inr v)).val
    (fun j => canonicalPacketLeaf_ne_root k l u f n σ v j) i).symm

/-- The complementary comparison is determined by the same gap. -/
theorem packet_label_valid_root_lt_leaf_iff_gap
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (hvalid : CanonicalPacketValid k l u f n σ)
    (v : SlotLeaf k l u f) (i : Fin k) :
    (σ (Sum.inl i)).val < (σ (Sum.inr v)).val ↔
      k - i.val ≤
        ((canonicalPacketAllowedSlotAssignment k l u f n σ hvalid).1 v).val := by
  classical
  change (σ (Sum.inl i)).val < (σ (Sum.inr v)).val ↔
    k - i.val ≤ (Finset.univ.filter (fun j : Fin k =>
      (σ (Sum.inl j)).val < (σ (Sum.inr v)).val)).card
  exact (root_gap_root_gap_ge_iff
    (fun j : Fin k => (σ (Sum.inl j)).val)
    hvalid.1 (σ (Sum.inr v)).val
    (fun j => canonicalPacketLeaf_ne_root k l u f n σ v j) i).symm

/-- Inverse property (construction): decode a packet, then encode it.
The assignment is recovered by `root_gap_allowed_of_packet_eq` and each
internal order by `packet_label_sorted_orders_of_packet_eq` above. -/
theorem packet_label_packet_encode_decode
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    canonicalPacketEncode k l u f _
      (canonicalPacketOfPacket k l u f a o)
      (canonicalPacketOfPacket_valid k l u f a o) =
      (⟨a, o⟩ : SlotGapPackets k l u f) := by
  classical
  let σ := canonicalPacketOfPacket k l u f a o
  let hv := canonicalPacketOfPacket_valid k l u f a o
  have ha :
      canonicalPacketAllowedSlotAssignment k l u f _ σ hv = a :=
    root_gap_allowed_of_packet_eq k l u f a o
  have ho :
      packetSortedOrdersFromLabeling k l u f _ σ a = o := by
    funext g
    exact packet_label_sorted_orders_of_packet_eq k l u f a o g
  calc
    canonicalPacketEncode k l u f _ σ hv =
        (⟨a, packetSortedOrdersFromLabeling k l u f _ σ a⟩ :
          SlotGapPackets k l u f) :=
      congrArg
        (fun b : AllowedSlotAssignment k l u f =>
          (⟨b, packetSortedOrdersFromLabeling k l u f _ σ b⟩ :
            SlotGapPackets k l u f)) ha
    _ = (⟨a, o⟩ : SlotGapPackets k l u f) :=
      congrArg
        (fun p : SlotGapOrders k l u f a =>
          (⟨a, p⟩ : SlotGapPackets k l u f)) ho


end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Rigidity of abstract label comparisons. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- An equivalence on a disjoint union is determined by its four
families of pairwise strict comparisons. -/
theorem packet_label_sum_equiv_eq_of_comparisons
    {α β : Type*} {n : ℕ} (σ τ : (α ⊕ β) ≃ Fin n)
    (hRR : ∀ i j : α,
      σ (Sum.inl i) < σ (Sum.inl j) ↔
      τ (Sum.inl i) < τ (Sum.inl j))
    (hRL : ∀ i : α, ∀ v : β,
      σ (Sum.inl i) < σ (Sum.inr v) ↔
      τ (Sum.inl i) < τ (Sum.inr v))
    (hLR : ∀ v : β, ∀ i : α,
      σ (Sum.inr v) < σ (Sum.inl i) ↔
      τ (Sum.inr v) < τ (Sum.inl i))
    (hLL : ∀ v w : β,
      σ (Sum.inr v) < σ (Sum.inr w) ↔
      τ (Sum.inr v) < τ (Sum.inr w)) : σ = τ := by
  apply ordered_packet_equiv_eq_of_same_strict_order
  intro x y
  cases x with
  | inl i =>
    cases y with
    | inl j => exact hRR i j
    | inr w => exact hRL i w
  | inr v =>
    cases y with
    | inl j => exact hLR v j
    | inr w => exact hLL v w

/-- Every two valid labelings give the same root/root comparisons,
since root labels are strictly decreasing in block order. -/
theorem packet_label_abstract_root_order_agree
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ τ : CanonicalPacketCells k l u f ≃ Fin n)
    (hσ : CanonicalPacketValid k l u f n σ)
    (hτ : CanonicalPacketValid k l u f n τ)
    (i j : Fin k) :
    σ (Sum.inl i) < σ (Sum.inl j) ↔
      τ (Sum.inl i) < τ (Sum.inl j) := by
  exact (packet_label_strictAnti_lt_iff
    (fun i : Fin k => (σ (Sum.inl i)).val) hσ.1 i j).trans
    ((packet_label_strictAnti_lt_iff
      (fun i : Fin k => (τ (Sum.inl i)).val) hτ.1 i j).symm)

/-- Matching encoded gap numbers imply matching leaf/root comparisons.
This is purely abstract and works for any two valid permutations. -/
theorem packet_label_abstract_leaf_root_order_agree
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ τ : CanonicalPacketCells k l u f ≃ Fin n)
    (hσ : CanonicalPacketValid k l u f n σ)
    (hτ : CanonicalPacketValid k l u f n τ)
    (hg : ∀ v : SlotLeaf k l u f,
      canonicalPacketGap k l u f n σ v =
        canonicalPacketGap k l u f n τ v)
    (v : SlotLeaf k l u f) (i : Fin k) :
    σ (Sum.inr v) < σ (Sum.inl i) ↔
      τ (Sum.inr v) < τ (Sum.inl i) := by
  have hs := packet_label_valid_leaf_lt_root_iff_gap k l u f n σ hσ v i
  have ht := packet_label_valid_leaf_lt_root_iff_gap k l u f n τ hτ v i
  change (σ (Sum.inr v)).val < (σ (Sum.inl i)).val ↔
    (canonicalPacketGap k l u f n σ v).val < k - i.val at hs
  change (τ (Sum.inr v)).val < (τ (Sum.inl i)).val ↔
    (canonicalPacketGap k l u f n τ v).val < k - i.val at ht
  rw [hg v] at hs
  exact hs.trans ht.symm

/-- Matching gaps give matching root/leaf comparisons as well. -/
theorem packet_label_abstract_root_leaf_order_agree
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ τ : CanonicalPacketCells k l u f ≃ Fin n)
    (hσ : CanonicalPacketValid k l u f n σ)
    (hτ : CanonicalPacketValid k l u f n τ)
    (hg : ∀ v : SlotLeaf k l u f,
      canonicalPacketGap k l u f n σ v =
        canonicalPacketGap k l u f n τ v)
    (i : Fin k) (v : SlotLeaf k l u f) :
    σ (Sum.inl i) < σ (Sum.inr v) ↔
      τ (Sum.inl i) < τ (Sum.inr v) := by
  have hs := packet_label_valid_root_lt_leaf_iff_gap k l u f n σ hσ v i
  have ht := packet_label_valid_root_lt_leaf_iff_gap k l u f n τ hτ v i
  change (σ (Sum.inl i)).val < (σ (Sum.inr v)).val ↔
    k - i.val ≤ (canonicalPacketGap k l u f n σ v).val at hs
  change (τ (Sum.inl i)).val < (τ (Sum.inr v)).val ↔
    k - i.val ≤ (canonicalPacketGap k l u f n τ v).val at ht
  rw [hg v] at hs
  exact hs.trans ht.symm

/-- SECOND INVERSE REDUCTION: proof of equality of labels once
1) their gap numbers match and 2) the within-leaf order is preserved.
The latter is the one remaining comparison family to be assembled from
`SlotGapOrders` and `packet_label_packet_same_gap_lt_iff`. -/
theorem packet_label_abstract_labelings_equal_of_gap_and_leaf_order
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ τ : CanonicalPacketCells k l u f ≃ Fin n)
    (hσ : CanonicalPacketValid k l u f n σ)
    (hτ : CanonicalPacketValid k l u f n τ)
    (hg : ∀ v : SlotLeaf k l u f,
      canonicalPacketGap k l u f n σ v =
        canonicalPacketGap k l u f n τ v)
    (hLL : ∀ v w : SlotLeaf k l u f,
      σ (Sum.inr v) < σ (Sum.inr w) ↔
      τ (Sum.inr v) < τ (Sum.inr w)) : σ = τ := by
  apply packet_label_sum_equiv_eq_of_comparisons σ τ
  · exact packet_label_abstract_root_order_agree k l u f n σ τ hσ hτ
  · exact packet_label_abstract_root_leaf_order_agree k l u f n σ τ hσ hτ hg
  · exact packet_label_abstract_leaf_root_order_agree k l u f n σ τ hσ hτ hg
  · exact hLL

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Leaf-label comparisons under packet encoding. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- When the leaves of a given fiber are sorted by a bijective labeling,
their `Fin` positions are ordered exactly like their labels. -/
theorem packet_label_sorted_orders_preserves_label_lt
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (a : AllowedSlotAssignment k l u f)
    (g : Fin (k + 1))
    (v w : SlotGapFiber k l u f a g) :
    (σ (Sum.inr v.1)).val < (σ (Sum.inr w.1)).val ↔
      ((packetSortedOrdersFromLabeling k l u f n σ a g) v).val <
      ((packetSortedOrdersFromLabeling k l u f n σ a g) w).val := by
  classical
  let α := SlotGapFiber k l u f a g
  have hinj : Function.Injective
      (fun q : α => (σ (Sum.inr q.1)).val) := by
    intro x y h
    apply Subtype.ext
    exact Sum.inr.inj (σ.injective (Fin.ext h))
  let instOrd : LinearOrder α :=
    LinearOrder.lift'
      (fun q : α => (σ (Sum.inr q.1)).val) hinj
  let instLE : LE α := instOrd.toLE
  let instLT : LT α := instOrd.toLT
  let instLE' : LE α := instOrd.toLE
  let instLT' : LT α := instOrd.toLT
  let instPreorder : Preorder α := instOrd.toPreorder
  change (v < w) ↔
    ((Fintype.orderIsoFinOfCardEq α
      (card_slotGapFiber k l u f a g)).symm v) <
    ((Fintype.orderIsoFinOfCardEq α
      (card_slotGapFiber k l u f a g)).symm w)
  exact (Fintype.orderIsoFinOfCardEq α
    (card_slotGapFiber k l u f a g)).symm.lt_iff_lt.symm

/-- The order on abstract leaves is preserved by packing an arbitrary
valid labeling and decoding it before the uniform Fin-size cast. -/
theorem packet_label_leaf_order_after_packetization
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n)
    (hvalid : CanonicalPacketValid k l u f n σ)
    (v w : SlotLeaf k l u f) :
    (σ (Sum.inr v)).val < (σ (Sum.inr w)).val ↔
      ((canonicalPacketOfPacket k l u f
        (canonicalPacketAllowedSlotAssignment k l u f n σ hvalid)
        (packetSortedOrdersFromLabeling k l u f n σ
          (canonicalPacketAllowedSlotAssignment k l u f n σ hvalid)))
          (Sum.inr v)).val <
      ((canonicalPacketOfPacket k l u f
        (canonicalPacketAllowedSlotAssignment k l u f n σ hvalid)
        (packetSortedOrdersFromLabeling k l u f n σ
          (canonicalPacketAllowedSlotAssignment k l u f n σ hvalid)))
          (Sum.inr w)).val := by
  classical
  let a := canonicalPacketAllowedSlotAssignment k l u f n σ hvalid
  let o := packetSortedOrdersFromLabeling k l u f n σ a
  let gv := a.1 v
  let gw := a.1 w
  rcases lt_trichotomy gv gw with hlt | heq | hgt
  · have hσ := ordered_packet_abstract_leaf_lt_of_gap_lt k l u f n σ
      (show (canonicalPacketGap k l u f n σ v).val <
         (canonicalPacketGap k l u f n σ w).val from hlt)
    have hτ := packet_label_packet_cross_gap_lt k l u f a o gv gw hlt
      ⟨v, rfl⟩ ⟨w, rfl⟩
    exact ⟨fun _ => hτ, fun _ => hσ⟩
  · have hw : a.1 w = gv := heq.symm
    have hσ := packet_label_sorted_orders_preserves_label_lt k l u f n σ a gv
      (⟨v, rfl⟩ : SlotGapFiber k l u f a gv)
      (⟨w, hw⟩ : SlotGapFiber k l u f a gv)
    have hτ := packet_label_packet_same_gap_lt_iff k l u f a o gv
      (⟨v, rfl⟩ : SlotGapFiber k l u f a gv)
      (⟨w, hw⟩ : SlotGapFiber k l u f a gv)
    exact hσ.trans hτ.symm
  · have hσ := ordered_packet_abstract_leaf_lt_of_gap_lt k l u f n σ
      (show (canonicalPacketGap k l u f n σ w).val <
         (canonicalPacketGap k l u f n σ v).val from hgt)
    have hτ := packet_label_packet_cross_gap_lt k l u f a o gw gv hgt
      ⟨w, rfl⟩ ⟨v, rfl⟩
    constructor
    · intro hvw
      exact (lt_asymm hvw hσ).elim
    · intro hvw
      exact (lt_asymm hvw hτ).elim

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Inverse transport for packet decoding. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Passing from the packet-specific Fin size to the universally
fixed Fin size does not modify any numerical rank. -/
theorem packet_label_uniform_packet_value
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (c : CanonicalPacketCells k l u f) :
    ((canonicalPacketOfPacketUniform k l u f a o) c).val =
      ((canonicalPacketOfPacket k l u f a o) c).val := by
  classical
  let m : Fin (k + 1) → ℕ := slotGapOccupancy k l u f a
  have hN : k + (∑ g : Fin (k + 1), m g) =
      k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f := by
    rw [show (∑ g : Fin (k + 1), m g) =
      (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f from
        sum_slotGapOccupancy k l u f a]
    omega
  change ((Equiv.cast (congrArg Fin hN))
      ((canonicalPacketOfPacket k l u f a o) c)).val =
      ((canonicalPacketOfPacket k l u f a o) c).val
  exact packet_label_fin_cast_val hN _

/-- Admissibility also survives the final rank cast. -/
theorem packet_label_uniform_packet_valid
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    CanonicalPacketValid k l u f _
      (canonicalPacketOfPacketUniform k l u f a o) := by
  have hv := canonicalPacketOfPacket_valid k l u f a o
  constructor
  · intro i j hij
    simpa only [packet_label_uniform_packet_value] using hv.1 hij
  constructor
  · intro i p
    simpa only [packet_label_uniform_packet_value] using hv.2.1 i p
  · intro i p
    simpa only [packet_label_uniform_packet_value] using hv.2.2 i p

/-- Every gap is unchanged by the uniform-size cast. -/
theorem packet_label_uniform_gap_eq
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (v : SlotLeaf k l u f) :
    canonicalPacketGap k l u f _
      (canonicalPacketOfPacketUniform k l u f a o) v = a.1 v := by
  have h := root_gap_gap_of_packet_eq k l u f a o v
  apply Fin.ext
  simpa only [canonicalPacketGap, packet_label_uniform_packet_value] using
    congrArg Fin.val h

/-- Inverse property (construction). For a valid abstract labeling,
packing and then unpacking restores the SAME bijective labeling.
Root/root, root/leaf, leaf/root and leaf/leaf comparisons are all
accounted for by earlier separately named lemmas. -/
theorem packet_label_abstract_decode_encode
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (σ : CanonicalPacketCells k l u f ≃
      Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f))
    (hvalid : CanonicalPacketValid k l u f _ σ) :
    canonicalPacketOfPacketUniform k l u f
      (canonicalPacketEncode k l u f _ σ hvalid).1
      (canonicalPacketEncode k l u f _ σ hvalid).2 = σ := by
  classical
  let a := canonicalPacketAllowedSlotAssignment k l u f _ σ hvalid
  let o := packetSortedOrdersFromLabeling k l u f _ σ a
  let τ := canonicalPacketOfPacketUniform k l u f a o
  have hτvalid : CanonicalPacketValid k l u f _ τ :=
    packet_label_uniform_packet_valid k l u f a o
  have hg : ∀ v : SlotLeaf k l u f,
      canonicalPacketGap k l u f _ σ v = canonicalPacketGap k l u f _ τ v := by
    intro v
    have hr := packet_label_uniform_gap_eq k l u f a o v
    rw [hr]
    rfl
  have hLL : ∀ v w : SlotLeaf k l u f,
      σ (Sum.inr v) < σ (Sum.inr w) ↔
      τ (Sum.inr v) < τ (Sum.inr w) := by
    intro v w
    have hv := packet_label_leaf_order_after_packetization k l u f _ σ
      hvalid v w
    -- Compare Fin labels through their numerical values.
    change (σ (Sum.inr v)).val < (σ (Sum.inr w)).val ↔
      (τ (Sum.inr v)).val < (τ (Sum.inr w)).val
    simpa only [τ, packet_label_uniform_packet_value] using hv
  exact (packet_label_abstract_labelings_equal_of_gap_and_leaf_order
    k l u f _ σ τ hvalid hτvalid hg hLL).symm

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Transport of finite bijective labelings. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The abstract finite labeling type for the actual block shape. -/
abbrev AbstractChainLabeling {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) :=
  CanonicalPacketCells k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card ≃
    Fin (k +
      (∑ i : Fin k, (rowCount (chainBlock C i) - 1)) +
      (∑ i : Fin k, (columnCount (chainBlock C i) - 1)) +
      (chainFreeCells C).card)

/-- One and the same cardinality cast is used in both directions. -/
private noncomputable def chainLabelingsCardinalityEquiv
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) :
    Fin (Fintype.card (ShapeCell D)) ≃
      Fin (k +
        (∑ i : Fin k, (rowCount (chainBlock C i) - 1)) +
        (∑ i : Fin k, (columnCount (chainBlock C i) - 1)) +
        (chainFreeCells C).card) := by
  exact Equiv.cast
    (congrArg Fin (chainCell_card_from_slots C))

/-- The whole-domain geometric relabeling uses a shared Fin cast. -/
noncomputable def chainLabelingToAbstract {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) : AbstractChainLabeling C :=
  ((chainSlotChainCellRootLeafEquiv C).symm.trans σ).trans
    (chainLabelingsCardinalityEquiv C)

/-- Converse using the inverse of precisely the same cast. -/
noncomputable def chainLabelingFromAbstract {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k)
    (τ : AbstractChainLabeling C) : StandardLabeling D :=
  ((chainSlotChainCellRootLeafEquiv C).trans τ).trans
    (chainLabelingsCardinalityEquiv C).symm

/-- The concrete labeling is restored exactly. -/
theorem chainLabelingDecodeEncode {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D) :
    chainLabelingFromAbstract C (chainLabelingToAbstract C σ) = σ := by
  ext c
  simp [chainLabelingToAbstract, chainLabelingFromAbstract,
    Equiv.trans_apply, Equiv.symm_apply_apply]

/-- The abstract labeling is restored exactly. -/
theorem chainLabelingEncodeDecode {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (τ : AbstractChainLabeling C) :
    chainLabelingToAbstract C (chainLabelingFromAbstract C τ) = τ := by
  ext c
  simp [chainLabelingToAbstract, chainLabelingFromAbstract,
    Equiv.trans_apply, Equiv.apply_symm_apply]

/-- Genuine finite equivalence of all concrete and abstract labelings.
No compatibility condition is used in its construction. -/
noncomputable def chainLabelingsEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    StandardLabeling D ≃ AbstractChainLabeling C :=
  { toFun := chainLabelingToAbstract C
    invFun := chainLabelingFromAbstract C
    left_inv := chainLabelingDecodeEncode C
    right_inv := chainLabelingEncodeDecode C }

/-- Compatibility transport property for chain labelings. -/
def ChainCompatibilityTransport {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) : Prop :=
  ∀ σ : StandardLabeling D,
    σ ∈ chainCompatibleStandardLabelings C ↔
      CanonicalPacketValid k
        (fun i => rowCount (chainBlock C i) - 1)
        (fun i => columnCount (chainBlock C i) - 1)
        (chainFreeCells C).card _ (chainLabelingToAbstract C σ)

/-- A CONDITIONAL transport of the compatible finite types. The only
hypothesis is the explicit shape/boundary statement above. -/
noncomputable def compatibleChainLabelingsEquiv
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (htransport : ChainCompatibilityTransport C) :
    ChainCompatibleLabelingType C ≃
      {τ : AbstractChainLabeling C //
        CanonicalPacketValid k
          (fun i => rowCount (chainBlock C i) - 1)
          (fun i => columnCount (chainBlock C i) - 1)
          (chainFreeCells C).card _ τ} := by
  refine
    { toFun := fun σ => ⟨chainLabelingToAbstract C σ.1,
        (htransport σ.1).mp σ.2⟩
      invFun := fun τ =>
        ⟨chainLabelingFromAbstract C τ.1,
          (htransport (chainLabelingFromAbstract C τ.1)).mpr (by
            simpa only [chainLabelingEncodeDecode] using τ.2)⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro σ
    apply Subtype.ext
    exact chainLabelingDecodeEncode C σ.1
  · intro τ
    apply Subtype.ext
    exact chainLabelingEncodeDecode C τ.1

/-- The completed *abstract* bijection and preservation of geometric
conditions would now suffice for the desired exact count. This theorem
records the boundary without treating either assumption as established. -/
theorem packet_label_geometric_identity_from_bridges
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (htransport : ChainCompatibilityTransport C)
    (habstract : CanonicalPacketEquivalence k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card) :
    GeometricSlotIdentity C := by
  rcases habstract with ⟨e⟩
  exact geometric_slot_identity_of_packet_equiv C
    ((compatibleChainLabelingsEquiv C htransport).trans e)

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Abstract packet equivalence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- In the uniform codomain, the original enumeration of every gap is
still the increasing order of the leaf labels; the final cast cannot
change strict order because it leaves the numerical rank unchanged. -/
theorem packet_transport_sorted_orders_of_uniform_packet_eq
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a)
    (g : Fin (k + 1)) :
    packetSortedOrdersFromLabeling k l u f _
      (canonicalPacketOfPacketUniform k l u f a o) a g = o g := by
  classical
  let σ := canonicalPacketOfPacketUniform k l u f a o
  apply ordered_packet_equiv_eq_of_same_strict_order
  intro v w
  have hsorted :=
    packet_label_sorted_orders_preserves_label_lt
      k l u f _ σ a g v w
  have hcmp :
      (σ (Sum.inr v.1)).val <
        (σ (Sum.inr w.1)).val ↔
      (o g v).val < (o g w).val := by
    rw [
      packet_label_uniform_packet_value k l u f a o (Sum.inr v.1),
      packet_label_uniform_packet_value k l u f a o (Sum.inr w.1)
    ]
    exact packet_label_packet_same_gap_lt_iff k l u f a o g v w
  change
    ((packetSortedOrdersFromLabeling k l u f _ σ a g) v).val <
      ((packetSortedOrdersFromLabeling k l u f _ σ a g) w).val ↔
    (o g v).val < (o g w).val
  exact hsorted.symm.trans hcmp

/-- First inverse with a fixed target type Fin N: packet -> labeling
-> packet. Unlike the earlier version, no type index depends on a. -/
theorem packet_transport_uniform_packet_encode_decode
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : AllowedSlotAssignment k l u f)
    (o : SlotGapOrders k l u f a) :
    canonicalPacketEncode k l u f _
      (canonicalPacketOfPacketUniform k l u f a o)
      (packet_label_uniform_packet_valid k l u f a o) =
        (⟨a, o⟩ : SlotGapPackets k l u f) := by
  classical
  let σ := canonicalPacketOfPacketUniform k l u f a o
  let hv : CanonicalPacketValid k l u f _ σ :=
    packet_label_uniform_packet_valid k l u f a o
  let b : AllowedSlotAssignment k l u f :=
    canonicalPacketAllowedSlotAssignment k l u f _ σ hv
  let F : (b : AllowedSlotAssignment k l u f) →
      SlotGapOrders k l u f b :=
    fun b => packetSortedOrdersFromLabeling k l u f _ σ b
  have ha : b = a := by
    apply Subtype.ext
    funext v
    exact packet_label_uniform_gap_eq k l u f a o v
  have ho : F a = o := by
    funext g
    exact packet_transport_sorted_orders_of_uniform_packet_eq k l u f a o g
  change (⟨b, F b⟩ : SlotGapPackets k l u f) =
    (⟨a, o⟩ : SlotGapPackets k l u f)
  calc
    (⟨b, F b⟩ : SlotGapPackets k l u f) =
        (⟨a, F a⟩ : SlotGapPackets k l u f) := by
      exact congrArg
        (fun x : AllowedSlotAssignment k l u f =>
          (⟨x, F x⟩ : SlotGapPackets k l u f)) ha
    _ = (⟨a, o⟩ : SlotGapPackets k l u f) := by
      exact congrArg
        (fun q : SlotGapOrders k l u f a =>
          (⟨a, q⟩ : SlotGapPackets k l u f)) ho

/-- The abstract bijection. Its inverse laws are the
written second inverse and the new uniform first inverse above. -/
noncomputable def uniformPacketEquiv
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    {σ : CanonicalPacketCells k l u f ≃
        Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) //
        CanonicalPacketValid k l u f _ σ} ≃
      SlotGapPackets k l u f := by
  classical
  refine
    { toFun := fun σ =>
        canonicalPacketEncode k l u f _ σ.1 σ.2
      invFun := fun p =>
        ⟨canonicalPacketOfPacketUniform k l u f p.1 p.2,
          packet_label_uniform_packet_valid k l u f p.1 p.2⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro σ
    apply Subtype.ext
    exact packet_label_abstract_decode_encode k l u f σ.1 σ.2
  · rintro ⟨a, o⟩
    exact packet_transport_uniform_packet_encode_decode k l u f a o

/-- The existential proposition of the previous development is now
reduced to the explicit abstract bijection above, with no extra premise. -/
theorem packet_transport_abstract_packet_equivalence
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    CanonicalPacketEquivalence k l u f := by
  exact ⟨uniformPacketEquiv k l u f⟩

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — geometric transport of the finite abstract packet bijection. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Casting the codomain of the concrete labeling to the abstract cardinal
leaves all numerical values unchanged. -/
theorem packet_transport_chain_abstract_value
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (v : ChainCellPacketDomain C) :
    ((chainLabelingToAbstract C σ) v).val =
      labelingOf D σ ((chainSlotChainCellRootLeafEquiv C).symm v).1 := by
  classical
  let c : ShapeCell D :=
    (chainSlotChainCellRootLeafEquiv C).symm v
  have hcast :
      ((chainLabelingsCardinalityEquiv C) (σ c)).val = (σ c).val := by
    unfold chainLabelingsCardinalityEquiv
    exact packet_label_fin_cast_val
      (chainCell_card_from_slots C) (σ c)
  have hlabel :
      labelingOf D σ c.1 = (σ c).val := by
    simp [labelingOf]
  calc
    ((chainLabelingToAbstract C σ) v).val =
        ((chainLabelingsCardinalityEquiv C) (σ c)).val := by
      rfl
    _ = (σ c).val := hcast
    _ = labelingOf D σ c.1 := hlabel.symm

/-- Every tagged root is exactly its concrete chain anchor. -/
theorem packet_transport_classifier_anchor
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    (chainSlotChainCellRootLeafEquiv C).symm (Sum.inl i) =
      chainAnchorAsCell C i := by
  classical
  have hr : chainAnchorAsCell C i ∈ chainAnchorCells C := by
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩
  have hclass :
      (chainSlotChainCellRootLeafEquiv C) (chainAnchorAsCell C i) =
        Sum.inl i := by
    change chainSlotChainCellClassify C (chainAnchorAsCell C i) = _
    simp [chainSlotChainCellClassify, hr, chainBlockIndex_anchor]
  calc
    (chainSlotChainCellRootLeafEquiv C).symm (Sum.inl i) =
      (chainSlotChainCellRootLeafEquiv C).symm
        ((chainSlotChainCellRootLeafEquiv C) (chainAnchorAsCell C i)) := by
          rw [hclass]
    _ = chainAnchorAsCell C i := Equiv.symm_apply_apply _ _

/-- Recover the true cell from a tagged left leaf. -/
theorem packet_transport_classifier_left
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k)
    (p : Fin (rowCount (chainBlock C i) - 1)) :
    (chainSlotChainCellRootLeafEquiv C).symm
        (Sum.inr (Sum.inl ⟨i, p⟩)) =
      chainLiftLeft C i ((chainLeftFiberFinEquiv C i).symm p) := by
  classical
  let c := (chainLeftFiberFinEquiv C i).symm p
  have hn := chainLiftLeft_not_root C i c
  have hslot :
      (chainNonrootSlotEquiv C)
        (chainConcreteLeafToNonroot C (Sum.inl ⟨i, c⟩)) =
      Sum.inl ⟨i, p⟩ := by
    change
      (chainConcreteSlotEquiv C)
        (chainNonrootToConcreteLeaf C
          (chainConcreteLeafToNonroot C (Sum.inl ⟨i, c⟩))) =
      Sum.inl ⟨i, p⟩
    rw [chainConcreteLeafToNonroot_left_inv C]
    change
      (Sum.inl ⟨i, (chainLeftFiberFinEquiv C i) c⟩ :
        SlotLeaf k
          (fun j => rowCount (chainBlock C j) - 1)
          (fun j => columnCount (chainBlock C j) - 1)
          (chainFreeCells C).card) =
      Sum.inl ⟨i, p⟩
    simp only [c, Equiv.apply_symm_apply]
  have hclass :
      (chainSlotChainCellRootLeafEquiv C) (chainLiftLeft C i c) =
        Sum.inr (Sum.inl ⟨i, p⟩) := by
    change chainSlotChainCellClassify C (chainLiftLeft C i c) = _
    unfold chainSlotChainCellClassify
    simp only [dite_eq_right hn]
    exact congrArg Sum.inr hslot
  calc
    (chainSlotChainCellRootLeafEquiv C).symm
        (Sum.inr (Sum.inl ⟨i, p⟩)) =
      (chainSlotChainCellRootLeafEquiv C).symm
        ((chainSlotChainCellRootLeafEquiv C)
          (chainLiftLeft C i c)) := by
        rw [hclass]
    _ = chainLiftLeft C i c := Equiv.symm_apply_apply _ _

/-- Every root label in abstract coordinates equals its concrete
southwest-anchor label, without changing the original labeling. -/
theorem packet_transport_root_value
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (i : Fin k) :
    ((chainLabelingToAbstract C σ) (Sum.inl i)).val =
      chainAnchorRootLabels C σ i := by
  rw [packet_transport_chain_abstract_value, packet_transport_classifier_anchor]
  rfl

/-- Recover the concrete left-boundary inequality from its abstract
coordinate, in both directions. -/
theorem packet_transport_left_value
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (i : Fin k) (p : Fin (rowCount (chainBlock C i) - 1)) :
    ((chainLabelingToAbstract C σ) (Sum.inr (Sum.inl ⟨i, p⟩))).val =
      labelingOf D σ ((chainLeftFiberFinEquiv C i).symm p).1 := by
  rw [packet_transport_chain_abstract_value, packet_transport_classifier_left]
  rfl

/-- Recover the concrete bottom-boundary inequality. -/
theorem packet_transport_classifier_bottom
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k)
    (p : Fin (columnCount (chainBlock C i) - 1)) :
    (chainSlotChainCellRootLeafEquiv C).symm
        (Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩))) =
      chainLiftBottom C i ((chainBottomFiberFinEquiv C i).symm p) := by
  classical
  let c := (chainBottomFiberFinEquiv C i).symm p
  have hn := chainLiftBottom_not_root C i c
  have hslot :
      (chainNonrootSlotEquiv C)
        (chainConcreteLeafToNonroot C
          (Sum.inr (Sum.inl ⟨i, c⟩))) =
      Sum.inr (Sum.inl ⟨i, p⟩) := by
    change
      (chainConcreteSlotEquiv C)
        ((chainNonrootToConcreteLeaf C)
          (chainConcreteLeafToNonroot C
            (Sum.inr (Sum.inl ⟨i, c⟩)))) =
      Sum.inr (Sum.inl ⟨i, p⟩)
    rw [chainConcreteLeafToNonroot_left_inv C]
    change
      (Sum.inr (Sum.inl
        ⟨i, (chainBottomFiberFinEquiv C i) c⟩) :
        SlotLeaf k
          (fun j => rowCount (chainBlock C j) - 1)
          (fun j => columnCount (chainBlock C j) - 1)
          (chainFreeCells C).card) =
      Sum.inr (Sum.inl ⟨i, p⟩)
    simp only [c, Equiv.apply_symm_apply]
  have hclass :
      (chainSlotChainCellRootLeafEquiv C) (chainLiftBottom C i c) =
        Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩)) := by
    change chainSlotChainCellClassify C (chainLiftBottom C i c) = _
    unfold chainSlotChainCellClassify
    simp only [dite_eq_right hn]
    exact congrArg Sum.inr hslot
  calc
    (chainSlotChainCellRootLeafEquiv C).symm
        (Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩))) =
      (chainSlotChainCellRootLeafEquiv C).symm
        ((chainSlotChainCellRootLeafEquiv C)
          (chainLiftBottom C i c)) := by
        rw [hclass]
    _ = chainLiftBottom C i c := Equiv.symm_apply_apply _ _

/-- Recover the concrete bottom-boundary inequality. -/
theorem packet_transport_bottom_value
    {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (i : Fin k) (p : Fin (columnCount (chainBlock C i) - 1)) :
    ((chainLabelingToAbstract C σ)
      (Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩)))).val =
      labelingOf D σ ((chainBottomFiberFinEquiv C i).symm p).1 := by
  rw [packet_transport_chain_abstract_value, packet_transport_classifier_bottom]
  rfl

/-- Restore an original block's boundary predicate from inequalities
on the two *counted* nonroot boundary sets. -/
theorem packet_transport_boundary_conditions_iff
    (B : Diagram) (root : Cell) (label : Cell → ℕ) :
    RootBoundaryConditions B root label ↔
      (∀ c ∈ nonrootLeftEnds B root, label c < label root) ∧
      (∀ c ∈ nonrootBottomEnds B root, label root < label c) := by
  classical
  constructor
  · exact labels_on_nonroot_ends
  · rintro ⟨hl, hb⟩
    constructor
    · intro c hc hne
      exact hl c (Finset.mem_erase.mpr
        ⟨hne, mem_leftEnds.mpr hc⟩)
    · intro c hc hne
      exact hb c (Finset.mem_erase.mpr
        ⟨hne, mem_bottomEnds.mpr hc⟩)

/-- The entire geometric condition is precisely the already-defined
abstract root/leaf condition, provided that D is a skew diagram.
No unproved hypothesis is introduced. -/
theorem packet_transport_compatibility_transport
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) : ChainCompatibilityTransport C := by
  classical
  intro σ
  rw [mem_chainCompatibleStandardLabelings_iff_anchor hsk C σ]
  -- The root labels and both finite classes of boundary leaves agree
  -- entrywise by the preceding three coordinate lemmas.
  constructor
  · intro hc
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      simpa only [packet_transport_root_value] using hc.1 hij
    · intro i p
      have hlocal := (packet_transport_boundary_conditions_iff
        (chainBlock C i) (chainBlockAnchor C i) (labelingOf D σ)).mp
        (hc.2.2 i)
      have hleaf := hlocal.1
        ((chainLeftFiberFinEquiv C i).symm p).1
        ((chainLeftFiberFinEquiv C i).symm p).2
      simpa [chainAnchorRootLabels, packet_transport_left_value, packet_transport_root_value]
        using hleaf
    · intro i p
      have hlocal := (packet_transport_boundary_conditions_iff
        (chainBlock C i) (chainBlockAnchor C i) (labelingOf D σ)).mp
        (hc.2.2 i)
      have hleaf := hlocal.2
        ((chainBottomFiberFinEquiv C i).symm p).1
        ((chainBottomFiberFinEquiv C i).symm p).2
      simpa [chainAnchorRootLabels, packet_transport_bottom_value, packet_transport_root_value]
        using hleaf
  · intro hv
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      simpa only [packet_transport_root_value] using hv.1 hij
    · intro i
      rfl
    · intro i
      apply (packet_transport_boundary_conditions_iff
        (chainBlock C i) (chainBlockAnchor C i) (labelingOf D σ)).mpr
      constructor
      · intro c hc
        let p := chainLeftFiberFinEquiv C i ⟨c, hc⟩
        have hleaf := hv.2.1 i p
        simpa [p, chainAnchorRootLabels, packet_transport_left_value, packet_transport_root_value,
          Equiv.symm_apply_apply] using hleaf
      · intro c hc
        let p := chainBottomFiberFinEquiv C i ⟨c, hc⟩
        have hleaf := hv.2.2 i p
        simpa [p, chainAnchorRootLabels, packet_transport_bottom_value, packet_transport_root_value,
          Equiv.symm_apply_apply] using hleaf

/-- The exact geometry-to-slot equality, obtained from a true finite
equivalence once the submitted construction compiles. -/
theorem packet_transport_geometric_identity
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) : GeometricSlotIdentity C := by
  exact packet_label_geometric_identity_from_bridges C
    (packet_transport_compatibility_transport hsk C)
    (packet_transport_abstract_packet_equivalence k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card)

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Deleting the maximal label. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The fixed-chain identity follows from the universal slot/integral
identity and the chain-labeling transport equivalence. -/
theorem packet_transport_fixed_chain_identity
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k)
    (huniv : UniversalSlotIdentity k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card) :
    FixedChainSlotIdentity C := by
  exact fixed_chain_slot_identity_of_bridges C
    (packet_transport_geometric_identity hsk C) huniv

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Deleting the maximal label. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A finite rank is strictly below the final rank precisely when it
is different from `Fin.last`. -/
theorem root_integral_fin_ne_last_iff_lt {n : ℕ} (v : Fin (n + 1)) :
    v ≠ Fin.last n ↔ v.val < n := by
  constructor
  · intro hv
    by_contra hge
    have htop : v = Fin.last n := Fin.ext (by simp; omega)
    exact hv htop
  · intro hv htop
    have := congrArg Fin.val htop
    simp at this
    omega

/-- Restrict a labeling whose distinguished cell has the highest rank.
The induced labeling of the remaining cells uses precisely ranks 0,...,n-1. -/
noncomputable def root_integral_eraseMaximum
    {α : Type*} (n : ℕ) (x : α)
    (σ : α ≃ Fin (n + 1)) (hx : σ x = Fin.last n) :
    {y : α // y ≠ x} ≃ Fin n := by
  classical
  let e := finSuccAboveEquiv (Fin.last n)
  let f : {y : α // y ≠ x} → Fin n := fun y =>
    e.symm ⟨σ y.1, by
      intro hy
      exact y.2 (σ.injective (hy.trans hx.symm))⟩
  have hi : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    apply σ.injective
    have he := e.symm.injective hab
    exact congrArg Subtype.val he
  have hs : Function.Surjective f := by
    intro z
    let y : α := σ.symm (e z).1
    have hy : y ≠ x := by
      intro heq
      have hz : (e z).1 = Fin.last n := by
        calc
          (e z).1 = σ y := by simp [y]
          _ = σ x := by rw [heq]
          _ = Fin.last n := hx
      exact (e z).2 hz
    refine ⟨⟨y, hy⟩, ?_⟩
    change e.symm (⟨σ y, _⟩ : {w : Fin (n + 1) // w ≠ Fin.last n}) = z
    have hval : σ y = (e z).1 := by simp [y]
    apply e.injective
    apply Subtype.ext
    simpa only [e.apply_symm_apply] using hval
  exact Equiv.ofBijective f ⟨hi, hs⟩

/-- Insert a new maximal cell into any bijection of the remaining set. -/
noncomputable def root_integral_insertMaximum
    {α : Type*} (n : ℕ) (x : α)
    (e : {y : α // y ≠ x} ≃ Fin n) :
    α ≃ Fin (n + 1) := by
  classical
  let f : α → Fin (n + 1) := fun y =>
    if hy : y = x then Fin.last n else (e ⟨y, hy⟩).castSucc
  have hinj : Function.Injective f := by
    intro y z h
    by_cases hy : y = x
    · by_cases hz : z = x
      · exact hy.trans hz.symm
      · have he : Fin.last n = (e ⟨z, hz⟩).castSucc := by
          simpa [f, hy, hz] using h
        have hh := congrArg Fin.val he
        have hv := (e ⟨z, hz⟩).isLt
        simp at hh
        omega
    · by_cases hz : z = x
      · have he : (e ⟨y, hy⟩).castSucc = Fin.last n := by
          simp [f, hy, hz] at h
        have hh := congrArg Fin.val he
        have hv := (e ⟨y, hy⟩).isLt
        simp at hh
        omega
      · have he : e ⟨y, hy⟩ = e ⟨z, hz⟩ := by
          apply Fin.ext
          have hh := congrArg Fin.val h
          simpa [f, hy, hz] using hh
        have hh := e.injective he
        exact congrArg Subtype.val hh
  have hsurj : Function.Surjective f := by
    intro v
    by_cases hv : v = Fin.last n
    · refine ⟨x, ?_⟩
      simp [f, hv]
    · have hlt : v.val < n :=
        (root_integral_fin_ne_last_iff_lt v).mp hv
      let z : Fin n := ⟨v.val, hlt⟩
      let y : α := (e.symm z).1
      have hy : y ≠ x := (e.symm z).2
      refine ⟨y, ?_⟩
      apply Fin.ext
      simp [f, hy, y, z, Equiv.apply_symm_apply]
  exact Equiv.ofBijective f ⟨hinj, hsurj⟩

/-- Removing and then reinserting the largest rank fixes the original
bijection. This is the actual content needed to reindex the Euler sum. -/
theorem root_integral_insert_erase_maximum
    {α : Type*} (n : ℕ) (x : α)
    (σ : α ≃ Fin (n + 1)) (hx : σ x = Fin.last n) :
    root_integral_insertMaximum n x
      (root_integral_eraseMaximum n x σ hx) = σ := by
  classical
  apply Equiv.ext
  intro y
  by_cases hy : y = x
  · subst y
    simpa [root_integral_insertMaximum] using hx.symm
  · have hval :
        (root_integral_eraseMaximum n x σ hx ⟨y, hy⟩).val =
          (σ y).val := by
      simp [root_integral_eraseMaximum,
        finSuccAboveEquiv_symm_apply_last]
    apply Fin.ext
    simpa [root_integral_insertMaximum, hy] using hval

/-- The distinguished maximum really has the largest numerical rank. -/
theorem root_integral_insertMaximum_top
    {α : Type*} (n : ℕ) (x : α)
    (e : {z : α // z ≠ x} ≃ Fin n) :
    root_integral_insertMaximum n x e x = Fin.last n := by
  classical
  simp [root_integral_insertMaximum]

/-- Reinsertion and subsequent deletion also fix every bijection of
the restricted cell type. -/
theorem root_integral_erase_insert_maximum
    {α : Type*} (n : ℕ) (x : α)
    (e : {y : α // y ≠ x} ≃ Fin n) :
    root_integral_eraseMaximum n x (root_integral_insertMaximum n x e)
      (root_integral_insertMaximum_top n x e) = e := by
  classical
  apply Equiv.ext
  intro y
  apply Fin.ext
  have hy := y.2
  -- A nonmaximal cell keeps the same rank on both sides.
  simp [root_integral_eraseMaximum, root_integral_insertMaximum, hy,
    finSuccAboveEquiv_symm_apply_last]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Maximum-label insertion and deletion. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A numerical rank is unchanged when its unique global maximum is
removed from a finite labeling. -/
theorem root_integral_eraseMaximum_val
    {α : Type*} (n : ℕ) (x : α)
    (σ : α ≃ Fin (n + 1)) (hx : σ x = Fin.last n)
    (y : {z : α // z ≠ x}) :
    (root_integral_eraseMaximum n x σ hx y).val = (σ y.1).val := by
  classical
  have hne : σ y.1 ≠ Fin.last n := by
    intro h
    exact y.2 (σ.injective (h.trans hx.symm))
  simp [root_integral_eraseMaximum,
    finSuccAboveEquiv_symm_apply_last]

/-- A nonmaximum point retains its numerical rank when a new global
maximum is inserted. -/
theorem root_integral_insertMaximum_val
    {α : Type*} (n : ℕ) (x : α)
    (e : {z : α // z ≠ x} ≃ Fin n)
    (y : {z : α // z ≠ x}) :
    (root_integral_insertMaximum n x e y.1).val = (e y).val := by
  classical
  simp [root_integral_insertMaximum, y.2]

/-- A valid labeling is a finite bijection respecting a family of
strict directed inequalities. No transitivity assumption is needed. -/
abbrev KahaneValidOrder
    (α : Type*) (R : α → α → Prop) (n : ℕ) :=
  {σ : α ≃ Fin n // ∀ a b, R a b → σ a < σ b}

/-- Finite enumeration of all bijective labelings satisfying the relation.
The injective map into the finite function space proves finiteness;
no assertion about existence of such labelings is made. -/
noncomputable instance (priority := 100) validRootOrderFintype
    {α : Type*} [Fintype α] (R : α → α → Prop) (n : ℕ) :
    Fintype (KahaneValidOrder α R n) := by
  classical
  letI : Finite (α ≃ Fin n) :=
    Finite.of_injective (fun e : α ≃ Fin n => (e : α → Fin n))
      (by
        intro e₁ e₂ h
        apply Equiv.ext
        intro x
        exact congrFun h x)
  exact Fintype.ofFinite _

/-- A low-priority decidability instance used only by the subsequent
    noncomputable finite enumeration of directed-inequality labelings. -/
noncomputable instance (priority := 10) decidableRootOrderRelation
    (p : Prop) : Decidable p := Classical.propDecidable p

/-- A possible maximum has no outgoing strict comparison constraints. -/
def KahaneMaximal {α : Type*} (R : α → α → Prop) (x : α) : Prop :=
  ∀ y : α, ¬ R x y

/-- Restrict a directed inequality relation to the complement of x. -/
def KahaneRemoveRelation {α : Type*} (R : α → α → Prop) (x : α) :
    {y : α // y ≠ x} → {y : α // y ≠ x} → Prop :=
  fun a b => R a.1 b.1

/-- A bijective valid labeling always places a maximal element at its
largest rank. If there are directed cycles, neither side exists. -/
theorem root_integral_maximum_must_be_maximal
    {α : Type*} (n : ℕ) (R : α → α → Prop)
    (σ : KahaneValidOrder α R (n + 1)) :
    KahaneMaximal R (σ.1.symm (Fin.last n)) := by
  intro y hxy
  have h := σ.2 (σ.1.symm (Fin.last n)) y hxy
  have hv := (σ.1 y).isLt
  have ht : (σ.1 (σ.1.symm (Fin.last n))).val = n := by simp
  omega

/-- Maximum deletion sends a valid full labeling to a valid reduced
labeling, preserving every strict comparison among the remaining cells. -/
noncomputable def root_integral_validEraseMaximum
    {α : Type*} (n : ℕ) (R : α → α → Prop)
    (σ : KahaneValidOrder α R (n + 1)) :
    KahaneValidOrder
      {y : α // y ≠ σ.1.symm (Fin.last n)}
      (KahaneRemoveRelation R (σ.1.symm (Fin.last n))) n := by
  classical
  let x : α := σ.1.symm (Fin.last n)
  have hx : σ.1 x = Fin.last n := σ.1.apply_symm_apply _
  refine ⟨root_integral_eraseMaximum n x σ.1 hx, ?_⟩
  intro a b hab
  have h := σ.2 a.1 b.1 hab
  have ha := root_integral_eraseMaximum_val n x σ.1 hx a
  have hb := root_integral_eraseMaximum_val n x σ.1 hx b
  exact Fin.lt_def.mpr (by omega)

/-- Insert a *permitted* maximum into a valid reduced labeling. -/
noncomputable def root_integral_validInsertMaximum
    {α : Type*} (n : ℕ) (R : α → α → Prop)
    (x : α) (hm : KahaneMaximal R x)
    (e : KahaneValidOrder
      {y : α // y ≠ x} (KahaneRemoveRelation R x) n) :
    KahaneValidOrder α R (n + 1) := by
  classical
  refine ⟨root_integral_insertMaximum n x e.1, ?_⟩
  intro a b hab
  by_cases ha : a = x
  · subst a
    exact False.elim (hm b hab)
  by_cases hb : b = x
  · subst b
    have hleft := root_integral_insertMaximum_val n x e.1 ⟨a, ha⟩
    have hright := root_integral_insertMaximum_top n x e.1
    have hn := (e.1 ⟨a, ha⟩).isLt
    apply Fin.lt_def.mpr
    rw [hleft, hright]
    simp
  · have hleft := root_integral_insertMaximum_val n x e.1 ⟨a, ha⟩
    have hright := root_integral_insertMaximum_val n x e.1 ⟨b, hb⟩
    have hsmall := e.2 ⟨a, ha⟩ ⟨b, hb⟩ hab
    apply Fin.lt_def.mpr
    rw [hleft, hright]
    exact hsmall

/-- **Generic exact maximum decomposition.** Every valid permutation is
uniquely equivalent to choosing one allowed maximum and a valid
permutation of the remaining elements. It is independent of any
Kahane-specific geometry or probability. -/
noncomputable def root_integral_validOrderMaximumEquiv
    {α : Type*} (n : ℕ) (R : α → α → Prop) :
    KahaneValidOrder α R (n + 1) ≃
      (Σ x : {x : α // KahaneMaximal R x},
        KahaneValidOrder
          {y : α // y ≠ x.1} (KahaneRemoveRelation R x.1) n) := by
  classical
  let decode :
      (Σ x : {x : α // KahaneMaximal R x},
        KahaneValidOrder
          {y : α // y ≠ x.1} (KahaneRemoveRelation R x.1) n) →
        KahaneValidOrder α R (n + 1) := fun s =>
    root_integral_validInsertMaximum n R s.1.1 s.1.2 s.2
  let encode : KahaneValidOrder α R (n + 1) →
      (Σ x : {x : α // KahaneMaximal R x},
        KahaneValidOrder
          {y : α // y ≠ x.1} (KahaneRemoveRelation R x.1) n) := fun σ =>
    ⟨⟨σ.1.symm (Fin.last n),
      root_integral_maximum_must_be_maximal n R σ⟩,
      root_integral_validEraseMaximum n R σ⟩
  refine {
    toFun := encode
    invFun := decode
    left_inv := ?_
    right_inv := ?_ }
  · intro σ
    apply Subtype.ext
    exact root_integral_insert_erase_maximum n _ σ.1
      (σ.1.apply_symm_apply (Fin.last n))
  · intro ⟨⟨x, hm⟩, e⟩
    have htop :
        (root_integral_validInsertMaximum n R x hm e).1 x = Fin.last n :=
      root_integral_insertMaximum_top n x e.1
    have hx :
        (root_integral_validInsertMaximum n R x hm e).1.symm (Fin.last n) = x := by
      apply (root_integral_validInsertMaximum n R x hm e).1.injective
      rw [Equiv.apply_symm_apply, htop]
    apply Sigma.ext
    · apply Subtype.ext
      exact hx
    · have hdep
          (z : α) (hz : z = x)
          (q : KahaneValidOrder
            {y : α // y ≠ z}
            (KahaneRemoveRelation R z) n)
          (hq : ∀ y : {y : α // y ≠ x},
            (q.1 ⟨y.1, by rw [hz]; exact y.2⟩).val =
              (e.1 y).val) :
          HEq q e := by
        subst z
        apply heq_of_eq
        apply Subtype.ext
        apply Equiv.ext
        intro y
        apply Fin.ext
        exact hq y
      refine hdep
        ((root_integral_validInsertMaximum n R x hm e).1.symm
          (Fin.last n))
        hx
        (root_integral_validEraseMaximum n R
          (root_integral_validInsertMaximum n R x hm e)) ?_
      intro y
      let σ := root_integral_validInsertMaximum n R x hm e
      have htop' :
          σ.1 (σ.1.symm (Fin.last n)) = Fin.last n :=
        σ.1.apply_symm_apply _
      calc
        ((root_integral_validEraseMaximum n R σ).1
          ⟨y.1, by rw [hx]; exact y.2⟩).val =
            (σ.1 y.1).val := by
              exact root_integral_eraseMaximum_val n
                (σ.1.symm (Fin.last n)) σ.1 htop'
                ⟨y.1, by rw [hx]; exact y.2⟩
        _ = (e.1 y).val :=
          root_integral_insertMaximum_val n x e.1 y

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Root–leaf order relations. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Exactly the three classes of strict comparisons: later root below
earlier root, left leaf below own root, own root below upper leaf. -/
def root_integral_rootLeafRelation
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    CanonicalPacketCells k l u f → CanonicalPacketCells k l u f → Prop
  | Sum.inl i, Sum.inl j => j < i
  | Sum.inr (Sum.inl ⟨i, _⟩), Sum.inl j => i = j
  | Sum.inl i, Sum.inr (Sum.inr (Sum.inl ⟨j, _⟩)) => i = j
  | _, _ => False

/-- The existing abstract geometry is precisely the linear-extension
condition for the preceding finite directed relation. -/
theorem root_integral_relation_valid_iff
    (k : ℕ) (l u : Fin k → ℕ) (f n : ℕ)
    (σ : CanonicalPacketCells k l u f ≃ Fin n) :
    (∀ x y, root_integral_rootLeafRelation k l u f x y → σ x < σ y) ↔
    CanonicalPacketValid k l u f n σ := by
  classical
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      exact h (Sum.inl j) (Sum.inl i) (by simpa [root_integral_rootLeafRelation] using hij)
    · intro i p
      exact h (Sum.inr (Sum.inl ⟨i, p⟩)) (Sum.inl i) (by rfl)
    · intro i p
      exact h (Sum.inl i) (Sum.inr (Sum.inr (Sum.inl ⟨i, p⟩))) (by rfl)
  · rintro ⟨hroot, hleft, hupper⟩ x y hxy
    cases x with
    | inl i =>
        cases y with
        | inl j =>
            change j < i at hxy
            exact hroot hxy
        | inr z =>
            cases z with
            | inl ip =>
                cases hxy
            | inr z =>
                cases z with
                | inl ip =>
                    rcases ip with ⟨j,p⟩
                    change i = j at hxy
                    subst j
                    exact hupper i p
                | inr q =>
                    cases hxy
    | inr z =>
        cases z with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            cases y with
            | inl j =>
                change i = j at hxy
                subst j
                exact hleft i p
            | inr v =>
                cases hxy
        | inr z =>
            cases z with
            | inl ip =>
                cases y <;> cases hxy
            | inr q =>
                cases y <;> cases hxy

/-- Changing coordinates by a relation-preserving bijection transports
valid permutations without any assumptions about acyclicity. -/
noncomputable def root_integral_relabelValidOrder
    {α β : Type*} (n : ℕ)
    (Rα : α → α → Prop) (Rβ : β → β → Prop)
    (e : α ≃ β)
    (hrel : ∀ a b, Rα a b ↔ Rβ (e a) (e b)) :
    KahaneValidOrder β Rβ n ≃ KahaneValidOrder α Rα n := by
  classical
  refine
    { toFun := fun σ => ⟨e.trans σ.1, ?_⟩
      invFun := fun τ => ⟨e.symm.trans τ.1, ?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro a b hab
    exact σ.2 (e a) (e b) ((hrel a b).mp hab)
  · intro b c hbc
    have h := τ.2 (e.symm b) (e.symm c)
      ((hrel (e.symm b) (e.symm c)).mpr (by simpa using hbc))
    simpa using h
  · intro σ
    apply Subtype.ext
    apply Equiv.ext
    intro b
    simp
  · intro τ
    apply Subtype.ext
    apply Equiv.ext
    intro a
    simp

/-- All upper leaves are maximal elements in the directed root/leaf
relation (their labels have no imposed upper bound). -/
theorem root_integral_upper_is_maximal
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (i : Fin k) (p : Fin (u i)) :
    KahaneMaximal (root_integral_rootLeafRelation k l u f)
      (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))) := by
  intro y hy
  cases y <;> cases hy

/-- If root 0 has no upper leaves, it is maximal in the inequality
relation. (All other roots are constrained below root 0.) -/
theorem root_integral_first_root_is_maximal
    (k : ℕ) (hk : 0 < k)
    (l u : Fin k → ℕ) (f : ℕ)
    (hu : u ⟨0, hk⟩ = 0) :
    KahaneMaximal (root_integral_rootLeafRelation k l u f)
      (Sum.inl (⟨0, hk⟩ : Fin k)) := by
  intro y hy
  cases y with
  | inl j =>
      change j < (⟨0, hk⟩ : Fin k) at hy
      exact (Nat.not_lt_zero j.val) hy
  | inr z =>
      cases z with
      | inl p => cases hy
      | inr z =>
          cases z with
          | inl ip =>
              rcases ip with ⟨j,p⟩
              change (⟨0, hk⟩ : Fin k) = j at hy
              subst j
              have : False := by
                have hp := p.isLt
                have hz : u ⟨0, hk⟩ = 0 := hu
                omega
              exact this.elim
          | inr p => cases hy

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Upper-boundary deletion equivalence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Upper multiplicities after deleting one chosen upper leaf. -/
def root_integral_upperDrop
    (k : ℕ) (u : Fin k → ℕ) (i : Fin k) : Fin k → ℕ :=
  Function.update u i (u i - 1)

/-- For each root index j, the reduced upper-leaf fiber has the same
cardinality as the old fiber with the chosen leaf excluded. -/
theorem root_integral_upperDrop_fiber_card
    (k : ℕ) (u : Fin k → ℕ) (i : Fin k) (p : Fin (u i))
    (j : Fin k) :
    Fintype.card (Fin (root_integral_upperDrop k u i j)) =
      Fintype.card {q : Fin (u j) // (⟨j, q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩} := by
  classical
  by_cases h : j = i
  · subst j
    simp only [root_integral_upperDrop, Function.update_self,
      Fintype.card_fin]
    have hp : p ∈ (Finset.univ : Finset (Fin (u i))) := Finset.mem_univ _
    calc
      u i - 1 = ((Finset.univ : Finset (Fin (u i))).erase p).card := by
        rw [Finset.card_erase_of_mem hp]
        simp
      _ = Fintype.card {q : Fin (u i) //
          (⟨i,q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩} := by
        rw [Fintype.card_subtype]
        apply congrArg Finset.card
        ext q
        simp only [Finset.mem_erase, Finset.mem_univ,
          Finset.mem_filter, and_true, true_and]
        simp [Sigma.mk.injEq, ne_eq]
  · simp only [root_integral_upperDrop, Function.update_of_ne h,
      Fintype.card_fin]
    rw [Fintype.card_subtype]
    have hfilter :
        (Finset.univ.filter (fun q : Fin (u j) =>
          (⟨j,q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩)) = Finset.univ := by
      ext q
      simp only [Finset.mem_filter, Finset.mem_univ,
        true_and, iff_true]
      intro he
      apply h
      have hh :
          (⟨j, q⟩ : Σ t : Fin k, Fin (u t)).fst =
          (⟨i, p⟩ : Σ t : Fin k, Fin (u t)).fst :=
        congrArg Sigma.fst he
      exact hh
    rw [hfilter]
    simp

/-- A fiberwise choice of bijections, preserving the root index,
identifies every remaining upper leaf after a deletion. -/
noncomputable def root_integral_upperDropSigmaEquiv
    (k : ℕ) (u : Fin k → ℕ) (i : Fin k) (p : Fin (u i)) :
    (Σ j : Fin k, Fin (root_integral_upperDrop k u i j)) ≃
      {v : (Σ j : Fin k, Fin (u j)) // v ≠ ⟨i,p⟩} := by
  classical
  let fiber (j : Fin k) :
      Fin (root_integral_upperDrop k u i j) ≃
        {q : Fin (u j) //
          (⟨j,q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩} :=
    Fintype.equivOfCardEq (root_integral_upperDrop_fiber_card k u i p j)
  let sig :
      (Σ j : Fin k, Fin (root_integral_upperDrop k u i j)) ≃
      (Σ j : Fin k,
        {q : Fin (u j) //
          (⟨j,q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩}) :=
    Equiv.sigmaCongrRight fiber
  let pack :
      (Σ j : Fin k,
        {q : Fin (u j) //
          (⟨j,q⟩ : Σ t : Fin k, Fin (u t)) ≠ ⟨i,p⟩}) ≃
        {v : (Σ j : Fin k, Fin (u j)) // v ≠ ⟨i,p⟩} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1⟩, x.2.2⟩
      invFun := fun x => ⟨x.1.1, ⟨x.1.2, x.2⟩⟩
      left_inv := by rintro ⟨j, q⟩; rfl
      right_inv := by rintro ⟨⟨j,q⟩,h⟩; rfl }
  exact sig.trans pack

/-- The sigma-equivalence above has the same root index before and
after deletion, a fact needed to preserve ALL inequalities. -/
theorem root_integral_upperDropSigmaEquiv_index
    (k : ℕ) (u : Fin k → ℕ) (i : Fin k) (p : Fin (u i))
    (v : Σ j : Fin k, Fin (root_integral_upperDrop k u i j)) :
    (root_integral_upperDropSigmaEquiv k u i p v).1.1 = v.1 := by
  simp [root_integral_upperDropSigmaEquiv,
    Equiv.sigmaCongrRight_apply]

/-- A complete root/left/upper/free abstract cell, with exactly one
chosen upper leaf removed, is a reduced root/leaf word of the same
length. No cardinal argument about arbitrary full types is used. -/
noncomputable def root_integral_upperDropCellsEquiv
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (i : Fin k) (p : Fin (u i)) :
    CanonicalPacketCells k l (root_integral_upperDrop k u i) f ≃
      {v : CanonicalPacketCells k l u f //
        v ≠ Sum.inr (Sum.inr (Sum.inl (⟨i,p⟩ : Σ j : Fin k, Fin (u j))))} := by
  classical
  let deleted : CanonicalPacketCells k l u f :=
    Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))
  let eu := root_integral_upperDropSigmaEquiv k u i p
  let F : CanonicalPacketCells k l (root_integral_upperDrop k u i) f →
      {v : CanonicalPacketCells k l u f // v ≠ deleted} := by
    intro v
    cases v with
    | inl j =>
        exact ⟨Sum.inl j, by simp [deleted]⟩
    | inr v =>
        cases v with
        | inl q => exact ⟨Sum.inr (Sum.inl q), by simp [deleted]⟩
        | inr v =>
            cases v with
            | inl q => exact ⟨Sum.inr (Sum.inr (Sum.inl (eu q).1)), by
                intro h
                exact (eu q).2 (Sum.inl.inj
                  (Sum.inr.inj (Sum.inr.inj h)))⟩
            | inr q => exact ⟨Sum.inr (Sum.inr (Sum.inr q)), by simp [deleted]⟩
  have hinj : Function.Injective F := by
    intro a b hab
    have hval : (F a).1 = (F b).1 :=
      congrArg Subtype.val hab
    rcases a with (a | (a | (a | a))) <;>
      rcases b with (b | (b | (b | b))) <;>
      simp_all only [F, Sum.inr.injEq, Sum.inl.injEq,
        Sum.inl_ne_inr, Sum.inr_ne_inl]
    exact eu.injective (Subtype.ext hval)
  have hsurj : Function.Surjective F := by
    rintro ⟨v, hv⟩
    cases v with
    | inl j => exact ⟨Sum.inl j, rfl⟩
    | inr v =>
        cases v with
        | inl q => exact ⟨Sum.inr (Sum.inl q), rfl⟩
        | inr v =>
            cases v with
            | inl q =>
                have hq : q ≠ (⟨i,p⟩ : Σ j : Fin k, Fin (u j)) := by
                  intro he
                  exact hv (by simp [deleted, he])
                refine ⟨Sum.inr (Sum.inr (Sum.inl (eu.symm ⟨q,hq⟩))), ?_⟩
                apply Subtype.ext
                simp [F]
            | inr q => exact ⟨Sum.inr (Sum.inr (Sum.inr q)), rfl⟩
  exact Equiv.ofBijective F ⟨hinj, hsurj⟩

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Root deletion equivalence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The exact root-deletion bijection of the *cell types*. It preserves
every relevant block index and leaves the initial root's left leaves as
unrestricted variables in the reduced word. -/
noncomputable def root_integral_rootDropCellsEquiv
    (n : ℕ) (l u : Fin (n + 1) → ℕ)
    (hu : u (0 : Fin (n + 1)) = 0) :
    CanonicalPacketCells n (fun i => l i.succ) (fun i => u i.succ)
      (l (0 : Fin (n + 1))) ≃
    {v : CanonicalPacketCells (n + 1) l u 0 //
      v ≠ Sum.inl (0 : Fin (n + 1))} := by
  classical
  let F : CanonicalPacketCells n (fun i => l i.succ) (fun i => u i.succ)
      (l (0 : Fin (n + 1))) →
      {v : CanonicalPacketCells (n + 1) l u 0 //
        v ≠ Sum.inl (0 : Fin (n + 1))} := by
    intro v
    cases v with
    | inl i => exact ⟨Sum.inl i.succ, by simp⟩
    | inr v =>
        cases v with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            exact ⟨Sum.inr (Sum.inl ⟨i.succ,p⟩), by simp⟩
        | inr v =>
            cases v with
            | inl ip =>
                rcases ip with ⟨i,p⟩
                exact ⟨Sum.inr (Sum.inr (Sum.inl ⟨i.succ,p⟩)), by simp⟩
            | inr p =>
                exact ⟨Sum.inr (Sum.inl ⟨(0 : Fin (n + 1)),p⟩), by simp⟩
  let G : {v : CanonicalPacketCells (n + 1) l u 0 //
      v ≠ Sum.inl (0 : Fin (n + 1))} →
      CanonicalPacketCells n (fun i => l i.succ) (fun i => u i.succ)
        (l (0 : Fin (n + 1))) := by
    intro v
    rcases v with ⟨v,hv⟩
    cases v with
    | inl i =>
        cases i using Fin.cases with
        | zero => exact False.elim (hv rfl)
        | succ i => exact Sum.inl i
    | inr v =>
        cases v with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            cases i using Fin.cases with
            | zero => exact Sum.inr (Sum.inr (Sum.inr p))
            | succ i => exact Sum.inr (Sum.inl ⟨i,p⟩)
        | inr v =>
            cases v with
            | inl ip =>
                rcases ip with ⟨i,p⟩
                cases i using Fin.cases with
                | zero =>
                    have h : False := by
                      have hp : (p.val : ℕ) < 0 := by
                        simpa only [hu] using p.isLt
                      omega
                    exact h.elim
                | succ i => exact Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))
            | inr p => exact Fin.elim0 p
  refine { toFun := F, invFun := G, left_inv := ?_, right_inv := ?_ }
  · intro v
    cases v with
    | inl i => rfl
    | inr v =>
        cases v with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            rfl
        | inr v =>
            cases v with
            | inl ip =>
                rcases ip with ⟨i,p⟩
                rfl
            | inr p => rfl
  · rintro ⟨v,hv⟩
    apply Subtype.ext
    cases v with
    | inl i =>
        cases i using Fin.cases with
        | zero => exact False.elim (hv rfl)
        | succ i => rfl
    | inr v =>
        cases v with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            cases i using Fin.cases with
            | zero => rfl
            | succ i => rfl
        | inr v =>
            cases v with
            | inl ip =>
                rcases ip with ⟨i,p⟩
                cases i using Fin.cases with
                | zero =>
                    have h : False := by
                      have hp : (p.val : ℕ) < 0 := by
                        simpa only [hu] using p.isLt
                      omega
                    exact h.elim
                | succ i => rfl
            | inr p => exact Fin.elim0 p

/-- Every directed inequality between surviving cells corresponds
exactly to a reduced-word inequality. The head's lower leaves carry no
remaining constraint after becoming free leaves. -/
theorem root_integral_rootDropCells_rel
    (n : ℕ) (l u : Fin (n + 1) → ℕ)
    (hu : u (0 : Fin (n + 1)) = 0)
    (a b : CanonicalPacketCells n (fun i => l i.succ)
      (fun i => u i.succ) (l (0 : Fin (n + 1)))) :
    root_integral_rootLeafRelation n (fun i => l i.succ)
        (fun i => u i.succ) (l (0 : Fin (n + 1))) a b ↔
    root_integral_rootLeafRelation (n + 1) l u 0
      (root_integral_rootDropCellsEquiv n l u hu a).1
      (root_integral_rootDropCellsEquiv n l u hu b).1 := by
  classical
  cases a with
  | inl i =>
      cases b with
      | inl j =>
          simp [root_integral_rootLeafRelation,
            root_integral_rootDropCellsEquiv,
            Fin.succ_lt_succ_iff]
      | inr v =>
          cases v with
          | inl ip =>
              rcases ip with ⟨j, p⟩
              simp [root_integral_rootLeafRelation,
                root_integral_rootDropCellsEquiv]
          | inr v =>
              cases v with
              | inl ip =>
                  rcases ip with ⟨j, p⟩
                  simp [root_integral_rootLeafRelation,
                    root_integral_rootDropCellsEquiv]
              | inr p =>
                  simp [root_integral_rootLeafRelation,
                    root_integral_rootDropCellsEquiv]
  | inr v =>
      cases v with
      | inl ip =>
          rcases ip with ⟨i, p⟩
          cases b with
          | inl j =>
              simp [root_integral_rootLeafRelation,
                root_integral_rootDropCellsEquiv]
          | inr w =>
              cases w with
              | inl ip =>
                  rcases ip with ⟨j, q⟩
                  simp [root_integral_rootLeafRelation,
                    root_integral_rootDropCellsEquiv]
              | inr w =>
                  cases w with
                  | inl ip =>
                      rcases ip with ⟨j, q⟩
                      simp [root_integral_rootLeafRelation,
                        root_integral_rootDropCellsEquiv]
                  | inr q =>
                      simp [root_integral_rootLeafRelation,
                        root_integral_rootDropCellsEquiv]
      | inr v =>
          cases v with
          | inl ip =>
              rcases ip with ⟨i, p⟩
              cases b <;>
                simp [root_integral_rootLeafRelation,
                  root_integral_rootDropCellsEquiv]
          | inr p =>
              cases b with
              | inl j =>
                  simpa [root_integral_rootLeafRelation,
                    root_integral_rootDropCellsEquiv] using
                    (Fin.succ_ne_zero j).symm
              | inr w =>
                  cases w with
                  | inl ip =>
                      rcases ip with ⟨j, q⟩
                      simp [root_integral_rootLeafRelation,
                        root_integral_rootDropCellsEquiv]
                  | inr w =>
                      cases w with
                      | inl ip =>
                          rcases ip with ⟨j, q⟩
                          simp [root_integral_rootLeafRelation,
                            root_integral_rootDropCellsEquiv]
                      | inr q =>
                          simp [root_integral_rootLeafRelation,
                            root_integral_rootDropCellsEquiv]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Reindexing maximal-root cases. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- In the word with no free leaves, exactly the upper leaves and,
when its upper fiber is empty, the first root are maximal in the
inequality relation. A maximal cell must also satisfy the admissible labeling conditions;
that is supplied by the generic maximum-deletion equivalence. -/
theorem root_integral_maximal_cases
    (k : ℕ) (hk : 0 < k) (l u : Fin k → ℕ)
    (x : CanonicalPacketCells k l u 0) :
    KahaneMaximal (root_integral_rootLeafRelation k l u 0) x ↔
      (∃ i : Fin k, ∃ p : Fin (u i),
        x = Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))) ∨
      (u (⟨0, hk⟩ : Fin k) = 0 ∧ x = Sum.inl (⟨0, hk⟩ : Fin k)) := by
  classical
  constructor
  · intro hm
    cases x with
    | inl i =>
        have hi0 : i = (⟨0, hk⟩ : Fin k) := by
          by_contra h
          have hpos : 0 < i.val := by
            have hne : i.val ≠ 0 := by
              intro he
              exact h (Fin.ext he)
            omega
          have hout : root_integral_rootLeafRelation k l u 0
              (Sum.inl i) (Sum.inl (⟨0, hk⟩ : Fin k)) := by
            exact Fin.lt_def.mpr hpos
          exact hm _ hout
        subst i
        have hu : u (⟨0, hk⟩ : Fin k) = 0 := by
          by_contra hzero
          have hpos : 0 < u (⟨0, hk⟩ : Fin k) := Nat.pos_of_ne_zero hzero
          have h := hm (Sum.inr (Sum.inr (Sum.inl
            ⟨(⟨0, hk⟩ : Fin k), (⟨0,hpos⟩ : Fin (u ⟨0, hk⟩))⟩)))
            (by rfl)
          exact h
        exact Or.inr ⟨hu, rfl⟩
    | inr y =>
        cases y with
        | inl ip =>
            rcases ip with ⟨i,p⟩
            have h := hm (Sum.inl i)
              (show root_integral_rootLeafRelation k l u 0
                (Sum.inr (Sum.inl ⟨i,p⟩)) (Sum.inl i) from rfl)
            exact False.elim h
        | inr z =>
            cases z with
            | inl ip =>
                rcases ip with ⟨i,p⟩
                exact Or.inl ⟨i,p,rfl⟩
            | inr p => exact Fin.elim0 p
  · rintro (⟨i,p,rfl⟩ | ⟨hu,rfl⟩)
    · exact root_integral_upper_is_maximal k l u 0 i p
    · exact root_integral_first_root_is_maximal k hk l u 0 hu

/-- The upper-leaf deletion map changes only the LABEL within the
chosen upper fiber, never the root index or the kind of cell. The
full root/leaf inequality relation is therefore transported verbatim. -/
theorem root_integral_upperDropCells_rel
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (i : Fin k) (p : Fin (u i))
    (a b : CanonicalPacketCells k l (root_integral_upperDrop k u i) f) :
    root_integral_rootLeafRelation k l (root_integral_upperDrop k u i) f a b ↔
    root_integral_rootLeafRelation k l u f
      (root_integral_upperDropCellsEquiv k l u f i p a).1
      (root_integral_upperDropCellsEquiv k l u f i p b).1 := by
  classical
  rcases a with (j | (⟨j, q⟩ | (⟨j, q⟩ | q))) <;>
    rcases b with (m | (⟨m, r⟩ | (⟨m, r⟩ | r))) <;>
    first
    | change False ↔ False
      rfl
    | change (m < j) ↔ (m < j)
      rfl
    | change (j = m) ↔ (j = m)
      rfl

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Maximal-label order equivalence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The optional head-root branch is a genuine finite subtype of Unit,
not an extra assumption to be carried into the target theorem. -/
abbrev KahaneFirstRootOption
    {k : ℕ} (u : Fin (k + 1) → ℕ) :=
  {_t : Unit // u (0 : Fin (k + 1)) = 0}

/-- All maximal cells are accounted for exactly once, even in the
case where the largest root is itself a possible maximum. -/
noncomputable def root_integral_maximalWordEquiv
    (k : ℕ) (l u : Fin (k + 1) → ℕ) :
    {x : CanonicalPacketCells (k + 1) l u 0 //
      KahaneMaximal (root_integral_rootLeafRelation (k + 1) l u 0) x} ≃
    (Σ i : Fin (k + 1), Fin (u i)) ⊕ KahaneFirstRootOption u := by
  classical
  let R := root_integral_rootLeafRelation (k + 1) l u 0
  have hk : 0 < k+1 := Nat.zero_lt_succ k
  let F : {x : CanonicalPacketCells (k + 1) l u 0 // KahaneMaximal R x} →
      (Σ i : Fin (k + 1), Fin (u i)) ⊕ KahaneFirstRootOption u := by
    intro x
    cases hx : x.1 with
    | inl i =>
        have hc :=
          (root_integral_maximal_cases (k + 1) hk l u (Sum.inl i)).mp
            (by simpa [R, hx] using x.2)
        have hu : u (0 : Fin (k + 1)) = 0 := by
          rcases hc with ⟨j,p,h⟩ | ⟨hu,heq⟩
          · cases h
          · exact hu
        exact Sum.inr ⟨(), hu⟩
    | inr y =>
        cases y with
        | inl ip =>
            have hc :=
              (root_integral_maximal_cases (k + 1) hk l u
                (Sum.inr (Sum.inl ip))).mp
                (by simpa [R, hx] using x.2)
            have hf : False := by
              rcases hc with ⟨j, p, h⟩ | ⟨_, h⟩
              · cases h
              · cases h
            exact hf.elim
        | inr y =>
            cases y with
            | inl ip => exact Sum.inl ip
            | inr p => exact Fin.elim0 p
  let G : ((Σ i : Fin (k + 1), Fin (u i)) ⊕ KahaneFirstRootOption u) →
      {x : CanonicalPacketCells (k + 1) l u 0 // KahaneMaximal R x} := by
    intro x
    cases x with
    | inl ip =>
        rcases ip with ⟨i,p⟩
        exact ⟨Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩)),
          root_integral_upper_is_maximal (k + 1) l u 0 i p⟩
    | inr z =>
        exact ⟨Sum.inl (0 : Fin (k + 1)),
          root_integral_first_root_is_maximal (k + 1) hk l u 0 z.2⟩
  refine ⟨F, G, ?_, ?_⟩
  · rintro ⟨x,hx⟩
    apply Subtype.ext
    cases x with
    | inl i =>
        have hh :=
          (root_integral_maximal_cases (k + 1) hk l u (Sum.inl i)).mp hx
        rcases hh with ⟨j,p,h⟩ | ⟨hu,heq⟩
        · cases h
        · change Sum.inl (0 : Fin (k + 1)) = Sum.inl i
          exact congrArg Sum.inl (Sum.inl.inj heq).symm
    | inr y =>
        cases y with
        | inl ip =>
            have hh :=
              (root_integral_maximal_cases (k + 1) hk l u (Sum.inr (Sum.inl ip))).mp hx
            have hf : False := by
              rcases hh with ⟨j,p,h⟩ | ⟨hu,heq⟩
              · exact (by cases h)
              · exact (by cases heq)
            exact hf.elim
        | inr y =>
            cases y with
            | inl ip => rfl
            | inr p => exact Fin.elim0 p
  · intro x
    cases x with
    | inl ip =>
        rcases ip with ⟨i,p⟩
        rfl
    | inr z =>
        cases z with
        | mk t hu =>
            cases t
            rfl

/-- Maximal-root choices are finite and yield either zero or one
summand, according to the *actual* upper multiplicity of the head. -/
theorem root_integral_card_firstRootOption
    (k : ℕ) (u : Fin (k + 1) → ℕ) :
    Fintype.card (KahaneFirstRootOption u) =
      if u (0 : Fin (k + 1)) = 0 then 1 else 0 := by
  classical
  by_cases hu : u (0 : Fin (k + 1)) = 0
  · have e : KahaneFirstRootOption u ≃ Unit :=
      { toFun := fun _ => ()
        invFun := fun _ => ⟨(), hu⟩
        left_inv := by intro x; apply Subtype.ext; cases x.1; rfl
        right_inv := by intro x; cases x; rfl }
    simpa only [hu, ite_true, Fintype.card_unit] using
      (Fintype.card_congr e)
  · have hempty : IsEmpty (KahaneFirstRootOption u) :=
      ⟨fun x => hu x.2⟩
    simp [hu, Fintype.card_eq_zero]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Transport of weighted cardinalities. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A generic finite maximum-deletion enumeration of linear extensions.
The RHS is a sum indexed by actual maximal elements, with a *true*
bijection of permutation types as its proof. -/
theorem root_integral_card_validOrder_maximum
    {α : Type*} [Fintype α] [DecidableEq α]
    (n : ℕ) (R : α → α → Prop) :
    Fintype.card (KahaneValidOrder α R (n + 1)) =
      ∑ x : {x : α // KahaneMaximal R x},
        Fintype.card (KahaneValidOrder
          {y : α // y ≠ x.1}
          (KahaneRemoveRelation R x.1) n) := by
  classical
  calc
    Fintype.card (KahaneValidOrder α R (n + 1)) =
      Fintype.card (Σ x : {x : α // KahaneMaximal R x},
        KahaneValidOrder {y : α // y ≠ x.1}
          (KahaneRemoveRelation R x.1) n) :=
        Fintype.card_congr (root_integral_validOrderMaximumEquiv n R)
    _ = _ := by simp only [Fintype.card_sigma]

/-- Removing a prescribed upper leaf produces EXACTLY the valid
permutations of the reduced multiplicity vector. The forgotten label
is the UNIQUE maximum, so no further factorial factor is needed. -/
theorem root_integral_card_upper_delete
    (k : ℕ) (l u : Fin k → ℕ)
    (i : Fin k) (p : Fin (u i)) (n : ℕ) :
    Fintype.card (KahaneValidOrder
      {v : CanonicalPacketCells k l u 0 //
        v ≠ Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))}
      (KahaneRemoveRelation
        (root_integral_rootLeafRelation k l u 0)
        (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩)))) n) =
    Fintype.card (KahaneValidOrder
      (CanonicalPacketCells k l (root_integral_upperDrop k u i) 0)
      (root_integral_rootLeafRelation k l
        (root_integral_upperDrop k u i) 0) n) := by
  classical
  let e := root_integral_upperDropCellsEquiv k l u 0 i p
  have he : ∀ a b : CanonicalPacketCells k l (root_integral_upperDrop k u i) 0,
      root_integral_rootLeafRelation k l (root_integral_upperDrop k u i) 0 a b ↔
      KahaneRemoveRelation (root_integral_rootLeafRelation k l u 0)
        (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))) (e a) (e b) := by
    intro a b
    exact root_integral_upperDropCells_rel k l u 0 i p a b
  exact Fintype.card_congr
    (root_integral_relabelValidOrder n
      (root_integral_rootLeafRelation k l (root_integral_upperDrop k u i) 0)
      (KahaneRemoveRelation
        (root_integral_rootLeafRelation k l u 0)
        (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩)))) e he)

/-- When the first upper fiber is empty, deleting the first root turns
its lower leaves into free leaves and decreases the number of roots by
one. Each remaining relation is preserved. -/
theorem root_integral_card_first_root_delete
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (hu : u (0 : Fin (k + 1)) = 0) (n : ℕ) :
    Fintype.card (KahaneValidOrder
      {v : CanonicalPacketCells (k + 1) l u 0 //
        v ≠ Sum.inl (0 : Fin (k + 1))}
      (KahaneRemoveRelation
        (root_integral_rootLeafRelation (k + 1) l u 0)
        (Sum.inl (0 : Fin (k + 1)))) n) =
    Fintype.card (KahaneValidOrder
      (CanonicalPacketCells k (fun i => l i.succ) (fun i => u i.succ)
        (l (0 : Fin (k + 1))))
      (root_integral_rootLeafRelation k
        (fun i => l i.succ) (fun i => u i.succ)
        (l (0 : Fin (k + 1)))) n) := by
  classical
  let e := root_integral_rootDropCellsEquiv k l u hu
  have he : ∀ a b : CanonicalPacketCells k (fun i => l i.succ)
      (fun i => u i.succ) (l (0 : Fin (k + 1))),
      root_integral_rootLeafRelation k (fun i => l i.succ)
        (fun i => u i.succ) (l (0 : Fin (k + 1))) a b ↔
      KahaneRemoveRelation
        (root_integral_rootLeafRelation (k + 1) l u 0)
        (Sum.inl (0 : Fin (k + 1))) (e a) (e b) := by
    intro a b
    exact root_integral_rootDropCells_rel k l u hu a b
  exact Fintype.card_congr
    (root_integral_relabelValidOrder n
      (root_integral_rootLeafRelation k
        (fun i => l i.succ) (fun i => u i.succ)
        (l (0 : Fin (k + 1))))
      (KahaneRemoveRelation
        (root_integral_rootLeafRelation (k + 1) l u 0)
        (Sum.inl (0 : Fin (k + 1)))) e he)

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Euler recurrence for valid assignments. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Euler's maximum-label recursion for finite valid permutations,
with no assumptions on the number n of available ranks. If the number
of elements is not n+1, all relevant types of bijections are empty,
and the same equality still holds. -/
theorem root_integral_valid_count_euler
    (k : ℕ) (l u : Fin (k + 1) → ℕ) (n : ℕ) :
    Fintype.card (KahaneValidOrder
      (CanonicalPacketCells (k + 1) l u 0)
      (root_integral_rootLeafRelation (k + 1) l u 0) (n+1)) =
      (∑ i : Fin (k + 1), ∑ _p : Fin (u i),
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0)
          (root_integral_rootLeafRelation (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0) n)) +
      (if u (0 : Fin (k + 1)) = 0 then
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1))))
          (root_integral_rootLeafRelation k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1)))) n)
       else 0) := by
  classical
  let R := root_integral_rootLeafRelation (k + 1) l u 0
  let M := {x : CanonicalPacketCells (k + 1) l u 0 // KahaneMaximal R x}
  let W := (Σ i : Fin (k + 1), Fin (u i)) ⊕ KahaneFirstRootOption u
  let e : M ≃ W := root_integral_maximalWordEquiv k l u
  let F : M → ℕ := fun x =>
    Fintype.card (KahaneValidOrder
      {y : CanonicalPacketCells (k + 1) l u 0 // y ≠ x.1}
      (KahaneRemoveRelation R x.1) n)
  have hfirst :
      Fintype.card (KahaneValidOrder
        (CanonicalPacketCells (k + 1) l u 0) R (n+1)) =
      ∑ x : M, F x := by
    rw [root_integral_card_validOrder_maximum n R]
    apply Finset.sum_congr rfl
    intro x _
    dsimp only [F]
    let T := KahaneValidOrder
      {y : CanonicalPacketCells (k + 1) l u 0 // y ≠ x.1}
      (KahaneRemoveRelation R x.1) n
    have hcard (s t : Fintype T) :
        @Fintype.card T s = @Fintype.card T t := by
      exact @Fintype.card_congr T T s t (Equiv.refl T)
    exact hcard _ _
  have hreindex : (∑ x : M, F x) =
      ∑ y : W, F (e.symm y) := by
    apply Fintype.sum_equiv e _ _
    intro x
    simp
  have hupper (i : Fin (k + 1)) (p : Fin (u i)) :
      F (e.symm (Sum.inl ⟨i,p⟩)) =
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0)
          (root_integral_rootLeafRelation (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0) n) := by
    change Fintype.card (KahaneValidOrder
      {v : CanonicalPacketCells (k + 1) l u 0 //
        v ≠ Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩))}
      (KahaneRemoveRelation R
        (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩)))) n) = _
    exact root_integral_card_upper_delete (k + 1) l u i p n
  have hroot (z : KahaneFirstRootOption u) :
      F (e.symm (Sum.inr z)) =
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1))))
          (root_integral_rootLeafRelation k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1)))) n) := by
    change Fintype.card (KahaneValidOrder
      {v : CanonicalPacketCells (k + 1) l u 0 //
        v ≠ Sum.inl (0 : Fin (k + 1))}
      (KahaneRemoveRelation R (Sum.inl (0 : Fin (k + 1)))) n) = _
    exact root_integral_card_first_root_delete k l u z.2 n
  rw [hfirst, hreindex]
  change (∑ x : W, F (e.symm x)) = _
  simp only [W, Fintype.sum_sum_type, Fintype.sum_sigma]
  simp_rw [hupper]
  have hRootSum :
      (∑ z : KahaneFirstRootOption u, F (e.symm (Sum.inr z))) =
      if u (0 : Fin (k + 1)) = 0 then
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1))))
          (root_integral_rootLeafRelation k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1)))) n)
      else 0 := by
    by_cases hu : u (0 : Fin (k + 1)) = 0
    · let z0 : KahaneFirstRootOption u := ⟨(), hu⟩
      have huniq (z : KahaneFirstRootOption u) : z = z0 := by
        apply Subtype.ext
        cases z.1
        rfl
      have hsingle :
          (Finset.univ : Finset (KahaneFirstRootOption u)) = {z0} := by
        ext z
        simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
        exact huniq z
      simp only [ite_eq_left hu]
      rw [hsingle, Finset.sum_singleton]
      exact hroot z0
    · have hne : IsEmpty (KahaneFirstRootOption u) :=
        ⟨fun z => hu z.2⟩
      let : IsEmpty (KahaneFirstRootOption u) := hne
      simp [hu]
  rw [hRootSum]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Normalization of weighted masses. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Removing one distinguished member of a finite type decreases its
cardinality by exactly one. This avoids unstable `Finset.update` sums. -/
theorem root_integral_card_complement_singleton
    (α : Type*) [Fintype α] [DecidableEq α] (x : α) :
    Fintype.card {y : α // y ≠ x} + 1 = Fintype.card α := by
  classical
  have hone : Fintype.card {y : α // y = x} = 1 :=
    Fintype.card_subtype_eq x
  have h :
      Fintype.card {y : α // y ≠ x} =
        Fintype.card α - 1 := by
    simpa only [hone, ne_eq] using
      (Fintype.card_subtype_compl (fun y : α => y = x))
  have hpos : 0 < Fintype.card α :=
    Fintype.card_pos_iff.mpr ⟨x⟩
  omega

/-- The mass in the numerical slot problem is exactly the cardinality
of the root/leaf type used in the finite linear-extension problem. -/
theorem root_integral_abstractCells_card
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    Fintype.card (CanonicalPacketCells k l u f) =
      k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f := by
  classical
  simp only [CanonicalPacketCells, Fintype.card_sum,
    Fintype.card_sigma, Fintype.card_fin, add_assoc]

/-- A selected upper leaf is replaced by one fewer element in its
fiber, and the whole mass drops by one. -/
theorem root_integral_upperDrop_mass
    (k : ℕ) (l u : Fin k → ℕ)
    (i : Fin k) (p : Fin (u i)) :
    (k + (∑ j : Fin k, l j) +
        (∑ j : Fin k, root_integral_upperDrop k u i j)) + 1 =
      k + (∑ j : Fin k, l j) + (∑ j : Fin k, u j) := by
  classical
  have hcard := Fintype.card_congr
    (root_integral_upperDropCellsEquiv k l u 0 i p)
  have hremove := root_integral_card_complement_singleton
    (CanonicalPacketCells k l u 0)
    (Sum.inr (Sum.inr (Sum.inl ⟨i,p⟩)))
  rw [← hcard] at hremove
  have hmass0 := root_integral_abstractCells_card k l u 0
  have hmass1 := root_integral_abstractCells_card k l
    (root_integral_upperDrop k u i) 0
  rw [hmass0, hmass1] at hremove
  omega

/-- Deleting the first root creates exactly as many new free leaves as
there were lower leaves of that root. The reduced and original
underlying finite types differ by precisely one element. -/
theorem root_integral_rootDrop_mass
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (hu : u (0 : Fin (k + 1)) = 0) :
    (k + (∑ i : Fin k, l i.succ) +
       (∑ i : Fin k, u i.succ) + l (0 : Fin (k + 1))) + 1 =
    (k + 1) + (∑ i : Fin (k + 1), l i) +
      (∑ i : Fin (k + 1), u i) := by
  classical
  have hcard := Fintype.card_congr (root_integral_rootDropCellsEquiv k l u hu)
  have hremove := root_integral_card_complement_singleton
    (CanonicalPacketCells (k + 1) l u 0)
    (Sum.inl (0 : Fin (k + 1)))
  rw [← hcard] at hremove
  have hmass0 := root_integral_abstractCells_card (k + 1) l u 0
  have hmass1 := root_integral_abstractCells_card k
    (fun i => l i.succ) (fun i => u i.succ)
    (l (0 : Fin (k + 1)))
  rw [hmass0, hmass1] at hremove
  omega

/-- A uniform cast of finite ranks is enough to replace the `Fin n`
of a deleted permutation by the canonically indexed smaller mass.
The inequalities are preserved because `Fin.cast` preserves `.val`. -/
noncomputable def root_integral_castValidOrders
    {α : Type*} (R : α → α → Prop) {n m : ℕ}
    (h : n = m) :
    KahaneValidOrder α R n ≃ KahaneValidOrder α R m := by
  cases h
  exact Equiv.refl _

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Linking weighted counts and Euler recurrence. -/
/-!
The original factorial gap sum is not a black box: by the concrete
packet permutation equivalence, it is an actual cardinality of the
root/leaf labeling type, divided by the full factorial. This is the
required bridge from Euler's maximum-deletion recursion on finite
permutations to `UniversalSlotIdentity`.
-/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The coefficient of the universal root/leaf problem is the fraction
of all bijective labelings which satisfy the root/boundary inequalities.
This statement follows from the explicit packet bijection; it does not
assume the integral identity. -/
theorem root_integral_slotRatio_eq_valid_permutations
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u f =
      (Fintype.card
        {σ : CanonicalPacketCells k l u f ≃
          Fin (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) //
          CanonicalPacketValid k l u f _ σ} : ℚ) /
      (Nat.factorial
        (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) : ℚ) := by
  classical
  let N := k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f
  let V := {σ : CanonicalPacketCells k l u f ≃ Fin N //
    CanonicalPacketValid k l u f N σ}
  have hpack : Fintype.card V = Fintype.card (SlotGapPackets k l u f) :=
    Fintype.card_congr (uniformPacketEquiv k l u f)
  have hweight :
      (∑ a : AllowedSlotAssignment k l u f,
        slotGapFactorialWeight k l u f a) =
      (Fintype.card V : ℚ) := by
    rw [hpack, card_slotGapPackets]
    unfold slotGapFactorialWeight factorialGapWeight
    simp only [Nat.cast_sum, Nat.cast_prod]
  rw [slotAssignmentRatio_eq_weight_sum, hweight]

/-- The same equality in terms of directed inequalities.  The
relation is only a definitional re-encoding of `CanonicalPacketValid`. -/
theorem root_integral_slotRatio_eq_linear_extensions
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u f =
      (Fintype.card
        (KahaneValidOrder (CanonicalPacketCells k l u f)
          (root_integral_rootLeafRelation k l u f)
          (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f)) : ℚ) /
      (Nat.factorial
        (k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f) : ℚ) := by
  classical
  rw [root_integral_slotRatio_eq_valid_permutations]
  congr 1
  exact_mod_cast
    (Fintype.card_congr
      (Equiv.subtypeEquiv (Equiv.refl _)
        (fun σ => (root_integral_relation_valid_iff k l u f _ σ).symm)))

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Finite integral coefficient identity. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The size of the root/leaf word, including unconstrained leaves. -/
def root_integral_wordMass
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) : ℕ :=
  k + (∑ i : Fin k, l i) + (∑ i : Fin k, u i) + f

/-- An actual finite count, not a definition by an integral. -/
noncomputable def root_integral_validPermutationCount
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) : ℕ := by
  classical
  exact Fintype.card (KahaneValidOrder
    (CanonicalPacketCells k l u f)
    (root_integral_rootLeafRelation k l u f)
    (root_integral_wordMass k l u f))

/-- Equate the independently constructed factorial slot quotient to
the number of admissible root/leaf permutations divided by n!. -/
theorem root_integral_slotRatio_eq_count
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    slotAssignmentRatio k l u f =
      (root_integral_validPermutationCount k l u f : ℚ) /
        (Nat.factorial (root_integral_wordMass k l u f) : ℚ) := by
  classical
  exact root_integral_slotRatio_eq_linear_extensions k l u f

/-- Under deletion of any existing upper leaf, the *smaller* word has
the same cardinality as the complement of the deleted cell. -/
theorem root_integral_upperDrop_wordMass
    (k : ℕ) (l u : Fin k → ℕ) (i : Fin k) (p : Fin (u i)) :
    root_integral_wordMass k l (root_integral_upperDrop k u i) 0 + 1 =
      root_integral_wordMass k l u 0 := by
  simpa only [root_integral_wordMass, add_zero] using
    root_integral_upperDrop_mass k l u i p

/-- Under deletion of the first root, the new unrestricted leaves
exactly compensate for its old left-boundary multiplicity. -/
theorem root_integral_rootDrop_wordMass
    (k : ℕ) (l u : Fin (k + 1) → ℕ)
    (hu : u (0 : Fin (k + 1)) = 0) :
    root_integral_wordMass k (fun i => l i.succ)
      (fun i => u i.succ) (l (0 : Fin (k + 1))) + 1 =
    root_integral_wordMass (k + 1) l u 0 := by
  simpa only [root_integral_wordMass, add_zero] using
    root_integral_rootDrop_mass k l u hu

/-- The finite COUNT of legal permutations satisfies the two-branch
Euler recursion after converting the size of `Fin` to the proper
canonical number of remaining elements. This is the unnormalized
bridge, not the integral statement. -/
theorem root_integral_validCount_euler_canonical
    (k : ℕ) (l u : Fin (k + 1) → ℕ) :
    root_integral_validPermutationCount (k + 1) l u 0 =
      (∑ i : Fin (k + 1), (u i) *
        root_integral_validPermutationCount (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0) +
      (if u (0 : Fin (k + 1)) = 0 then
        root_integral_validPermutationCount k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))
       else 0) := by
  classical
  let N := root_integral_wordMass (k + 1) l u 0
  have hN : 0 < N := by dsimp [N, root_integral_wordMass]; omega
  let n := N-1
  have hNn : n+1=N := by dsimp [n]; omega
  have hrec := root_integral_valid_count_euler k l u n
  have hUP (i : Fin (k + 1)) (p : Fin (u i)) :
      Fintype.card (KahaneValidOrder
        (CanonicalPacketCells (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0)
        (root_integral_rootLeafRelation (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0) n) =
      root_integral_validPermutationCount (k + 1) l
        (root_integral_upperDrop (k + 1) u i) 0 := by
    let m := root_integral_wordMass (k + 1) l
      (root_integral_upperDrop (k + 1) u i) 0
    have heq : m = n := by
      have h := root_integral_upperDrop_wordMass (k + 1) l u i p
      dsimp [m, n]
      omega
    unfold root_integral_validPermutationCount
    exact Fintype.card_congr
      (root_integral_castValidOrders
        (root_integral_rootLeafRelation (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0) heq.symm)
  have hROOT (hzero : u (0 : Fin (k + 1)) = 0) :
      Fintype.card (KahaneValidOrder
        (CanonicalPacketCells k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1))))
        (root_integral_rootLeafRelation k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))) n) =
      root_integral_validPermutationCount k (fun i => l i.succ)
        (fun i => u i.succ) (l (0 : Fin (k + 1))) := by
    let m := root_integral_wordMass k (fun i => l i.succ)
      (fun i => u i.succ) (l (0 : Fin (k + 1)))
    have heq : m = n := by
      have h := root_integral_rootDrop_wordMass k l u hzero
      dsimp [m, n]
      omega
    unfold root_integral_validPermutationCount
    exact Fintype.card_congr
      (root_integral_castValidOrders
        (root_integral_rootLeafRelation k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))) heq.symm)
  have hUPsum :
      (∑ i : Fin (k + 1), ∑ p : Fin (u i),
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0)
          (root_integral_rootLeafRelation (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0) n)) =
      ∑ i : Fin (k + 1), (u i) *
        root_integral_validPermutationCount (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0 := by
    apply Finset.sum_congr rfl
    intro i _
    calc
      (∑ p : Fin (u i),
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0)
          (root_integral_rootLeafRelation (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0) n)) =
        ∑ _p : Fin (u i),
          root_integral_validPermutationCount (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0 := by
          apply Finset.sum_congr rfl
          intro p _
          exact hUP i p
      _ = (u i) *
          root_integral_validPermutationCount (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0 := by
          simp
  have hroot :
      (if u (0 : Fin (k + 1)) = 0 then
        Fintype.card (KahaneValidOrder
          (CanonicalPacketCells k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1))))
          (root_integral_rootLeafRelation k (fun i => l i.succ)
            (fun i => u i.succ) (l (0 : Fin (k + 1)))) n)
       else 0) =
      (if u (0 : Fin (k + 1)) = 0 then
        root_integral_validPermutationCount k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))
       else 0) := by
    by_cases hu : u (0 : Fin (k + 1)) = 0
    · simp [hu, hROOT hu]
    · simp [hu]
  conv_lhs =>
    unfold root_integral_validPermutationCount
  simpa only [hNn] using
    hrec.trans (congrArg₂ (· + ·) hUPsum hroot)

/-- A purely rational factorial cancellation: `N/n!` is the
normalization of a count after removing one maximum. -/
theorem root_integral_factorial_step (n a : ℕ) :
    ((n+1 : ℕ) : ℚ) *
      ((a : ℚ) / (Nat.factorial (n+1) : ℚ)) =
    (a : ℚ) / (Nat.factorial n : ℚ) := by
  have hfact : (Nat.factorial (n+1) : ℚ) =
      (n+1 : ℕ) * (Nat.factorial n : ℚ) := by
    exact_mod_cast Nat.factorial_succ n
  have hn : ((n+1 : ℕ) : ℚ) ≠ 0 := by positivity
  have hf : (Nat.factorial n : ℚ) ≠ 0 := by positivity
  rw [hfact]
  field_simp

/-- Normalized Euler recurrence for the ORIGINAL slot statistic,
including the special first-root term with its old left leaves becoming
unrestricted. It is derived from the explicit maximum-label counting,
not from the analytic identity it will be used to prove. -/
theorem root_integral_slotRatio_euler
    (k : ℕ) (l u : Fin (k + 1) → ℕ) :
    (root_integral_wordMass (k + 1) l u 0 : ℚ) *
      slotAssignmentRatio (k + 1) l u 0 =
      (∑ i : Fin (k + 1), (u i : ℚ) *
        slotAssignmentRatio (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0) +
      (if u (0 : Fin (k + 1)) = 0 then
        slotAssignmentRatio k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))
       else 0) := by
  classical
  let N := root_integral_wordMass (k + 1) l u 0
  have hN : 0 < N := by dsimp [N, root_integral_wordMass]; omega
  let n := N-1
  have hNn : n+1=N := by dsimp [n]; omega
  have hrec := root_integral_validCount_euler_canonical k l u
  rw [root_integral_slotRatio_eq_count]
  have hleft :
      (N : ℚ) *
        ((root_integral_validPermutationCount (k + 1) l u 0 : ℚ) /
          (Nat.factorial N : ℚ)) =
      (root_integral_validPermutationCount (k + 1) l u 0 : ℚ) /
        (Nat.factorial n : ℚ) := by
    rw [← hNn]
    exact root_integral_factorial_step n _
  have hrightUP (i : Fin (k + 1)) (p : Fin (u i)) :
      (slotAssignmentRatio (k + 1) l
        (root_integral_upperDrop (k + 1) u i) 0) =
      (root_integral_validPermutationCount (k + 1) l
        (root_integral_upperDrop (k + 1) u i) 0 : ℚ) /
        (Nat.factorial n : ℚ) := by
    rw [root_integral_slotRatio_eq_count]
    have h := root_integral_upperDrop_wordMass (k + 1) l u i p
    have heq : root_integral_wordMass (k + 1) l
      (root_integral_upperDrop (k + 1) u i) 0 = n := by
      dsimp [N,n] at *
      omega
    rw [heq]
  have hrightRoot (hu : u (0 : Fin (k + 1)) = 0) :
      slotAssignmentRatio k (fun i => l i.succ)
        (fun i => u i.succ) (l (0 : Fin (k + 1))) =
      (root_integral_validPermutationCount k (fun i => l i.succ)
        (fun i => u i.succ) (l (0 : Fin (k + 1))) : ℚ) /
        (Nat.factorial n : ℚ) := by
    rw [root_integral_slotRatio_eq_count]
    have h := root_integral_rootDrop_wordMass k l u hu
    have heq : root_integral_wordMass k (fun i => l i.succ)
      (fun i => u i.succ) (l (0 : Fin (k + 1))) = n := by
      dsimp [N,n] at *
      omega
    rw [heq]
  rw [hleft]
  have hright :
      (∑ i : Fin (k + 1), (u i : ℚ) *
        slotAssignmentRatio (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0) +
      (if u (0 : Fin (k + 1)) = 0 then
        slotAssignmentRatio k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1)))
       else 0) =
      (∑ i : Fin (k + 1), (u i : ℚ) *
        ((root_integral_validPermutationCount (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0 : ℚ) /
          (Nat.factorial n : ℚ))) +
      (if u (0 : Fin (k + 1)) = 0 then
        ((root_integral_validPermutationCount k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1))) : ℚ) /
          (Nat.factorial n : ℚ))
       else 0) := by
    apply congrArg₂ (· + ·)
    · apply Finset.sum_congr rfl
      intro i _
      by_cases hi : u i = 0
      · simp [hi]
      · let p : Fin (u i) := ⟨0, Nat.pos_of_ne_zero hi⟩
        rw [hrightUP i p]
    · by_cases hu : u (0 : Fin (k + 1)) = 0
      · simp [hu, hrightRoot hu]
      · simp [hu]
  rw [hright]
  have hnz : (Nat.factorial n : ℚ) ≠ 0 := by positivity
  have hqrec :
      ((root_integral_validPermutationCount (k + 1) l u 0 : ℚ) /
        (Nat.factorial n : ℚ)) =
      (∑ i : Fin (k + 1), (u i : ℚ) *
        ((root_integral_validPermutationCount (k + 1) l
          (root_integral_upperDrop (k + 1) u i) 0 : ℚ) /
          (Nat.factorial n : ℚ))) +
      (if u (0 : Fin (k + 1)) = 0 then
        ((root_integral_validPermutationCount k (fun i => l i.succ)
          (fun i => u i.succ) (l (0 : Fin (k + 1))) : ℚ) /
          (Nat.factorial n : ℚ))
       else 0) := by
    have hq := congrArg (fun m : ℕ => (m : ℚ) /
      (Nat.factorial n : ℚ)) hrec
    -- Every term has the SAME denominator, thanks to maximum deletion.
    push_cast at hq
    by_cases hu : u (0 : Fin (k + 1)) = 0
    · simpa [hu, Finset.sum_div, Finset.sum_mul, mul_div_assoc,
        mul_comm, mul_left_comm, mul_assoc, add_div] using hq
    · simpa [hu, Finset.sum_div, Finset.sum_mul, mul_div_assoc,
        mul_comm, mul_left_comm, mul_assoc, add_div] using hq
  exact hqrec

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Canonical block partition of the global labeling set. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The type of chains of a fixed length is finite because each chain
is uniquely determined by its function of k+1 values in a finite ideal
lattice. -/
noncomputable instance root_integral_connectedBlockChainFintype
    (D : Diagram) (k : ℕ) : Fintype (ConnectedBlockChain D k) := by
  classical
  haveI : Finite (ConnectedBlockChain D k) :=
    Finite.of_injective (fun C : ConnectedBlockChain D k => C.ideals) (by
      intro C C' h
      exact ConnectedBlockChain.ext (fun i => congrFun h i))
  exact Fintype.ofFinite _

/-- Canonically transport the compressed chain along an exact equality
of the number of blocks. No extra chain is chosen. -/
noncomputable def root_integral_canonicalChainAt
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ)
    (σ : StandardLabeling D) (hk : blockCount D σ = k) :
    ConnectedBlockChain D k := by
  cases hk
  exact canonicalCompressedChain D hsk σ

/-- The canonical chain with the transported length always realizes the
original labeling. -/
theorem root_integral_canonicalChainAt_compatible
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ)
    (σ : StandardLabeling D) (hk : blockCount D σ = k) :
    σ ∈ chainCompatibleStandardLabelings
      (root_integral_canonicalChainAt D hsk k σ hk) := by
  classical
  cases hk
  change σ ∈ (Finset.univ.filter (fun τ : StandardLabeling D =>
    ∃ roots : Fin (blockCount D σ) → ℕ,
      ConnectedChainCompatibleLabeling
        (canonicalCompressedChain D hsk σ) τ roots))
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨activeRootsDescending D σ,
    canonicalCompressedChain_compatible D hsk σ⟩

/-- The bijection between all labelings having k canonical blocks and
all pairs (strict connected chain of k blocks, compatible labeling).
The inverse sends a labeling to its UNIQUE canonical chain. -/
noncomputable def root_integral_labelings_by_chain_equiv
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ) :
    (Σ C : ConnectedBlockChain D k, ChainCompatibleLabelingType C) ≃
    {σ : StandardLabeling D // blockCount D σ = k} := by
  classical
  let F : (Σ C : ConnectedBlockChain D k,
      ChainCompatibleLabelingType C) →
      {σ : StandardLabeling D // blockCount D σ = k} := by
    intro q
    rcases q with ⟨C, ⟨σ, hσ⟩⟩
    have hcomp : ∃ roots : Fin k → ℕ,
        ConnectedChainCompatibleLabeling C σ roots := by
      simpa [chainCompatibleStandardLabelings] using hσ
    let roots : Fin k → ℕ := Classical.choose hcomp
    have hroots : ConnectedChainCompatibleLabeling C σ roots :=
      Classical.choose_spec hcomp
    have hk : k = blockCount D σ :=
      compatibleChain_length_eq_blockCount C σ roots hroots
    exact ⟨σ, hk.symm⟩
  let G : {σ : StandardLabeling D // blockCount D σ = k} →
      (Σ C : ConnectedBlockChain D k, ChainCompatibleLabelingType C) := by
    intro σ
    let C := root_integral_canonicalChainAt D hsk k σ.1 σ.2
    exact ⟨C, ⟨σ.1,
      root_integral_canonicalChainAt_compatible D hsk k σ.1 σ.2⟩⟩
  refine { toFun := F, invFun := G, left_inv := ?_, right_inv := ?_ }
  · rintro ⟨C, ⟨σ, hσ⟩⟩
    have hcomp : ∃ roots : Fin k → ℕ,
        ConnectedChainCompatibleLabeling C σ roots := by
      simpa [chainCompatibleStandardLabelings] using hσ
    obtain ⟨roots, hroots⟩ := hcomp
    have hk : k = blockCount D σ :=
      compatibleChain_length_eq_blockCount C σ roots hroots
    -- After substituting the forced block count, both first
    -- components are the same canonical chain by the preceding construction uniqueness.
    cases hk
    have hC : C = canonicalCompressedChain D hsk σ :=
      (compatibleChain_data_unique D hsk σ C roots hroots).1
    refine Sigma.ext hC.symm ?_
    cases hC
    exact HEq.rfl
  · rintro ⟨σ, hk⟩
    apply Subtype.ext
    rfl

/-- The exact cardinal partition in every degree k. There are NO
weights or integrals in this lemma. -/
theorem root_integral_card_labelings_by_chain
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ) :
    (∑ C : ConnectedBlockChain D k,
      (chainCompatibleStandardLabelings C).card) =
    (Finset.univ.filter (fun σ : StandardLabeling D =>
      blockCount D σ = k)).card := by
  classical
  calc
    (∑ C : ConnectedBlockChain D k,
      (chainCompatibleStandardLabelings C).card) =
        ∑ C : ConnectedBlockChain D k,
          Fintype.card (ChainCompatibleLabelingType C) := by
          apply Finset.sum_congr rfl
          intro C _
          simp [ChainCompatibleLabelingType, Fintype.card_subtype]
    _ = Fintype.card
          (Σ C : ConnectedBlockChain D k, ChainCompatibleLabelingType C) := by
          rw [Fintype.card_sigma]
    _ = Fintype.card
          {σ : StandardLabeling D // blockCount D σ = k} :=
          Fintype.card_congr (root_integral_labelings_by_chain_equiv D hsk k)
    _ = (Finset.univ.filter (fun σ : StandardLabeling D =>
          blockCount D σ = k)).card := by
          rw [Fintype.card_subtype]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Grouping the block polynomial by chains. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The normalized contribution of all length-k chains. -/
noncomputable def root_integral_chainCoefficient
    (D : Diagram) (k : ℕ) : ℚ :=
  ∑ C : ConnectedBlockChain D k, chainCompatibleFraction C

/-- Partition a polynomial sum over labels into the fibers of the
block count, bounded by the number of cells. -/
theorem root_integral_labelPolynomial_group_by_blockCount
    (D : Diagram) :
    (∑ σ : StandardLabeling D,
      (Polynomial.X : Polynomial ℚ) ^ blockCount D σ) =
    ∑ k ∈ Finset.range (D.card + 1),
      Polynomial.C
        ((Finset.univ.filter (fun σ : StandardLabeling D =>
          blockCount D σ = k)).card : ℚ) *
        (Polynomial.X : Polynomial ℚ) ^ k := by
  classical
  calc
    (∑ σ : StandardLabeling D,
        (Polynomial.X : Polynomial ℚ) ^ blockCount D σ) =
      ∑ σ : StandardLabeling D,
        ∑ k ∈ Finset.range (D.card + 1),
          if blockCount D σ = k then
            (Polynomial.X : Polynomial ℚ) ^ k else 0 := by
        apply Finset.sum_congr rfl
        intro σ _
        have hbound : blockCount D σ < D.card + 1 := by
          have h := blockCount_le_card D σ
          omega
        simp [Finset.mem_range, hbound]
    _ = ∑ k ∈ Finset.range (D.card + 1),
          ∑ σ : StandardLabeling D,
            if blockCount D σ = k then
              (Polynomial.X : Polynomial ℚ) ^ k else 0 := by
        rw [Finset.sum_comm]
    _ = ∑ k ∈ Finset.range (D.card + 1),
          Polynomial.C
            ((Finset.univ.filter (fun σ : StandardLabeling D =>
              blockCount D σ = k)).card : ℚ) *
            (Polynomial.X : Polynomial ℚ) ^ k := by
        apply Finset.sum_congr rfl
        intro k _
        rw [← Finset.sum_filter]
        simp [Finset.sum_const, nsmul_eq_mul]

/-- After division by n!, the combinatorial polynomial is exactly
the sum of the normalized compatible-labeling contributions of all
length-k strict connected chains. -/
theorem root_integral_normalizedPolynomial_grouped_by_chains
    (D : Diagram) (hsk : SkewRowIntervals D) :
    normalizedBlockPolynomial D =
      ∑ k ∈ Finset.range (D.card + 1),
        Polynomial.C (root_integral_chainCoefficient D k) *
          (Polynomial.X : Polynomial ℚ) ^ k := by
  classical
  let n : ℕ := Fintype.card (ShapeCell D)
  have hn : n = D.card := by
    simp [n]
  have hfact : (Nat.factorial n : ℚ) ≠ 0 := by positivity
  have hcoeff (k : ℕ) :
      (root_integral_chainCoefficient D k) =
      ((Finset.univ.filter (fun σ : StandardLabeling D =>
          blockCount D σ = k)).card : ℚ) /
        (Nat.factorial n : ℚ) := by
    unfold root_integral_chainCoefficient chainCompatibleFraction
    rw [← Finset.sum_div]
    have hc := root_integral_card_labelings_by_chain D hsk k
    rw [← Nat.cast_sum, hc]
  unfold normalizedBlockPolynomial
  rw [root_integral_labelPolynomial_group_by_blockCount]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  rw [hcoeff]
  simp only [div_eq_mul_inv, map_mul]
  ring

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Assembly of the ordered-root formula. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The exact matrix-path and orientation problem remaining once the
combinatorial coefficients have been counted.  Both sides are fixed,
independently defined rational expressions. -/
def OrderedRootGlobalKernelIdentity (D : Diagram) : Prop :=
  ∀ k : ℕ, k ≤ D.card →
    (∑ C : ConnectedBlockChain D k,
      descendingChainKernelIntegral C) = orderedKernelCoefficient D k

/-- Sum the already-constructed fixed-chain identities over the finite
type of all chains with exactly k blocks. -/
theorem root_integral_sum_fixed_chains
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ)
    (huniv : ∀ (j : ℕ) (l u : Fin j → ℕ) (f : ℕ),
      UniversalSlotIdentity j l u f) :
    root_integral_chainCoefficient D k =
      ∑ C : ConnectedBlockChain D k,
        descendingChainKernelIntegral C := by
  classical
  unfold root_integral_chainCoefficient
  apply Finset.sum_congr rfl
  intro C _
  exact packet_transport_fixed_chain_identity hsk C
    (huniv k
      (fun i => rowCount (chainBlock C i) - 1)
      (fun i => columnCount (chainBlock C i) - 1)
      (chainFreeCells C).card)

/-- Final coefficientwise assembly: from the universal finite-counting
identity and the independent kernel-path identity, the ACTUAL statement
of manuscript Lemma 6.1 follows without any extra geometric assumption.
The geometric packet equivalence is supplied by `packet_transport_geometric_identity`. -/
theorem root_integral_manuscript_of_universal_and_global
    (D : Diagram)
    (huniv : ∀ (k : ℕ) (l u : Fin k → ℕ) (f : ℕ),
      UniversalSlotIdentity k l u f)
    (hglobal : OrderedRootGlobalKernelIdentity D) :
    OrderedRootIntegralStatement D := by
  classical
  intro hsk
  rw [root_integral_normalizedPolynomial_grouped_by_chains D hsk]
  unfold orderedKernelPolynomial
  apply Finset.sum_congr rfl
  intro k hk
  have hbound : k ≤ D.card := by
    have hm := Finset.mem_range.mp hk
    omega
  have hfixed := root_integral_sum_fixed_chains D hsk k huniv
  have hmatrix := hglobal k hbound
  rw [hfixed, hmatrix]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Universal slot-identity recurrence. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

private def ordered_kernel_pairWord (k : ℕ) (l u : Fin k → ℕ) : List (ℕ × ℕ) :=
  List.ofFn (fun i : Fin k => (l i, u i))

private theorem ordered_kernel_pairWord_length (k : ℕ) (l u : Fin k → ℕ) :
    (ordered_kernel_pairWord k l u).length = k := by
  simp [ordered_kernel_pairWord]

private theorem ordered_kernel_pairWord_get
    (k : ℕ) (l u : Fin k → ℕ)
    (i : Fin (ordered_kernel_pairWord k l u).length) :
    (ordered_kernel_pairWord k l u).get i =
      (l ⟨i.val, by simpa [ordered_kernel_pairWord_length] using i.isLt⟩,
       u ⟨i.val, by simpa [ordered_kernel_pairWord_length] using i.isLt⟩) := by
  exact List.get_ofFn (fun j : Fin k => (l j, u j)) i

/-- The ratio is always a finite sum of factorial gap weights. -/
private noncomputable def ordered_kernel_wordSlotRatio (ps : List (ℕ × ℕ)) : ℚ :=
  slotAssignmentRatio ps.length
    (fun i => (ps.get i).1)
    (fun i => (ps.get i).2) 0

/-- Delete one upper cell at the given position in a list of roots. -/
private def ordered_kernel_wordUpperDrop (ps : List (ℕ × ℕ))
    (i : Fin ps.length) : List (ℕ × ℕ) :=
  (List.finRange ps.length).map (fun j =>
    ((ps.get j).1, if j = i then (ps.get j).2 - 1 else (ps.get j).2))

private theorem ordered_kernel_wordUpperDrop_head (a b : ℕ)
    (ps : List (ℕ × ℕ)) :
    ordered_kernel_wordUpperDrop ((a,b) :: ps)
      (0 : Fin (ps.length + 1)) =
      (a,b-1) :: ps := by
  have hget :
      (List.finRange ps.length).map (fun j => ps.get j) = ps :=
    List.map_get_finRange ps
  simp [ordered_kernel_wordUpperDrop, List.finRange_succ,
    List.map_map, Function.comp_def, Fin.succ_ne_zero]

private theorem ordered_kernel_wordUpperDrop_tail
    (a b : ℕ) (ps : List (ℕ × ℕ))
    (i : Fin ps.length) :
    ordered_kernel_wordUpperDrop ((a,b) :: ps) i.succ =
      (a,b) :: ordered_kernel_wordUpperDrop ps i := by
  have hz : (0 : Fin (ps.length + 1)) ≠ i.succ :=
    (Fin.succ_ne_zero i).symm
  simp [ordered_kernel_wordUpperDrop, List.finRange_succ,
    List.map_map, Function.comp_def,
    Fin.succ_inj, hz]

private theorem ordered_kernel_wordUpperDrop_vector
    (k : ℕ) (l u : Fin k → ℕ) (i : Fin k) :
    ordered_kernel_wordUpperDrop (ordered_kernel_pairWord k l u)
      ⟨i.val, by simp [ordered_kernel_pairWord_length]⟩ =
    ordered_kernel_pairWord k l (root_integral_upperDrop k u i) := by
  calc
    ordered_kernel_wordUpperDrop (ordered_kernel_pairWord k l u)
        ⟨i.val, by simp [ordered_kernel_pairWord_length]⟩ =
      (List.finRange k).map (fun j : Fin k =>
        (l j, if j = i then u j - 1 else u j)) := by
          simp only [ordered_kernel_wordUpperDrop, ordered_kernel_pairWord,
            List.length_ofFn, List.finRange, List.map_ofFn,
            Fin.ext_iff]
          congr 1
          funext j
          simp only [Function.comp_apply, List.get_ofFn,
            Fin.cast_cast, Fin.cast_eq_self, Fin.val_cast]
    _ = ordered_kernel_pairWord k l (root_integral_upperDrop k u i) := by
      simp only [ordered_kernel_pairWord, List.ofFn_eq_map,
        root_integral_upperDrop, Function.update_apply]
      congr 1
      funext j
      by_cases h : j = i
      · subst j
        rfl
      · simp only [h, ite_false]

/-- Pure list reindexing: an upper deletion in any root contributes
its OLD multiplicity, irrespective of the statistic on reduced words. -/
private theorem ordered_kernel_upperDeleteCases_reindex
    (F : List (ℕ × ℕ) → ℚ) (ps : List (ℕ × ℕ)) :
    ((upperDeleteCases ps).map
      (fun x => (x.1 : ℚ) * F x.2)).sum =
      ∑ i : Fin ps.length, ((ps.get i).2 : ℚ) *
        F (ordered_kernel_wordUpperDrop ps i) := by
  induction ps generalizing F with
  | nil =>
      simp [upperDeleteCases]
  | cons p ps ih =>
      rcases p with ⟨a, b⟩
      have htail := ih (fun xs => F ((a,b) :: xs))
      conv_rhs =>
        simp only [List.length_cons]
        rw [Fin.sum_univ_succ]
      simp only [upperDeleteCases, List.map_append,
        List.sum_append, List.map_map, Function.comp_def,
        ordered_kernel_wordUpperDrop_head, ordered_kernel_wordUpperDrop_tail]
      simp only [List.get_cons_zero, List.get_cons_succ']
      rw [← htail]
      by_cases hb : b = 0
      · simp [hb]
      · simp [hb]

/-- `get` on the original root word converts the abstract `Fin`
parameters to the correct vector of original upper multiplicities. -/
private theorem ordered_kernel_wordSlotRatio_pairWord
    (k : ℕ) (l u : Fin k → ℕ) :
    ordered_kernel_wordSlotRatio (ordered_kernel_pairWord k l u) =
      slotAssignmentRatio k l u 0 := by
  classical
  have transport
      (m : ℕ) (hm : m = k)
      (L U : Fin m → ℕ)
      (hL : ∀ j, L j = l (Fin.cast hm j))
      (hU : ∀ j, U j = u (Fin.cast hm j)) :
      slotAssignmentRatio m L U 0 =
        slotAssignmentRatio k l u 0 := by
    cases hm
    have hL' : L = l := by
      funext j
      exact hL j
    have hU' : U = u := by
      funext j
      exact hU j
    rw [hL', hU']
  unfold ordered_kernel_wordSlotRatio
  refine transport
    (ordered_kernel_pairWord k l u).length
    (ordered_kernel_pairWord_length k l u)
    (fun j => ((ordered_kernel_pairWord k l u).get j).1)
    (fun j => ((ordered_kernel_pairWord k l u).get j).2)
    ?_ ?_
  · intro j
    exact congrArg Prod.fst (ordered_kernel_pairWord_get k l u j)
  · intro j
    exact congrArg Prod.snd (ordered_kernel_pairWord_get k l u j)

private theorem ordered_kernel_wordSlotRatio_drop_pairWord
    (k : ℕ) (l u : Fin k → ℕ) (i : Fin k) :
    ordered_kernel_wordSlotRatio
      (ordered_kernel_wordUpperDrop (ordered_kernel_pairWord k l u)
        ⟨i.val, by simp [ordered_kernel_pairWord_length]⟩) =
    slotAssignmentRatio k l (root_integral_upperDrop k u i) 0 := by
  rw [ordered_kernel_wordUpperDrop_vector]
  exact ordered_kernel_wordSlotRatio_pairWord k l (root_integral_upperDrop k u i)

private theorem ordered_kernel_wordMass_pairWord
    (k : ℕ) (l u : Fin k → ℕ) :
    eulerRootMass (ordered_kernel_pairWord k l u) =
      root_integral_wordMass k l u 0 := by
  induction k with
  | zero =>
      simp [ordered_kernel_pairWord, eulerRootMass, root_integral_wordMass]
  | succ k ih =>
      let a : ℕ := l 0
      let b : ℕ := u 0
      let ls : Fin k → ℕ := fun i => l i.succ
      let us : Fin k → ℕ := fun i => u i.succ
      have hword : ordered_kernel_pairWord (k + 1) l u =
          (a,b) :: ordered_kernel_pairWord k ls us := by
        simp [ordered_kernel_pairWord, List.ofFn_eq_map,
          a, b, ls, us]
      rw [hword]
      have hm := ih ls us
      simp only [eulerRootMass, root_integral_wordMass,
        Fin.sum_univ_succ] at *
      dsimp [ls, us, a, b] at *
      omega

private theorem ordered_kernel_wordSlotRatio_empty : ordered_kernel_wordSlotRatio [] = 1 := by
  change slotAssignmentRatio 0
    (fun i : Fin 0 => (([] : List (ℕ × ℕ)).get i).1)
    (fun i : Fin 0 => (([] : List (ℕ × ℕ)).get i).2) 0 = 1
  have hl : (fun i : Fin 0 => (([] : List (ℕ × ℕ)).get i).1) =
      (fun i : Fin 0 => i.elim0) := by
    funext i; exact i.elim0
  have hu : (fun i : Fin 0 => (([] : List (ℕ × ℕ)).get i).2) =
      (fun i : Fin 0 => i.elim0) := by
    funext i; exact i.elim0
  rw [hl, hu]
  exact slotAssignmentRatio_zero_zero
    (fun i : Fin 0 => i.elim0) (fun i : Fin 0 => i.elim0)

/-- THE finite-side Euler recurrence, indexed by the very same list
of weighted deletions used in the established analytic uniqueness theorem.
No integral identity is assumed anywhere in its derivation. -/
private theorem ordered_kernel_wordSlotRatio_euler
    (a b : ℕ) (ps : List (ℕ × ℕ)) :
    (eulerRootMass ((a,b) :: ps) : ℚ) *
        ordered_kernel_wordSlotRatio ((a,b) :: ps) =
      ((upperDeleteCases ((a,b) :: ps)).map (fun x =>
        (x.1 : ℚ) * ordered_kernel_wordSlotRatio x.2)).sum +
      (if b = 0 then ordered_kernel_wordSlotRatio ps else 0) := by
  classical
  let w : List (ℕ × ℕ) := (a,b) :: ps
  let k : ℕ := ps.length
  let l : Fin (k + 1) → ℕ := fun i => (w.get i).1
  let u : Fin (k + 1) → ℕ := fun i => (w.get i).2
  have hw : w = ordered_kernel_pairWord (k + 1) l u := by
    change w = List.ofFn
      (fun j : Fin (k + 1) => ((w.get j).1, (w.get j).2))
    simpa only [Prod.mk.eta] using (List.ofFn_get w).symm
  have hm : eulerRootMass w = root_integral_wordMass (k + 1) l u 0 := by
    rw [hw]
    exact ordered_kernel_wordMass_pairWord _ _ _
  have hcount := root_integral_slotRatio_euler k l u
  have hdelete :
      ((upperDeleteCases w).map (fun x =>
          (x.1 : ℚ) * ordered_kernel_wordSlotRatio x.2)).sum =
        ∑ i : Fin (k + 1), (u i : ℚ) *
          slotAssignmentRatio (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0 := by
    have htransport
        (A B : List (ℕ × ℕ)) (h : A = B)
        (m : ℕ) (hA : m < A.length)
        (hB : m < B.length) :
        ordered_kernel_wordUpperDrop A ⟨m, hA⟩ =
          ordered_kernel_wordUpperDrop B ⟨m, hB⟩ := by
      subst B
      rfl
    rw [ordered_kernel_upperDeleteCases_reindex]
    change
      (∑ j : Fin (k + 1),
        ((w.get j).2 : ℚ) *
          ordered_kernel_wordSlotRatio (ordered_kernel_wordUpperDrop w j)) =
      ∑ j : Fin (k + 1), (u j : ℚ) *
        slotAssignmentRatio (k + 1) l
          (root_integral_upperDrop (k + 1) u j) 0
    apply Finset.sum_congr rfl
    intro j _
    have hj :
        j.val < (ordered_kernel_pairWord (k + 1) l u).length := by
      simpa only [ordered_kernel_pairWord_length] using j.isLt
    have hd :
        ordered_kernel_wordUpperDrop w j =
          ordered_kernel_wordUpperDrop (ordered_kernel_pairWord (k + 1) l u)
            ⟨j.val, hj⟩ :=
      htransport w (ordered_kernel_pairWord (k + 1) l u)
        hw j.val j.isLt hj
    change
      (u j : ℚ) *
        ordered_kernel_wordSlotRatio (ordered_kernel_wordUpperDrop w j) =
      (u j : ℚ) *
        slotAssignmentRatio (k + 1) l
          (root_integral_upperDrop (k + 1) u j) 0
    rw [hd]
    exact congrArg
      (fun z : ℚ => (u j : ℚ) * z)
      (ordered_kernel_wordSlotRatio_drop_pairWord (k + 1) l u j)
  have hhead : u 0 = b := by
    rfl
  have htail : ordered_kernel_wordSlotRatio ps =
      slotAssignmentRatio k (fun i => l i.succ)
        (fun i => u i.succ) (l 0) := by
    have hps : ps = ordered_kernel_pairWord k
        (fun i => l i.succ) (fun i => u i.succ) := by
      simp [ordered_kernel_pairWord, l, u, w, k, List.ofFn_eq_map]
    rw [hps, ordered_kernel_wordSlotRatio_pairWord]
    exact (slotAssignmentRatio_free_independent k
      (fun i => l i.succ) (fun i => u i.succ) (l 0)).symm
  change (eulerRootMass w : ℚ) * ordered_kernel_wordSlotRatio w = _
  calc
    (eulerRootMass w : ℚ) * ordered_kernel_wordSlotRatio w =
      (root_integral_wordMass (k + 1) l u 0 : ℚ) *
        slotAssignmentRatio (k + 1) l u 0 := by
          rw [hm, hw, ordered_kernel_wordSlotRatio_pairWord]
    _ = (∑ i : Fin (k + 1), (u i : ℚ) *
          slotAssignmentRatio (k + 1) l
            (root_integral_upperDrop (k + 1) u i) 0) +
          (if u 0 = 0 then
            slotAssignmentRatio k (fun i => l i.succ)
              (fun i => u i.succ) (l 0) else 0) := hcount
    _ = ((upperDeleteCases w).map (fun x =>
            (x.1 : ℚ) * ordered_kernel_wordSlotRatio x.2)).sum +
          (if b = 0 then ordered_kernel_wordSlotRatio ps else 0) := by
            rw [hdelete]
            rw [hhead]
            rw [htail]

/-- The exact universal numerical identity, with arbitrary lower,
upper and unconstrained cells. It is independent of the geometric
transport and of the global matrix identity. -/
theorem root_integral_universal_slot_formula
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :
    UniversalSlotIdentity k l u f := by
  classical
  have huniq := eulerRootIntegral_unique_from_deletion
    ordered_kernel_wordSlotRatio
    ordered_kernel_wordSlotRatio_empty
    ordered_kernel_wordSlotRatio_euler
  unfold UniversalSlotIdentity
  rw [slotAssignmentRatio_free_independent]
  have hw := huniq (ordered_kernel_pairWord k l u)
  rw [ordered_kernel_wordSlotRatio_pairWord] at hw
  rw [slotKernelIntegral_eq_eulerRootPrimitive]
  simpa only [ordered_kernel_pairWord, List.ofFn_eq_map] using hw

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Kernel symmetry and polynomial primitives. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

private noncomputable def ordered_kernel_matEval (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) (z : ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ :=
  Matrix.of (fun I J => (M I J).eval z)

private noncomputable def ordered_kernel_matC (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) :=
  Matrix.of (fun I J => Polynomial.C (M I J))

private noncomputable def ordered_kernel_matDerivative (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) :=
  Matrix.of (fun I J => Polynomial.derivative (M I J))

private noncomputable def ordered_kernel_matPrimitive (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) :=
  Matrix.of (fun I J => primitiveFromZero (M I J))

private theorem ordered_kernel_matEval_mul (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ))
    (z : ℚ) :
    ordered_kernel_matEval D (M * N) z =
      ordered_kernel_matEval D M z * ordered_kernel_matEval D N z := by
  classical
  ext I J
  simp [ordered_kernel_matEval, Matrix.mul_apply,
    Polynomial.eval_finsetSum, Polynomial.eval_mul]

private theorem ordered_kernel_matEval_const (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ) (z : ℚ) :
    ordered_kernel_matEval D (ordered_kernel_matC D M) z = M := by
  ext I J
  simp [ordered_kernel_matEval, ordered_kernel_matC]

private theorem ordered_kernel_matEval_kernel (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D (blockKernelPolynomial D) z = A D z := by
  classical
  ext I J
  exact blockKernelPolynomial_eval D z I J

/-- Every entrywise polynomial matrix equality follows from evaluation
at infinitely many rational parameters. -/
private theorem ordered_kernel_mat_ext_of_eval (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ))
    (h : ∀ z : ℚ, ordered_kernel_matEval D M z = ordered_kernel_matEval D N z) :
    M = N := by
  apply Matrix.ext
  intro I J
  apply Polynomial.eq_of_infinite_eval_eq
  have he : ({z : ℚ | (M I J).eval z = (N I J).eval z} : Set ℚ) =
      Set.univ := by
    ext z
    constructor
    · intro _; trivial
    · intro _
      exact congrFun (congrFun (h z) I) J
  rw [he]
  exact Set.infinite_univ

private theorem ordered_kernel_matDerivative_mul (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    ordered_kernel_matDerivative D (M * N) =
      ordered_kernel_matDerivative D M * N + M * ordered_kernel_matDerivative D N := by
  classical
  ext I J
  simp [ordered_kernel_matDerivative, Matrix.mul_apply,
    Polynomial.derivative_mul, Finset.sum_add_distrib]

private theorem ordered_kernel_matDerivative_const (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ) :
    ordered_kernel_matDerivative D (ordered_kernel_matC D M) = 0 := by
  classical
  ext I J
  simp [ordered_kernel_matDerivative, ordered_kernel_matC]

private theorem ordered_kernel_mat_eq_of_derivative_and_zero (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ))
    (hd : ordered_kernel_matDerivative D M = ordered_kernel_matDerivative D N)
    (hz : ordered_kernel_matEval D M 0 = ordered_kernel_matEval D N 0) : M = N := by
  apply Matrix.ext
  intro I J
  apply polynomial_eq_of_derivative_and_eval_zero
  · exact congrFun (congrFun hd I) J
  · exact congrFun (congrFun hz I) J

/-- The matrix kernel at any rational z commutes with the WHOLE
polynomial kernel as a function of an independent variable. -/
private theorem ordered_kernel_const_kernel_commutes
    (D : Diagram) (hsk : SkewRowIntervals D) (z : ℚ) :
    ordered_kernel_matC D (A D z) * blockKernelPolynomial D =
      blockKernelPolynomial D * ordered_kernel_matC D (A D z) := by
  apply ordered_kernel_mat_ext_of_eval D
  intro u
  simp only [ordered_kernel_matEval_mul, ordered_kernel_matEval_const,
    ordered_kernel_matEval_kernel]
  exact connected_block_kernels_commute D hsk z u

/-- Derivative and lower endpoint of the original ordered kernels. -/
private theorem ordered_kernel_forward_derivative (D : Diagram) (k : ℕ) :
    ordered_kernel_matDerivative D (orderedKernelPrimitive D (k + 1)) =
      orderedKernelPrimitive D k * blockKernelPolynomial D := by
  classical
  apply Matrix.ext
  intro I J
  change Polynomial.derivative (orderedKernelPrimitive D (k + 1) I J) =
    ∑ K : ShapeIdeal D, orderedKernelPrimitive D k I K *
      blockKernelPolynomial D K J
  rw [orderedKernelPrimitive_succ, derivative_primitiveFromZero]

private theorem ordered_kernel_forward_zero (D : Diagram) (k : ℕ) :
    ordered_kernel_matEval D (orderedKernelPrimitive D (k + 1)) 0 = 0 := by
  classical
  ext I J
  change (orderedKernelPrimitive D (k + 1) I J).eval 0 = 0
  rw [orderedKernelPrimitive_succ]
  exact primitiveFromZero_eval_zero _

/-- Every fixed-parameter A_z commutes with every forward polynomial
matrix integral. This is proved by differentiating the commutator,
not by assuming the desired equality of integration orders. -/
private theorem ordered_kernel_const_commutes_forward
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ) (z : ℚ) :
    ordered_kernel_matC D (A D z) * orderedKernelPrimitive D k =
      orderedKernelPrimitive D k * ordered_kernel_matC D (A D z) := by
  induction k with
  | zero =>
      simp [orderedKernelPrimitive_zero]
  | succ k ih =>
      let C := ordered_kernel_matC D (A D z)
      let R := orderedKernelPrimitive D (k + 1)
      let P := blockKernelPolynomial D
      apply ordered_kernel_mat_eq_of_derivative_and_zero D
      · calc
          ordered_kernel_matDerivative D (C * R) =
              C * (orderedKernelPrimitive D k * P) := by
                rw [ordered_kernel_matDerivative_mul, ordered_kernel_matDerivative_const,
                  zero_mul, zero_add, ordered_kernel_forward_derivative]
          _ = (orderedKernelPrimitive D k * P) * C := by
                calc
                  C * (orderedKernelPrimitive D k * P) =
                      (C * orderedKernelPrimitive D k) * P := by
                        rw [mul_assoc]
                  _ = (orderedKernelPrimitive D k * C) * P := by
                        rw [ih]
                  _ = orderedKernelPrimitive D k * (C * P) := by
                        rw [mul_assoc]
                  _ = orderedKernelPrimitive D k * (P * C) := by
                        rw [ordered_kernel_const_kernel_commutes D hsk z]
                  _ = (orderedKernelPrimitive D k * P) * C := by
                        rw [mul_assoc]
          _ = ordered_kernel_matDerivative D (R * C) := by
                rw [ordered_kernel_matDerivative_mul, ordered_kernel_matDerivative_const,
                  mul_zero, add_zero, ordered_kernel_forward_derivative]
      · rw [ordered_kernel_matEval_mul, ordered_kernel_matEval_mul]
        simp [ordered_kernel_forward_zero D k]

/-- A(X) commutes with every polynomial iterated forward integral R_k(X).
The independent-parameter commutation of §5.4 is essential here. -/
private theorem ordered_kernel_kernel_commutes_forward
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ) :
    blockKernelPolynomial D * orderedKernelPrimitive D k =
      orderedKernelPrimitive D k * blockKernelPolynomial D := by
  apply ordered_kernel_mat_ext_of_eval D
  intro z
  have h := congrArg (fun M => ordered_kernel_matEval D M z)
    (ordered_kernel_const_commutes_forward D hsk k z)
  simp only [ordered_kernel_matEval_mul, ordered_kernel_matEval_const,
    ordered_kernel_matEval_kernel] at h ⊢
  exact h

/-- Same ordered-root integration with the NEWEST (first) edge at the
outermost integration variable. Its derivative is A(X)*L_k(X). -/
private noncomputable def ordered_kernel_reverseKernelPrimitive (D : Diagram) :
    ℕ → Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)
  | 0 => by classical exact 1
  | k + 1 => by
      classical
      exact Matrix.of (fun I J =>
        primitiveFromZero
          (∑ K : ShapeIdeal D,
            blockKernelPolynomial D I K *
              ordered_kernel_reverseKernelPrimitive D k K J))

private theorem ordered_kernel_reverse_derivative (D : Diagram) (k : ℕ) :
    ordered_kernel_matDerivative D (ordered_kernel_reverseKernelPrimitive D (k + 1)) =
      blockKernelPolynomial D * ordered_kernel_reverseKernelPrimitive D k := by
  classical
  apply Matrix.ext
  intro I J
  change Polynomial.derivative
    (primitiveFromZero (∑ K : ShapeIdeal D,
      blockKernelPolynomial D I K *
        ordered_kernel_reverseKernelPrimitive D k K J)) = _
  simp [derivative_primitiveFromZero, Matrix.mul_apply]

private theorem ordered_kernel_reverse_zero (D : Diagram) (k : ℕ) :
    ordered_kernel_matEval D (ordered_kernel_reverseKernelPrimitive D (k + 1)) 0 = 0 := by
  classical
  ext I J
  change (primitiveFromZero (∑ K : ShapeIdeal D,
    blockKernelPolynomial D I K *
      ordered_kernel_reverseKernelPrimitive D k K J)).eval 0 = 0
  exact primitiveFromZero_eval_zero _

/-- The TWO integration orders agree as polynomial matrices. -/
theorem root_integral_forward_reverse_polynomial_kernel
    (D : Diagram) (hsk : SkewRowIntervals D) (k : ℕ) :
    ordered_kernel_reverseKernelPrimitive D k = orderedKernelPrimitive D k := by
  induction k with
  | zero => rfl
  | succ k ih =>
      apply ordered_kernel_mat_eq_of_derivative_and_zero D
      · rw [ordered_kernel_reverse_derivative, ordered_kernel_forward_derivative, ih]
        exact ordered_kernel_kernel_commutes_forward D hsk k
      · rw [ordered_kernel_reverse_zero, ordered_kernel_forward_zero]

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Enumeration of connected-block paths. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

private abbrev OrderedKernelPath (D : Diagram) (k : ℕ)
    (I J : ShapeIdeal D) :=
  {v : Fin (k + 1) → ShapeIdeal D //
    v ⟨0, Nat.zero_lt_succ k⟩ = I ∧
    v ⟨k, Nat.lt_succ_self k⟩ = J ∧
    ∀ i : Fin k,
      IsConnectedBlockIncrement D (v i.castSucc) (v i.succ)}

private noncomputable instance orderedKernelPathFintype
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D) :
    Fintype (OrderedKernelPath D k I J) := by
  classical
  infer_instance

/-- For fixed bottom and top endpoints, paths are literally the
`ConnectedBlockChain` objects of the proved §6 foundation. -/
private noncomputable def orderedKernelPathChainEquiv (D : Diagram) (k : ℕ) :
    OrderedKernelPath D k
      (FinitePoset.bottomIdeal (α := ShapeCell D))
      (FinitePoset.topIdeal (α := ShapeCell D)) ≃
    ConnectedBlockChain D k := by
  classical
  refine {
    toFun := fun p =>
      { ideals := p.1, starts := p.2.1,
        finishes := p.2.2.1, steps := p.2.2.2 }
    invFun := fun C =>
      ⟨C.ideals, C.starts, C.finishes, C.steps⟩
    left_inv := ?_
    right_inv := ?_ }
  · intro p
    apply Subtype.ext
    rfl
  · intro C
    cases C
    rfl

private noncomputable def orderedKernelPathPolynomial
    {D : Diagram} {k : ℕ} {I J : ShapeIdeal D}
    (p : OrderedKernelPath D k I J) : Polynomial ℚ :=
  (((List.finRange k).map (fun i =>
    blockKernelPolynomial D (p.1 i.castSucc) (p.1 i.succ))).reverse).foldl
      (fun F q => primitiveFromZero (F * q)) 1

/-- Split a nonempty ideal path into its first connected step and a
shorter path between the new intermediate ideal and the original end. -/
private noncomputable def orderedKernelPathHeadEquiv
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D) :
    OrderedKernelPath D (k + 1) I J ≃
      (Σ K : ShapeIdeal D,
        PLift (IsConnectedBlockIncrement D I K) ×
          OrderedKernelPath D k K J) := by
  classical
  let F : OrderedKernelPath D (k + 1) I J →
      (Σ K : ShapeIdeal D,
        PLift (IsConnectedBlockIncrement D I K) ×
          OrderedKernelPath D k K J) := by
    intro p
    let K := p.1 (Fin.succ (0 : Fin (k + 1)))
    have hstep : IsConnectedBlockIncrement D I K := by
      have h := p.2.2.2 (0 : Fin (k + 1))
      change IsConnectedBlockIncrement D
        (p.1 (0 : Fin (k + 2))) K at h
      exact p.2.1 ▸ h
    let tail : OrderedKernelPath D k K J :=
      ⟨fun i => p.1 i.succ,
       by rfl,
       by simpa using p.2.2.1,
       by
         intro i
         simpa using p.2.2.2 i.succ⟩
    exact ⟨K, (⟨hstep⟩, tail)⟩
  let G :
      (Σ K : ShapeIdeal D,
        PLift (IsConnectedBlockIncrement D I K) ×
          OrderedKernelPath D k K J) →
      OrderedKernelPath D (k + 1) I J := by
    rintro ⟨K, ⟨⟨hstep⟩, tail⟩⟩
    refine ⟨Fin.cons I tail.1, ?_, ?_, ?_⟩
    · simp
    · simpa [Fin.cons] using tail.2.2.1
    · intro i
      cases i using Fin.cases with
      | zero =>
          change IsConnectedBlockIncrement D I
            (tail.1 (0 : Fin (k + 1)))
          exact tail.2.1.symm ▸ hstep
      | succ i =>
          simpa using tail.2.2.2 i
  refine {
    toFun := F
    invFun := G
    left_inv := ?_
    right_inv := ?_
  }
  · intro p
    apply Subtype.ext
    funext i
    cases i using Fin.cases with
    | zero =>
        simpa [F, G, Fin.cons] using p.2.1.symm
    | succ i =>
        rfl
  · rintro ⟨K, ⟨⟨hstep⟩, tail⟩⟩
    rcases tail with ⟨v, ⟨hstart, hend, hsteps⟩⟩
    subst K
    rfl


/-- A descending-root path integral is one primitive of its FIRST
step times the descending-root integral of its remaining steps. -/
private theorem orderedKernelPathPolynomial_head
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D)
    (p : OrderedKernelPath D (k + 1) I J) :
    orderedKernelPathPolynomial p =
      primitiveFromZero
        (blockKernelPolynomial D I
          (orderedKernelPathHeadEquiv D k I J p).1 *
         orderedKernelPathPolynomial
           (orderedKernelPathHeadEquiv D k I J p).2.2) := by
  classical
  let q := orderedKernelPathHeadEquiv D k I J p
  have hpath :
      (List.finRange (k + 1)).map (fun i =>
        blockKernelPolynomial D (p.1 i.castSucc) (p.1 i.succ)) =
      blockKernelPolynomial D I q.1 ::
        (List.finRange k).map (fun i =>
          blockKernelPolynomial D (q.2.2.1 i.castSucc)
            (q.2.2.1 i.succ)) := by
    rw [List.finRange_succ]
    simp only [List.map_cons, List.map_map]
    congr 1
    · change
        blockKernelPolynomial D
          (p.1 (Fin.castSucc (0 : Fin (k + 1))))
          (p.1 (Fin.succ (0 : Fin (k + 1)))) =
        blockKernelPolynomial D I
          (p.1 (Fin.succ (0 : Fin (k + 1))))
      exact congrArg
        (fun X : ShapeIdeal D =>
          blockKernelPolynomial D X
            (p.1 (Fin.succ (0 : Fin (k + 1)))))
        p.2.1
  unfold orderedKernelPathPolynomial
  rw [hpath, List.reverse_cons, List.foldl_append]
  simp only [List.foldl_cons, List.foldl_nil]
  congr 1
  ring

private noncomputable def orderedKernelPathPolynomialSum
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D) : Polynomial ℚ :=
  ∑ p : OrderedKernelPath D k I J, orderedKernelPathPolynomial p

/-- One step of exact path integration. Invalid steps have polynomial
kernel zero, so the unrestricted intermediate-ideal sum is valid. -/
private theorem orderedKernelPathPolynomialSum_succ
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D) :
    orderedKernelPathPolynomialSum D (k + 1) I J =
      primitiveFromZero (∑ K : ShapeIdeal D,
        blockKernelPolynomial D I K *
          orderedKernelPathPolynomialSum D k K J) := by
  classical
  let e := orderedKernelPathHeadEquiv D k I J
  have hreindex :
      orderedKernelPathPolynomialSum D (k + 1) I J =
        ∑ q : (Σ K : ShapeIdeal D,
          PLift (IsConnectedBlockIncrement D I K) ×
            OrderedKernelPath D k K J),
          orderedKernelPathPolynomial (e.symm q) := by
    unfold orderedKernelPathPolynomialSum
    apply Fintype.sum_equiv e _ _
    intro p
    simp
  have hpoly
      (q : Σ K : ShapeIdeal D,
        PLift (IsConnectedBlockIncrement D I K) ×
          OrderedKernelPath D k K J) :
      orderedKernelPathPolynomial (e.symm q) =
        primitiveFromZero
          (blockKernelPolynomial D I q.1 *
            orderedKernelPathPolynomial q.2.2) := by
    have h := orderedKernelPathPolynomial_head D k I J (e.symm q)
    change orderedKernelPathPolynomial (e.symm q) =
      primitiveFromZero
        (blockKernelPolynomial D I (e (e.symm q)).1 *
          orderedKernelPathPolynomial (e (e.symm q)).2.2) at h
    have hq : e (e.symm q) = q :=
      e.apply_symm_apply q
    exact h.trans (congrArg
      (fun r : (Σ K : ShapeIdeal D,
          PLift (IsConnectedBlockIncrement D I K) ×
            OrderedKernelPath D k K J) =>
        primitiveFromZero
          (blockKernelPolynomial D I r.1 *
            orderedKernelPathPolynomial r.2.2))
      hq)
  have hsplit :
      (∑ q : (Σ K : ShapeIdeal D,
        PLift (IsConnectedBlockIncrement D I K) ×
          OrderedKernelPath D k K J),
        orderedKernelPathPolynomial (e.symm q)) =
      ∑ K : ShapeIdeal D,
        ∑ ht : PLift (IsConnectedBlockIncrement D I K),
          ∑ p : OrderedKernelPath D k K J,
            primitiveFromZero
              (blockKernelPolynomial D I K *
                orderedKernelPathPolynomial p) := by
    rw [Fintype.sum_sigma]
    apply Finset.sum_congr rfl
    intro K _
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro ht _
    apply Finset.sum_congr rfl
    intro p _
    exact hpoly ⟨K, (ht, p)⟩
  have hinner (K : ShapeIdeal D) :
      (∑ ht : PLift (IsConnectedBlockIncrement D I K),
        ∑ p : OrderedKernelPath D k K J,
          primitiveFromZero
            (blockKernelPolynomial D I K *
              orderedKernelPathPolynomial p)) =
      primitiveFromZero
        (blockKernelPolynomial D I K *
          orderedKernelPathPolynomialSum D k K J) := by
    by_cases h : IsConnectedBlockIncrement D I K
    · have hone :
          (∑ ht : PLift (IsConnectedBlockIncrement D I K),
            ∑ p : OrderedKernelPath D k K J,
              primitiveFromZero
                (blockKernelPolynomial D I K *
                  orderedKernelPathPolynomial p)) =
          ∑ p : OrderedKernelPath D k K J,
            primitiveFromZero
              (blockKernelPolynomial D I K *
                orderedKernelPathPolynomial p) :=
        Fintype.sum_subsingleton _ ⟨h⟩
      rw [hone]
      calc
        (∑ p : OrderedKernelPath D k K J,
          primitiveFromZero
            (blockKernelPolynomial D I K *
              orderedKernelPathPolynomial p)) =
          primitiveFromZero
            (∑ p : OrderedKernelPath D k K J,
              blockKernelPolynomial D I K *
                orderedKernelPathPolynomial p) := by
            exact (primitiveFromZero_finset_sum
              Finset.univ
              (fun p : OrderedKernelPath D k K J =>
                blockKernelPolynomial D I K *
                  orderedKernelPathPolynomial p)).symm
        _ = primitiveFromZero
              (blockKernelPolynomial D I K *
                orderedKernelPathPolynomialSum D k K J) := by
            unfold orderedKernelPathPolynomialSum
            rw [Finset.mul_sum]
    · have hz : blockKernelPolynomial D I K = 0 := by
        have h' :
            ¬ (I.1 ⊂ K.1 ∧
              ConnectedSkewRows (intervalCells D I K)) := h
        simp only [blockKernelPolynomial, Matrix.of_apply, ite_eq_right h']
      have : IsEmpty
          (PLift (IsConnectedBlockIncrement D I K)) :=
        ⟨fun ht => h ht.down⟩
      rw [Fintype.sum_empty, hz]
      simp only [zero_mul, primitiveFromZero_zero]
  calc
    orderedKernelPathPolynomialSum D (k + 1) I J =
        ∑ q : (Σ K : ShapeIdeal D,
          PLift (IsConnectedBlockIncrement D I K) ×
            OrderedKernelPath D k K J),
          orderedKernelPathPolynomial (e.symm q) := hreindex
    _ = ∑ K : ShapeIdeal D,
          ∑ ht : PLift (IsConnectedBlockIncrement D I K),
            ∑ p : OrderedKernelPath D k K J,
              primitiveFromZero
                (blockKernelPolynomial D I K *
                  orderedKernelPathPolynomial p) := hsplit
    _ = ∑ K : ShapeIdeal D,
          primitiveFromZero
            (blockKernelPolynomial D I K *
              orderedKernelPathPolynomialSum D k K J) := by
          apply Finset.sum_congr rfl
          intro K _
          exact hinner K
    _ = primitiveFromZero
          (∑ K : ShapeIdeal D,
            blockKernelPolynomial D I K *
              orderedKernelPathPolynomialSum D k K J) := by
          exact (primitiveFromZero_finset_sum
            Finset.univ
            (fun K : ShapeIdeal D =>
              blockKernelPolynomial D I K *
                orderedKernelPathPolynomialSum D k K J)).symm

/-- Exactly the backward polynomial matrix primitive, for all endpoints.
No local or global Kahane counting identity is used. -/
private theorem orderedKernelPathPolynomialSum_eq_reverse
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D) :
    orderedKernelPathPolynomialSum D k I J =
      ordered_kernel_reverseKernelPrimitive D k I J := by
  induction k generalizing I with
  | zero =>
      classical
      by_cases h : I = J
      · subst J
        have hfilter :
            (Finset.univ.filter
              (fun x : Fin 1 → ShapeIdeal D => x 0 = I)) =
              {fun _ => I} := by
          ext x
          simp only [Finset.mem_filter, Finset.mem_univ,
            true_and, Finset.mem_singleton]
          constructor
          · intro hx
            funext i
            have hi : i = (0 : Fin 1) :=
              Subsingleton.elim i 0
            simpa only [hi] using hx
          · intro hx
            rw [hx]
        have hcard :
            (Finset.univ.filter
              (fun x : Fin 1 → ShapeIdeal D => x 0 = I)).card = 1 := by
          rw [hfilter]
          exact Finset.card_singleton _
        simpa [orderedKernelPathPolynomialSum, OrderedKernelPath,
          orderedKernelPathPolynomial, ordered_kernel_reverseKernelPrimitive,
          Fintype.card_subtype] using hcard
      · have hnot :
            ∀ ⦃x : Fin 1 → ShapeIdeal D⦄,
              x 0 = I → ¬ x 0 = J := by
          intro x hx hy
          exact h (hx.symm.trans hy)
        simpa [orderedKernelPathPolynomialSum, OrderedKernelPath,
          orderedKernelPathPolynomial, ordered_kernel_reverseKernelPrimitive,
          h, Fintype.card_subtype] using hnot
  | succ k ih =>
      rw [orderedKernelPathPolynomialSum_succ]
      change primitiveFromZero
        (∑ K : ShapeIdeal D,
          blockKernelPolynomial D I K *
            orderedKernelPathPolynomialSum D k K J) =
        primitiveFromZero (∑ K : ShapeIdeal D,
          blockKernelPolynomial D I K *
            ordered_kernel_reverseKernelPrimitive D k K J)
      apply congrArg primitiveFromZero
      apply Finset.sum_congr rfl
      intro K _
      rw [ih K]

/-- All concrete strict connected chains give exactly the reversed
polynomial-matrix kernel, before endpoint evaluation. -/
private theorem ordered_kernel_chain_sum_polynomial
    (D : Diagram) (k : ℕ) :
    (∑ C : ConnectedBlockChain D k,
      orderedKernelPathPolynomial
        ((orderedKernelPathChainEquiv D k).symm C)) =
      ordered_kernel_reverseKernelPrimitive D k
        (FinitePoset.bottomIdeal (α := ShapeCell D))
        (FinitePoset.topIdeal (α := ShapeCell D)) := by
  classical
  have heq := orderedKernelPathPolynomialSum_eq_reverse D k
    (FinitePoset.bottomIdeal (α := ShapeCell D))
    (FinitePoset.topIdeal (α := ShapeCell D))
  unfold orderedKernelPathPolynomialSum at heq
  calc
    (∑ C : ConnectedBlockChain D k,
        orderedKernelPathPolynomial ((orderedKernelPathChainEquiv D k).symm C)) =
      ∑ p : OrderedKernelPath D k
          (FinitePoset.bottomIdeal (α := ShapeCell D))
          (FinitePoset.topIdeal (α := ShapeCell D)),
        orderedKernelPathPolynomial p := by
          symm
          apply Fintype.sum_equiv (orderedKernelPathChainEquiv D k)
          intro p
          rfl
    _ = _ := heq

/-- Last missing independent matrix identity. This closes the
permutation of root-integral order by combining exact path expansion
with the already-proved commutativity of A. -/
theorem root_integral_global_kernel_identity
    (D : Diagram) (hsk : SkewRowIntervals D) :
    OrderedRootGlobalKernelIdentity D := by
  classical
  intro k hk
  have heq := ordered_kernel_chain_sum_polynomial D k
  have hsym := root_integral_forward_reverse_polynomial_kernel D hsk k
  unfold orderedKernelCoefficient descendingChainKernelIntegral
  rw [← hsym]
  rw [← heq]
  rw [← Polynomial.eval_finsetSum]
  apply congrArg (Polynomial.eval (1 : ℚ))
  apply Finset.sum_congr rfl
  intro C _
  rfl

end OrderedRootIntegral
end OrderIdealSpecializations


/-! ### §6.1 — Lemma 6.1: ordered-root integral identity. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- **Lemma 6.1 (Ordered-root integral).**
Formal statement: the normalized polynomial of the corrected block
statistic is the polynomial of ordered products of the block kernels. -/
theorem ordered_root_integral_identity (D : Diagram) :
    OrderedRootIntegralStatement D := by
  intro hsk
  have hall : ∀ (k : ℕ) (l u : Fin k → ℕ) (f : ℕ),
      UniversalSlotIdentity k l u f :=
    root_integral_universal_slot_formula
  have hmatrix : OrderedRootGlobalKernelIdentity D :=
    root_integral_global_kernel_identity D hsk
  exact (root_integral_manuscript_of_universal_and_global
    D hall hmatrix) hsk

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### Theorem 6.2 — Polynomial transfer and zeta-matrix identities. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- The logarithmic-derivative identity from Lemma 5.3, now in its
explicit right-multiplication form.  No formal matrix logarithm or
additional inverse hypothesis is used. -/
theorem tableau_ode_Tprime_eq_T_mul_A
    (D : Diagram) (hsk : SkewRowIntervals D) (x : ℚ) :
    Tprime D x = T D x * A D (1 - x) := by
  classical
  obtain ⟨hQT, hQA⟩ :=
    vertical_strip_inverse_and_log_derivative D hsk x
  have hTQ : T D x * Q D x = 1 :=
    (mul_eq_one_comm).mp hQT
  calc
    Tprime D x = (T D x * Q D x) * Tprime D x := by
      rw [hTQ, one_mul]
    _ = T D x * (Q D x * Tprime D x) := by
      rw [mul_assoc]
    _ = T D x * A D (1 - x) := by
      rw [hQA]

/-- Every transfer matrix commutes with every connected-block
kernel. This cross-family commutation is the algebraic input needed
when differentiating powers of the inverse transfer. -/
theorem tableau_ode_T_commutes_A
    (D : Diagram) (hsk : SkewRowIntervals D) (x z : ℚ) :
    T D x * A D z = A D z * T D x := by
  classical
  let y : ℚ := 1 - z
  have hQT : Q D y * T D y = 1 :=
    (vertical_strip_inverse_and_log_derivative D hsk y).1
  have hTQ : T D y * Q D y = 1 :=
    (mul_eq_one_comm).mp hQT
  have hTQcomm : T D x * Q D y = Q D y * T D x :=
    (inverse_commutes_with (Q D y) (T D y) (T D x)
      hQT hTQ (tableau_transfer_matrices_commute D hsk y x)).symm
  have hTPcomm : T D x * Tprime D y = Tprime D y * T D x :=
    transfer_commutes_with_derivatives D hsk x y
  have hA : A D z = Q D y * Tprime D y := by
    have h := (vertical_strip_inverse_and_log_derivative D hsk y).2
    have hy : 1 - y = z := by
      dsimp [y]
      ring
    rw [hy] at h
    exact h.symm
  calc
    T D x * A D z = T D x * (Q D y * Tprime D y) := by
      rw [hA]
    _ = (T D x * Q D y) * Tprime D y := by
      rw [mul_assoc]
    _ = (Q D y * T D x) * Tprime D y := by
      rw [hTQcomm]
    _ = Q D y * (T D x * Tprime D y) := by
      rw [mul_assoc]
    _ = Q D y * (Tprime D y * T D x) := by
      rw [hTPcomm]
    _ = A D z * T D x := by
      rw [hA, mul_assoc]

/-- The rational inverse transfer is the identity at x=0. -/
theorem tableau_ode_Q_zero (D : Diagram)
    (hsk : SkewRowIntervals D) : Q D 0 = 1 := by
  have h := (vertical_strip_inverse_and_log_derivative D hsk 0).1
  rw [T_zero, mul_one] at h
  exact h

/-- At x=1 the vertical-strip matrix Q is a left inverse of Z. -/
theorem tableau_ode_Q_one_mul_Z (D : Diagram)
    (hsk : SkewRowIntervals D) : Q D 1 * Z D = 1 := by
  have h := (vertical_strip_inverse_and_log_derivative D hsk 1).1
  rw [T_one] at h
  exact h

/-- The same Q is a right inverse of Z, using finite square matrices. -/
theorem tableau_ode_Z_mul_Q_one (D : Diagram)
    (hsk : SkewRowIntervals D) : Z D * Q D 1 = 1 := by
  have h := tableau_ode_Q_one_mul_Z D hsk
  exact (mul_eq_one_comm).mp h

/-- Relate the rational zeta-matrix entries to the natural-number
incidence matrix used in the already proved order-polynomial lemma. -/
private theorem tableau_ode_Z_natCast (D : Diagram)
    (I J : ShapeIdeal D) :
    Z D I J =
      (FinitePoset.idealZeta (α := ShapeCell D) I J : ℚ) := by
  classical
  by_cases h : I.1 ⊆ J.1
  · have hZ : Z D I J = 1 := by
      change (if I.1 ⊆ J.1 then (1 : ℚ) else 0) = 1
      exact ite_eq_left h
    rw [hZ, FinitePoset.idealZeta_of_subset I J h]
    norm_num
  · have hZ : Z D I J = 0 := by
      change (if I.1 ⊆ J.1 then (1 : ℚ) else 0) = 0
      exact ite_eq_right h
    rw [hZ, FinitePoset.idealZeta_of_not_subset I J h]
    norm_num

/-- Casting the full natural-number zeta-matrix power to the rationals
agrees with taking the power after casting the entries. -/
theorem tableau_ode_Z_pow_natCast (D : Diagram) :
    ∀ m : ℕ, ∀ I J : ShapeIdeal D,
      (Z D ^ m) I J =
        ((FinitePoset.idealZeta (α := ShapeCell D) ^ m) I J : ℚ) := by
  classical
  intro m
  induction m with
  | zero =>
      intro I J
      by_cases h : I = J
      · subst J
        simp
      · simp [h]
  | succ m ih =>
      intro I J
      calc
        (Z D ^ (m + 1)) I J =
            ∑ K : ShapeIdeal D, (Z D ^ m) I K * Z D K J := by
              rw [pow_succ, Matrix.mul_apply]
        _ = ∑ K : ShapeIdeal D,
              ((FinitePoset.idealZeta (α := ShapeCell D) ^ m) I K : ℚ) *
                (FinitePoset.idealZeta (α := ShapeCell D) K J : ℚ) := by
              apply Finset.sum_congr rfl
              intro K _
              rw [ih I K, tableau_ode_Z_natCast D K J]
        _ = ((FinitePoset.idealZeta (α := ShapeCell D) ^ (m + 1)) I J : ℚ) := by
              rw [pow_succ, Matrix.mul_apply]
              simp only [Nat.cast_sum, Nat.cast_mul]

/-- This is the exact bridge from Lemma 2.2 to the rational matrices of
Theorem 6.2: Z^(m+1) counts order-preserving (m+1)-colorings. -/
theorem tableau_ode_Z_pow_bottom_top_eq_omega (D : Diagram) (m : ℕ) :
    (Z D ^ (m + 1))
        (FinitePoset.bottomIdeal (α := ShapeCell D))
        (FinitePoset.topIdeal (α := ShapeCell D)) =
      (FinitePoset.omega (α := ShapeCell D) (m + 1) : ℚ) := by
  rw [tableau_ode_Z_pow_natCast D (m + 1)
    (FinitePoset.bottomIdeal (α := ShapeCell D))
    (FinitePoset.topIdeal (α := ShapeCell D))]
  exact congrArg (fun n : ℕ => (n : ℚ))
    (FinitePoset.idealZeta_pow_bottom_top_eq_omega
      (α := ShapeCell D) m)

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Exact natural-argument formulation of the target manuscript
Theorem 6.2. Multiplying by n! recovers equation (6.2); since the
left side is an actual rational polynomial in t, equality at all
natural values characterizes the entire order polynomial.

Proposition expressing the block-statistic identity in terms of
natural evaluations of the normalized polynomial. -/
def SkewBlockStatisticStatement (D : Diagram) : Prop :=
  SkewRowIntervals D →
    ∀ m : ℕ,
      (normalizedBlockPolynomial D).eval (m : ℚ) =
        (FinitePoset.omega (α := ShapeCell D) m : ℚ)

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.2 — Reflected polynomial transfer matrices. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.2 — Reflected polynomial transfer matrices. -/

/-- A genuine polynomial matrix specializing to T_(1-z). -/
private noncomputable def tableau_ode_shiftT (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then
      (1 - Polynomial.X) ^ columnCount (intervalCells D I J)
    else 0)

/-- A polynomial matrix specializing to the *explicit* strip inverse
Q_(1-z), rather than to an unformalized matrix inverse. -/
private noncomputable def tableau_ode_shiftQ (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊆ J.1 then
      if IsVerticalStrip (intervalCells D I J) then
        (-(1 - Polynomial.X)) ^
            verticalRunCount (intervalCells D I J) *
          Polynomial.X ^
            ((intervalCells D I J).card -
              verticalRunCount (intervalCells D I J))
      else 0
    else 0)

private theorem tableau_ode_shiftT_eval (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D (tableau_ode_shiftT D) z = T D (1 - z) := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matEval, tableau_ode_shiftT, T, Matrix.of_apply]
  by_cases h : I.1 ⊆ J.1
  · simp only [ite_eq_left h, Polynomial.eval_pow, Polynomial.eval_sub,
      Polynomial.eval_one, Polynomial.eval_X]
  · simp only [ite_eq_right h, Polynomial.eval_zero]

private theorem tableau_ode_shiftQ_eval (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D (tableau_ode_shiftQ D) z = Q D (1 - z) := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matEval, tableau_ode_shiftQ, Q, Matrix.of_apply]
  by_cases h : I.1 ⊆ J.1
  · simp only [ite_eq_left h]
    by_cases hv : IsVerticalStrip (intervalCells D I J)
    · simp only [ite_eq_left hv, verticalStripCoefficient,
        Polynomial.eval_mul, Polynomial.eval_pow,
        Polynomial.eval_neg, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_X]
      have hz : (1 : ℚ) - (1 - z) = z := by ring
      rw [hz]
    · simp only [ite_eq_right hv, verticalStripCoefficient,
        Polynomial.eval_zero]
  · simp only [ite_eq_right h, Polynomial.eval_zero]

private theorem tableau_ode_matEval_one (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D
      (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) z = 1 := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matEval, Matrix.of_apply, Matrix.one_apply]
  by_cases h : I = J
  · simp only [ite_eq_left h, Polynomial.eval_one]
  · simp only [ite_eq_right h, Polynomial.eval_zero]

private theorem tableau_ode_matDerivative_one (D : Diagram) :
    ordered_kernel_matDerivative D
      (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) = 0 := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matDerivative, Matrix.of_apply,
    Matrix.one_apply, Matrix.zero_apply]
  by_cases h : I = J
  · simp only [ite_eq_left h, Polynomial.derivative_one]
  · simp only [ite_eq_right h, Polynomial.derivative_zero]

private theorem tableau_ode_matEval_neg (D : Diagram)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) (z : ℚ) :
    ordered_kernel_matEval D (-M) z = -ordered_kernel_matEval D M z := by
  classical
  apply Matrix.ext
  intro I J
  change Polynomial.eval z (-(M I J)) = -(Polynomial.eval z (M I J))
  exact Polynomial.eval_neg (M I J) z

/-! ### §6.2 — Polynomial inverse and derivative identities. -/

/-- The rational inverse identity holds over the entire polynomial ring:
no division by a variable and no rational-function matrix is required. -/
theorem tableau_ode_shiftT_mul_shiftQ
    (D : Diagram) (hsk : SkewRowIntervals D) :
    tableau_ode_shiftT D * tableau_ode_shiftQ D = 1 := by
  classical
  apply ordered_kernel_mat_ext_of_eval D
  intro z
  rw [ordered_kernel_matEval_mul, tableau_ode_shiftT_eval,
    tableau_ode_shiftQ_eval, tableau_ode_matEval_one]
  exact (mul_eq_one_comm).mp
    ((vertical_strip_inverse_and_log_derivative D hsk (1 - z)).1)

/-- The reverse inverse holds in the finite square polynomial-matrix ring. -/
theorem tableau_ode_shiftQ_mul_shiftT
    (D : Diagram) (hsk : SkewRowIntervals D) :
    tableau_ode_shiftQ D * tableau_ode_shiftT D = 1 := by
  exact (mul_eq_one_comm).mp (tableau_ode_shiftT_mul_shiftQ D hsk)

/-- Elementary derivative of a reflected monomial, including n=0. -/
private theorem tableau_ode_derivative_one_sub_X_pow (n : ℕ) (z : ℚ) :
    (Polynomial.derivative
      ((1 - Polynomial.X : Polynomial ℚ) ^ n)).eval z =
        -((n : ℚ) * (1 - z) ^ (n - 1)) := by
  cases n with
  | zero =>
      simp only [pow_zero, Polynomial.derivative_one, Polynomial.eval_zero,
        Nat.cast_zero, zero_mul, neg_zero]
  | succ n =>
      rw [Polynomial.derivative_pow_succ]
      simp only [Nat.succ_sub_one, Polynomial.derivative_sub,
        Polynomial.derivative_one, Polynomial.derivative_X,
        zero_sub, Polynomial.eval_mul, Polynomial.eval_pow,
        Polynomial.eval_neg, Polynomial.eval_sub,
        Polynomial.eval_one, Polynomial.eval_X,
        Polynomial.eval_C, Nat.cast_succ]
      ring_nf

private theorem tableau_ode_shiftT_derivative_eval
    (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D (ordered_kernel_matDerivative D (tableau_ode_shiftT D)) z =
      -(Tprime D (1 - z)) := by
  classical
  apply Matrix.ext
  intro I J
  simp only [Matrix.neg_apply, ordered_kernel_matEval, ordered_kernel_matDerivative,
    Matrix.of_apply, tableau_ode_shiftT]
  by_cases h : I.1 ⊆ J.1
  · simp only [ite_eq_left h]
    rw [Tprime_of_subset D (1 - z) I J h]
    exact tableau_ode_derivative_one_sub_X_pow
      (columnCount (intervalCells D I J)) z
  · simp only [ite_eq_right h, Polynomial.derivative_zero, Polynomial.eval_zero]
    rw [Tprime_of_not_subset D (1 - z) I J h]
    exact neg_zero.symm

/-- S'(X) = -S(X) A_X, established entrywise in ℚ[X].
This uses the *proved* logarithmic derivative of T, not a new
unproved differential equation. -/
theorem tableau_ode_shiftT_derivative
    (D : Diagram) (hsk : SkewRowIntervals D) :
    ordered_kernel_matDerivative D (tableau_ode_shiftT D) =
      -(tableau_ode_shiftT D * blockKernelPolynomial D) := by
  classical
  apply ordered_kernel_mat_ext_of_eval D
  intro z
  rw [tableau_ode_shiftT_derivative_eval, tableau_ode_matEval_neg,
    ordered_kernel_matEval_mul, tableau_ode_shiftT_eval,
    ordered_kernel_matEval_kernel]
  have ht := tableau_ode_Tprime_eq_T_mul_A D hsk (1 - z)
  have hz : 1 - (1 - z) = z := by ring
  rw [hz] at ht
  exact congrArg Neg.neg ht

/-- Every S(X) commutes with its connected-block kernel A_X.
This identity is obtained by polynomial extensionality from §5.4. -/
theorem tableau_ode_shiftT_commutes_kernel
    (D : Diagram) (hsk : SkewRowIntervals D) :
    tableau_ode_shiftT D * blockKernelPolynomial D =
      blockKernelPolynomial D * tableau_ode_shiftT D := by
  classical
  apply ordered_kernel_mat_ext_of_eval D
  intro z
  rw [ordered_kernel_matEval_mul, ordered_kernel_matEval_mul,
    tableau_ode_shiftT_eval, ordered_kernel_matEval_kernel]
  exact tableau_ode_T_commutes_A D hsk (1 - z) z

/-- The explicit inverse R(X)=Q_(1-X) commutes with A_X. -/
theorem tableau_ode_shiftQ_commutes_kernel
    (D : Diagram) (hsk : SkewRowIntervals D) :
    tableau_ode_shiftQ D * blockKernelPolynomial D =
      blockKernelPolynomial D * tableau_ode_shiftQ D := by
  exact inverse_commutes_with
    (tableau_ode_shiftQ D) (tableau_ode_shiftT D)
    (blockKernelPolynomial D)
    (tableau_ode_shiftQ_mul_shiftT D hsk)
    (tableau_ode_shiftT_mul_shiftQ D hsk)
    (tableau_ode_shiftT_commutes_kernel D hsk)

/-! ### §6.2 — Polynomial solution of the transfer equation. -/

/-- Differentiating the inverse relation gives R'(X)=R(X) A_X.
All operations take place in a finite polynomial matrix ring. -/
theorem tableau_ode_shiftQ_derivative
    (D : Diagram) (hsk : SkewRowIntervals D) :
    ordered_kernel_matDerivative D (tableau_ode_shiftQ D) =
      tableau_ode_shiftQ D * blockKernelPolynomial D := by
  classical
  let S := tableau_ode_shiftT D
  let R := tableau_ode_shiftQ D
  let P := blockKernelPolynomial D
  have hSR : S * R = 1 := tableau_ode_shiftT_mul_shiftQ D hsk
  have hRS : R * S = 1 := tableau_ode_shiftQ_mul_shiftT D hsk
  have hS' : ordered_kernel_matDerivative D S = -(S * P) :=
    tableau_ode_shiftT_derivative D hsk
  have hRP : R * P = P * R :=
    tableau_ode_shiftQ_commutes_kernel D hsk
  have hd : -(S * P) * R + S * ordered_kernel_matDerivative D R = 0 := by
    have h := congrArg (ordered_kernel_matDerivative D) hSR
    rw [ordered_kernel_matDerivative_mul, hS', tableau_ode_matDerivative_one] at h
    exact h
  have hSR' : S * ordered_kernel_matDerivative D R = (S * P) * R := by
    have hd' : -((S * P) * R) + S * ordered_kernel_matDerivative D R = 0 := by
      simpa only [neg_mul] using hd
    apply sub_eq_zero.mp
    calc
      S * ordered_kernel_matDerivative D R - (S * P) * R =
          -((S * P) * R) + S * ordered_kernel_matDerivative D R := by abel
      _ = 0 := hd'
  calc
    ordered_kernel_matDerivative D R = (R * S) * ordered_kernel_matDerivative D R := by
      rw [hRS, one_mul]
    _ = R * (S * ordered_kernel_matDerivative D R) := by rw [mul_assoc]
    _ = R * ((S * P) * R) := by rw [hSR']
    _ = (R * S) * (P * R) := by simp only [mul_assoc]
    _ = P * R := by rw [hRS, one_mul]
    _ = R * P := hRP.symm

/-- The polynomial matrix interpolating the identity and the zeta
matrix. Unlike a formal exponential, this is a concrete finite object. -/
private noncomputable def tableau_ode_V (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) :=
  ordered_kernel_matC D (Z D) * tableau_ode_shiftQ D

/-- The initial condition V(0)=Z Q_1=Id. -/
theorem tableau_ode_V_zero (D : Diagram)
    (hsk : SkewRowIntervals D) :
    ordered_kernel_matEval D (tableau_ode_V D) 0 = 1 := by
  classical
  calc
    ordered_kernel_matEval D (tableau_ode_V D) 0 =
        Z D * Q D (1 - 0) := by
          rw [tableau_ode_V, ordered_kernel_matEval_mul,
            ordered_kernel_matEval_const, tableau_ode_shiftQ_eval]
    _ = 1 := by
          simpa only [sub_zero] using tableau_ode_Z_mul_Q_one D hsk

/-- The terminal condition V(1)=Z Q_0=Z. -/
theorem tableau_ode_V_one (D : Diagram)
    (hsk : SkewRowIntervals D) :
    ordered_kernel_matEval D (tableau_ode_V D) 1 = Z D := by
  classical
  calc
    ordered_kernel_matEval D (tableau_ode_V D) 1 =
        Z D * Q D (1 - 1) := by
          rw [tableau_ode_V, ordered_kernel_matEval_mul,
            ordered_kernel_matEval_const, tableau_ode_shiftQ_eval]
    _ = Z D := by
          rw [sub_self, tableau_ode_Q_zero D hsk, mul_one]

/-- The central equation V'(X)=V(X) A_X.  This is the right-sided
orientation needed by the *forward* ordered-root primitives of §6.1. -/
theorem tableau_ode_V_derivative (D : Diagram)
    (hsk : SkewRowIntervals D) :
    ordered_kernel_matDerivative D (tableau_ode_V D) =
      tableau_ode_V D * blockKernelPolynomial D := by
  classical
  change
    ordered_kernel_matDerivative D
      (ordered_kernel_matC D (Z D) * tableau_ode_shiftQ D) =
    (ordered_kernel_matC D (Z D) * tableau_ode_shiftQ D) *
      blockKernelPolynomial D
  rw [ordered_kernel_matDerivative_mul, ordered_kernel_matDerivative_const,
    zero_mul, zero_add, tableau_ode_shiftQ_derivative D hsk,
    mul_assoc]

/-- The inverse transfer and the zeta matrix commute with A_X;
therefore the interpolating matrix V(X) does as well. -/
theorem tableau_ode_Z_commutes_kernel
    (D : Diagram) (hsk : SkewRowIntervals D) :
    ordered_kernel_matC D (Z D) * blockKernelPolynomial D =
      blockKernelPolynomial D * ordered_kernel_matC D (Z D) := by
  classical
  apply ordered_kernel_mat_ext_of_eval D
  intro z
  rw [ordered_kernel_matEval_mul, ordered_kernel_matEval_mul,
    ordered_kernel_matEval_const, ordered_kernel_matEval_kernel]
  have hz := tableau_ode_T_commutes_A D hsk 1 z
  rw [T_one] at hz
  exact hz

theorem tableau_ode_V_commutes_kernel
    (D : Diagram) (hsk : SkewRowIntervals D) :
    tableau_ode_V D * blockKernelPolynomial D =
      blockKernelPolynomial D * tableau_ode_V D := by
  classical
  let R := tableau_ode_shiftQ D
  let P := blockKernelPolynomial D
  let C := ordered_kernel_matC D (Z D)
  have hRP : R * P = P * R := tableau_ode_shiftQ_commutes_kernel D hsk
  have hCP : C * P = P * C := tableau_ode_Z_commutes_kernel D hsk
  change (C * R) * P = P * (C * R)
  calc
    (C * R) * P = C * (R * P) := by rw [mul_assoc]
    _ = C * (P * R) := by rw [hRP]
    _ = (C * P) * R := by rw [mul_assoc]
    _ = (P * C) * R := by rw [hCP]
    _ = P * (C * R) := by rw [mul_assoc]

/-- For every natural exponent, evaluating the interpolation matrix
  at the endpoints gives the identity matrix and the corresponding
  power of the ideal-zeta matrix. -/
theorem tableau_ode_V_pow_endpoints (D : Diagram)
    (hsk : SkewRowIntervals D) (m : ℕ) :
    ordered_kernel_matEval D ((tableau_ode_V D) ^ m) 0 = 1 ∧
    ordered_kernel_matEval D ((tableau_ode_V D) ^ m) 1 = (Z D) ^ m := by
  classical
  have hevalpow (z : ℚ) :
      ordered_kernel_matEval D ((tableau_ode_V D) ^ m) z =
        (ordered_kernel_matEval D (tableau_ode_V D) z) ^ m := by
    induction m with
    | zero =>
        change ordered_kernel_matEval D
          (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) z =
            (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ)
        exact tableau_ode_matEval_one D z
    | succ n ih =>
        rw [pow_succ, pow_succ, ordered_kernel_matEval_mul, ih]
  constructor
  · rw [hevalpow, tableau_ode_V_zero D hsk, one_pow]
  · rw [hevalpow, tableau_ode_V_one D hsk]

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.2 — Finiteness of the ordered-root series. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- A path of k strict ideal increments cannot end in an ideal of fewer
than k cells. The proof uses only strict inclusion and the original
kernel recursion, and works for arbitrary starting ideals. -/
private theorem tableau_ode_orderedKernel_above_target
    (D : Diagram) (k : ℕ) (I J : ShapeIdeal D)
    (hk : J.1.card < k) :
    orderedKernelPrimitive D k I J = 0 := by
  classical
  induction k generalizing J with
  | zero =>
      omega
  | succ k ih =>
      rw [orderedKernelPrimitive_succ]
      have hsum :
          (∑ K : ShapeIdeal D,
            orderedKernelPrimitive D k I K *
              blockKernelPolynomial D K J) = 0 := by
        apply Finset.sum_eq_zero
        intro K _
        by_cases hs : K.1 ⊂ J.1
        · have hc : K.1.card < J.1.card := Finset.card_lt_card hs
          have hsmall : K.1.card < k := by omega
          rw [ih K hsmall, zero_mul]
        · have hzero : blockKernelPolynomial D K J = 0 := by
            change
              (if K.1 ⊂ J.1 ∧
                    ConnectedSkewRows (intervalCells D K J) then
                (Polynomial.X : Polynomial ℚ) ^
                    (rowCount (intervalCells D K J) - 1) *
                  (1 - Polynomial.X) ^
                    (columnCount (intervalCells D K J) - 1)
               else 0) = 0
            simp only [hs, false_and, ite_false]
          rw [hzero, mul_zero]
      rw [hsum, primitiveFromZero_zero]

/-- The ordered-kernel primitive vanishes beyond the maximal length
  of a chain of strict ideal increments. -/
private theorem tableau_ode_orderedKernel_last_zero (D : Diagram) :
    orderedKernelPrimitive D (Fintype.card (ShapeCell D) + 1) = 0 := by
  classical
  apply Matrix.ext
  intro I J
  have hle : J.1.card ≤ Fintype.card (ShapeCell D) := by
    simpa only [Finset.card_univ] using
      (Finset.card_le_card (Finset.subset_univ J.1))
  exact tableau_ode_orderedKernel_above_target D
    (Fintype.card (ShapeCell D) + 1) I J (by omega)

private theorem tableau_ode_matDerivative_zero (D : Diagram) :
    ordered_kernel_matDerivative D
      (0 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) = 0 := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matDerivative, Matrix.of_apply,
    Matrix.zero_apply, Polynomial.derivative_zero]

/-! ### §6.2 — Polynomial Picard iteration. -/

private theorem tableau_ode_matDerivative_add (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    ordered_kernel_matDerivative D (M + N) =
      ordered_kernel_matDerivative D M + ordered_kernel_matDerivative D N := by
  classical
  apply Matrix.ext
  intro I J
  change Polynomial.derivative (M I J + N I J) =
    Polynomial.derivative (M I J) + Polynomial.derivative (N I J)
  exact Polynomial.derivative_add

private theorem tableau_ode_matEval_add (D : Diagram)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) (z : ℚ) :
    ordered_kernel_matEval D (M + N) z =
      ordered_kernel_matEval D M z + ordered_kernel_matEval D N z := by
  classical
  apply Matrix.ext
  intro I J
  change Polynomial.eval z (M I J + N I J) =
    Polynomial.eval z (M I J) + Polynomial.eval z (N I J)
  exact Polynomial.eval_add

private theorem tableau_ode_matEval_zero (D : Diagram) (z : ℚ) :
    ordered_kernel_matEval D
      (0 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) z = 0 := by
  classical
  apply Matrix.ext
  intro I J
  simp only [ordered_kernel_matEval, Matrix.of_apply,
    Matrix.zero_apply, Polynomial.eval_zero]

private theorem tableau_ode_matDerivative_nsmul (D : Diagram)
    (c : ℕ)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    ordered_kernel_matDerivative D (c • M) = c • ordered_kernel_matDerivative D M := by
  induction c with
  | zero =>
      rw [zero_smul, zero_smul]
      exact tableau_ode_matDerivative_zero D
  | succ c ih =>
      rw [succ_nsmul, succ_nsmul,
        tableau_ode_matDerivative_add, ih]

private theorem tableau_ode_matEval_nsmul (D : Diagram)
    (c : ℕ)
    (M : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) (z : ℚ) :
    ordered_kernel_matEval D (c • M) z = c • ordered_kernel_matEval D M z := by
  induction c with
  | zero =>
      rw [zero_smul, zero_smul]
      exact tableau_ode_matEval_zero D z
  | succ c ih =>
      rw [succ_nsmul, succ_nsmul,
        tableau_ode_matEval_add, ih]

private theorem tableau_ode_nsmul_mul (D : Diagram) (c : ℕ)
    (M N : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) :
    (c • M) * N = c • (M * N) := by
  induction c with
  | zero =>
      simp only [zero_smul, zero_mul]
  | succ c ih =>
      rw [succ_nsmul, succ_nsmul, add_mul, ih]

/-- The truncated Picard series, written recursively to avoid
uncontrolled reindexing of dependent finite sums. -/
private noncomputable def tableau_ode_partialSeries (D : Diagram)
    (m : ℕ) : ℕ →
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)
  | 0 => 1
  | k + 1 => tableau_ode_partialSeries D m k +
      (m ^ (k + 1)) • orderedKernelPrimitive D (k + 1)

private theorem tableau_ode_partialSeries_derivative (D : Diagram)
    (m k : ℕ) :
    ordered_kernel_matDerivative D (tableau_ode_partialSeries D m (k + 1)) =
      m • (tableau_ode_partialSeries D m k * blockKernelPolynomial D) := by
  classical
  induction k with
  | zero =>
      change
        ordered_kernel_matDerivative D
          ((1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) +
            (m ^ 1) • orderedKernelPrimitive D 1) =
        m • ((1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) *
          blockKernelPolynomial D)
      rw [tableau_ode_matDerivative_add, tableau_ode_matDerivative_one,
        zero_add, tableau_ode_matDerivative_nsmul,
        ordered_kernel_forward_derivative, orderedKernelPrimitive_zero,
        one_mul, pow_one]
  | succ k ih =>
      change
        ordered_kernel_matDerivative D
          (tableau_ode_partialSeries D m (k + 1) +
            (m ^ (k + 2)) • orderedKernelPrimitive D (k + 2)) =
        m • (tableau_ode_partialSeries D m (k + 1) *
          blockKernelPolynomial D)
      rw [tableau_ode_matDerivative_add, ih,
        tableau_ode_matDerivative_nsmul, ordered_kernel_forward_derivative]
      change
        m • (tableau_ode_partialSeries D m k * blockKernelPolynomial D) +
          (m ^ (k + 2)) •
            (orderedKernelPrimitive D (k + 1) * blockKernelPolynomial D) =
        m • ((tableau_ode_partialSeries D m k +
          (m ^ (k + 1)) • orderedKernelPrimitive D (k + 1)) *
          blockKernelPolynomial D)
      rw [add_mul, tableau_ode_nsmul_mul, smul_add, smul_smul]
      have hp : m * m ^ (k + 1) = m ^ (k + 2) := by
        calc
          m * m ^ (k + 1) = m ^ (k + 1) * m := mul_comm _ _
          _ = m ^ (k + 2) := (pow_succ m (k + 1)).symm
      rw [hp]

private theorem tableau_ode_partialSeries_zero (D : Diagram)
    (m k : ℕ) :
    ordered_kernel_matEval D (tableau_ode_partialSeries D m k) 0 = 1 := by
  classical
  induction k with
  | zero =>
      change ordered_kernel_matEval D
        (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)) 0 = 1
      exact tableau_ode_matEval_one D 0
  | succ k ih =>
      change ordered_kernel_matEval D
        (tableau_ode_partialSeries D m k +
          (m ^ (k + 1)) • orderedKernelPrimitive D (k + 1)) 0 = 1
      rw [tableau_ode_matEval_add, tableau_ode_matEval_nsmul,
        ordered_kernel_forward_zero, smul_zero, add_zero, ih]

private theorem tableau_ode_partialSeries_stable (D : Diagram) (m : ℕ) :
    tableau_ode_partialSeries D m (Fintype.card (ShapeCell D) + 1) =
      tableau_ode_partialSeries D m (Fintype.card (ShapeCell D)) := by
  change
    tableau_ode_partialSeries D m (Fintype.card (ShapeCell D)) +
      (m ^ (Fintype.card (ShapeCell D) + 1)) •
        orderedKernelPrimitive D (Fintype.card (ShapeCell D) + 1) =
    tableau_ode_partialSeries D m (Fintype.card (ShapeCell D))
  rw [tableau_ode_orderedKernel_last_zero, smul_zero, add_zero]

private theorem tableau_ode_partialSeries_ode (D : Diagram) (m : ℕ) :
    ordered_kernel_matDerivative D
      (tableau_ode_partialSeries D m (Fintype.card (ShapeCell D))) =
      m • (tableau_ode_partialSeries D m
        (Fintype.card (ShapeCell D)) * blockKernelPolynomial D) := by
  have h := tableau_ode_partialSeries_derivative D m
    (Fintype.card (ShapeCell D))
  rw [tableau_ode_partialSeries_stable D m] at h
  exact h

/-! ### §6.2 — Uniqueness of the polynomial matrix initial-value problem. -/

/-- For a strictly increasing ideal-kernel, a polynomial-matrix
right-sided initial-value problem has at most one solution. This is
proved by strong induction on the number of cells in the target ideal,
so it does not require matrix exponentials. -/
private theorem tableau_ode_ode_unique (D : Diagram) (m : ℕ)
    (U W : Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ))
    (hU : ordered_kernel_matDerivative D U = m • (U * blockKernelPolynomial D))
    (hW : ordered_kernel_matDerivative D W = m • (W * blockKernelPolynomial D))
    (hzero : ordered_kernel_matEval D U 0 = ordered_kernel_matEval D W 0) : U = W := by
  classical
  have hcol : ∀ n : ℕ, ∀ J : ShapeIdeal D,
      J.1.card = n → ∀ I : ShapeIdeal D, U I J = W I J := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro J hJn I
        apply polynomial_eq_of_derivative_and_eval_zero
        · have hmul : (U * blockKernelPolynomial D) I J =
              (W * blockKernelPolynomial D) I J := by
            rw [Matrix.mul_apply, Matrix.mul_apply]
            apply Finset.sum_congr rfl
            intro K _
            by_cases hs : K.1 ⊂ J.1
            · have hc : K.1.card < J.1.card := Finset.card_lt_card hs
              rw [ih K.1.card (by omega) K rfl I]
            · have hz : blockKernelPolynomial D K J = 0 := by
                change
                  (if K.1 ⊂ J.1 ∧
                        ConnectedSkewRows (intervalCells D K J) then
                    (Polynomial.X : Polynomial ℚ) ^
                        (rowCount (intervalCells D K J) - 1) *
                      (1 - Polynomial.X) ^
                        (columnCount (intervalCells D K J) - 1)
                   else 0) = 0
                simp only [hs, false_and, ite_false]
              rw [hz, mul_zero, mul_zero]
          have hd : (ordered_kernel_matDerivative D U) I J =
              (ordered_kernel_matDerivative D W) I J := by
            rw [hU, hW]
            exact congrArg (fun z : Polynomial ℚ => m • z) hmul
          exact hd
        · exact congrFun (congrFun hzero I) J
  apply Matrix.ext
  intro I J
  exact hcol J.1.card J rfl I

/-- The derivative of a power follows from the commutativity of V and
its logarithmic kernel A. Natural scalar multiples avoid denominators. -/
private theorem tableau_ode_V_pow_derivative (D : Diagram)
    (hsk : SkewRowIntervals D) (m : ℕ) :
    ordered_kernel_matDerivative D ((tableau_ode_V D) ^ m) =
      m • ((tableau_ode_V D) ^ m * blockKernelPolynomial D) := by
  classical
  induction m with
  | zero =>
      rw [pow_zero, zero_smul]
      exact tableau_ode_matDerivative_one D
  | succ m ih =>
      rw [pow_succ, ordered_kernel_matDerivative_mul, ih,
        tableau_ode_V_derivative D hsk]
      have hcomm := tableau_ode_V_commutes_kernel D hsk
      have hprod :
          ((tableau_ode_V D) ^ m * blockKernelPolynomial D) *
            tableau_ode_V D =
          (tableau_ode_V D) ^ (m + 1) * blockKernelPolynomial D := by
        calc
          ((tableau_ode_V D) ^ m * blockKernelPolynomial D) *
              tableau_ode_V D =
            (tableau_ode_V D) ^ m *
              (blockKernelPolynomial D * tableau_ode_V D) := by
                rw [mul_assoc]
          _ = (tableau_ode_V D) ^ m *
              (tableau_ode_V D * blockKernelPolynomial D) := by
                rw [hcomm]
          _ = (tableau_ode_V D) ^ (m + 1) *
              blockKernelPolynomial D := by
                rw [← mul_assoc, pow_succ]
      calc
        (m • ((tableau_ode_V D) ^ m * blockKernelPolynomial D)) *
            tableau_ode_V D +
          (tableau_ode_V D) ^ m *
            (tableau_ode_V D * blockKernelPolynomial D) =
          m • ((tableau_ode_V D) ^ (m + 1) * blockKernelPolynomial D) +
            ((tableau_ode_V D) ^ (m + 1) * blockKernelPolynomial D) := by
              rw [tableau_ode_nsmul_mul, hprod, ← mul_assoc, pow_succ]
        _ = (m + 1) • ((tableau_ode_V D) ^ (m + 1) *
              blockKernelPolynomial D) := by
              rw [succ_nsmul]

/-- The key finite-series identity for every nonnegative integer m:
V(X)^m is the finite Picard sum, with no analytic convergence. -/
theorem tableau_ode_power_eq_finite_picard (D : Diagram)
    (hsk : SkewRowIntervals D) (m : ℕ) :
    (tableau_ode_V D) ^ m =
      tableau_ode_partialSeries D m (Fintype.card (ShapeCell D)) := by
  apply tableau_ode_ode_unique D m
  · exact tableau_ode_V_pow_derivative D hsk m
  · exact tableau_ode_partialSeries_ode D m
  · exact (tableau_ode_V_pow_endpoints D hsk m).1.trans
      (tableau_ode_partialSeries_zero D m _).symm


/-! ### §6.2 — Zeta powers and the order polynomial. -/

private theorem tableau_ode_partialSeries_sum (D : Diagram)
    (m k : ℕ) :
    tableau_ode_partialSeries D m k =
      ∑ j ∈ Finset.range (k + 1),
        (m ^ j) • orderedKernelPrimitive D j := by
  classical
  induction k with
  | zero =>
      rw [Finset.sum_range_succ, Finset.sum_range_zero,
        zero_add, pow_zero, one_smul]
      rfl
  | succ k ih =>
      change tableau_ode_partialSeries D m k +
        (m ^ (k + 1)) • orderedKernelPrimitive D (k + 1) = _
      rw [Finset.sum_range_succ, ih]

private theorem tableau_ode_matEval_sum (D : Diagram)
    {α : Type*} (s : Finset α)
    (f : α → Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ))
    (z : ℚ) :
    ordered_kernel_matEval D (∑ x ∈ s, f x) z =
      ∑ x ∈ s, ordered_kernel_matEval D (f x) z := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      exact tableau_ode_matEval_zero D z
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha,
        tableau_ode_matEval_add, ih]

private theorem tableau_ode_partialSeries_eval_one (D : Diagram)
    (m : ℕ) (I J : ShapeIdeal D) :
    (ordered_kernel_matEval D
      (tableau_ode_partialSeries D m (Fintype.card (ShapeCell D))) 1) I J =
      ∑ j ∈ Finset.range (Fintype.card (ShapeCell D) + 1),
        (m : ℚ) ^ j * (orderedKernelPrimitive D j I J).eval 1 := by
  classical
  rw [tableau_ode_partialSeries_sum,
    tableau_ode_matEval_sum]
  simp only [Matrix.sum_apply, Matrix.smul_apply, ordered_kernel_matEval, Matrix.of_apply]
  apply Finset.sum_congr rfl
  intro j _
  simp only [nsmul_eq_mul, Nat.cast_pow,
    Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_natCast]

/-- The finite Picard identity yields the exact value of the ordered
root polynomial at *every* nonnegative integer.  This is the main
connection between Lemma 6.1 and the zeta-matrix of Lemma 2.2. -/
private theorem tableau_ode_ordered_eval_eq_Zpow (D : Diagram)
    (hsk : SkewRowIntervals D) (m : ℕ) :
    (orderedKernelPolynomial D).eval (m : ℚ) =
      (Z D ^ m)
        (FinitePoset.bottomIdeal (α := ShapeCell D))
        (FinitePoset.topIdeal (α := ShapeCell D)) := by
  classical
  let bot : ShapeIdeal D := FinitePoset.bottomIdeal (α := ShapeCell D)
  let top : ShapeIdeal D := FinitePoset.topIdeal (α := ShapeCell D)
  have hn : Fintype.card (ShapeCell D) = D.card := by
    simp only [Fintype.card_coe]
  have hcoeff := tableau_ode_partialSeries_eval_one D m bot top
  have hpow := tableau_ode_power_eq_finite_picard D hsk m
  have hend := (tableau_ode_V_pow_endpoints D hsk m).2
  calc
    (orderedKernelPolynomial D).eval (m : ℚ) =
        ∑ j ∈ Finset.range (Fintype.card (ShapeCell D) + 1),
          orderedKernelCoefficient D j * (m : ℚ) ^ j := by
            rw [orderedKernelPolynomial_eval, hn]
    _ = (ordered_kernel_matEval D
          (tableau_ode_partialSeries D m
            (Fintype.card (ShapeCell D))) 1) bot top := by
          rw [hcoeff]
          apply Finset.sum_congr rfl
          intro j _
          exact mul_comm _ _
    _ = (ordered_kernel_matEval D ((tableau_ode_V D) ^ m) 1) bot top := by
          rw [hpow]
    _ = (Z D ^ m) bot top := by
          rw [hend]

/-- The order polynomial at zero counts the unique coloring of an
empty diagram and zero colorings of any nonempty diagram. This is
exactly the zeroth zeta-matrix power. -/
private theorem tableau_ode_Zpow_zero_eq_omega (D : Diagram) :
    (Z D ^ 0)
        (FinitePoset.bottomIdeal (α := ShapeCell D))
        (FinitePoset.topIdeal (α := ShapeCell D)) =
      (FinitePoset.omega (α := ShapeCell D) 0 : ℚ) := by
  classical
  rw [pow_zero]
  have hom := FinitePoset.omega_eq_card_isotone
    (α := ShapeCell D) 0
  rw [hom]
  by_cases hempty : Nonempty (ShapeCell D)
  · have hne :
        (FinitePoset.bottomIdeal (α := ShapeCell D)) ≠
          (FinitePoset.topIdeal (α := ShapeCell D)) := by
        intro heq
        let a : ShapeCell D := Classical.choice hempty
        have ha : a ∈
            (FinitePoset.bottomIdeal (α := ShapeCell D)).1 := by
          rw [heq]
          exact Finset.mem_univ a
        change a ∈ (∅ : Finset (ShapeCell D)) at ha
        have hf : False := by
          simp at ha
        exact hf.elim
    have : IsEmpty
        {f : ShapeCell D → Fin 0 // FinitePoset.IsIsotone f} :=
      ⟨fun f => Fin.elim0 (f.1 (Classical.choice hempty))⟩
    rw [Fintype.card_eq_zero]
    simp only [Matrix.one_apply, ite_eq_right hne, Nat.cast_zero]
  · have : IsEmpty (ShapeCell D) :=
        ⟨fun a => hempty ⟨a⟩⟩
    have heq :
        (FinitePoset.bottomIdeal (α := ShapeCell D)) =
          (FinitePoset.topIdeal (α := ShapeCell D)) := by
        apply Subtype.ext
        apply Finset.ext
        intro a
        exact isEmptyElim a
    let f0 : ShapeCell D → Fin 0 := fun a => isEmptyElim a
    let x0 :
        {f : ShapeCell D → Fin 0 // FinitePoset.IsIsotone f} :=
      ⟨f0, by
        intro a b _
        exact isEmptyElim a⟩
    have : Unique
        {f : ShapeCell D → Fin 0 // FinitePoset.IsIsotone f} :=
      ⟨⟨x0⟩, by
        intro x
        apply Subtype.ext
        funext a
        exact isEmptyElim a⟩
    rw [Fintype.card_unique]
    simp only [Matrix.one_apply, ite_eq_left heq, Nat.cast_one]

/-- **Theorem 6.2 (Skew-shape block-statistic identity).**
: the normalized polynomial of the
corrected block statistic agrees, at every natural argument, with the
actual number of isotone colorings. Equivalently, multiplying by n!
yields manuscript equation (6.2). -/
theorem skew_shape_block_statistic_identity (D : Diagram) :
    SkewBlockStatisticStatement D := by
  intro hsk m
  have h61 : normalizedBlockPolynomial D =
      orderedKernelPolynomial D :=
    ordered_root_integral_identity D hsk
  calc
    (normalizedBlockPolynomial D).eval (m : ℚ) =
        (orderedKernelPolynomial D).eval (m : ℚ) := by
          rw [h61]
    _ = (Z D ^ m)
          (FinitePoset.bottomIdeal (α := ShapeCell D))
          (FinitePoset.topIdeal (α := ShapeCell D)) :=
            tableau_ode_ordered_eval_eq_Zpow D hsk m
    _ = (FinitePoset.omega (α := ShapeCell D) m : ℚ) := by
          cases m with
          | zero =>
              exact tableau_ode_Zpow_zero_eq_omega D
          | succ m =>
              exact tableau_ode_Z_pow_bottom_top_eq_omega D m

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### Theorem 6.3 — Bivariate block refinement and coefficientwise positivity. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- The cells left after deleting a lower ideal of D. -/
private noncomputable abbrev weighted_refinement_remainingDiagram (D : Diagram)
    (I : ShapeIdeal D) : Diagram :=
  MovingShape D I (FinitePoset.topIdeal (α := ShapeCell D))

/-- The complement subtype is canonically order-isomorphic to the
induced cell poset of the remaining skew diagram. -/
private noncomputable def weighted_refinement_complementOrderIso (D : Diagram)
    (I : ShapeIdeal D) :
    {c : ShapeCell D // c ∉ I.1} ≃o
      ShapeCell (weighted_refinement_remainingDiagram D I) := by
  classical
  let T : ShapeIdeal D := FinitePoset.topIdeal (α := ShapeCell D)
  let f : {c : ShapeCell D // c ∉ I.1} →
      ShapeCell (weighted_refinement_remainingDiagram D I) :=
    fun c => ⟨c.1.1,
      (moving_cell_mem_iff D I T c.1).mpr
        ⟨by change c.1 ∈ (Finset.univ : Finset (ShapeCell D))
            exact Finset.mem_univ _, c.2⟩⟩
  let g : ShapeCell (weighted_refinement_remainingDiagram D I) →
      {c : ShapeCell D // c ∉ I.1} :=
    fun c => ⟨movingCellToAmbient D I T c,
      ((moving_cell_mem_iff D I T
        (movingCellToAmbient D I T c)).mp c.2).2⟩
  let e : {c : ShapeCell D // c ∉ I.1} ≃
      ShapeCell (weighted_refinement_remainingDiagram D I) :=
    { toFun := f
      invFun := g
      left_inv := by
        intro c
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := by
        intro c
        apply Subtype.ext
        rfl }
  exact {
    toEquiv := e
    map_rel_iff' := by
      intro a b
      change (a.1.1 ≤ b.1.1) ↔ (a.1.1 ≤ b.1.1)
      rfl
  }

/-- The number of isotone colorings is invariant under an order isomorphism. -/
private theorem weighted_refinement_omega_orderIso
    {α β : Type*} [PartialOrder α] [PartialOrder β]
    [Fintype α] [Fintype β] (e : α ≃o β) (t : ℕ) :
    FinitePoset.omega (α := α) t =
      FinitePoset.omega (α := β) t := by
  classical
  let h :
      {f : α → Fin t // FinitePoset.IsIsotone f} ≃
        {g : β → Fin t // FinitePoset.IsIsotone g} :=
    { toFun := fun f =>
        ⟨fun b => f.1 (e.symm b), by
          intro a b hab
          exact f.2 (e.symm.monotone hab)⟩
      invFun := fun g =>
        ⟨fun a => g.1 (e a), by
          intro a b hab
          exact g.2 (e.monotone hab)⟩
      left_inv := by
        intro f
        apply Subtype.ext
        funext a
        exact congrArg f.1 (e.symm_apply_apply a)
      right_inv := by
        intro g
        apply Subtype.ext
        funext b
        exact congrArg g.1 (e.apply_symm_apply b) }
  calc
    FinitePoset.omega (α := α) t =
        Fintype.card {f : α → Fin t // FinitePoset.IsIsotone f} :=
          FinitePoset.omega_eq_card_isotone t
    _ = Fintype.card {g : β → Fin t // FinitePoset.IsIsotone g} :=
          Fintype.card_congr h
    _ = FinitePoset.omega (α := β) t :=
          (FinitePoset.omega_eq_card_isotone t).symm

/-- Applying Theorem 6.2 to the actual complement of each ideal. -/
private theorem weighted_refinement_omega_remaining (D : Diagram)
    (hsk : SkewRowIntervals D) (I : ShapeIdeal D) (t : ℕ) :
    (FinitePoset.omega
      (α := {c : ShapeCell D // c ∉ I.1}) t : ℚ) =
      (normalizedBlockPolynomial
        (weighted_refinement_remainingDiagram D I)).eval (t : ℚ) := by
  have horder := weighted_refinement_omega_orderIso
    (weighted_refinement_complementOrderIso D I) t
  have hskew : SkewRowIntervals (weighted_refinement_remainingDiagram D I) :=
    movingShape_skew D hsk I
      (FinitePoset.topIdeal (α := ShapeCell D))
  have h62 := skew_shape_block_statistic_identity
    (weighted_refinement_remainingDiagram D I) hskew t
  exact (congrArg (fun n : ℕ => (n : ℚ)) horder).trans h62.symm

/-- Formula (6.4) before clearing the local factorials. This is the
exact weighted block refinement of H(t+1,q) for every natural t. -/
theorem weighted_refinement_normalized_refinement (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (t : ℕ) (q : ℚ) :
    FinitePoset.H (α := ShapeCell D) w (t + 1) q =
      ∑ I : ShapeIdeal D,
        q ^ FinitePoset.weight w I.1 *
          (normalizedBlockPolynomial
            (weighted_refinement_remainingDiagram D I)).eval (t : ℚ) := by
  classical
  have hs :
      (FinitePoset.ideals (α := ShapeCell D)).sum
        (fun S : Finset (ShapeCell D) =>
          q ^ FinitePoset.weight w S *
            (FinitePoset.omega
              (α := {c : ShapeCell D // c ∉ S}) t : ℚ)) =
      ∑ I : ShapeIdeal D,
        q ^ FinitePoset.weight w I.1 *
          (FinitePoset.omega
            (α := {c : ShapeCell D // c ∉ I.1}) t : ℚ) := by
    exact Finset.sum_subtype
      (FinitePoset.ideals (α := ShapeCell D))
      (fun S => FinitePoset.mem_ideals S)
      (fun S => q ^ FinitePoset.weight w S *
        (FinitePoset.omega
          (α := {c : ShapeCell D // c ∉ S}) t : ℚ))
  calc
    FinitePoset.H (α := ShapeCell D) w (t + 1) q =
        (FinitePoset.ideals (α := ShapeCell D)).sum
          (fun S : Finset (ShapeCell D) =>
            q ^ FinitePoset.weight w S *
              (FinitePoset.omega
                (α := {c : ShapeCell D // c ∉ S}) t : ℚ)) := by
          rfl
    _ = ∑ I : ShapeIdeal D,
          q ^ FinitePoset.weight w I.1 *
            (FinitePoset.omega
              (α := {c : ShapeCell D // c ∉ I.1}) t : ℚ) := hs
    _ = ∑ I : ShapeIdeal D,
          q ^ FinitePoset.weight w I.1 *
            (normalizedBlockPolynomial
              (weighted_refinement_remainingDiagram D I)).eval (t : ℚ) := by
          apply Finset.sum_congr rfl
          intro I _
          rw [weighted_refinement_omega_remaining D hsk I t]

/-- A genuine polynomial lift of the manuscript's H(1+u;q),
for each fixed rational q. Unlike the Nat-indexed original `H`, this
has a rational polynomial variable u. -/
noncomputable def weighted_refinement_shiftedHPolynomial (D : Diagram)
    (w : ShapeCell D → ℤ) (q : ℚ) : Polynomial ℚ := by
  classical
  exact ∑ I : ShapeIdeal D,
    Polynomial.C (q ^ FinitePoset.weight w I.1) *
      normalizedBlockPolynomial (weighted_refinement_remainingDiagram D I)

/-- The polynomial lift agrees with the original finite-poset
interpolating enumerator at every natural argument u. -/
theorem weighted_refinement_shiftedHPolynomial_eval (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (u : ℕ) (q : ℚ) :
    (weighted_refinement_shiftedHPolynomial D w q).eval (u : ℚ) =
      FinitePoset.H (α := ShapeCell D) w (u + 1) q := by
  rw [weighted_refinement_normalized_refinement D hsk w u q]
  simp only [weighted_refinement_shiftedHPolynomial,
    Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C]

/-- An ideal complement cannot contain more cells than D. -/
private theorem weighted_refinement_remaining_card_le (D : Diagram) (I : ShapeIdeal D) :
    (weighted_refinement_remainingDiagram D I).card ≤ D.card :=
  Finset.card_le_card
    (intervalCells_subset_diagram D I
      (FinitePoset.topIdeal (α := ShapeCell D)))

/-- In the paper's notation the complement has precisely
`n - |I|` cells. This is proved using the actual order isomorphism,
so no cardinality statement about embedded subtypes is assumed. -/
private theorem weighted_refinement_remaining_card_sub (D : Diagram)
    (I : ShapeIdeal D) :
    (weighted_refinement_remainingDiagram D I).card = D.card - I.1.card := by
  classical
  let B := weighted_refinement_remainingDiagram D I
  have hc : Fintype.card (ShapeCell B) =
      Fintype.card {c : ShapeCell D // c ∉ I.1} :=
    (Fintype.card_congr (weighted_refinement_complementOrderIso D I).toEquiv).symm
  have hs : Fintype.card {c : ShapeCell D // c ∉ I.1} =
      ((Finset.univ : Finset (ShapeCell D)) \ I.1).card := by
    rw [Fintype.card_subtype]
    congr 1
    ext c
    simp only [Finset.mem_filter, Finset.mem_univ,
      true_and, Finset.mem_sdiff]
  calc
    B.card = Fintype.card (ShapeCell B) := by
      simp only [Fintype.card_coe]
    _ = Fintype.card {c : ShapeCell D // c ∉ I.1} := hc
    _ = ((Finset.univ : Finset (ShapeCell D)) \ I.1).card := hs
    _ = (Finset.univ : Finset (ShapeCell D)).card - I.1.card :=
      Finset.card_sdiff_of_subset (Finset.subset_univ I.1)
    _ = D.card - I.1.card := by
      simp only [Finset.card_univ, Fintype.card_coe]

/-- The factorial prefactor in (6.4) is actually a natural number. -/
private noncomputable def weighted_refinement_factorialMultiplier (D : Diagram)
    (I : ShapeIdeal D) : ℕ :=
  Nat.factorial D.card /
    Nat.factorial (weighted_refinement_remainingDiagram D I).card

private theorem weighted_refinement_factorial_dvd (D : Diagram) (I : ShapeIdeal D) :
    Nat.factorial (weighted_refinement_remainingDiagram D I).card ∣
      Nat.factorial D.card := by
  exact Nat.factorial_dvd_factorial (weighted_refinement_remaining_card_le D I)

/-- The rational factorial quotient in (6.4) coincides with the
explicit natural-number multiplier, so it is nonnegative. -/
private theorem weighted_refinement_factorial_ratio (D : Diagram) (I : ShapeIdeal D) :
    (Nat.factorial D.card : ℚ) /
        (Nat.factorial (weighted_refinement_remainingDiagram D I).card : ℚ) =
      (weighted_refinement_factorialMultiplier D I : ℚ) := by
  let a := Nat.factorial (weighted_refinement_remainingDiagram D I).card
  let b := Nat.factorial D.card
  have hab : a ∣ b := weighted_refinement_factorial_dvd D I
  have hprod : a * (b / a) = b := Nat.mul_div_cancel' hab
  have hprodQ : (a : ℚ) * ((b / a : ℕ) : ℚ) = (b : ℚ) := by
    exact_mod_cast hprod
  have ha : (a : ℚ) ≠ 0 := by
    dsimp [a]
    exact_mod_cast Nat.factorial_ne_zero
      (weighted_refinement_remainingDiagram D I).card
  change (b : ℚ) / (a : ℚ) = ((b / a : ℕ) : ℚ)
  apply (div_eq_iff ha).2
  calc
    (b : ℚ) = (a : ℚ) * ((b / a : ℕ) : ℚ) := hprodQ.symm
    _ = ((b / a : ℕ) : ℚ) * (a : ℚ) := mul_comm _ _

/-- **Theorem 6.3 (Bivariate block refinement).**
The factorial multiplier is literally a natural number. The
finite sum on the right uses the *corrected*, canonical block count
of the actual complement skew diagram. -/
theorem weighted_block_refinement_identity (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (u : ℕ) (q : ℚ) :
    (Nat.factorial D.card : ℚ) *
        FinitePoset.H (α := ShapeCell D) w (u + 1) q =
      ∑ I : ShapeIdeal D,
        q ^ FinitePoset.weight w I.1 *
          (weighted_refinement_factorialMultiplier D I : ℚ) *
            (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
              (u : ℚ) ^ blockCount (weighted_refinement_remainingDiagram D I) σ) := by
  classical
  rw [weighted_refinement_normalized_refinement D hsk w u q]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro I _
  have hratio := weighted_refinement_factorial_ratio D I
  calc
    (Nat.factorial D.card : ℚ) *
        (q ^ FinitePoset.weight w I.1 *
          (normalizedBlockPolynomial
            (weighted_refinement_remainingDiagram D I)).eval (u : ℚ)) =
      ((Nat.factorial D.card : ℚ) /
          (Nat.factorial (weighted_refinement_remainingDiagram D I).card : ℚ)) *
        q ^ FinitePoset.weight w I.1 *
          (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
            (u : ℚ) ^ blockCount (weighted_refinement_remainingDiagram D I) σ) := by
          rw [normalizedBlockPolynomial_eval]
          simp only [Fintype.card_coe, div_eq_mul_inv]
          ring
    _ = q ^ FinitePoset.weight w I.1 *
          (weighted_refinement_factorialMultiplier D I : ℚ) *
            (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
              (u : ℚ) ^ blockCount (weighted_refinement_remainingDiagram D I) σ) := by
          rw [hratio]
          ring

/-- The literal factorial-ratio form of manuscript equation (6.4),
with `(n-|I|)!` in the denominator. The finite labeling sum is taken
on the skew cell set of the complement of I. -/
theorem weighted_block_refinement_factorial_formula (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (u : ℕ) (q : ℚ) :
    (Nat.factorial D.card : ℚ) *
        FinitePoset.H (α := ShapeCell D) w (u + 1) q =
      ∑ I : ShapeIdeal D,
        ((Nat.factorial D.card : ℚ) /
            (Nat.factorial (D.card - I.1.card) : ℚ)) *
          q ^ FinitePoset.weight w I.1 *
            (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
              (u : ℚ) ^ blockCount (weighted_refinement_remainingDiagram D I) σ) := by
  classical
  rw [weighted_block_refinement_identity D hsk w u q]
  apply Finset.sum_congr rfl
  intro I _
  rw [← weighted_refinement_factorial_ratio D I,
    weighted_refinement_remaining_card_sub D I]
  ring

/-- The number of standard labelings of the complement with a
specified number of corrected canonical blocks. -/
private noncomputable def weighted_refinement_labelMultiplicity (D : Diagram)
    (I : ShapeIdeal D) (b : ℕ) : ℕ := by
  classical
  exact (Finset.univ.filter
    (fun σ : StandardLabeling (weighted_refinement_remainingDiagram D I) =>
      blockCount (weighted_refinement_remainingDiagram D I) σ = b)).card

/-- Natural bivariate coefficients: the coefficient of q^a u^b in
n! H(1+u;q) is the sum of nonnegative integer contributions of all
ideals of weight a, multiplied by the number of labelings with b
corrected blocks. This is a canonical *finite-support* coefficient
formula, also valid for negative exponents a. -/
noncomputable def weighted_refinement_bivariateCoefficient (D : Diagram)
    (w : ShapeCell D → ℤ) (a : ℤ) (b : ℕ) : ℕ := by
  classical
  exact ∑ I : ShapeIdeal D,
    if FinitePoset.weight w I.1 = a then
      weighted_refinement_factorialMultiplier D I *
        weighted_refinement_labelMultiplicity D I b
    else 0

/-- The support is bounded in the shifted variable u by the number
of cells of D, with no hypothesis on the signed weight w. -/
theorem weighted_refinement_coefficient_high_zero (D : Diagram)
    (w : ShapeCell D → ℤ) (a : ℤ) (b : ℕ)
    (hb : D.card < b) :
    weighted_refinement_bivariateCoefficient D w a b = 0 := by
  classical
  unfold weighted_refinement_bivariateCoefficient
  apply Finset.sum_eq_zero
  intro I _
  have hnone :
      (Finset.univ.filter
        (fun σ : StandardLabeling (weighted_refinement_remainingDiagram D I) =>
          blockCount (weighted_refinement_remainingDiagram D I) σ = b)) = ∅ := by
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro σ hσ
    have hblock := blockCount_le_card (weighted_refinement_remainingDiagram D I) σ
    have hcard := weighted_refinement_remaining_card_le D I
    have heq := (Finset.mem_filter.mp hσ).2
    omega
  have hcount : weighted_refinement_labelMultiplicity D I b = 0 := by
    change (Finset.univ.filter
      (fun σ : StandardLabeling (weighted_refinement_remainingDiagram D I) =>
        blockCount (weighted_refinement_remainingDiagram D I) σ = b)).card = 0
    rw [hnone]
    rfl
  simp only [hcount, mul_zero, ite_self]



/-! ### §6.3 — Finite-support Laurent expansion. -/

/-- Partition labelings according to their actual number of blocks.
The summation range `D.card + 1` works uniformly for every ideal,
since its complement contains at most `D.card` cells. -/
private theorem weighted_refinement_labelMultiplicity_sum (D : Diagram)
    (I : ShapeIdeal D) (u : ℚ) :
    (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
        u ^ blockCount (weighted_refinement_remainingDiagram D I) σ) =
      ∑ b ∈ Finset.range (D.card + 1),
        (weighted_refinement_labelMultiplicity D I b : ℚ) * u ^ b := by
  classical
  let B := weighted_refinement_remainingDiagram D I
  have hbound (σ : StandardLabeling B) :
      blockCount B σ ∈ Finset.range (D.card + 1) := by
    apply Finset.mem_range.mpr
    have hb : blockCount B σ ≤ B.card := blockCount_le_card B σ
    have hD : B.card ≤ D.card := weighted_refinement_remaining_card_le D I
    omega
  calc
    (∑ σ : StandardLabeling B, u ^ blockCount B σ) =
        ∑ σ : StandardLabeling B,
          ∑ b ∈ Finset.range (D.card + 1),
            (if blockCount B σ = b then u ^ b else 0) := by
          apply Finset.sum_congr rfl
          intro σ _
          rw [Finset.sum_ite_eq]
          simp only [hbound σ, ite_true]
    _ = ∑ b ∈ Finset.range (D.card + 1),
          ∑ σ : StandardLabeling B,
            (if blockCount B σ = b then u ^ b else 0) := by
          rw [Finset.sum_comm]
    _ = ∑ b ∈ Finset.range (D.card + 1),
          (weighted_refinement_labelMultiplicity D I b : ℚ) * u ^ b := by
          apply Finset.sum_congr rfl
          intro b _
          rw [← Finset.sum_filter]
          change (∑ σ ∈ Finset.univ.filter
              (fun σ : StandardLabeling B => blockCount B σ = b),
              u ^ b) =
            (((Finset.univ.filter
              (fun σ : StandardLabeling B => blockCount B σ = b)).card : ℚ) *
              u ^ b)
          rw [Finset.sum_const]
          simp only [nsmul_eq_mul]

/-- The rational incarnation of the natural-number coefficient. -/
private theorem weighted_refinement_bivariateCoefficient_cast (D : Diagram)
    (w : ShapeCell D → ℤ) (a : ℤ) (b : ℕ) :
    (weighted_refinement_bivariateCoefficient D w a b : ℚ) =
      ∑ I : ShapeIdeal D,
        if FinitePoset.weight w I.1 = a then
          (weighted_refinement_factorialMultiplier D I : ℚ) *
            (weighted_refinement_labelMultiplicity D I b : ℚ)
        else 0 := by
  classical
  unfold weighted_refinement_bivariateCoefficient
  simp only [Nat.cast_sum, Nat.cast_ite, Nat.cast_mul, Nat.cast_zero]

/-- There are only finitely many q-exponents: exactly the weights
actually attained by ideals. -/
private noncomputable def weighted_refinement_weightSupport (D : Diagram)
    (w : ShapeCell D → ℤ) : Finset ℤ := by
  classical
  exact (Finset.univ : Finset (ShapeIdeal D)).image
    (fun I => FinitePoset.weight w I.1)

/-- Regroup a sum by its q-exponent, keeping the block-count degree
fixed. The proof only uses finite sums and an equality-test partition. -/
private theorem weighted_refinement_regroup_weight (D : Diagram)
    (w : ShapeCell D → ℤ) (b : ℕ) (u q : ℚ) :
    (∑ a ∈ weighted_refinement_weightSupport D w,
      (weighted_refinement_bivariateCoefficient D w a b : ℚ) * q ^ a * u ^ b) =
      ∑ I : ShapeIdeal D,
        ((weighted_refinement_factorialMultiplier D I : ℚ) *
            (weighted_refinement_labelMultiplicity D I b : ℚ)) *
          q ^ FinitePoset.weight w I.1 * u ^ b := by
  classical
  simp_rw [weighted_refinement_bivariateCoefficient_cast]
  calc
    (∑ a ∈ weighted_refinement_weightSupport D w,
      (∑ I : ShapeIdeal D,
        if FinitePoset.weight w I.1 = a then
          (weighted_refinement_factorialMultiplier D I : ℚ) *
            (weighted_refinement_labelMultiplicity D I b : ℚ)
        else 0) * q ^ a * u ^ b) =
      ∑ a ∈ weighted_refinement_weightSupport D w,
        ∑ I : ShapeIdeal D,
          (if FinitePoset.weight w I.1 = a then
            (weighted_refinement_factorialMultiplier D I : ℚ) *
              (weighted_refinement_labelMultiplicity D I b : ℚ)
          else 0) * q ^ a * u ^ b := by
          apply Finset.sum_congr rfl
          intro a _
          rw [Finset.sum_mul, Finset.sum_mul]
    _ = ∑ I : ShapeIdeal D,
          ∑ a ∈ weighted_refinement_weightSupport D w,
            (if FinitePoset.weight w I.1 = a then
              (weighted_refinement_factorialMultiplier D I : ℚ) *
                (weighted_refinement_labelMultiplicity D I b : ℚ)
            else 0) * q ^ a * u ^ b := by
          rw [Finset.sum_comm]
    _ = ∑ I : ShapeIdeal D,
          ((weighted_refinement_factorialMultiplier D I : ℚ) *
              (weighted_refinement_labelMultiplicity D I b : ℚ)) *
            q ^ FinitePoset.weight w I.1 * u ^ b := by
          apply Finset.sum_congr rfl
          intro I _
          have hw : FinitePoset.weight w I.1 ∈
              weighted_refinement_weightSupport D w := by
            change FinitePoset.weight w I.1 ∈
              (Finset.univ : Finset (ShapeIdeal D)).image
                (fun J => FinitePoset.weight w J.1)
            exact Finset.mem_image.mpr ⟨I, Finset.mem_univ _, rfl⟩
          calc
            (∑ a ∈ weighted_refinement_weightSupport D w,
              (if FinitePoset.weight w I.1 = a then
                (weighted_refinement_factorialMultiplier D I : ℚ) *
                  (weighted_refinement_labelMultiplicity D I b : ℚ)
              else 0) * q ^ a * u ^ b) =
              ∑ a ∈ weighted_refinement_weightSupport D w,
                (if FinitePoset.weight w I.1 = a then
                  ((weighted_refinement_factorialMultiplier D I : ℚ) *
                    (weighted_refinement_labelMultiplicity D I b : ℚ)) *
                      q ^ a * u ^ b
                else 0) := by
                  apply Finset.sum_congr rfl
                  intro a _
                  split_ifs <;> ring
            _ = ((weighted_refinement_factorialMultiplier D I : ℚ) *
                  (weighted_refinement_labelMultiplicity D I b : ℚ)) *
                    q ^ FinitePoset.weight w I.1 * u ^ b := by
                  rw [Finset.sum_ite_eq]
                  simp only [hw, ite_true]

/-- **The coefficientwise form of manuscript Theorem 6.3.**
The bivariate formula uses only a finite sum of monomials with
natural-number coefficients. Its q-exponents may be negative, but
shifting them by their finite minimum produces an ordinary polynomial
with nonnegative integer coefficients in q and u. -/
theorem weighted_block_coefficient_expansion (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (u : ℕ) (q : ℚ) :
    (Nat.factorial D.card : ℚ) *
        FinitePoset.H (α := ShapeCell D) w (u + 1) q =
      ∑ a ∈ weighted_refinement_weightSupport D w,
        ∑ b ∈ Finset.range (D.card + 1),
          (weighted_refinement_bivariateCoefficient D w a b : ℚ) *
            q ^ a * (u : ℚ) ^ b := by
  classical
  calc
    (Nat.factorial D.card : ℚ) *
        FinitePoset.H (α := ShapeCell D) w (u + 1) q =
      ∑ I : ShapeIdeal D,
        q ^ FinitePoset.weight w I.1 *
          (weighted_refinement_factorialMultiplier D I : ℚ) *
            (∑ σ : StandardLabeling (weighted_refinement_remainingDiagram D I),
              (u : ℚ) ^ blockCount (weighted_refinement_remainingDiagram D I) σ) :=
                weighted_block_refinement_identity D hsk w u q
    _ = ∑ I : ShapeIdeal D,
          ∑ b ∈ Finset.range (D.card + 1),
            ((weighted_refinement_factorialMultiplier D I : ℚ) *
              (weighted_refinement_labelMultiplicity D I b : ℚ)) *
                q ^ FinitePoset.weight w I.1 * (u : ℚ) ^ b := by
          apply Finset.sum_congr rfl
          intro I _
          rw [weighted_refinement_labelMultiplicity_sum]
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro b _
          ring
    _ = ∑ b ∈ Finset.range (D.card + 1),
          ∑ I : ShapeIdeal D,
            ((weighted_refinement_factorialMultiplier D I : ℚ) *
              (weighted_refinement_labelMultiplicity D I b : ℚ)) *
                q ^ FinitePoset.weight w I.1 * (u : ℚ) ^ b := by
          rw [Finset.sum_comm]
    _ = ∑ b ∈ Finset.range (D.card + 1),
          ∑ a ∈ weighted_refinement_weightSupport D w,
            (weighted_refinement_bivariateCoefficient D w a b : ℚ) *
              q ^ a * (u : ℚ) ^ b := by
          apply Finset.sum_congr rfl
          intro b _
          exact (weighted_refinement_regroup_weight D w b (u : ℚ) q).symm
    _ = ∑ a ∈ weighted_refinement_weightSupport D w,
          ∑ b ∈ Finset.range (D.card + 1),
            (weighted_refinement_bivariateCoefficient D w a b : ℚ) *
              q ^ a * (u : ℚ) ^ b := by
          rw [Finset.sum_comm]

/-- The finite weight support is nonempty, even for the empty
diagram (the empty ideal is always present). -/
private theorem weighted_refinement_weightSupport_nonempty (D : Diagram)
    (w : ShapeCell D → ℤ) :
    (weighted_refinement_weightSupport D w).Nonempty := by
  classical
  let I : ShapeIdeal D := FinitePoset.bottomIdeal (α := ShapeCell D)
  refine ⟨FinitePoset.weight w I.1, ?_⟩
  change FinitePoset.weight w I.1 ∈
    (Finset.univ : Finset (ShapeIdeal D)).image
      (fun J => FinitePoset.weight w J.1)
  exact Finset.mem_image.mpr ⟨I, Finset.mem_univ _, rfl⟩

/-- A uniform integral shift makes every q-exponent nonnegative.
Together with `weighted_block_coefficient_expansion` and the
natural-number coefficients, this is exactly the shifted coefficient
positivity assertion in the paper. -/
theorem weighted_refinement_exists_nonnegative_weight_shift (D : Diagram)
    (w : ShapeCell D → ℤ) :
    ∃ shift : ℤ, ∀ a ∈ weighted_refinement_weightSupport D w,
      0 ≤ a + shift := by
  classical
  let S := weighted_refinement_weightSupport D w
  have hS : S.Nonempty := weighted_refinement_weightSupport_nonempty D w
  refine ⟨-(S.min' hS), ?_⟩
  intro a ha
  have hmin : S.min' hS ≤ a := Finset.min'_le S a ha
  omega

/-- Natural coefficients are nonnegative by construction; the
preceding theorem proves that these are truly the coefficients of the
weighted shifted block enumerator, not merely arbitrary counts. -/
theorem weighted_refinement_coefficient_nonnegative (D : Diagram)
    (w : ShapeCell D → ℤ) (a : ℤ) (b : ℕ) :
    (0 : ℤ) ≤ (weighted_refinement_bivariateCoefficient D w a b : ℤ) := by
  exact Int.natCast_nonneg _

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### Corollary 6.4 — Two specializations and the common surface subfamily. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-- Corollary 6.4, first specialization (6.5): for every positive
natural argument, the q=1 weighted ideal enumerator is the corrected
block-statistic generating sum divided by the cell factorial. -/
theorem weighted_block_order_specialization (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ) (t : ℕ) :
    FinitePoset.H (α := ShapeCell D) w (t + 1) 1 =
      (Nat.factorial D.card : ℚ)⁻¹ *
        (∑ σ : StandardLabeling D,
          ((t + 1 : ℕ) : ℚ) ^ blockCount D σ) := by
  calc
    FinitePoset.H (α := ShapeCell D) w (t + 1) 1 =
        (FinitePoset.omega (α := ShapeCell D) (t + 1) : ℚ) :=
          FinitePoset.H_one_eq_omega_succ w t
    _ = (normalizedBlockPolynomial D).eval ((t + 1 : ℕ) : ℚ) :=
          (skew_shape_block_statistic_identity D hsk (t + 1)).symm
    _ = (Nat.factorial D.card : ℚ)⁻¹ *
          (∑ σ : StandardLabeling D,
            ((t + 1 : ℕ) : ℚ) ^ blockCount D σ) := by
          simpa only [Fintype.card_coe] using
            (normalizedBlockPolynomial_eval D ((t + 1 : ℕ) : ℚ))

/-- Corollary 6.4, second specialization (6.5): t=2 retains exactly
the weighted ideal rank enumerator, even for signed cell weights. -/
theorem weighted_block_rank_specialization (D : Diagram)
    (w : ShapeCell D → ℤ) (q : ℚ) :
    FinitePoset.H (α := ShapeCell D) w 2 q =
      FinitePoset.weightedRank (α := ShapeCell D) w q := by
  exact FinitePoset.H_two w q

/-- **Corollary 6.4 (Two specializations).**
Both coordinate slices, stated together as equation (6.5). -/
theorem weighted_block_two_specializations (D : Diagram)
    (hsk : SkewRowIntervals D) (w : ShapeCell D → ℤ)
    (t : ℕ) (q : ℚ) :
    (FinitePoset.H (α := ShapeCell D) w (t + 1) 1 =
      (Nat.factorial D.card : ℚ)⁻¹ *
        (∑ σ : StandardLabeling D,
          ((t + 1 : ℕ) : ℚ) ^ blockCount D σ)) ∧
    (FinitePoset.H (α := ShapeCell D) w 2 q =
      FinitePoset.weightedRank (α := ShapeCell D) w q) := by
  exact ⟨weighted_block_order_specialization D hsk w t,
    weighted_block_rank_specialization D w q⟩

/-- The numerical consequence of (6.5): the number of order ideals is
the corrected block-generating sum evaluated at two, divided by n!.
In particular this also covers the empty diagram. -/
theorem order_ideal_count_by_block_statistic (D : Diagram)
    (hsk : SkewRowIntervals D) :
    ((FinitePoset.ideals (α := ShapeCell D)).card : ℚ) =
      (Nat.factorial D.card : ℚ)⁻¹ *
        (∑ σ : StandardLabeling D,
          (2 : ℚ) ^ blockCount D σ) := by
  calc
    ((FinitePoset.ideals (α := ShapeCell D)).card : ℚ) =
        (FinitePoset.omega (α := ShapeCell D) 2 : ℚ) :=
          congrArg (fun n : ℕ => (n : ℚ))
            (FinitePoset.omega_two_eq_ideals_card
              (α := ShapeCell D)).symm
    _ = (normalizedBlockPolynomial D).eval (2 : ℚ) :=
          (skew_shape_block_statistic_identity D hsk 2).symm
    _ = (Nat.factorial D.card : ℚ)⁻¹ *
          (∑ σ : StandardLabeling D,
            (2 : ℚ) ^ blockCount D σ) := by
          simpa only [Fintype.card_coe] using
            (normalizedBlockPolynomial_eval D (2 : ℚ))

/-- The last paragraph of Corollary 6.4, in the common ideal model.
For an arc whose principal-coefficient expansion really is this ideal
expansion, the `normalizedSurfaceEvaluation` is its shear-specialized
c-polynomial after the prescribed shift.  The other slice uses the
*same cell poset* and the corrected block statistic. -/
theorem surface_weighted_ideal_specializations (D : Diagram)
    (hsk : SkewRowIntervals D) {κ : Type*}
    (labels : ShapeCell D → κ) (shear : κ → ℤ)
    (shift : ℤ) (q : ℚ) (hq : q ≠ 0) (t : ℕ) :
    (SurfaceCoefficients.normalizedSurfaceEvaluation
        labels shear shift q =
      q ^ (-shift) *
        FinitePoset.H (α := ShapeCell D) (shear ∘ labels) 2 q) ∧
    (FinitePoset.H (α := ShapeCell D) (shear ∘ labels) (t + 1) 1 =
      (Nat.factorial D.card : ℚ)⁻¹ *
        (∑ σ : StandardLabeling D,
          ((t + 1 : ℕ) : ℚ) ^ blockCount D σ)) := by
  constructor
  · exact SurfaceCoefficients.normalizedSurfaceEvaluation_eq_H_two
      labels shear shift q hq
  · exact weighted_block_order_specialization D hsk
      (shear ∘ labels) t


/-- The fence/ribbon clause of Corollary 6.4 in its precise conditional
form: an arc ideal poset order-isomorphic to the cell poset of a skew
ribbon/diagram has both specializations on that *same* poset.  The
hypothesis `e` is exactly the combinatorial identification that must
be supplied by a fence/ribbon representation of the arc. -/
theorem fence_ribbon_weighted_specializations
    (D : Diagram) (hsk : SkewRowIntervals D)
    {α : Type*} [PartialOrder α] [Fintype α]
    (e : α ≃o ShapeCell D) {κ : Type*}
    (labels : α → κ) (shear : κ → ℤ)
    (shift : ℤ) (q : ℚ) (hq : q ≠ 0) (t : ℕ) :
    (SurfaceCoefficients.normalizedSurfaceEvaluation
        labels shear shift q =
      q ^ (-shift) * FinitePoset.H (shear ∘ labels) 2 q) ∧
    (FinitePoset.H (shear ∘ labels) (t + 1) 1 =
      (Nat.factorial D.card : ℚ)⁻¹ *
        (∑ σ : StandardLabeling D,
          ((t + 1 : ℕ) : ℚ) ^ blockCount D σ)) := by
  constructor
  · exact SurfaceCoefficients.normalizedSurfaceEvaluation_eq_H_two
      labels shear shift q hq
  · calc
      FinitePoset.H (shear ∘ labels) (t + 1) 1 =
          (FinitePoset.omega (α := α) (t + 1) : ℚ) :=
            FinitePoset.H_one_eq_omega_succ (shear ∘ labels) t
      _ = (FinitePoset.omega (α := ShapeCell D) (t + 1) : ℚ) := by
            exact congrArg (fun a : ℕ => (a : ℚ))
              (weighted_refinement_omega_orderIso e (t + 1))
      _ = (normalizedBlockPolynomial D).eval ((t + 1 : ℕ) : ℚ) :=
            (skew_shape_block_statistic_identity D hsk (t + 1)).symm
      _ = (Nat.factorial D.card : ℚ)⁻¹ *
            (∑ σ : StandardLabeling D,
              ((t + 1 : ℕ) : ℚ) ^ blockCount D σ) := by
            simpa only [Fintype.card_coe] using
              (normalizedBlockPolynomial_eval D ((t + 1 : ℕ) : ℚ))

/-- The smallest common subfamily, Proposition 3.6: one cell with
shear weight 2 has q-slice `1 + q²`, while its t-slice is t. -/
theorem one_cell_surface_block_specializations (t : ℕ) (q : ℚ) :
    FinitePoset.H OneCellBridge.oneCellWeight 2 q = 1 + q ^ 2 ∧
      FinitePoset.H OneCellBridge.oneCellWeight (t + 1) 1 =
        ((t + 1 : ℕ) : ℚ) := by
  constructor
  · exact OneCellBridge.oneCell_H_two q
  · rw [OneCellBridge.oneCell_H_one, OneCellBridge.oneCell_omega]

end OrderedRootIntegral
end OrderIdealSpecializations

