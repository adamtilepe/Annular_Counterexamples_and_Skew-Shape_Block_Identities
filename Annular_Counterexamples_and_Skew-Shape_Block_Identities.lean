open CanonicalBlocks

/-- Every head group that is selected in full is visibly occupied
by the tuple-built selection. -/
theorem headTuple_full_group_iff (B : Diagram)
    (lo : ℕ → ℕ) (P : HeadPrefixTuples B lo)
    (g : HeadColumn B lo) :
    (∀ r ∈ leftBoundaryRowGroup B lo g.1,
      (r, g.1) ∈ headTuplesCells B lo P) ↔
      (P g).1 = leftBoundaryRowGroup B lo g.1 := by
  classical
  have hP := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
  constructor
  · intro hfull
    apply Finset.Subset.antisymm hP.1
    intro r hr
    have hSelected := hfull r hr
    obtain ⟨g', hEq, hPick⟩ :=
      (mem_headTuplesCells B lo P r g.1).mp hSelected
    have heq : g' = g := Subtype.ext hEq
    subst g'
    exact hPick
  · intro hfull r hr
    have hChoice : r ∈ (P g).1 := by
      rw [hfull]
      exact hr
    exact (mem_headTuplesCells B lo P r g.1).mpr
      ⟨g, rfl, hChoice⟩

/-- Explicit support of a removable column is nonempty whenever that
column is actually occupied, hence such a column indexes a real group. -/
theorem removable_occupied_is_headColumn (B : Diagram)
    (lo : ℕ → ℕ) (j : ℕ)
    (hj : j ∈ occupiedColumnsRaw B)
    (hrem : RemovableHeadColumn B lo j) :
    j ∈ headColumnIndices B lo := by
  classical
  obtain ⟨c, hc, hcj⟩ := Finset.mem_image.mp hj
  have hcell : (c.1, j) ∈ B := by
    have hcEq : c = (c.1, j) := Prod.ext rfl hcj
    rw [hcEq] at hc
    exact hc
  have hleft : lo c.1 = j := hrem c.1 hcell
  change j ∈ (occupiedRows B).image lo
  apply Finset.mem_image.mpr
  refine ⟨c.1, ?_, hleft⟩
  exact Finset.mem_image.mpr ⟨c, hc, rfl⟩

/-- For a genuinely occupied column, disappearance under a tuple of
prefix choices depends on exactly ONE group coordinate: this column
must consist entirely of row heads, and that group's prefix must be
full. -/
theorem headTuple_column_vanishes_iff_full (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) (j : ℕ)
    (hj : j ∈ occupiedColumnsRaw B) :
    j ∉ occupiedColumnsRaw (B \ headTuplesCells B lo P) ↔
      ∃ hrem : RemovableHeadColumn B lo j,
        (P (⟨j, removable_occupied_is_headColumn B lo j
          hj hrem⟩ : HeadColumn B lo)).1 =
            leftBoundaryRowGroup B lo j := by
  classical
  rw [headTuple_column_disappears B n lo hi hmem hlo P j]
  constructor
  · rintro ⟨hrem, hall⟩
    refine ⟨hrem, ?_⟩
    exact (headTuple_full_group_iff B lo P
      ⟨j, removable_occupied_is_headColumn B lo j
        hj hrem⟩).mp hall
  · rintro ⟨hrem, hfull⟩
    refine ⟨hrem, ?_⟩
    exact (headTuple_full_group_iff B lo P
      ⟨j, removable_occupied_is_headColumn B lo j
        hj hrem⟩).mpr hfull

/-- The leftmost occupied column of any nonempty skew row-interval
diagram consists entirely of row-head cells. Thus every nonempty
skew interval has at least one removable group. No connectivity
assumption is needed for this existence statement. -/
theorem nonempty_skew_has_removable_column (B : Diagram)
    (_hsk : SkewRowIntervals B) (hNonempty : B.Nonempty) :
    ∃ j : ℕ,
      j ∈ occupiedColumnsRaw B ∧
      ∀ n : ℕ, ∀ lo hi : ℕ → ℕ,
        (∀ r c : ℕ,
          (r, c) ∈ B ↔ r < n ∧ lo r ≤ c ∧ c < hi r) →
        RemovableHeadColumn B lo j := by
  classical
  obtain ⟨c, hc⟩ := hNonempty
  have hCols : (occupiedColumnsRaw B).Nonempty :=
    ⟨c.2, Finset.mem_image.mpr ⟨c, hc, rfl⟩⟩
  let j : ℕ := (occupiedColumnsRaw B).min' hCols
  have hj : j ∈ occupiedColumnsRaw B :=
    Finset.min'_mem (occupiedColumnsRaw B) hCols
  refine ⟨j, hj, ?_⟩
  intro n lo hi hmem r hr
  have hData := (hmem r j).mp hr
  have hLoCell : (r, lo r) ∈ B := by
    apply (hmem r (lo r)).mpr
    exact ⟨hData.1, le_refl _, by omega⟩
  have hLoCol : lo r ∈ occupiedColumnsRaw B :=
    Finset.mem_image.mpr ⟨(r, lo r), hLoCell, rfl⟩
  have hMinimal : j ≤ lo r :=
    Finset.min'_le (occupiedColumnsRaw B) (lo r) hLoCol
  omega

end TableauTransfer
end OrderIdealSpecializations

