/-! ### §5.3 — Reindexing the *whole* matrix convolution, not just its first strip. -/

/-- Removing an intermediate ideal from the top interval is the same
as subtracting the initial strip from the full skew interval. -/
theorem intervalCells_after_intermediate (D : Diagram)
    (I K J : ShapeIdeal D)
    (hIK : I.1 ⊆ K.1) (_hKJ : K.1 ⊆ J.1) :
    intervalCells D K J =
      intervalCells D I J \ intervalCells D I K := by
  classical
  ext c
  constructor
  · intro hc
    obtain ⟨hcD, hcJ, hcNotK⟩ :=
      (mem_intervalCells_iff_ideal_membership
        D K J c.1 c.2).mp hc
    have hcNotI :
        (⟨c, hcD⟩ : ShapeCell D) ∉ I.1 := by
      intro hI
      exact hcNotK (hIK hI)
    have hcB : c ∈ intervalCells D I J :=
      (mem_intervalCells_iff_ideal_membership D I J c.1 c.2).mpr
        ⟨hcD, hcJ, hcNotI⟩
    have hcS : c ∉ intervalCells D I K := by
      intro hcS'
      have hh := (mem_intervalCells_iff_ideal_membership
        D I K c.1 c.2).mp hcS'
      have hcK : (⟨c, hcD⟩ : ShapeCell D) ∈ K.1 := hh.2.1
      exact hcNotK hcK
    exact Finset.mem_sdiff.mpr ⟨hcB, hcS⟩
  · intro hc
    obtain ⟨hcB, hcNotS⟩ := Finset.mem_sdiff.mp hc
    obtain ⟨hcD, hcJ, hcNotI⟩ :=
      (mem_intervalCells_iff_ideal_membership
        D I J c.1 c.2).mp hcB
    have hcNotK : (⟨c, hcD⟩ : ShapeCell D) ∉ K.1 := by
      intro hcK
      apply hcNotS
      exact (mem_intervalCells_iff_ideal_membership
        D I K c.1 c.2).mpr ⟨hcD, hcK, hcNotI⟩
    exact (mem_intervalCells_iff_ideal_membership
      D K J c.1 c.2).mpr ⟨hcD, hcJ, hcNotK⟩

/-- A common reindexing theorem for ALL subsequent choices of weights.
In particular, its use for the derivative does not require any
analytic differentiation argument or a separate combinatorial bijection. -/
theorem legalStrips_sum_as_headTuples (D : Diagram)
    (hsk : SkewRowIntervals D) (I J : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ D ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r)
    (nB : ℕ) (loB hiB : ℕ → ℕ)
    (hmemB : ∀ r j : ℕ,
      (r, j) ∈ intervalCells D I J ↔
        r < nB ∧ loB r ≤ j ∧ j < hiB r)
    (hloB : ∀ r : ℕ, r + 1 < nB → loB (r + 1) ≤ loB r)
    (F : Diagram → Diagram → ℚ) :
    (∑ K : LegalInitialStrips D I J,
      F (intervalCells D I K.1) (intervalCells D K.1 J)) =
    ∑ P : HeadPrefixTuples (intervalCells D I J) loB,
      F (headTuplesCells (intervalCells D I J) loB P)
        (intervalCells D I J \
          headTuplesCells (intervalCells D I J) loB P) := by
  classical
  let B : Diagram := intervalCells D I J
  let e₁ := legalStripsEquivPrefixSelections D hsk I J
    hIJ n lo hi hmem hlo hhi
  let e₂ := initialStripChoicesEquivHead D I J
    n lo hi hmem nB loB hiB hmemB
  let e₃ := headSelectionsEquivGroupPrefixes B
    nB loB hiB hmemB hloB
  let e := (e₁.trans e₂).trans e₃
  apply Fintype.sum_equiv e _ _
  intro K
  have hIK : I.1 ⊆ K.1.1 := K.2.1.1
  have hKJ : K.1.1 ⊆ J.1 := K.2.1.2
  have hSelection :
      intervalCells D I K.1 =
        headTuplesCells B loB (e K) := by
    have hRec := headTuplesFromSelection B
      nB loB hiB hmemB hloB (e₂ (e₁ K))
    have hFrom := congrArg Subtype.val hRec
    change headTuplesCells B loB (e K) = (e₂ (e₁ K)).1 at hFrom
    have hHead : (e₂ (e₁ K)).1 = (e₁ K).1 := rfl
    have hStrip : (e₁ K).1 = intervalCells D I K.1 := rfl
    exact hStrip.symm.trans (hHead.symm.trans hFrom.symm)
  have hRemaining := intervalCells_after_intermediate
    D I K.1 J hIK hKJ
  rw [hSelection] at hRemaining
  exact congrArg₂ F hSelection hRemaining

end TableauTransfer
