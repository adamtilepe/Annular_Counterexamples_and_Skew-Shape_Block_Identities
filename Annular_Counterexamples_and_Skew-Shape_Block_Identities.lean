/-- A strict ideal interval contains a cell. -/
theorem strict_intervalCells_nonempty (D : Diagram)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊂ J.1) :
    (intervalCells D I J).Nonempty := by
  classical
  have hproper := (Finset.ssubset_iff_subset_ne).mp hIJ
  have hNonzero : columnCount (intervalCells D I J) ≠ 0 := by
    intro hzero
    have hrev := (interval_width_zero_iff D I J).mp hzero
    exact hproper.2 (Finset.Subset.antisymm hproper.1 hrev)
  by_contra hempty
  have he : intervalCells D I J = ∅ :=
    Finset.not_nonempty_iff_eq_empty.mp hempty
  exact hNonzero (by simp [he, columnCount])

/-- The first equality of Lemma 5.3 at every non-diagonal comparable
pair, with NO connectedness hypothesis. -/
theorem general_Q_mul_T_proper_entry (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊂ J.1) :
    (Q D x * T D x) I J = 0 := by
  classical
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  have hskD : SkewRowIntervals D :=
    ⟨n, lo, hi, hmem, hlo, hhi⟩
  obtain ⟨nB, loB, hiB, hmemB, hloB, hhiB⟩ :=
    movingShape_skew D hskD I J
  let B : Diagram := intervalCells D I J
  obtain ⟨j₀, hj₀, hrem₀⟩ :=
    nonempty_skew_has_removable_column B
      (movingShape_skew D hskD I J)
      (strict_intervalCells_nonempty D I J hIJ)
  have hjHead : j₀ ∈ headColumnIndices B loB :=
    removable_occupied_is_headColumn B loB j₀ hj₀
      (hrem₀ nB loB hiB hmemB)
  let g₀ : HeadColumn B loB := ⟨j₀, hjHead⟩
  rw [Q_mul_T_as_legal_initial_strips]
  have hReindex := legalStrips_sum_as_headTuples D hskD I J
    hIJ.subset n lo hi hmem hlo hhi
    nB loB hiB hmemB hloB
    (fun S R => verticalStripCoefficient x S * x ^ columnCount R)
  rw [hReindex]
  rw [skew_headTuples_bivariate_product B
    nB loB hiB hmemB hloB hhiB x x]
  have hzero :
      (∏ g : HeadColumn B loB,
        if RemovableHeadColumn B loB g.1 then
          (x - x) * (1 - x) ^
            ((leftBoundaryRowGroup B loB g.1).card - 1)
        else (1 - x) ^ (leftBoundaryRowGroup B loB g.1).card) = 0 := by
    apply Finset.prod_eq_zero (Finset.mem_univ g₀)
    simp [g₀, hrem₀ nB loB hiB hmemB]
  rw [hzero]
  ring

/-- On a disconnected strict interval the derivative convolution
vanishes. The two removable columns furnish two *distinct* linear
factors, hence a double root of the bivariate enumerator. -/
theorem disconnected_Q_mul_Tprime_proper_entry (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ)
    (I J : ShapeIdeal D) (hIJ : I.1 ⊂ J.1)
    (hnot : ¬ ConnectedSkewRows (intervalCells D I J)) :
    (Q D x * Tprime D x) I J = 0 := by
  classical
  obtain ⟨n, lo, hi, hmem, hlo, hhi⟩ := hsk
  have hskD : SkewRowIntervals D :=
    ⟨n, lo, hi, hmem, hlo, hhi⟩
  obtain ⟨nB, loB, hiB, hmemB, hloB, hhiB⟩ :=
    movingShape_skew D hskD I J
  let B : Diagram := intervalCells D I J
  obtain ⟨j₀, j₁, hj₀, hj₁, hne, hrem₀, hrem₁⟩ :=
    disconnected_skew_two_removable_columns B
      (movingShape_skew D hskD I J) hnot
      nB loB hiB hmemB hloB hhiB
  let g₀ : HeadColumn B loB :=
    ⟨j₀, removable_occupied_is_headColumn B loB j₀ hj₀ hrem₀⟩
  let g₁ : HeadColumn B loB :=
    ⟨j₁, removable_occupied_is_headColumn B loB j₁ hj₁ hrem₁⟩
  have hgNe : g₀ ≠ g₁ := by
    intro heq
    exact hne (congrArg Subtype.val heq)
  let a : HeadPrefixTuples B loB → ℚ := fun P =>
    verticalStripCoefficient x (headTuplesCells B loB P)
  let m : HeadPrefixTuples B loB → ℕ := fun P =>
    columnCount (B \ headTuplesCells B loB P)
  let c : HeadColumn B loB → ℚ := fun g =>
    if RemovableHeadColumn B loB g.1 then
      (1 - x) ^ ((leftBoundaryRowGroup B loB g.1).card - 1)
    else (1 - x) ^ (leftBoundaryRowGroup B loB g.1).card
  have hFactor : ∀ y : ℚ,
      (∑ P : HeadPrefixTuples B loB, a P * y ^ m P) =
      y ^ (nonremovableColumns B loB).card *
        ∏ g : HeadColumn B loB,
          if RemovableHeadColumn B loB g.1 then
            (y - x) * c g else c g := by
    intro y
    rw [skew_headTuples_bivariate_product B
      nB loB hiB hmemB hloB hhiB x y]
    apply congrArg (fun t : ℚ => y ^ (nonremovableColumns B loB).card * t)
    apply Finset.prod_congr rfl
    intro g _
    by_cases hrem : RemovableHeadColumn B loB g.1
    · simp [c, hrem]
    · simp [c, hrem]
  have hDerivative :
      (∑ P : HeadPrefixTuples B loB,
        a P * ((m P : ℚ) * x ^ (m P - 1))) = 0 :=
    finite_bivariate_two_roots_derivative
      a m (nonremovableColumns B loB).card c
      (fun g : HeadColumn B loB =>
        RemovableHeadColumn B loB g.1)
      g₀ g₁ hgNe hrem₀ hrem₁ x hFactor
  rw [Q_mul_Tprime_as_legal_initial_strips]
  have hReindex := legalStrips_sum_as_headTuples D hskD I J
    hIJ.subset n lo hi hmem hlo hhi
    nB loB hiB hmemB hloB
    (fun S R => verticalStripCoefficient x S *
      ((columnCount R : ℚ) * x ^ (columnCount R - 1)))
  rw [hReindex]
  exact hDerivative

/-- **Lemma 5.3 (Vertical-strip inverse and derivative).**
For every finite skew row-interval diagram the vertical-strip kernel
is a left inverse of the tableau transfer family, and its product
with the entrywise polynomial derivative equals the connected block
kernel. No connectedness hypothesis, auxiliary cancellation
hypothesis, or inverse axiom appears in the statement. -/
theorem vertical_strip_inverse_and_log_derivative (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ) :
    Q D x * T D x = 1 ∧
    Q D x * Tprime D x = A D (1 - x) := by
  apply lemma_5_3_of_proper_interval_sums D x
  · intro I J hIJ
    exact general_Q_mul_T_proper_entry D hsk x I J hIJ
  · intro I J hIJ
    by_cases hconn : ConnectedSkewRows (intervalCells D I J)
    · exact connected_Q_mul_Tprime_entry D hsk x I J hIJ hconn
    · rw [A_of_not_connected D (1 - x) I J hconn]
      exact disconnected_Q_mul_Tprime_proper_entry D hsk x I J hIJ hconn

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Lemma 5.3 also provides the inverse interpretation of the block
kernel: `Q_x` is a two-sided matrix inverse of `T_x`, and
`A_{1-x} = Q_x T'_x` is the corresponding logarithmic derivative.
The inverse is exhibited constructively, without using an arbitrary
inverse as an extra assumption. -/
theorem inverse_transfer_log_derivative_formula (D : Diagram)
    (hsk : SkewRowIntervals D) (x : ℚ) :
    ∃ R : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ,
      R * T D x = 1 ∧
      T D x * R = 1 ∧
      A D (1 - x) = R * Tprime D x := by
  classical
  obtain ⟨hQT, hQDerivative⟩ :=
    vertical_strip_inverse_and_log_derivative D hsk x
  refine ⟨Q D x, hQT, ?_, hQDerivative.symm⟩
  exact (mul_eq_one_comm).mp hQT

end TableauTransfer
end OrderIdealSpecializations

/-! ### §5.4 — Proposition 5.4 — universal commuting block kernels. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.4 — Formal differentiation of a polynomial matrix centralizer. -/

/-- Evaluate each entry of a polynomial matrix at a rational parameter. -/
private noncomputable def evalPolynomialMatrix {ι : Type*}
    (P : Matrix ι ι (Polynomial ℚ)) (x : ℚ) : Matrix ι ι ℚ :=
  Matrix.of (fun i j => (P i j).eval x)

/-- Evaluate the formal derivatives of all entries of a polynomial matrix. -/
private noncomputable def evalDerivativeMatrix {ι : Type*}
    (P : Matrix ι ι (Polynomial ℚ)) (x : ℚ) : Matrix ι ι ℚ :=
  Matrix.of (fun i j => (Polynomial.derivative (P i j)).eval x)

/-- A constant matrix commuting with every evaluation of a polynomial
matrix also commutes with every evaluation of its formal derivative. -/
private theorem matrix_commutes_polynomial_derivative
    {ι : Type*} [Fintype ι]
    (P : Matrix ι ι (Polynomial ℚ)) (M : Matrix ι ι ℚ)
    (hcomm : ∀ t : ℚ,
      M * evalPolynomialMatrix P t = evalPolynomialMatrix P t * M)
    (x : ℚ) :
    M * evalDerivativeMatrix P x = evalDerivativeMatrix P x * M := by
  classical
  ext i j
  have hpoly :
      (∑ k : ι, Polynomial.C (M i k) * P k j) =
        (∑ k : ι, P i k * Polynomial.C (M k j)) := by
    apply Polynomial.funext
    intro t
    have he := congrArg
      (fun N : Matrix ι ι ℚ => N i j) (hcomm t)
    simp only [Matrix.mul_apply] at he
    change (∑ k : ι, M i k * (P k j).eval t) =
      (∑ k : ι, (P i k).eval t * M k j) at he
    calc
      Polynomial.eval t (∑ k : ι, Polynomial.C (M i k) * P k j) =
          ∑ k : ι, M i k * (P k j).eval t := by
            simp [Polynomial.eval_finsetSum]
      _ = ∑ k : ι, (P i k).eval t * M k j := he
      _ = Polynomial.eval t
            (∑ k : ι, P i k * Polynomial.C (M k j)) := by
            simp [Polynomial.eval_finsetSum]
  have hderivative := congrArg
    (fun p : Polynomial ℚ => (Polynomial.derivative p).eval x) hpoly
  have hleft :
      (Polynomial.derivative
        (∑ k : ι, Polynomial.C (M i k) * P k j)).eval x =
          ∑ k : ι, M i k * (Polynomial.derivative (P k j)).eval x := by
    simp [Polynomial.derivative_mul, Polynomial.eval_finsetSum]
  have hright :
      (Polynomial.derivative
        (∑ k : ι, P i k * Polynomial.C (M k j))).eval x =
          ∑ k : ι, (Polynomial.derivative (P i k)).eval x * M k j := by
    simp [Polynomial.derivative_mul, Polynomial.eval_finsetSum]
  change (∑ k : ι, M i k * (Polynomial.derivative (P k j)).eval x) =
    (∑ k : ι, (Polynomial.derivative (P i k)).eval x * M k j)
  exact hleft.symm.trans (hderivative.trans hright)

/-! ### §5.4 — Connect the polynomial transfer to T and Tprime. -/

private theorem eval_transfer_polynomial (D : Diagram) (x : ℚ) :
    evalPolynomialMatrix (Tpolynomial D) x = T D x := by
  classical
  ext I J
  change (Tpolynomial D I J).eval x = T D x I J
  by_cases hIJ : I.1 ⊆ J.1
  · rw [T_of_subset D x I J hIJ]
    change Polynomial.eval x
      (if I.1 ⊆ J.1 then
        (Polynomial.X : Polynomial ℚ) ^
          columnCount (intervalCells D I J)
       else 0) = x ^ columnCount (intervalCells D I J)
    simp [hIJ]
  · rw [T_of_not_subset D x I J hIJ]
    change Polynomial.eval x
      (if I.1 ⊆ J.1 then
        (Polynomial.X : Polynomial ℚ) ^
          columnCount (intervalCells D I J)
       else 0) = 0
    simp [hIJ]

private theorem eval_transfer_derivative (D : Diagram) (x : ℚ) :
    evalDerivativeMatrix (Tpolynomial D) x = Tprime D x := by
  classical
  ext I J
  change (Polynomial.derivative (Tpolynomial D I J)).eval x =
    Tprime D x I J
  exact (Tprime_is_polynomial_derivative D x I J).symm

/-- First formal differentiation of the two-parameter T commutation. -/
theorem transfer_commutes_with_derivatives (D : Diagram)
    (hsk : SkewRowIntervals D) (x y : ℚ) :
    T D x * Tprime D y = Tprime D y * T D x := by
  have hcomm : ∀ t : ℚ,
      T D x * evalPolynomialMatrix (Tpolynomial D) t =
        evalPolynomialMatrix (Tpolynomial D) t * T D x := by
    intro t
    simpa only [eval_transfer_polynomial] using
      (tableau_transfer_matrices_commute D hsk x t)
  have h := matrix_commutes_polynomial_derivative
    (Tpolynomial D) (T D x) hcomm y
  simpa only [eval_transfer_derivative] using h

/-- Second formal differentiation: all polynomial transfer derivatives
commute, even at different parameter values. -/
theorem transfer_derivatives_pairwise_commute (D : Diagram)
    (hsk : SkewRowIntervals D) (x y : ℚ) :
    Tprime D x * Tprime D y = Tprime D y * Tprime D x := by
  have hcomm : ∀ t : ℚ,
      Tprime D x * evalPolynomialMatrix (Tpolynomial D) t =
        evalPolynomialMatrix (Tpolynomial D) t * Tprime D x := by
    intro t
    simpa only [eval_transfer_polynomial] using
      (transfer_commutes_with_derivatives D hsk t x).symm
  have h := matrix_commutes_polynomial_derivative
    (Tpolynomial D) (Tprime D x) hcomm y
  simpa only [eval_transfer_derivative] using h

/-! ### §5.4 — Inverse centralizers and the conclusion for A. -/

/-- If R is a two-sided inverse of P, everything commuting with P
also commutes with R. -/
private theorem inverse_commutes_with
    {α : Type*} [Monoid α] (R P M : α)
    (hRP : R * P = 1) (hPR : P * R = 1)
    (hPM : P * M = M * P) : R * M = M * R := by
  calc
    R * M = R * (M * (P * R)) := by rw [hPR, mul_one]
    _ = R * ((M * P) * R) := by rw [mul_assoc]
    _ = R * ((P * M) * R) := by rw [hPM]
    _ = (R * P) * (M * R) := by simp only [mul_assoc]
    _ = M * R := by rw [hRP, one_mul]

/-- Four pairwise-commuting cross factors yield two commuting products.
This argument is valid in any monoid, not just in matrix rings. -/
private theorem commuting_products
    {α : Type*} [Monoid α] (a b c d : α)
    (hac : a * c = c * a) (had : a * d = d * a)
    (hbc : b * c = c * b) (hbd : b * d = d * b) :
    (a * b) * (c * d) = (c * d) * (a * b) := by
  calc
    (a * b) * (c * d) = a * (b * c) * d := by simp only [mul_assoc]
    _ = a * (c * b) * d := by rw [hbc]
    _ = (a * c) * (b * d) := by simp only [mul_assoc]
    _ = (c * a) * (d * b) := by rw [hac, hbd]
    _ = c * (a * d) * b := by simp only [mul_assoc]
    _ = c * (d * a) * b := by rw [had]
    _ = (c * d) * (a * b) := by simp only [mul_assoc]

/-- **Proposition 5.4 (Commuting block kernels).**
Proposition 5.4 — universal commutation of block kernels.
For every finite skew Young diagram D and all rational parameters z,u,
its connected-block transfer kernels A_z and A_u commute.

The proof uses only the already established Lemmas 5.1 and 5.3,
formal polynomial differentiation, and ordinary matrix algebra. -/
theorem connected_block_kernels_commute (D : Diagram)
    (hsk : SkewRowIntervals D) (z u : ℚ) :
    A D z * A D u = A D u * A D z := by
  classical
  have hQT (x : ℚ) : Q D x * T D x = 1 :=
    (vertical_strip_inverse_and_log_derivative D hsk x).1
  have hTQ (x : ℚ) : T D x * Q D x = 1 :=
    (mul_eq_one_comm).mp (hQT x)
  have hQ_T (x y : ℚ) :
      Q D x * T D y = T D y * Q D x := by
    exact inverse_commutes_with (Q D x) (T D x) (T D y)
      (hQT x) (hTQ x) (tableau_transfer_matrices_commute D hsk x y)
  have hQ_Tprime (x y : ℚ) :
      Q D x * Tprime D y = Tprime D y * Q D x := by
    exact inverse_commutes_with (Q D x) (T D x) (Tprime D y)
      (hQT x) (hTQ x) (transfer_commutes_with_derivatives D hsk x y)
  have hQ_Q (x y : ℚ) :
      Q D x * Q D y = Q D y * Q D x := by
    exact inverse_commutes_with (Q D x) (T D x) (Q D y)
      (hQT x) (hTQ x) (hQ_T y x).symm
  have hA (x : ℚ) : A D (1 - x) = Q D x * Tprime D x :=
    (vertical_strip_inverse_and_log_derivative D hsk x).2.symm
  have hz : A D z = Q D (1 - z) * Tprime D (1 - z) := by
    have heq : 1 - (1 - z) = z := by ring
    simpa only [heq] using (hA (1 - z))
  have hu : A D u = Q D (1 - u) * Tprime D (1 - u) := by
    have heq : 1 - (1 - u) = u := by ring
    simpa only [heq] using (hA (1 - u))
  calc
    A D z * A D u =
        (Q D (1 - z) * Tprime D (1 - z)) *
          (Q D (1 - u) * Tprime D (1 - u)) := by rw [hz, hu]
    _ = (Q D (1 - u) * Tprime D (1 - u)) *
          (Q D (1 - z) * Tprime D (1 - z)) := by
            exact commuting_products
              (Q D (1 - z)) (Tprime D (1 - z))
              (Q D (1 - u)) (Tprime D (1 - u))
              (hQ_Q (1 - z) (1 - u))
              (hQ_Tprime (1 - z) (1 - u))
              (hQ_Tprime (1 - u) (1 - z)).symm
              (transfer_derivatives_pairwise_commute D hsk (1 - z) (1 - u))
    _ = A D u * A D z := by rw [hu, hz]

end TableauTransfer
end OrderIdealSpecializations

/-!
## §6 — Resolution of the skew-shape block-statistic identity
### Lemma 6.1 — Ordered-root integral

The proof combines the canonical block-chain decomposition with exact
polynomial primitives and the associated connected-block kernel products.
-/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Standard labelings and canonical block count. -/

/-- A bijective labeling by `0, ..., n-1` where `n` is the number of
cells.  Shifting every label by one yields the paper's `[n]` convention;
all root comparisons and the block count are invariant under the shift. -/
abbrev StandardLabeling (D : Diagram) :=
  ShapeCell D ≃ Fin (Fintype.card (ShapeCell D))

/-- Extend a bijection from the cells of `D` to a total numerical
labeling, with arbitrary values outside `D` (here zero). -/
noncomputable def labelingOf (D : Diagram) (σ : StandardLabeling D) :
    Cell → ℕ := by
  classical
  exact fun c => if hc : c ∈ D then (σ ⟨c, hc⟩).val else 0

/-- Every standard labeling really is injective on the diagram. -/
theorem labelingOf_injectiveOn (D : Diagram) (σ : StandardLabeling D) :
    ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      labelingOf D σ a = labelingOf D σ b → a = b := by
  classical
  intro a ha b hb hab
  have hval : (σ ⟨a, ha⟩).val = (σ ⟨b, hb⟩).val := by
    simpa only [labelingOf, dite_eq_left ha, dite_eq_left hb] using hab
  have hfin : σ ⟨a, ha⟩ = σ ⟨b, hb⟩ := Fin.ext hval
  have hsub : (⟨a, ha⟩ : ShapeCell D) = ⟨b, hb⟩ :=
    σ.injective hfin
  exact congrArg Subtype.val hsub

/-- The root labels of the NONEMPTY canonical fibers. This counts
actual blocks, not just all possible labels or a postulated statistic. -/
noncomputable def activeRootLabels (D : Diagram)
    (σ : StandardLabeling D) : Finset ℕ := by
  classical
  exact (D.image (labelingOf D σ)).filter
    (fun r => (canonicalRootFiber D (labelingOf D σ) r).Nonempty)

/-- The filter includes exactly the roots of nonempty canonical blocks;
there is no extra support hypothesis in the reverse implication. -/
theorem mem_activeRootLabels_iff (D : Diagram)
    (σ : StandardLabeling D) (r : ℕ) :
    r ∈ activeRootLabels D σ ↔
      (canonicalRootFiber D (labelingOf D σ) r).Nonempty := by
  classical
  change r ∈ (D.image (labelingOf D σ)).filter
    (fun s => (canonicalRootFiber D (labelingOf D σ) s).Nonempty) ↔ _
  rw [Finset.mem_filter]
  constructor
  · intro hr
    exact hr.2
  · intro hr
    exact ⟨nonemptyRootFiber_mem_labelImage
      D (labelingOf D σ) r hr, hr⟩

/-- The statistic appearing in the LEFT side of manuscript (6.1).
Its interpretation uses precisely the root-excluded Definition 4.1. -/
noncomputable def blockCount (D : Diagram)
    (σ : StandardLabeling D) : ℕ :=
  (activeRootLabels D σ).card

/-- The corrected number of blocks can never exceed the number of cells. -/
theorem blockCount_le_card (D : Diagram) (σ : StandardLabeling D) :
    blockCount D σ ≤ D.card := by
  classical
  unfold blockCount activeRootLabels
  calc
    ((D.image (labelingOf D σ)).filter
      (fun r => (canonicalRootFiber D (labelingOf D σ) r).Nonempty)).card ≤
        (D.image (labelingOf D σ)).card :=
          Finset.card_le_card (Finset.filter_subset _ _)
    _ ≤ D.card := Finset.card_image_le

/-- The canonical decomposition for every bijective labeling is an
ACTUAL corrected Kahane-valid block partition, and it is unique.
This supplies the canonical block-chain bridge used in Lemma 6.1. -/
theorem standardLabeling_unique_validBlocks (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D) :
    ∃ roots : PartialRoots,
      KahaneOrderedBlockAssignment D (labelingOf D σ) roots ∧
      ∀ other : PartialRoots,
        KahaneOrderedBlockAssignment D (labelingOf D σ) other →
        ∀ c : Cell, c ∈ D → other c = roots c := by
  exact correctedKahaneBlocks_exists_unique D (labelingOf D σ)
    hsk (labelingOf_injectiveOn D σ)

/-- The EXACT polynomial on the left of (6.1).  It is normalized by
`n!`, with `n` the number of cells of the finite diagram. -/
noncomputable def normalizedBlockPolynomial (D : Diagram) :
    Polynomial ℚ := by
  classical
  exact Polynomial.C
      (((Nat.factorial (Fintype.card (ShapeCell D)) : ℕ) : ℚ)⁻¹) *
    (∑ σ : StandardLabeling D,
      (Polynomial.X : Polynomial ℚ) ^ blockCount D σ)

/-- This is exactly the normalized finite sum in equation (6.1),
after setting the polynomial variable to a rational value `t`. -/
theorem normalizedBlockPolynomial_eval (D : Diagram) (t : ℚ) :
    (normalizedBlockPolynomial D).eval t =
      (((Nat.factorial (Fintype.card (ShapeCell D)) : ℕ) : ℚ)⁻¹) *
        (∑ σ : StandardLabeling D, t ^ blockCount D σ) := by
  classical
  simp [normalizedBlockPolynomial, Polynomial.eval_finsetSum]

/-! ### §6.1 — Exact rational ordered-simplex integrals. -/

/-- The unique formal primitive with zero constant term, constructed
coefficientwise. For `p(X)=∑aₙXⁿ` this is `∑aₙXⁿ⁺¹/(n+1)`.
No real analysis or measure theory is needed to compute these integrals. -/
noncomputable def primitiveFromZero (p : Polynomial ℚ) : Polynomial ℚ :=
  p.sum (fun n a =>
    Polynomial.monomial (n + 1) (a / ((↑(n + 1)) : ℚ)))

/-- The formal primitive has precisely the original polynomial as its
derivative. This is the algebraic fundamental theorem of calculus that
makes the ordered integrals faithful, rather than a renaming of a sum. -/
theorem derivative_primitiveFromZero (p : Polynomial ℚ) :
    Polynomial.derivative (primitiveFromZero p) = p := by
  classical
  have hcoeff (n : ℕ) (a : ℚ) :
      (a / ((↑(n + 1)) : ℚ)) * ((↑n : ℚ) + 1) = a := by
    have hn : ((↑(n + 1)) : ℚ) ≠ 0 := by positivity
    have hcast : ((↑n : ℚ) + 1) = ((↑(n + 1)) : ℚ) := by push_cast; ring
    rw [hcast]
    field_simp [hn]
  calc
    Polynomial.derivative (primitiveFromZero p) =
        ∑ n ∈ p.support,
          Polynomial.monomial n
            ((p.coeff n / ((↑(n + 1)) : ℚ)) * ((↑n : ℚ) + 1)) := by
              simp only [primitiveFromZero, Polynomial.sum_def,
                Polynomial.derivative_sum,
                Polynomial.derivative_monomial_succ]
    _ = ∑ n ∈ p.support, Polynomial.monomial n (p.coeff n) := by
          apply Finset.sum_congr rfl
          intro n _
          rw [hcoeff]
    _ = p := by
          simpa only [Polynomial.sum_def] using
            (Polynomial.sum_monomial_eq p)

/-- The primitive really starts at zero, so evaluation at its
upper endpoint is a definite integral rather than an arbitrary antiderivative. -/
theorem primitiveFromZero_eval_zero (p : Polynomial ℚ) :
    (primitiveFromZero p).eval 0 = 0 := by
  classical
  simp only [primitiveFromZero, Polynomial.sum_def,
    Polynomial.eval_finsetSum]
  apply Finset.sum_eq_zero
  intro n hn
  simp [Polynomial.eval_monomial]

/-- Evaluation at the upper endpoint gives an exact rational integral
`∫₀¹ p(z) dz`, computed through the zero-constant primitive. -/
noncomputable def integrateUnit (p : Polynomial ℚ) : ℚ :=
  (primitiveFromZero p).eval 1

/-- Polynomial-valued connected-block kernel. Evaluating `X` at a
rational parameter `z` recovers the previously established `A D z`. -/
noncomputable def blockKernelPolynomial (D : Diagram) :
    Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ) := by
  classical
  exact Matrix.of (fun I J =>
    if I.1 ⊂ J.1 ∧ ConnectedSkewRows (intervalCells D I J) then
      (Polynomial.X : Polynomial ℚ) ^
        (rowCount (intervalCells D I J) - 1) *
      (1 - Polynomial.X) ^
        (columnCount (intervalCells D I J) - 1)
    else 0)

/-- Direct entrywise check: the new polynomial kernel genuinely
specializes to the original connected-block matrix `A`. -/
theorem blockKernelPolynomial_eval (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D) :
    (blockKernelPolynomial D I J).eval z = A D z I J := by
  classical
  change Polynomial.eval z
    (if I.1 ⊂ J.1 ∧ ConnectedSkewRows (intervalCells D I J) then
      (Polynomial.X : Polynomial ℚ) ^
        (rowCount (intervalCells D I J) - 1) *
      (1 - Polynomial.X) ^
        (columnCount (intervalCells D I J) - 1)
    else 0) =
    (if I.1 ⊂ J.1 ∧ ConnectedSkewRows (intervalCells D I J) then
      z ^ (rowCount (intervalCells D I J) - 1) *
        (1 - z) ^ (columnCount (intervalCells D I J) - 1)
    else 0)
  split_ifs <;> simp

/-- The ordered root-simplex integral with `k` blocks, but with a
variable upper endpoint X. Recurrence:
F₀(I,J;X)=δ(I,J),
Fₖ₊₁(I,J;X)=∫₀ˣ ∑_K Fₖ(I,K;z) A_z(K,J) dz.
The matrix multiplication order is the order of increasing roots. -/
noncomputable def orderedKernelPrimitive (D : Diagram) :
    ℕ → Matrix (ShapeIdeal D) (ShapeIdeal D) (Polynomial ℚ)
  | 0 => by
      classical
      exact 1
  | k + 1 => by
      classical
      exact Matrix.of (fun I J =>
        primitiveFromZero
          (∑ K : ShapeIdeal D,
            orderedKernelPrimitive D k I K * blockKernelPolynomial D K J))

/-- The coefficient of t^k on the right of (6.1), evaluated at the
endpoints ∅ and D after integrating over ordered root values. -/
noncomputable def orderedKernelCoefficient (D : Diagram) (k : ℕ) : ℚ :=
  (orderedKernelPrimitive D k
    (FinitePoset.bottomIdeal (α := ShapeCell D))
    (FinitePoset.topIdeal (α := ShapeCell D))).eval 1

/-- The exact polynomial on the RIGHT of (6.1). The upper bound on k
is the number of cells: every nonzero A-increment adds at least one cell. -/
noncomputable def orderedKernelPolynomial (D : Diagram) :
    Polynomial ℚ := by
  classical
  exact ∑ k ∈ Finset.range (D.card + 1),
    Polynomial.C (orderedKernelCoefficient D k) *
      (Polynomial.X : Polynomial ℚ) ^ k

/-- Evaluation gives exactly the ordered-integral sum on the
right-hand side of (6.1), once the formal-primitives/real-integrals
identification is carried out. -/
theorem orderedKernelPolynomial_eval (D : Diagram) (t : ℚ) :
    (orderedKernelPolynomial D).eval t =
      ∑ k ∈ Finset.range (D.card + 1),
        orderedKernelCoefficient D k * t ^ k := by
  classical
  simp [orderedKernelPolynomial, Polynomial.eval_finsetSum]

/-- The ordered-root integral identity, expressed as a proposition
rather than being introduced as a theorem with a circular proof. -/
def OrderedRootIntegralStatement (D : Diagram) : Prop :=
  SkewRowIntervals D →
    normalizedBlockPolynomial D = orderedKernelPolynomial D

/-- The k=0 ordered product is the identity matrix, corresponding to
one empty root chain; it contributes only when the endpoints coincide. -/
theorem orderedKernelPrimitive_zero (D : Diagram) :
    orderedKernelPrimitive D 0 = 1 := by
  classical
  rfl

/-- The exact recursive integration equation (the algebraic version of
integrating over the final root coordinate). -/
theorem orderedKernelPrimitive_succ (D : Diagram) (k : ℕ)
    (I J : ShapeIdeal D) :
    orderedKernelPrimitive D (k + 1) I J =
      primitiveFromZero
        (∑ K : ShapeIdeal D,
          orderedKernelPrimitive D k I K * blockKernelPolynomial D K J) := rfl

/-! ### §6.1 — Ordered-root kernel and canonical-chain identity. -/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Connected-block chains and kernel paths. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Strict chains of connected skew increments. -/

/-- An admissible single step between ideals: strict containment and a
connected skew increment, exactly the support condition of the A-kernel. -/
def IsConnectedBlockIncrement (D : Diagram)
    (I J : ShapeIdeal D) : Prop :=
  I.1 ⊂ J.1 ∧ ConnectedSkewRows (intervalCells D I J)

/-- A sequence of `k+1` actual lower ideals from the empty ideal to the
full ideal, with all `k` consecutive differences nonempty and connected.
Indices on `Fin k` identify the consecutive pair `i`, `i+1`.

In particular, this object does not encode a weak chain: every increment
is strictly positive in the ideal order. The root-label compatibility
conditions of Lemma 6.1 will be added in , not presumed here. -/
structure ConnectedBlockChain (D : Diagram) (k : ℕ) where
  ideals : Fin (k + 1) → ShapeIdeal D
  starts : ideals ⟨0, Nat.zero_lt_succ k⟩ =
    FinitePoset.bottomIdeal (α := ShapeCell D)
  finishes : ideals ⟨k, Nat.lt_succ_self k⟩ =
    FinitePoset.topIdeal (α := ShapeCell D)
  steps : ∀ i : Fin k,
    IsConnectedBlockIncrement D (ideals i.castSucc) (ideals i.succ)

/-- Each increment of a connected-block chain contains a genuine cell. -/
theorem connectedBlockChain_increment_nonempty
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (i : Fin k) :
    (intervalCells D (C.ideals i.castSucc) (C.ideals i.succ)).Nonempty := by
  exact strict_intervalCells_nonempty D _ _ (C.steps i).1

/-- The local product of the row/column factors from manuscript (5.2),
for the ordered root parameters indexed by the steps of a fixed chain. -/
noncomputable def connectedBlockChainWeight
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (z : Fin k → ℚ) : ℚ :=
  ∏ i : Fin k,
    z i ^ (rowCount
      (intervalCells D (C.ideals i.castSucc) (C.ideals i.succ)) - 1) *
    (1 - z i) ^ (columnCount
      (intervalCells D (C.ideals i.castSucc) (C.ideals i.succ)) - 1)

/-- On every actual connected-block chain, the explicit weight is the
product of its corresponding entries of `A` (not an assumed identity). -/
theorem connectedBlockChainWeight_eq_A_product
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (z : Fin k → ℚ) :
    connectedBlockChainWeight C z =
      ∏ i : Fin k,
        A D (z i) (C.ideals i.castSucc) (C.ideals i.succ) := by
  classical
  unfold connectedBlockChainWeight
  apply Finset.prod_congr rfl
  intro i _
  exact (A_of_connected D (z i)
    (C.ideals i.castSucc) (C.ideals i.succ)
    (C.steps i).1 (C.steps i).2).symm

/-! ### §6.1 — A finite recursive sum over admissible connected paths. -/

/-- The weight of one putative step. An invalid step contributes zero;
an admissible one has precisely the geometric boundary weight of (5.2). -/
noncomputable def connectedStepWeight (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D) : ℚ := by
  classical
  exact if IsConnectedBlockIncrement D I J then
    z ^ (rowCount (intervalCells D I J) - 1) *
      (1 - z) ^ (columnCount (intervalCells D I J) - 1)
    else 0

/-- Identification of the independently defined admissible-step weight
with one already formalized entry of the connected-block transfer kernel. -/
theorem connectedStepWeight_eq_A (D : Diagram) (z : ℚ)
    (I J : ShapeIdeal D) :
    connectedStepWeight D z I J = A D z I J := by
  classical
  unfold connectedStepWeight IsConnectedBlockIncrement
  by_cases h : I.1 ⊂ J.1 ∧
      ConnectedSkewRows (intervalCells D I J)
  · rw [ite_eq_left h]
    exact (A_of_connected D z I J h.1 h.2).symm
  · rw [ite_eq_right h]
    by_cases hp : I.1 ⊂ J.1
    · exact (A_of_not_connected D z I J
        (fun hc => h ⟨hp, hc⟩)).symm
    · exact (A_of_not_ssubset D z I J hp).symm

/-- Recursively enumerate all ideal paths between arbitrary endpoints
with the chosen increasing-root parameters `zs`.

For `[]`, only the empty path from an ideal to itself survives. At
`z :: zs`, the next ideal K is selected. Only STRICT CONNECTED steps I->K
have nonzero step weight, and the remainder is enumerated recursively.
This is a genuine finite combinatorial sum, not a matrix-product alias. -/
noncomputable def connectedChainKernelSum (D : Diagram) :
    List ℚ → ShapeIdeal D → ShapeIdeal D → ℚ
  | [], I, J => by
      classical
      exact if I = J then 1 else 0
  | z :: zs, I, J => by
      classical
      exact ∑ K : ShapeIdeal D,
        connectedStepWeight D z I K * connectedChainKernelSum D zs K J

/-- An ordered product of block kernels. If roots are ordered
`z₁ < ... < zₖ`, the matrix order is A(z₁)...A(zₖ), as in (6.1).
For no roots, the product is the identity matrix. -/
noncomputable def orderedBlockMatrixProduct (D : Diagram) :
    List ℚ → Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ
  | [] => by
      classical
      exact 1
  | z :: zs => by
      classical
      exact A D z * orderedBlockMatrixProduct D zs

/-- ** matrix/chain identity.** Every entry in a finite ordered
product of A-kernels is exactly the recursive sum over strict connected
ideal steps, with the prescribed local row/column weights. The proof is
an induction over the number of parameters and does not invoke 6.1. -/
theorem connectedChainKernelSum_eq_matrix_product (D : Diagram)
    (zs : List ℚ) (I J : ShapeIdeal D) :
    connectedChainKernelSum D zs I J =
      orderedBlockMatrixProduct D zs I J := by
  induction zs generalizing I with
  | nil =>
      classical
      change (if I = J then (1 : ℚ) else 0) =
        (1 : Matrix (ShapeIdeal D) (ShapeIdeal D) ℚ) I J
      by_cases h : I = J
      · subst J
        simp
      · simp [h]
  | cons z zs ih =>
      classical
      change
        (∑ K : ShapeIdeal D,
          connectedStepWeight D z I K * connectedChainKernelSum D zs K J) =
          (A D z * orderedBlockMatrixProduct D zs) I J
      rw [Matrix.mul_apply]
      apply Finset.sum_congr rfl
      intro K _
      rw [connectedStepWeight_eq_A D z I K, ih K]

/-- The same identification for exactly the endpoints of the manuscript:
empty ideal at the left and full diagram at the right. -/
theorem connectedChainKernelSum_bottom_top (D : Diagram) (zs : List ℚ) :
    connectedChainKernelSum D zs
      (FinitePoset.bottomIdeal (α := ShapeCell D))
      (FinitePoset.topIdeal (α := ShapeCell D)) =
    orderedBlockMatrixProduct D zs
      (FinitePoset.bottomIdeal (α := ShapeCell D))
      (FinitePoset.topIdeal (α := ShapeCell D)) := by
  exact connectedChainKernelSum_eq_matrix_product D zs _ _

/-! ### §6.1 — End-point identities for kernel chains. -/

end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Lemma 6.1: canonical root-threshold filtration. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Root thresholds are order ideals. -/

/-- Cells whose canonical block-root label is at least `cutoff`, regarded
as elements of the finite cell poset. In the poset orientation of §5 this
is the right (LOWER ideal) direction. -/
noncomputable def canonicalRootUpperCut
    (D : Diagram) (label : Cell → ℕ) (cutoff : ℕ) :
    Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c : ShapeCell D =>
    ∃ r : ℕ, c.1 ∈ canonicalRootFiber D label r ∧ cutoff ≤ r)

@[simp] theorem mem_canonicalRootUpperCut
    (D : Diagram) (label : Cell → ℕ) (cutoff : ℕ)
    (c : ShapeCell D) :
    c ∈ canonicalRootUpperCut D label cutoff ↔
      ∃ r : ℕ, c.1 ∈ canonicalRootFiber D label r ∧ cutoff ≤ r := by
  classical
  change c ∈ (Finset.univ.filter (fun c : ShapeCell D =>
    ∃ r : ℕ, c.1 ∈ canonicalRootFiber D label r ∧ cutoff ≤ r)) ↔ _
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

/-- The crucial geometrical bridge: root labels decrease along the
coordinatewise poset order, so upper root thresholds are lower ideals. -/
theorem canonicalRootUpperCut_isIdeal
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (cutoff : ℕ) :
    FinitePoset.IsIdeal (canonicalRootUpperCut D label cutoff) := by
  intro a b hab hb
  obtain ⟨rb, hbRoot, hcut⟩ :=
    (mem_canonicalRootUpperCut D label cutoff b).mp hb
  obtain ⟨ra, haRoot⟩ := canonicalRootFiber_cover D label a.1 a.property
  have hcoords : a.1.1 ≤ b.1.1 ∧ a.1.2 ≤ b.1.2 := by
    exact hab
  have horder : rb ≤ ra :=
    canonicalRootFibers_ordered D label hsk
      a.1 b.1 ra rb haRoot hbRoot hcoords.1 hcoords.2
  exact (mem_canonicalRootUpperCut D label cutoff a).mpr
    ⟨ra, haRoot, hcut.trans horder⟩

/-- Each root threshold is a genuine lower ideal in the SAME index type
used by the kernels `T`, `Q` and `A`. -/
noncomputable def canonicalRootThresholdIdeal
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (cutoff : ℕ) : ShapeIdeal D :=
  ⟨canonicalRootUpperCut D label cutoff,
    canonicalRootUpperCut_isIdeal D label hsk cutoff⟩

/-- Raising the root cutoff can only shrink the corresponding ideal. -/
theorem canonicalRootUpperCut_antitone
    (D : Diagram) (label : Cell → ℕ)
    {a b : ℕ} (hab : a ≤ b) :
    canonicalRootUpperCut D label b ⊆
      canonicalRootUpperCut D label a := by
  intro c hc
  obtain ⟨r, hr, hbr⟩ := (mem_canonicalRootUpperCut D label b c).mp hc
  exact (mem_canonicalRootUpperCut D label a c).mpr
    ⟨r, hr, hab.trans hbr⟩

/-- For consecutive cutoffs, the removed cells are EXACTLY one canonical
block: there is no reliance on an informal picture of the roots. -/
theorem mem_rootThreshold_succ_difference
    (D : Diagram) (label : Cell → ℕ) (r : ℕ)
    (c : ShapeCell D) :
    c ∈ canonicalRootUpperCut D label r \
        canonicalRootUpperCut D label (r + 1) ↔
      c.1 ∈ canonicalRootFiber D label r := by
  classical
  constructor
  · intro hc
    obtain ⟨hlo, hhi⟩ := Finset.mem_sdiff.mp hc
    obtain ⟨s, hs, hrs⟩ :=
      (mem_canonicalRootUpperCut D label r c).mp hlo
    have hlt : s < r + 1 := by
      by_contra hnot
      have hge : r + 1 ≤ s := by omega
      exact hhi ((mem_canonicalRootUpperCut D label (r + 1) c).mpr
        ⟨s, hs, hge⟩)
    have heq : s = r := by omega
    simpa only [heq] using hs
  · intro hc
    apply Finset.mem_sdiff.mpr
    constructor
    · exact (mem_canonicalRootUpperCut D label r c).mpr
        ⟨r, hc, le_rfl⟩
    · intro hbad
      obtain ⟨s, hs, hge⟩ :=
        (mem_canonicalRootUpperCut D label (r + 1) c).mp hbad
      have heq : r = s := canonicalRootFiber_unique D label c.1 r s hc hs
      omega

/-- The skew interval between two consecutive root thresholds equals
EXACTLY the canonical fiber with that root label. -/
theorem rootThreshold_interval_eq_fiber
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (r : ℕ) :
    intervalCells D
      (canonicalRootThresholdIdeal D label hsk (r + 1))
      (canonicalRootThresholdIdeal D label hsk r) =
    canonicalRootFiber D label r := by
  classical
  ext c
  change c ∈ (canonicalRootUpperCut D label r \
    canonicalRootUpperCut D label (r + 1)).image
      (fun a : ShapeCell D => a.1) ↔ _
  constructor
  · intro hc
    obtain ⟨a, ha, heq⟩ := Finset.mem_image.mp hc
    have hr := (mem_rootThreshold_succ_difference D label r a).mp ha
    simpa only [heq] using hr
  · intro hc
    have hcD : c ∈ D := canonicalRootFiber_subset D label r hc
    let a : ShapeCell D := ⟨c, hcD⟩
    exact Finset.mem_image.mpr
      ⟨a, (mem_rootThreshold_succ_difference D label r a).mpr hc, rfl⟩

/-- A root is active precisely if its successive threshold increment
contains at least one cell. -/
theorem rootThreshold_step_nonempty_iff
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D) (r : ℕ) :
    (intervalCells D
      (canonicalRootThresholdIdeal D label hsk (r + 1))
      (canonicalRootThresholdIdeal D label hsk r)).Nonempty ↔
    (canonicalRootFiber D label r).Nonempty := by
  rw [rootThreshold_interval_eq_fiber D label hsk r]

/-- Any nonempty canonical block produces a STRICT, CONNECTED ideal
increment in the correct decreasing-root order. -/
theorem canonicalRoot_active_connected_step
    (D : Diagram) (label : Cell → ℕ)
    (hsk : SkewRowIntervals D)
    (hinj : ∀ a : Cell, a ∈ D → ∀ b : Cell, b ∈ D →
      label a = label b → a = b)
    (r : ℕ) (hne : (canonicalRootFiber D label r).Nonempty) :
    IsConnectedBlockIncrement D
      (canonicalRootThresholdIdeal D label hsk (r + 1))
      (canonicalRootThresholdIdeal D label hsk r) := by
  classical
  let I := canonicalRootThresholdIdeal D label hsk (r + 1)
  let J := canonicalRootThresholdIdeal D label hsk r
  have hsubset : I.1 ⊆ J.1 :=
    canonicalRootUpperCut_antitone D label (Nat.le_succ r)
  have hneIJ : I.1 ≠ J.1 := by
    intro heq
    obtain ⟨c, hc⟩ := hne
    have hcD : c ∈ D := canonicalRootFiber_subset D label r hc
    let a : ShapeCell D := ⟨c, hcD⟩
    have hd : a ∈ J.1 \ I.1 :=
      (mem_rootThreshold_succ_difference D label r a).mpr hc
    obtain ⟨hJ, hI⟩ := Finset.mem_sdiff.mp hd
    exact hI (heq.symm ▸ hJ)
  have hss : I.1 ⊂ J.1 :=
    Finset.ssubset_iff_subset_ne.mpr ⟨hsubset, hneIJ⟩
  have hconn : ConnectedSkewRows (intervalCells D I J) := by
    rw [rootThreshold_interval_eq_fiber D label hsk r]
    exact canonicalRootFiber_connectedSkewRows D label hsk hinj r
  exact ⟨hss, hconn⟩

/-! ### §6.1 — The endpoints of the canonical finite root filtration. -/

/-- The threshold zero contains every cell, because every diagram cell
belongs to its unique canonical block. -/
theorem canonicalRootUpperCut_zero
    (D : Diagram) (label : Cell → ℕ) :
    canonicalRootUpperCut D label 0 = Finset.univ := by
  classical
  ext c
  rw [mem_canonicalRootUpperCut]
  simp only [Finset.mem_univ, iff_true]
  obtain ⟨r, hr⟩ := canonicalRootFiber_cover D label c.1 c.property
  exact ⟨r, hr, Nat.zero_le r⟩

/-- In a standard labeling by `Fin n`, every active block-root label is
smaller than n; the root really is the label of one of its cells. -/
theorem standard_active_root_lt_card
    (D : Diagram) (σ : StandardLabeling D) (r : ℕ)
    (hne : (canonicalRootFiber D (labelingOf D σ) r).Nonempty) :
    r < Fintype.card (ShapeCell D) := by
  obtain ⟨c, hcD, hr⟩ :=
    canonicalRootFiber_nonempty_origin D (labelingOf D σ) r hne
  have hlt : labelingOf D σ c < Fintype.card (ShapeCell D) := by
    classical
    simpa only [labelingOf, dite_eq_left hcD] using
      (σ ⟨c, hcD⟩).isLt
  omega

/-- There are no roots at or beyond the number of cells. Thus the
highest threshold is the EMPTY ideal. -/
theorem standard_rootUpperCut_card_empty
    (D : Diagram) (σ : StandardLabeling D) :
    canonicalRootUpperCut D (labelingOf D σ)
      (Fintype.card (ShapeCell D)) = ∅ := by
  classical
  ext c
  have hnot : c ∉ canonicalRootUpperCut D (labelingOf D σ)
      (Fintype.card (ShapeCell D)) := by
    intro hc
    obtain ⟨r, hr, hge⟩ :=
      (mem_canonicalRootUpperCut D (labelingOf D σ) _ c).mp hc
    have hne : (canonicalRootFiber D (labelingOf D σ) r).Nonempty :=
      ⟨c.1, hr⟩
    have hlt := standard_active_root_lt_card D σ r hne
    omega
  constructor
  · intro hc
    exact (hnot hc).elim
  · intro hc
    simp at hc

/-- The canonical filtration has n+1 positions (including both
endpoints), indexed by ALL potential root labels. Some consecutive
ideals coincide precisely at labels that do not start a new block. -/
noncomputable def canonicalRootWeakFiltration
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D) :
    Fin (Fintype.card (ShapeCell D) + 1) → ShapeIdeal D :=
  fun i => canonicalRootThresholdIdeal D (labelingOf D σ) hsk
    (Fintype.card (ShapeCell D) - i.val)

/-- The zero-th member of the weak filtration is the empty ideal. -/
theorem canonicalRootWeakFiltration_starts
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D) :
    canonicalRootWeakFiltration D hsk σ
      ⟨0, Nat.zero_lt_succ _⟩ =
      FinitePoset.bottomIdeal (α := ShapeCell D) := by
  apply Subtype.ext
  change canonicalRootUpperCut D (labelingOf D σ)
    (Fintype.card (ShapeCell D) - 0) = ∅
  simpa only [Nat.sub_zero] using standard_rootUpperCut_card_empty D σ

/-- The last member of the weak filtration is the full ideal. -/
theorem canonicalRootWeakFiltration_finishes
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D) :
    canonicalRootWeakFiltration D hsk σ
      ⟨Fintype.card (ShapeCell D), Nat.lt_succ_self _⟩ =
      FinitePoset.topIdeal (α := ShapeCell D) := by
  apply Subtype.ext
  change canonicalRootUpperCut D (labelingOf D σ)
    (Fintype.card (ShapeCell D) - Fintype.card (ShapeCell D)) = Finset.univ
  simpa only [Nat.sub_self] using
    canonicalRootUpperCut_zero D (labelingOf D σ)


/-! ### §6.1 — Every step of the weak filtration is one canonical block. -/

/-- The i-th increment in the n+1 member filtration is precisely the
canonical root fiber at label n-(i+1), regardless of whether it is empty. -/
theorem canonicalRootWeakFiltration_step_interval
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D)
    (i : Fin (Fintype.card (ShapeCell D))) :
    intervalCells D
      (canonicalRootWeakFiltration D hsk σ i.castSucc)
      (canonicalRootWeakFiltration D hsk σ i.succ) =
      canonicalRootFiber D (labelingOf D σ)
        (Fintype.card (ShapeCell D) - (i.val + 1)) := by
  have hshift :
      Fintype.card (ShapeCell D) - i.val =
      (Fintype.card (ShapeCell D) - (i.val + 1)) + 1 := by
    have hi := i.isLt
    omega
  change intervalCells D
    (canonicalRootThresholdIdeal D (labelingOf D σ) hsk
      (Fintype.card (ShapeCell D) - i.val))
    (canonicalRootThresholdIdeal D (labelingOf D σ) hsk
      (Fintype.card (ShapeCell D) - (i.val + 1))) = _
  rw [hshift]
  exact rootThreshold_interval_eq_fiber D (labelingOf D σ) hsk _

/-- The canonical filtration is monotonically increasing in the
poset-of-ideals order, even when the next root fiber is empty. -/
theorem canonicalRootWeakFiltration_step_subset
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D)
    (i : Fin (Fintype.card (ShapeCell D))) :
    (canonicalRootWeakFiltration D hsk σ i.castSucc).1 ⊆
      (canonicalRootWeakFiltration D hsk σ i.succ).1 := by
  change canonicalRootUpperCut D (labelingOf D σ)
    (Fintype.card (ShapeCell D) - i.val) ⊆
    canonicalRootUpperCut D (labelingOf D σ)
      (Fintype.card (ShapeCell D) - (i.val + 1))
  apply canonicalRootUpperCut_antitone
  omega

/-- The successive weak-chain ideals either coincide, or form an
actual STRICT CONNECTED increment. Thus no spurious nonempty steps
appear in the chain extracted from a standard labeling. -/
theorem canonicalRootWeakFiltration_step_eq_or_connected
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D)
    (i : Fin (Fintype.card (ShapeCell D))) :
    canonicalRootWeakFiltration D hsk σ i.castSucc =
        canonicalRootWeakFiltration D hsk σ i.succ ∨
      IsConnectedBlockIncrement D
        (canonicalRootWeakFiltration D hsk σ i.castSucc)
        (canonicalRootWeakFiltration D hsk σ i.succ) := by
  classical
  let r := Fintype.card (ShapeCell D) - (i.val + 1)
  by_cases hactive : (canonicalRootFiber D (labelingOf D σ) r).Nonempty
  · right
    have hs := canonicalRoot_active_connected_step D (labelingOf D σ)
      hsk (labelingOf_injectiveOn D σ) r hactive
    have hshift : Fintype.card (ShapeCell D) - i.val = r + 1 := by
      dsimp [r]
      have hi := i.isLt
      omega
    change IsConnectedBlockIncrement D
      (canonicalRootThresholdIdeal D (labelingOf D σ) hsk
        (Fintype.card (ShapeCell D) - i.val))
      (canonicalRootThresholdIdeal D (labelingOf D σ) hsk r)
    rw [hshift]
    exact hs
  · left
    apply Subtype.ext
    apply Finset.Subset.antisymm
    · exact canonicalRootWeakFiltration_step_subset D hsk σ i
    · intro c hcJ
      by_contra hcI
      have hcDiff : c.1 ∈ intervalCells D
          (canonicalRootWeakFiltration D hsk σ i.castSucc)
          (canonicalRootWeakFiltration D hsk σ i.succ) := by
        apply Finset.mem_image.mpr
        exact ⟨c, Finset.mem_sdiff.mpr ⟨hcJ, hcI⟩, rfl⟩
      rw [canonicalRootWeakFiltration_step_interval D hsk σ i] at hcDiff
      exact hactive ⟨c.1, hcDiff⟩

/-- In fact the i-th root is active precisely when this filtration step
is strict. This is the precise finite correspondence between canonical
blocks and nontrivial transitions in the (not-yet-compressed) chain. -/
theorem canonicalRootWeakFiltration_strict_iff_active
    (D : Diagram) (hsk : SkewRowIntervals D)
    (σ : StandardLabeling D)
    (i : Fin (Fintype.card (ShapeCell D))) :
    (canonicalRootWeakFiltration D hsk σ i.castSucc).1 ⊂
      (canonicalRootWeakFiltration D hsk σ i.succ).1 ↔
    (canonicalRootFiber D (labelingOf D σ)
      (Fintype.card (ShapeCell D) - (i.val + 1))).Nonempty := by
  constructor
  · intro hss
    have hne := strict_intervalCells_nonempty D _ _ hss
    rw [canonicalRootWeakFiltration_step_interval D hsk σ i] at hne
    exact hne
  · intro hne
    obtain hEq | hConnected :=
      canonicalRootWeakFiltration_step_eq_or_connected D hsk σ i
    · exfalso
      have hneInt : (intervalCells D
          (canonicalRootWeakFiltration D hsk σ i.castSucc)
          (canonicalRootWeakFiltration D hsk σ i.succ)).Nonempty := by
        rw [canonicalRootWeakFiltration_step_interval D hsk σ i]
        exact hne
      rw [hEq] at hneInt
      simp [intervalCells] at hneInt
    · exact hConnected.1


/-! ### §6.1 — Compatibility of strict chains with the block labels. -/

/-- A genuine strict connected-block chain is compatible with a given
standard labeling if its successive increments are precisely the canonical
fibers, listed with strictly DECREASING root labels, and every nonempty
fiber occurs exactly once. This definition does not make an arbitrary
chain valid merely by supplying root values: each geometric equality is
an independent, checkable condition. -/
def ConnectedChainCompatibleLabeling
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ) : Prop :=
  (∀ i : Fin k,
    intervalCells D (C.ideals i.castSucc) (C.ideals i.succ) =
      canonicalRootFiber D (labelingOf D σ) (roots i)) ∧
  (∀ i j : Fin k, i < j → roots j < roots i) ∧
  (∀ r : ℕ, r ∈ activeRootLabels D σ →
    ∃ i : Fin k, roots i = r)

/-- Every root value in a compatible strict chain is genuinely active.
This follows from the strictness of the ideal chain and the stated
fiber equality; no extra activity assumption was smuggled into the type. -/
theorem compatibleChain_root_active
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots)
    (i : Fin k) : roots i ∈ activeRootLabels D σ := by
  apply (mem_activeRootLabels_iff D σ (roots i)).mpr
  rw [← hcomp.1 i]
  exact connectedBlockChain_increment_nonempty C i

/-- In a compatible strict chain, the number of increments is EXACTLY
the corrected number of blocks. This rules out both omitted blocks and
duplicate blocks; it is an important converse constraint for . -/
theorem compatibleChain_length_eq_blockCount
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k)
    (σ : StandardLabeling D) (roots : Fin k → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots) :
    k = blockCount D σ := by
  classical
  let f : Fin k → {r : ℕ // r ∈ activeRootLabels D σ} :=
    fun i => ⟨roots i, compatibleChain_root_active C σ roots hcomp i⟩
  have hinj : Function.Injective f := by
    intro i j hij
    have heq : roots i = roots j := congrArg Subtype.val hij
    rcases lt_trichotomy i j with hlt | heqij | hgt
    · have hh := hcomp.2.1 i j hlt
      omega
    · exact heqij
    · have hh := hcomp.2.1 j i hgt
      omega
  have hsurj : Function.Surjective f := by
    intro r
    obtain ⟨i, hi⟩ := hcomp.2.2 r.1 r.property
    refine ⟨i, ?_⟩
    apply Subtype.ext
    exact hi
  have hcard : Fintype.card (Fin k) =
      Fintype.card {r : ℕ // r ∈ activeRootLabels D σ} :=
    Fintype.card_congr (Equiv.ofBijective f ⟨hinj, hsurj⟩)
  simpa only [Fintype.card_fin, Fintype.card_coe, blockCount] using hcard

/-! ### §6.1 — Enumeration of distinct canonical block roots. -/
end OrderedRootIntegral
end OrderIdealSpecializations

/-! ### §6.1 — Enumeration of distinct canonical block roots. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Enumeration of distinct canonical block roots. -/

/-- The `i`-th active block-root, sorted in STRICTLY DECREASING order.
The finite order isomorphism comes from mathlib's `Finset.orderIsoOfFin`;
`Fin.rev` converts its increasing enumeration into decreasing order. -/
noncomputable def activeRootsDescending (D : Diagram)
    (σ : StandardLabeling D) : Fin (blockCount D σ) → ℕ :=
  fun i => ((activeRootLabels D σ).orderIsoOfFin (by rfl) i.rev).1

/-- Every enumerated root is genuinely active. -/
theorem activeRootsDescending_mem (D : Diagram)
    (σ : StandardLabeling D) (i : Fin (blockCount D σ)) :
    activeRootsDescending D σ i ∈ activeRootLabels D σ := by
  exact ((activeRootLabels D σ).orderIsoOfFin (by rfl) i.rev).property

/-- The enumeration is strictly decreasing, in the actual natural-number
order of the labels (not merely injective). -/
theorem activeRootsDescending_strictAnti (D : Diagram)
    (σ : StandardLabeling D) :
    StrictAnti (activeRootsDescending D σ) := by
  intro i j hij
  have hrev : j.rev < i.rev := Fin.rev_strictAnti hij
  exact ((activeRootLabels D σ).orderIsoOfFin (by rfl)).strictMono hrev

/-- Every active root occurs. Thus `activeRootsDescending` is a finite
bijection onto the actual roots of the canonical decomposition. -/
theorem activeRootsDescending_surjective (D : Diagram)
    (σ : StandardLabeling D) (r : ℕ)
    (hr : r ∈ activeRootLabels D σ) :
    ∃ i : Fin (blockCount D σ), activeRootsDescending D σ i = r := by
  let e : Fin (blockCount D σ) ≃o
      {s : ℕ // s ∈ activeRootLabels D σ} :=
    (activeRootLabels D σ).orderIsoOfFin (by rfl)
  let i : Fin (blockCount D σ) := e.symm ⟨r, hr⟩
  refine ⟨i.rev, ?_⟩
  change (e (i.rev.rev)).1 = r
  rw [Fin.rev_involutive]
  exact congrArg Subtype.val (e.apply_symm_apply ⟨r, hr⟩)

/-! ### §6.1 — compressed ideals (no empty increments). -/

/-- Union of the FIRST `i` canonical root fibers in decreasing order,
expressed as cells of the existing finite cell poset. Unlike the older
weak filtration, every new index corresponds to an actual nonempty block. -/
noncomputable def canonicalCompressedCutCells (D : Diagram)
    (σ : StandardLabeling D)
    (i : Fin (blockCount D σ + 1)) : Finset (ShapeCell D) := by
  classical
  exact Finset.univ.filter (fun c : ShapeCell D =>
    ∃ j : Fin (blockCount D σ),
      j.val < i.val ∧
        c.1 ∈ canonicalRootFiber D (labelingOf D σ)
          (activeRootsDescending D σ j))

@[simp] theorem mem_canonicalCompressedCutCells (D : Diagram)
    (σ : StandardLabeling D)
    (i : Fin (blockCount D σ + 1)) (c : ShapeCell D) :
    c ∈ canonicalCompressedCutCells D σ i ↔
      ∃ j : Fin (blockCount D σ),
        j.val < i.val ∧
          c.1 ∈ canonicalRootFiber D (labelingOf D σ)
            (activeRootsDescending D σ j) := by
  classical
  change c ∈ (Finset.univ.filter (fun c : ShapeCell D =>
    ∃ j : Fin (blockCount D σ), j.val < i.val ∧
      c.1 ∈ canonicalRootFiber D (labelingOf D σ)
        (activeRootsDescending D σ j))) ↔ _
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

/-- Prefix unions are LOWER ideals: any cell below a chosen block has
an at least as large canonical root, hence comes from an earlier block
in the decreasing enumeration. -/
theorem canonicalCompressedCut_isIdeal (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ + 1)) :
    FinitePoset.IsIdeal (canonicalCompressedCutCells D σ i) := by
  intro a b hab hb
  obtain ⟨j, hj, hbRoot⟩ :=
    (mem_canonicalCompressedCutCells D σ i b).mp hb
  obtain ⟨ra, haRoot⟩ :=
    canonicalRootFiber_cover D (labelingOf D σ) a.1 a.property
  have hcoords : a.1.1 ≤ b.1.1 ∧ a.1.2 ≤ b.1.2 := hab
  have hge : activeRootsDescending D σ j ≤ ra :=
    canonicalRootFibers_ordered D (labelingOf D σ) hsk
      a.1 b.1 ra (activeRootsDescending D σ j)
      haRoot hbRoot hcoords.1 hcoords.2
  have hmem : ra ∈ activeRootLabels D σ :=
    (mem_activeRootLabels_iff D σ ra).mpr ⟨a.1, haRoot⟩
  obtain ⟨j', hj'⟩ := activeRootsDescending_surjective D σ ra hmem
  have hle : j'.val ≤ j.val := by
    by_contra hle
    have hlt : j < j' := by omega
    have hanti := activeRootsDescending_strictAnti D σ hlt
    omega
  exact (mem_canonicalCompressedCutCells D σ i a).mpr
    ⟨j', Nat.lt_of_le_of_lt hle hj, by simpa only [hj'] using haRoot⟩

/-- The i-th member of the compressed filtration, now a genuine ideal. -/
noncomputable def canonicalCompressedIdeal (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ + 1)) : ShapeIdeal D :=
  ⟨canonicalCompressedCutCells D σ i,
    canonicalCompressedCut_isIdeal D hsk σ i⟩

/-- The compressed filtration begins with the empty ideal. -/
theorem canonicalCompressedIdeal_starts (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D) :
    canonicalCompressedIdeal D hsk σ ⟨0, Nat.zero_lt_succ _⟩ =
      FinitePoset.bottomIdeal (α := ShapeCell D) := by
  apply Subtype.ext
  apply Finset.Subset.antisymm
  · intro c hc
    obtain ⟨j, hj, _⟩ :=
      (mem_canonicalCompressedCutCells D σ _ c).mp hc
    have : j.val < 0 := hj
    omega
  · intro c hc
    change c ∈ (∅ : Finset (ShapeCell D)) at hc
    simp at hc

/-- The compressed filtration ends with the full ideal, including the
empty-diagram case (`blockCount=0`). -/
theorem canonicalCompressedIdeal_finishes (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D) :
    canonicalCompressedIdeal D hsk σ
      ⟨blockCount D σ, Nat.lt_succ_self _⟩ =
      FinitePoset.topIdeal (α := ShapeCell D) := by
  apply Subtype.ext
  apply Finset.Subset.antisymm
  · intro c hc
    change c ∈ (Finset.univ : Finset (ShapeCell D))
    exact Finset.mem_univ c
  · intro c hc
    obtain ⟨r, hr⟩ :=
      canonicalRootFiber_cover D (labelingOf D σ) c.1 c.property
    have hra : r ∈ activeRootLabels D σ :=
      (mem_activeRootLabels_iff D σ r).mpr ⟨c.1, hr⟩
    obtain ⟨j, hj⟩ := activeRootsDescending_surjective D σ r hra
    exact (mem_canonicalCompressedCutCells D σ _ c).mpr
      ⟨j, by have := j.isLt; omega, by simpa only [hj] using hr⟩

/-- Compressed prefixes are increasing. -/
theorem canonicalCompressedIdeal_step_subset (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ)) :
    (canonicalCompressedIdeal D hsk σ i.castSucc).1 ⊆
      (canonicalCompressedIdeal D hsk σ i.succ).1 := by
  intro c hc
  obtain ⟨j, hj, hroot⟩ :=
    (mem_canonicalCompressedCutCells D σ i.castSucc c).mp hc
  exact (mem_canonicalCompressedCutCells D σ i.succ c).mpr
    ⟨j, by dsimp at hj ⊢; omega, hroot⟩

/-- The difference between successive compressed prefixes is EXACTLY
one canonical fiber, the i-th nonempty block in decreasing root order. -/
theorem mem_canonicalCompressedIdeal_step_difference (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ)) (c : ShapeCell D) :
    c ∈ (canonicalCompressedIdeal D hsk σ i.succ).1 \
          (canonicalCompressedIdeal D hsk σ i.castSucc).1 ↔
      c.1 ∈ canonicalRootFiber D (labelingOf D σ)
        (activeRootsDescending D σ i) := by
  classical
  constructor
  · intro hc
    obtain ⟨hcNext, hcPrev⟩ := Finset.mem_sdiff.mp hc
    obtain ⟨j, hj, hjFiber⟩ :=
      (mem_canonicalCompressedCutCells D σ i.succ c).mp hcNext
    have heq : j = i := by
      apply Fin.ext
      have hnot : ¬j.val < i.val := by
        intro hlt
        exact hcPrev ((mem_canonicalCompressedCutCells D σ i.castSucc c).mpr
          ⟨j, hlt, hjFiber⟩)
      have hi := i.isLt
      have hj' : j.val < i.val + 1 := hj
      omega
    simpa only [heq] using hjFiber
  · intro hc
    apply Finset.mem_sdiff.mpr
    constructor
    · exact (mem_canonicalCompressedCutCells D σ i.succ c).mpr
        ⟨i, by dsimp; omega, hc⟩
    · intro hcPrev
      obtain ⟨j, hj, hjFiber⟩ :=
        (mem_canonicalCompressedCutCells D σ i.castSucc c).mp hcPrev
      have hlt : j < i := by
        change j.val < i.val
        exact hj
      have hanti := activeRootsDescending_strictAnti D σ hlt
      have hrootEq := canonicalRootFiber_unique D (labelingOf D σ)
        c.1 (activeRootsDescending D σ j)
        (activeRootsDescending D σ i) hjFiber hc
      omega

/-- Precisely the geometric interval statement required by . -/
theorem canonicalCompressedIdeal_step_interval (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ)) :
    intervalCells D
      (canonicalCompressedIdeal D hsk σ i.castSucc)
      (canonicalCompressedIdeal D hsk σ i.succ) =
      canonicalRootFiber D (labelingOf D σ)
        (activeRootsDescending D σ i) := by
  classical
  ext c
  change c ∈ ((canonicalCompressedIdeal D hsk σ i.succ).1 \
    (canonicalCompressedIdeal D hsk σ i.castSucc).1).image
      (fun a : ShapeCell D => a.1) ↔ _
  constructor
  · intro hc
    obtain ⟨a, ha, heq⟩ := Finset.mem_image.mp hc
    have hr := (mem_canonicalCompressedIdeal_step_difference
      D hsk σ i a).mp ha
    simpa only [heq] using hr
  · intro hc
    have hcD : c ∈ D :=
      canonicalRootFiber_subset D (labelingOf D σ)
        (activeRootsDescending D σ i) hc
    let a : ShapeCell D := ⟨c, hcD⟩
    exact Finset.mem_image.mpr
      ⟨a, (mem_canonicalCompressedIdeal_step_difference
        D hsk σ i a).mpr hc, rfl⟩

/-- Each step is strictly increasing and connected: empty jumps have
been eliminated by construction, not by a postulated property. -/
theorem canonicalCompressedIdeal_step_connected (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (i : Fin (blockCount D σ)) :
    IsConnectedBlockIncrement D
      (canonicalCompressedIdeal D hsk σ i.castSucc)
      (canonicalCompressedIdeal D hsk σ i.succ) := by
  classical
  let I := canonicalCompressedIdeal D hsk σ i.castSucc
  let J := canonicalCompressedIdeal D hsk σ i.succ
  have hsubset : I.1 ⊆ J.1 := canonicalCompressedIdeal_step_subset D hsk σ i
  have hne : (canonicalRootFiber D (labelingOf D σ)
      (activeRootsDescending D σ i)).Nonempty :=
    (mem_activeRootLabels_iff D σ _).mp
      (activeRootsDescending_mem D σ i)
  have hinterval : intervalCells D I J =
      canonicalRootFiber D (labelingOf D σ)
        (activeRootsDescending D σ i) :=
    canonicalCompressedIdeal_step_interval D hsk σ i
  have hneq : I.1 ≠ J.1 := by
    intro heq
    have hIJ : I = J := Subtype.ext heq
    have hnon : (intervalCells D I J).Nonempty := by
      rw [hinterval]
      exact hne
    rw [hIJ] at hnon
    simp [intervalCells] at hnon
  have hss : I.1 ⊂ J.1 :=
    Finset.ssubset_iff_subset_ne.mpr ⟨hsubset, hneq⟩
  have hconn : ConnectedSkewRows (intervalCells D I J) := by
    rw [hinterval]
    exact canonicalRootFiber_connectedSkewRows D (labelingOf D σ)
      hsk (labelingOf_injectiveOn D σ)
      (activeRootsDescending D σ i)
  exact ⟨hss, hconn⟩

/-- The actual STRONG chain of exactly `blockCount` connected increments
attached canonically to any standard labeling. -/
noncomputable def canonicalCompressedChain (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D) :
    ConnectedBlockChain D (blockCount D σ) := by
  refine
    { ideals := fun i => canonicalCompressedIdeal D hsk σ i
      starts := ?_
      finishes := ?_
      steps := ?_ }
  · exact canonicalCompressedIdeal_starts D hsk σ
  · exact canonicalCompressedIdeal_finishes D hsk σ
  · intro i
    exact canonicalCompressedIdeal_step_connected D hsk σ i

/-- The canonical chain is compatible with ALL and ONLY the actual
root fibers, in the decreasing order dictated by the ideal convention. -/
theorem canonicalCompressedChain_compatible (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D) :
    ConnectedChainCompatibleLabeling
      (canonicalCompressedChain D hsk σ) σ
      (activeRootsDescending D σ) := by
  constructor
  · intro i
    exact canonicalCompressedIdeal_step_interval D hsk σ i
  constructor
  · intro i j hij
    exact activeRootsDescending_strictAnti D σ hij
  · intro r hr
    exact activeRootsDescending_surjective D σ r hr

/-! ### §6.1 — Converse: any compatible chain has these same roots/ideals. -/

/-- There is only one descending enumeration of the finite active-root
set. Thus the root function of ANY compatible strong chain is forced. -/
theorem compatibleChain_roots_unique (D : Diagram)
    (σ : StandardLabeling D)
    (C : ConnectedBlockChain D (blockCount D σ))
    (roots : Fin (blockCount D σ) → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots) :
    roots = activeRootsDescending D σ := by
  classical
  let f : Fin (blockCount D σ) → ℕ := fun i => roots i.rev
  have hfmem : ∀ i, f i ∈ activeRootLabels D σ := by
    intro i
    exact compatibleChain_root_active C σ roots hcomp i.rev
  have hfmono : StrictMono f := by
    intro i j hij
    exact hcomp.2.1 j.rev i.rev (Fin.rev_strictAnti hij)
  have hf : f = (activeRootLabels D σ).orderEmbOfFin (by rfl) :=
    Finset.orderEmbOfFin_unique (by rfl) hfmem hfmono
  let g : Fin (blockCount D σ) → ℕ :=
    fun i => activeRootsDescending D σ i.rev
  have hgmem : ∀ i, g i ∈ activeRootLabels D σ := by
    intro i
    exact activeRootsDescending_mem D σ i.rev
  have hgmono : StrictMono g := by
    intro i j hij
    exact activeRootsDescending_strictAnti D σ
      (Fin.rev_strictAnti hij)
  have hg : g = (activeRootLabels D σ).orderEmbOfFin (by rfl) :=
    Finset.orderEmbOfFin_unique (by rfl) hgmem hgmono
  have hfg : f = g := hf.trans hg.symm
  funext i
  have hi := congrFun hfg i.rev
  change roots i.rev.rev =
    activeRootsDescending D σ i.rev.rev at hi
  have hrev : i.rev.rev = i := Fin.rev_involutive i
  rw [hrev] at hi
  exact hi

/-- Two nested ideals with the same left endpoint and the same skew
interval have the same right endpoint. This is elementary set algebra,
but it avoids assuming that the chain is the canonical one. -/
private theorem idealRight_eq_of_same_increment (D : Diagram)
    (I J K : ShapeIdeal D)
    (hIJ : I.1 ⊆ J.1) (hIK : I.1 ⊆ K.1)
    (hinterval : intervalCells D I J = intervalCells D I K) :
    J = K := by
  classical
  apply Subtype.ext
  apply Finset.Subset.antisymm
  · intro c hcJ
    by_cases hcI : c ∈ I.1
    · exact hIK hcI
    · have hm : c.1 ∈ intervalCells D I J :=
        Finset.mem_image.mpr
          ⟨c, Finset.mem_sdiff.mpr ⟨hcJ, hcI⟩, rfl⟩
      rw [hinterval] at hm
      obtain ⟨d, hd, hdval⟩ := Finset.mem_image.mp hm
      have hdc : d = c := Subtype.ext hdval
      subst d
      exact (Finset.mem_sdiff.mp hd).1
  · intro c hcK
    by_cases hcI : c ∈ I.1
    · exact hIJ hcI
    · have hm : c.1 ∈ intervalCells D I K :=
        Finset.mem_image.mpr
          ⟨c, Finset.mem_sdiff.mpr ⟨hcK, hcI⟩, rfl⟩
      rw [← hinterval] at hm
      obtain ⟨d, hd, hdval⟩ := Finset.mem_image.mp hm
      have hdc : d = c := Subtype.ext hdval
      subst d
      exact (Finset.mem_sdiff.mp hd).1

/-- The ideals of ANY compatible chain coincide pointwise with the
compressed canonical ideals. Proof by induction on the finite step
index, using equality of their actual increments and common start. -/
theorem compatibleChain_ideals_unique (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (C : ConnectedBlockChain D (blockCount D σ))
    (roots : Fin (blockCount D σ) → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots) :
    ∀ i : Fin (blockCount D σ + 1),
      C.ideals i = (canonicalCompressedChain D hsk σ).ideals i := by
  classical
  let C₀ := canonicalCompressedChain D hsk σ
  have hroots := compatibleChain_roots_unique D σ C roots hcomp
  have hstep (i : Fin (blockCount D σ)) :
      intervalCells D (C.ideals i.castSucc) (C.ideals i.succ) =
      intervalCells D (C₀.ideals i.castSucc) (C₀.ideals i.succ) := by
    calc
      intervalCells D (C.ideals i.castSucc) (C.ideals i.succ) =
          canonicalRootFiber D (labelingOf D σ) (roots i) := hcomp.1 i
      _ = canonicalRootFiber D (labelingOf D σ)
            (activeRootsDescending D σ i) := by rw [hroots]
      _ = intervalCells D (C₀.ideals i.castSucc)
            (C₀.ideals i.succ) :=
          ((canonicalCompressedChain_compatible D hsk σ).1 i).symm
  have hind : ∀ (m : ℕ) (hm : m ≤ blockCount D σ),
      C.ideals ⟨m, Nat.lt_succ_of_le hm⟩ =
        C₀.ideals ⟨m, Nat.lt_succ_of_le hm⟩ := by
    intro m
    induction m with
    | zero =>
        intro hm
        exact C.starts.trans C₀.starts.symm
    | succ m ih =>
        intro hm
        have hm' : m < blockCount D σ := by omega
        let i : Fin (blockCount D σ) := ⟨m, hm'⟩
        have hI : C.ideals i.castSucc = C₀.ideals i.castSucc :=
          ih (by omega)
        have hCsubset : (C₀.ideals i.castSucc).1 ⊆
            (C.ideals i.succ).1 := by
          rw [← hI]
          exact (C.steps i).1.subset
        have hZsubset : (C₀.ideals i.castSucc).1 ⊆
            (C₀.ideals i.succ).1 := (C₀.steps i).1.subset
        have hEqInterval :
            intervalCells D (C₀.ideals i.castSucc) (C.ideals i.succ) =
            intervalCells D (C₀.ideals i.castSucc) (C₀.ideals i.succ) := by
          calc
            intervalCells D (C₀.ideals i.castSucc) (C.ideals i.succ) =
                intervalCells D (C.ideals i.castSucc) (C.ideals i.succ) := by
                  rw [hI]
            _ = intervalCells D (C₀.ideals i.castSucc)
                  (C₀.ideals i.succ) := hstep i
        have hJ := idealRight_eq_of_same_increment D
          (C₀.ideals i.castSucc) (C.ideals i.succ) (C₀.ideals i.succ)
          hCsubset hZsubset hEqInterval
        exact hJ
  intro i
  exact hind i.val (Nat.le_of_lt_succ i.isLt)

/-- Extensionality for actual connected-block chains: the endpoint and
increment fields are proofs, so equality of the ideal functions suffices. -/
theorem ConnectedBlockChain.ext {D : Diagram} {k : ℕ}
    {C C' : ConnectedBlockChain D k}
    (h : ∀ i : Fin (k + 1), C.ideals i = C'.ideals i) :
    C = C' := by
  cases C with
  | mk ideals starts finishes steps =>
    cases C' with
    | mk ideals' starts' finishes' steps' =>
      have hh : ideals = ideals' := funext h
      cases hh
      rfl

/-- FULL uniqueness: the strong connected-block chain and its
ordered roots are not additional choices once the labeling is fixed. -/
theorem compatibleChain_data_unique (D : Diagram)
    (hsk : SkewRowIntervals D) (σ : StandardLabeling D)
    (C : ConnectedBlockChain D (blockCount D σ))
    (roots : Fin (blockCount D σ) → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots) :
    C = canonicalCompressedChain D hsk σ ∧
      roots = activeRootsDescending D σ := by
  constructor
  · apply ConnectedBlockChain.ext
    exact compatibleChain_ideals_unique D hsk σ C roots hcomp
  · exact compatibleChain_roots_unique D σ C roots hcomp

/-- Genuine combinatorial-data equivalence: every standard bijective
labeling has exactly one compatible strictly connected ideal chain
(together with its descending roots). The inverse forgets this UNIQUE
certified data; no integral/volume assertion is used here. -/
noncomputable def standardLabelings_equiv_compatibleChains (D : Diagram)
    (hsk : SkewRowIntervals D) :
    StandardLabeling D ≃
      (Σ σ : StandardLabeling D,
        {p : ConnectedBlockChain D (blockCount D σ) ×
            (Fin (blockCount D σ) → ℕ) //
          ConnectedChainCompatibleLabeling p.1 σ p.2}) := by
  classical
  refine
    { toFun := fun σ =>
        ⟨σ, ⟨(canonicalCompressedChain D hsk σ,
          activeRootsDescending D σ),
          canonicalCompressedChain_compatible D hsk σ⟩⟩
      invFun := fun s => s.1
      left_inv := by intro σ; rfl
      right_inv := ?_ }
  rintro ⟨σ, ⟨⟨C, roots⟩, hcomp⟩⟩
  obtain ⟨hC, hroots⟩ :=
    compatibleChain_data_unique D hsk σ C roots hcomp
  cases hC
  cases hroots
  rfl

