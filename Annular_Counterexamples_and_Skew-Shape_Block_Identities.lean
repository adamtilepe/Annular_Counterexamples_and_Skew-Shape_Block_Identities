/-! ### §5.3 — Counting surviving columns as independent one-column factors. -/

/-- The occupied columns which can never disappear under a head
selection. Their number is the fixed monomial exponent in the general
bivariate factorization. -/
noncomputable def nonremovableColumns (B : Diagram)
    (lo : ℕ → ℕ) : Finset ℕ := by
  classical
  exact (occupiedColumnsRaw B).filter
    (fun j => ¬ RemovableHeadColumn B lo j)

/-- An indicator product is a power whose exponent is the number of
positions where the predicate holds. -/
theorem indicator_product_is_power (s : Finset ℕ)
    (p : ℕ → Prop) [DecidablePred p] (y : ℚ) :
    (∏ j ∈ s, if p j then y else 1) =
      y ^ (s.filter p).card := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      by_cases hpa : p a
      · have hf : (insert a s).filter p = insert a (s.filter p) := by
          simp [Finset.filter_insert, hpa]
        have ha' : a ∉ s.filter p := by
          intro h
          exact ha ((Finset.mem_filter.mp h).1)
        rw [Finset.prod_insert ha, hf, Finset.card_insert_of_notMem ha']
        simp only [ite_eq_left hpa, ih, pow_succ]
        ring
      · have hf : (insert a s).filter p = s.filter p := by
          simp [Finset.filter_insert, hpa]
        rw [Finset.prod_insert ha, hf]
        simp only [ite_eq_right hpa, one_mul]
        exact ih

/-- Split a finite product into the indices satisfying a property and
its complement. This avoids any assumptions about the ambient type. -/
theorem product_filter_partition (s : Finset ℕ)
    (p : ℕ → Prop) [DecidablePred p] (f : ℕ → ℚ) :
    (∏ j ∈ s, f j) =
      (∏ j ∈ s.filter p, f j) *
        (∏ j ∈ s.filter (fun j => ¬ p j), f j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      have haP : a ∉ s.filter p := by
        intro h
        exact ha ((Finset.mem_filter.mp h).1)
      have haN : a ∉ s.filter (fun j => ¬ p j) := by
        intro h
        exact ha ((Finset.mem_filter.mp h).1)
      by_cases hpa : p a
      · have hfP : (insert a s).filter p = insert a (s.filter p) := by
          simp [Finset.filter_insert, hpa]
        have hfN : (insert a s).filter (fun j => ¬ p j) =
            s.filter (fun j => ¬ p j) := by
          simp [Finset.filter_insert, hpa]
        rw [Finset.prod_insert ha, hfP, hfN, Finset.prod_insert haP, ih]
        ring
      · have hfP : (insert a s).filter p = s.filter p := by
          simp [Finset.filter_insert, hpa]
        have hfN : (insert a s).filter (fun j => ¬ p j) =
            insert a (s.filter (fun j => ¬ p j)) := by
          simp [Finset.filter_insert, hpa]
        rw [Finset.prod_insert ha, hfP, hfN, Finset.prod_insert haN, ih]
        ring

/-- Filtering out terms from a product is equivalent to replacing
those terms by the multiplicative unit. -/
theorem product_filter_as_indicator (s : Finset ℕ)
    (p : ℕ → Prop) [DecidablePred p] (f : ℕ → ℚ) :
    (∏ j ∈ s.filter p, f j) =
      ∏ j ∈ s, if p j then f j else 1 := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      by_cases hpa : p a
      · have hf : (insert a s).filter p = insert a (s.filter p) := by
          simp [Finset.filter_insert, hpa]
        have haP : a ∉ s.filter p := by
          intro h
          exact ha ((Finset.mem_filter.mp h).1)
        rw [hf, Finset.prod_insert haP, Finset.prod_insert ha, ih]
        simp [hpa]
      · have hf : (insert a s).filter p = s.filter p := by
          simp [Finset.filter_insert, hpa]
        rw [hf, Finset.prod_insert ha]
        simpa [hpa] using ih

/-- Every occupied head column really contains an occupied cell. -/
theorem headColumn_occupied (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (g : HeadColumn B lo) :
    g.1 ∈ occupiedColumnsRaw B := by
  obtain ⟨r, hr⟩ := headColumn_rowGroup_nonempty B lo g
  have hcell := headCell_of_leftBoundaryRowGroup B
    n lo hi hmem g.1 r hr
  exact Finset.mem_image.mpr ⟨(r, g.1), hcell, rfl⟩

/-- An occupied column is removable precisely when its index is one
of the head-column indices and it is removable there. -/
theorem removable_columns_filter_eq (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    [DecidablePred (RemovableHeadColumn B lo)] :
    (occupiedColumnsRaw B).filter
        (RemovableHeadColumn B lo) =
      (headColumnIndices B lo).filter
        (RemovableHeadColumn B lo) := by
  classical
  ext j
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨hj, hrem⟩
    exact ⟨removable_occupied_is_headColumn B lo j hj hrem, hrem⟩
  · rintro ⟨hj, hrem⟩
    have hocc : j ∈ occupiedColumnsRaw B := by
      simpa only [Subtype.coe_mk] using
        (headColumn_occupied B n lo hi hmem
          (⟨j, hj⟩ : HeadColumn B lo))
    exact ⟨hocc, hrem⟩

/-- Every unremovable occupied column survives every admissible head
selection, whatever other columns the selection deletes. -/
theorem nonremovable_column_survives (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) (j : ℕ)
    (hj : j ∈ nonremovableColumns B lo) :
    j ∈ occupiedColumnsRaw (B \ headTuplesCells B lo P) := by
  classical
  have hnot : ¬ RemovableHeadColumn B lo j :=
    (Finset.mem_filter.mp hj).2
  by_contra hvan
  exact hnot (vanished_column_is_head B _ lo
    (headTuplesCells_isHeadPrefixSelection B
      n lo hi hmem hlo P) j hvan)

end TableauTransfer
