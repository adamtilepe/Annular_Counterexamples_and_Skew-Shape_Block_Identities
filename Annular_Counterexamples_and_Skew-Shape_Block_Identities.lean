/-! ### §5.3 — The finite distributive law for independent row prefixes. -/

/-- A finite family of independent prefix choices is summed by
multiplying the separate finite sums.  The proof invokes the actual
finite-Pi distributive law, with no assumed factorization of an ideal
lattice or of a tableau enumerator. -/
theorem finitePi_weight_sum_product
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → Type*} [∀ i, Fintype (β i)]
    (w : ∀ i : ι, β i → ℚ) :
    (∑ P : ∀ i : ι, β i, ∏ i : ι, w i (P i)) =
      ∏ i : ι, ∑ p : β i, w i p := by
  classical
  have h := Finset.prod_univ_sum
    (fun i : ι => (Finset.univ : Finset (β i))) w
  simpa only [Fintype.piFinset_univ] using h.symm

/-- The row group corresponding to a head column is nonempty. -/
theorem headColumn_rowGroup_nonempty (B : Diagram)
    (lo : ℕ → ℕ) (g : HeadColumn B lo) :
    (leftBoundaryRowGroup B lo g.1).Nonempty := by
  classical
  have hG : g.1 ∈ (occupiedRows B).image lo := g.2
  obtain ⟨r, hr, hcol⟩ := Finset.mem_image.mp hG
  exact ⟨r, (mem_leftBoundaryRowGroup B lo g.1 r).mpr
    ⟨hr, hcol⟩⟩

/-- The exact finite product identity with one distinguished factor.
The other factors remain independent even when they are dependent
finite types indexed by occupied head columns. -/
theorem finitePi_weighted_distinguished
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {β : ι → Type*} [∀ i, Fintype (β i)]
    (w : ∀ i : ι, β i → ℚ) (j : ι)
    (special : ∀ i : ι, β i → ℚ)
    (hone : ∀ i : ι, i ≠ j → ∀ p : β i, special i p = 1) :
    (∑ P : ∀ i : ι, β i,
      (∏ i : ι, w i (P i)) * special j (P j)) =
      (∑ p : β j, w j p * special j p) *
        (∏ i ∈ (Finset.univ : Finset ι).erase j,
           ∑ p : β i, w i p) := by
  classical
  let v : ∀ i : ι, β i → ℚ := fun i p =>
    w i p * special i p
  have hAt (P : ∀ i : ι, β i) :
      (∏ i : ι, v i (P i)) =
      (∏ i : ι, w i (P i)) * special j (P j) := by
    calc
      _ = (∏ i : ι, w i (P i)) *
          (∏ i : ι, special i (P i)) := by
          simp [v, Finset.prod_mul_distrib]
      _ = (∏ i : ι, w i (P i)) * special j (P j) := by
          congr 1
          apply Finset.prod_eq_single j
          · intro i _ hi
            exact hone i hi (P i)
          · intro hj
            exact False.elim (hj (Finset.mem_univ j))
  have hSum := finitePi_weight_sum_product v
  calc
    (∑ P : ∀ i : ι, β i,
      (∏ i : ι, w i (P i)) * special j (P j)) =
        ∑ P : ∀ i : ι, β i, ∏ i : ι, v i (P i) := by
          apply Finset.sum_congr rfl
          intro P _
          exact (hAt P).symm
    _ = ∏ i : ι, ∑ p : β i, v i p := hSum
    _ = (∑ p : β j, w j p * special j p) *
        (∏ i ∈ (Finset.univ : Finset ι).erase j,
          ∑ p : β i, w i p) := by
          have hprod := Finset.prod_erase_mul
            (Finset.univ : Finset ι)
            (fun i : ι => ∑ p : β i, v i p)
            (Finset.mem_univ j)
          rw [← hprod]
          have hother :
              (∏ i ∈ (Finset.univ : Finset ι).erase j,
                ∑ p : β i, v i p) =
              (∏ i ∈ (Finset.univ : Finset ι).erase j,
                ∑ p : β i, w i p) := by
            apply Finset.prod_congr rfl
            intro i hi
            have hine : i ≠ j := (Finset.mem_erase.mp hi).1
            apply Finset.sum_congr rfl
            intro p _
            simp [v, hone i hine p]
          rw [hother]
          simp only [v]
          ring

/-- For any finite tuple of head-prefix choices, summing its true
inverse coefficient against the weight of a *single full* group is a
closed expression.  This uses the actual finite types, not a formal
product assumed without a bijection. -/
theorem headTuples_weighted_special_sum (B : Diagram)
    (lo : ℕ → ℕ) (x y : ℚ)
    (g₀ : HeadColumn B lo) :
    (∑ P : HeadPrefixTuples B lo,
       (∏ g : HeadColumn B lo,
          oneColumnInverseCoefficient x (P g).1.card) *
       (if (P g₀).1 = leftBoundaryRowGroup B lo g₀.1
        then 1 else y)) =
      ((y - x) * (1 - x) ^
        ((leftBoundaryRowGroup B lo g₀.1).card - 1)) *
        (1 - x) ^
          (∑ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
            (leftBoundaryRowGroup B lo g.1).card) := by
  classical
  let w : ∀ g : HeadColumn B lo,
      FiniteRowPrefix (leftBoundaryRowGroup B lo g.1) → ℚ :=
    fun g p => oneColumnInverseCoefficient x p.1.card
  let z : ∀ g : HeadColumn B lo,
      FiniteRowPrefix (leftBoundaryRowGroup B lo g.1) → ℚ :=
    fun g p => if g = g₀ then
      (if p.1 = leftBoundaryRowGroup B lo g.1 then 1 else y)
    else 1
  have hz (g : HeadColumn B lo) (hg : g ≠ g₀)
      (p : FiniteRowPrefix (leftBoundaryRowGroup B lo g.1)) :
      z g p = 1 := by
    simp [z, hg]
  have hsum := finitePi_weighted_distinguished w g₀ z hz
  have hspecial :
      (∑ p : FiniteRowPrefix (leftBoundaryRowGroup B lo g₀.1),
        w g₀ p * z g₀ p) =
        (y - x) * (1 - x) ^
          ((leftBoundaryRowGroup B lo g₀.1).card - 1) := by
    simpa only [w, z, ite_true] using
      (finiteRowPrefix_removable_sum x y
        (leftBoundaryRowGroup B lo g₀.1)
        (headColumn_rowGroup_nonempty B lo g₀))
  have hother :
      (∏ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
        ∑ p : FiniteRowPrefix (leftBoundaryRowGroup B lo g.1),
          w g p) =
      (1 - x) ^
        (∑ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
           (leftBoundaryRowGroup B lo g.1).card) := by
    simp_rw [show ∀ g : HeadColumn B lo,
      (∑ p : FiniteRowPrefix (leftBoundaryRowGroup B lo g.1),
        w g p) =
          (1 - x) ^ (leftBoundaryRowGroup B lo g.1).card from
      fun g => finiteRowPrefix_weight_sum_subtype x _]
    exact Finset.prod_pow_eq_pow_sum _
      (fun g : HeadColumn B lo =>
        (leftBoundaryRowGroup B lo g.1).card) (1 - x)
  have htarget :
      (∑ P : HeadPrefixTuples B lo,
        (∏ g : HeadColumn B lo, w g (P g)) * z g₀ (P g₀)) =
      ((y - x) * (1 - x) ^
        ((leftBoundaryRowGroup B lo g₀.1).card - 1)) *
        (1 - x) ^
          (∑ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
             (leftBoundaryRowGroup B lo g.1).card) := by
    rw [hsum, hspecial, hother]
  simpa only [w, z, ite_true] using htarget

end TableauTransfer
