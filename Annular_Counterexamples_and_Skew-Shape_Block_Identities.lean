/-! ### §5.3 — A certified normal form for one consecutive row group

A prefix-closed subset of `range r` is *uniquely* `range k` for some
`0 ≤ k ≤ r`. This elementary but indispensable result is what lets a
row-group sum become the telescoping series already proved above. -/

/-- An initial segment of `range r` in the usual order on natural
numbers. The set itself remains a genuinely finite object. -/
def IsPrefixOfRange (r : ℕ) (S : Finset ℕ) : Prop :=
  S ⊆ Finset.range r ∧
  ∀ i j : ℕ, i ∈ Finset.range r → j ∈ S → i ≤ j → i ∈ S

/-- Any prefix of a finite consecutive row group is determined by its
cardinality: its chosen indices are exactly `0, ..., |S|-1`. -/
theorem prefixOfRange_eq_range_card (r : ℕ) (S : Finset ℕ)
    (h : IsPrefixOfRange r S) :
    S = Finset.range S.card := by
  classical
  have hcardBound : S.card ≤ r := by
    calc
      S.card ≤ (Finset.range r).card := Finset.card_le_card h.1
      _ = r := Finset.card_range r
  have hle : ∀ j ∈ S, j < S.card := by
    intro j hj
    have hjr : j < r := Finset.mem_range.mp (h.1 hj)
    have hsub : Finset.range (j + 1) ⊆ S := by
      intro i hi
      have hij : i ≤ j := by
        have := Finset.mem_range.mp hi
        omega
      have hir : i ∈ Finset.range r := Finset.mem_range.mpr (by omega)
      exact h.2 i j hir hj hij
    have hc := Finset.card_le_card hsub
    simp only [Finset.card_range] at hc
    omega
  ext j
  constructor
  · intro hj
    exact Finset.mem_range.mpr (hle j hj)
  · intro hj
    have hjk : j < S.card := Finset.mem_range.mp hj
    by_contra hn
    have hsub : S ⊆ Finset.range j := by
      intro i hi
      apply Finset.mem_range.mpr
      by_contra hnot
      have hir : j ∈ Finset.range r :=
        Finset.mem_range.mpr (by omega)
      have hji : j ≤ i := by omega
      exact hn (h.2 j i hir hi hji)
    have hc := Finset.card_le_card hsub
    simp only [Finset.card_range] at hc
    omega

/-- Conversely each `range k`, for `k ≤ r`, is prefix-closed in
`range r`. -/
theorem range_isPrefixOfRange (r k : ℕ) (hk : k ≤ r) :
    IsPrefixOfRange r (Finset.range k) := by
  constructor
  · intro i hi
    exact Finset.mem_range.mpr
      (lt_of_lt_of_le (Finset.mem_range.mp hi) hk)
  · intro i j hir hj hij
    exact Finset.mem_range.mpr
      (lt_of_le_of_lt hij (Finset.mem_range.mp hj))

/-- The exact classification of legal prefixes for a single group.
In the later product sum, their sizes will run from `0` through `r`. -/
theorem prefixOfRange_iff_exists_length (r : ℕ) (S : Finset ℕ) :
    IsPrefixOfRange r S ↔
      ∃ k : ℕ, k ≤ r ∧ S = Finset.range k := by
  constructor
  · intro h
    have hle : S.card ≤ r := by
      calc
        S.card ≤ (Finset.range r).card := Finset.card_le_card h.1
        _ = r := Finset.card_range r
    exact ⟨S.card, hle, prefixOfRange_eq_range_card r S h⟩
  · rintro ⟨k, hk, rfl⟩
    exact range_isPrefixOfRange r k hk

/-- The one-column coefficient of a prefix depends only on its
length; after `r` selected consecutive rows it is `-x (1-x)^(r-1)`.
This theorem is a direct bridge to the previous scalar telescoping. -/
theorem rowGroupPrefix_weight (x : ℚ) (r k : ℕ)
    (_hk : k ≤ r) :
    oneColumnInverseCoefficient x (Finset.range k).card =
      oneColumnInverseCoefficient x k := by
  simp

end TableauTransfer
end OrderIdealSpecializations

