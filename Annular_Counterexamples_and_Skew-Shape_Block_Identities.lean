/-! ### §5.3 — Cartesian decomposition of prefix selections. -/

/-- The occupied *left-boundary* columns, not all occupied columns. -/
noncomputable def headColumnIndices (B : Diagram)
    (lo : ℕ → ℕ) : Finset ℕ := by
  classical
  exact (occupiedRows B).image lo

abbrev HeadColumn (B : Diagram) (lo : ℕ → ℕ) :=
  {j : ℕ // j ∈ headColumnIndices B lo}

noncomputable instance headColumnFintype (B : Diagram)
    (lo : ℕ → ℕ) : Fintype (HeadColumn B lo) := by
  classical
  exact Finset.fintypeCoeSort (headColumnIndices B lo)

/-- Product of one finite prefix choice per occupied left-boundary
column. All row groups are the actual groups from the skew diagram. -/
abbrev HeadPrefixTuples (B : Diagram) (lo : ℕ → ℕ) :=
  ∀ j : HeadColumn B lo,
    FiniteRowPrefix (leftBoundaryRowGroup B lo j.1)

/-- A prefix selection stated in terms of its own interval diagram,
independent of an ambient ideal. -/
def IsHeadPrefixSelection (B : Diagram) (lo : ℕ → ℕ)
    (S : Diagram) : Prop :=
  S ⊆ B ∧
  (∀ r j : ℕ, (r, j) ∈ S → j = lo r) ∧
  (∀ r s j : ℕ, r ≤ s →
    (r, j) ∈ B → (s, j) ∈ S → (r, j) ∈ S)

/-- Finite type of admissible head selections, with the real diagram
B in the first condition. -/
noncomputable def headPrefixSelections (B : Diagram)
    (lo : ℕ → ℕ) : Finset Diagram := by
  classical
  exact B.powerset.filter (IsHeadPrefixSelection B lo)

@[simp] theorem mem_headPrefixSelections (B : Diagram)
    (lo : ℕ → ℕ) (S : Diagram) :
    S ∈ headPrefixSelections B lo ↔
      IsHeadPrefixSelection B lo S := by
  classical
  simp [headPrefixSelections, IsHeadPrefixSelection]

abbrev HeadPrefixSelection (B : Diagram) (lo : ℕ → ℕ) :=
  {S : Diagram // S ∈ headPrefixSelections B lo}

noncomputable instance headPrefixSelectionFintype (B : Diagram)
    (lo : ℕ → ℕ) : Fintype (HeadPrefixSelection B lo) := by
  classical
  exact Finset.fintypeCoeSort (headPrefixSelections B lo)

/-- Every occupied row has its leftmost cell, and that cell belongs
to the column group determined by its row endpoint. -/
theorem headCell_of_leftBoundaryRowGroup (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (j r : ℕ) (hr : r ∈ leftBoundaryRowGroup B lo j) :
    (r, j) ∈ B := by
  obtain ⟨hOcc, hEq⟩ :=
    (mem_leftBoundaryRowGroup B lo j r).mp hr
  obtain ⟨c, hc, hrow⟩ := Finset.mem_image.mp hOcc
  have hdata := (hmem c.1 c.2).mp hc
  have hdataR : r < n ∧ lo r ≤ c.2 ∧ c.2 < hi r := by
    simpa only [hrow] using hdata
  rcases hdataR with ⟨hrn, hle, hhi⟩
  apply (hmem r j).mpr
  exact ⟨hrn, by omega, by omega⟩

/-- Conversely every occupied left-boundary cell comes from its
(unique) row group. -/
theorem mem_leftBoundaryRowGroup_of_headCell (B : Diagram)
    (lo : ℕ → ℕ) (r j : ℕ)
    (hB : (r, j) ∈ B) (hj : j = lo r) :
    r ∈ leftBoundaryRowGroup B lo j := by
  apply (mem_leftBoundaryRowGroup B lo j r).mpr
  exact ⟨Finset.mem_image.mpr ⟨(r, j), hB, rfl⟩, hj.symm⟩

/-- A true head selection gives a prefix in each row group. -/
noncomputable def headSelectionToTuples (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (S : HeadPrefixSelection B lo) : HeadPrefixTuples B lo := by
  classical
  intro j
  let R := leftBoundaryRowGroup B lo j.1
  let P := R.filter (fun r => (r, j.1) ∈ S.1)
  refine ⟨P, (mem_finiteRowPrefixes R P).mpr ?_⟩
  have hS : IsHeadPrefixSelection B lo S.1 :=
    (mem_headPrefixSelections B lo S.1).mp S.2
  constructor
  · intro r hr
    exact (Finset.mem_filter.mp hr).1
  · intro r hr s hs hrs
    obtain ⟨hsR, hsSel⟩ := Finset.mem_filter.mp hs
    have hrB := headCell_of_leftBoundaryRowGroup B
      n lo hi hmem j.1 r hr
    have hrSel := hS.2.2 r s j.1 hrs hrB hsSel
    exact Finset.mem_filter.mpr ⟨hr, hrSel⟩

/-- Build a cell selection from one group prefix for each head column. -/
noncomputable def headTuplesCells (B : Diagram) (lo : ℕ → ℕ)
    (P : HeadPrefixTuples B lo) : Diagram := by
  classical
  exact (Finset.univ : Finset (HeadColumn B lo)).biUnion
    (fun j => (P j).1.image (fun r => (r, j.1)))

/-- Explicit membership in the selection assembled from column groups. -/
theorem mem_headTuplesCells (B : Diagram) (lo : ℕ → ℕ)
    (P : HeadPrefixTuples B lo) (r j : ℕ) :
    (r, j) ∈ headTuplesCells B lo P ↔
      ∃ g : HeadColumn B lo, g.1 = j ∧ r ∈ (P g).1 := by
  classical
  simp only [headTuplesCells, Finset.mem_biUnion, Finset.mem_univ,
    true_and, Finset.mem_image]
  constructor
  · rintro ⟨g, s, hs, heq⟩
    have hrow : s = r := congrArg Prod.fst heq
    have hcol : g.1 = j := congrArg Prod.snd heq
    exact ⟨g, hcol, by simpa only [hrow] using hs⟩
  · rintro ⟨g, hcol, hr⟩
    refine ⟨g, r, hr, ?_⟩
    exact Prod.ext rfl hcol

/-- The tuple-built selection consists of leftmost cells of the real
skew diagram and is closed under taking upper row prefixes. -/
theorem headTuplesCells_isHeadPrefixSelection (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) :
    IsHeadPrefixSelection B lo (headTuplesCells B lo P) := by
  classical
  constructor
  · intro c hc
    have h := (mem_headTuplesCells B lo P c.1 c.2).mp hc
    obtain ⟨g, hgcol, hgr⟩ := h
    have hgRows := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
    have hrgroup : c.1 ∈ leftBoundaryRowGroup B lo g.1 :=
      hgRows.1 hgr
    have hc := headCell_of_leftBoundaryRowGroup B
      n lo hi hmem g.1 c.1 hrgroup
    simpa only [hgcol] using hc
  constructor
  · intro r j hc
    obtain ⟨g, hgcol, hgr⟩ :=
      (mem_headTuplesCells B lo P r j).mp hc
    have hgRows := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
    have hrgroup := hgRows.1 hgr
    have heq := (mem_leftBoundaryRowGroup B lo g.1 r).mp hrgroup
    exact hgcol.symm.trans heq.2.symm
  · intro r s j hrs hrB hsSelected
    obtain ⟨g, hgcol, hsChoice⟩ :=
      (mem_headTuplesCells B lo P s j).mp hsSelected
    have hP := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
    have hsGroup : s ∈ leftBoundaryRowGroup B lo g.1 :=
      hP.1 hsChoice
    have hloS : lo s = j := by
      have hh := (mem_leftBoundaryRowGroup B lo g.1 s).mp hsGroup
      omega
    have hrData := (hmem r j).mp hrB
    have hsCell : (s, j) ∈ B := by
      have h := headCell_of_leftBoundaryRowGroup B
        n lo hi hmem g.1 s hsGroup
      simpa only [hgcol] using h
    have hsData := (hmem s j).mp hsCell
    have hloR : lo r ≤ j := hrData.2.1
    have hle : lo s ≤ lo r :=
      finiteInterval_antitone lo n hlo r s hrs hsData.1
    have hEqR : lo r = j := by omega
    have hrGroupJ : r ∈ leftBoundaryRowGroup B lo j :=
      mem_leftBoundaryRowGroup_of_headCell B lo r j hrB hEqR.symm
    have hrGroup : r ∈ leftBoundaryRowGroup B lo g.1 := by
      simpa only [hgcol] using hrGroupJ
    have hrChoice := hP.2 r hrGroup s hsChoice hrs
    exact (mem_headTuplesCells B lo P r j).mpr
      ⟨g, hgcol, hrChoice⟩

/-- The inverse direction turns a tuple into a *typed* admissible
head selection. -/
noncomputable def headTuplesToSelection (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) : HeadPrefixSelection B lo := by
  classical
  refine ⟨headTuplesCells B lo P,
    (mem_headPrefixSelections B lo _).mpr ?_⟩
  exact headTuplesCells_isHeadPrefixSelection B
    n lo hi hmem hlo P

/-- Every actual head prefix selection is recovered exactly from its
column-by-column tuple. -/
theorem headTuplesFromSelection (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (S : HeadPrefixSelection B lo) :
    headTuplesToSelection B n lo hi hmem hlo
      (headSelectionToTuples B n lo hi hmem S) = S := by
  classical
  apply Subtype.ext
  ext c
  have hS : IsHeadPrefixSelection B lo S.1 :=
    (mem_headPrefixSelections B lo S.1).mp S.2
  constructor
  · intro hc
    change c ∈ headTuplesCells B lo
      (headSelectionToTuples B n lo hi hmem S) at hc
    obtain ⟨g, hcol, hr⟩ :=
      (mem_headTuplesCells B lo _ c.1 c.2).mp hc
    have hmemFilter : c.1 ∈
        (leftBoundaryRowGroup B lo g.1).filter
          (fun r => (r, g.1) ∈ S.1) := hr
    have hSval := (Finset.mem_filter.mp hmemFilter).2
    have heq : (c.1, g.1) = c := Prod.ext rfl hcol
    simpa only [heq] using hSval
  · intro hc
    have hcB := hS.1 hc
    have hcol := hS.2.1 c.1 c.2 hc
    have hgroup : c.1 ∈ leftBoundaryRowGroup B lo c.2 :=
      mem_leftBoundaryRowGroup_of_headCell B lo
        c.1 c.2 hcB hcol
    have hHeadCol : c.2 ∈ headColumnIndices B lo := by
      change c.2 ∈ (occupiedRows B).image lo
      refine Finset.mem_image.mpr ⟨c.1, ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨c, hcB, rfl⟩
      · exact hcol.symm
    let g : HeadColumn B lo := ⟨c.2, hHeadCol⟩
    apply (mem_headTuplesCells B lo _ c.1 c.2).mpr
    refine ⟨g, rfl, ?_⟩
    exact Finset.mem_filter.mpr ⟨hgroup, hc⟩

/-- Every tuple is recovered exactly from its assembled head selection. -/
theorem headSelectionFromTuples (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo) :
    headSelectionToTuples B n lo hi hmem
      (headTuplesToSelection B n lo hi hmem hlo P) = P := by
  classical
  funext g
  apply Subtype.ext
  ext r
  change r ∈
    (leftBoundaryRowGroup B lo g.1).filter
      (fun r => (r, g.1) ∈ headTuplesCells B lo P) ↔
    r ∈ (P g).1
  constructor
  · intro hr
    have hC : (r, g.1) ∈ headTuplesCells B lo P :=
      (Finset.mem_filter.mp hr).2
    obtain ⟨g', hg, hPick⟩ :=
      (mem_headTuplesCells B lo P r g.1).mp hC
    have heq : g' = g := Subtype.ext hg
    subst g'
    exact hPick
  · intro hr
    have hGroup := (mem_finiteRowPrefixes _ (P g).1).mp (P g).2
    apply Finset.mem_filter.mpr
    refine ⟨hGroup.1 hr, ?_⟩
    exact (mem_headTuplesCells B lo P r g.1).mpr
      ⟨g, rfl, hr⟩

/-- A full, unconditional equivalence: actual connected-skew head
selections are exactly independent finite prefixes for the row groups.
The geometry is needed only to show that the tuple-built selection
is again downward-prefix-closed. -/
noncomputable def headSelectionsEquivGroupPrefixes (B : Diagram)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r) :
    HeadPrefixSelection B lo ≃ HeadPrefixTuples B lo := by
  classical
  refine ⟨headSelectionToTuples B n lo hi hmem,
    headTuplesToSelection B n lo hi hmem hlo, ?_, ?_⟩
  · intro S
    exact headTuplesFromSelection B n lo hi hmem hlo S
  · intro P
    exact headSelectionFromTuples B n lo hi hmem hlo P

end TableauTransfer
end OrderIdealSpecializations

