/-- Non-connected skew diagrams have at least two *distinct*
removable occupied columns. One is the absolute leftmost occupied
column; the other is the head column immediately above a failure of
successive-row overlap. -/
theorem disconnected_skew_two_removable_columns (B : Diagram)
    (hsk : SkewRowIntervals B) (hnot : ¬ ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (hhi : ∀ r : ℕ, r + 1 < n → hi (r + 1) ≤ hi r) :
    ∃ j₀ j₁ : ℕ,
      j₀ ∈ occupiedColumnsRaw B ∧
      j₁ ∈ occupiedColumnsRaw B ∧
      j₀ ≠ j₁ ∧
      RemovableHeadColumn B lo j₀ ∧
      RemovableHeadColumn B lo j₁ := by
  classical
  have hNoOverlap : ¬ SuccessiveRowsOverlap B := by
    intro hoverlap
    exact hnot ⟨hsk, hoverlap⟩
  unfold SuccessiveRowsOverlap at hNoOverlap
  push Not at hNoOverlap
  obtain ⟨r, hrOcc, ⟨s, hsOcc, hrs⟩, hNo⟩ := hNoOverlap
  obtain ⟨cr, hcr, hcrRow⟩ := Finset.mem_image.mp hrOcc
  obtain ⟨cs, hcs, hcsRow⟩ := Finset.mem_image.mp hsOcc
  have hrn : r < n := by
    have h := (hmem cr.1 cr.2).mp hcr
    omega
  have hsn : s < n := by
    have h := (hmem cs.1 cs.2).mp hcs
    omega
  have hnext : r + 1 < n := by omega
  have hrHi : lo r < hi r := by
    have hrow : cr.1 = r := by simpa using hcrRow
    have hdata := (hmem cr.1 cr.2).mp hcr
    rw [hrow] at hdata
    exact lt_of_le_of_lt hdata.2.1 hdata.2.2
  have hsHi : lo s < hi s := by
    have hrow : cs.1 = s := by simpa using hcsRow
    have hdata := (hmem cs.1 cs.2).mp hcs
    rw [hrow] at hdata
    exact lt_of_le_of_lt hdata.2.1 hdata.2.2
  have hrHead : (r, lo r) ∈ B :=
    (hmem r (lo r)).mpr ⟨hrn, le_refl _, hrHi⟩
  have hsHead : (s, lo s) ∈ B :=
    (hmem s (lo s)).mpr ⟨hsn, le_refl _, hsHi⟩
  have hGap : hi (r + 1) ≤ lo r := by
    by_contra hn
    have hDown : (r + 1, lo r) ∈ B :=
      (hmem (r + 1) (lo r)).mpr
        ⟨hnext, hlo r hnext, by omega⟩
    exact hNo (lo r) hrHead hDown
  have hsBound : hi s ≤ hi (r + 1) :=
    finiteInterval_antitone hi n hhi (r + 1) s (by omega) hsn
  have hBelow : lo s < lo r := by omega
  have hColsNE : (occupiedColumnsRaw B).Nonempty :=
    ⟨lo s, Finset.mem_image.mpr ⟨(s, lo s), hsHead, rfl⟩⟩
  let j₀ : ℕ := (occupiedColumnsRaw B).min' hColsNE
  have hj₀ : j₀ ∈ occupiedColumnsRaw B :=
    Finset.min'_mem (occupiedColumnsRaw B) hColsNE
  have hj₀le : j₀ ≤ lo s :=
    Finset.min'_le (occupiedColumnsRaw B) (lo s)
      (Finset.mem_image.mpr ⟨(s, lo s), hsHead, rfl⟩)
  have hj₀rem : RemovableHeadColumn B lo j₀ := by
    intro t ht
    have htData := (hmem t j₀).mp ht
    have htHead : (t, lo t) ∈ B :=
      (hmem t (lo t)).mpr
        ⟨htData.1, le_refl _, by omega⟩
    have hMin : j₀ ≤ lo t :=
      Finset.min'_le (occupiedColumnsRaw B) (lo t)
        (Finset.mem_image.mpr ⟨(t, lo t), htHead, rfl⟩)
    omega
  have hj₁ : lo r ∈ occupiedColumnsRaw B :=
    Finset.mem_image.mpr ⟨(r, lo r), hrHead, rfl⟩
  have hj₁rem : RemovableHeadColumn B lo (lo r) := by
    intro t ht
    have htN : t < n := ((hmem t (lo r)).mp ht).1
    by_cases htr : t ≤ r
    · have hLe := finiteInterval_antitone lo n hlo t r htr hrn
      have hData := (hmem t (lo r)).mp ht
      omega
    · have hrt : r + 1 ≤ t := by omega
      have hHi := finiteInterval_antitone hi n hhi (r + 1) t hrt htN
      have hData := (hmem t (lo r)).mp ht
      omega
  refine ⟨j₀, lo r, hj₀, hj₁, ?_, hj₀rem, hj₁rem⟩
  omega

