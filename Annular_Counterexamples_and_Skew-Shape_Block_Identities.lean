namespace TableauTransfer

/-- The precise scalar sum for an arbitrary finite row group whose
full selection deletes a column. Unlike `removable_row_group_sum`, the
rows need not be numbered `0,...,r-1`; the prefix condition is the
order-theoretic one on their actual coordinates. -/
theorem finiteRowPrefix_removable_sum (x y : ℚ)
    (R : Finset ℕ) (hne : R.Nonempty) :
    (∑ P : FiniteRowPrefix R,
      oneColumnInverseCoefficient x P.1.card *
        (if P.1 = R then 1 else y)) =
      (y - x) * (1 - x) ^ (R.card - 1) := by
  classical
  let full : FiniteRowPrefix R :=
    ⟨R, finiteRowPrefixes_full R⟩
  let w : FiniteRowPrefix R → ℚ :=
    fun P => oneColumnInverseCoefficient x P.1.card
  have hSplit := Fintype.sum_eq_add_sum_subtype_ne w full
  have hSplitWeighted := Fintype.sum_eq_add_sum_subtype_ne
    (fun P : FiniteRowPrefix R =>
      w P * (if P.1 = R then 1 else y)) full
  have hNefull (P : {P : FiniteRowPrefix R // P ≠ full}) :
      P.1.1 ≠ R := by
    intro he
    apply P.2
    exact Subtype.ext he
  have hOutside :
      (∑ P : {P : FiniteRowPrefix R // P ≠ full},
        w P.1 * (if P.1.1 = R then 1 else y)) =
      (∑ P : {P : FiniteRowPrefix R // P ≠ full},
        w P.1) * y := by
    calc
      _ = ∑ P : {P : FiniteRowPrefix R // P ≠ full},
          w P.1 * y := by
            apply Fintype.sum_congr
            intro P
            simp [hNefull P]
      _ = (∑ P : {P : FiniteRowPrefix R // P ≠ full},
          w P.1) * y := by
            rw [Finset.sum_mul]
  have hFullWeight : w full =
      (-x) * (1 - x) ^ (R.card - 1) := by
    have hpos : 0 < R.card := Finset.card_pos.mpr hne
    obtain ⟨r, hr⟩ : ∃ r : ℕ, R.card = r + 1 :=
      ⟨R.card - 1, by omega⟩
    simp only [w, full, hr, oneColumnInverseCoefficient_succ,
      Nat.add_sub_cancel_right]
  have hTotal : (∑ P : FiniteRowPrefix R, w P) =
      (1 - x) ^ R.card := by
    exact finiteRowPrefix_weight_sum_subtype x R
  have hFull : (if (full : FiniteRowPrefix R).1 = R then 1 else y) = 1 := by
    simp [full]
  have hcombine :
      (∑ P : FiniteRowPrefix R,
        w P * (if P.1 = R then 1 else y)) =
      w full + ((1 - x) ^ R.card - w full) * y := by
    rw [hSplitWeighted]
    simp only [hFull, mul_one]
    rw [hOutside]
    have hRest :
        (∑ P : {P : FiniteRowPrefix R // P ≠ full}, w P.1) =
        (1 - x) ^ R.card - w full := by
      have hEq := hSplit
      rw [hTotal] at hEq
      linarith only [hEq]
    rw [hRest]
  change (∑ P : FiniteRowPrefix R,
    w P * (if P.1 = R then 1 else y)) = _
  rw [hcombine, hFullWeight]
  have hc : R.card - 1 + 1 = R.card := by
    have hpos : 0 < R.card := Finset.card_pos.mpr hne
    omega
  have hpow : (1 - x) ^ R.card =
      (1 - x) ^ (R.card - 1) * (1 - x) := by
    calc
      (1 - x) ^ R.card = (1 - x) ^ (R.card - 1 + 1) := by rw [hc]
      _ = (1 - x) ^ (R.card - 1) * (1 - x) := pow_succ _ _
  rw [hpow]
  ring

end TableauTransfer
end OrderIdealSpecializations


namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.3 — Completing the connected-column width analysis

These statements do not make an unproved assumption about a convolution.
They concern the actual cell set of a prefix tuple, with the real
column-cardinality function from the matrix T. -/

/-- Removing cells cannot create a previously unoccupied column. -/
theorem occupiedColumnsRaw_sdiff_subset (B S : Diagram) :
    occupiedColumnsRaw (B \ S) ⊆ occupiedColumnsRaw B := by
  classical
  intro j hj
  obtain ⟨c, hc, hcj⟩ := Finset.mem_image.mp hj
  exact Finset.mem_image.mpr
    ⟨c, (Finset.mem_sdiff.mp hc).1, hcj⟩

/-- In the connected case every occupied non-removable column survives
any legitimate initial-strip selection. -/
theorem connected_nonremovable_column_survives (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (j : ℕ) (hj : j ∈ occupiedColumnsRaw B)
    (hne : j ≠ j₀) :
    j ∈ occupiedColumnsRaw (B \ headTuplesCells B lo P) := by
  classical
  by_contra hnot
  have hSel := headTuplesCells_isHeadPrefixSelection
    B n lo hi hmem hlo P
  have hrem := vanished_column_is_head B _ lo hSel j hnot
  have heq := connected_removable_column_unique B hconn
    n lo hi hmem hlo j j₀ hj hj₀ hrem hrem₀
  exact hne heq

/-- The unique potentially vanishing column disappears exactly when
its corresponding row prefix is full. -/
theorem connected_special_column_vanishes_iff (B : Diagram)
    (_hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀) :
    j₀ ∉ occupiedColumnsRaw (B \ headTuplesCells B lo P) ↔
      (P (⟨j₀, removable_occupied_is_headColumn B lo j₀
        hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
        leftBoundaryRowGroup B lo j₀ := by
  classical
  have hV := headTuple_column_vanishes_iff_full
    B n lo hi hmem hlo P j₀ hj₀
  constructor
  · intro hv
    obtain ⟨hrem, hfull⟩ := hV.mp hv
    exact hfull
  · intro hf
    apply hV.mpr
    exact ⟨hrem₀, hf⟩

/-- Exactly one occupied column may be erased by a prefix tuple.
The strong set equality makes the subsequent cardinality and
polynomial calculations independent of decision procedures. -/
theorem connected_headTuple_remaining_columns (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀) :
    occupiedColumnsRaw (B \ headTuplesCells B lo P) =
      if (P (⟨j₀, removable_occupied_is_headColumn B lo j₀
            hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
           leftBoundaryRowGroup B lo j₀ then
        (occupiedColumnsRaw B).erase j₀
      else occupiedColumnsRaw B := by
  classical
  let S := headTuplesCells B lo P
  let g₀ : HeadColumn B lo :=
    ⟨j₀, removable_occupied_is_headColumn B lo j₀ hj₀ hrem₀⟩
  have hSpecial : j₀ ∉ occupiedColumnsRaw (B \ S) ↔
      (P g₀).1 = leftBoundaryRowGroup B lo j₀ :=
    connected_special_column_vanishes_iff B hconn
      n lo hi hmem hlo P j₀ hj₀ hrem₀
  have hSub : occupiedColumnsRaw (B \ S) ⊆ occupiedColumnsRaw B :=
    occupiedColumnsRaw_sdiff_subset B S
  have hOthers : ∀ j ∈ occupiedColumnsRaw B, j ≠ j₀ →
      j ∈ occupiedColumnsRaw (B \ S) := by
    intro j hj hne
    exact connected_nonremovable_column_survives B hconn
      n lo hi hmem hlo P j₀ hj₀ hrem₀ j hj hne
  by_cases hfull : (P g₀).1 = leftBoundaryRowGroup B lo j₀
  · rw [ite_eq_left hfull]
    apply Finset.Subset.antisymm
    · intro j hj
      have hjB := hSub hj
      have hjNe : j ≠ j₀ := by
        intro he
        subst j
        exact (hSpecial.mpr hfull) hj
      exact Finset.mem_erase.mpr ⟨hjNe, hjB⟩
    · intro j hj
      obtain ⟨hne, hjB⟩ := Finset.mem_erase.mp hj
      exact hOthers j hjB hne
  · rw [ite_eq_right hfull]
    apply Finset.Subset.antisymm hSub
    intro j hjB
    by_cases heq : j = j₀
    · subst j
      by_contra hnot
      exact hfull (hSpecial.mp hnot)
    · exact hOthers j hjB heq

/-- The remaining width is either unchanged or one less. This is
the exact geometric width dichotomy required in the corresponding construction. -/
theorem connected_headTuple_width_cases (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀) :
    columnCount (B \ headTuplesCells B lo P) =
      columnCount B -
        (if (P (⟨j₀, removable_occupied_is_headColumn B lo j₀
              hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
             leftBoundaryRowGroup B lo j₀ then 1 else 0) := by
  classical
  have hCols := connected_headTuple_remaining_columns B hconn
    n lo hi hmem hlo P j₀ hj₀ hrem₀
  change (occupiedColumnsRaw (B \ headTuplesCells B lo P)).card = _
  rw [hCols]
  by_cases hf : (P (⟨j₀, removable_occupied_is_headColumn
    B lo j₀ hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
      leftBoundaryRowGroup B lo j₀
  · simp only [ite_eq_left hf]
    change ((occupiedColumnsRaw B).erase j₀).card =
      (occupiedColumnsRaw B).card - 1
    have hc := Finset.card_erase_add_one hj₀
    omega
  · simp only [ite_eq_right hf]
    change (occupiedColumnsRaw B).card =
      (occupiedColumnsRaw B).card - 0
    omega

end TableauTransfer
