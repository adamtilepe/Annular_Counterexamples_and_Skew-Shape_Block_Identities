/-! ### §6.1 — Boundary geometry of connected chain increments. -/
namespace OrderIdealSpecializations
namespace OrderedRootIntegral

open CanonicalBlocks TableauTransfer

/-! ### §6.1 — Boundary geometry of connected chain increments. -/

/-- The i-th nonempty connected increment of a genuine ideal chain. -/
noncomputable def chainBlock {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) : Diagram :=
  intervalCells D (C.ideals i.castSucc) (C.ideals i.succ)

/-- A chain block is never empty. -/
theorem chainBlock_nonempty {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    (chainBlock C i).Nonempty :=
  connectedBlockChain_increment_nonempty C i

/-- Each connected increment has its intrinsic southwest corner. -/
noncomputable def chainBlockAnchor {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) : Cell :=
  Classical.choose
    (connectedSkewRows_unique_corner (chainBlock_nonempty C i)
      (C.steps i).2)

/-- The chosen anchor is genuinely the unique southwest corner. -/
theorem chainBlockAnchor_corner {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    UniqueSouthwestCorner (chainBlock C i) (chainBlockAnchor C i) := by
  exact Classical.choose_spec
    (connectedSkewRows_unique_corner (chainBlock_nonempty C i)
      (C.steps i).2)

/-- The left-boundary comparisons have exactly h(B)-1 variables. -/
theorem chainBlock_left_boundary_card {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    (nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i)).card =
      rowCount (chainBlock C i) - 1 := by
  exact card_nonrootLeftEnds (chainBlockAnchor_corner C i)

/-- The bottom-boundary comparisons have exactly w(B)-1 variables. -/
theorem chainBlock_bottom_boundary_card {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    (nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)).card =
      columnCount (chainBlock C i) - 1 := by
  exact card_nonrootBottomEnds (chainBlockAnchor_corner C i)

/-- No cell is subject to both strict inequalities for the same block. -/
theorem chainBlock_boundaries_disjoint {D : Diagram} {k : ℕ}
    (C : ConnectedBlockChain D k) (i : Fin k) :
    Disjoint
      (nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i))
      (nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i)) := by
  exact nonrootEnds_disjoint (chainBlockAnchor_corner C i)

/-- In a compatible chain the actual anchor carries the declared root
label, and the two independent classes of boundary inequalities are
satisfied. This follows from the previously established §4.3 geometry, not
from a new assumption on the labeling. -/
theorem compatibleChain_anchor_and_boundary
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots) :
    (∀ i : Fin k,
      labelingOf D σ (chainBlockAnchor C i) = roots i) ∧
    (∀ i : Fin k,
      RootBoundaryConditions (chainBlock C i)
        (chainBlockAnchor C i) (labelingOf D σ)) := by
  classical
  constructor
  · intro i
    have hne :
        (canonicalRootFiber D (labelingOf D σ) (roots i)).Nonempty := by
      simpa only [chainBlock, hcomp.1 i] using
        (chainBlock_nonempty C i)
    obtain ⟨a, ha, har⟩ :=
      canonicalRootFiber_anchor_unique_corner D (labelingOf D σ)
        hsk (labelingOf_injectiveOn D σ) (roots i) hne
    have hc : UniqueSouthwestCorner
        (canonicalRootFiber D (labelingOf D σ) (roots i))
        (chainBlockAnchor C i) := by
      simpa only [chainBlock, hcomp.1 i] using
        (chainBlockAnchor_corner C i)
    have heq : chainBlockAnchor C i = a :=
      ha.2.2 (chainBlockAnchor C i) hc.1 hc.2.1
    simpa only [heq] using har
  · intro i
    have hne :
        (canonicalRootFiber D (labelingOf D σ) (roots i)).Nonempty := by
      simpa only [chainBlock, hcomp.1 i] using
        (chainBlock_nonempty C i)
    obtain ⟨a, ha, hboundary⟩ :=
      canonicalRootFiber_strict_boundary_conditions D
        (labelingOf D σ) hsk (labelingOf_injectiveOn D σ)
        (roots i) hne
    have hc : UniqueSouthwestCorner
        (canonicalRootFiber D (labelingOf D σ) (roots i))
        (chainBlockAnchor C i) := by
      simpa only [chainBlock, hcomp.1 i] using
        (chainBlockAnchor_corner C i)
    have heq : chainBlockAnchor C i = a :=
      ha.2.2 (chainBlockAnchor C i) hc.1 hc.2.1
    have hb : RootBoundaryConditions
        (canonicalRootFiber D (labelingOf D σ) (roots i))
        (chainBlockAnchor C i) (labelingOf D σ) := by
      simpa only [heq] using hboundary
    simpa only [chainBlock, hcomp.1 i] using hb

/-- Explicit strict comparisons for the left boundaries of every block. -/
theorem compatibleChain_left_boundary_labels
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots)
    (i : Fin k) :
    ∀ c ∈ nonrootLeftEnds (chainBlock C i) (chainBlockAnchor C i),
      labelingOf D σ c < roots i := by
  have hc := (compatibleChain_anchor_and_boundary hsk C σ roots hcomp).2 i
  have hleft := (labels_on_nonroot_ends hc).1
  intro c hmem
  have h := hleft c hmem
  rw [(compatibleChain_anchor_and_boundary hsk C σ roots hcomp).1 i] at h
  exact h

/-- Explicit strict comparisons for the bottom boundaries of every block. -/
theorem compatibleChain_bottom_boundary_labels
    {D : Diagram} {k : ℕ} (hsk : SkewRowIntervals D)
    (C : ConnectedBlockChain D k) (σ : StandardLabeling D)
    (roots : Fin k → ℕ)
    (hcomp : ConnectedChainCompatibleLabeling C σ roots)
    (i : Fin k) :
    ∀ c ∈ nonrootBottomEnds (chainBlock C i) (chainBlockAnchor C i),
      roots i < labelingOf D σ c := by
  have hc := (compatibleChain_anchor_and_boundary hsk C σ roots hcomp).2 i
  have hbottom := (labels_on_nonroot_ends hc).2
  intro c hmem
  have h := hbottom c hmem
  rw [(compatibleChain_anchor_and_boundary hsk C σ roots hcomp).1 i] at h
  exact h

/-! ### §6.1 — Geometric and algebraic fixed-chain weights. -/

/-- The standard labelings actually compatible with a FIXED connected
chain. Its definition is independent of the integral. -/
noncomputable def chainCompatibleStandardLabelings
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    Finset (StandardLabeling D) := by
  classical
  exact Finset.univ.filter (fun σ : StandardLabeling D =>
    ∃ roots : Fin k → ℕ,
      ConnectedChainCompatibleLabeling C σ roots)

/-- Exact normalized cardinal on the combinatorial side. -/
noncomputable def chainCompatibleFraction
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) : ℚ :=
  ((chainCompatibleStandardLabelings C).card : ℚ) /
    (Nat.factorial (Fintype.card (ShapeCell D)) : ℚ)

/-- List of the successive (polynomial) A-kernel entries, REVERSED so
that the first integral corresponds to the smallest root. -/
noncomputable def chainKernelPolynomialsDescending
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) :
    List (Polynomial ℚ) :=
  ((List.finRange k).map (fun i =>
    blockKernelPolynomial D (C.ideals i.castSucc) (C.ideals i.succ))).reverse

/-- The iterated rational integral over 1>z₀>...>zₖ₋₁>0, with the
same boundary kernels A as the manuscript, now in the correct
chain-by-chain root order. -/
noncomputable def descendingChainKernelIntegral
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) : ℚ :=
  Polynomial.eval 1
    ((chainKernelPolynomialsDescending C).foldl
      (fun F p => primitiveFromZero (F * p)) (1 : Polynomial ℚ))

/-- The local algebraic equation is encoded as an explicit predicate (not
assumed). The PDF's formula is a GLOBAL sum with increasing parameters;
this is the corrected LOCAL formula with decreasing parameters. -/
def FixedChainSlotIdentity
    {D : Diagram} {k : ℕ} (C : ConnectedBlockChain D k) : Prop :=
  chainCompatibleFraction C = descendingChainKernelIntegral C

/-! ### §6.1 — Universal finite slot-summation identity. -/

/-- There are lower-boundary leaves, upper-boundary leaves, and free
leaves. The k distinguished roots are not included in this type. -/
abbrev SlotLeaf (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) : Type :=
  (Σ i : Fin k, Fin (l i)) ⊕
    ((Σ i : Fin k, Fin (u i)) ⊕ Fin f)

/-- Roots are listed in DECREASING order, while gaps are numbered from
smallest to largest root value (gap 0 below the smallest root). -/
def SlotAllowed (k : ℕ) (l u : Fin k → ℕ) (f : ℕ)
    (a : SlotLeaf k l u f) (gap : Fin (k + 1)) : Prop :=
  match a with
  | Sum.inl ⟨i, _⟩ => gap.val < k - i.val
  | Sum.inr (Sum.inl ⟨i, _⟩) => k - i.val ≤ gap.val
  | Sum.inr (Sum.inr _) => True

/-- Assign each nonroot label to an admissible gap between consecutive
roots, subject only to its strict inequality against its own root. -/
abbrev AllowedSlotAssignment (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) :=
  {a : SlotLeaf k l u f → Fin (k + 1) //
    ∀ v, SlotAllowed k l u f v (a v)}

/-- For each slot assignment, the labels in a given gap can be ordered
in m! ways. The factorial denominator counts all permutations of the
k roots and the sum of lower, upper, and free leaves. -/
noncomputable def slotAssignmentRatio
    (k : ℕ) (l u : Fin k → ℕ) (f : ℕ) : ℚ := by
  classical
  exact
    (∑ a : AllowedSlotAssignment k l u f,
      ∏ gap : Fin (k + 1),
        (Nat.factorial
          ((Finset.univ.filter
            (fun v : SlotLeaf k l u f => a.1 v = gap)).card) : ℚ)) /
      (Nat.factorial (k + (∑ i : Fin k, l i) +
        (∑ i : Fin k, u i) + f) : ℚ)

/-- The same ordered integral, expressed purely via polynomial
antiderivatives. Free leaves contribute a factor 1 to its integrand. -/
noncomputable def slotKernelIntegral
    (k : ℕ) (l u : Fin k → ℕ) : ℚ :=
  Polynomial.eval 1
    ((((List.finRange k).reverse.map (fun i =>
      (Polynomial.X : Polynomial ℚ) ^ (l i) *
        (1 - Polynomial.X) ^ (u i))).foldl
      (fun F p => primitiveFromZero (F * p)) (1 : Polynomial ℚ)))

/-- The slot-count/integral identity relates the combinatorial assignment
ratio to the ordered polynomial kernel integral. It is proved below
using finite summation and polynomial integration. -/
def UniversalSlotIdentity (k : ℕ) (l u : Fin k → ℕ)
    (f : ℕ) : Prop :=
  slotAssignmentRatio k l u f = slotKernelIntegral k l u

