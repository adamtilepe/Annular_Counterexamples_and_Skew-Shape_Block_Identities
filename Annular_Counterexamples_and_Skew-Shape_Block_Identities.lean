/-! ### §5.3 — Prefix sums for an arbitrary finite ordered row group

This formulation does not assume that the rows are a range starting
at zero.  It is designed for the actual finite row groups of an
interval diagram, which may start at arbitrary row coordinates. -/

/-- A prefix of an arbitrary finite subset of natural-number rows. -/
def IsPrefixOfFiniteRows (R P : Finset ℕ) : Prop :=
  P ⊆ R ∧
  ∀ r ∈ R, ∀ s ∈ P, r ≤ s → r ∈ P

/-- All prefixes of a finite group of rows, as an actual finite set. -/
noncomputable def finiteRowPrefixes (R : Finset ℕ) :
    Finset (Finset ℕ) := by
  classical
  exact R.powerset.filter (IsPrefixOfFiniteRows R)

@[simp] theorem mem_finiteRowPrefixes (R P : Finset ℕ) :
    P ∈ finiteRowPrefixes R ↔ IsPrefixOfFiniteRows R P := by
  classical
  simp [finiteRowPrefixes, IsPrefixOfFiniteRows]

/-- The full row group is always one of its prefixes. -/
theorem finiteRowPrefixes_full (R : Finset ℕ) :
    R ∈ finiteRowPrefixes R := by
  apply (mem_finiteRowPrefixes R R).mpr
  exact ⟨Finset.Subset.rfl, by intros; assumption⟩

/-- An arbitrary finite group of rows has the same prefix enumerator
as a consecutive group of the same size.  The proof removes the
maximum row, not the minimum: a non-full prefix cannot contain it. -/
theorem finiteRowPrefix_weight_sum (x : ℚ) (R : Finset ℕ) :
    (∑ P ∈ finiteRowPrefixes R,
      oneColumnInverseCoefficient x P.card) = (1 - x) ^ R.card := by
  classical
  refine Finset.strongInductionOn R ?_
  intro R ih
  by_cases hEmpty : R = ∅
  · subst R
    have hprefixes :
        finiteRowPrefixes (∅ : Finset ℕ) = {∅} := by
      ext P
      rw [mem_finiteRowPrefixes]
      constructor
      · intro hP
        simp only [Finset.mem_singleton]
        exact Finset.subset_empty.mp hP.1
      · intro hP
        have hEq : P = ∅ := Finset.mem_singleton.mp hP
        subst P
        constructor
        · exact Finset.Subset.rfl
        · intro r hr
          simp at hr
    rw [hprefixes]
    simp only [Finset.sum_singleton, Finset.card_empty,
      pow_zero, oneColumnInverseCoefficient_zero]
  · have hNonempty : R.Nonempty :=
      Finset.nonempty_iff_ne_empty.mpr hEmpty
    let m : ℕ := R.max' hNonempty
    have hm : m ∈ R := Finset.max'_mem R hNonempty
    let U : Finset ℕ := R.erase m
    have hmU : m ∉ U := by
      simp [U]
    have hUsub : U ⊆ R := Finset.erase_subset _ _
    have hUstrict : U ⊂ R := by
      refine Finset.ssubset_iff_subset_ne.mpr ⟨hUsub, ?_⟩
      intro hEq
      exact hmU (hEq.symm ▸ hm)
    have hprefix_cases (P : Finset ℕ) :
        IsPrefixOfFiniteRows R P ↔
          P = R ∨ IsPrefixOfFiniteRows U P := by
      constructor
      · intro hP
        by_cases hMax : m ∈ P
        · left
          apply Finset.Subset.antisymm hP.1
          intro r hr
          exact hP.2 r hr m hMax
            (Finset.le_max' R r hr)
        · right
          constructor
          · intro r hr
            apply Finset.mem_erase.mpr
            exact ⟨hMax ∘ (fun h : r = m => h ▸ hr), hP.1 hr⟩
          · intro r hr s hs hrs
            have hrR := hUsub hr
            exact hP.2 r hrR s hs hrs
      · intro hP
        rcases hP with hFull | hSmall
        · subst P
          exact ⟨Finset.Subset.rfl, by intros; assumption⟩
        · constructor
          · exact hSmall.1.trans hUsub
          · intro r hr s hs hrs
            by_cases hrm : r = m
            · subst r
              have hsU : s ∈ U := hSmall.1 hs
              have hsR : s ∈ R := hUsub hsU
              have hsm : s ≤ m := Finset.le_max' R s hsR
              have hse : s = m := by omega
              exact False.elim (hmU (hse ▸ hsU))
            · have hrU : r ∈ U :=
                Finset.mem_erase.mpr ⟨hrm, hr⟩
              exact hSmall.2 r hrU s hs hrs
    have hprefixSet :
        finiteRowPrefixes R = insert R (finiteRowPrefixes U) := by
      ext P
      rw [Finset.mem_insert, mem_finiteRowPrefixes,
        mem_finiteRowPrefixes]
      exact hprefix_cases P
    have hnotFull : R ∉ finiteRowPrefixes U := by
      intro h
      have hh := (mem_finiteRowPrefixes U R).mp h
      exact hmU (hh.1 hm)
    have hcard : U.card + 1 = R.card := by
      dsimp [U]
      exact Finset.card_erase_add_one hm
    have hInd := ih U hUstrict
    rw [hprefixSet, Finset.sum_insert hnotFull]
    rw [hInd]
    have hweight : oneColumnInverseCoefficient x R.card =
        (-x) * (1 - x) ^ U.card := by
      rw [← hcard, oneColumnInverseCoefficient_succ]
    rw [hweight, ← hcard, pow_succ]
    ring
/-- The same group summation over a finite subtype, convenient for
reindexing actual selected subsets by equivalences. -/
abbrev FiniteRowPrefix (R : Finset ℕ) :=
  {P : Finset ℕ // P ∈ finiteRowPrefixes R}

noncomputable instance finiteRowPrefixFintype (R : Finset ℕ) :
    Fintype (FiniteRowPrefix R) := by
  classical
  exact Finset.fintypeCoeSort (finiteRowPrefixes R)

theorem finiteRowPrefix_weight_sum_subtype (x : ℚ)
    (R : Finset ℕ) :
    (∑ P : FiniteRowPrefix R,
      oneColumnInverseCoefficient x P.1.card) = (1 - x) ^ R.card := by
  classical
  rw [← finiteRowPrefix_weight_sum x R]
  symm
  exact Finset.sum_subtype (finiteRowPrefixes R)
    (fun _ => Iff.rfl)
    (fun P => oneColumnInverseCoefficient x P.card)

end TableauTransfer
