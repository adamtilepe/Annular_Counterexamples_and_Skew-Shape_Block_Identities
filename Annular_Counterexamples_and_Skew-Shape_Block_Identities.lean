/-! ### §5.3 — The full connected two-variable prefix sum. -/

/-- Exactly the monomial factor associated with the width of the
remaining interval, with the exceptional full-column choice isolated. -/
theorem connected_headTuple_power (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (P : HeadPrefixTuples B lo)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (y : ℚ) :
    y ^ columnCount (B \ headTuplesCells B lo P) =
      y ^ (columnCount B - 1) *
        (if (P (⟨j₀, removable_occupied_is_headColumn
              B lo j₀ hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
             leftBoundaryRowGroup B lo j₀ then 1 else y) := by
  classical
  have hWpos : 0 < columnCount B := by
    change 0 < (occupiedColumnsRaw B).card
    exact Finset.card_pos.mpr ⟨j₀, hj₀⟩
  have hWidth := connected_headTuple_width_cases B hconn
    n lo hi hmem hlo P j₀ hj₀ hrem₀
  by_cases hfull :
      (P (⟨j₀, removable_occupied_is_headColumn
        B lo j₀ hj₀ hrem₀⟩ : HeadColumn B lo)).1 =
          leftBoundaryRowGroup B lo j₀
  · have hw : columnCount (B \ headTuplesCells B lo P) =
        columnCount B - 1 := by
      simpa only [ite_eq_left hfull] using hWidth
    rw [hw]
    simp [hfull]
  · have hw : columnCount (B \ headTuplesCells B lo P) =
        columnCount B := by
      simpa only [ite_eq_right hfull, Nat.sub_zero] using hWidth
    rw [hw]
    have he : columnCount B = columnCount B - 1 + 1 := by
      omega
    conv_lhs => rw [he]
    rw [pow_succ]
    simp [hfull]

/-- **Completed finite connected-prefix convolution.**  The entire
sum over genuine prefix-tuples has been evaluated, including the
change of the surviving number of occupied columns.  The exponent
`sum_g card(R_g)` is the number of occupied rows; that equality is
a separate finite-partition identity, and no cancellation is assumed. -/
theorem connected_headTuples_bivariate_sum (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (x y : ℚ) :
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        y ^ columnCount (B \ headTuplesCells B lo P)) =
      y ^ (columnCount B - 1) * (y - x) *
        (1 - x) ^
          ((∑ g : HeadColumn B lo,
            (leftBoundaryRowGroup B lo g.1).card) - 1) := by
  classical
  let g₀ : HeadColumn B lo :=
    ⟨j₀, removable_occupied_is_headColumn B lo j₀ hj₀ hrem₀⟩
  have hG : 0 < (leftBoundaryRowGroup B lo g₀.1).card :=
    Finset.card_pos.mpr (headColumn_rowGroup_nonempty B lo g₀)
  have hSum := headTuples_weighted_special_sum B lo x y g₀
  have hSplit := Finset.sum_erase_add
    (Finset.univ : Finset (HeadColumn B lo))
    (fun g : HeadColumn B lo =>
      (leftBoundaryRowGroup B lo g.1).card)
    (Finset.mem_univ g₀)
  have he :
      (leftBoundaryRowGroup B lo g₀.1).card - 1 +
          (∑ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
            (leftBoundaryRowGroup B lo g.1).card) =
        (∑ g : HeadColumn B lo,
          (leftBoundaryRowGroup B lo g.1).card) - 1 := by
    omega
  calc
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        y ^ columnCount (B \ headTuplesCells B lo P)) =
      ∑ P : HeadPrefixTuples B lo,
        y ^ (columnCount B - 1) *
          ((∏ g : HeadColumn B lo,
              oneColumnInverseCoefficient x (P g).1.card) *
           (if (P g₀).1 = leftBoundaryRowGroup B lo g₀.1
            then 1 else y)) := by
        apply Finset.sum_congr rfl
        intro P _
        rw [headTuples_q_is_product B hconn
          n lo hi hmem hlo P x]
        rw [connected_headTuple_power B hconn
          n lo hi hmem hlo P j₀ hj₀ hrem₀ y]
        ring
    _ = y ^ (columnCount B - 1) *
          (∑ P : HeadPrefixTuples B lo,
            (∏ g : HeadColumn B lo,
              oneColumnInverseCoefficient x (P g).1.card) *
            (if (P g₀).1 = leftBoundaryRowGroup B lo g₀.1
             then 1 else y)) := by
          rw [Finset.mul_sum]
    _ = y ^ (columnCount B - 1) *
          (((y - x) * (1 - x) ^
            ((leftBoundaryRowGroup B lo g₀.1).card - 1)) *
             (1 - x) ^
              (∑ g ∈ (Finset.univ : Finset (HeadColumn B lo)).erase g₀,
                (leftBoundaryRowGroup B lo g.1).card)) := by
          rw [hSum]
    _ = y ^ (columnCount B - 1) * (y - x) *
          (1 - x) ^
            ((∑ g : HeadColumn B lo,
              (leftBoundaryRowGroup B lo g.1).card) - 1) := by
          calc
            _ = y ^ (columnCount B - 1) * (y - x) *
                ((1 - x) ^
                  ((leftBoundaryRowGroup B lo g₀.1).card - 1) *
                 (1 - x) ^
                  (∑ g ∈ (Finset.univ :
                    Finset (HeadColumn B lo)).erase g₀,
                    (leftBoundaryRowGroup B lo g.1).card)) := by ring
            _ = _ := by rw [← pow_add, he]

end TableauTransfer
