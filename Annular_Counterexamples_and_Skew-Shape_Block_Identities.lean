/-! ### §5.3 — finite bivariate factor derivative. -/

/-- A finite factorized polynomial identity implies its exact
differentiated coefficient identity, without division by `x`.
In particular this proof is valid when `x=0` and when `w=1`. -/
theorem finite_bivariate_factor_derivative
    {α : Type*} [Fintype α] (a : α → ℚ) (m : α → ℕ)
    (w h : ℕ) (_hw : 0 < w) (x : ℚ)
    (hid : ∀ y : ℚ,
      (∑ i : α, a i * y ^ m i) =
        y ^ (w - 1) * (y - x) * (1 - x) ^ (h - 1)) :
    (∑ i : α,
      a i * ((m i : ℚ) * x ^ (m i - 1))) =
        x ^ (w - 1) * (1 - x) ^ (h - 1) := by
  classical
  let p : Polynomial ℚ :=
    ∑ i : α, Polynomial.C (a i) * Polynomial.X ^ (m i)
  let q : Polynomial ℚ :=
    Polynomial.X ^ (w - 1) *
      (Polynomial.X - Polynomial.C x) *
        Polynomial.C ((1 - x) ^ (h - 1))
  have hpq : p = q := by
    apply Polynomial.funext
    intro y
    have h := hid y
    simpa [p, q, Polynomial.eval_finsetSum,
      Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_sub, mul_assoc] using h
  have hleft :
      (Polynomial.derivative p).eval x =
        ∑ i : α, a i * ((m i : ℚ) * x ^ (m i - 1)) := by
    simp [p, Polynomial.derivative_X_pow, Polynomial.eval_finsetSum, Polynomial.eval_mul,
      Polynomial.eval_pow]
  have hright :
      (Polynomial.derivative q).eval x =
        x ^ (w - 1) * (1 - x) ^ (h - 1) := by
    simp [q, Polynomial.derivative_mul,
      Polynomial.derivative_sub,
      Polynomial.derivative_X_pow,
      Polynomial.eval_mul, Polynomial.eval_sub]
  rw [hpq, hright] at hleft
  exact hleft.symm

/-- Both connected convolution identities, in their fully reindexed
head-tuple form.  The first sum cancels and the differentiated sum
is the connected block-kernel coefficient. -/
theorem connected_headTuples_derivative (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j₀ : ℕ) (hj₀ : j₀ ∈ occupiedColumnsRaw B)
    (hrem₀ : RemovableHeadColumn B lo j₀)
    (x : ℚ) :
    (∑ P : HeadPrefixTuples B lo,
      verticalStripCoefficient x (headTuplesCells B lo P) *
        ((columnCount (B \ headTuplesCells B lo P) : ℚ) *
          x ^ (columnCount (B \ headTuplesCells B lo P) - 1))) =
       x ^ (columnCount B - 1) *
         (1 - x) ^ (rowCount B - 1) := by
  classical
  have hwidth : 0 < columnCount B := by
    change 0 < (occupiedColumnsRaw B).card
    exact Finset.card_pos.mpr ⟨j₀, hj₀⟩
  exact finite_bivariate_factor_derivative
    (fun P : HeadPrefixTuples B lo =>
      verticalStripCoefficient x (headTuplesCells B lo P))
    (fun P : HeadPrefixTuples B lo =>
      columnCount (B \ headTuplesCells B lo P))
    (columnCount B) (rowCount B) hwidth x
    (fun y => connected_headTuples_bivariate_closed B hconn
      n lo hi hmem hlo j₀ hj₀ hrem₀ x y)

end TableauTransfer
