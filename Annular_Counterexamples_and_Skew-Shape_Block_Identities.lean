/-! ### §5.3 — Exact finite summation over the prefixes of one row group. -/

noncomputable def rowGroupPrefixes (r : ℕ) : Finset (Finset ℕ) := by
  classical
  exact (Finset.range r).powerset.filter (IsPrefixOfRange r)

@[simp] theorem mem_rowGroupPrefixes (r : ℕ) (S : Finset ℕ) :
    S ∈ rowGroupPrefixes r ↔ IsPrefixOfRange r S := by
  classical
  simp only [rowGroupPrefixes, Finset.mem_filter, Finset.mem_powerset]
  constructor
  · exact And.right
  · intro h
    exact ⟨h.1, h⟩

abbrev RowGroupPrefix (r : ℕ) :=
  {S : Finset ℕ // S ∈ rowGroupPrefixes r}

noncomputable instance rowGroupPrefixFintype (r : ℕ) :
    Fintype (RowGroupPrefix r) := by
  classical
  exact Finset.fintypeCoeSort (rowGroupPrefixes r)

/-- Every legal prefix has a unique length in the range `0,...,r`.
This is a bijection of finite *types*, not merely an equality of counts. -/
noncomputable def rowGroupPrefixLengthEquiv (r : ℕ) :
    RowGroupPrefix r ≃ {k : ℕ // k ∈ Finset.range (r + 1)} := by
  classical
  refine ⟨
    (fun S =>
      ⟨S.1.card, Finset.mem_range.mpr (by
        have hS : IsPrefixOfRange r S.1 :=
          (mem_rowGroupPrefixes r S.1).mp S.2
        have hle := Finset.card_le_card hS.1
        simp only [Finset.card_range] at hle
        omega)⟩),
    (fun k =>
      ⟨Finset.range k.1,
        (mem_rowGroupPrefixes r (Finset.range k.1)).mpr
          (range_isPrefixOfRange r k.1 (by
            have hk := Finset.mem_range.mp k.2
            omega))⟩),
    ?_, ?_⟩
  · intro S
    apply Subtype.ext
    have hS : IsPrefixOfRange r S.1 :=
      (mem_rowGroupPrefixes r S.1).mp S.2
    exact (prefixOfRange_eq_range_card r S.1 hS).symm
  · intro k
    apply Subtype.ext
    exact Finset.card_range k.1

/-- A genuine, unconditional calculation of the sum over all legal
prefixes of one group. Each summand has weight `q_x` for one vertical
run, and the entire group contributes `(1-x)^r`. -/
theorem rowGroupPrefix_weight_sum (x : ℚ) (r : ℕ) :
    (∑ S : RowGroupPrefix r,
      oneColumnInverseCoefficient x S.1.card) = (1 - x) ^ r := by
  classical
  let e := rowGroupPrefixLengthEquiv r
  have hReindex :
      (∑ S : RowGroupPrefix r,
        oneColumnInverseCoefficient x S.1.card) =
      ∑ k : {k : ℕ // k ∈ Finset.range (r + 1)},
        oneColumnInverseCoefficient x k.1 := by
    exact Fintype.sum_equiv e
      (fun S : RowGroupPrefix r =>
        oneColumnInverseCoefficient x S.1.card)
      (fun k : {k : ℕ // k ∈ Finset.range (r + 1)} =>
        oneColumnInverseCoefficient x k.1)
      (by intro S; rfl)
  rw [hReindex]
  have hFinite :
      (∑ k : {k : ℕ // k ∈ Finset.range (r + 1)},
        oneColumnInverseCoefficient x k.1) =
      ∑ k ∈ Finset.range (r + 1), oneColumnInverseCoefficient x k := by
    symm
    exact Finset.sum_subtype (Finset.range (r + 1))
      (fun _ => Iff.rfl)
      (oneColumnInverseCoefficient x)
  rw [hFinite]
  exact oneColumnInverseCoefficient_prefix x r

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace TableauTransfer

/-! ### §5.3 — All row groups: product of the genuinely enumerated prefix sums. -/

/-- Independent finite groups of consecutive rows have the expected
product weight. Here each factor is an actual sum over all its possible
prefix selections, not merely the previously introduced algebraic
abbreviation `initialRowGroupSum`. -/
theorem all_row_group_prefixes_weight_product (x : ℚ)
    (S : Finset ℕ) (sizes : ℕ → ℕ) :
    (∏ i ∈ S,
      (∑ p : RowGroupPrefix (sizes i),
        oneColumnInverseCoefficient x p.1.card)) =
      (1 - x) ^ (∑ i ∈ S, sizes i) := by
  simp_rw [rowGroupPrefix_weight_sum x]
  exact Finset.prod_pow_eq_pow_sum S sizes (1 - x)

/-- When one nonempty distinguished group must be selected in full,
the other groups may be chosen freely. This is the *enumerated* form of
the special-column contribution in the connected interval. -/
theorem all_row_group_prefixes_distinguished (x : ℚ)
    (S : Finset ℕ) (sizes : ℕ → ℕ) (s : ℕ)
    (hs : s ∈ S) (hpos : 0 < sizes s) :
    oneColumnInverseCoefficient x (sizes s) *
      (∏ i ∈ S.erase s,
        (∑ p : RowGroupPrefix (sizes i),
          oneColumnInverseCoefficient x p.1.card)) =
      (-x) * (1 - x) ^ ((∑ i ∈ S, sizes i) - 1) := by
  rw [all_row_group_prefixes_weight_product]
  cases hsize : sizes s with
  | zero =>
      omega
  | succ k =>
      rw [oneColumnInverseCoefficient_succ]
      have hsum := Finset.sum_erase_add S sizes hs
      have he : k + (∑ i ∈ S.erase s, sizes i) =
          (∑ i ∈ S, sizes i) - 1 := by
        omega
      calc
        (-x) * (1 - x) ^ k *
            (1 - x) ^ (∑ i ∈ S.erase s, sizes i) =
          (-x) * (1 - x) ^ (k + ∑ i ∈ S.erase s, sizes i) := by
            rw [pow_add]
            ring
        _ = (-x) * (1 - x) ^ ((∑ i ∈ S, sizes i) - 1) := by
            rw [he]

end TableauTransfer
end OrderIdealSpecializations


/-! ### §5.3 — Lemma 5.3, separating column contributions. -/
namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- Two cell sets never share an occupied column. -/
def DisjointColumnSupports (A B : Diagram) : Prop :=
  ∀ a ∈ A, ∀ b ∈ B, a.2 ≠ b.2

/-- Two cell sets never share an occupied row. -/
def DisjointRowSupports (A B : Diagram) : Prop :=
  ∀ a ∈ A, ∀ b ∈ B, a.1 ≠ b.1

/-- Disjoint columns imply disjoint cell sets. -/
theorem disjoint_of_disjointColumnSupports (A B : Diagram)
    (hcol : DisjointColumnSupports A B) : Disjoint A B := by
  classical
  apply Finset.disjoint_left.mpr
  intro c hcA hcB
  exact (hcol c hcA c hcB) rfl

/-- A union of vertically admissible strips is vertical when its two
parts occupy disjoint rows. -/
theorem verticalStrip_union_of_disjoint_rows (A B : Diagram)
    (hA : IsVerticalStrip A) (hB : IsVerticalStrip B)
    (hrow : DisjointRowSupports A B) :
    IsVerticalStrip (A ∪ B) := by
  intro c hc d hd hcd
  rcases Finset.mem_union.mp hc with hcA | hcB
  · rcases Finset.mem_union.mp hd with hdA | hdB
    · exact hA c hcA d hdA hcd
    · exact False.elim ((hrow c hcA d hdB) hcd)
  · rcases Finset.mem_union.mp hd with hdA | hdB
    · exact False.elim ((hrow d hdA c hcB) hcd.symm)
    · exact hB c hcB d hdB hcd

/-- The bottom-cell enumerator of two column-disjoint pieces is their
union: the successor of a cell cannot lie in the other piece. -/
theorem verticalRunEnds_union_of_disjoint_columns (A B : Diagram)
    (hcol : DisjointColumnSupports A B) :
    verticalRunEnds (A ∪ B) = verticalRunEnds A ∪ verticalRunEnds B := by
  classical
  ext c
  simp only [verticalRunEnds, Finset.mem_filter, Finset.mem_union]
  constructor
  · rintro ⟨hc, hn⟩
    rcases hc with hcA | hcB
    · left
      exact ⟨hcA, fun hnext => hn (Or.inl hnext)⟩
    · right
      exact ⟨hcB, fun hnext => hn (Or.inr hnext)⟩
  · intro hc
    rcases hc with ⟨hcA, hnA⟩ | ⟨hcB, hnB⟩
    · refine ⟨Or.inl hcA, ?_⟩
      intro hn
      rcases hn with hnA' | hnB'
      · exact hnA hnA'
      · exact (hcol c hcA (c.1 + 1, c.2) hnB') rfl
    · refine ⟨Or.inr hcB, ?_⟩
      intro hn
      rcases hn with hnA' | hnB'
      · exact (hcol (c.1 + 1, c.2) hnA' c hcB) rfl
      · exact hnB hnB'

/-- The number of runs is additive for pieces in distinct columns. -/
theorem verticalRunCount_union_of_disjoint_columns (A B : Diagram)
    (hcol : DisjointColumnSupports A B) :
    verticalRunCount (A ∪ B) =
      verticalRunCount A + verticalRunCount B := by
  classical
  unfold verticalRunCount
  rw [verticalRunEnds_union_of_disjoint_columns A B hcol]
  apply Finset.card_union_of_disjoint
  apply Finset.disjoint_left.mpr
  intro c hcA hcB
  have hca : c ∈ A := (verticalRunEnds_subset A) hcA
  have hcb : c ∈ B := (verticalRunEnds_subset B) hcB
  exact (hcol c hca c hcb) rfl

/-- The actual coefficients q_x(S) multiply across disjoint row-and-
column supports.  This is a geometric fact about vertical runs, not a
formal invocation of a conditional matrix-inversion statement. -/
theorem verticalStripCoefficient_union_independent (x : ℚ)
    (A B : Diagram) (hA : IsVerticalStrip A)
    (hB : IsVerticalStrip B)
    (hrow : DisjointRowSupports A B)
    (hcol : DisjointColumnSupports A B) :
    verticalStripCoefficient x (A ∪ B) =
      verticalStripCoefficient x A * verticalStripCoefficient x B := by
  classical
  have hAB := verticalStrip_union_of_disjoint_rows A B hA hB hrow
  have hdisj := disjoint_of_disjointColumnSupports A B hcol
  have hcard : (A ∪ B).card = A.card + B.card :=
    Finset.card_union_of_disjoint hdisj
  have hruns := verticalRunCount_union_of_disjoint_columns A B hcol
  have hboundA := verticalRunCount_le_card A
  have hboundB := verticalRunCount_le_card B
  have hexp : (A ∪ B).card - verticalRunCount (A ∪ B) =
      (A.card - verticalRunCount A) +
        (B.card - verticalRunCount B) := by
    omega
  simp only [verticalStripCoefficient, ite_eq_left hAB,
    ite_eq_left hA, ite_eq_left hB]
  rw [hexp, hruns, pow_add, pow_add]
  ring

/-- A slice consists of all cells in a specified column. -/
noncomputable def selectedColumnSlice (E : Diagram) (j : ℕ) : Diagram := by
  classical
  exact E.filter (fun c => c.2 = j)

@[simp] theorem mem_selectedColumnSlice (E : Diagram) (j : ℕ)
    (c : Cell) :
    c ∈ selectedColumnSlice E j ↔ c ∈ E ∧ c.2 = j := by
  classical
  simp [selectedColumnSlice]

/-- The part of a diagram whose columns belong to a finite index set. -/
noncomputable def restrictToColumns (E : Diagram) (C : Finset ℕ) :
    Diagram := by
  classical
  exact E.filter (fun c => c.2 ∈ C)

@[simp] theorem mem_restrictToColumns (E : Diagram)
    (C : Finset ℕ) (c : Cell) :
    c ∈ restrictToColumns E C ↔ c ∈ E ∧ c.2 ∈ C := by
  classical
  simp [restrictToColumns]

/-- Restricting a vertical strip to columns preserves its verticality. -/
theorem verticalStrip_restrictToColumns (E : Diagram)
    (hE : IsVerticalStrip E) (C : Finset ℕ) :
    IsVerticalStrip (restrictToColumns E C) := by
  intro c hc d hd hrow
  exact hE c ((mem_restrictToColumns E C c).mp hc).1
    d ((mem_restrictToColumns E C d).mp hd).1 hrow

/-- Separating one new column from a previously selected set gives
independent pieces of a vertical strip. -/
theorem selectedColumnSlice_disjoint_rows (E : Diagram)
    (hE : IsVerticalStrip E) (j : ℕ) (C : Finset ℕ)
    (hj : j ∉ C) :
    DisjointRowSupports (selectedColumnSlice E j)
      (restrictToColumns E C) := by
  intro a ha b hb hab
  obtain ⟨haE, haj⟩ := (mem_selectedColumnSlice E j a).mp ha
  obtain ⟨hbE, hbC⟩ := (mem_restrictToColumns E C b).mp hb
  have hcol := hE a haE b hbE hab
  exact hj (by rw [← haj, hcol]; exact hbC)

/-- The same pieces have disjoint column supports. -/
theorem selectedColumnSlice_disjoint_columns (E : Diagram)
    (j : ℕ) (C : Finset ℕ) (hj : j ∉ C) :
    DisjointColumnSupports (selectedColumnSlice E j)
      (restrictToColumns E C) := by
  intro a ha b hb hab
  obtain ⟨_, haj⟩ := (mem_selectedColumnSlice E j a).mp ha
  obtain ⟨_, hbC⟩ := (mem_restrictToColumns E C b).mp hb
  exact hj (by rw [← haj, hab]; exact hbC)

/-- The decomposition of a column restriction after inserting one
new column into the set of allowed columns. -/
theorem restrictToColumns_insert (E : Diagram)
    (C : Finset ℕ) (j : ℕ) :
    restrictToColumns E (insert j C) =
      selectedColumnSlice E j ∪ restrictToColumns E C := by
  classical
  ext c
  simp only [mem_restrictToColumns, mem_selectedColumnSlice,
    Finset.mem_union, Finset.mem_insert]
  tauto

@[simp] theorem restrictToColumns_empty (E : Diagram) :
    restrictToColumns E ∅ = ∅ := by
  classical
  ext c
  simp

/-- On the empty set of columns the inverse coefficient is the unit. -/
theorem verticalStripCoefficient_restrict_empty (x : ℚ)
    (E : Diagram) :
    verticalStripCoefficient x (restrictToColumns E ∅) = 1 := by
  rw [restrictToColumns_empty, verticalStripCoefficient_empty]

/-- Multiplicativity over any finite family of disjoint column slices
of an initially vertical strip.  All terms refer to the *actual*
vertical-run coefficient from Definition 5.2. -/
theorem verticalStripCoefficient_restrict_prod (x : ℚ)
    (E : Diagram) (hE : IsVerticalStrip E)
    (C : Finset ℕ) :
    verticalStripCoefficient x (restrictToColumns E C) =
      ∏ j ∈ C, verticalStripCoefficient x (selectedColumnSlice E j) := by
  classical
  induction C using Finset.induction_on with
  | empty =>
      simp [restrictToColumns_empty]
  | @insert j C hj ih =>
      rw [restrictToColumns_insert]
      have hA : IsVerticalStrip (selectedColumnSlice E j) := by
        intro a ha b hb hrow
        exact hE a ((mem_selectedColumnSlice E j a).mp ha).1
          b ((mem_selectedColumnSlice E j b).mp hb).1 hrow
      have hB : IsVerticalStrip (restrictToColumns E C) :=
        verticalStrip_restrictToColumns E hE C
      rw [verticalStripCoefficient_union_independent x
        (selectedColumnSlice E j) (restrictToColumns E C)
        hA hB (selectedColumnSlice_disjoint_rows E hE j C hj)
        (selectedColumnSlice_disjoint_columns E j C hj)]
      rw [Finset.prod_insert hj, ih]

/-- Every occupied column occurs as the column of an actual cell. -/
noncomputable def occupiedColumnsRaw (E : Diagram) : Finset ℕ :=
  E.image Prod.snd

/-- Restricting to all actually occupied columns changes nothing. -/
theorem restrictToColumns_occupied (E : Diagram) :
    restrictToColumns E (occupiedColumnsRaw E) = E := by
  classical
  ext c
  simp only [mem_restrictToColumns]
  constructor
  · exact And.left
  · intro hc
    exact ⟨hc, Finset.mem_image.mpr ⟨c, hc, rfl⟩⟩

/-- Unconditional column-factorization of q_x on any vertical strip. -/
theorem verticalStripCoefficient_prod_columns (x : ℚ)
    (E : Diagram) (hE : IsVerticalStrip E) :
    verticalStripCoefficient x E =
      ∏ j ∈ occupiedColumnsRaw E,
        verticalStripCoefficient x (selectedColumnSlice E j) := by
  calc
    verticalStripCoefficient x E =
        verticalStripCoefficient x
          (restrictToColumns E (occupiedColumnsRaw E)) := by
          rw [restrictToColumns_occupied]
    _ = ∏ j ∈ occupiedColumnsRaw E,
          verticalStripCoefficient x (selectedColumnSlice E j) :=
          verticalStripCoefficient_restrict_prod x E hE _

end TableauTransfer
end OrderIdealSpecializations

