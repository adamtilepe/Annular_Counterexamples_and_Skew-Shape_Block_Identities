namespace TableauTransfer

open CanonicalBlocks

/-! ### §5.3 — The connected-row geometry behind consecutive groups. -/

/-- Every row between two occupied rows of a connected skew diagram
is occupied. This fills the potential gap in the row-group argument. -/
theorem connectedSkew_occupiedRows_interval (B : Diagram)
    (hconn : ConnectedSkewRows B) (r s t : ℕ)
    (hr : r ∈ occupiedRows B) (hs : s ∈ occupiedRows B)
    (hrt : r ≤ t) (hts : t ≤ s) :
    t ∈ occupiedRows B := by
  induction t, hrt using Nat.le_induction with
  | base =>
      exact hr
  | succ t hrt ih =>
      have ht : t ∈ occupiedRows B := ih (by omega)
      have hmore : ∃ u ∈ occupiedRows B, t < u :=
        ⟨s, hs, by omega⟩
      obtain ⟨j, _, hnext⟩ := hconn.2 t ht hmore
      exact Finset.mem_image.mpr ⟨(t + 1, j), hnext, rfl⟩

/-- Occupied rows whose left boundary has a particular value `j`.
The Finset construction is finite even when `lo` is defined on all ℕ. -/
noncomputable def leftBoundaryRowGroup (B : Diagram)
    (lo : ℕ → ℕ) (j : ℕ) : Finset ℕ := by
  classical
  exact (occupiedRows B).filter (fun r => lo r = j)

@[simp] theorem mem_leftBoundaryRowGroup (B : Diagram)
    (lo : ℕ → ℕ) (j r : ℕ) :
    r ∈ leftBoundaryRowGroup B lo j ↔
      r ∈ occupiedRows B ∧ lo r = j := by
  classical
  simp [leftBoundaryRowGroup]

/-- Every nonempty left-boundary group in a connected skew diagram
consists of *consecutive* occupied rows. This is the geometric input
needed to interpret a selected prefix as a single vertical run. -/
theorem connectedSkew_leftBoundaryRowGroup_interval (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (j r s t : ℕ)
    (hr : r ∈ leftBoundaryRowGroup B lo j)
    (hs : s ∈ leftBoundaryRowGroup B lo j)
    (hrt : r ≤ t) (hts : t ≤ s) :
    t ∈ leftBoundaryRowGroup B lo j := by
  obtain ⟨hrOcc, hrEq⟩ :=
    (mem_leftBoundaryRowGroup B lo j r).mp hr
  obtain ⟨hsOcc, hsEq⟩ :=
    (mem_leftBoundaryRowGroup B lo j s).mp hs
  have htOcc := connectedSkew_occupiedRows_interval B hconn
    r s t hrOcc hsOcc hrt hts
  obtain ⟨cr, hcr, hcrow⟩ := Finset.mem_image.mp hrOcc
  obtain ⟨cs, hcs, hcsrow⟩ := Finset.mem_image.mp hsOcc
  obtain ⟨ct, hct, hctrow⟩ := Finset.mem_image.mp htOcc
  have hsn : s < n := by
    have hh := (hmem cs.1 cs.2).mp hcs
    omega
  have htn : t < n := by
    have hh := (hmem ct.1 ct.2).mp hct
    omega
  have hleft : lo t ≤ lo r :=
    finiteInterval_antitone lo n hlo r t hrt htn
  have hright : lo s ≤ lo t :=
    finiteInterval_antitone lo n hlo t s hts hsn
  apply (mem_leftBoundaryRowGroup B lo j t).mpr
  exact ⟨htOcc, by omega⟩

end TableauTransfer
end OrderIdealSpecializations

namespace OrderIdealSpecializations
namespace TableauTransfer

open CanonicalBlocks

/-- A selection from a connected skew diagram that chooses only the
first cell of each selected row, and is column-prefix-closed, has no
gaps in the selected rows of any one column. -/
theorem connected_initialSelection_column_consecutive (B : Diagram)
    (hconn : ConnectedSkewRows B)
    (n : ℕ) (lo hi : ℕ → ℕ)
    (hmem : ∀ r j : ℕ,
      (r, j) ∈ B ↔ r < n ∧ lo r ≤ j ∧ j < hi r)
    (hlo : ∀ r : ℕ, r + 1 < n → lo (r + 1) ≤ lo r)
    (S : Diagram) (hSB : S ⊆ B)
    (hfirst : ∀ r j : ℕ, (r, j) ∈ S → j = lo r)
    (hprefix : ∀ r s j : ℕ, r ≤ s →
      (r, j) ∈ B → (s, j) ∈ S → (r, j) ∈ S)
    (j r s t : ℕ) (hr : (r, j) ∈ S) (hs : (s, j) ∈ S)
    (hrt : r ≤ t) (hts : t ≤ s) :
    (t, j) ∈ S := by
  have hrB : (r, j) ∈ B := hSB hr
  have hsB : (s, j) ∈ B := hSB hs
  have hrOcc : r ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨(r, j), hrB, rfl⟩
  have hsOcc : s ∈ occupiedRows B :=
    Finset.mem_image.mpr ⟨(s, j), hsB, rfl⟩
  have hrG : r ∈ leftBoundaryRowGroup B lo j :=
    (mem_leftBoundaryRowGroup B lo j r).mpr
      ⟨hrOcc, (hfirst r j hr).symm⟩
  have hsG : s ∈ leftBoundaryRowGroup B lo j :=
    (mem_leftBoundaryRowGroup B lo j s).mpr
      ⟨hsOcc, (hfirst s j hs).symm⟩
  have htG := connectedSkew_leftBoundaryRowGroup_interval B
    hconn n lo hi hmem hlo j r s t hrG hsG hrt hts
  obtain ⟨htOcc, htLeft⟩ :=
    (mem_leftBoundaryRowGroup B lo j t).mp htG
  obtain ⟨c, hc, hrow⟩ := Finset.mem_image.mp htOcc
  have hhiCell : c.2 < hi t := by
    have hdata := (hmem c.1 c.2).mp hc
    rw [hrow] at hdata
    exact hdata.2.2
  have htN : t < n := by
    have hdata := (hmem c.1 c.2).mp hc
    rw [hrow] at hdata
    exact hdata.1
  have htB : (t, j) ∈ B := by
    apply (hmem t j).mpr
    have hcol : lo t ≤ j := le_of_eq htLeft
    have hright : j < hi t := by
      rw [← htLeft]
      have hrowHas : lo t ≤ c.2 := by
        have hdata := (hmem c.1 c.2).mp hc
        rw [hrow] at hdata
        exact hdata.2.1
      exact lt_of_le_of_lt hrowHas hhiCell
    exact ⟨htN, hcol, hright⟩
  exact hprefix t s j hts htB hs

end TableauTransfer
end OrderIdealSpecializations

