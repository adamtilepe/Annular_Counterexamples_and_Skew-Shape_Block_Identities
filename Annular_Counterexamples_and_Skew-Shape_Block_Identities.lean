/-! ### §5.3 — The double-root argument for disconnected intervals. -/

/-- A finite product of polynomial factors with two distinct linear
factors `(X - C x)` has zero value and zero first derivative at `x`.
This is an elementary polynomial statement, not an analytic limit. -/
theorem finite_bivariate_two_roots_derivative
    {α ι : Type*} [Fintype α] [Fintype ι]
    (a : α → ℚ) (m : α → ℕ) (u : ℕ)
    (c : ι → ℚ) (isRoot : ι → Prop) [DecidablePred isRoot]
    (i j : ι) (hij : i ≠ j)
    (hi : isRoot i) (hj : isRoot j) (x : ℚ)
    (hid : ∀ y : ℚ,
      (∑ k : α, a k * y ^ m k) =
        y ^ u * ∏ k : ι,
          if isRoot k then (y - x) * c k else c k) :
    (∑ k : α, a k *
      ((m k : ℚ) * x ^ (m k - 1))) = 0 := by
  classical
  let L : Polynomial ℚ := Polynomial.X - Polynomial.C x
  let p : Polynomial ℚ :=
    ∑ k : α, Polynomial.C (a k) * Polynomial.X ^ (m k)
  let f : ι → Polynomial ℚ := fun k =>
    if isRoot k then L * Polynomial.C (c k)
    else Polynomial.C (c k)
  let q : Polynomial ℚ := Polynomial.X ^ u * ∏ k : ι, f k
  have hpq : p = q := by
    apply Polynomial.funext
    intro y
    have hterm (k : ι) :
        Polynomial.eval y (f k) =
          if isRoot k then (y - x) * c k else c k := by
      by_cases hk : isRoot k
      · simp [f, L, hk]
      · simp [f, L, hk]
    calc
      Polynomial.eval y p = ∑ k : α, a k * y ^ m k := by
        simp [p, Polynomial.eval_finsetSum]
      _ = y ^ u * ∏ k : ι,
          if isRoot k then (y - x) * c k else c k := hid y
      _ = Polynomial.eval y q := by
        simp only [q, Polynomial.eval_mul, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_prod]
        congr 1
        apply Finset.prod_congr rfl
        intro k _
        exact (hterm k).symm
  have hLeft : (Polynomial.derivative p).eval x =
      ∑ k : α, a k * ((m k : ℚ) * x ^ (m k - 1)) := by
    simp [p, Polynomial.derivative_X_pow,
      Polynomial.eval_finsetSum, Polynomial.eval_mul,
      Polynomial.eval_pow]
  have hExtract :
      (∏ k : ι, f k) =
        f i * f j *
          ∏ k ∈ ((Finset.univ : Finset ι).erase i).erase j, f k := by
    have h1 := Finset.prod_erase_mul
      (Finset.univ : Finset ι) f (Finset.mem_univ i)
    have hji : j ∈ (Finset.univ : Finset ι).erase i :=
      Finset.mem_erase.mpr ⟨Ne.symm hij, Finset.mem_univ j⟩
    have h2 := Finset.prod_erase_mul
      ((Finset.univ : Finset ι).erase i) f hji
    calc
      (∏ k : ι, f k) =
          (∏ k ∈ (Finset.univ : Finset ι).erase i, f k) * f i :=
        h1.symm
      _ = ((∏ k ∈ ((Finset.univ : Finset ι).erase i).erase j,
          f k) * f j) * f i := by rw [h2]
      _ = _ := by ring
  let r : Polynomial ℚ :=
    Polynomial.X ^ u *
      Polynomial.C (c i * c j) *
        (∏ k ∈ ((Finset.univ : Finset ι).erase i).erase j, f k)
  have hq : q = L * L * r := by
    have hfi : f i = L * Polynomial.C (c i) := by
      simp [f, hi]
    have hfj : f j = L * Polynomial.C (c j) := by
      simp [f, hj]
    change Polynomial.X ^ u * (∏ k : ι, f k) = L * L * r
    rw [hExtract, hfi, hfj]
    dsimp [r]
    simp only [map_mul]
    ring
  have hDerivative : (Polynomial.derivative q).eval x = 0 := by
    rw [hq]
    simp [Polynomial.derivative_mul, Polynomial.eval_mul,
      Polynomial.eval_add, L]
  rw [hpq] at hLeft
  exact hLeft.symm.trans hDerivative

